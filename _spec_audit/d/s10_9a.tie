type tie<logic>
// ch10.9 数据流图 —— graph() 表形态 API
func fetch() -> i64 { return 1 }
func parse(x: i64) -> i64 { return x + 1 }
func store(x: i64) -> i64 { return x + 2 }

func main() -> i64 {
    var g = graph()
    var a = g.add(fetch)
    var b = g.add(parse, a)
    var c = g.add(store, b)
    g.run()
    println(to_string(c))
    return 0
}
