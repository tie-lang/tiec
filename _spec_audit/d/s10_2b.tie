type tie<logic>
// ch10.2 状态单元 —— pub 方法 + run 建立
actor Counter {
    var n: i64 = 0

    pub func inc(step: i64) {
        n += step
    }

    pub func value() -> i64 {
        return n
    }
}

func main() -> i64 {
    var c = run Counter()
    c.inc(5)
    println(to_string(c.value()))
    return 0
}
