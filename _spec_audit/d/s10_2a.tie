type tie<logic>
// ch10.2 状态单元 —— 规范原文示例（方法未标 pub，句柄用 Counter()）
actor Counter {
    var n: i64 = 0

    func inc(step: i64) {
        n += step
    }

    func value() -> i64 {
        return n
    }
}

func main() -> i64 {
    var c = Counter()
    c.inc(5)
    println(to_string(c.value()))
    return 0
}
