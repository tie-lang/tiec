type tie<logic>
// 16.3 参数约定
func f1(a: i64) -> i64 { return a }
func f2(ref t: table<i64>) -> i64 { return len(t) }
func f3(immut t: table<i64>) -> i64 { return len(t) }
func f4(move t: table<i64>) -> i64 { return len(t) }
func f5(a: i64, b: i64 = 10) -> i64 { return a + b }
func f6(rest: ...i64) -> i64 { return 1 }
func main() -> i64 {
    var t: table<i64> = [1, 2]
    var r = f5(a: 1)
    return f1(1) + f2(t) + f3(t) + f4(t) + r + f6(1, 2, 3)
}
