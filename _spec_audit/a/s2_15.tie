type tie<logic>
// tests/_p9126_rowpool_probe/rowpool_probe.tie —— p.9.12.6 行池探针
// ============================================================
// table<R>（R 为 struct）结构化行池验收矩阵：写读回环、稀疏大 id（前驱为默认行）、
// 零行、多字段类型（i64/f64/string/bool/表字段）、复写覆盖、行间值拷贝、
// 读越界返回默认行、默认行含非零字段默认值。负下标写拒绝由 companion 负例探针
// rowpool_neg_probe.tie 验证（exit(1) + 诊断）。
// 既有 table<i64> 等非 struct 元素表行为零变化（p.9.12.2 扩容语义保持）。
var g_fail: i64 = 0

func expect(cond: bool, msg: string) {
    if !cond {
        println("FAIL: " + msg)
        g_fail = g_fail + 1
    }
}

// 多字段 struct：i64 / f64 / string / bool / 表字段
struct R {
    var x: i64 = 0
    var y: f64 = 0.0
    var name: string = ""
    var ok: bool = false
    var tags: table<i64> = []
}
// 带非零字段默认值：用于默认行断言
struct P {
    var w: i64 = 42
    var h: f64 = 2.5
}

// 构造 R（给各字段赋值；tags 默认空表）
func mkR(x: i64, y: f64, nm: string) -> R {
    var r = R()
    r.x = x
    r.y = y
    r.name = nm
    r.ok = true
    r.tags = table_new_i64()
    return r
}

func main() -> i64 {
    // 1. 写读回环（roundtrip）
    var rows: table<R> = []
    expect(len(rows) == 0, "空行池初始 len 应为 0")
    rows[0] = mkR(1, 2.0, "a")
    expect(len(rows) == 1, "rows[0] 写后 len 应为 1")
    var r0 = rows[0]
    expect(r0.x == 1, "roundtrip x")
    expect(r0.y == 2.0, "roundtrip y")
    expect(r0.name == "a", "roundtrip name")
    expect(r0.ok == true, "roundtrip ok")

    // 2. 稀疏大 id：写 id=1000 → len 1001，0..999 为默认行
    var big: table<R> = []
    big[1000] = mkR(7, 1.5, "big")
    expect(len(big) == 1001, "big[1000] 写后 len 应为 1001")
    expect(big[1000].x == 7 && big[1000].name == "big", "big[1000] 读回")
    var def = big[0]
    expect(def.x == 0 && def.y == 0.0 && def.name == "" && def.ok == false, "big[0] 应为默认行")
    expect(big[500].x == 0, "big[500] 默认行")
    expect(big[999].x == 0, "big[999] 默认行")
    expect(len(def.tags) == 0, "默认行表字段为空表")

    // 3. 零行（缺省中间 id，再回写既有槽）
    big[500] = mkR(123, 4.5, "mid")
    expect(big[500].x == 123 && big[500].name == "mid", "回写既有零槽成功")

    // 4. 多字段类型含表字段：写 R 携带表字段 → 读回该表内容
    var tr: table<R> = []
    var rr = mkR(3, 3.5, "t")
    var tt = table_new_i64()
    tt[0] = 11
    tt[1] = 22
    rr.tags = tt
    tr[2] = rr
    expect(len(tr) == 3, "tr[2] 写后 len 应为 3")
    var got = tr[2]
    expect(got.x == 3 && got.name == "t", "表字段行其他字段")
    expect(len(got.tags) == 2, "表字段 len==2")
    expect(got.tags[0] == 11 && got.tags[1] == 22, "表字段内容回读")
    // 其余缺省行表字段应为有效空表
    expect(len(tr[0].tags) == 0, "缺省行表字段为空表")

    // 5. 复写覆盖
    var ov: table<R> = []
    ov[1] = mkR(10, 1.0, "first")
    ov[1] = mkR(20, 2.0, "second")
    var o1 = ov[1]
    expect(o1.x == 20 && o1.name == "second", "复写覆盖生效")
    expect(len(ov) == 2, "复写不影响 len")

    // 6. 行间值拷贝 rows[a] = rows[b]：逐字段拷贝，互不影响
    var cp: table<R> = []
    cp[5] = mkR(9, 6.0, "src")
    cp[6] = cp[5]
    var c6 = cp[6]
    expect(c6.x == 9 && c6.y == 6.0 && c6.name == "src", "行值拷贝生效")
    cp[5] = mkR(1, 1.0, "changed")
    var c6b = cp[6]
    expect(c6b.x == 9 && c6b.name == "src", "改源行不影响拷贝目标（值语义）")
    // 整行 RMW 改 cp[6] 的字段 → cp[5] 不受影响
    var c6m = cp[6]
    c6m.x = 99
    cp[6] = c6m
    var c5 = cp[5]
    expect(c5.x == 1, "改目标行不影响源行（值语义）")

    // 7. 读越界返回默认行（含带非零字段默认值的 P）
    var dflt: table<P> = []
    dflt[3] = P(7, 3.5)
    expect(len(dflt) == 4, "P 行池 dflt[3] 写后 len 应为 4")
    var dOut = dflt[10]
    expect(dOut.w == 42 && as_f64(dOut.h) == 2.5, "越界读返回默认行（非零默认）")
    var dIn = dflt[0]
    expect(dIn.w == 42, "范围内未写过槽为默认行（w=42）")
    expect(dflt[3].w == 7, "写过槽读回（w=7）")

    // 8. 非 struct 元素表既有行为零变化（p.9.12.2 扩容）
    var ti = table_new_i64()
    ti[5] = 5
    expect(len(ti) == 6 && ti[5] == 5 && ti[3] == 0, "table<i64> 扩容语义保持")

    if g_fail == 0 {
        println("_p9126_rowpool_probe ALL PASS")
        return 0
    }
    println("_p9126_rowpool_probe FAILED: " + to_string(g_fail) + " 项失败")
    return 1
}