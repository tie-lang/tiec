type tie<logic>
func main() -> i64 {
    var a = 1 < 2
    var b = 2 <= 2
    var c = 3 > 1
    var d = 3 >= 4
    var e = 1 == 1
    var f = 1 != 2
    var chained = 1 < 2 && 2 < 3
    var chained2 = 1 < 2 < 3
    if a && b && c && !d && e && f {
        println("cmp ok")
    }
    if chained {
        println("chain ok")
    }
    if chained2 {
        println("chain2 ok")
    }
    return 0
}
