type tie<logic>
// §11.8 重分类：切片视图与下标在**安全代码**中可用
func slice_ops() -> i64 {
    var t = table_new_i64()
    table_push(t, 10)
    table_push(t, 20)
    table_push(t, 30)
    table_push(t, 40)
    var s = slice_of(t, 1, 3)
    return slice_len(s) * 1000 + slice_index(s, 0) + slice_index(s, 2)
}
func main() { println(to_string(slice_ops())) }
