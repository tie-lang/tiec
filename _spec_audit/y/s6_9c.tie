type tie<logic>
// ch06 §6.9 计算属性写：setter 首参自动 ref，验证写回调用方
struct Circle {
    var r: f64 = 0.0
    var name: string = ""
}

namespace Circle {
    pub func label(c: Circle) -> string { return "circle" }
    pub func label_set(c: Circle, v: string) { c.name = v }
}

func main() -> i64 {
    var c = Circle(2.0, "x")
    c.label = "hello"
    println(c.name)
    return 0
}
