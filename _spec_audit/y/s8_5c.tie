type tie<logic>
// ch08 §8.5 捕获 panic 转为普通错误
import "/std/result.tie"
func guard() -> Result<i64, string> {
    var buf: table<i64> = []
    if len(buf) == 0 {
        panic("缓冲区不应为空")
    }
    return Result.Ok(1)
}
func main() -> i64 {
    var r = catch_panic(guard)
    switch r {
        case Ok(v):
            println("ok " + to_string(v))
        case Err(m):
            println("caught " + m)
    }
    return 0
}
