type tie<logic>
// ch07 §7.1/7.2 规范原文形态：port 方法首参写 self
port Drawable {
    pub func draw(self, ctx: i64) -> string
    pub func bounds(self) -> i64
}

struct Button {
    var label: string = ""
    var w: i64 = 0
    var h: i64 = 0
}

impl Drawable for Button {
    pub func draw(self, ctx: i64) -> string {
        return "Button(" + self.label + ")"
    }
    pub func bounds(self) -> i64 {
        return self.w * self.h
    }
}

func main() -> i64 {
    var b = Button("ok", 3, 4)
    println(b.draw(0))
    println(to_string(b.bounds()))
    return 0
}