type tie<logic>
// 正确写法：parse_int（字符串 -> 整数）
func parse_port(s: string) -> Result<i64, string> {
    if len(s) == 0 { return Result.Err("empty") }
    return Result.Ok(parse_int(s))
}
func config_port(raw: string) -> Result<i64, string> {
    var port_no = parse_port(raw)?
    return Result.Ok(port_no)
}
func main() -> i64 {
    switch config_port("8080") {
        case Ok(v):
            println("port " + to_string(v))
        case Err(m):
            println("err " + m)
    }
    switch config_port("") {
        case Ok(v):
            println("port " + to_string(v))
        case Err(m):
            println("err " + m)
    }
    return 0
}
