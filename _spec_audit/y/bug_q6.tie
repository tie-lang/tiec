type tie<logic>
import "/std/result.tie"
func parse_port(s: string) -> Result<i64, i64> {
    if len(s) == 0 { return Result.Err(0) }
    return Result.Ok(to_i64(s))
}
func config_port(raw: string) -> Result<i64, i64> {
    var port_no = parse_port(raw)?
    return Result.Ok(port_no)
}
func main() -> i64 { return 0 }
