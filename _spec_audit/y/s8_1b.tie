type tie<logic>
// ch08 §8.1 显式 import result.tie 后的 Option/Result
import "/std/result.tie"

func find(xs: table<i64>, target: i64) -> Option<i64> {
    for x in xs {
        if x == target { return Some(x) }
    }
    return None
}

func parse_port(s: string) -> Result<i64, string> {
    if s.len() == 0 { return Err("空输入") }
    return Ok(to_i64(s))
}

func main() -> i64 {
    switch find([1, 2, 3], 2) {
        case Some(v):
            println("found " + to_string(v))
        case None:
            println("none")
    }
    switch parse_port("42") {
        case Ok(v):
            println("ok " + to_string(v))
        case Err(msg):
            println("fail " + msg)
    }
    return 0
}
