type tie<logic>
// ch06 §6.9 变体：setter 接收者不用ref（看是否 setter 只认ref 形态）
struct Circle {
    var r: f64 = 0.0
    var name: string = ""
}

namespace Circle {
    pub func label(c: Circle) -> string { return "circle" }
    pub func label_set(c: Circle, v: string) { c.name = v }
}

func main() -> i64 {
    var c = Circle(2.0, "x")
    println(c.label)
    return 0
}