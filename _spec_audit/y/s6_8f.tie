type tie<logic>
// ch06 §6.8 对照：规范要求 to_string 为约定名（可被 println 直接用）
struct Vec2 {
    var x: f64 = 0.0
}

namespace Vec2 {
    pub func to_string(a: Vec2) -> string { return "V(" + to_string(a.x) + ")" }
}

func main() -> i64 {
    var p = Vec2(1.0)
    println(p)          // 规范：to_string 约定 → 应打出 V(1)
    return 0
}