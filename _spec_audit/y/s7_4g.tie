type tie<logic, unsafe:mem>
// ch07 §7.4 变体：table_push(port 对象) 而非箭头赋值
port Drawable {
    pub func draw(self, ctx: i64) -> string
}

struct Button {
    var label: string = ""
}

impl Drawable for Button {
    pub func draw(self, ctx: i64) -> string { return "Button(" + self.label + ")" }
}

struct Panel {
    var tag: string = ""
}

impl Drawable for Panel {
    pub func draw(self, ctx: i64) -> string { return "Panel(" + self.tag + ")" }
}

unsafe func build() -> i64 {
    var items: table<Drawable> = table_new<Drawable>()
    var b: Drawable = Button("b")
    table_push(items, b)
    var p: Drawable = Panel("p")
    table_push(items, p)
    var n: i64 = 0
    for it in items {
        println(it.draw(0))
        n = n + 1
    }
    return n
}

func main() -> i64 {
    return build()
}
