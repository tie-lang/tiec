type tie<logic>
enum Shape {
    Circle(f64)
    Rect(f64, f64)
}
func main() -> i64 {
    var c = 1
    switch c {
        case 1, 2:
            println("small")
        case 3..7:
            println("mid")
        default:
            println("other")
    }
    var s = Shape.Circle(2.0)
    switch s {
        case Shape.Circle(r):
            println(to_string(r))
        case Shape.Rect(w, h):
            println(to_string(w * h))
    }
    return 0
}
