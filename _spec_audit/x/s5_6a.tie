type tie<logic>
func divmod(a: i64, b: i64) -> (q: i64, r: i64) {
    return (a / b, a % b)
}
func twice(g: fn(i64) -> i64, x: i64) -> i64 {
    return g(g(x))
}
func double(x: i64) -> i64 { return x * 2 }
func apply2(g: fn(i64) -> i64, v: i64) -> i64 { return g(v) }
func main() -> i64 {
    var (q, r) = divmod(7, 3)
    println(to_string(q) + to_string(r))
    var cb: fn(i64) -> i64 = double
    println(to_string(twice(cb, 3)))
    println(to_string(apply2(cb, 5)))
    var (a, b) = (1, 2)
    println(to_string(a + b))
    return 0
}
