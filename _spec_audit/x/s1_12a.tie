type tie<logic>
func main() -> i64 {
    var a = 7
    var b = 3
    println(to_string(a + b))
    println(to_string(a - b))
    println(to_string(a * b))
    println(to_string(a / b))
    println(to_string(a % b))
    println(to_string(a \ b))
    println(to_string(a %% b))
    println(to_string(a ** b))
    println(to_string(a **? b))
    println(to_string(a +? b))
    println(to_string(a -? b))
    println(to_string(a *? b))
    println(to_string(a <<? b))
    println(to_string(a << b))
    println(to_string(a >> b))
    println(to_string(a & b))
    println(to_string(a | b))
    println(to_string(a ^ b))
    println(to_string(~a))
    println(to_string(a == b))
    println(to_string(a != b))
    println(to_string(a < b))
    println(to_string(a <= b))
    println(to_string(a > b))
    println(to_string(a >= b))
    println(to_string(a && b > 0))
    println(to_string(a > 0 || b > 0))
    println(to_string(!(a > 0)))
    var c = a
    c += 1
    c -= 1
    c *= 2
    c /= 2
    c %= 7
    c \= 2
    println(to_string(c))
    c = 3
    c ++
    c --
    println(to_string(c))
    return 0
}
