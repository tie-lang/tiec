type tie<logic>
func by_value(x: i64) -> i64 { return x }
func by_ref(ref t: table<i64>) -> i64 {
    table_push(t, 1)
    return len(t)
}
func by_read(immut t: table<i64>) -> i64 { return len(t) }
func by_move(move t: table<i64>) -> i64 { return len(t) }
func main() -> i64 {
    println(to_string(by_value(1)))
    var a: table<i64> = table_new_i64()
    println(to_string(by_ref(a)))
    var b: table<i64> = table_new_i64()
    table_push(b, 1)
    table_push(b, 2)
    println(to_string(by_read(b)))
    var c: table<i64> = table_new_i64()
    table_push(c, 1)
    println(to_string(by_move(c)))
    return 0
}
