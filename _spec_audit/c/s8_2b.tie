type tie<logic>
import "F:/Projects/tie-repo/lib_v1/std/result.tie"

func parse_port(s: string) -> Result<i64, string> {
    if str_len(s) == 0 { return Result.Err("空输入") }
    return Result.Ok(to_int(s))
}

func config_port(cfg: map<string>) -> Result<i64, string> {
    var raw = cfg["port"]?
    var port = parse_port(raw)?
    return Result.Ok(port)
}

func main() -> i64 {
    var cfg: map<string> = ["port": "8080"]
    var r = config_port(cfg)
    switch r {
        case Ok(v):
            println(to_string(v))
        case Err(msg):
            println(msg)
    }
    return 0
}
