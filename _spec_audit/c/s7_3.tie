type tie<logic>

port Drawable {
    pub func draw(self, ctx: i64) -> string
    pub func bounds(self) -> i64
}

struct Button {
    var label: string
    var w: i64
    var h: i64
}

impl Drawable for Button {
    pub func draw(self, ctx: i64) -> string {
        return "Button(" + self.label + ")"
    }
    pub func bounds(self) -> i64 {
        return self.w * self.h
    }
}

func render_all<T: Drawable>(items: table<T>, ctx: i64) {
    for it in items {
        it.draw(ctx)
    }
}

func main() -> i64 {
    var b: Button = Button("ok", 10, 20)
    var items: table<Button> = [b]
    render_all(items, 0)
    return 0
}
