type tie<logic>
struct Vec2 {
    var x: i64 = 0
    var y: i64 = 0
}
namespace Vec2 {
    pub func op_add(a: Vec2, b: Vec2) -> Vec2 {
        return Vec2(a.x + b.x, a.y + b.y)
    }
    pub func op_eq(a: Vec2, b: Vec2) -> bool {
        return a.x == b.x && a.y == b.y
    }
}
func main() -> i64 {
    var p = Vec2(1, 2)
    var q = Vec2(3, 4)
    var v = p + q
    println(to_string(v.x))
    if p == q { println("eq") } else { println("ne") }
    return 0
}
