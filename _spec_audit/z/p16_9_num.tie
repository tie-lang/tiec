type tie<logic>
// 16.9 字符串与数字；16.11 语句速览；16.12 声明速览
/// 文档注释紧接声明之前
pub func gcd(a: i64, b: i64) -> i64 { if b == 0 { return a } return gcd(b, a % b) }

struct Box<T> { var f: T = d; }
struct Base { }
struct Sub extends Base { var n: i64 = 0; }
interface I { pub func m(self) -> i64 }
enum EE { A  B }
port P { pub func mp(self) -> i64 }
impl P for Box<i64> { pub func mp(self) -> i64 { return 1 } }
async func af() -> i64 { return 1 }
inline func inf() -> i64 { return 2 }
func eqb(x: i64) -> i64 = x * 2

func main() -> i64 {
    println(h"{1 + 1}")
    println(to_string(0xFF))
    println(to_string(0b1011))
    println(to_string(1_000_000))
    println(to_string(1.5))
    println(to_string('A'))
    println(to_string(42i32))
    println(gcd(12, 18).to_string())
    println(eqb(4).to_string())
    println(af().to_string())
    println(inf().to_string())
    var opt: i64 = 7
    println(to_string(opt ?: 10))
    return 0
}