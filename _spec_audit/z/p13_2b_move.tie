type tie<logic>
// 13.2 显式移动：参数声明 move 时调用即转移；13.3 已移出后使用应报错
func take(move t: table<i64>) -> i64 {
    return len(t)
}

func main() -> i64 {
    var xs: table<i64> = []
    table_push(xs, 1)
    table_push(xs, 2)
    var n = take(xs)
    println(to_string(n))
    println(to_string(len(xs)))   // 13.3：期望报错「变量已移出」
    return 0
}