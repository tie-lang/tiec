type tie<logic>

struct Circle {
    var r: i64 = 0
}

namespace Circle {
    pub func scale(self: Circle, k: i64 = 2, bias: i64 = 0) -> i64 {
        return self.r * k + bias
    }
}

func main() -> i64 {
    var c = Circle(3)
    println(to_string(c.scale()))
    println(to_string(c.scale(bias: 10)))
    println(to_string(c.scale(k: 5)))
    return 0
}
