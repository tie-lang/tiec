type tie<logic>

enum Shape {
    Circle(i64)
    Rect(i64, i64)
}

func desc(s: Shape) -> string {
    switch s {
        case Shape.Circle:
            return "圆"
        case Shape.Rect:
            return "矩形"
        default:
            return "?"
    }
}

func main() -> i64 {
    println(desc(Shape.Circle(5)))
    println(desc(Shape.Rect(3, 4)))
    return 0
}
