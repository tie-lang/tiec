type tie<tsh>
// scripts/selfhost-gate.tsh.tie —— tie 自举闭环闸门脚本（阶段 3，T3.4 G2 闸门）骨架占位
// （tsh-role 移植 selfhost-gate.ps1）。当前为骨架：检测 tiec 是否已构建，
// 未构建则提示阶段 3 尚未开始。退出码：0 = 通过 / 1 = 失败。
// 用法（仓库根目录）：<tsh> -f scripts/selfhost-gate.tsh.tie [--help]

var cmd = ""
if arg_count() >= 1 { cmd = arg_at(0) }

if cmd == "--help" || cmd == "-h" || cmd == "-?" || cmd == "/?" {
    println("tie 自举闭环闸门脚本（阶段 3，T3.4 G2 闸门）")
    println("")
    println("用法:")
    println("  .\\scripts\\selfhost-gate.tsh.tie            # 运行 G2 闸门")
    println("  .\\scripts\\selfhost-gate.tsh.tie --help     # 打印本帮助")
    println("")
    println("G2 闸门断言（待阶段 3 填充）:")
    println("  (a) tiec1 --emit-ir == tiec2 --emit-ir（逐字节，101 语料 + compiler/**/*.tie）")
    println("  (b) tiec1 / tiec2 产出 sha 一致的 .exe")
    println("  (c) tiec2 运行全部正例语料，行为与 Rust 编译产物一致")
    exit(0)
}

var root = cwd()
var tiec = root + "\\compiler\\tiec.exe"
if !file_exists(tiec) {
    println("[selfhost-gate] 未找到 tiec: " + tiec)
    println("[selfhost-gate] 阶段 3 尚未开始，G2 闸门逻辑待填充（当前为骨架）。")
    exit(0)
}

println("[selfhost-gate] 检测到 tiec，G2 闸门逻辑待阶段 3（T3.4）填充。")
exit(0)