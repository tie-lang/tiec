type tie<tsh>
// scripts/verify-crashdiag.tsh.tie —— p.9.2.1 崩溃诊断验收（tsh-role 移植 verify-crashdiag.ps1）
// ============================================================================
// 用法（仓库根目录）: <tsh> -f scripts/verify-crashdiag.tsh.tie [tiec路径]
// 验收点：
//   1) 崩溃探针：退出码 1，崩溃日志含符号化 backtrace（main -> a -> b -> boom）与错误消息
//   2) 正常探针：退出码 0、控制台输出探针结果、不写崩溃日志
//   3) 自举不动点：tiec.exe 以自身编译自身 -> tiec_fp2，两次产物 SHA256 一致
// 返回：全部通过输出 "CRASHDIAG-VERIFY OK"；任一失败 exit 1。
// 移植说明：
//   - `file_exists` 内建对本运行期新建文件返回陈旧快照（缺陷）→ 存在性统一走 cmd
//     `if exist`（真实磁盘）fex()。
//   - tsh 的 `var` 在 if/else 块内声明不可靠 → 所有可变变量顶层声明后复用（run.tsh.tie 惯例）。
//   - 新自编译产物首次经 exec 再执行有防病毒/句柄竞态 → 轮询 + settle 稳定后复用。

func bstr(b: bool) -> string {
    if b { return "T" }
    return "F"
}
// 真实磁盘存在性（cmd if exist；路径不含空格约定）
func fex(p: string) -> bool {
    var r = exec_output("cmd /c if exist " + p + " (echo _FE_YES) else (echo _FE_NO) 2>&1")
    return contains(r, "_FE_YES")
}

var tiec = ".\\compiler\\tiec.exe"
if arg_count() >= 1 && !is_empty(arg_at(0)) { tiec = arg_at(0) }

var root = cwd()
var exe = root + "\\compiler\\dbug\\crashdiag.exe"
var probeCrash = root + "\\compiler\\dbug\\_crash_probe.tie"
var probeOk = root + "\\compiler\\dbug\\_ok_probe.tie"
var logCrash = root + "\\compiler\\dbug\\_crash_probe.crash.log"
var logOk = root + "\\compiler\\dbug\\_ok_probe.crash.log"
var tmp1 = root + "\\compiler\\tiec_fp1.exe"
var tmp2 = root + "\\compiler\\tiec_fp2.exe"

var fail: i64 = 0
var rc: i64 = 0
var c1: i64 = 0
var c2: i64 = 0
var rcA: i64 = 0
var rcB: i64 = 0
var h1 = ""
var h2 = ""
var logtext = ""
var ok1 = false
var w: i64 = 0
var _x: i64 = 0

// 0) 用当前 tiec 重新构建 crashdiag
println("[0] 构建 crashdiag...")
rc = exec_code("cmd /c " + tiec + " " + root + "\\compiler\\dbug\\crashdiag.tie -o " + exe + " --no-cache >nul 2>&1")
if rc != 0 {
    println("[0] CRASHDIAG-BUILD FAIL")
    println("CRASHDIAG-VERIFY FAILED")
    exit(1)
}
println("[0] build OK")
sleep_ms(500)
_x = exec_code("cmd /c del /Q " + logCrash + " " + logOk + " >nul 2>&1")

// 1) 崩溃路径
println("[1] 崩溃探针...")
var outC = exec_output("cmd /c " + exe + " -o " + logCrash + " " + probeCrash + " 2>&1")
println(outC)
c1 = exec_code("cmd /c " + exe + " -o " + logCrash + " " + probeCrash + " >nul 2>&1")
if c1 != 1 {
    println("[1] CRASH-EXITCODE FAIL (got " + to_string(c1) + ", want 1)")
    fail = 1
} else {
    if !fex(logCrash) {
        println("[1] CRASH-LOG-NOT-WRITTEN FAIL")
        fail = 1
    } else {
        logtext = file_read(logCrash)
        ok1 = contains(logtext, "除零错误") && contains(logtext, "调用栈") &&
                  contains(logtext, "boom") && regex_findstr(logtext, "#[0-9]+ b (行") &&
                  regex_findstr(logtext, "#[0-9]+ a (行") && contains(logtext, "main")
        if ok1 {
            println("[1] crash+backtrace OK (main->a->b->boom)")
        } else {
            println("[1] BACKTRACE-CONTENT FAIL")
            fail = 1
        }
    }
    _x = exec_code("cmd /c del /Q " + logCrash + " >nul 2>&1")
}

// 2) 正常路径
println("[2] 正常探针...")
var out2 = exec_output("cmd /c " + exe + " -o " + logOk + " " + probeOk + " 2>&1")
c2 = exec_code("cmd /c " + exe + " -o " + logOk + " " + probeOk + " >nul 2>&1")
if c2 != 0 {
    println("[2] OK-EXITCODE FAIL (got " + to_string(c2) + ", want 0)")
    fail = 1
} else {
    if !contains(out2, "probe=42") {
        println("[2] OK-OUTPUT FAIL")
        fail = 1
    } else {
        if fex(logOk) {
            println("[2] OK-SHOULD-NO-LOG FAIL")
            fail = 1
        } else {
            println("[2] normal-exit OK (\"probe=42\", no log)")
        }
    }
}

// 3) 自举不动点
println("[3] 自举不动点...")
_x = exec_code("cmd /c del /Q " + tmp1 + " " + tmp2 + " >nul 2>&1")
rcA = exec_code("cmd /c " + tiec + " " + root + "\\compiler\\driver.tie -o " + tmp1 + " --no-cache >nul 2>&1")
sleep_ms(500)
if rcA != 0 {
    println("[3] FP-STAGE1 FAIL")
    fail = 1
} else {
    w = 0
    while w < 40 && !fex(tmp1) {
        w = w + 1
        sleep_ms(250)
    }
    sleep_ms(1500)
    rcB = exec_code("cmd /c " + tmp1 + " " + root + "\\compiler\\driver.tie -o " + tmp2 + " --no-cache >nul 2>&1")
    sleep_ms(500)
    if rcB != 0 {
        println("[3] FP-STAGE2 FAIL (rc=" + to_string(rcB) + ", fp1present=" + bstr(fex(tmp1)) + ")")
        fail = 1
    } else {
        h1 = get_file_hash(tmp1)
        h2 = get_file_hash(tmp2)
        if h1 != h2 {
            println("[3] FIXPOINT-DIVERGE FAIL")
            fail = 1
        } else {
            println("[3] fixpoint OK (" + h1 + ")")
        }
    }
}
_x = exec_code("cmd /c del /Q " + tmp1 + " " + tmp2 + " >nul 2>&1")

if fail == 0 {
    println("CRASHDIAG-VERIFY OK")
    exit(0)
}
println("CRASHDIAG-VERIFY FAILED")
exit(1)