type tie<tsh>
// scripts/fetch-lib.tsh.tie —— p.9.13.7-B 内置库零副本：拉取内置库根（tie-lang/tlib）
// ============================================================================
// 职责：确保编译器按 --lib-root / TIE_LIB_ROOT / 默认 ~/.tiec-lib/tlib 解析的内置库根
//   （std/ext/rdu/sys 四目录）就位；缺失时 git clone tie-lang/tlib。
// 用法（仓库根目录）：<tsh> -f scripts/fetch-lib.tsh.tie [Root目录]
//   Root 缺省 = $env:TIE_LIB_ROOT 或默认 ~/.tiec-lib/tlib。退出码 0=就绪/完成，1=异常。
// 移植说明：git 为外部命令（本机必备），经 exec_code 调 clone；file 存在性用 cmd "if exist"
//   （localhost 新建文件 file_exists 内建在本环境不保证，与其它 tsh 脚本一致用 fex）。
// 注意 interp 限制：①嵌套 if 内变量重赋值不向外持久 → 根目录在函数内 return 解析；
//   ②exit(n) 中断不保证立刻停在后继 exec 之前 → 分支体不用提前 exit，结尾统一 exit 一次。

func fex(p: string) -> bool {
    var r = exec_output("cmd /c if exist " + p + " (echo _FE_YES) else (echo _FE_NO) 2>&1")
    return contains(r, "_FE_YES")
}

// 解析库根目录（参数 > TIE_LIB_ROOT > 默认 ~/.tiec-lib/tlib）。
func resolve_root() -> string {
    if arg_count() >= 1 && !is_empty(arg_at(0)) { return arg_at(0) }
    if !is_empty(get_env("TIE_LIB_ROOT")) { return get_env("TIE_LIB_ROOT") }
    return get_env("USERPROFILE") + "\\.tiec-lib\\tlib"
}

var root = resolve_root()
var exitcode: i64 = 0

var okStd = fex(root + "\\std")
var okExt = fex(root + "\\ext")
var okRdu = fex(root + "\\rdu")
var okSys = fex(root + "\\sys")

if okStd && okExt && okRdu && okSys {
    println("[fetch-lib] 库根已就绪: " + root)
    exitcode = 0
} else {
    if fex(root + "\\.git") {
        println("[fetch-lib] 存在检出但库目录不完整，请检查: " + root)
        exitcode = 1
    } else {
        println("[fetch-lib] 克隆 tie-lang/tlib -> " + root)
        var _rc = exec_code("cmd /c git clone --depth 1 https://github.com/tie-lang/tlib.git \"" + root + "\" 2>&1")
        if _rc != 0 {
            println("[fetch-lib] clone 失败")
            exitcode = 1
        } else {
            if !fex(root + "\\std") {
                println("[fetch-lib] 拉取后仍缺 std，异常")
                exitcode = 1
            } else {
                println("[fetch-lib] 完成: " + root)
                exitcode = 0
            }
        }
    }
}

exit(exitcode)