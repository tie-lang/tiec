type tie<tsh>
// scripts/verify-profiler.tsh.tie —— p.9.2.4 剖析器验收（tsh-role 移植 verify-profiler.ps1）
// 运行于仓库根目录。验收点：1) profiler 探针 rc=0 2) 每函数 main/fib/hot 行、
//   fib 调用次数 > hot 3) 折叠栈 main;hot / main;fib;fib 4) 文本火焰图节。
// 全部通过输出 "PROFILER-VERIFY OK"；任一失败 exit 1。
// tsh 无正则、无用户函数调用后读 var 的可靠性（interp re-entrancy 已知缺陷）：
// 逐行解析以 split_lines + has_prefix + 内联 while 找 tab 实现（等价 .ps1 的
// (?m)^main\t 锚点与 (\d+) 捕获），避免回调用户函数。

var tiec = ".\\compiler\\tiec.exe"
if arg_count() >= 1 && !is_empty(arg_at(0)) { tiec = arg_at(0) }

var root = cwd()
var src = root + "\\compiler\\dbug\\profiler.tie"
var exe = root + "\\compiler\\dbug\\profiler.exe"
var probe = root + "\\compiler\\dbug\\_prof_probe.tie"
var out = get_env("TEMP") + "\\profiler_verify.out"

var fail: i64 = 0

println("[0] 构建 profiler...")
var rc0 = exec_code("cmd /c " + tiec + " " + src + " -o " + exe + " --no-cache >nul 2>&1")
if rc0 != 0 { println("[0] PROFILER-BUILD FAIL"); exit(1) }
println("[0] build OK")

var _d0 = exec_code("cmd /c del /Q \"" + out + "\" >nul 2>&1")
var rc1 = exec_code("cmd /c " + exe + " -o " + out + " " + probe + " >nul 2>&1")
if rc1 != 0 { println("[1] PROFILER-RUN FAIL"); fail = 1 }
else { println("[1] profiler run OK") }

var rep = file_read(out)
if !contains(rep, "剖析器") { println("[1b] REPORT-HEADER FAIL"); fail = 1 }

// 2) 每函数汇总：逐行解析 "name\t<count>\t"
var hasMain: bool = false
var hasFib: bool = false
var hasHot: bool = false
var fibN: i64 = -1
var hotN: i64 = -1
var lines = split_lines(rep)
var li: i64 = 0
while li < len(lines) {
    var ln = lines[li]
    if has_prefix(ln, "main\t") { hasMain = true }
    if has_prefix(ln, "fib\t") {
        hasFib = true
        var j1: i64 = 4
        while j1 < str_len(ln) {
            if str_char(ln, j1) == "\t" { break }
            j1 = j1 + 1
        }
        fibN = parse_int(substr(ln, 4, j1))
    }
    if has_prefix(ln, "hot\t") {
        hasHot = true
        var j2: i64 = 4
        while j2 < str_len(ln) {
            if str_char(ln, j2) == "\t" { break }
            j2 = j2 + 1
        }
        hotN = parse_int(substr(ln, 4, j2))
    }
    li = li + 1
}
if hasMain && hasFib && hasHot {
    println("[2] per-function rows (main/fib/hot) OK")
} else {
    println("[2] PER-FUNCTION FAIL"); fail = 1
}
if fibN > hotN {
    println("[2b] fib-calls(" + to_string(fibN) + ") > hot(" + to_string(hotN) + ") OK")
} else {
    println("[2b] FIB-HOT-COUNT FAIL (fib=" + to_string(fibN) + " hot=" + to_string(hotN) + ")"); fail = 1
}

// 3) 折叠栈 4) 火焰图
if contains(rep, "main;hot") && contains(rep, "main;fib;fib") {
    println("[3] folded stacks (main;hot / main;fib;fib) OK")
} else {
    println("[3] FOLDED-STACKS FAIL"); fail = 1
}
if contains(rep, "火焰图") {
    println("[4] flame graph section OK")
} else {
    println("[4] FLAME-GRAPH FAIL"); fail = 1
}

var _d1 = exec_code("cmd /c del /Q \"" + out + "\" >nul 2>&1")

if fail == 0 { println("PROFILER-VERIFY OK"); exit(0) }
println("PROFILER-VERIFY FAILED")
exit(1)