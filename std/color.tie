type tie<class>
// color.tie：标准库——颜色工具（命名空间 color），p.9.1.1.11。
// ============================================================
// 定位：纯函数、无内部状态，数据平面 f64。RGB 用归一化 [r,g,b]（各通道
// 0..1），RGBA 用 [r,g,b,a]（a 0..1）；HSV/HSL 中 H 为 0..360 度，S/L/V
// 为 0..1。
//
// 覆盖（与 std/json 的"纯 tie、返回数据平面"取向一致）：
//   - sRGB↔Linear 互转（分段 gamma 2.4，逐通道 + 整体两套）；
//   - RGB↔HSV、RGB↔HSL（H 为角度，双向往返稳定）；
//   - 灰度（Rec.709 luma 系数：0.2126R+0.7152G+0.0722B）；
//   - 十六进制 RGB 解析（#RGB / #RRGGBB / 无 #）与命中式 #RRGGBB 序列化；
//   - 简单色差：alpha 混合（Porter-Duff over）+ 简化 delta-E
//     （RGB 归一化空间欧氏距离，按 sqrt(3) 归一到 0..100 量纲）。
//
// 原语依赖：pow/sqrt/floor/round + as_i64/as_f64（浮点↔整数互转）均为底座
// 内建，不 import 其他 std 模块。
//
// 失败约定：parse_hex 失败返回**空表**（调用方用 len()==0 判断）；
// 各取值函数对越界/空表返回安全值（不崩溃，见 rgb_at）。
//
// 调用：import 后 color.parse_hex("#f0a") / color.rgb_to_hsv(...) 等。
// 命名规范：命名空间内函数不加 color_ 前缀；pub func 显式导出。
// ============================================================

namespace color {
// ====================================================================
// 表工具
// ====================================================================

// 构造 RGB 表 [r,g,b]（各通道 0..1）。
pub func new_rgb(r: f64, g: f64, b: f64) -> table<f64> {
    var t = table_new_f64()
    table_push(t, r)
    table_push(t, g)
    table_push(t, b)
    return t
}

// 安全取第 i 个通道（越界返回 0.0；对空表也不崩溃）。
func rgb_at(rgb: table<f64>, i: i64) -> f64 {
    if i < 0 || i >= len(rgb) {
        return 0.0
    }
    return rgb[i]
}

// 浮点绝对值（自实现，避免依赖 std/math 泛型实例化）。
func fabs(v: f64) -> f64 {
    if v < 0.0 {
        return -v
    }
    return v
}

// ====================================================================
// sRGB → Linear / Linear → sRGB（分段 gamma 2.4）
// ====================================================================

// 单通道 sRGB 非线性值（0..1）→ 线性值（0..1）。分段：
//   c <= 0.04045 时 c/12.92；否则 ((c+0.055)/1.055)^2.4。
pub func srgb_to_linear_ch(c: f64) -> f64 {
    if c <= 0.04045 {
        return c / 12.92
    }
    return pow((c + 0.055) / 1.055, 2.4)
}

// 单通道线性值（0..1）→ sRGB 非线性值（0..1）：
//   c <= 0.0031308 时 c*12.92；否则 1.055*c^(1/2.4) - 0.055。
pub func linear_to_srgb_ch(c: f64) -> f64 {
    if c <= 0.0031308 {
        return c * 12.92
    }
    return 1.055 * pow(c, 0.4166666666666667) - 0.055
}

// 整体 RGB（逐通道）sRGB → Linear，返回新表。
pub func srgb_to_linear(rgb: table<f64>) -> table<f64> {
    return new_rgb(
        srgb_to_linear_ch(rgb_at(rgb, 0)),
        srgb_to_linear_ch(rgb_at(rgb, 1)),
        srgb_to_linear_ch(rgb_at(rgb, 2)))
}

// 整体 RGB（逐通道）Linear → sRGB，返回新表。
pub func linear_to_srgb(rgb: table<f64>) -> table<f64> {
    return new_rgb(
        linear_to_srgb_ch(rgb_at(rgb, 0)),
        linear_to_srgb_ch(rgb_at(rgb, 1)),
        linear_to_srgb_ch(rgb_at(rgb, 2)))
}

// ====================================================================
// RGB ↔ HSV
// ====================================================================

// RGB → HSV，返回 [h, s, v]：h 0..360，s 0..1，v 0..1。
pub func rgb_to_hsv(rgb: table<f64>) -> table<f64> {
    var r = rgb_at(rgb, 0)
    var g = rgb_at(rgb, 1)
    var b = rgb_at(rgb, 2)
    var mx = r
    if g > mx {
        mx = g
    }
    if b > mx {
        mx = b
    }
    var mn = r
    if g < mn {
        mn = g
    }
    if b < mn {
        mn = b
    }
    var d = mx - mn
    var h: f64 = 0.0
    if d > 0.0 {
        if mx == r {
            h = (g - b) / d
            if h < 0.0 {
                h = h + 6.0
            }
        } else if mx == g {
            h = (b - r) / d + 2.0
        } else {
            h = (r - g) / d + 4.0
        }
        h = h * 60.0
    }
    var s: f64 = 0.0
    if mx > 0.0 {
        s = d / mx
    }
    var out = table_new_f64()
    table_push(out, h)
    table_push(out, s)
    table_push(out, mx)
    return out
}

// HSV → RGB，返回 [r,g,b]（各 0..1）。h 任意（自动规整到 0..360）。
pub func hsv_to_rgb(hsv: table<f64>) -> table<f64> {
    var h = rgb_at(hsv, 0)
    var s = rgb_at(hsv, 1)
    var v = rgb_at(hsv, 2)
    while h < 0.0 {
        h = h + 360.0
    }
    while h >= 360.0 {
        h = h - 360.0
    }
    var out = table_new_f64()
    if s <= 0.0 {
        table_push(out, v)
        table_push(out, v)
        table_push(out, v)
        return out
    }
    var h6 = h / 60.0
    var i: i64 = as_i64(floor(h6)) % 6
    var f = h6 - as_f64(i)
    var p = v * (1.0 - s)
    var q = v * (1.0 - s * f)
    var t = v * (1.0 - s * (1.0 - f))
    if i == 0 {
        table_push(out, v)
        table_push(out, t)
        table_push(out, p)
    } else if i == 1 {
        table_push(out, q)
        table_push(out, v)
        table_push(out, p)
    } else if i == 2 {
        table_push(out, p)
        table_push(out, v)
        table_push(out, t)
    } else if i == 3 {
        table_push(out, p)
        table_push(out, q)
        table_push(out, v)
    } else if i == 4 {
        table_push(out, t)
        table_push(out, p)
        table_push(out, v)
    } else {
        table_push(out, v)
        table_push(out, p)
        table_push(out, q)
    }
    return out
}

// ====================================================================
// RGB ↔ HSL
// ====================================================================

// 内部：HSL 三通道 → 单通道（hue 辅助，见 hsl_to_rgb）。
func hue2rgb(p: f64, q: f64, t: f64) -> f64 {
    var tt = t
    if tt < 0.0 {
        tt = tt + 1.0
    }
    if tt > 1.0 {
        tt = tt - 1.0
    }
    if tt < 0.16666666666666666 {
        return p + (q - p) * 6.0 * tt
    }
    if tt < 0.5 {
        return q
    }
    if tt < 0.6666666666666666 {
        return p + (q - p) * (0.6666666666666666 - tt) * 6.0
    }
    return p
}

// RGB → HSL，返回 [h, s, l]：h 0..360，s 0..1，l 0..1。
pub func rgb_to_hsl(rgb: table<f64>) -> table<f64> {
    var r = rgb_at(rgb, 0)
    var g = rgb_at(rgb, 1)
    var b = rgb_at(rgb, 2)
    var mx = r
    if g > mx {
        mx = g
    }
    if b > mx {
        mx = b
    }
    var mn = r
    if g < mn {
        mn = g
    }
    if b < mn {
        mn = b
    }
    var d = mx - mn
    var l = (mx + mn) / 2.0
    var h: f64 = 0.0
    if d > 0.0 {
        if mx == r {
            h = (g - b) / d
            if h < 0.0 {
                h = h + 6.0
            }
        } else if mx == g {
            h = (b - r) / d + 2.0
        } else {
            h = (r - g) / d + 4.0
        }
        h = h * 60.0
    }
    var s: f64 = 0.0
    var denom = 1.0 - fabs(2.0 * l - 1.0)
    if denom > 0.0 {
        s = d / denom
    }
    var out = table_new_f64()
    table_push(out, h)
    table_push(out, s)
    table_push(out, l)
    return out
}

// HSL → RGB，返回 [r,g,b]（各 0..1）。h 任意（自动规整）。
pub func hsl_to_rgb(hsl: table<f64>) -> table<f64> {
    var h = rgb_at(hsl, 0)
    var s = rgb_at(hsl, 1)
    var l = rgb_at(hsl, 2)
    while h < 0.0 {
        h = h + 360.0
    }
    while h >= 360.0 {
        h = h - 360.0
    }
    var out = table_new_f64()
    if s <= 0.0 {
        table_push(out, l)
        table_push(out, l)
        table_push(out, l)
        return out
    }
    var q: f64 = 0.0
    if l < 0.5 {
        q = l * (1.0 + s)
    } else {
        q = l + s - l * s
    }
    var p = 2.0 * l - q
    var hh = h / 360.0
    table_push(out, hue2rgb(p, q, hh + 0.3333333333333333))
    table_push(out, hue2rgb(p, q, hh))
    table_push(out, hue2rgb(p, q, hh - 0.3333333333333333))
    return out
}

// ====================================================================
// 灰度 / 十六进制
// ====================================================================

// Rec.709 感知亮度（luma，0..1）：0.2126R + 0.7152G + 0.0722B。
pub func grayscale(rgb: table<f64>) -> f64 {
    return 0.2126 * rgb_at(rgb, 0) + 0.7152 * rgb_at(rgb, 1) + 0.0722 * rgb_at(rgb, 2)
}

// 灰度 RGB（三通道等值 = luma）。
pub func grayscale_rgb(rgb: table<f64>) -> table<f64> {
    var luma = grayscale(rgb)
    return new_rgb(luma, luma, luma)
}

// 解析十六进制颜色：支持 #RGB / #RRGGBB / 无 #（3 或 6 位）。各通道
// 归一化到 0..1。非法输入返回**空表**（len()==0 判失败）。
pub func parse_hex(s: string) -> table<f64> {
    var n: i64 = len(s)
    var i: i64 = 0
    if n > 0 && str_byte(s, 0) == 35 {
        i = 1
    }
    var rem = n - i
    var per: i64 = 0
    if rem == 3 {
        per = 1
    } else if rem == 6 {
        per = 2
    } else {
        return table_new_f64()
    }
    var out = table_new_f64()
    var k: i64 = 0
    while k < 3 {
        var hi = hex_val(str_byte(s, i + k * per))
        if hi < 0 {
            return table_new_f64()
        }
        if per == 1 {
            table_push(out, as_f64(hi * 17) / 255.0)
        } else {
            var lo = hex_val(str_byte(s, i + k * per + 1))
            if lo < 0 {
                return table_new_f64()
            }
            table_push(out, as_f64(hi * 16 + lo) / 255.0)
        }
        k = k + 1
    }
    return out
}

// 序列化 #RRGGBB（各通道四舍五入并钳制 0..1，输出大写十六进制）。
pub func to_hex(rgb: table<f64>) -> string {
    var out = "#"
    var i: i64 = 0
    while i < 3 {
        var v = rgb_at(rgb, i)
        if v < 0.0 {
            v = 0.0
        }
        if v > 1.0 {
            v = 1.0
        }
        var iv = as_i64(round(v * 255.0))
        out = out + hex2b(iv)
        i = i + 1
    }
    return out
}

// ====================================================================
// 简单色差 / 混合
// ====================================================================

// Porter-Duff "over" alpha 混合。输入 [r,g,b,a] 或 [r,g,b]（缺省 a=1）。
// 返回合成后的 [r,g,b,a]。
pub func alpha_blend(fg: table<f64>, bg: table<f64>) -> table<f64> {
    var fa: f64 = 1.0
    if len(fg) > 3 {
        fa = rgb_at(fg, 3)
    }
    var ba: f64 = 1.0
    if len(bg) > 3 {
        ba = rgb_at(bg, 3)
    }
    var alpha = fa + ba * (1.0 - fa)
    var out = table_new_f64()
    var i: i64 = 0
    while i < 3 {
        var c = rgb_at(fg, i) * fa + rgb_at(bg, i) * ba * (1.0 - fa)
        if alpha > 0.0 {
            c = c / alpha
        }
        table_push(out, c)
        i = i + 1
    }
    table_push(out, alpha)
    return out
}

// 简化 delta-E：RGB 归一化空间欧氏距离，按 sqrt(3)（最大距离）归一，量纲 0..100。
// 0 ≈ 无差别；约 > 15 可感知。仅作快速近似（非 CIEDE2000）。
pub func delta_e(rgb1: table<f64>, rgb2: table<f64>) -> f64 {
    var dr = rgb_at(rgb1, 0) - rgb_at(rgb2, 0)
    var dg = rgb_at(rgb1, 1) - rgb_at(rgb2, 1)
    var db = rgb_at(rgb1, 2) - rgb_at(rgb2, 2)
    var dist = sqrt(dr * dr + dg * dg + db * db)
    return dist / sqrt(3.0) * 100.0
}

// ---------- 内部工具 ----------

// 十六进制单字节数值 0..15；非十六进制返回 -1。
func hex_val(b: i64) -> i64 {
    if b >= 48 && b <= 57 {
        return b - 48
    }
    if b >= 65 && b <= 70 {
        return b - 65 + 10
    }
    if b >= 97 && b <= 102 {
        return b - 97 + 10
    }
    return -1
}

// 字节（0..255）→ 两位大写十六进制。
func hex2b(v: i64) -> string {
    return hex1(v >> 4) + hex1(v & 0xF)
}

// 半字节（0..15）→ 一位大写十六进制。
func hex1(v: i64) -> string {
    if v < 10 {
        return to_string(v)
    }
    if v == 10 {
        return "A"
    }
    if v == 11 {
        return "B"
    }
    if v == 12 {
        return "C"
    }
    if v == 13 {
        return "D"
    }
    if v == 14 {
        return "E"
    }
    return "F"
}
}