type tie<logic>
// tests/svc_harness/svc_harness.tie —— 常驻编译服务（--serve-compile，kind=6 + op=2）探针
// ============================================================
// 两相验证（服务本身是 stdin/stdout 单工帧流，不引入双向管道）：
//   ① `svc_harness gen <outdir> <src...>` → stdout = 编译请求帧流（重定向到文件）
//   ② `tiec --serve-compile < 请求帧 > 应答帧`
//   ③ `svc_harness dec < 应答帧` → 逐请求打印 "DONE rc=N <vpath>" + 捕获文本
// 断言口径（调用脚本比对）：同一进程内连续编译 N 个单元，每个单元的产物必须与
// 「一次性 CLI 逐个编译」逐字节相同 —— 检验的是**跨单元复位纪律**，非编译本身。
//
// 协议实现刻意**独立于 compiler/tinker**（后者与 driver 强耦合，其全局在
// tinker.tie 主文件里）：本文件只复用 zdwrite 的 zd 原语（自包含叶），帧头/CRC
// 自行按 tink v3 线格式拼装 ⇒ 客户端与服务端两份实现互为交叉校验。
import "../../compiler/zdwrite.tie"

// ---------- 帧编码（tink v3：16B 头 + 载荷 + CRC32C） ----------

// CRC32C（Castagnoli，反射，poly 0x82F63B78；逐位实现——探针量小，不建表）。
func p_crc32c(bytes: table<i64>, n: i64) -> i64 {
    // ★ 全程用**正数** 32 位域：c 若取 -1（位模式 0xFFFFFFFF），tie 的 `>>` 是
    //   算术右移（保留符号位），CRC 立刻算错。0xFFFFFFFF 作正 i64 起步即无此问题。
    var c: i64 = 0xFFFFFFFF
    var i: i64 = 0
    while i < n {
        c = c ^ (bytes[i] & 0xFF)
        var k: i64 = 0
        while k < 8 {
            if (c & 1) != 0 {
                c = (c >> 1) ^ 0x82F63B78
            } else {
                c = c >> 1
            }
            k = k + 1
        }
        i = i + 1
    }
    return c ^ 0xFFFFFFFF
}

func p_be16(v: i64) -> table<i64> {
    var o = table_new_i64()
    table_push(o, (v >> 8) & 0xFF)
    table_push(o, v & 0xFF)
    return o
}

func p_be32(v: i64) -> table<i64> {
    var o = table_new_i64()
    table_push(o, (v >> 24) & 0xFF)
    table_push(o, (v >> 16) & 0xFF)
    table_push(o, (v >> 8) & 0xFF)
    table_push(o, v & 0xFF)
    return o
}

// 一帧：头(16) + 载荷 + CRC32C(4)。flags=4（仅 CRC；无 EXT/PROTECTED/OFFSET）。
func p_frame(payload: table<i64>) -> table<i64> {
    var h = table_new_i64()
    table_push(h, 0x74)
    table_push(h, 0x6B)
    table_push(h, 3)
    table_push(h, 0x04)
    h = byte_concat(h, p_be16(4))
    h = byte_concat(h, p_be32(0))   // stream_id
    h = byte_concat(h, p_be32(0))   // seq
    h = byte_concat(h, p_be16(len(payload)))
    var body = byte_concat(h, payload)
    var crc = p_crc32c(body, len(body))
    return byte_concat(body, p_be32(crc))
}

// ---------- 信封编码（zd 字段流：tag + varint(len) + 值） ----------

func p_fld(fno: i64, payload: table<i64>) -> table<i64> {
    var head = zdw.concat(zdw.varint(fno * 8 + 2), zdw.varint(len(payload)))
    return zdw.concat(head, payload)
}

func p_fstr(fno: i64, s: string) -> table<i64> {
    return p_fld(fno, zdw.enc_string(s))
}

func p_fi64(fno: i64, v: i64) -> table<i64> {
    return p_fld(fno, zdw.enc_i64(v))
}

// ---------- 请求载荷 ----------

// analyze 请求（op=1）：f1=op f2=src f3=base_dir f4=vpath f5=stages
func p_req_analyze(src: string, base: string, vpath: string, stages: i64) -> table<i64> {
    var p = table_new_i64()
    p = byte_concat(p, p_fi64(1, 1))
    p = byte_concat(p, p_fstr(2, src))
    p = byte_concat(p, p_fstr(3, base))
    p = byte_concat(p, p_fstr(4, vpath))
    p = byte_concat(p, p_fi64(5, stages))
    return p
}

// compile 请求（op=2）：f1=op f2=vpath f3=out f4=target f5=l f6=t f7=flags
func p_req(vpath: string, out: string, lv: i64, tv: i64, flags: i64) -> table<i64> {
    var p = table_new_i64()
    p = byte_concat(p, p_fi64(1, 2))
    p = byte_concat(p, p_fstr(2, vpath))
    p = byte_concat(p, p_fstr(3, out))
    p = byte_concat(p, p_fstr(4, ""))
    p = byte_concat(p, p_fi64(5, lv))
    p = byte_concat(p, p_fi64(6, tv))
    p = byte_concat(p, p_fi64(7, flags))
    return p
}

// ---------- 解码（应答） ----------

func p_varint(b: table<i64>, pos: i64) -> (i64, i64) {
    var v: i64 = 0
    var shift: i64 = 0
    var i = pos
    while i < len(b) {
        var x = b[i]
        v = v | ((x & 0x7F) << shift)
        if (x & 0x80) == 0 {
            return (v, i + 1)
        }
        shift = shift + 7
        if shift > 63 {
            return (0, -1)
        }
        i = i + 1
    }
    return (0, -1)
}

// zd 字符串正文（UTF-8 → 串；头字节按 fixstr/str8/str16/str32 跳过）。
func p_zstr(p: table<i64>, start: i64, end: i64) -> string {
    if start >= end {
        return ""
    }
    var h0 = p[start]
    var hw: i64 = 1
    if h0 == 0xD9 {
        hw = 2
    } else if h0 == 0xDA {
        hw = 3
    } else if h0 == 0xDB {
        hw = 5
    }
    var sb = string_builder()
    var bi = start + hw
    while bi < end {
        var b0 = p[bi]
        var cp: i64 = b0
        var adv: i64 = 1
        if b0 >= 0xF0 {
            if bi + 3 >= end {
                break
            }
            cp = ((b0 & 0x07) << 18) | ((p[bi + 1] & 0x3F) << 12) | ((p[bi + 2] & 0x3F) << 6) | (p[bi + 3] & 0x3F)
            adv = 4
        } else if b0 >= 0xE0 {
            if bi + 2 >= end {
                break
            }
            cp = ((b0 & 0x0F) << 12) | ((p[bi + 1] & 0x3F) << 6) | (p[bi + 2] & 0x3F)
            adv = 3
        } else if b0 >= 0xC0 {
            if bi + 1 >= end {
                break
            }
            cp = ((b0 & 0x1F) << 6) | (p[bi + 1] & 0x3F)
            adv = 2
        }
        sb_append(sb, str_from_code(cp))
        bi = bi + adv
    }
    return sb_build(sb)
}

func p_stdin() -> table<i64> {
    var out = table_new_i64()
    while true {
        var c = stdin_read(65536)
        if len(c) == 0 {
            break
        }
        out = byte_concat(out, c)
    }
    return out
}

// 前 n 个码点组成的串。
func p_head(p: string, n: i64) -> string {
    var sb = string_builder()
    var i: i64 = 0
    var lim = str_len(p)
    if n < lim {
        lim = n
    }
    while i < lim {
        sb_append(sb, str_char(p, i))
        i = i + 1
    }
    return sb_build(sb)
}

func p_fname(p: string) -> string {
    var n = str_len(p)
    var i = n
    while i > 0 {
        var ch = str_char(p, i - 1)
        if ch == "\\" || ch == "/" {
            var sb = string_builder()
            var k = i
            while k < n {
                sb_append(sb, str_char(p, k))
                k = k + 1
            }
            return sb_build(sb)
        }
        i = i - 1
    }
    return p
}

func p_base(p: string) -> string {
    var f = p_fname(p)
    var n = str_len(f)
    var i = n
    while i > 0 {
        if str_char(f, i - 1) == "." {
            return p_head(f, i - 1)
        }
        i = i - 1
    }
    return f
}

func main() -> i64 {
    var mode = ""
    if arg_count() >= 1 {
        mode = arg_string(0)
    }
    if mode == "gen" {
        var outdir = ""
        if arg_count() >= 2 {
            outdir = arg_string(1)
        }
        var i: i64 = 2
        while i < arg_count() {
            var src = arg_string(i)
            var out = outdir + "\\" + p_base(src) + ".svc.exe"
            var pl = p_req(src, out, 2, 0, 5)   // -l2 -t0 flags=no_cache|emit_ir
            var env = table_new_i64()
            env = byte_concat(env, p_fi64(1, 6))
            env = byte_concat(env, p_fi64(2, 0))
            env = byte_concat(env, p_fstr(3, "compile"))
            env = byte_concat(env, p_fld(4, pl))
            stdout_write_bytes(p_frame(env))
            i = i + 1
        }
        return 0
    }
    if mode == "gena" {
        // svc_harness gena <srcfile> [base_dir]：读源码文本 → op=1 请求帧
        var srcfile = ""
        if arg_count() >= 2 {
            srcfile = arg_string(1)
        }
        var base = ""
        if arg_count() >= 3 {
            base = arg_string(2)
        }
        var txt = file_read(srcfile)
        var pl = p_req_analyze(txt, base, srcfile, 15)
        var env = table_new_i64()
        env = byte_concat(env, p_fi64(1, 6))
        env = byte_concat(env, p_fi64(2, 0))
        env = byte_concat(env, p_fstr(3, "analyze"))
        env = byte_concat(env, p_fld(4, pl))
        stdout_write_bytes(p_frame(env))
        return 0
    }
    if mode == "dec" {
        var buf = p_stdin()
        var pos: i64 = 0
        var nok: i64 = 0
        var nbad: i64 = 0
        while pos + 16 <= len(buf) {
            if buf[pos] != 0x74 || buf[pos + 1] != 0x6B {
                println("DEC 帧魔力错 pos=" + to_string(pos))
                return 1
            }
            var ln = ((buf[pos + 14] & 0xFF) << 8) | (buf[pos + 15] & 0xFF)
            var pstart = pos + 16
            var pend = pstart + ln
            if pend + 4 > len(buf) {
                println("DEC 帧截断 pos=" + to_string(pos))
                return 1
            }
            pos = pend + 4
            // 信封字段：f1=kind f4=payload
            var kind: i64 = -1
            var body = table_new_i64()
            var q: i64 = pstart
            while q < pend {
                var tr = p_varint(buf, q)
                if tr.1 < 0 {
                    break
                }
                var lr = p_varint(buf, tr.1)
                if lr.1 < 0 || lr.1 + lr.0 > pend {
                    break
                }
                var fno = tr.0 >> 3
                if fno == 1 {
                    var gr = p_varint(buf, lr.1)
                    if gr.1 >= 0 {
                        kind = gr.0
                    }
                } else if fno == 4 {
                    var k = lr.1
                    while k < lr.1 + lr.0 {
                        table_push(body, buf[k])
                        k = k + 1
                    }
                }
                q = lr.1 + lr.0
            }
            if kind == 7 {
                // done：f1=op f2=rc f3=vpath f4=captured
                var rc: i64 = -999
                var vp = ""
                var cap = ""
                var r: i64 = 0
                while r < len(body) {
                    var tr2 = p_varint(body, r)
                    if tr2.1 < 0 {
                        break
                    }
                    var lr2 = p_varint(body, tr2.1)
                    if lr2.1 < 0 || lr2.1 + lr2.0 > len(body) {
                        break
                    }
                    var f2 = tr2.0 >> 3
                    if f2 == 2 {
                        var gr2 = p_varint(body, lr2.1)
                        if gr2.1 >= 0 {
                            rc = gr2.0
                        }
                    } else if f2 == 3 {
                        vp = p_zstr(body, lr2.1, lr2.1 + lr2.0)
                    } else if f2 == 4 {
                        cap = p_zstr(body, lr2.1, lr2.1 + lr2.0)
                    }
                    r = lr2.1 + lr2.0
                }
                println("DONE rc=" + to_string(rc) + " " + vp)
                if str_len(cap) > 0 {
                    print(cap)
                }
                nok = nok + 1
            } else if kind == 2 {
                // hello-ack
            } else {
                nbad = nbad + 1
            }
        }
        println("SUMMARY done=" + to_string(nok) + " other=" + to_string(nbad))
        if nbad > 0 {
            return 1
        }
        return 0
    }
    println("用法: svc_harness gen <outdir> <src...> | svc_harness dec < 应答帧")
    return 2
}
