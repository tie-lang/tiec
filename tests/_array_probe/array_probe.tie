type tie<logic>
// tests/_array_probe/array_probe.tie —— L1 定长数组探针
// 覆盖：array_init 广播 / 字面量初始化 / 下标读写 / len / ref 传参（写回）/
// 按值传参 / 数组返回值 / 嵌套数组。

// ref 数组参数：写回调用方（零拷贝指针传参）
func fill(z: ref array<f32, 8>) {
    var i: i64 = 0
    var k: f64 = 0.0
    while i < 8 {
        k = k + 1.0
        z[i] = as_f32(1.5 * k)
        i = i + 1
    }
}

// ref 读取：sum 全部元素
func sum(z: ref array<f32, 8>) -> f64 {
    var s: f64 = 0.0
    var i: i64 = 0
    while i < 8 {
        s = s + as_f64(z[i])
        i = i + 1
    }
    return s
}

// 按值传入：逐个相加
func sum_vals(z: array<f64, 3>) -> f64 {
    return z[0] + z[1] + z[2]
}

// 数组返回值（聚合值返回）
func make() -> array<f64, 3> {
    var r: array<f64, 3> = [1.0, 2.0, 3.0]
    return r
}

// struct 内嵌数组字段（内联布局）+ 命名空间方法
struct Vec4 {
    var data: array<f32, 4>;
}
namespace Vec4 {
    pub func dot(v: Vec4, w: Vec4) -> f64 {
        var s: f64 = 0.0
        var i: i64 = 0
        while i < 4 {
            s = s + as_f64(v.data[i]) * as_f64(w.data[i])
            i = i + 1
        }
        return s
    }
}

func main() {
    // 广播初始化
    var a: array<f32, 8> = array_init(0.0)
    // 编译期常量 len
    var n: i64 = len(a)
    println("len(a)=" + to_string(n))
    // ref 传参写回
    fill(a)
    // 下标写（普通赋值）
    a[2] = 99.0
    // 下标读 → f32 变量
    var x: f32 = a[1]
    var sx: f64 = 0.0
    sx = sx + as_f64(x)
    println("a[1]=" + to_string(sx))
    println("sum(a)=" + to_string(sum(a)))
    // 字面量初始化 + 复制赋值
    var s: array<f32, 3> = [1.0, 2.0, 3.0]
    var t: array<f32, 3> = s
    t[0] = 5.0
    println("s2sum=" + to_string(as_f64(s[0]) + as_f64(s[1]) + as_f64(s[2])))
    println("t0=" + to_string(as_f64(t[0])))
    // 按值传参（数组字面量）
    println("sum_vals=" + to_string(sum_vals([1.0, 2.0, 3.0])))
    // 数组返回值 + 推断类型变量
    var m = make()
    println("m0=" + to_string(m[0]) + " m2=" + to_string(m[2]))
    // 嵌套数组 g[1][2] = 9.0（写回真地址）
    var g: array<array<f32, 4>, 4> = array_init(array_init(0.0))
    g[1][2] = 9.0
    g[0][3] = 2.5
    println("g12=" + to_string(as_f64(g[1][2])) + " g03=" + to_string(as_f64(g[0][3])))
    // struct 内嵌数组字段
    var v: Vec4 = Vec4([1.0, 2.0, 3.0, 4.0])
    var w: Vec4 = Vec4([5.0, 6.0, 7.0, 8.0])
    println("dot=" + to_string(v.dot(w)))
    // 占位：编译期越界应被拒绝（下方被注释的写法在语义层报错）
    // var bad: array<f32, 3> = [1.0, 2.0]
    // var oob: f32 = a[99]
}