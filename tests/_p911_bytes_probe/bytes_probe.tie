type tie<logic>
// tests/_p911_bytes_probe/bytes_probe.tie —— p.9.1.1.15 验收：std/bytes 增强。
// 全离线确定性探针：
//   1. 大小端 u16/u32/u64 编码解码回环（LE/BE 各自）；
//   2. slice/append/fill/reverse/index_of/count_of/replace_byte；
//   3. to_hex/from_hex 互转 + 已知向量；
//   4. to_base64/from_base64 互转 + 已知向量（含 300B 二进制）；
//   5. f64 位模式读写回环、f32 普通数回环（含 ±0/±Inf）；
//   6. 既有 from_ascii / concat 回归（向后兼容）。
// 期望全部 PASS / exit 0。
import "/std/bytes.tie" as bytes

var fails: i64 = 0

func check(cond: bool, msg: string) {
    if cond {
        println("PASS " + msg)
    } else {
        println("FAIL " + msg)
        fails = fails + 1
    }
}

func eq(a: table<i64>, b: table<i64>) -> bool {
    if len(a) != len(b) {
        return false
    }
    var i: i64 = 0
    while i < len(a) {
        if a[i] != b[i] {
            return false
        }
        i = i + 1
    }
    return true
}
func sb(s: string) -> table<i64> {
    var t = table_new_i64()
    var n = str_len(s)
    var i: i64 = 0
    while i < n {
        table_push(t, str_byte(s, i))
        i = i + 1
    }
    return t
}

func section_int_endian() {
    var v: i64 = 0xDEADBEEF
    check(bytes.from_u32_le(bytes.to_u32_le(v), 0) == v, "u32 LE roundtrip")
    check(bytes.from_u32_be(bytes.to_u32_be(v), 0) == v, "u32 BE roundtrip")
    check(eq(bytes.reverse(bytes.to_u32_le(v)), bytes.to_u32_be(v)), "u32 LE/BE reversed")
    var v16: i64 = 0x1234
    check(bytes.from_u16_le(bytes.to_u16_le(v16), 0) == v16, "u16 LE roundtrip")
    check(bytes.from_u16_be(bytes.to_u16_be(v16), 0) == v16, "u16 BE roundtrip")
    var v64: i64 = 0x0123456789ABCDEF
    check(bytes.from_u64_le(bytes.to_u64_le(v64), 0) == v64, "u64 LE roundtrip")
    check(bytes.from_u64_be(bytes.to_u64_be(v64), 0) == v64, "u64 BE roundtrip")
    // 已知字节序：0x12345678 BE = 12 34 56 78
    check(eq(bytes.to_u32_be(0x12345678), bytes.from_hex("12345678")), "u32 BE known bytes")
    // LE = 78 56 34 12
    check(eq(bytes.to_u32_le(0x12345678), bytes.from_hex("78563412")), "u32 LE known bytes")
}

func section_array() {
    var a = sb("Hello World")
    check(eq(bytes.slice(a, 6, 11), sb("World")), "slice [6,11) == World")
    check(eq(bytes.append(sb("ab"), sb("cd")), sb("abcd")), "append ab+cd")
    check(eq(bytes.fill(4, 0x41), sb("AAAA")), "fill n=4 val=0x41")
    check(eq(bytes.reverse(sb("abc")), sb("cba")), "reverse abc")
    check(bytes.index_of(a, 87) == 6, "index_of 'W'==6")
    check(bytes.index_of(a, 0x5A) == -1, "index_of missing -1")
    check(bytes.count_of(sb("mississippi"), 115) == 4, "count_of 's'==4")
    check(eq(bytes.replace_byte(sb("a-b-c"), 45, 95), sb("a_b_c")), "replace_byte - -> _")
}

func section_hex() {
    check(bytes.to_hex(bytes.from_hex("deadbeef")) == "deadbeef", "to_hex deadbeef")
    check(eq(bytes.from_hex("DEADBEEF"), bytes.from_hex("deadbeef")), "from_hex DEADBEEF")
    check(eq(bytes.from_hex(bytes.to_hex(bytes.from_hex("546965"))), bytes.from_hex("546965")),
          "hex roundtrip Tie(546965)")
    check(eq(bytes.from_hex("01 aB cD 0F"), bytes.from_hex("01abcd0f")), "from_hex mixed+spaces")
    // 奇数位：末位单半字节作为高 4 位、低 4 位补 0
    check(eq(bytes.from_hex("abc"), bytes.from_hex("abc0")), "from_hex odd length -> pad low")
}

func section_base64() {
    check(bytes.to_base64(sb("Man")) == "TWFu", "b64 Man")
    check(bytes.to_base64(sb("Ma")) == "TWE=", "b64 Ma pad1")
    check(bytes.to_base64(sb("M")) == "TQ==", "b64 M pad2")
    check(bytes.to_base64(table_new_i64()) == "", "b64 empty")
    check(eq(bytes.from_base64("TWFu"), sb("Man")), "unb64 TWFu")
    check(eq(bytes.from_base64("TWE="), sb("Ma")), "unb64 TWE=")
    var bin = table_new_i64()
    var i: i64 = 0
    while i < 300 {
        table_push(bin, (i * 31 + 7) & 0xFF)
        i = i + 1
    }
    var b = bytes.to_base64(bin)
    check(eq(bytes.from_base64(b), bin), "b64 binary 300B roundtrip")
}

func section_float() {
    var v: f64 = -2.5
    check(bytes.from_f64_le(bytes.to_f64_le(v), 0) == v, "f64 LE roundtrip -2.5")
    var big: f64 = 1234567.25
    check(bytes.from_f64_be(bytes.to_f64_be(big), 0) == big, "f64 BE roundtrip 1234567.25")
    check(bytes.from_u64_be(bytes.to_f64_be(1.0), 0) == 0x3FF0000000000000, "f64 1.0 known bits")
    check(bytes.from_f32_le(bytes.to_f32_le(1.5), 0) == 1.5, "f32 LE 1.5")
    check(bytes.from_f32_le(bytes.to_f32_le(-2.25), 0) == -2.25, "f32 LE -2.25")
    check(bytes.from_f32_be(bytes.to_f32_be(100.0), 0) == 100.0, "f32 BE 100.0")
    check(bytes.from_u32_be(bytes.to_f32_be(1.0), 0) == 0x3F800000, "f32 1.0 known bits")
    check(bytes.from_f32_le(bytes.to_f32_le(1.0 / 0.0), 0) == (1.0 / 0.0), "f32 +Inf roundtrip")
    var nz: f64 = -1.0 * 0.0
    check(1.0 / bytes.from_f32_le(bytes.to_f32_le(nz), 0) < 0.0, "f32 -0.0 sign")
}

func section_backward_compat() {
    check(eq(bytes.from_ascii("Tie"), sb("Tie")), "backward from_ascii")
    check(eq(bytes.concat(sb("a"), sb("b")), sb("ab")), "backward concat")
}

func main() {
    println("start")
    section_int_endian()
    section_array()
    section_hex()
    section_base64()
    section_float()
    section_backward_compat()
    if fails == 0 {
        println("PASS")
    } else {
        println("FAIL count=" + to_string(fails))
    }
    println("done")
}