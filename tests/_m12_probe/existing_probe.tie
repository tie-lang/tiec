type tie<logic>
var fails: i64 = 0
func check(cond: bool, msg: string) {
    if cond {
        println("PASS " + msg)
    } else {
        println("FAIL " + msg)
        fails = fails + 1
    }
}
func main() {
    println("start")
    check(sqrt(4.0) == 2.0, "sqrt(4)==2")
    check(sin(0.0) == 0.0, "sin(0)==0")
    check(exp(0.0) == 1.0, "exp(0)==1")
    if fails == 0 {
        println("PASS all")
    } else {
        println("FAIL total=" + to_string(fails))
    }
    println("done")
}