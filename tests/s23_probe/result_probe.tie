type tie<logic>

// 双类型参数泛型 enum（MyRes<T, E> 前置验证）
enum MyRes<T, E> {
    Ok(T)
    Err(E)
}

func desc(r: MyRes<i64, string>) -> string {
    switch r {
        case MyRes.Ok:
            return "ok"
        default:
            return "err"
    }
}

func main() {
    var a: MyRes<i64, string> = MyRes.Ok(42)
    var b: MyRes<i64, string> = MyRes.Err("bad")
    println(desc(a))
    println(desc(b))
}