type tie<logic>
const TMAX: i64 = 64
struct Tensor {
    var data: array<f32, 64>
    var len: i64 = 0
}

func readat(me: ref array<f32, 64>, i: i64) -> f32 {
    return me[i]
}
func writeat(me: ref array<f32, 64>, i: i64, v: f32) {
    me[i] = v
}
func main() {
    var t: Tensor = Tensor(array_init(0.0), 0)
    var d = t.data
    writeat(d, 2, 9.0)
    t.data[2] = 7.0
    println("field direct+ref=" + to_string(as_f64(readat(t.data, 2))))
    println("ref via local=" + to_string(as_f64(readat(d, 2))))
}