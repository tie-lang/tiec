type tie<logic>
const TMAX: i64 = 64
struct Tensor {
    var data: array<f32, 64>;
    var len: i64 = 0;
}
func readat(me: ref array<f32, 64>, i: i64) -> f32 {
    return me[i]
}
func writeat(me: ref array<f32, 64>, i: i64, v: f32) {
    me[i] = v
}
func main() {
    var t: Tensor = Tensor(array_init(0.0), 0)
    writeat(t.data, 2, 9.0)
    var v: f64 = as_f64(readat(t.data, 2))
    println("ref through field, read=" + to_string(v))
    var a: array<f32, 64> = array_init(0.0)
    println("builtin len(a)=" + to_string(len(a)) + " field len=" + to_string(t.len))
}