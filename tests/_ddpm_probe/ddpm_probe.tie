type tie<logic>
// tests/_ddpm_probe/ddpm_probe.tie —— L3 diffusion+data+serde 库探针（≥30 断言）
// 覆盖：schedule_linear/cosine、alpha_cumprod（f64/f32）、timestep_embedding、
//       add_noise、denoise_step、sample；zscore/zscore_stat/denorm、shuffle_tiles、
//       batch_slice、tile_load/tile_checkpoint/tile_log；serde 权重/checkpoint 往返+损坏。
//       端到端：64 元粗图 + schedule_linear(200) + add_noise + zscore + 1 层 linear +
//       loss.mse + adamw_step 训 50 步噪声预测 loss 下降。
// 编译运行（tiec 根目录 f:\Projects\tie-repo\tiec）：
//   compiler\tiec.exe --no-cache tests\_ddpm_probe\ddpm_probe.tie
import "/ext/tensor.tie";
import "/std/linalg.tie";
import "/ext/tmath.tie";
import "/ext/trng.tie";
import "/ext/nn.tie";
import "/ext/optim.tie";
import "/ext/loss.tie";
import "/ext/buffer.tie";
import "/ext/diffusion.tie";
import "/ext/data.tie";
import "/ext/serde.tie";

var fails: i64 = 0
var npass: i64 = 0

func chk(cond: bool, msg: string) {
    npass = npass + 1
    if !cond {
        fails = fails + 1
        println("FAIL " + msg)
    }
}

func absf(v: f64) -> f64 {
    if v < 0.0 {
        return -v
    }
    return v
}

func near(a: f64, b: f64) -> bool {
    return absf(a - b) < 0.0001
}

func main() {
    println("=== L3 diffusion+data+serde probe ===")

    // ===================== schedule_linear =====================
    var bl = diffusion.schedule_linear(50, 0.0001, 0.02)
    chk(bl[0] == 0.0001, "lin beta0 == beta_start")
    chk(near(bl[49], 0.02), "lin beta49 == beta_end")
    var mono: bool = true
    var ii: i64 = 1
    while ii < 50 {
        if bl[ii] < bl[ii - 1] {
            mono = false
        }
        ii = ii + 1
    }
    chk(mono, "lin betas monotonic non-decreasing")
    chk(bl[50] == 0.0, "lin fold rest = 0")

    // ===================== schedule_cosine =====================
    var bc = diffusion.schedule_cosine(50, 0.008)
    var ac = diffusion.alpha_cumprod(bc, 50)
    var aMonotone: bool = true
    var nonneg: bool = true
    ii = 1
    while ii < 50 {
        if ac[ii] > ac[ii - 1] {
            aMonotone = false
        }
        if bc[ii] < 0.0 {
            nonneg = false
        }
        ii = ii + 1
    }
    chk(aMonotone, "cosine alpha-bar monotonic non-increasing")
    chk(nonneg && bc[0] >= 0.0, "cosine betas non-negative")
    chk(absf(ac[0] - 1.0) < 0.02, "cosine t=0 alpha-bar ~ 1")
    // 手算 2 点：ᾱ(t)=cos((t/n+s)/(1+s)·π/2)²
    var half_pi = 1.5707963267948966
    var a0m = cos(0.008 / 1.008 * half_pi)
    a0m = a0m * a0m
    chk(near(ac[0], a0m), "cosine ac[0] matches cos formula")
    var frac1 = 1.0 / 50.0
    var a1m = cos((frac1 + 0.008) / 1.008 * half_pi)
    a1m = a1m * a1m
    var b1m = 1.0 - a1m / a0m
    chk(near(bc[1], b1m), "cosine beta1 == 1 - ac1/ac0")

    // ===================== alpha_cumprod 手算 3 点 =====================
    var bb3: array<f64, 1024> = array_init(0.0)
    bb3[0] = 0.1; bb3[1] = 0.2; bb3[2] = 0.3
    var ac3 = diffusion.alpha_cumprod(bb3, 3)
    chk(near(ac3[0], 0.9), "acp p0 = 1-0.1 = 0.9")
    chk(near(ac3[1], 0.9 * 0.8), "acp p1 = 0.9*0.8 = 0.72")
    chk(near(ac3[2], 0.9 * 0.8 * 0.7), "acp p2 = 0.9*0.8*0.7 = 0.504")
    var ac3f = diffusion.alpha_cumprod_f32(bb3, 3)
    chk(near(as_f64(ac3f[2]), 0.504), "acp_f32 p2 same")

    // ===================== timestep_embedding =====================
    var e1 = diffusion.timestep_embedding(2, 8)
    chk(near(e1[0], sin(2.0)), "te even0 = sin(t=2)")
    chk(near(e1[1], cos(2.0)), "te odd1 = cos(t=2)")
    var ep = diffusion.timestep_embedding(3, 8)
    var en = diffusion.timestep_embedding(-3, 8)
    var sym: bool = true
    var jj: i64 = 0
    while jj < 8 {
        if jj % 2 == 0 {
            if !near(ep[jj], -en[jj]) {
                sym = false
            }
        } else {
            if !near(ep[jj], en[jj]) {
                sym = false
            }
        }
        jj = jj + 1
    }
    chk(sym, "te half-symmetry (even negate, odd keep)")
    chk(e1[8] == 0.0, "te dim bound -> elem[dim]==0")

    // ===================== add_noise =====================
    var acpX: array<f64, 1024> = array_init(0.0)
    acpX[0] = 1.0; acpX[1] = 0.64; acpX[2] = 0.36
    var x0: array<f32, 1024> = array_init(0.0)
    x0[0] = 1.0; x0[1] = 2.0; x0[2] = 3.0
    var nz: array<f32, 1024> = array_init(0.0)
    nz[0] = 1.0; nz[1] = 0.0; nz[2] = 5.0
    var o1: array<f32, 1024> = array_init(0.0)
    var r0 = trng.new(11)
    r0 = diffusion.add_noise(x0, 3, 0, nz, acpX, o1, r0)
    chk(as_f64(o1[0]) == 1.0 && as_f64(o1[2]) == 3.0, "add_noise t=0 -> x==x0 (alpha=1)")
    var o2: array<f32, 1024> = array_init(0.0)
    r0 = diffusion.add_noise(x0, 3, 1, nz, acpX, o2, r0)
    chk(near(as_f64(o2[0]), 0.8 * 1.0 + 0.6 * 1.0), "add_noise hand out0 = 0.8*1+0.6*1 = 1.4")
    chk(near(as_f64(o2[1]), 0.8 * 2.0 + 0.6 * 0.0), "add_noise hand out1 = 1.6")
    chk(near(as_f64(o2[2]), 0.8 * 3.0 + 0.6 * 5.0), "add_noise hand out2 = 5.4")
    // 生成路径：noise 全 0 → trng.gauss 生成；确定性校验
    var zz: array<f32, 1024> = array_init(0.0)
    var ra = trng.new(99)
    var g1: array<f32, 1024> = array_init(0.0)
    ra = diffusion.add_noise(x0, 3, 1, zz, acpX, g1, ra)
    var rb = trng.new(99)
    var g2b: array<f32, 1024> = array_init(0.0)
    rb = diffusion.add_noise(x0, 3, 1, zz, acpX, g2b, rb)
    chk(g1[0] == g2b[0] && g1[1] == g2b[1], "add_noise generated noise deterministic (same seed)")

    // ===================== denoise_step =====================
    var cln: array<f32, 1024> = array_init(0.0)
    cln[0] = 1.0; cln[1] = 2.0; cln[2] = 3.0
    var de: array<f32, 1024> = array_init(0.0)
    var r1 = trng.new(5)
    r1 = diffusion.denoise_step(cln, 3, 0, nz, acpX, r1, de, false)
    chk(as_f64(de[0]) == 1.0 && as_f64(de[1]) == 2.0 && as_f64(de[2]) == 3.0, "denoise t=0 exact x0")
    var rec: array<f32, 1024> = array_init(0.0)
    r1 = diffusion.denoise_step(o2, 3, 1, nz, acpX, r1, rec, false)
    chk(near(as_f64(rec[0]), 1.0) && near(as_f64(rec[2]), 3.0), "denoise t=1 (no sample) reconstruct x0")
    var stoch: array<f32, 1024> = array_init(0.0)
    r1 = diffusion.denoise_step(o2, 3, 1, nz, acpX, r1, stoch, true)
    var differs: bool = false
    jj = 0
    while jj < 3 {
        if absf(as_f64(stoch[jj]) - as_f64(rec[jj])) > 0.0001 {
            differs = true
        }
        jj = jj + 1
    }
    chk(differs, "denoise t=1 with sample adds sigma noise (sigma from beta)")

    // ===================== sample 全环（模型解耦，predict-noise 表） =====================
    var acpS: array<f64, 1024> = array_init(0.0)
    acpS[0] = 1.0; acpS[1] = 0.64; acpS[2] = 0.36   // steps=3
    var seed: array<f32, 1024> = array_init(0.0)
    seed[0] = 2.0; seed[1] = 1.0
    var eno: array<f32, 1024> = array_init(0.0)
    // 目标 x0（2 元素）；用已知 noise 表做确定性反演应回 x0
    eno[0] = 1.0; eno[1] = 0.5; eno[2] = 1.0; eno[3] = 0.5; eno[4] = 1.0; eno[5] = 0.5
    // 先加噪到最高步(2)：x=√0.36 x0 + √0.64 ε
    var xn: array<f32, 1024> = array_init(0.0)
    var r2 = trng.new(4)
    var ne: array<f32, 1024> = array_init(0.0)
    ne[0] = 1.0; ne[1] = 0.5
    r2 = diffusion.add_noise(seed, 2, 2, ne, acpS, xn, r2)
    var sres: array<f32, 1024> = array_init(0.0)
    r2 = diffusion.sample(xn, 2, 3, acpS, eno, r2, sres, false)
    // 一致性校验：sample 全环 == 逐段调用 denoise_step（同样 eno 表、strat=false，确定性）
    var enoA: array<f32, 1024> = array_init(0.0)
    var enoB: array<f32, 1024> = array_init(0.0)
    var enoC: array<f32, 1024> = array_init(0.0)
    enoA[0] = eno[4]; enoA[1] = eno[5]
    enoB[0] = eno[2]; enoB[1] = eno[3]
    enoC[0] = eno[0]; enoC[1] = eno[1]
    var cur: array<f32, 1024> = array_init(0.0)
    var tmpM: array<f32, 1024> = array_init(0.0)
    cur[0] = xn[0]; cur[1] = xn[1]
    var rm = trng.new(6)
    rm = diffusion.denoise_step(cur, 2, 2, enoA, acpS, rm, tmpM, false)
    cur[0] = tmpM[0]; cur[1] = tmpM[1]
    rm = diffusion.denoise_step(cur, 2, 1, enoB, acpS, rm, tmpM, false)
    cur[0] = tmpM[0]; cur[1] = tmpM[1]
    rm = diffusion.denoise_step(cur, 2, 0, enoC, acpS, rm, tmpM, false)
    cur[0] = tmpM[0]; cur[1] = tmpM[1]
    chk(near(as_f64(sres[0]), as_f64(cur[0])) && near(as_f64(sres[1]), as_f64(cur[1])), "sample == sequential denoise_step")

    // ===================== zscore / zscore_stat / denorm =====================
    var zs: array<f32, 1024> = array_init(0.0)
    zs[0] = 2.0; zs[1] = 4.0; zs[2] = 4.0; zs[3] = 4.0; zs[4] = 5.0; zs[5] = 5.0; zs[6] = 7.0; zs[7] = 9.0
    var st0 = data.zscore_stat(zs, 8)
    chk(near(st0.m, 5.0) && near(st0.s, 2.0), "zscore_stat m=5 s=2")
    data.zscore(zs, 8)
    var st1 = data.zscore_stat(zs, 8)
    chk(near(st1.m, 0.0) && near(st1.s, 1.0), "zscore -> mean 0 std 1")
    chk(near(as_f64(zs[0]), -1.5), "zscore z0 = (2-5)/2 = -1.5")
    data.denorm(zs, 8, 5.0, 2.0)
    chk(near(as_f64(zs[0]), 2.0) && near(as_f64(zs[7]), 9.0), "denorm restores original")
    var cst: array<f32, 1024> = array_init(0.0)
    cst[0] = 3.0; cst[1] = 3.0; cst[2] = 3.0
    data.zscore(cst, 3)
    chk(as_f64(cst[0]) == 0.0 && as_f64(cst[2]) == 0.0, "zscore std0 -> zeros")

    // ===================== shuffle_tiles =====================
    var starr: array<f32, 1024> = array_init(0.0)
    var k: i64 = 0
    while k < 16 {
        starr[k] = as_f32(as_f64(k))
        k = k + 1
    }
    var r3 = trng.new(7)
    r3 = data.shuffle_tiles(starr, 1, 16, r3)
    var conserve: bool = true
    var v: i64 = 0
    while v < 16 {
        var c: i64 = 0
        var idx: i64 = 0
        while idx < 16 {
            if as_i64(starr[idx]) == v {
                c = c + 1
            }
            idx = idx + 1
        }
        if c != 1 {
            conserve = false
        }
        v = v + 1
    }
    chk(conserve, "shuffle_tiles (tile=1) preserves 16-multiset")
    // tile=2 整块守恒：每 tile 值 = i*10 成对，交换后仍成对
    var tp: array<f32, 1024> = array_init(0.0)
    k = 0
    while k < 8 {
        tp[k * 2] = as_f32(as_f64(k * 10))
        tp[k * 2 + 1] = as_f32(as_f64(k * 10))
        k = k + 1
    }
    r3 = data.shuffle_tiles(tp, 2, 8, r3)
    var intact: bool = true
    var setsame: bool = true
    k = 0
    while k < 8 {
        if tp[k * 2] != tp[k * 2 + 1] {
            intact = false
        }
        k = k + 1
    }
    // 多集：每个 0,10,...,70 恰好出现两次
    var q: i64 = 0
    while q < 8 {
        var c2: i64 = 0
        var ii2: i64 = 0
        while ii2 < 8 {
            if as_i64(tp[ii2 * 2]) == q * 10 {
                c2 = c2 + 1
            }
            ii2 = ii2 + 1
        }
        if c2 != 1 {
            setsame = false
        }
        q = q + 1
    }
    chk(intact, "shuffle_tiles tile=2 keeps tiles whole")
    chk(setsame, "shuffle_tiles tile=2 multiset preserved")

    // ===================== batch_slice =====================
    var bs: array<f32, 1024> = array_init(0.0)
    k = 0
    while k < 8 {
        bs[k] = as_f32(as_f64(10 + k))
        k = k + 1
    }
    var bout: array<f32, 1024> = array_init(0.0)
    var nb0 = data.batch_slice(bs, 8, 3, 0, bout)
    chk(nb0 == 3 && as_f64(bout[0]) == 10.0 && as_f64(bout[2]) == 12.0, "batch0 3 elems [10,12]")
    var nb1 = data.batch_slice(bs, 8, 3, 1, bout)
    chk(nb1 == 3 && as_f64(bout[0]) == 13.0, "batch1 3 elems start 13")
    var nb2 = data.batch_slice(bs, 8, 3, 2, bout)
    chk(nb2 == 2 && as_f64(bout[1]) == 17.0, "batch2 2 elems [16,17]")
    var nb3 = data.batch_slice(bs, 8, 3, 3, bout)
    chk(nb3 == 0, "batch3 out of range -> 0")

    // ===================== tile_checkpoint / tile_log =====================
    var ckpath = "tests/_ddpm_probe/_ckpt.csv"
    var logpath = "tests/_ddpm_probe/_log.txt"
    fs.remove(ckpath)
    fs.remove(logpath)
    data.tile_checkpoint(ckpath, 10, 0.5, 0.1)
    data.tile_checkpoint(ckpath, 11, 0.3, 0.2)
    data.tile_log(logpath, "epoch1 done")
    var clines = fs.read_lines(ckpath)
    var el1 = to_string(10) + "," + to_string(0.5) + "," + to_string(0.1)
    var el2 = to_string(11) + "," + to_string(0.3) + "," + to_string(0.2)
    chk(len(clines) == 2, "checkpoint 2 CSV rows")
    chk(clines[0] == el1 && clines[1] == el2, "checkpoint rows match step,loss,mse")
    var llines = fs.read_lines(logpath)
    chk(len(llines) == 1 && llines[0] == "epoch1 done", "tile_log append round-trip")

    // ===================== tile_load（raw f32 高度图 tile） =====================
    var tilepath = "tests/_ddpm_probe/_tile_f32.bin"
    var tw: array<f32, 1024> = array_init(0.0)
    tw[0] = 1.5; tw[1] = -2.25; tw[2] = 3.75
    chk(serde.save_weights(tw, 3, tilepath), "tile raw write ok")
    var tpool: array<f32, 1024> = array_init(0.0)
    var tcnt = data.tile_load(tpool, tilepath)
    chk(tcnt == 3, "tile_load count == 3 f32")
    chk(near(as_f64(tpool[0]), 1.5) && near(as_f64(tpool[1]), -2.25) && near(as_f64(tpool[2]), 3.75), "tile_load values match")

    // ===================== serde =====================
    var wpa = "tests/_ddpm_probe/_w.bin"
    var wsp: array<f32, 1024> = array_init(0.0)
    wsp[0] = 0.1; wsp[1] = -0.2; wsp[2] = 0.3; wsp[3] = 1.5; wsp[4] = -2.5
    chk(serde.save_weights(wsp, 5, wpa), "save_weights ok")
    var back: array<f32, 1024> = array_init(0.0)
    var rd = serde.load_weights(back, 5, wpa)
    var rr2: bool = true
    k = 0
    while k < 5 {
        if !near(as_f64(back[k]), as_f64(wsp[k])) {
            rr2 = false
        }
        k = k + 1
    }
    chk(rd == 5 && rr2, "save_weights->load_weights round-trip elementwise==")
    var cpa = "tests/_ddpm_probe/_ckpt.bin"
    chk(serde.save_checkpoint(12345, wsp, 4, cpa), "save_checkpoint ok")
    var cback: array<f32, 1024> = array_init(0.0)
    var step = serde.load_checkpoint(cback, 4, cpa)
    var crr: bool = true
    k = 0
    while k < 4 {
        if !near(as_f64(cback[k]), as_f64(wsp[k])) {
            crr = false
        }
        k = k + 1
    }
    chk(step == 12345, "load_checkpoint returns step")
    chk(crr, "load_checkpoint weights match (offset 8)")
    // 损坏文件（截断 <8 字节）→ -1
    var badp = "tests/_ddpm_probe/_bad.bin"
    var tmpB: Buf = buf.new()
    tmpB = buf.push_f32(tmpB, 1.0)
    buf.write_bytes(tmpB, badp)
    chk(serde.load_checkpoint(back, 5, badp) == -1, "load_checkpoint truncated -> -1")

    // ===================== 端到端：1 层 linear 训噪声预测 =====================
    var img: array<f32, 1024> = array_init(0.0)
    k = 0
    while k < 64 {
        img[k] = as_f32(as_f64(k % 16) / 16.0)
        k = k + 1
    }
    var betas = diffusion.schedule_linear(200, 0.0001, 0.02)
    var acpf = diffusion.alpha_cumprod_f32(betas, 200)
    var acpf64: array<f64, 1024> = array_init(0.0)
    var ww: i64 = 0
    while ww < 200 {
        acpf64[ww] = as_f64(acpf[ww])
        ww = ww + 1
    }
    var r4 = trng.new(202)
    var eps: array<f32, 1024> = array_init(0.0)
    k = 0
    while k < 64 {
        var pg = trng.gauss(r4)
        r4 = pg.r2
        eps[k] = as_f32(pg.v2)
        k = k + 1
    }
    eps[0] = 1.0   // 确保 noise 池被采用（非 0）
    var xt: array<f32, 1024> = array_init(0.0)
    r4 = diffusion.add_noise(img, 64, 100, eps, acpf64, xt, r4)
    data.zscore(xt, 64)     // 输入特征
    // 1 层 linear：64 → 16 预测噪声片段（W 64*16=1024）
    var W1: array<f32, 1024> = array_init(0.0)
    var b1: array<f32, 1024> = array_init(0.0)
    var mW: array<f32, 1024> = array_init(0.0)
    var vW: array<f32, 1024> = array_init(0.0)
    var mb: array<f32, 1024> = array_init(0.0)
    var vb: array<f32, 1024> = array_init(0.0)
    k = 0
    while k < 1024 {
        var pr = trng.range(r4, -0.05, 0.05)
        r4 = pr.r2
        W1[k] = as_f32(pr.v2)
        k = k + 1
    }
    var lr = 0.02
    var wd = 0.0001
    var l0: f64 = 0.0
    var l50: f64 = 0.0
    var s0: i64 = 0
    while s0 < 50 {
        var pred: array<f32, 1024> = array_init(0.0)
        nn.linear_forward(pred, xt, 64, W1, 1024, b1, 16, 16)
        var ls = loss.mse(pred, 16, eps, 16)
        if s0 == 0 {
            l0 = ls
        }
        if s0 == 49 {
            l50 = ls
        }
        var gy: array<f32, 1024> = array_init(0.0)
        loss.mse_grad(gy, pred, eps, 16)          // grad wrt pred
        var gx: array<f32, 1024> = array_init(0.0)
        var gW: array<f32, 1024> = array_init(0.0)
        var gb: array<f32, 1024> = array_init(0.0)
        nn.linear_backward(gx, gy, xt, 64, W1, 1024, 16, gW, gb)
        var stp = s0 + 1
        optim.adamw_step(W1, 1024, gW, mW, vW, stp, lr, wd, 0.9, 0.999, 0.00000001)
        optim.adamw_step(b1, 16, gb, mb, vb, stp, lr, wd, 0.9, 0.999, 0.00000001)
        s0 = s0 + 1
    }
    println("e2e train loss l0=" + to_string(l0) + "  l50=" + to_string(l50))
    chk(l50 < l0 && l0 > 0.0, "e2e noise-pred loss decreases (l0>l50)")
    chk(near(loss.mse(eps, 16, eps, 16), 0.0), "sanity: self-mse = 0")

    if fails == 0 {
        println("PASS ALL " + to_string(npass) + " asserts")
    } else {
        println("FAILS=" + to_string(fails) + " / npass=" + to_string(npass))
        exit(1)
    }
}