type tie<logic>
// tests/_p91117_process_probe/process_probe.tie —— p.9.1.1.17 验收：std/process 超时强杀。
// Windows 确定性探针：
//   1. 慢命令（ping -n 3，约 2s）设 200ms 超时 → timed_out=true（强杀）；
//   2. 正常快命令（echo）在 5000ms 内完成 → timed_out=false、exit==0；
//   3. 显式退出码命令（exit 7）→ timed_out=false、exit==7；
//   4. exec_code_timeout 别名与 timeout_run 等价。
// 期望全部 PASS / exit 0。
import "../../std/process.tie" as process

var fails: i64 = 0

func check(cond: bool, msg: string) {
    if cond {
        println("PASS " + msg)
    } else {
        println("FAIL " + msg)
        fails = fails + 1
    }
}

func main() {
    // 1) 慢命令超时 → timed_out=true
    var (e1, t1) = process.timeout_run("ping -n 3 127.0.0.1", 200)
    check(t1 == true, "slow ping times out (timed_out=true), e=" + to_string(e1))

    // 2) 快命令不超时 → exit 0
    var (e2, t2) = process.timeout_run("echo hello", 5000)
    check(t2 == false, "echo not timed out")
    check(e2 == 0, "echo exit == 0 (got " + to_string(e2) + ")")

    // 3) 显式退出码命令
    var (e3, t3) = process.timeout_run("exit 7", 5000)
    check(t3 == false, "exit 7 not timed out")
    check(e3 == 7, "exit 7 propagates (got " + to_string(e3) + ")")

    // 4) exec_code_timeout 别名等价
    var (e4, t4) = process.exec_code_timeout("echo ok", 5000)
    check(t4 == false && e4 == 0, "exec_code_timeout alias emulates timeout_run")

    // 5) 慢命令经 exec_code_timeout 亦超时
    var (e5, t5) = process.exec_code_timeout("ping -n 3 127.0.0.1", 200)
    check(t5 == true, "exec_code_timeout slow ping times out")

    if fails == 0 {
        println("PASS")
    } else {
        println("FAILED")
    }
}