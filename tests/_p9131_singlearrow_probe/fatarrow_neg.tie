type tie<logic>
// ============================================================
// p.9.13.1 单箭头统一负例探针：源码里使用已移除的 `=>` 应报「已移除」诊断。
//   期望编译失败，诊断文本含「`=>` 已移除，请用 `->`」。
//   （本文件故意不可编译，由验证脚本单独驱动并断言失败。）
// ============================================================
func f(n: i64) -> i64 {
    return switch n {
        0 => 42,
        _ => -1
    }
}

func main() {
    println(to_string(f(0)))
}