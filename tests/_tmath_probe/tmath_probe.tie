type tie<logic>
// tests/_tmath_probe/tmath_probe.tie —— L2 tmath 数学壳库探针
// 覆盖：relu/sigmoid/tanh 关键点、gelu(0) 与渐进、softplus、silu、clamp、lerp、
//       smoothstep、step、softmax_3 归一和=1、softmax 溢出安全（极大输入）、
//       mean64/var64/std64/max64/min64 手算对照、mean512 抽样对照。
// 编译运行（tiec 根目录）：compiler\tiec.exe --no-cache tests\_tmath_probe\tmath_probe.tie
//                            -o tests\_tmath_probe\tmath_probe.exe
// 然后运行 tests\_tmath_probe\tmath_probe.exe。

import "/ext/tmath.tie"
using tmath;

var fails: i64 = 0

// 浮点近似比较：|a-b| <= eps（容差断言辅助）
func near(a: f64, b: f64, eps: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 {
        d = 0.0 - d
    }
    return d <= eps
}

// 断言辅助：条件为假则计 FAIL 并打印
func chk(cond: bool, msg: string) {
    if cond {
        println("PASS   " + msg)
    } else {
        fails = fails + 1
        println("FAIL   " + msg)
    }
}

func main() {
    // --- relu 关键点 ---
    chk(relu(-3.0) == 0.0, "relu(-3)=0")                                   // 1
    chk(relu(0.0) == 0.0, "relu(0)=0")                                     // 2
    chk(relu(5.0) == 5.0, "relu(5)=5")                                     // 3
    chk(leaky_relu(-1.0, 0.1) == -0.1, "leaky_relu(-1,0.1)=-0.1")          // 4
    chk(leaky_relu(2.0, 0.1) == 2.0, "leaky_relu(2,0.1)=2")                // 5

    // --- sigmoid 关键点 ---
    chk(sigmoid(0.0) == 0.5, "sigmoid(0)=0.5")                             // 6
    chk(near(sigmoid(1.0), 0.731059, 0.00001), "sigmoid(1)~0.731059")       // 7
    chk(near(sigmoid(-1.0), 1.0 - sigmoid(1.0), 0.000000001), "sigmoid(-1)=1-sig(1)") // 8

    // --- tanh 关键点（裸内建；gelu 亦依赖 tanh）---
    chk(tanh(0.0) == 0.0, "tanh(0)=0")                                     // 9
    chk(near(tanh(1.0), 0.0 - tanh(-1.0), 0.000000001), "tanh odd (tanh(1)=-tanh(-1))") // 10
    chk(near(tanh(10.0), 1.0, 0.000001), "tanh(10)~1 asymptotic")           // 11

    // --- gelu：x=0 为 0，且大正趋于 x、奇对称 ---
    chk(gelu(0.0) == 0.0, "gelu(0)=0")                                     // 12
    chk(near(gelu(1.0), 0.841, 0.001), "gelu(1)~0.841")                    // 13
    chk(near(gelu(-1.0), -0.1588, 0.002), "gelu(-1)~-0.1588")            // 14
    chk(near(gelu(5.0), 5.0, 0.001), "gelu(5)~5 asymptote")                // 15

    // --- softplus / silu ---
    chk(near(softplus(0.0), 0.693147, 0.00001), "softplus(0)~ln2")         // 16
    chk(near(softplus(20.0), 20.0, 0.0001), "softplus(20)~20")            // 17
    chk(silu(0.0) == 0.0, "silu(0)=0")                                     // 18
    chk(near(silu(1.0), 0.731059, 0.00001), "silu(1)~sigmoid(1)")          // 19

    // --- clamp / lerp ---
    chk(clamp(-1.0, 0.0, 1.0) == 0.0, "clamp(-1,0,1)=0")                   // 20
    chk(clamp(2.0, 0.0, 1.0) == 1.0, "clamp(2,0,1)=1")                     // 21
    chk(clamp(0.5, 0.0, 1.0) == 0.5, "clamp(0.5,0,1)=0.5")                 // 22
    chk(lerp(0.0, 1.0, 0.0) == 0.0, "lerp(0,1,0)=0")                       // 23
    chk(lerp(0.0, 1.0, 0.5) == 0.5, "lerp(0,1,0.5)=0.5")                   // 24
    chk(lerp(0.0, 1.0, 1.0) == 1.0, "lerp(0,1,1)=1")                       // 25

    // --- smoothstep / step ---
    chk(smoothstep(0.0, 1.0, 0.0) == 0.0, "smoothstep(0)=0")               // 26
    chk(smoothstep(0.0, 1.0, 0.5) == 0.5, "smoothstep(0.5)=0.5")           // 27
    chk(smoothstep(0.0, 1.0, 1.0) == 1.0, "smoothstep(1)=1")               // 28
    chk(step(-1.0) == 0.0, "step(-1)=0")                                   // 29
    chk(step(0.0) == 1.0, "step(0)=1")                                     // 30
    chk(step(5.0) == 1.0, "step(5)=1")                                     // 31

    // --- softmax_3：归一和=1，且顺序保持 ---
    var sm = tmath.softmax_3(1.0, 2.0, 3.0)
    chk(near(sm.s1 + sm.s2 + sm.s3, 1.0, 0.000000001), "softmax_3 sum=1")  // 32
    chk(sm.s3 > sm.s2 && sm.s2 > sm.s1, "softmax_3 order preserved")       // 33
    chk(near(sm.s1, 0.0900306, 0.00001), "softmax_3(1,2,3).s1~0.0900")     // 34

    // --- softmax 溢出安全：极大输入不得产生 inf/NaN，且仍需归一 ---
    var sb = tmath.softmax_3(1000.0, 1001.0, 1002.0)
    chk(near(sb.s1 + sb.s2 + sb.s3, 1.0, 0.000000001), "softmax overflow-safe sum=1") // 35
    chk(sb.s1 > 0.0 && sb.s1 < 1.0 && sb.s3 > sb.s2, "softmax finite & ordered") // 36

    // --- 窗口 64 统计：手算对照 [4,8,6] ---
    var xs64: array<f64, 64> = array_init(0.0)
    xs64[0] = 4.0
    xs64[1] = 8.0
    xs64[2] = 6.0
    chk(mean64(xs64, 3) == 6.0, "mean64[4,8,6]=6")                         // 37
    chk(near(var64(xs64, 3), 2.666667, 0.0001), "var64[4,8,6]~2.6667")     // 38
    chk(near(std64(xs64, 3), 1.632993, 0.0001), "std64[4,8,6]~1.6330")     // 39
    chk(max64(xs64, 3) == 8.0, "max64[4,8,6]=8")                           // 40
    chk(min64(xs64, 3) == 4.0, "min64[4,8,6]=4")                           // 41

    // --- 窗口 512 统计：抽样对照 xs[i]=i ---
    var xs512: array<f64, 512> = array_init(0.0)
    var k: i64 = 0
    while k < 512 {
        xs512[k] = as_f64(k)
        k = k + 1
    }
    chk(mean512(xs512, 8) == 3.5, "mean512[i:i<8]=3.5")                    // 42
    chk(mean512(xs512, 512) == 255.5, "mean512[0..511]=255.5")             // 43
    chk(max512(xs512, 512) == 511.0, "max512[0..511]=511")                 // 44
    chk(min512(xs512, 512) == 0.0, "min512[0..511]=0")                     // 45
    chk(near(var512(xs512, 4), 1.25, 0.000001), "var512[0,1,2,3]=1.25")    // 46

    if fails == 0 {
        println("ALL PASS (" + to_string(46) + " asserts, 0 fail)")
    } else {
        println("FAIL total=" + to_string(fails))
    }
}