type tie<logic>
// tests/_p911_zlib_probe/zlib_probe.tie —— p.9.1.1.1 验收：std/zlib zlib/gzip 库。
// 全离线确定性探针：
//   1. crc32/adler32 与已知向量对拍；
//   2. deflate→inflate 回环（纯文本 / 重复数据算 LZ77 / 空输入 / 二进制表）；
//   3. zlib compress→decompress 回环；
//   4. gzip_compress→gzip_decompress 回环（含 CRC/ISIZE 校验）；
//   5. inflate 外部 zlib 生成向量（stored/fixed/dynamic 三型，Python 开发期生成）；
//   6. 负例：坏 zlib 头 / 坏 gzip 魔数 / 坏 adler 尾 → 返回 false 不挂死。
// 期望全部 PASS / exit 0。
import "/std/zlib.tie" as zlib

var fails: i64 = 0

func check(cond: bool, msg: string) {
    if cond {
        println("PASS " + msg)
    } else {
        println("FAIL " + msg)
        fails = fails + 1
    }
}

func hexv(c: i64) -> i64 {
    if c >= 0x30 && c <= 0x39 {
        return c - 0x30
    }
    if c >= 0x61 && c <= 0x66 {
        return c - 0x61 + 10
    }
    if c >= 0x41 && c <= 0x46 {
        return c - 0x41 + 10
    }
    return -1
}

func hexbytes(s: string) -> table<i64> {
    var t = table_new_i64()
    var nib: i64 = -1
    var n = str_len(s)
    var i: i64 = 0
    while i < n {
        var v = hexv(str_byte(s, i))
        if v >= 0 {
            if nib < 0 {
                nib = v
            } else {
                table_push(t, nib * 16 + v)
                nib = -1
            }
        }
        i = i + 1
    }
    return t
}

func sb(s: string) -> table<i64> {
    var t = table_new_i64()
    var n = str_len(s)
    var i: i64 = 0
    while i < n {
        table_push(t, str_byte(s, i))
        i = i + 1
    }
    return t
}

func bytes_eq(a: table<i64>, b: table<i64>) -> bool {
    if len(a) != len(b) {
        return false
    }
    var i: i64 = 0
    while i < len(a) {
        if a[i] != b[i] {
            return false
        }
        i = i + 1
    }
    return true
}

func section_checksum() {
    check(zlib.crc32(sb("123456789")) == 0xCBF43926, "crc32 123456789 == 0xCBF43926")
    check(zlib.adler32(sb("Wikipedia")) == 0x11E60398, "adler32 Wikipedia == 0x11E60398")
    // gzip 空内容 CRC 已知值 0, ISIZE 0
    var empty = table_new_i64()
    check(zlib.crc32(empty) == 0, "crc32 empty == 0")
    check(zlib.adler32(empty) == 1, "adler32 empty == 1")
}

// "a"*64+"b"*64.
func build_ab() -> table<i64> {
    var t = table_new_i64()
    var i: i64 = 0
    while i < 64 {
        table_push(t, str_byte("a", 0))
        i = i + 1
    }
    i = 0
    while i < 64 {
        table_push(t, str_byte("b", 0))
        i = i + 1
    }
    return t
}

// 长重复串（触发 LZ77 长匹配）。
func build_rep() -> table<i64> {
    var t = table_new_i64()
    var k: i64 = 0
    while k < 300 {
        table_push(t, str_byte("x", 0))
        k = k + 1
    }
    k = 0
    while k < 100 {
        table_push(t, str_byte("y", 0))
        k = k + 1
    }
    return t
}

func section_deflate_roundtrip() {
    var empty = table_new_i64()
    var r1 = zlib.inflate(zlib.deflate(empty))
    check(r1.0 && len(r1.1) == 0, "deflate empty roundtrip")

    var r2 = zlib.inflate(zlib.deflate(sb("Hello, Tie zlib!")))
    check(r2.0 && bytes_eq(r2.1, sb("Hello, Tie zlib!")), "deflate text roundtrip")

    var r3 = zlib.inflate(zlib.deflate(build_ab()))
    check(r3.0 && bytes_eq(r3.1, build_ab()), "deflate a*64+b*64 roundtrip (LZ77)")

    var r4 = zlib.inflate(zlib.deflate(build_rep()))
    check(r4.0 && bytes_eq(r4.1, build_rep()), "deflate long-run roundtrip (LZ77)")

    // 二进制表（全字节 0..255 两遍）——覆盖 ≥0x80 字节，string 承载不了
    var bin = table_new_i64()
    var i: i64 = 0
    while i < 256 {
        table_push(bin, (i * 7 + 3) & 0xFF)
        i = i + 1
    }
    var r5 = zlib.inflate(zlib.deflate(bin))
    check(r5.0 && bytes_eq(r5.1, bin), "deflate binary table roundtrip")

    // 压缩确实变小（文本重复数据）
    var cmp = zlib.deflate(build_rep())
    check(len(cmp) < len(build_rep()), "deflate compresses long repeats")
}

func section_zlib_roundtrip() {
    var a = build_ab()
    var z = zlib.compress(a)
    // zlib 头 0x78 0x01
    check(len(z) >= 2 && z[0] == 0x78, "zlib header CM=0x78")
    var r = zlib.decompress(z)
    check(r.0 && bytes_eq(r.1, a), "zlib compress->decompress roundtrip")

    var empty = table_new_i64()
    var ze = zlib.compress(empty)
    var re = zlib.decompress(ze)
    check(re.0 && len(re.1) == 0, "zlib empty roundtrip")
}

func section_gzip_roundtrip() {
    var a = build_ab()
    var g = zlib.gzip_compress(a)
    // 魔数
    check(len(g) >= 2 && g[0] == 0x1F && g[1] == 0x8B, "gzip magic")
    var r = zlib.gzip_decompress(g)
    check(r.0 && bytes_eq(r.1, a), "gzip compress->decompress roundtrip")

    var empty = table_new_i64()
    var ge = zlib.gzip_compress(empty)
    var re = zlib.gzip_decompress(ge)
    check(re.0 && len(re.1) == 0, "gzip empty roundtrip")
}

func section_inflate_vectors() {
    // Python zlib.compressobj(level=0) 生成：BTYPE=00 存储块
    var s1 = zlib.inflate(hexbytes("01 03 00 FC FF 41 42 43"))
    check(s1.0 && bytes_eq(s1.1, sb("ABC")), "inflate stored block -> ABC")

    // Python zlib.compressobj(level=1) 生成：固定 Huffman
    var s2 = zlib.decompress(hexbytes("78 01 F3 48 CD C9 C9 57 04 00 07 A2 02 16"))
    check(s2.0 && bytes_eq(s2.1, sb("Hello!")), "zlib fixed huffman -> Hello!")

    // Python zlib.compressobj(level=6) 生成：动态 Huffman
    var s3 = zlib.decompress(hexbytes("78 9C 4B 4C A4 0C 24 51 08 00 41 94 30 C1"))
    check(s3.0 && bytes_eq(s3.1, build_ab()), "zlib dynamic huffman -> a*64+b*64")
}

func section_invalid() {
    var r1 = zlib.decompress(hexbytes("00 01 02"))
    check(r1.0 == false, "decompress bad header -> false")
    var r2 = zlib.decompress(hexbytes("01 02 03 04 05 06 07 08"))
    check(r2.0 == false, "decompress invalid CMF -> false")
    // 合法头但 adler 尾错
    var z = zlib.compress(sb("hi"))
    z[len(z) - 1] = z[len(z) - 1] ^ 0xFF
    var r3 = zlib.decompress(z)
    check(r3.0 == false, "decompress bad adler trailer -> false")
    // 坏 gzip 魔数
    var g = zlib.gzip_compress(sb("x"))
    g[0] = 0x40
    var r4 = zlib.gzip_decompress(g)
    check(r4.0 == false, "gzip bad magic -> false")
}

func main() {
    println("start")
    section_checksum()
    section_deflate_roundtrip()
    section_zlib_roundtrip()
    section_gzip_roundtrip()
    section_inflate_vectors()
    section_invalid()
    if fails == 0 {
        println("PASS")
    } else {
        println("FAIL count=" + to_string(fails))
    }
    println("done")
}