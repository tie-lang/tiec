type tie<logic>

// ============================================================
// p.8.1.3 泛型增强验收：约束 / 特化 / 变长泛型
//
// 覆盖场景：
//   1. 变长泛型：`func g_sum<T>(items: ...T)` 任意个数实参（元素类型 T 推断）
//   2. 显式特化：`func max<string>(...)` string 专用实现（长度比较）——调用点
//      instantiate_fn 幂等命中特化签名，自动优先于通用模板实例化
//   3. 特化不干扰其它实例：max(3,5) 仍走通用模板（i64 实例）
//   4. 多类型参数特化：`func pick<i64, string>(...)` 绑定 A/B 具体类型
//   5. 约束（port 约束 <T: Drawable> + 静态分发）已有专测
//      （tests/s24_probe/probe1_static.tie），此处不再重复
//
// 期望输出（逐行，与 println 一一对应）：
//   10 / 21 / 0 / aaa / yy / 5 / 100 / 3.500000
// ============================================================

// 变长泛型：元素类型 T 由实参推断，任意个数
func g_sum<T>(items: ...T) -> i64 {
    var s: i64 = 0
    var i: i64 = 0
    while i < len(items) {
        s = s + as_i64(items[i])
        i = i + 1
    }
    return s
}

// 通用模板：max（按 > 比较；string 按字节序）
func max<T>(a: T, b: T) -> T {
    if a > b {
        return a
    }
    return b
}

// 显式特化：max<string> 专用实现（按长度比较——与通用模板行为可区分）
func max<string>(a: string, b: string) -> string {
    if len(a) > len(b) {
        return a
    }
    return b
}

// 多类型参数 + 特化：pick<A,B> 通用 + pick<i64, string> 特化（返回 a*100）
func pick<A, B>(a: A, b: B) -> A {
    return a
}
func pick<i64, string>(a: i64, b: string) -> i64 {
    return a * 100
}

func main() {
    // 1. 变长泛型：4 个实参 / 1 个实参 / 0 个实参
    println(g_sum(1, 2, 3, 4))        // 10
    println(g_sum(21))                // 21
    println(g_sum<i64>())             // 0（空变参：显式类型实参指定 T）
    // 2. 特化 string 版本（长度比较）
    println(max("zz", "aaa"))         // 特化 → "aaa"（len 3 > 2；通用模板按字节序会返回 "zz"）
    println(max("x", "yy"))           // 特化 → "yy"
    // 3. 特化不干扰其它实例：i64 走通用模板
    println(max(3, 5))                // 5
    // 4. 多类型参数特化：pick<i64,string>（a*100）；pick(3.5,"x") 走通用模板
    println(pick(1, "hi"))            // 特化 → 100
    var p2 = pick(3.5, "x")
    println(p2)                       // 3.5
}
