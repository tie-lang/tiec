type tie<logic>

// ============================================================
// p.8.2.4 负例：未声明 op_add 的 struct 写 a + b → 保持原语义/诊断路径
// （运算符重载只发生在「任一操作数类型为用户 struct 且该 struct 声明了对应
// op_ 方法」时；未声明则走既有算术运算符诊断，编译拒绝）。
// 负例仅用于门禁验证 req 部，不应可编译运行。
// ============================================================

struct Plain {
    var v: i64 = 0
}

func main() {
    var p1 = Plain(1)
    var p2 = Plain(2)
    var r = p1 + p2   // Plain 未定义 op_add → 编译错误（算术运算符不能用于 Plain）
    println(to_string(r.v))
}