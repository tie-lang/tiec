type tie<logic>
// 规范 §2.11 文本解析族：to_i64(s) / to_f64(s)（正例；本表只做编译门禁，
// 运行值由 tests/s22_probe/to_num_text_probe.tie 断言）。
// 修复前：字符串实参被后端直通进数值槽 ⇒ 任意 -l 档均 E00883（ptr→i64/f64）。
func main() -> i64 {
    var s = "4096"
    var n = to_i64(s)                 // 变量实参
    var m = to_i64("7")               // 字面量实参
    var f = to_f64("3.5")
    var g = to_f64(s + ".25")         // 表达式结果
    // 窄化必须显式嵌套（文本解析只到 i64/f64）
    var k = to_i32(to_i64("12"))
    println(to_string(n) + "," + to_string(m) + "," + to_string(f) + "," +
            to_string(g) + "," + to_string(k))
    return 0
}
