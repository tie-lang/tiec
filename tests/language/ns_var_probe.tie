type tie<logic>

// 命名空间内的全局变量：私有 var（模块私有）+ pub var（跨文件可读写）、
// 多命名空间块同名成员互不干扰、复合赋值。
// 限定访问统一用 ns::name（与 ns::func() 同一条路径）。

namespace nsv_a {
    var g_priv: i64 = 10
    pub var g_pub: i64 = 20

    pub func sum() -> i64 {
        return g_priv + g_pub
    }

    pub func bump() {
        g_priv += 1
        g_pub += 1
    }
}

namespace nsv_b {
    pub var x: i64 = 2
}

// 命名空间内的表全局：元素类型须随命名空间解析（gb_telem 走 ns 前缀补全），
// 否则 table_push 会按 i64 默认元素类型误报 E00032。
namespace nsv_t {
    pub var names: table<string> = []

    pub func add(s: string) {
        table_push(names, s)
    }

    pub func first() -> string {
        return names[0]
    }
}

func main() {
    println(nsv_a::sum())      // 30
    nsv_a::bump()
    println(nsv_a::sum())      // 32
    nsv_a::g_pub = 100
    println(nsv_a::sum())      // 111
    nsv_a::g_pub += 1
    println(nsv_a::g_pub)      // 101
    println(nsv_b::x)          // 2
    nsv_b::x = 7
    println(nsv_b::x)          // 7
    nsv_t::add("abc")
    println(nsv_t::first())    // abc
}
