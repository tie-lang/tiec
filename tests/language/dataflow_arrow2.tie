type tie<logic>

// ============================================================
// p.8.2.8 数据流箭头 -> / <- 增强与推广验收（不改词法 token，`->`/`<-` 恒为
//   数据流箭头——tie 闭包唯一语法 func(...){...} 无裸 lambda 参数箭头，故无歧义）。
// 在 P1 基础语义（见 dataflow_arrow.tie）之上推广：
//   1. 裸函数名链式：x -> f -> g -> h ≡ h(g(f(x)))（左结合解析，等价右结合结果）
//   2. 反向管道：目标在左 f() <- x ≡ f(x)（数据作末参）；多段反向
//   3. 方法调用管道：x -> obj.m()（数据追加为该调用末参）
//   4. 完整调用形态 x -> f(1,2)：数据追加为末参 f(1,2,x)（D1，与既有探针一致）
//   5. 与 p.8.2.9 尾随闭包 / p.8.2.5 推导式 组合（D4/D5）
// 裁决（详见 pexpr.parse_arrow 注释 D1–D6）：
//   D1 调用目标数据一律追加为末参；D2 裸字段目标 = 字段赋值（方法管道走
//       obj.m() 调用形态）；D4 尾随闭包先在 unary 层附着、数据再追加为末参
//       （arg 序 …闭包,x）；D6 箭头恒为数据流，无 lambda 歧义。
//
// 期望输出（逐行，与 println 一一对应）：
//   PASS chain / PASS chain3 / PASS reverse / PASS method_pipe /
//   PASS assign / PASS trailing_cb / PASS in_comprehension / PASS nested_arg
// ============================================================

func inc(x: i64) -> i64 { return x + 1 }
func dbl(x: i64) -> i64 { return x * 2 }
func add9(x: i64) -> i64 { return x + 9 }
func addv(a: i64, b: i64) -> i64 { return a + b }

// 方法载体：与结构绑定的命名空间方法（p.8.2.8 方法管道形态 obj.m()）
struct Box {
    var val: i64 = 0
}
namespace Box {
    pub func bump(self: Box, n: i64) -> i64 {
        self.val = self.val + n
        return self.val
    }
}

// 尾随闭包 + 管道组合载体：闭包（fn()->void）形参在前、管道数据追加为末参（D4）
func consume(cb: fn() -> void, xs: table<i64>) -> i64 {
    cb()
    return len(xs)
}

func main() {
    // 1. 裸函数名链式：g(h(f(x)))
    var r = 3 -> inc -> dbl     // dbl(inc(3)) = dbl(4) = 8
    if r == 8 {
        println("PASS chain")
    } else {
        println("FAIL chain r=" + to_string(r))
        exit(1)
    }
    // 2. 三段链式：h
    var c = 3 -> inc -> inc -> inc   // 3+3=6
    if c == 6 {
        println("PASS chain3")
    } else {
        println("FAIL chain3 c=" + to_string(c))
        exit(1)
    }
    // 3. 反向管道：f() <- x ≡ f(x)；多段反向
    var rev = inc() <- 3        // inc(3)=4
    if rev == 4 {
        println("PASS reverse")
    } else {
        println("FAIL reverse rev=" + to_string(rev))
        exit(1)
    }
    // 4. 方法调用管道：x -> obj.m() ＝ obj.m(x)
    var b: Box = Box(0)
    var ms = 10 -> b.bump()      // Box.bump(b, 10) → val=10
    if ms == 10 && b.val == 10 {
        println("PASS method_pipe")
    } else {
        println("FAIL method_pipe ms=" + to_string(ms) + " val=" + to_string(b.val))
        exit(1)
    }
    // 5. 字段/下标赋值形态保持（D2/D3，与 P1 探针一致）
    b.val <- 7
    var arr2: table<i64> = [1, 2, 3]
    arr2[0] <- 9
    if b.val == 7 && arr2[0] == 9 {
        println("PASS assign")
    } else {
        println("FAIL assign val=" + to_string(b.val) + " v=" + to_string(arr2[0]))
        exit(1)
    }
    // 6. 完整调用形态追加末参（D1）+ 尾随闭包组合（D4）
    var xs: table<i64> = [1, 2, 3, 4]
    var tr = xs -> consume() {
        // 块：作为首参闭包（无参 void）；数据 xs 追加为末参
    }
    if tr == 4 {
        println("PASS trailing_cb")
    } else {
        println("FAIL trailing_cb tr=" + to_string(tr))
        exit(1)
    }
    // 7. 尾随闭包等价显式写法（闭包作普通末参，形态自证）
    var tr2 = xs -> consume(func() {})
    if tr2 == 4 {
        println("PASS nested_arg")
    } else {
        println("FAIL nested_arg tr2=" + to_string(tr2))
        exit(1)
    }
    // 8. 与 p.8.2.5 推导式组合：管道嵌在元素表达式（D5）
    var src = [1, 2, 3]
    var out = [addv(k -> inc, 100) for k in src]   // inc(k)+100 = 102/103/104
    if len(out) == 3 && out[0] == 102 && out[1] == 103 && out[2] == 104 {
        println("PASS in_comprehension")
    } else {
        println("FAIL in_comprehension")
        exit(1)
    }
    // 9. 管道嵌作函数实参
    var rr = addv(1 -> inc, 10)   // addv(inc(1),10) = addv(2,10)=12
    if rr == 12 {
        println("PASS nested_arg2")
    } else {
        println("FAIL nested_arg2 rr=" + to_string(rr))
        exit(1)
    }
}