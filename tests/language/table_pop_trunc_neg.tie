type tie<logic>

// ============================================================
// p.8.1.6 负例：table_pop / table_trunc 错误用法应被编译期拒绝
//   1. table_pop 非表参数 → 拒绝
//   2. table_trunc 非表参数 → 拒绝
//   3. table_pop 参数个数错误 → 拒绝
//   4. table_trunc 参数个数错误 → 拒绝
// ============================================================

func main() {
    var x: i64 = 42
    var y = table_pop(x)      // 非表参数
    var t = table_new_i64()
    table_push(t, 1)
    table_trunc(t)            // 参数个数错误
    table_pop(t, 1)           // 参数个数错误
    table_trunc(x, 1)         // 非表参数
    println(y)
}
