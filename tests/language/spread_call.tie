type tie<logic>

// ============================================================
// p.8.2.10 展开/解包调用（spread call）验收：
//   调用实参中允许 `expr...`——expr 为表/数组时按元素序展开为该位置之后的
//   多个实参（与 p.8.1.3 变长形参 `...T` 衔接，展开数量由运行期表长度决定）。
//   语义：固定数量形参在前（普通实参补齐），后随的展开表元素 + 其余实参依序
//   平铺进变长形参打包的动态表。
//      cat(a, b, ...rest) ：
//        cat(5, 6, xs..., 100)  → a=5 b=6 rest=[1,2,3,100]（展开表平铺+后缀）
//        cat(7, 8, ys..., 9)    → a=7 b=8 rest=[10,20,9]
//      sum_all(...xs)：
//        sum_all(xs...)         → 1+2+3=6
//        sum_all(xs..., ys...)  → 1+2+3+10+20=36（多个展开依序平铺）
//
// 期望输出（逐行，与 println 一一对应）：
//   5,6,1,2,3,100 / 7,8,10,20,9 / 6 / 36
// ============================================================

// 固定数量 + 变长形参
func cat(a: i64, b: i64, rest: ...i64) -> string {
    var s: string = to_string(a) + "," + to_string(b)
    var i: i64 = 0
    while i < len(rest) {
        s = s + "," + to_string(rest[i])
        i = i + 1
    }
    return s
}

// 纯变长形参
func sum_all(xs: ...i64) -> i64 {
    var t: i64 = 0
    var i: i64 = 0
    while i < len(xs) {
        t = t + xs[i]
        i = i + 1
    }
    return t
}

func main() {
    var xs = [1, 2, 3]
    var ys = [10, 20]
    // 1. 固定数量形参 + 展开平铺 + 后缀实参
    println(cat(5, 6, xs..., 100))    // 5,6,1,2,3,100
    // 2. 固定数量形参 + 展开表置于中间
    println(cat(7, 8, ys..., 9))      // 7,8,10,20,9
    // 3. 纯变长形参：单个展开
    println(to_string(sum_all(xs...)))    // 6
    // 4. 多个展开依序平铺
    println(to_string(sum_all(xs..., ys...)))  // 36
}