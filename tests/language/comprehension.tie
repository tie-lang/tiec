type tie<logic>

// ============================================================
// p.8.2.5 表/数组推导式（comprehension）验收：
//   [expr for 迭代变量 in 源表 if 条件]  →  展开构建新表（元素顺序 = 源迭代顺序）
//   - 基本元素映射：  [x * 2 for x in arr]
//   - 可选 if 筛选：  [x for x in arr if x % 2 == 0]
//   - 表达式上下文：  推导式可作函数实参（[y + 10 for y in arr]）
//   - 字符串/任意元素：源元素类型由表类型决定（[len(n) for n in names]）
//   - 解构迭代：      for (a, b) in 元组表（对齐 p.8.2.2 for..in 解构语义；
//                    expr/if 内对 a/b 的引用改写为 _cN.Item1/_cN.Item2）
// 生成器仅支持单个 for + 可选单 if（多 for/多 if 留待后续批次）。
//
// 期望输出（逐行，与 println 一一对应）：
//   PASS basic / PASS filter / PASS ctx_arg / PASS str_elem /
//   PASS destructure
// ============================================================

func sum_of(t: table<i64>) -> i64 {
    var s: i64 = 0
    var i: i64 = 0
    while i < len(t) {
        s = s + t[i]
        i = i + 1
    }
    return s
}

func main() {
    var arr = [1, 2, 3, 4, 5]
    // 1. 基本元素映射
    var d = [x * 2 for x in arr]
    if len(d) == 5 && d[0] == 2 && d[1] == 4 && d[4] == 10 {
        println("PASS basic")
    } else {
        println("FAIL basic")
        exit(1)
    }
    // 2. 可选 if 筛选（偶数）
    var e = [x for x in arr if x % 2 == 0]
    if len(e) == 2 && e[0] == 2 && e[1] == 4 {
        println("PASS filter")
    } else {
        println("FAIL filter")
        exit(1)
    }
    // 3. 表达式上下文：推导式作函数实参（每个元素 +10 → [11..15] 求和 = 65）
    var add3 = sum_of([y + 10 for y in arr])
    if add3 == 65 {
        println("PASS ctx_arg")
    } else {
        println("FAIL ctx_arg add3=" + to_string(add3))
        exit(1)
    }
    // 4. 字符串元素映射（源元素类型为 string）
    var names = ["a", "bb", "ccc"]
    var lens = [len(n) for n in names]
    if len(lens) == 3 && lens[0] == 1 && lens[1] == 2 && lens[2] == 3 {
        println("PASS str_elem")
    } else {
        println("FAIL str_elem")
        exit(1)
    }
    // 5. 解构迭代：for (a, b) in 元组表 —— a+b 汇总
    var pairs = [(1, 2), (3, 4), (5, 6)]
    var sums = [a + b for (a, b) in pairs]
    if len(sums) == 3 && sums[0] == 3 && sums[1] == 7 && sums[2] == 11 {
        println("PASS destructure")
    } else {
        println("FAIL destructure")
        exit(1)
    }
}