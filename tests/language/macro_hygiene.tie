type tie<logic>
// ============================================================
// p.8.2.12 宏升级验收：声明式宏（模板代换）+ 卫生（唯一化）
//
// 落地边界（务实定界）：
//   - 声明式宏 = 裸形参 + 块体模板（`macro name(a, b) { 体 }`），区别于既有
//     函数式宏（`: code` + `-> code`，编译期执行）。体内与形参同名的裸标识符
//     = 代换槽（替换为调用实参的克隆）；宏作者引入、`__` 前缀标识符 = 卫生
//     临时名（每次展开加 `_m<序号>` 后缀唯一化）。
//   - 不捕获调用处同名变量、不泄漏到调用处（跨展开序号单调递增，互不污染）。
//   - 与既有语句级（函数式）宏共存：同一文件可同时用两种宏。
//   - 真正完整的模式匹配/递归宏扩展/卫生闭包语义等：后续（p.9.x，见 ROAD
//     延后项），本项只落地模板代换 + 标识符卫生唯一化（探针证明真跑通）。
//
// 覆盖场景：
//   1. 声明式宏 ×3：语句上下文（含 __ 卫生临时变量）、表达式上下文、
//      双形参
//   2. 卫生：调用处同名局部变量（非 __ 且 __）与宏内临时变量互不污染
//   3. 与既有函数式宏共存
// ============================================================

// 函数式宏（既有，编译期执行）——共存用
macro fldbl(x: code) -> code {
    return `( ($x) * 2 )
}

// 声明式宏 1：表达式上下文（宏体单表达式 → 解包为表达式）
macro dbl(x) {
    x * 2
}

// 声明式宏 2：语句上下文 + 卫生临时变量 __r（绑定+引用+赋值全改名）
macro bump(x) {
    var __r = x
    __r = __r + 1
    println("bump=" + to_string(__r))
}

// 声明式宏 3：双形参，语句上下文
macro pairdump(a, b) {
    println("pair=" + to_string(a) + "," + to_string(b))
}

func main() {
    // 1. 表达式上下文声明式宏
    var a = dbl(21)
    println("dbl=" + to_string(a))
    // 1b. 与既有函数式宏共存（同一表达式还用了声明式）
    var b = fldbl(3) + dbl(5)
    println("mixed=" + to_string(b))
    // 2. 语句上下文宏 + 卫生：两次 bump，调用处同名 __r 不被打扰
    var __r = 99
    bump(5)
    bump(7)
    println("caller __r=" + to_string(__r))   // 仍为 99（未泄漏宏内 __r 改名）
    // 3. 双形参
    pairdump(10, 20)
    // 4. 嵌套表达式实参（代换槽克隆实参整棵子树）
    var c = dbl(1 + 2) + 3
    println("nested=" + to_string(c))
    println("done")
}