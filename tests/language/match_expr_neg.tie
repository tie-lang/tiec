type tie<logic>

// ============================================================
// p.9.10.1 match/switch 表达式负例：枚举不穷尽（无 `_` 通配且未覆盖全部变体）
//   期望编译报 error[E...]（穷尽检查）
// ============================================================

enum Tag {
    A(i64)
    B
    C(i64)
}

func main() {
    var x = Tag.A(1)
    var r = switch x {
        A(v) -> v
    }
    println(r)
}