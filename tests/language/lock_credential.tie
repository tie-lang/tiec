type tie<logic>
// lock_credential.tie —— r.1.6.7 `lock` 凭据域（去锁）的**正负例不变量**
// ============================================================================
// 被 `_tiec_verify/esc_safety.sh` 用 `--esc-audit` 编译并核对：
//   正例（必须出现「凭据去锁」）：块级 with(lock) / 绑证 use g(guard<lock>) /
//     函数级 #[unsafe.lock]；
//   负例（不得出现）：错域凭据（guard<share>）/ 无凭据 / 闭包体内（凭据不跨函数继承）。
// 全部用例都用**函数形参表** —— 它永不可证独占，故任何「凭据去锁」命中都只可能
// 来自显式凭据路径，不会与编译器自动独占分析混淆。
import "./lockauth/mod_plain.tie"

// ---------- 正例 1：块级临时凭据 unsafe with(lock) ----------
func ok_block_lock(g: table<i64>) -> i64 {
    var s: i64 = 0
    unsafe {
        unsafe with(lock) {
            table_push(g, 1)
            s = g[0]
        }
    }
    return s
}

// ---------- 正例 2：块级绑证 unsafe use g（g: guard<lock>） ----------
func ok_use_lock(g: table<i64>) -> i64 {
    var s: i64 = 0
    unsafe {
        var cred: guard<lock> = unsafe.get(lock)
        unsafe use cred {
            table_push(g, 2)
            s = g[0]
        }
    }
    return s
}

// ---------- 正例 3：函数级 #[unsafe.lock] ----------
#[unsafe.lock]
func ok_fn_lock(g: table<i64>) -> i64 {
    table_push(g, 3)
    return g[0]
}

// ---------- 负例 1：错域凭据（guard<share>） ⇒ 不得去锁 ----------
func no_wrong_domain(g: table<i64>) -> i64 {
    var s: i64 = 0
    unsafe {
        var cred: guard<share> = unsafe.get(share)
        unsafe use cred {
            table_push(g, 4)
            s = g[0]
        }
    }
    return s
}

// ---------- 负例 2：无凭据（仅 unsafe 上下文） ⇒ 不得去锁 ----------
func no_credential(g: table<i64>) -> i64 {
    var s: i64 = 0
    unsafe {
        table_push(g, 5)
        s = g[0]
    }
    return s
}

// ---------- 负例 3：函数级持证**不继承进闭包体** ----------
// 闭包可能被 spawn / 存全局 ⇒ 若继承外层去锁状态，另一个执行流会对同一张表
// 做免锁访问 ⇒ 真实数据竞争。闭包体是独立函数，凭据不跨函数继承。
#[unsafe.lock]
func no_closure_inherit(g: table<i64>) -> i64 {
    var f = func() -> i64 {
        table_push(g, 6)
        return g[0]
    }
    return f()
}

func main() {
    var t = table_new_i64()
    table_push(t, 0)
    var acc = ok_block_lock(t) + ok_use_lock(t) + ok_fn_lock(t) +
        no_wrong_domain(t) + no_credential(t) + no_closure_inherit(t) +
        mod_plain.push_it(t)
    println(to_string(acc) + " " + to_string(len(t)))
}
