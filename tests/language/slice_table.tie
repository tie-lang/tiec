type tie<logic>

// ============================================================
// p.9.11.7 切片/区间糖 `t[1..3]` 验收（左闭右开 [start,end)）：
//   表/数组：t[1..3] / t[..n] / t[n..] / t[..]（全拷贝）+ 越界 clamp + 负端 clamp
//   字符串：s[1..3]（字节子串，clamp 语义同）
//   端点闭开：含 start 不含 end；越界：clamp 到 [0,len]；负端 → 0。
// 实现裁决（见 pexpr.parse_unary '[' 分支 + sinfer N_SLICE + irgen tig_slice）：
//   - `[` 后是 `..`（空 start）或首段表达式后紧跟 `..` → N_SLICE；否则普通下标
//   - 结果类型：表/数组 → table<同元素>（拷贝非视图）；字符串 → string
//   - 越界/负端一律 clamp（与 str_sub_bytes 内建一致；避免切片 raise）
// 期望输出：
//   PASS t_range / PASS t_head / PASS t_tail / PASS t_full /
//   PASS t_clamp / PASS s_range / PASS s_full
// ============================================================

func main() {
    var t = [1, 2, 3, 4, 5]
    // 1. t[1..3] = [2,3]
    var a = t[1..3]
    if len(a) == 2 && a[0] == 2 && a[1] == 3 {
        println("PASS t_range")
    } else {
        println("FAIL t_range")
        exit(1)
    }
    // 2. t[..2] = [1,2]
    var b = t[..2]
    if len(b) == 2 && b[0] == 1 && b[1] == 2 {
        println("PASS t_head")
    } else {
        println("FAIL t_head")
        exit(1)
    }
    // 3. t[2..] = [3,4,5]
    var c = t[2..]
    if len(c) == 3 && c[0] == 3 && c[2] == 5 {
        println("PASS t_tail")
    } else {
        println("FAIL t_tail")
        exit(1)
    }
    // 4. t[..] = 全拷贝
    var d = t[..]
    if len(d) == 5 && d[0] == 1 && d[4] == 5 {
        println("PASS t_full")
    } else {
        println("FAIL t_full")
        exit(1)
    }
    // 5. 越界/负端 clamp：t[3..99] → [4,5]（end 钳到 len）；t[-2..2] → [1,2]
    var e = t[3..99]
    var f = t[-2..2]
    if len(e) == 2 && e[0] == 4 && e[1] == 5 && len(f) == 2 && f[0] == 1 && f[1] == 2 {
        println("PASS t_clamp")
    } else {
        println("FAIL t_clamp")
        exit(1)
    }
    // 6. 字符串子串
    var s = "hello"
    var g = s[1..3]
    var h = s[..2]
    var k = s[2..]
    if g == "el" && h == "he" && k == "llo" {
        println("PASS s_range")
    } else {
        println("FAIL s_range g=" + g + " h=" + h + " k=" + k)
        exit(1)
    }
    // 7. 字符串全拷贝 s[..]
    var m = s[..]
    if m == "hello" {
        println("PASS s_full")
    } else {
        println("FAIL s_full " + m)
        exit(1)
    }
}