type tie<logic>
// ============================================================
// p.9.11.12 @注解负例：悬空注解（@ 后不是 func/struct/enum 声明）
// → 编译错误（error[E...]；回归把 *_neg*.tie 应拒编译视为 PASS）。
// ============================================================
@component
var x: i64 = 1        // @ 注解后跟 var 声明 → 悬空注解诊断

func main() {
    println("unreachable")
}
