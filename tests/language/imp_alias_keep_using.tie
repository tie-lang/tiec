type tie<logic>
// ============================================================
// 别名「增名」× using 正例（2026-10-12）：别名导入后，按**原名** using
// 仍可把库名带进作用域裸调（using 记录的名字经改名映射回退解析）。
// 期望：编译成功 + 运行打印 "alias using 探针全过"。
// ============================================================
import "./imp_alias_keep_lib.tie" as nick
using keep

func main() {
    if v() != 41 {
        panic("using 原名裸调失败")
    }
    if nick.v() != 41 {
        panic("别名调用失败")
    }
    println("alias using 探针全过")
}
