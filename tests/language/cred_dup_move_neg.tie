type tie<logic>
// cred_dup_move_neg.tie —— 负例：凭据被重复转移（= 悄悄复制）必须被拒绝
// ============================================================================
// 规范 §11.6：「凭据可以转移，但不能复制，因此同一时刻只有一处持有它，
// 不存在权限被悄悄扩散的情形。」
// 第 2 次 `var g3 = g` 时 g 已失效：若放行，g2 与 g3 会同时持有 mem 域权限，
// 正是规范要杜绝的扩散。期望编译器报「已移动」。

unsafe func dup() -> i64 {
    var g: guard<mem> = unsafe.get(mem)
    var g2 = g
    var g3 = g
    return 1
}

func main() {
    var x: i64 = 0
    unsafe {
        x = dup()
    }
    println(to_string(x))
}
