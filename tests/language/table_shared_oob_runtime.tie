type tie<logic>
// table_shared_oob_runtime.tie —— r.1.6.9：共享表越界写（**运行期**拒绝）
// ============================================================================
// `b` 与 `a` 共享同一张表（rc=2）。`b[100] = 42` 是越界写，会扩容并改写共享的
// len——若不拦，`len(a)` 也会从 3 变成 101，即「写 b 无声改变了 a 的形状」。
//
// 期望：**编译通过**（判据是运行期引用计数，编译期无法判定），
//       运行时诊断「表下标越界——该表被别名共享…」后 exit(1)。
//
// ⚠ 本文件**不带 `_neg` 后缀**，因为回归脚本（scripts/regress-s21.tsh.tie）
//   把 `*_neg.tie` 一律当作「**编译期**应被拒绝」的负例（期望编译失败）。
//   本案是运行期拒绝、编译必然成功，若命 `_neg` 会被误判为「未拒」。
//   运行期行为由本条目的实测记录守门（见下），编译期「通过」由回归守门。
//
// 实测（2026-10-04，r.1.6.9 落地后）：
//   $ tiec table_shared_oob_runtime.tie -o x.exe   # 编译成功
//   $ ./x.exe
//   运行时错误: 表下标越界——该表被别名共享，写越界会改变所有别名看到的长度；如需扩容请先 clone 出独立副本
//   $ echo $?                                       # 1
//
// 对照（同目录 table_shared_oob.tie）覆盖四条正向路径：独占越界写自动扩容、
// 共享原位写可见、共享 push 可见、独占 push 正常。
// ============================================================================

func main() -> i64 {
    var a: table<i64> = [1, 2, 3]
    var b = a                     // rc=2（别名共享）
    b[100] = 42                   // 越界写 + 共享 ⇒ 运行期必须被拒
    // 若未被拒，会执行到这里（说明门禁失效）
    println("NOT-REJECTED len(a)=" + to_string(len(a)))
    return 1
}
