type tie<logic>
// guard_revoke.tie —— r.1.6.7 `unsafe.revoke(g)` 凭据撤销（规范 §11.6）
// ============================================================================
// 正例：撤销本身合法、派生合法、撤销后**不再使用**该凭据则一切正常。
// 负例见同目录 guard_revoke_*_neg.tie（s21 回归第 5 段自动纳入：应拒绝）。
//
// 语义要点：
//   · 撤销是编译期的事（凭据无运行时表示）；撤销后该凭据**及其传递派生出的
//     凭据**一并失效，后续使用报诊断；
//   · 撤销可作用于**已被 delegate 消费（move）的父凭据** —— 撤销的对象是
//     「凭据身份」而非运行时的值，故 revoke 的实参豁免 moved 检查（否则
//     「撤销父 ⇒ 子女失效」这条永远不可达）。

// 撤销后不再使用 —— 通过
func ok_revoke_unused(n: i64) -> i64 {
    var s: i64 = 0
    unsafe {
        var j: guard<lock> = unsafe.get(lock)
        unsafe.revoke(j)
        s = n
    }
    return s
}

// 派生子凭据（父被 move，子有效）—— 持子凭据去锁
func ok_delegate_then_use(ref g: table<i64>) -> i64 {
    var s: i64 = 0
    unsafe {
        var a: guard<lock> = unsafe.get(lock)
        var b: guard<lock> = a.delegate(lock)
        unsafe use b {
            table_push(g, 1)
            s = g[0]
        }
    }
    return s
}

// 撤销**父**（已被 move）后不使用其子 —— 通过
func ok_revoke_parent(n: i64) -> i64 {
    var s: i64 = 0
    unsafe {
        var a: guard<lock> = unsafe.get(lock)
        var b: guard<lock> = a.delegate(lock)
        unsafe.revoke(a)
        s = n
    }
    return s
}

// 未撤销的凭据照常可用（撤销只影响它自己与其后代）
func ok_independent_credential(ref g: table<i64>) -> i64 {
    var s: i64 = 0
    unsafe {
        var x: guard<lock> = unsafe.get(lock)
        var y: guard<lock> = unsafe.get(lock)
        unsafe.revoke(x)
        unsafe use y {
            table_push(g, 2)
            s = g[0]
        }
    }
    return s
}

func main() {
    var t = table_new_i64()
    var acc = ok_revoke_unused(7) + ok_delegate_then_use(t) + ok_revoke_parent(9) +
        ok_independent_credential(t) + len(t)
    println(to_string(acc))
}
