type tie<logic, unsafe:lock>
// lock_file_auth.tie —— 文件级 lock 授权（`type tie<logic, unsafe:lock>`）不变量
// ============================================================================
// 断言：
//   · 本文件（主输入文件）的函数 ⇒ **去锁**（凭据去锁）；
//   · import 的 `mod_plain` ⇒ **加锁**（未被授权，范围精确限定在本文件）。
import "./lockauth/mod_plain.tie"

// 主机文件函数：获文件级授权 ⇒ 去锁
func file_auth_fn(g: table<i64>) -> i64 {
    table_push(g, 9)
    return g[0]
}

func main() {
    var t = table_new_i64()
    table_push(t, 0)
    println(to_string(file_auth_fn(t)) + to_string(mod_plain.push_it(t)) + to_string(len(t)))
}
