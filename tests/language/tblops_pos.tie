type tie<logic>
// ============================================================
// 3.11 追加 / 6.4 点形态正例（2026-10-12）：t <- v 单发与链式、
// t.push/pop/at/trunc 转发、ref 形参与全局目标；期望编译+运行通过。
// ============================================================
var g_tbl: table<i64> = []

func add_ref(ref t: table<i64>) {
    t <- 6
}

func main() {
    var t = table_new_i64()
    t <- 1
    t <- 2
    add_ref(t)
    g_tbl <- 9
    var c = table_new_i64()
    c <- 1 <- 2 <- 3
    if len(t) != 3 || len(c) != 3 || len(g_tbl) != 1 {
        panic("追加基础失败")
    }
    var d: table<i64> = [5, 6, 7]
    d.push(8)
    if d.at(0) != 5 || d.pop() != 8 {
        panic("点形态失败")
    }
    d.trunc(2)
    if len(d) != 2 {
        panic("trunc 失败")
    }
    println("tblops 探针全过")
}
