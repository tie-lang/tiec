type tie<logic>
// ============================================================
// 3.11 追加 / 表操作记号正例（2026-10-12，记号制度修编后）：
//   · 追加 `t <- v`（单发与链式）、ref 形参与全局目标；
//   · 表操作三条渠道——箭头（数据作末参）/ 显式调用 / 下标；
//   · 点号不用于纯数据值（点=从属专用，规范 §3.11 修编）。
// 期望：编译+运行通过。
// ============================================================
var g_tbl: table<i64> = []

func add_ref(ref t: table<i64>) {
    t <- 6
}

func main() {
    var t = table_new_i64()
    t <- 1
    t <- 2
    add_ref(t)
    g_tbl <- 9
    var c = table_new_i64()
    c <- 1 <- 2 <- 3
    if len(t) != 3 || len(c) != 3 || len(g_tbl) != 1 {
        panic("追加基础失败")
    }
    var d: table<i64> = [5, 6, 7]
    8 -> table_push(d)
    if d[0] != 5 || (d -> table_pop()) != 8 {
        panic("箭头表操作失败")
    }
    if table_at(d, 0) != 5 {
        panic("显式调用失败")
    }
    2 -> table_trunc(d)
    if len(d) != 2 {
        panic("trunc 失败")
    }
    println("tblops 探针全过")
}
