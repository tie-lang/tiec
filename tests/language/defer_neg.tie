type tie<logic>

// ============================================================
// p.9.11.4 defer 负例：defer 块内禁止 return/break/continue/goto/panic。
// 资源释放语句在作用域退出时线性执行，不允许在 defer 体内提前跳转/不可恢复
// 退出（表达式/赋值/读作用域变量允许）。期望编译报 error[E...]。
// ============================================================

func f(x: i64) -> i64 {
    defer {
        return 5
    }
    return x
}