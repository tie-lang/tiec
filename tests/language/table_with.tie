type tie<logic>

// ============================================================
// p.9.11.6 表不可变更新 `t with {k: v}` 验收：
//   - 基本：基于 t1 产出新表，命中键更新、未提及键不变
//   - t1 原表不被修改（值语义纯糖，等价拷贝+赋值）
//   - 多键：t with {a: 1, b: 2}
//   - 链式：t with {a: 1} with {b: 2}（左结合）
//   - 作函数实参：结果可直接传入 map<i64> 形参
//   - 与记录字面量组合（记录构造 + with 更新）
//
// 实现裁决（见 pstmt/pexpr.parse_arrow + sinfer N_WITH + irgen tig_with）：
//   - with 为保留字二元 token（lex_with=98），优先级低于数据流箭头，链左结合
//   - N_WITH[base, 更新 map 字面量]，类型 = 左侧 map/表类型
//   - 值语义全复制（容器扁平数组无结构化共享，非零拷贝共享）
//   - 数组/表 with（RHS 需数字键）因 with 右侧记录键限 ident/string 不表达，留待
// 期望输出：
//   PASS basic / PASS unchanged / PASS multi / PASS chain / PASS farg
// ============================================================

func sum_i(m: map<i64>) -> i64 {
    var keys = map_keys(m)
    var s: i64 = 0
    var i: i64 = 0
    while i < len(keys) {
        s = s + m[keys[i]]
        i = i + 1
    }
    return s
}

func main() {
    // 1. 基本：命中键更新、未提及键不变
    var t1 = {a: 1, b: 2}
    var t2 = t1 with {a: 5}
    if t2.a == 5 && t2.b == 2 && len(t2) == 2 {
        println("PASS basic")
    } else {
        println("FAIL basic")
        exit(1)
    }
    // 2. 原表不被修改（新表，值语义）
    if t1.a == 1 && t1.b == 2 && len(t1) == 2 {
        println("PASS unchanged")
    } else {
        println("FAIL unchanged")
        exit(1)
    }
    // 3. 多键
    var t3 = t1 with {a: 9, b: 8}
    if t3.a == 9 && t3.b == 8 {
        println("PASS multi")
    } else {
        println("FAIL multi")
        exit(1)
    }
    // 4. 链式（左结合）
    var t4 = t1 with {a: 9} with {b: 7}
    if t4.a == 9 && t4.b == 7 && t1.a == 1 {
        println("PASS chain")
    } else {
        println("FAIL chain")
        exit(1)
    }
    // 5. 作函数实参
    var s = sum_i(t1 with {b: 10})
    if s == 11 {
        println("PASS farg")
    } else {
        println("FAIL farg s=" + to_string(s))
        exit(1)
    }
}