type tie<logic>
// ptr_value_probe.tie —— 「产出指针值」类操作的安全回归（2026-10-01）
// ============================================================================
// 判据（清单化）：一个操作是 unsafe 的 ⟺ 它**要求调用方先满足某个安全前提**。
// 「产出/计算指针值」的五项**没有**任何前提 —— 纯值运算、不触碰内存；结果即便无效，
// 也只在被解引用时才成为问题，而**解引用另有门禁** ⇒ 无独立危害面 ⇒ 安全。
//
//   安全（本文件覆盖）：addr_of · addr_of_field · ptr_add · ptr_to_int · int_to_ptr
//   仍须 unsafe（见同目录 ptr_value_*_neg.tie）：deref · deref_write · alloc · free ·
//     memcpy · memset · volatile_load · volatile_store
//
// 一句话边界：**产出指针值安全，用指针触碰内存须 unsafe**。
// 与 Rust 判法一致：addr_of! / ptr as usize / without_provenance / wrapping_offset
// 都是安全函数，只有 read/write/alloc 因带前提而 unsafe。

// ---- 1) addr_of：取变量地址（本文件不含任何 unsafe 上下文）----
func take_addr() -> i64 {
    var x: i64 = 41
    var p = addr_of(x)             // ptr<i64>
    return 0                       // 只验证「能取到」，不解引
}

// ---- 2) addr_of + ptr_to_int：指针转整数（纯转换）----
func addr_to_int() -> i64 {
    var x: i64 = 7
    var p = addr_of(x)
    var n = ptr_to_int(p)
    if n != 0 {
        return 1                   // 有效地址 ⇒ 非 0
    }
    return 0
}

// ---- 3) int_to_ptr + is_null：整数转指针（纯转换）----
func int_to_ptr_path() -> i64 {
    var p = int_to_ptr(0)          // 空指针
    if is_null(p) {
        return 1
    }
    return 0
}

// ---- 4) ptr_add：指针偏移（普通 gep，无 inbounds；不触碰内存）----
func offset_ptr() -> i64 {
    var arr: array<i64, 4> = [0, 0, 0, 0]
    var p: ptr<i64> = addr_of(arr[0])
    var q = ptr_add(p, 2)          // 偏移 2 个元素
    if !is_null(q) && !is_null(p) {
        return 1
    }
    return 0
}

// ---- 5) addr_of_field：取聚合字段地址 ----
struct Pair {
    var a: i64 = 0
    var b: i64 = 0
}
func field_addr() -> i64 {
    var pr: Pair = Pair()
    var fb: ptr<i64> = addr_of_field(pr, "b")
    if !is_null(fb) {
        return 1
    }
    return 0
}

func main() {
    var a = take_addr()
    var b = addr_to_int()
    var c = int_to_ptr_path()
    var d = offset_ptr()
    var e = field_addr()
    if b == 1 && c == 1 && d == 1 && e == 1 {
        println("ptr-value-safe PASS (addr 1 int 1 null 1 offset 1 field 1)")
    } else {
        println("ptr-value-safe FAIL (" + to_string(b) + " " + to_string(c) + " " +
            to_string(d) + " " + to_string(e) + ")")
    }
}
