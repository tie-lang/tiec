type tie<logic>
// ============================================================
// p.9.11.13 #cfg 条件编译负例：#cfg 块未闭合（缺 #end/#endif）
// → 编译错误（error[E...]；回归把 *_neg*.tie 应拒编译视为 PASS）。
// ============================================================
#cfg(debug)
func main() {
    println("unreachable")
}
// 缺少 #end/#endif → 未闭合诊断
