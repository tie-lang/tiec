type tie<logic>

// 点分命名空间：声明写 `a.b`，跨命名空间引用写 `a.b::f`。
// 编译器把点分前缀归一为内部全名 a::b::f（声明与引用两侧一致）。

namespace a.b {
    pub const K: i64 = 3

    pub func f() -> i64 {
        return 5
    }
}

namespace c.d {
    pub func g() -> i64 {
        return a.b::f() + a.b::K
    }
}

func main() {
    println(c.d::g())   // 8
}
