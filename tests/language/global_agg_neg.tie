type tie<logic>
// ============================================================
// 全局聚合变量负例（2026-10-13 安全加固）：以下形态的全局槽不可安全承载——
//   · fn 全局：读出野 entry 调用即段错误（红线）
//   · array/tuple 全局：后端报错
// 期望：编译失败（干净报错）。struct/enum 全局暂留（初始化物化缺陷另批）。
// ============================================================
pub var gf: fn() -> i64 = func() -> i64 { return 1 }
pub var ga2: array<i64, 3> = [1, 2, 3]
func main() {
    println(to_string(gf()))
    println(to_string(ga2[0]))
}
