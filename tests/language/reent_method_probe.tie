type tie<script>

actor B {
    pub func val() -> i64 { return 5 }
}

actor A {
    var marks: i64
    pub async reentrant func slow() {
        var b = run B()
        var r = b.val()
        marks = r
    }
    pub func getmarks() -> i64 { return marks }
}

func main() -> i64 {
    var a = run A()
    a.slow()
    return 0
}
