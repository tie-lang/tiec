type tie<logic, unsafe:mem>
// reclass_safe_probe.tie —— §11.8 安全边界重分类回归（2026-10-01）
// ============================================================================
// 断言：**原子操作 / 切片视图与下标 / 指针的声明·比较·传参·返回 / repr(C) 声明**
// 都可以在**安全代码**中使用 —— 本文件不含 unsafe 块、不含 unsafe fn（除了
// 造指针的那一处，那才是真正危险的「分配」动作）。
//
// 重分类把危险面从**类型**下移到**操作**，进而下移到**「带安全前提」与否**：
// 产出/计算指针值（取地址、指针算术、指针↔整数转换）**安全**——纯值运算、不碰内存，
// 结果只在被解引用时才成为问题，而解引用另有门禁（见 ptr_value_probe.tie）；
// 真正须 unsafe 的是**用指针触碰内存**：解引用、原始分配与释放、块拷贝、易失访存
// （负例见同目录 reclass_*_neg.tie 与 ptr_value_*_neg.tie，s21 第 5 段自动纳入「应拒绝」）。
//
// 设计依据：tie-main/docs/designs/safe-unsafe-reclassification.md
// 判据（定稿）：「构造安全 ⟺ 不可能引发 UB」。

// ---- 1) atomic：五操作全部免 unsafe ----
func atomic_ops() -> i64 {
    var c: atomic<i64> = 0
    c.store(10, Release)              // store
    var old = c.fetch_add(5, AcqRel)  // 读改写（返回旧值）
    var cur = c.load(Acquire)         // load
    var ok = c.compare_exchange(15, 100, SeqCst)   // CAS
    if ok {
        // store(10) → fetch_add(5): old=10, now=15 → load=15 → cas(15→100) 成功
        return old + cur + c.load(SeqCst)          // 10 + 15 + 100 = 125
    }
    return old + cur
}

// ---- 2) slice：视图、长度、下标全部免 unsafe ----
func slice_ops() -> i64 {
    var t = table_new_i64()
    table_push(t, 10)
    table_push(t, 20)
    table_push(t, 30)
    table_push(t, 40)
    var s = slice_of(t, 1, 3)          // [20, 30, 40]
    return slice_len(s) * 1000 + slice_index(s, 0) + slice_index(s, 2)   // 3060
}

// ---- 3) ptr：声明 / 参数 / 返回 / 比较 全部免 unsafe ----
func ptr_is_null(p: ptr<u8>) -> bool {
    return is_null(p)
}
func ptr_identity(p: ptr<u8>) -> ptr<u8> {
    return p
}
unsafe func ptr_make() -> ptr<u8> {
    return alloc(8)                    // 「分配」才是危险面
}

// ---- 4) repr(C) 声明与字段访问免 unsafe ----
repr(C) struct Pod {
    var x: i64 = 0
    var y: i64 = 0
}
func reprc_ops() -> i64 {
    var p: Pod = Pod()
    p.x = 3
    p.y = 4
    return p.x + p.y                   // 7
}

func main() {
    var a = atomic_ops()
    var s = slice_ops()
    var r = reprc_ops()
    var ptr_ok = false
    unsafe {
        var p = ptr_make()
        var q = ptr_identity(p)
        // 安全函数能接收/返回/比较指针；p 来自 alloc ⇒ 非空
        ptr_ok = !ptr_is_null(q) && !ptr_is_null(p)
        free(q)
    }
    if a == 125 && s == 3060 && r == 7 && ptr_ok {
        println("reclass-safe PASS (" + to_string(a) + " " + to_string(s) + " " +
            to_string(r) + ")" + " ptr=ok")
    } else {
        println("reclass-safe FAIL (" + to_string(a) + " " + to_string(s) + " " +
            to_string(r) + ") ptr=" + to_string(ptr_ok))
    }
}
