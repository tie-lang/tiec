type tie<logic>
// table_append_probe.tie —— 内置 table_append 正向探针（批量追加语义）
// 覆盖：基本追加 / n 钳制 / n<=0 / 自追加守卫 / 全局表（无 cow 形态）/
//       局部表（值语义分离形态）/ 字符串元素（拷贝型）。
// 运行期望输出：
//   b=4:10,1,2,3
//   clamp=7
//   noop=7
//   g=2:1,2
//   self=4:7,8
//   str=2:x,y
var g: table<i64> = []

func main() -> i64 {
    var a: table<i64> = [1, 2, 3]
    var b: table<i64> = [10]
    table_append(b, a, 3)
    println("b=" + to_string(len(b)) + ":" + to_string(b[0]) + "," + to_string(b[1]) + "," + to_string(b[2]) + "," + to_string(b[3]))
    table_append(b, a, 99)
    println("clamp=" + to_string(len(b)))
    table_append(b, a, 0)
    table_append(b, a, 0 - 2)
    println("noop=" + to_string(len(b)))
    table_append(g, a, 2)
    println("g=" + to_string(len(g)) + ":" + to_string(g[0]) + "," + to_string(g[1]))
    var c: table<i64> = [7, 8]
    table_append(c, c, 2)
    println("self=" + to_string(len(c)) + ":" + to_string(c[2]) + "," + to_string(c[3]))
    var sa: table<string> = ["x", "y"]
    var sb: table<string> = []
    table_append(sb, sa, 2)
    println("str=" + to_string(len(sb)) + ":" + sb[0] + "," + sb[1])
    return 0
}
