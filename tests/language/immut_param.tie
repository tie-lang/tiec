type tie<logic>
// ============================================================
// p.9.11.11 immut 只读形参正例：`fn f(immut t: T)` 中 t 在函数体内只读。
// 读操作、方法调用、传入其它函数均正常；运行期零开销（纯编译期检查，不繁殖拷贝）。
// 与普通形参共存：普通形参仍可写。
// ============================================================
func scale(immut base: i64, factor: i64) -> i64 {
    // immut 形参 base 只读（读取计算正常）
    var r = base * factor
    return r + base
}
func mix(immut a: i64, b: i64) -> i64 {
    b = b + 1    // 普通形参可写
    return a + b
}
func first(immut items: table<i64>) -> i64 {
    // immut 表形参：读下标、len、方法调用正常
    if len(items) == 0 {
        return 0
    }
    var v = items[0]
    var w = items
    return v + len(w)
}
func main() {
    var a = scale(3, 4)         // 3*4+3 = 15
    if a != 15 { panic("scale 结果错误"); }
    var m = mix(1, 2)           // a=1, b->3, return 4
    if m != 4 { panic("mix 结果错误"); }
    var t: table<i64> = [10, 20]
    var f = first(t)            // 10 + len(2) = 12
    if f != 12 { panic("first 结果错误"); }
    println("immut_param 探针全过")
}