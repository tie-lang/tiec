type tie<logic>
// ============================================================
// 别名「增名」修复正例（2026-10-12）：别名导入不再除掉原命名空间名——
//   主文件以别名 nick 调用；兄弟文件按原名 keep.v() 调用。
// 两者必须同时可解析（修复前兄弟方报 E00391 断链）。
// 期望：编译成功 + 运行打印 "alias 增名 探针全过"。
// ============================================================
import "./imp_alias_keep_lib.tie" as nick
import "./imp_alias_keep_sib.tie" as sib

func main() {
    if nick.v() != 41 {
        panic("别名调用失败")
    }
    if sib.through_old_name() != 41 {
        panic("原名调用断链")
    }
    println("alias 增名 探针全过")
}
