type tie<logic>

// ============================================================
// p.9.10.2 if-let 负例：模式与对象类型不匹配。
//   `if let Some(x) = n`——n 是 i64（非 Option），Some 解构模式不适用。
//   期望编译报 error[E...]
// ============================================================
import "/std/result.tie"

func main() {
    var n = 42
    if let Some(x) = n {
        println(x)
    }
}