type tie<logic>

// p.9.11.18 多行表达式续行：行尾 `\` 显式续行（token 边界，字符串/注释内
// 不生效）；行尾 `|`（二元/管道）与 `->`（数据流箭头）本为二元运算符、
// ASI 行尾不补分号 → 天然续行（本探针验证）。行首运算符延续（如下一行以
// `+` 开头）不在本轮（裁决：显式 `\` + 行尾运算符续行，行首延续留候选）。

func add(a: i64, b: i64) -> i64 { return a + b }

func main() {
    // 1. 行尾 \ 续行：长表达式（LF 换行）
    var x = 1 + \
        2 + \
        3
    println(x)
    // 2. \ 续行：函数实参跨行
    var s = add(
        10,
        20)
    println(s)
    // 3. \ 续行：长字符串拼接
    var msg = "hello " + \
        "world" + \
        "!"
    println(msg)
    // 4. 行尾 | 续行（位或；| 是二元运算符，ASI 行尾不补分号）
    var y = 5 | \
        3
    println(y)
    // 5. 行尾 -> 数据流箭头跨行（10 -> add(5) = add(5,10)）
    var r = 10 -> \
        add(5)
    println(r)
    // 6. 普通换行不变（两语句各自分号）
    var a = 1
    var b = 2
    println(a + b)
    // 7. 字符串内 \n 转义不受续行影响（输出换行）
    println("a\nb")
    // 8. 注释内行尾 \ 不续行（注释吞到行尾，下一行是新语句）
    // 注释末尾反斜杠 \
    var c = 7
    println(c)
}
