type tie<logic>
// share_pos.tie —— r.1.6.15 `share(x)`：值语义的**显式共享逃生舱**（正例）
// ============================================================================
// `share(x)` 返回与 x **共享同一份底层数据**的可变别名（不 COW）。
// 效果在**绑定处**：目标变量（及裸变量实参）登记为「显式共享」⇒ 写路径跳过分离
// ⇒ 就地改、别名互见。这就是「非 unsafe 下的高性能语法」的对照面——需要零拷贝
// 就地改、且书写者能自行证明并发安全时，用它在凭据下换取性能。
//
// 危险面 ⇒ 双锁门禁：unsafe 上下文（锁一）+ share 域凭据（锁二）。
// 期望输出：len(a)=1 a[0]=99   （写 b 可见于 a，证明共享成立）
// ============================================================================
// 正例：持 share 凭据 ⇒ 共享可变别名，写 b 调用方可见
func main() {
    var a = table_new_i64()
    unsafe {
        unsafe with(share) {
            var b = share(a)
            table_push(b, 7)
            b[0] = 99
        }
    }
    println("len(a)=" + to_string(len(a)) + " a[0]=" + to_string(a[0]))
}
