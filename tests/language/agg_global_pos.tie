type tie<logic>
// ============================================================
// 聚合全局初始化物化正例（2026-10-13）：struct/enum 全局的初值（构造器形态，
// 无法静态折叠）由 main 入口求值存回 @g（对齐表全局初始化）。此前静默丢失
// （@g 恒 zeroinitializer）。
// 期望：编译成功 + 运行打印 "agg-global 探针全过"。
// ============================================================
struct Q {
    var a: i64 = 0
    var b: i64 = 0
}
enum E4 { A(i64) B }
pub var q1: Q = Q(3, 4)
pub var ge: E4 = E4.A(9)
pub var gsx: i64 = 10
func main() {
    if q1.a != 3 || q1.b != 4 {
        panic("struct 全局物化失败")
    }
    var l = ge
    var got = 0
    switch l {
        case E4.A(v):
            got = v
        case E4.B:
            got = -1
    }
    if got != 9 {
        panic("enum 全局物化失败")
    }
    if gsx != 10 {
        panic("标量全局回归失败")
    }
    println("agg-global 探针全过")
}
