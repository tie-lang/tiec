type tie<logic>

// 应用文件（logic）也能进命名空间：主文件的 main（本文件 ns_main_probe::main）
// 仍以 C 入口符号 @main 发射；全局表初始化与 `return` 也按入口处理。
namespace ns_main_probe;

var names: table<string> = ["a"]

func main() {
    println("ns-main=" + names[0])
    if len(names) > 0 {
        return
    }
    println("unreachable")
}
