type tie<logic>
// table_shared_oob_neg.tie —— r.1.6.9 负例：共享表越界写必须被拒绝
// ============================================================================
// `b` 与 `a` 共享同一张表（rc=2）。`b[100] = 42` 是越界写，会扩容并改写共享的
// len——若不拦，`len(a)` 也会从 3 变成 101，即「写 b 无声改变了 a 的形状」。
// 期望：编译通过，**运行期**诊断「表下标越界——该表被别名共享…」后 exit(1)。
//
// 注：判据是运行期引用计数，故这是运行时负例（不是编译期拒绝）。
// ============================================================================

func main() -> i64 {
    var a: table<i64> = [1, 2, 3]
    var b = a                     // rc=2（别名共享）
    b[100] = 42                   // 越界写 + 共享 ⇒ 必须被拒
    // 若未被拒，会执行到这里（说明门禁失效）
    println("NOT-REJECTED len(a)=" + to_string(len(a)))
    return 1
}
