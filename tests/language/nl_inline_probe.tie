type tie<logic, unsafe:lock>
// nl_inline_probe.tie —— 免锁内联快路径（r.1.7）行为等价探针
// ============================================================
// 覆盖 codegen 内联的四条路径与调用路径的逐项等价：
//   * push 内联快路径 + 扩容回退（跨 cap 边界）
//   * 下标读内联：命中取值 / 越界取元素零值（i64 → 0）
//   * 下标写内联：命中原位写 / 越界自动扩容后写
//   * 字符串表越界读 → 空串（非 null）；bool 表（esz=1）读写
func main() {
    // ---- push：40 次跨多次扩容（内联快路径 + 增长回退交替）----
    var t = table_new_i64()
    var i: i64 = 0
    while i < 40 {
        table_push(t, i * 2)
        i = i + 1
    }
    println("len=" + to_string(len(t)) + " t0=" + to_string(t[0]) + " t39=" + to_string(t[39]))
    // 注：用户层越界读按 driver 恒开的 check-bounds 直接 panic（不是零值），
    // 内联读的"越界零值臂"服务于依赖 ok=0 的内部调用方（如 table_pop 的
    // `len>0 ? len-1 : 0`），由回归套件覆盖。
    // ---- 下标写：命中原位 / 越界扩容 ----
    t[5] = 555
    t[45] = 999
    println("w5=" + to_string(t[5]) + " w45=" + to_string(t[45]) + " len2=" + to_string(len(t)))
    // ---- 字符串表（元素为句柄宽 8B）----
    var s = table_new_string()
    table_push(s, "ab")
    println("s0=" + s[0] + " slen=" + to_string(len(s)))
    // ---- bool 表（esz=1）----
    var b = table_new_bool()
    table_push(b, true)
    println("b0=" + to_string(b[0]))
}
