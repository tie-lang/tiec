type tie<logic>
// ============================================================
// 顶层值从属正例（2026-10-12 从属扩展）：`lib.K` 词干限定访问顶层常量/变量，
// 裸名亦可用（顶层值由统一登记裁决唯一性）。
// 期望：编译成功 + 运行打印 "toplevel 值 探针全过"。
// ============================================================
import "./imp_toplevel_lib.tie"

func main() {
    if TOPV != 42 {
        panic("裸名顶层值失败")
    }
    if imp_toplevel_lib.TOPV != 42 {
        panic("词干限定顶层值失败")
    }
    if imp_toplevel_lib.open_ok() != 7 {
        panic("词干限定函数回归失败")
    }
    println("toplevel 值 探针全过")
}
