type tie<logic, unsafe:mem>
// new_builtins_probe.tie —— r.1.7 新接线内置探针
// ============================================================
// 覆盖：table_reserve（容量预留，不动 len）
//       table_append_raw（裸内存批量追加到表尾）
//       ch_len / ch_closed_flag / ch_count（补齐的内置缺口，与库 API 同语义）
// 期望输出（逐行精确）：
//   r0=0
//   r1=5:5
//   raw=8:100,102
//   clen=1 cf=0 cnt=1
//   crecv=42 clen2=0
//   cf2=1
func main() {
    // ---- table_reserve：预留不改 len；随后 push 正常 ----
    var t = table_new_i64()
    table_reserve(t, 64)
    println("r0=" + to_string(len(t)))
    var i: i64 = 0
    while i < 5 {
        table_push(t, i + 1)
        i = i + 1
    }
    println("r1=" + to_string(len(t)) + ":" + to_string(t[4]))
    // ---- table_append_raw：从裸缓冲区拷 3 个元素 ----
    unsafe {
        var buf = alloc(24)
        var k: i64 = 0
        while k < 3 {
            var v = 100 + k
            memcpy(int_to_ptr(ptr_to_int(buf) + k * 8), int_to_ptr(ptr_to_int(addr_of(v))), 8)
            k = k + 1
        }
        table_append_raw(t, buf, 3)
    }
    println("raw=" + to_string(len(t)) + ":" + to_string(t[5]) + "," + to_string(t[7]))
    // ---- chan 缺口 ----
    var ch = ch_open()
    ch_send(ch, 42)
    println("clen=" + to_string(ch_len(ch)) + " cf=" + to_string(ch_closed_flag(ch)) +
        " cnt=" + to_string(ch_count()))
    var x = ch_recv(ch)
    println("crecv=" + to_string(x) + " clen2=" + to_string(ch_len(ch)))
    ch_close(ch)
    println("cf2=" + to_string(ch_closed_flag(ch)))
}
