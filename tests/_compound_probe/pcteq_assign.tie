type tie<logic>
// `%%=` 复合赋值探针（regress 6f）：规范 §1 运算符表与 §4 示例都写了 `count %%= 5`，
// 实现曾缺此 token（直接报 E00832）。不变式：**`a %%= b` 必须等于 `a %% b`**，
// 覆盖四种符号组合（余数符号跟随除数），并在探针内部自比较后只输出一行判定。
func main() -> i64 {
    var bad: i64 = 0
    var c0 = 7
    c0 %%= 3
    var d0 = 7
    if c0 != (d0 %% 3) {
        bad = bad + 1
    }
    var c1 = -7
    c1 %%= 3
    var d1 = -7
    if c1 != (d1 %% 3) {
        bad = bad + 1
    }
    var c2 = 7
    c2 %%= -3
    var d2 = 7
    if c2 != (d2 %% -3) {
        bad = bad + 1
    }
    var c3 = -7
    c3 %%= -3
    var d3 = -7
    if c3 != (d3 %% -3) {
        bad = bad + 1
    }
    var c4 = 0
    c4 %%= 5
    var d4 = 0
    if c4 != (d4 %% 5) {
        bad = bad + 1
    }
    var c5 = 5
    c5 %%= 5
    var d5 = 5
    if c5 != (d5 %% 5) {
        bad = bad + 1
    }
    var c6 = 100
    c6 %%= 7
    var d6 = 100
    if c6 != (d6 %% 7) {
        bad = bad + 1
    }
    if bad == 0 {
        println("VERDICT OK")
    } else {
        println("VERDICT FAIL " + to_string(bad))
    }
    return 0
}
