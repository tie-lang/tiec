type tie<logic>
// tests/_p911_process_probe/process_probe.tie —— p.9.1.1.16 验收：std/process 双向管道。
// 全确定性探针（Windows cmd）：
//   1. pipe_run 回环：stdin 投喂 → stdout 捕获（findstr 回显）且退出码 0；
//   2. 退出码捕获：cmd exit 7 → rc==7；
//   3. exec_stdin：只投喂 stdin 返回退出码；
//   4. run_capture：stdout 与 stderr 分开捕获；
//   5. read_stderr：单独捕获 stderr；
//   6. 既有 exec_code 回归（向后兼容）。
// 期望全部 PASS / exit 0。
import "../../std/process.tie" as process

var fails: i64 = 0

func check(cond: bool, msg: string) {
    if cond {
        println("PASS " + msg)
    } else {
        println("FAIL " + msg)
        fails = fails + 1
    }
}

func contains(hay: string, needle: string) -> bool {
    var hn = str_len(hay)
    var nn = str_len(needle)
    if nn == 0 {
        return true
    }
    if nn > hn {
        return false
    }
    var i: i64 = 0
    while i + nn <= hn {
        var ok = true
        var j: i64 = 0
        while j < nn {
            if str_char(hay, i + j) != str_char(needle, j) {
                ok = false
                break
            }
            j = j + 1
        }
        if ok {
            return true
        }
        i = i + 1
    }
    return false
}

func section_pipe_run() {
    // findstr 从 stdin 读行并回显到 stdout（兼容空行）
    var r = process.pipe_run("cmd /c findstr /r .*", "hello\r\nworld\r\n")
    check(r.0 == 0, "pipe_run exit 0")
    check(contains(r.1, "hello") && contains(r.1, "world"), "pipe_run stdout captured hello/world")
}

func section_exit_code() {
    var r = process.pipe_run("cmd /c exit 7", "")
    check(r.0 == 7, "pipe_run captures exit code 7")
    var r2 = process.pipe_run("cmd /c exit 0", "")
    check(r2.0 == 0, "pipe_run exit 0 empty")
}

func section_exec_stdin() {
    // 只投喂 stdin，明细不捕获输出
    var rc = process.exec_stdin("cmd /c findstr /r .* > nul", "pipeme")
    check(rc == 0, "exec_stdin exit 0")
}

func section_run_capture() {
    var r = process.run_capture("cmd /c \"echo So&echo Se 1>&2\"", "")
    check(r.0 == 0, "run_capture exit 0")
    check(contains(r.1, "So"), "run_capture stdout has So")
    check(contains(r.2, "Se"), "run_capture stderr has Se")
}

func section_read_stderr() {
    var s = process.read_stderr("cmd /c \"echo OopsErr 1>&2\"")
    check(contains(s, "OopsErr"), "read_stderr has OopsErr")
}

func section_backward_compat() {
    var rcode = process.exec_code("cmd /c exit 3")
    check(rcode == 3, "backward exec_code exit 3")
    var oc = process.exec_output("cmd /c echo HiOut")
    check(contains(oc, "HiOut"), "backward exec_output HiOut")
}

func main() {
    println("start")
    section_pipe_run()
    section_exit_code()
    section_exec_stdin()
    section_run_capture()
    section_read_stderr()
    section_backward_compat()
    if fails == 0 {
        println("PASS")
    } else {
        println("FAIL count=" + to_string(fails))
    }
    println("done")
}