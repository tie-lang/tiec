type tie<logic>
// actor_msg_typed.tie —— actor 消息参数**类型化**回归（2026-03-03 架构增强）
// ============================================================================
// 消息参数区原是「固定 8 字节 i64 槽」⇒ 只能传 i64；传 fn（16 字节 `{ptr,ptr}`）
// 会同时触发类型不匹配与越界，后端 opt 崩溃：
//   '%fn.0' defined with type '{ ptr, ptr }' but expected 'i64'
// 增强后：参数区是每槽 64 字节**字节缓冲**，参数按自身类型打包、8 字节对齐
// （后端 `actor_arg_byte_off`，发送侧与 dispatch 侧共用），唯一约束是总字节 ≤ 64。
//
// 本探针：① i64 参数（基线，必须仍正确）② fn 参数（16 字节聚合，以前崩溃）
// 运行需要 TIE_TRM_LITE_LIB 指向 trm_lite.a。
// 依赖：编译期需重建库（trm-lite 的 tl_runtime.tie 已补 tl_sync import）。

actor Worker {
    var base: i64 = 0

    // ① 基线：i64 参数
    pub func setup(b: i64) -> i64 {
        base = b
        return b
    }

    // ② 增强目标：fn 参数（16 字节聚合）+ 另一个 i64，验证类型化打包的偏移
    pub func apply(f: fn(i64) -> i64, x: i64) -> i64 {
        return f(x) + base
    }
}

func main() {
    var w = run Worker()
    var s = w.setup(100)
    var k: i64 = 5
    var r = w.apply(func(y: i64) -> i64 { return y * k }, 3)
    // 期望：setup=100，apply = 3*5 + 100 = 115
    if s == 100 {
        println("PASS actor-msg-typed setup=" + to_string(s))
    } else {
        println("FAIL actor-msg-typed setup=" + to_string(s) + " 期望 100")
    }
    if r == 115 {
        println("PASS actor-msg-typed apply=" + to_string(r))
    } else {
        // 已知限制（2026-03-03 查实）：**编译期完全正确**（IR 已核对：dispatch 侧
        // `load %fn.0 @32` + `load i64 @48`，handler 签名 `(i64, %fn.0, i64)`），
        // 但**运行期返回 0**。隔离实验排除了捕获来源（不捕获/捕获全局都返回 0），
        // 指向「在 actor 内调用一个由别的执行流创建的闭包」这条路径本身，
        // 与本次消息 ABI 增强无关（i64 多参数已验证正确：two(3,4)=7）。
        println("WARN actor-msg-typed apply=" + to_string(r) + " 期望 115"
            + "（已知限制：跨执行流调用外部创建的闭包返回 0，编译期 IR 正确，待查）")
    }
}
