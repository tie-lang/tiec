type tie<logic>
// ============================================================================
// tests/regexpx_probe/regexpx_probe.tie：std/regexpx regex-pro 探针（p.9.1.1.9）。
// Regex-pro probe (p.9.1.1.9).
//
// 覆盖（Coverage）：
//   - 正向前瞻 (?=...)：`foo(?=bar)` 匹配 foo 仅当后缀为 bar；`\w+(?=\d)`
//     前瞻后继续消费；
//   - 回引用 \1..\9：`(ab)\1` 匹配 abab，不匹配 abcd；(x+)\1 重复块；
//   - 惰性 vs 贪婪差异：`a.*b` 最长、`a.*?b` 最短；
//   - Unicode 类 \p{L}：匹配中文/拉丁/希腊字母，不匹配数字/标点；
//   - Pro 别名 regex_replace 与组引用 $1。
// 数据平面：全 string/bool/i64。夹具内联。
// 编译运行：compiler\tiec.exe tests\regexpx_probe\regexpx_probe.tie
// ============================================================================
import "../../std/regexpx.tie" as rxp

func chk_true(name: string, v: bool) {
    if v {
        println("PASS " + name)
    } else {
        println("FAIL " + name + " expected true")
        exit(1)
    }
}
func chk_false(name: string, v: bool) {
    if !v {
        println("PASS " + name)
    } else {
        println("FAIL " + name + " expected false")
        exit(1)
    }
}
func chk_str(name: string, got: string, want: string) {
    if got == want {
        println("PASS " + name)
    } else {
        println("FAIL " + name + " got=[" + got + "] want=[" + want + "]")
        exit(1)
    }
}

func tst_lookahead() {
    chk_true("la_foo_bar", rxp.is_match("foobar", "foo(?=bar)"))
    chk_false("la_foo_baz", rxp.is_match("foobaz", "foo(?=bar)"))
    // 前瞻不消费：`foo(?=bar)bar` 仍能匹配整段
    chk_true("la_no_consume", rxp.is_match("foobar", "foo(?=bar)bar"))
    // `[a-z]+(?=\d)` 前瞻后不消费，继续：匹配 abc（'1' 仅被前瞻使用）
    chk_str("la_word_digit", rxp.find("abc123", "[a-z]+(?=\\d)"), "abc")
    // 前瞻后继续消费（前瞻段之后的量词接续）
    chk_true("la_continue", rxp.is_match("abc123", "[a-z]+(?=\\d)\\d+"))
    // 前瞻与其他原子结合
    chk_true("la_nested", rxp.is_match("f12", "f(?=\\d)\\d+"))
}

func tst_backref() {
    chk_true("br_abab", rxp.is_match("abab", "(ab)\\1"))
    chk_false("br_not_abcd", rxp.is_match("abcd", "(ab)\\1"))
    chk_str("br_find", rxp.find("xxxyxy", "(xy)\\1"), "xyxy")
    // 重复块 (x+)\1
    chk_true("br_repeat_block", rxp.is_match("abcabc", "(abc)\\1"))
    // group 捕获与回引用一致
    chk_str("br_group", rxp.group("abab", "(ab)\\1", 1), "ab")
    // 回引用参与 find_all（"aba"：第一与第三字符相同）
    var all = rxp.find_all("aba", "(.).\\1")
    chk_i64_("br_findall_len", all, 1)
}

func tst_lazy() {
    // 贪婪 a.*b（最长）：a 到最后一个 b 之间全包含
    chk_str("lazy_greedy", rxp.find("aXbYb", "a.*b"), "aXbYb")
    // 惰性 a.*?b（最短）：a 到第一个 b
    chk_str("lazy_lazy", rxp.find("aXbYb", "a.*?b"), "aXb")
    // +? 最小为一次重复：a + .(1次) + b → "abb"（懒惰取最小，但 + 至少 1 次）
    chk_str("lazy_plus", rxp.find("abbbbb", "a.+?b"), "abb")
    // 对照贪婪 a.+b（最长）
    chk_str("lazy_plus_greedy", rxp.find("abbbbb", "a.+b"), "abbbbb")
    // ??
    chk_str("lazy_opt", rxp.find("ab", "ab??"), "a")
}

func tst_unicode() {
    // 注：tie 词法器对"字符串内 `{单标识符}`"字面量有解析限制（`\p{L}` 里的
    // `{L}` 编译报"未声明变量 L"），故用 pat() 拼接构造 pattern。
    // \p{L} 匹配中文（CJK）
    chk_true("ul_cn", rxp.is_match("中文abc", pat("L") + "+"))
    // 匹配拉丁
    chk_true("ul_latin", rxp.is_match("héllo", pat("L") + "+"))
    // 不匹配纯数字
    chk_false("ul_not_digit", rxp.is_match("123", "^" + pat("L") + "+$"))
    // \p{Letter} 别名
    chk_true("ul_letter_alias", rxp.is_match("abc世界", pat("Letter") + "+"))
    // 提取连续字母
    chk_str("ul_find", rxp.find("h1世界2ok", pat("L") + "+"), "h")
}

// 构造 `\p{...}` 类别 pattern（避免 tie 词法器对 `{单标识符}` 字面量的解析限制）。
func pat(cat: string) -> string {
    return "\\p" + "{" + cat + "}"
}

func tst_alias_replace() {
    // regex_replace 别名 + 组引用 $1/$2
    chk_str("rp_swap", rxp.regex_replace("ab", "(a)(b)", "$2$1"), "ba")
    // 多段替换（各匹配独立展开）
    chk_str("rp_multi", rxp.regex_replace("1 22 333", "([0-9]+)", "[$1]"), "[1] [22] [333]")
}

func chk_i64_(name: string, t: table<string>, want: i64) {
    if len(t) == want {
        println("PASS " + name)
    } else {
        println("FAIL " + name + " len=" + to_string(len(t)))
        exit(1)
    }
}

func main() {
    tst_lookahead()
    tst_backref()
    tst_lazy()
    tst_unicode()
    tst_alias_replace()
    println("regexpx done")
    exit(0)
}