type tie<logic>
// tests/_p91131_selimp_probe/lib_a.tie —— 选择性导入被导入库
// pub_a 依赖 helper_a（验证依赖闭包跟随保留）；pub_b 独立（验证过滤）。

/// pub_a 依赖 helper_a
func pub_a(x: i64) -> i64 {
    return helper_a(x) + 1
}

/// helper_a 仅被 pub_a 使用
func helper_a(x: i64) -> i64 {
    return x * 2
}

/// pub_b 独立于 pub_a
func pub_b(x: i64) -> i64 {
    return x - 1
}
