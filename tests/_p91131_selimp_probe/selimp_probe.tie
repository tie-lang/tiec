type tie<logic>
// tests/_p91131_selimp_probe/selimp_probe.tie —— p.9.11.31 选择性导入验收
// 只导入 pub_a；pub_a 内部依赖 helper_a 随闭包保留 → 调用成功。
// 期望输出 s:OK1 s:OK2，exit 0。

import "tests/_p91131_selimp_probe/lib_a.tie".{pub_a}

func main() {
    if pub_a(1) == 3 {
        println("s:OK1")
    } else {
        println("s:FAIL1")
    }
    // helper_a 随闭包保留（pub_a 的内部依赖）——调用它验证登记存在
    if helper_a(4) == 8 {
        println("s:OK2")
    } else {
        println("s:FAIL2")
    }
}
