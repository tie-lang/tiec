type tie<logic>
// tests/avif_probe/avif_probe.tie —— p.9.1.1.3 验收：ext/avif 如实登记（无 libavif）。
// 本环境无 libavif/libaom，本库不实现伪解码；探针断言其诚实登记状态：
//   available()==false；decode 对任意输入恒 ok=false（绝不伪解码）；
//   probe() 返回稳定诊断串。期望全部 PASS / exit 0。
import "../../ext/avif/avif.tie" as avif

var fails: i64 = 0

func check(cond: bool, msg: string) {
    if cond {
        println("PASS " + msg)
    } else {
        println("FAIL " + msg)
        fails = fails + 1
    }
}

func main() {
    println("start")
    check(avif.available() == false, "avif.available() == false (FFI dependency registered)")

    var empty = avif.decode(table_new_i64())
    check(empty.ok == false && str_len(empty.err) > 0, "decode(empty) -> ok=false + err")

    // 构造一段假想的"AVIF 字节"（真实 AVIF 头应有 ftyp/avif 等 box，但本库不解析）
    var fake = table_new_i64()
    var i: i64 = 0
    while i < 64 {
        table_push(fake, 0x00)
        i = i + 1
    }
    fake[4] = 0x66; fake[5] = 0x74; fake[6] = 0x79; fake[7] = 0x70   // "ftyp"
    var d = avif.decode(fake)
    check(d.ok == false, "decode(any bytes) -> ok=false (no fake decoding)")
    check(str_len(d.err) > 10, "decode err message explains FFI pending")

    var p = avif.probe()
    check(p == "libavif: NOT in-place; unavailable(awaiting provisioning)", "probe() stable diagnostic")

    if fails == 0 {
        println("PASS")
    } else {
        println("FAIL count=" + to_string(fails))
    }
    println("done")
}