type tie<logic>
// ============================================================================
// tests/color_probe/color_probe.tie：std/color 颜色工具探针（p.9.1.1.11）。
// Color tools probe (p.9.1.1.11).
//
// 覆盖（Coverage）：
//   - sRGB↔Linear 往返：若干样例（含暗部</br>亮部 gamma 分段）round-trip 误差 < 0.000001；
//   - 已知线性值核对：0.5 sRGB → 0.214041（标准值）；线性 → sRGB 反演路面复原；
//   - hex 解析：#RGB / #RRGGBB / 无 # / 非法（空表）；
//   - to_hex 序列化往返；
//   - RGB↔HSV 互转数值核对（纯红/纯绿/纯蓝/灰、已知 hsv 样例）+ 往返；
//   - RGB↔HSL 互转 + 往返；
//   - 灰度 luma、alpha 混合（Porter-Duff over）合成值核对、delta-E（0 与 100）。
// 数据平面：全部 f64/string。夹具内联。
// 编译运行：compiler\tiec.exe tests\color_probe\color_probe.tie
// ============================================================================
import "/std/color.tie" as color

// ---- 断言工具（f64 容差）----
func chk_str(name: string, got: string, want: string) {
    if got == want {
        println("PASS " + name)
    } else {
        println("FAIL " + name + " got=[" + got + "] want=[" + want + "]")
        exit(1)
    }
}

func chk_i64(name: string, got: i64, want: i64) {
    if got == want {
        println("PASS " + name)
    } else {
        println("FAIL " + name + " got=" + to_string(got) + " want=" + to_string(want))
        exit(1)
    }
}

func chk_ok(name: string, ok: bool) {
    if ok {
        println("PASS " + name)
    } else {
        println("FAIL " + name + " (条件不满足)")
        exit(1)
    }
}

func chk_near(name: string, got: f64, want: f64, eps: f64) {
    var diff = got - want
    if diff < 0.0 {
        diff = -diff
    }
    if diff <= eps {
        println("PASS " + name)
    } else {
        println("FAIL " + name + " got=" + to_string(got) + " want=" + to_string(want) + " eps=" + to_string(eps))
        exit(1)
    }
}

func chk_table_near(name: string, got: table<f64>, want: table<f64>) {
    if len(got) != len(want) {
        println("FAIL " + name + " 长度不等")
        exit(1)
    }
    var i: i64 = 0
    while i < len(want) {
        var d = got[i] - want[i]
        if d < 0.0 {
            d = -d
        }
        if d > 0.000001 {
            println("FAIL " + name + "[" + to_string(i) + "] got=" + to_string(got[i]) + " want=" + to_string(want[i]))
            exit(1)
        }
        i = i + 1
    }
    println("PASS " + name)
}

// ---- sRGB↔Linear ----
func tst_srgb_linear() {
    // 0 → 0
    chk_near("sl_0", color.srgb_to_linear_ch(0.0), 0.0, 0.000000000001)
    // 1 → 1
    chk_near("sl_1", color.srgb_to_linear_ch(1.0), 1.0, 0.000000001)
    // 0.5 → 0.21404114048223255（标准 sRGB)
    chk_near("sl_mid", color.srgb_to_linear_ch(0.5), 0.21404114048223255, 0.000001)
    // 暗部 0.02（<=0.04045，线性段）：0.02/12.92 = 0.0015479876...
    chk_near("sl_dark", color.srgb_to_linear_ch(0.02), 0.02 / 12.92, 0.000000001)
    // 往返：多组样例恢复
    var samples: table<f64> = table_new_f64()
    table_push(samples, 0.03)
    table_push(samples, 0.1)
    table_push(samples, 0.2)
    table_push(samples, 0.45)
    table_push(samples, 0.73)
    table_push(samples, 0.9)
    var ok: bool = true
    var i: i64 = 0
    while i < len(samples) {
        var v = samples[i]
        var back = color.linear_to_srgb_ch(color.srgb_to_linear_ch(v))
        var dd = back - v
        if dd < 0.0 {
            dd = -dd
        }
        if dd > 0.000000001 {
            ok = false
        }
        i = i + 1
    }
    chk_ok("sl_roundtrip_multi", ok)
    // 整体表往返
    var rgb = color.new_rgb(0.4, 0.7, 0.9)
    var linear = color.srgb_to_linear(rgb)
    var back2 = color.linear_to_srgb(linear)
    chk_table_near("sl_vec_roundtrip", back2, rgb)
}

// ---- hex ----
func tst_hex() {
    // #F00 → [1,0,0]
    var r0 = color.parse_hex("#F00")
    chk_i64("hex_f00_len", len(r0), 3)
    chk_near("hex_f00_r", r0[0], 1.0, 0.000000001)
    chk_near("hex_f00_g", r0[1], 0.0, 0.000000000001)
    // #336699 / 无 #
    var r1 = color.parse_hex("#336699")
    chk_i64("hex_336699_len", len(r1), 3)
    chk_near("hex_336699_r", r1[0], 51.0 / 255.0, 0.000000001)
    chk_near("hex_336699_g", r1[1], 102.0 / 255.0, 0.000000001)
    chk_near("hex_336699_b", r1[2], 153.0 / 255.0, 0.000000001)
    var r2 = color.parse_hex("336699")
    chk_i64("hex_no_hash_len", len(r2), 3)
    chk_near("hex_no_hash_r", r2[0], 51.0 / 255.0, 0.000000001)
    // to_hex 往返：0 与 255/255=1 边界 + 中值
    chk_str("tohex_white", color.to_hex(color.new_rgb(1.0, 1.0, 1.0)), "#FFFFFF")
    chk_str("tohex_black", color.to_hex(color.new_rgb(0.0, 0.0, 0.0)), "#000000")
    chk_str("tohex_red", color.to_hex(color.new_rgb(1.0, 0.0, 0.0)), "#FF0000")
    chk_str("tohex_50", color.to_hex(color.new_rgb(0.5, 0.5, 0.5)), "#808080")
    // parse(to_hex(x)) 往返
    var rr = color.parse_hex(color.to_hex(color.new_rgb(0.5, 0.35, 0.95)))
    chk_i64("tohex_parse_len", len(rr), 3)
    chk_near("tohex_parse_r", rr[0], 0.5, 1.0 / 255.0)
    chk_near("tohex_parse_g", rr[1], 0.35, 1.0 / 255.0)
    // 非法：bad length / 非 hex
    chk_i64("hex_bad_len", len(color.parse_hex("#12345")), 0)
    chk_i64("hex_bad_char", len(color.parse_hex("zzz")), 0)
}

// ---- HTML 中性色已知值校验（HSV）----
func tst_hsv() {
    // 纯红 [1,0,0] → h=0, s=1, v=1
    var hsv_red = color.rgb_to_hsv(color.new_rgb(1.0, 0.0, 0.0))
    chk_near("hsv_red_h", hsv_red[0], 0.0, 0.000000001)
    chk_near("hsv_red_s", hsv_red[1], 1.0, 0.000000001)
    chk_near("hsv_red_v", hsv_red[2], 1.0, 0.000000001)
    // 纯绿 [0,1,0] → h=120
    var hsv_g = color.rgb_to_hsv(color.new_rgb(0.0, 1.0, 0.0))
    chk_near("hsv_green_h", hsv_g[0], 120.0, 0.000000001)
    // 纯蓝 [0,0,1] → h=240
    var hsv_b = color.rgb_to_hsv(color.new_rgb(0.0, 0.0, 1.0))
    chk_near("hsv_blue_h", hsv_b[0], 240.0, 0.000000001)
    // 灰 [0.5,0.5,0.5] → s=0
    var hsv_gray = color.rgb_to_hsv(new_gray())
    chk_near("hsv_gray_s", hsv_gray[1], 0.0, 0.000000000001)
    chk_near("hsv_gray_v", hsv_gray[2], 0.5, 0.000000000001)
    // 经典样例：橙色 [1,0.5,0] → h=30, s=1, v=1
    var hsv_o = color.rgb_to_hsv(color.new_rgb(1.0, 0.5, 0.0))
    chk_near("hsv_orange_h", hsv_o[0], 30.0, 0.000000001)
    chk_near("hsv_orange_s", hsv_o[1], 1.0, 0.000000001)
    // hsv→rgb：红绿蓝橙
    var back_r = color.hsv_to_rgb(hsv_red)
    chk_table_near("hsvt_red", back_r, color.new_rgb(1.0, 0.0, 0.0))
    var back_g = color.hsv_to_rgb(hsv_g)
    chk_table_near("hsvt_green", back_g, color.new_rgb(0.0, 1.0, 0.0))
    var back_o = color.hsv_to_rgb(hsv_o)
    chk_table_near("hsvt_orange", back_o, color.new_rgb(1.0, 0.5, 0.0))
    // 往返：多组 RGB → HSV → RGB
    chk_table_near("hsv_roundtrip1", color.hsv_to_rgb(color.rgb_to_hsv(color.new_rgb(0.3, 0.6, 0.9))), color.new_rgb(0.3, 0.6, 0.9))
    chk_table_near("hsv_roundtrip2", color.hsv_to_rgb(color.rgb_to_hsv(color.new_rgb(0.85, 0.2, 0.45))), color.new_rgb(0.85, 0.2, 0.45))
}

func new_gray() -> table<f64> {
    var t = table_new_f64()
    table_push(t, 0.5)
    table_push(t, 0.5)
    table_push(t, 0.5)
    return t
}

// ---- HSL ----
func tst_hsl() {
    // 纯红 → h=0, s=1, l=0.5
    var hsl = color.rgb_to_hsl(color.new_rgb(1.0, 0.0, 0.0))
    chk_near("hsl_red_h", hsl[0], 0.0, 0.000000001)
    chk_near("hsl_red_s", hsl[1], 1.0, 0.000000001)
    chk_near("hsl_red_l", hsl[2], 0.5, 0.000000001)
    // 白色 → s=0, l=1
    var hsl_w = color.rgb_to_hsl(color.new_rgb(1.0, 1.0, 1.0))
    chk_near("hsl_white_l", hsl_w[2], 1.0, 0.000000001)
    chk_near("hsl_white_s", hsl_w[1], 0.0, 0.000000000001)
    // 往返
    chk_table_near("hsl_roundtrip", color.hsl_to_rgb(color.rgb_to_hsl(color.new_rgb(0.2, 0.7, 0.3))), color.new_rgb(0.2, 0.7, 0.3))
    chk_table_near("hsl_cyan", color.hsl_to_rgb(color.rgb_to_hsl(color.new_rgb(0.0, 1.0, 1.0))), color.new_rgb(0.0, 1.0, 1.0))
}

// ---- 灰度 / 混合 / delta-E ----
func tst_misc() {
    // 白 luma=1, 黑 luma=0, 中性灰 0.5
    chk_near("gray_white", color.grayscale(color.new_rgb(1.0, 1.0, 1.0)), 1.0, 0.000000000001)
    chk_near("gray_black", color.grayscale(color.new_rgb(0.0, 0.0, 0.0)), 0.0, 0.000000000001)
    chk_near("gray_neutral", color.grayscale(new_gray()), 0.5, 0.000000000001)
    // 半透明红盖半透明蓝 over → 品红分量核对
    // fg=[1,0,0,0.5], bg=[0,0,1,0.5]
    var fg = table_new_f64()
    table_push(fg, 1.0)
    table_push(fg, 0.0)
    table_push(fg, 0.0)
    table_push(fg, 0.5)
    var bg = table_new_f64()
    table_push(bg, 0.0)
    table_push(bg, 0.0)
    table_push(bg, 1.0)
    table_push(bg, 0.5)
    var blend = color.alpha_blend(fg, bg)
    // alpha = 0.5 + 0.5*0.5 = 0.75
    chk_near("blend_a", blend[3], 0.75, 0.000000001)
    // r = fg.r*0.5 / 0.75 = 0.66667
    chk_near("blend_r", blend[0], 0.5 / 0.75, 0.000001)
    // b = bg.b*0.5*0.5 / 0.75 = 0.25/0.75 = 0.3333
    chk_near("blend_b", blend[2], 0.25 / 0.75, 0.000001)
    // delta-E 同色 = 0；黑白 = 100；半程 ~ 50
    chk_near("de_same", color.delta_e(color.new_rgb(0.3, 0.4, 0.5), color.new_rgb(0.3, 0.4, 0.5)), 0.0, 0.000000001)
    chk_near("de_bw", color.delta_e(color.new_rgb(0.0, 0.0, 0.0), color.new_rgb(1.0, 1.0, 1.0)), 100.0, 0.000001)
    chk_near("de_mid", color.delta_e(color.new_rgb(0.0, 0.0, 0.0), color.new_rgb(1.0, 0.0, 0.0)), 100.0 / 1.7320508075688772, 0.000001)
}

func main() {
    tst_srgb_linear()
    tst_hex()
    tst_hsv()
    tst_hsl()
    tst_misc()
    println("color done")
    exit(0)
}