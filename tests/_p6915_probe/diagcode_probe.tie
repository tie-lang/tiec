type tie<logic>
// tests/_p6915_probe/diagcode_probe.tie —— 诊断标号探针（p.6.9.15）
// ============================================================
// 校验 compiler/frontend/diagcode.tie + diagcode_cat.gen.tie：
//   1) normalize 归一化折叠与生成器一致（ASCII 运行 → '%'）；
//   2) code_of：exact / prefix 命中、无 E0000 回退（覆盖 golden 语料代表消息）；
//   3) name_of / tail_of：短消息名与「；期望 x；实际 y」切分；
//   4) render_error / render_err_proto：error[E#####] @行:列: 格式；
//   5) 警告目录：warn_code_of / render_warning（warning[W#####] + 坏处建议）。
import "../../compiler/frontend/diagcode.tie"
import "/std/string.tie"

var g_fails: i64 = 0

func check(cond: bool, label: string) {
    if cond {
        return
    }
    g_fails = g_fails + 1
    println("FAIL: " + label)
}

func main() {
    // --- normalize 折叠 ---
    check(diagcode.normalize("字符串未闭合") == "字符串未闭合", "normalize 保留中文")
    check(diagcode.normalize("类型不匹配: i64 string") == "类型不匹配%", "normalize 整段 ASCII 折叠")
    check(diagcode.normalize("调用 'sum' 表参数元素类型不匹配：期望 table<i64>，实际 table<string>") ==
        "调用%表参数元素类型不匹配：期望%，实际%", "normalize 多插值折叠")
    check(diagcode.normalize("参数 'b' 缺少默认值：可选参数（带默认值）必须连续排在必选参数之后") ==
        "参数%缺少默认值：可选参数（带默认值）必须连续排在必选参数之后", "normalize 单插值折叠")

    // --- code_of：exact ---
    check(diagcode.code_of("字符串未闭合") != "E00000", "code_of 词法消息")
    check(diagcode.code_of("调用 'sum' 表参数元素类型不匹配：期望 table<i64>，实际 table<string>") != "E00000", "code_of 语义消息")
    check(diagcode.code_of("参数 'b' 缺少默认值：可选参数（带默认值）必须连续排在必选参数之后") != "E00000", "code_of 默认值消息")
    check(diagcode.code_of("无法读取导入文件 'no_such.tie'（文件不存在）") != "E00000", "code_of 动态路径（prefix）")
    check(diagcode.code_of("宏 'm' 展开失败: ERR:1 2 内部错误") != "E00000", "code_of 动态错误尾（prefix）")
    check(diagcode.code_of("这是一个完全未知的消息 xyz") == "E00000", "code_of 未分类兜底")

    // --- 五位纯序号格式（E + 5 位数字）---
    check(str_len(diagcode.code_of("字符串未闭合")) == 6 && str_char(diagcode.code_of("字符串未闭合"), 0) == "E",
        "code_of 五位格式")
    check(str.contains(diagcode.code_of("调用 'sum' 表参数元素类型不匹配：期望 table<i64>，实际 table<string>"), "E") &&
        str_len(diagcode.code_of("调用 'sum' 表参数元素类型不匹配：期望 table<i64>，实际 table<string>")) == 6, "code_of 五位数字长度")

    // --- name_of / tail_of ---
    check(diagcode.name_of("调用 'sum' 表参数元素类型不匹配：期望 table<i64>，实际 table<string>") ==
        "调用 'sum' 表参数元素类型不匹配", "name_of 语义切分")
    check(diagcode.name_of("字符串未闭合") == "字符串未闭合", "name_of 整条")
    check(diagcode.tail_of("调用 'sum' 表参数元素类型不匹配：期望 table<i64>，实际 table<string>") ==
        "期望 table<i64>；实际 table<string>", "tail_of 期望实际切分")

    // --- render_error / render_err_proto ---
    var r1 = diagcode.render_error(5, 9, "调用 'sum' 表参数元素类型不匹配：期望 table<i64>，实际 table<string>")
    println(r1)
    check(str.contains(r1, "error[E") && !str.contains(r1, "E00000"), "render_error 含五位标号")
    check(str.contains(r1, "@5:9:"), "render_error 含位置")
    check(str.contains(r1, "；期望 table<i64>；实际 table<string>。"), "render_error 尾段格式")
    var r2 = diagcode.render_err_proto("ERR:5 9 调用 'sum' 表参数元素类型不匹配：期望 table<i64>，实际 table<string>")
    check(str.contains(r2, "error[") && str.contains(r2, "@5:9:"), "render_err_proto 解析位置")
    println(r2)

    // --- 警告（五位）---
    check(diagcode.warn_code_of("循环内字符串拼接累积（x = x + y 逐次整体复制，O(n²)）") == "W00003", "warn_code_of 拼接")
    check(diagcode.warn_code_of("浮点相等比较（==/!= 对 f64/f32 结果不可靠）") == "W00001", "warn_code_of 浮点")
    var rw = diagcode.render_warning(12, 5, "循环内字符串拼接累积（x = x + y 逐次整体复制，O(n²)）")
    println(rw)
    check(str.contains(rw, "warning[W00003]") && str.contains(rw, "string_builder"), "render_warning 标号+建议")
    var ru = diagcode.render_warning(3, 1, "未知警告消息")
    check(str.contains(ru, "W00000"), "render_warning 未知兜底")

    // --- 警告目录：单行注册（warn_reg）+ 构建期自动排序 ---
    check(diagcode.warn_count() == 15, "warn_count 目录条数")

    // 全量核对：排序或平行表任一处错位，查到的码就会错
    var wc: table<string> = [
        "浮点相等比较（==/!= 对 f64/f32 结果不可靠）",
        "整数除法结果截断（如 7/2 == 3）",
        "循环内字符串拼接累积（x = x + y 逐次整体复制，O(n²)）",
        "表变量拷贝共享底层数组（var b = a 后 b 的修改会反映到 a）",
        "变量重复声明（同名变量再次声明，后者覆盖前者）",
        "条件恒假（if/while 条件为常量 0/false）",
        "条件恒真（if/while 条件为常量 true/非零值）",
        "整数除零（字面量 0 作除数，运行期崩溃）",
        "switch 缺少 default（未匹配值时静默无操作）",
        "未使用变量（声明后从未被读取）",
        "内存上限限制下优化档 O3 受限，已自动降为 O2",
        "roles.data.tie 解析失败，使用内置默认角色",
        "依赖包角色定义解析失败，使用内置默认角色",
        "角色重复注册，忽略后注册者",
        "角色 output 非法值，回退 lib"
    ]
    var wx: table<string> = ["W00001", "W00002", "W00003", "W00004", "W00005", "W00006",
        "W00007", "W00008", "W00009", "W00010", "W00011", "W00020", "W00021", "W00022", "W00023"]
    var wi: i64 = 0
    while wi < len(wc) {
        check(diagcode.warn_code_of(wc[wi]) == wx[wi], "warn_code_of 全量 " + wx[wi])
        wi = wi + 1
    }
    // 短名/建议随码走（平行表同步的另一重校验）
    check(diagcode.warn_name_of("整数除法结果截断（如 7/2 == 3）") == "整数除法截断", "warn_name_of 短名")
    check(str.contains(diagcode.warn_tip_of("整数除法结果截断（如 7/2 == 3）"), "f64"), "warn_tip_of 建议")

    // --- 二级匹配（对齐错误侧 exact→prefix）：ASCII 段有出入仍命中 ---
    check(diagcode.warn_code_of("整数除法结果截断（如 5/2 == 2）") == "W00002", "warn 归一化二级匹配")

    // --- 未登记审计（加发射点忘了 warn_reg 时不再静默）---
    diagcode.warn_unreg_reset()
    check(diagcode.warn_unreg_count() == 0, "warn_unreg 初始为空")
    check(diagcode.warn_code_of("这是一条尚未登记的警告 xyz") == "W00000", "warn 未登记兜底 W00000")
    check(diagcode.warn_unreg_count() == 1, "warn_unreg 记录未登记")
    check(str.contains(diagcode.warn_unreg_list(), "尚未登记"), "warn_unreg_list 含未登记项")
    check(diagcode.warn_code_of("这是一条尚未登记的警告 xyz") == "W00000", "warn 未登记仍兜底")
    check(diagcode.warn_unreg_count() == 1, "warn_unreg 去重")
    diagcode.warn_unreg_reset()
    check(diagcode.warn_unreg_count() == 0, "warn_unreg_reset 清空")

    if g_fails == 0 {
        println("ALL PASS")
    } else {
        println("FAILS=" + to_string(g_fails))
    }
}
