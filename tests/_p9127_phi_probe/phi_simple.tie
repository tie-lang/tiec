type tie<logic>
// p.9.12.7 对照组：单分支（单路径）多段字符串拼接——不应触发
// 「PHI 未分组」（ungrouped PHI）。单函数仅一条拼接链，无分支合流，
// 作为多臂探针 phi_probe.tie 的反证对照。
func main() {
    var x: i64 = 7
    var s = "a" + to_string(x) + "b" + "c"
    // 期望：a7bc
    if s == "a7bc" {
        println("PASS simple " + s)
    } else {
        println("FAIL simple got=" + s)
        exit(1)
    }
    println("p.9.12.7 phi_simple control done")
}