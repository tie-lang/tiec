type tie<tsc>

// to_i64(s) / to_f64(s) 的**文本实参**路径（规范 §2.11「文本解析为数值」）。
// 曾整条路径不可用：后端把字符串指针直通进 i64/f64 槽 ⇒ opt 报
// `defined with type 'ptr' but expected 'i64'`（E00883），任意 -l 档都编不过。
// 本探针只跑成功路径；解析失败的内建检查（诊断 + exit(1) / catch_panic 捕获）
// 由 tests/language/to_num_text_check.tie 与手工探针覆盖。
func main() -> i64 {
    var ok: i64 = 0
    if to_i64("4096") == 4096 { ok = ok + 1 } else { println("F1 " + to_string(to_i64("4096"))) }
    if to_i64("0") == 0 { ok = ok + 1 } else { println("F2 " + to_string(to_i64("0"))) }
    if to_i64("-17") == 0 - 17 { ok = ok + 1 } else { println("F3 " + to_string(to_i64("-17"))) }
    if to_i64("+8") == 8 { ok = ok + 1 } else { println("F4 " + to_string(to_i64("+8"))) }
    // 前导零、全数字；不做 n 进制推断（一律十进制）
    if to_i64("007") == 7 { ok = ok + 1 } else { println("F5 " + to_string(to_i64("007"))) }
    if to_i64("9223372036854775807") == 9223372036854775807 { ok = ok + 1 } else { println("F6 " + to_string(to_i64("9223372036854775807"))) }
    // 浮点：小数 / 指数 / 符号
    if to_f64("3.5") == 3.5 { ok = ok + 1 } else { println("F7 " + to_string(to_f64("3.5"))) }
    if to_f64("-1e3") == 0.0 - 1000.0 { ok = ok + 1 } else { println("F8 " + to_string(to_f64("-1e3"))) }
    if to_f64("0.5") == 0.5 { ok = ok + 1 } else { println("F9 " + to_string(to_f64("0.5"))) }
    // 非字面量实参（变量 / 拼接结果）走同一条运行时路径
    var s = "123"
    if to_i64(s) == 123 { ok = ok + 1 } else { println("F10 " + to_string(to_i64(s))) }
    if to_i64(s + "4") == 1234 { ok = ok + 1 } else { println("F11 " + to_string(to_i64(s + "4"))) }
    // 与数值转换族组合：先解析再窄化（规范要求窄化显式写出）
    if to_i32(to_i64("42")) == to_i32(42) { ok = ok + 1 } else { println("F12") }
    if ok == 12 {
        println("VERDICT OK")
        return 0
    }
    println("VERDICT FAIL ok=" + to_string(ok) + "/12")
    exit(1)
    return 0
}
