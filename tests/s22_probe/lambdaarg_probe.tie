type tie<script>

// p.9.11.34 短闭包实参位（上下文消歧）探针：`f(x -> expr)` 形参 fn ⇒ 短闭包。
// 覆盖：用户函数 / 函数值调用 / 命名空间函数 / 捕获外部局部 / 多实参混排。

func apply(f: fn(i64) -> i64, v: i64) -> i64 { return f(v) }
func applys(f: fn(string) -> string, s: string) -> string { return f(s) }

func double(v: i64) -> i64 { return v * 2 }

namespace ops {
    pub func run1(f: fn(i64) -> i64, v: i64) -> i64 { return f(v) + 1 }
}

func main() -> i64 {
    var ok: i64 = 0
    // 1. 用户函数实参位短闭包
    var r1 = apply(x -> x * 3, 5)
    if r1 == 15 { ok = ok + 1 } else { println("F1 r1=" + to_string(r1)) }
    // 2. 捕获外部局部
    var k: i64 = 10
    var r2 = apply(x -> x * k, 3)
    if r2 == 30 { ok = ok + 1 } else { println("F2 r2=" + to_string(r2)) }
    // 3. 多实参混排：闭包实参 + 普通实参
    var r3 = apply(x -> x + 1, apply(x -> x * 2, 4))
    if r3 == 9 { ok = ok + 1 } else { println("F3 r3=" + to_string(r3)) }
    // 4. string 形参
    var r4 = applys(s -> s + "!", "hi")
    if r4 == "hi!" { ok = ok + 1 } else { println("F4 r4=" + r4) }
    // 5. 高阶函数值调用：fn 值的形参本身是 fn ⇒ 实参位短闭包
    var fv: fn(fn(i64) -> i64, i64) -> i64 = apply
    var r5 = fv(x -> x - 1, 4)
    if r5 == 3 { ok = ok + 1 } else { println("F5 r5=" + to_string(r5)) }
    // 6. 命名空间函数
    var r6 = ops.run1(x -> x * 2, 5)
    if r6 == 11 { ok = ok + 1 } else { println("F6 r6=" + to_string(r6)) }
    // 7. 具名函数作实参（既有能力不回归）
    var r7 = apply(double, 6)
    if r7 == 12 { ok = ok + 1 } else { println("F7 r7=" + to_string(r7)) }

    if ok == 7 {
        println("VERDICT OK")
        return 0
    }
    println("VERDICT FAIL ok=" + to_string(ok) + "/7")
    exit(1)
    return 0
}
