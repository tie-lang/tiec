type tie<script>

// gap 1 修复探针：string 字段（无初值/带初值）+ string/table 经消息 ABI 回传
//（dispatch ptrtoint / 调用方 inttoptr，规范消息结果槽 result@96 单 i64）。

actor A {
    var log: string;
    var tag: string = "abc";
    var hits: table<i64>;
    pub func append(s: string) {
        log = log + s
    }
    pub func getlog() -> string { return log }
    pub func gettag() -> string { return tag }
    pub func bump() -> table<i64> {
        table_push(hits, hits_len_placeholder())
        return hits
    }
}

func hits_len_placeholder() -> i64 { return 1 }

func main() -> i64 {
    var ok: i64 = 0
    var a = run A()
    // 1. void 方法写 string 字段（跨消息累积）
    a.append("x")
    a.append("y")
    a.append("z")
    // 2. string 返回（同步 RPC，i64 槽往返）
    var l = a.getlog()
    if l == "xyz" { ok = ok + 1 } else { println("F1 l=[" + l + "]") }
    // 3. 带初值 string 字段读回
    var t = a.gettag()
    if t == "abc" { ok = ok + 1 } else { println("F2 t=[" + t + "]") }
    // 4. table 返回（ptr 表示）
    var h = a.bump()
    if len(h) == 1 && h[0] == 1 { ok = ok + 1 } else { println("F4 len=" + to_string(len(h))) }
    if ok == 3 {
        println("VERDICT OK")
        return 0
    }
    println("VERDICT FAIL ok=" + to_string(ok) + "/3")
    exit(1)
    return 0
}
