type tie<script>

// p.9.11 `is` 类型判定探针（规范 §3.16 / §2.10）。
// 覆盖：any 装 i64/f64/bool/char/string 的判定与翻转 · as_* 解包往返 ·
//       表装箱（tag=类型 id）· struct 装箱 · `is any` 恒真 · 复合条件。
// 断言自包含：全部通过打印 VERDICT OK，任一失败打印 F<n> 并 exit(1)。

struct Point {
    var x: i64 = 0
    var y: i64 = 0
}

func main() -> i64 {
    var ok: i64 = 0
    // 1. any 装 i64：is i64 真 + as_i64 解包往返
    var v: any = 42
    if v is i64 {
        var n = as_i64(v)
        if n == 42 { ok = ok + 1 } else { println("F1 n=" + to_string(n)) }
    } else { println("F1 42 判成非 i64") }
    // 2. 同一 any 值对其它类型为假
    if v is string { println("F2 42 判成 string") } else { ok = ok + 1 }
    // 3. 重绑定 string → 判定翻转
    v = "hello"
    if v is string { ok = ok + 1 } else { println("F3 string 判成非 string") }
    if v is i64 { println("F3b string 判成 i64") } else { ok = ok + 1 }
    // 4. f64 / bool / char
    var f: any = 2.5
    if f is f64 { ok = ok + 1 } else { println("F4 f64 判错") }
    var b: any = true
    if b is bool { ok = ok + 1 } else { println("F5 bool 判错") }
    var c: any = 'x'
    if c is char { ok = ok + 1 } else { println("F6 char 判错") }
    // 5. 表装箱：tag = 表类型 id
    var t: table<i64> = []
    table_push(t, 7)
    var tv: any = t
    if tv is table<i64> { ok = ok + 1 } else { println("F7 table 判错") }
    if tv is string { println("F7b table 判成 string") } else { ok = ok + 1 }
    // 6. struct 装箱：tag = 类型 id（P2c）
    var p = Point()
    p.x = 3
    var pv: any = p
    if pv is Point { ok = ok + 1 } else { println("F8 Point 判错") }
    // 7. `is any` 恒真
    var w: any = 1
    if w is any { ok = ok + 1 } else { println("F9 any 判错") }
    // 8. 复合条件 + 动态容器元素判定
    var hs: table<any> = []
    table_push(hs, 5)
    table_push(hs, "s")
    var cnt: i64 = 0
    for x in hs {
        if x is i64 { cnt = cnt + as_i64(x) }
    }
    if cnt == 5 { ok = ok + 1 } else { println("F10 cnt=" + to_string(cnt)) }
    // 9. is 参与三目/嵌套表达式
    var z: any = 5
    var lab = z is i64 ? "int" : "other"
    if lab == "int" { ok = ok + 1 } else { println("F11 lab=" + lab) }

    if ok == 13 {
        println("VERDICT OK")
        return 0
    }
    println("VERDICT FAIL ok=" + to_string(ok) + "/13")
    exit(1)
    return 0
}
