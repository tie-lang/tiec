type tie<script>

// p.9.11 `%%=` const 上下文探针：const fn 体内的 `%%=` 复合赋值必须可折叠
// （consteval exec_stmt 此前缺 op 26 路径 ⇒ cv_failed）。
// 期望：floor 取余语义（余数符号跟随除数）：cm(-7,3)=2、cm(7,-3)=-2、cm(7,3)=1。

const func cm(a: i64, b: i64) -> i64 {
    var x = a
    x %%= b
    return x
}

const R1: i64 = cm(-7, 3)
const R2: i64 = cm(7, -3)
const R3: i64 = cm(7, 3)
const R4: i64 = cm(-7, -3)

func main() -> i64 {
    var ok: i64 = 0
    if R1 == 2 { ok = ok + 1 } else { println("F1 R1=" + to_string(R1)) }
    if R2 == -2 { ok = ok + 1 } else { println("F2 R2=" + to_string(R2)) }
    if R3 == 1 { ok = ok + 1 } else { println("F3 R3=" + to_string(R3)) }
    if R4 == -1 { ok = ok + 1 } else { println("F4 R4=" + to_string(R4)) }
    if ok == 4 {
        println("VERDICT OK")
        return 0
    }
    println("VERDICT FAIL ok=" + to_string(ok) + "/4")
    exit(1)
    return 0
}
