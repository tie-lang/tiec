type tie<logic>
// tests/_p911_qrdec_probe/qrdec_probe.tie —— p.9.1.1.13 验收：ext/qrdec QR 解码。
// 依赖 ext/qr 生成端（encode/get/rs_ecc）做确定性回环，全离线：
//   1. 矩阵回环：ext/qr encode 若干文本（字母数字/数字/字节、v1/v2 各 ECL，含
//      Q 级）→ 逐模块读出 → qrdec.decode 还原文本 → 与原文本一致。
//   2. 图像回环：矩阵扩成含 quiet zone 的二值图像（scale 3）→ decode_image 定位
//      → 还原文本一致（覆盖 finder/网格采样）。
//   3. RS 纠错：qrdec.correct 全码字流（data||ecc）对承载体达 5 处字节损坏 →
//      数据码字完整还原（v1-Q：13/13）。
//   4. 负例：非法尺寸 / 垃圾矩阵 → 返回 ""（不挂死）。
import "../../ext/qr/qr.tie" as qr
import "../../ext/qrdec/qrdec.tie" as qrdec

var fails: i64 = 0

func check(cond: bool, msg: string) {
    if cond {
        println("PASS " + msg)
    } else {
        println("FAIL " + msg)
        fails = fails + 1
    }
}

// 从 qr 句柄逐模块读出 0/1 矩阵。
func build_matrix(m: i64, size: i64) -> table<i64> {
    var mat = table_new_i64()
    var r: i64 = 0
    while r < size {
        var c: i64 = 0
        while c < size {
            table_push(mat, qr.get(m, c, r))
            c = c + 1
        }
        r = r + 1
    }
    return mat
}

// 矩阵扩成二值图像（1=暗），scale，四周 4 模块 quiet zone。
func build_image(mat: table<i64>, size: i64, scale: i64) -> table<i64> {
    var dim = (size + 8) * scale
    var img = table_new_i64()
    var r: i64 = 0
    while r < dim {
        var c: i64 = 0
        while c < dim {
            var mr = r / scale - 4
            var mc = c / scale - 4
            var v: i64 = 0
            if mr >= 0 && mr < size && mc >= 0 && mc < size {
                v = mat[mr * size + mc]
            }
            table_push(img, v)
            c = c + 1
        }
        r = r + 1
    }
    return img
}

func section_matrix_roundtrip() {
    var cases = table_new_string()
    table_push(cases, "HELLO WORLD")
    table_push(cases, "HELLO")
    table_push(cases, "0123456789")
    table_push(cases, "abcdefghijklmnopqrstuvwxyz!")
    table_push(cases, "ABCDEFGHIJKLMNOPQRSTUVWXYZ")
    var ecls = table_new_i64()
    table_push(ecls, 0)
    table_push(ecls, 1)
    table_push(ecls, 2)   // Q 级
    table_push(ecls, 0)
    table_push(ecls, 0)
    var i: i64 = 0
    while i < len(cases) {
        var s = cases[i]
        var e = ecls[i]
        var m = qr.encode(s, e)
        check(m != -1, "qr.encode ok for [" + s + "] ecl " + to_string(e))
        var size = qr.size(m)
        var mat = build_matrix(m, size)
        var dec = qrdec.decode(mat, size)
        check(dec == s, "matrix roundtrip [" + s + "] (v" + to_string((size - 17) / 4) + ", ecl " + to_string(e) + ") -> " + dec)
        i = i + 1
    }
}

func section_image_roundtrip() {
    var m = qr.encode("HELLO WORLD", 2)   // Q 级
    var size = qr.size(m)
    var mat = build_matrix(m, size)
    var img = build_image(mat, size, 3)
    var dim = (size + 8) * 3
    var dec = qrdec.decode_image(img, dim, dim, 3)
    check(dec == "HELLO WORLD", "image roundtrip (Q, scale 3) -> " + dec)
    var m2 = qr.encode("0123456789", 1)
    var s2 = qr.size(m2)
    var mat2 = build_matrix(m2, s2)
    var img2 = build_image(mat2, s2, 2)
    var dim2 = (s2 + 8) * 2
    var dec2 = qrdec.decode_image(img2, dim2, dim2, 2)
    check(dec2 == "0123456789", "image roundtrip numeric (M, scale 2) -> " + dec2)
}

func section_rs() {
    // v1-Q：dc=13, ecc=13（t=6）。
    var data = table_new_i64()
    var i: i64 = 0
    while i < 13 {
        table_push(data, 0x11 + i)
        i = i + 1
    }
    var ecc = qr.rs_ecc(data, 13)
    var cw = table_new_i64()
    i = 0
    while i < 13 {
        table_push(cw, data[i])
        i = i + 1
    }
    i = 0
    while i < len(ecc) {
        table_push(cw, ecc[i])
        i = i + 1
    }
    // 损坏 5 个数据字节
    var bad = table_new_i64()
    i = 0
    while i < len(cw) {
        table_push(bad, cw[i])
        i = i + 1
    }
    bad[0] = bad[0] ^ 0x5A
    bad[3] = bad[3] ^ 0xA5
    bad[6] = bad[6] ^ 0x3C
    bad[9] = bad[9] ^ 0xC3
    bad[12] = bad[12] ^ 0xFF
    var fixed = qrdec.correct(bad, 13)
    check(len(fixed) == 26, "RS corrected full codeword length 26")
    var ok = true
    i = 0
    while i < 13 {
        if fixed[i] != data[i] {
            ok = false
        }
        i = i + 1
    }
    check(ok, "RS corrected first 13 data bytes intact after 5-byte damage")
}

func section_neg() {
    var bad_size = qrdec.decode([] /*placeholder*/, 23)
    check(bad_size == "", "unsupported size -> empty")
    // 垃圾矩阵（全 1，25×25 → v2，但格式信息无法匹配）→ 空
    var jm = table_new_i64()
    var i: i64 = 0
    while i < 25 * 25 {
        table_push(jm, 1)
        i = i + 1
    }
    var r = qrdec.decode(jm, 25)
    check(r == "", "garbage matrix -> empty")
}

func main() {
    println("start")
    section_matrix_roundtrip()
    section_image_roundtrip()
    section_rs()
    section_neg()
    if fails == 0 {
        println("PASS")
        println("done")
        exit(0)
    } else {
        println("FAIL count=" + to_string(fails))
        println("done")
        exit(1)
    }
}