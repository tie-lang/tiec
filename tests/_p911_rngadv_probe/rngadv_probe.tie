type tie<logic>
// tests/_p911_rngadv_probe/rngadv_probe.tie —— p.9.1.1.12 验收：std/rng_adv 统一随机封装。
// 覆盖：
//   1. 确定性/可复现：同种子两路独立 rng.new → 完全同序列（next/bytes/range）。
//   2. 不同种子 → 异序列。
//   3. 整数边界：range 半开 [a,b) 多次采样全部落界；irange 闭区间含 b。
//   4. 浮点：float ∈ [0,1)、frange ∈ [a,b)；精度 sanity。
//   5. 网络：rng_pick 从表取元素均在表内。
//   6. crypto：crypto_bytes → 系统 CSPRNG（bcrypt.dll::BCryptGenRandom，运行期动态
//      加载，与 csprng 同源同契约）长度正确、非全零；n<=0 → 空表哨兵。
//   7. 种子派生：seed_str 确定性；new_str 同串同序；new_entropy 熵驱动可用。
import "../../std/rng_adv.tie" as rng
import "../../std/random.tie" as rnd

var fails: i64 = 0

func check(cond: bool, msg: string) {
    if cond {
        println("PASS " + msg)
    } else {
        println("FAIL " + msg)
        fails = fails + 1
    }
}

func bytes_eq(a: table<i64>, b: table<i64>) -> bool {
    if len(a) != len(b) {
        return false
    }
    var i: i64 = 0
    while i < len(a) {
        if a[i] != b[i] {
            return false
        }
        i = i + 1
    }
    return true
}

func section_determinism() {
    var a = rng.new(42)
    var b = rng.new(42)
    var seq_a = table_new_i64()
    var seq_b = table_new_i64()
    var i: i64 = 0
    while i < 8 {
        table_push(seq_a, rng.next(a))
        table_push(seq_b, rng.next(b))
        i = i + 1
    }
    check(bytes_eq(seq_a, seq_b), "same seed -> identical sequence (next)")
    check(bytes_eq(rng.bytes(a, 12), rng.bytes(b, 12)), "same seed -> identical bytes")
}

func section_different_seed() {
    var a = rng.new(1)
    var b = rng.new(2)
    var va = rng.next(a)
    var vb = rng.next(b)
    check(va != vb, "different seeds -> different first value")
}

func section_range() {
    var r = rng.new(7)
    var i: i64 = 0
    var ok = true
    while i < 2000 {
        var v = rng.range(r, -5, 5)
        if v < -5 || v >= 5 {
            ok = false
        }
        i = i + 1
    }
    check(ok, "range [a,b) all samples in bounds")
    var sp = rng.new(9)
    // 闭区间需要 b 有代表值
    var hit_b = false
    i = 0
    while i < 300 {
        if rng.irange(sp, 3, 3) != 3 {
            check(false, "irange a==b constant")
            return
        }
        i = i + 1
    }
    check(true, "irange a==b constant")
    var r2 = rng.new(5)
    var j = 0
    while j < 500 {
        var v2 = rng.irange(r2, 0, 4)
        if v2 == 4 {
            hit_b = true
        }
        if v2 < 0 || v2 > 4 {
            check(false, "irange out of bounds")
            return
        }
        j = j + 1
    }
    check(hit_b, "irange inclusive reaches b")
}

func section_float() {
    var r = rng.new(11)
    var ok = true
    var in_half = false
    var i: i64 = 0
    while i < 2000 {
        var f = rng.float(r)
        if f < 0.0 || f >= 1.0 {
            ok = false
        }
        if f >= 0.5 {
            in_half = true
        }
        i = i + 1
    }
    check(ok, "float in [0,1)")
    check(in_half, "float distribution spreads")
    var fr = rng.new(12)
    var ok2 = true
    i = 0
    while i < 500 {
        var g = rng.frange(fr, 10.0, 20.0)
        if g < 10.0 || g >= 20.0 {
            ok2 = false
        }
        i = i + 1
    }
    check(ok2, "frange [a,b) in bounds")
}

func section_pick() {
    var r = rng.new(13)
    var t = table_new_i64()
    table_push(t, 10)
    table_push(t, 20)
    table_push(t, 30)
    table_push(t, 40)
    var ok = true
    var i: i64 = 0
    while i < 300 {
        var v = rng.pick(r, t)
        if v != 10 && v != 20 && v != 30 && v != 40 {
            ok = false
        }
        i = i + 1
    }
    check(ok, "rng_pick returns elements from table")
    var empty = table_new_i64()
    check(rng.pick(r, empty) == 0, "rng_pick empty table -> 0")
}

func section_crypto() {
    var cb = rng.crypto_bytes(16)
    check(len(cb) == 16, "crypto_bytes(16) length 16")
    var nonzero = false
    var i: i64 = 0
    while i < len(cb) {
        if cb[i] != 0 {
            nonzero = true
        }
        i = i + 1
    }
    check(nonzero, "crypto_bytes non-all-zero")
    var neg = rng.crypto_bytes(0)
    check(len(neg) == 0, "crypto_bytes(0) empty")
}

func section_seed() {
    check(rng.seed_str("alpha") == rng.seed_str("alpha"), "seed_str deterministic")
    check(rng.seed_str("alpha") != rng.seed_str("beta"), "seed_str differs by string")
    var a = rng.new_str("hello")
    var b = rng.new_str("hello")
    check(rng.next(a) == rng.next(b), "new_str same string -> same sequence")
    var c = rng.new_str("world")
    check(rng.next(a) != rng.next(c), "new_str different string -> different sequence")
    var e = rng.new_entropy()
    check(len(e) == 1, "new_entropy builds state")
}

func main() {
    println("start")
    section_determinism()
    section_different_seed()
    section_range()
    section_float()
    section_pick()
    section_crypto()
    section_seed()
    // 与旧 std/random 并存：rnd 仍工作（向后兼容未破坏）
    var x = rnd.int(0, 100)
    check(x >= 0 && x <= 100, "legacy rnd.int still works")
    if fails == 0 {
        println("PASS")
        println("done")
        exit(0)
    } else {
        println("FAIL count=" + to_string(fails))
        println("done")
        exit(1)
    }
}