type tie<logic>
// tests/_p911_bmp_probe/bmp_probe.tie —— p.9.1.1.14 验收：ext/bmp BMP 编解码。
// 全离线确定性探针：
//   1. 手工构建 24bpp BMP（宽 3 → 每行 9+3 补位到 12，负高=自上而下）→ 解码，
//      验证像素逐点一致（覆盖行对齐补位 + top-down 扫描）。
//   2. bmp.encode(4x3) → decode → 回环，RGB 逐点一致（行补位）。
//   3. 8bpp 调色板 BMP（4 色：黑/红/绿/蓝，2x4 索引图）→ 解码展开为 RGB 对拍。
//   4. 负例：坏魔数 / 截断 → ok=false（不 hang）。
// 期望全部 PASS / exit 0。
import "/ext/bmp/bmp.tie" as bmp

var fails: i64 = 0

func check(cond: bool, msg: string) {
    if cond {
        println("PASS " + msg)
    } else {
        println("FAIL " + msg)
        fails = fails + 1
    }
}

func push_u16(t: table<i64>, v: i64) {
    table_push(t, v & 0xFF)
    table_push(t, (v >> 8) & 0xFF)
}

func push_u32(t: table<i64>, v: i64) {
    table_push(t, v & 0xFF)
    table_push(t, (v >> 8) & 0xFF)
    table_push(t, (v >> 16) & 0xFF)
    table_push(t, (v >> 24) & 0xFF)
}

// 手工构建 24bpp top-down BMP（负高）。rgb 为 RGB flat，row-major 自上而下。
func mk_bmp24_topdown(w: i64, h: i64, rgb: table<i64>) -> table<i64> {
    var rb = (((24 * w) + 31) / 32) * 4
    var pxbytes = rb * h
    var t = table_new_i64()
    table_push(t, 0x42)
    table_push(t, 0x4D)
    push_u32(t, 54 + pxbytes)     // filesize
    push_u16(t, 0)                // reserved
    push_u16(t, 0)
    push_u32(t, 54)               // pixel offset
    push_u32(t, 40)               // infoheader size
    push_u32(t, w)
    push_u32(t, -h)               // negative height = top-down
    push_u16(t, 1)                // planes
    push_u16(t, 24)               // bpp
    push_u32(t, 0)                // compression = BI_RGB
    push_u32(t, pxbytes)          // imagesize
    push_u32(t, 0)                // xppm
    push_u32(t, 0)                // yppm
    push_u32(t, 0)                // colorsUsed
    push_u32(t, 0)                // colorsImportant
    var row: i64 = 0
    while row < h {
        var col: i64 = 0
        while col < w {
            var base = (row * w + col) * 3
            table_push(t, rgb[base + 2])   // B
            table_push(t, rgb[base + 1])   // G
            table_push(t, rgb[base + 0])   // R
            col = col + 1
        }
        var pad: i64 = 0
        while pad < rb - w * 3 {
            table_push(t, 0)
            pad = pad + 1
        }
        row = row + 1
    }
    return t
}

// 手工构建 8bpp top-down BMP。indices 为行优先索引（0..pal_count-1），
// pal_bgr 为 RGB flat（内部转存为 4 字节 BGRA 条目）。
func mk_bmp8(w: i64, h: i64, pal_count: i64, pal_rgb: table<i64>, indices: table<i64>) -> table<i64> {
    var rb = (((8 * w) + 31) / 32) * 4
    var pxbytes = rb * h
    var t = table_new_i64()
    table_push(t, 0x42)
    table_push(t, 0x4D)
    push_u32(t, 14 + 40 + pal_count * 4 + pxbytes)
    push_u16(t, 0)
    push_u16(t, 0)
    push_u32(t, 14 + 40 + pal_count * 4)   // pixel offset
    push_u32(t, 40)
    push_u32(t, w)
    push_u32(t, -h)
    push_u16(t, 1)
    push_u16(t, 8)
    push_u32(t, 0)
    push_u32(t, pxbytes)
    push_u32(t, 0)
    push_u32(t, 0)
    push_u32(t, pal_count)
    push_u32(t, 0)
    // palette：每项 B,G,R,reserved
    var i: i64 = 0
    while i < pal_count {
        table_push(t, pal_rgb[i * 3 + 2])   // B
        table_push(t, pal_rgb[i * 3 + 1])   // G
        table_push(t, pal_rgb[i * 3 + 0])   // R
        table_push(t, 0)
        i = i + 1
    }
    var row: i64 = 0
    while row < h {
        var col: i64 = 0
        while col < w {
            table_push(t, indices[row * w + col])
            col = col + 1
        }
        var pad: i64 = 0
        while pad < rb - w {
            table_push(t, 0)
            pad = pad + 1
        }
        row = row + 1
    }
    return t
}

func rgb_eq(a: table<i64>, b: table<i64>) -> bool {
    if len(a) != len(b) {
        return false
    }
    var i: i64 = 0
    while i < len(a) {
        if a[i] != b[i] {
            return false
        }
        i = i + 1
    }
    return true
}

func section_24bpp_manual() {
    // 3x2 图像，宽 3 → 每行 12 字节（9 像素 + 3 补位），负高 top-down
    var rgb = table_new_i64()
    table_push(rgb, 10)
    table_push(rgb, 20)
    table_push(rgb, 30)
    table_push(rgb, 40)
    table_push(rgb, 50)
    table_push(rgb, 60)
    table_push(rgb, 70)
    table_push(rgb, 80)
    table_push(rgb, 90)
    table_push(rgb, 100)
    table_push(rgb, 110)
    table_push(rgb, 120)
    table_push(rgb, 130)
    table_push(rgb, 140)
    table_push(rgb, 150)
    table_push(rgb, 160)
    table_push(rgb, 170)
    table_push(rgb, 180)
    var bytes = mk_bmp24_topdown(3, 2, rgb)
    // 每行 12 字节 × 2 行 = 24 像素字节 + 54 头
    check(len(bytes) == 54 + 24, "manual 3x2 24bpp length 54+24")
    var d = bmp.decode(bytes)
    check(d.ok == 1, "manual 24bpp decode ok")
    check(d.w == 3 && d.h == 2, "manual 24bpp dims 3x2")
    check(d.bpp == 24, "manual 24bpp bpp 24")
    check(rgb_eq(d.pixels, rgb), "manual 24bpp pixels equal (incl padding+topdown)")
}

func section_roundtrip() {
    // 4x3 RGB → encode → decode 回环
    var w: i64 = 4
    var h: i64 = 3
    var rgb = table_new_i64()
    var i: i64 = 0
    while i < w * h {
        table_push(rgb, (i * 37) & 0xFF)
        table_push(rgb, (i * 91 + 13) & 0xFF)
        table_push(rgb, (i * 53 + 200) & 0xFF)
        i = i + 1
    }
    var bytes = bmp.encode(w, h, rgb)
    var d = bmp.decode(bytes)
    check(d.ok == 1, "roundtrip decode ok")
    check(d.w == w && d.h == h, "roundtrip dims")
    check(d.bpp == 24, "roundtrip bpp 24")
    check(rgb_eq(d.pixels, rgb), "roundtrip pixels equal")
}

func section_8bpp_palette() {
    var pal_rgb = table_new_i64()
    table_push(pal_rgb, 0)
    table_push(pal_rgb, 0)
    table_push(pal_rgb, 0)
    table_push(pal_rgb, 255)
    table_push(pal_rgb, 0)
    table_push(pal_rgb, 0)
    table_push(pal_rgb, 0)
    table_push(pal_rgb, 255)
    table_push(pal_rgb, 0)
    table_push(pal_rgb, 0)
    table_push(pal_rgb, 0)
    table_push(pal_rgb, 255)
    var indices = table_new_i64()
    table_push(indices, 0)
    table_push(indices, 1)
    table_push(indices, 2)
    table_push(indices, 3)
    table_push(indices, 3)
    table_push(indices, 2)
    table_push(indices, 1)
    table_push(indices, 0)
    var bytes = mk_bmp8(4, 2, 4, pal_rgb, indices)
    var d = bmp.decode(bytes)
    check(d.ok == 1, "8bpp decode ok")
    check(d.w == 4 && d.h == 2, "8bpp dims")
    check(d.bpp == 8, "8bpp bpp 8")
    // 期望展开：黑 红 绿 蓝 | 蓝 绿 红 黑
    var exp = table_new_i64()
    table_push(exp, 0)
    table_push(exp, 0)
    table_push(exp, 0)
    table_push(exp, 255)
    table_push(exp, 0)
    table_push(exp, 0)
    table_push(exp, 0)
    table_push(exp, 255)
    table_push(exp, 0)
    table_push(exp, 0)
    table_push(exp, 0)
    table_push(exp, 255)
    table_push(exp, 0)
    table_push(exp, 0)
    table_push(exp, 255)
    table_push(exp, 0)
    table_push(exp, 255)
    table_push(exp, 0)
    table_push(exp, 255)
    table_push(exp, 0)
    table_push(exp, 0)
    table_push(exp, 0)
    table_push(exp, 0)
    table_push(exp, 0)
    check(rgb_eq(d.pixels, exp), "8bpp palette-expanded pixels equal")
    check(len(d.palette) == 12, "8bpp palette has 4 RGB entries")
}

func section_neg() {
    var bad = table_new_i64()
    table_push(bad, 0xAB)
    table_push(bad, 0x00)
    var d = bmp.decode(bad)
    check(d.ok == 0, "bad magic -> ok=0")
    // 合法魔数但截断（<54）
    var trun = table_new_i64()
    table_push(trun, 0x42)
    table_push(trun, 0x4D)
    var d2 = bmp.decode(trun)
    check(d2.ok == 0, "truncated -> ok=0")
}

func main() {
    println("start")
    section_24bpp_manual()
    section_roundtrip()
    section_8bpp_palette()
    section_neg()
    if fails == 0 {
        println("PASS")
        println("done")
        exit(0)
    } else {
        println("FAIL count=" + to_string(fails))
        println("done")
        exit(1)
    }
}