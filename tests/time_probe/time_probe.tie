type tie<logic>
// ============================================================================
// tests/time_probe/time_probe.tie：std/time 单调高分辨率时钟探针（p.9.1.1.20）。
// Monotonic high-resolution clock probe (p.9.1.1.20).
//
// 覆盖（Coverage）：
//   - mono_ms() 两次相邻调用单调不递减（ge，允许相等——粒度为 ~15.6ms）；
//   - 空耗循环后 mono_elapsed_ms() 严格递增且 > 0；
//   - mono_start()/mono_elapsed_ms() 简易计时器语义；
//   - 单调时钟相对墙钟的关系：mono_ms() 数值远小于 now_ms()（一个是自启动起
//     毫秒，一个是 Unix 纪元秒×1000），且方向一致（都是毫秒量纲）；
//   - GetTickCount64 外部符号链接成功（能跑通即证明 extern 可链 kernel32）。
// 数据平面：全部 i64。夹具内联。
// 编译运行：compiler\tiec.exe tests\time_probe\time_probe.tie
// ============================================================================
import "../../std/time.tie" as time

func chk_ok(name: string, ok: bool) {
    if ok {
        println("PASS " + name)
    } else {
        println("FAIL " + name)
        exit(1)
    }
}

func chk_i64(name: string, got: i64, want: i64) {
    if got == want {
        println("PASS " + name)
    } else {
        println("FAIL " + name + " got=" + to_string(got) + " want=" + to_string(want))
        exit(1)
    }
}

func main() {
    // 1) 相邻调用单调不递减（geq；粒度为定时器周期，允许相等）
    var a = time.mono_ms()
    var b = time.mono_ms()
    chk_ok("mono_nondecreasing", b >= a)

    // 2) 自旋至单调时钟跨过至少一个 tick → elapsed 严格 >= 1（GetTickCount
    //    粒度约 15.6ms，弹性等待；有界 guard 防死循环）
    time.mono_start()
    var guard: i64 = 0
    while guard < 300000000 {
        if time.mono_elapsed_ms() >= 1 {
            break
        }
        guard = guard + 1
    }
    var elapsed = time.mono_elapsed_ms()
    chk_ok("mono_acc_sane", guard < 300000000)
    chk_ok("mono_elapsed_gt0", elapsed >= 1)

    // 3) mono_start 后 elapsed 相对起点增量：两次测量的第二次严格 > 第一次
    time.mono_start()
    var c = time.mono_elapsed_ms()
    var d = time.mono_elapsed_ms()
    chk_ok("mono_elapsed_geq", d >= c)

    // 4) 与墙钟关系：mono_ms()（自启动起毫秒）应远小于 now_ms()（Unix 纪元秒×1000）
    chk_ok("mono_less_than_wall", time.mono_ms() < time.now_ms())

    // 5) 现有时钟仍工作（向后兼容回归）
    chk_i64("seconds_ok", time.seconds(3), 3000)

    println("time done")
    exit(0)
}