type tie<class>
// compiler/backend/irgen_bi_dyn.tie —— 内置生成器：动态加载原语（winsqlite3.dll C ABI 桥）
// ============================================================
// 自 irgen_expr.tie 的 builtin_expr 拆出（p.9.21.2 两步制①）。
// 范式：同 namespace 跨文件（文本内联）——只含函数与注释，
// 顶层全局 var 与 import 树留在 irgen.tie 主文件。
namespace irgen {
// 动态加载原语（p.6.6.20 std/sqlite：winsqlite3.dll C ABI 桥）
// 内置 `load_library`（p.9.21.2 两步制①：自 builtin_expr 提取）
pub func bi_load_library(nm: string, id: i64) -> i64 {
if nm == "load_library" {
    var namev = tig_expr(call_arg(id, 0))
    if namev < 0 {
        return -1
    }
    var w = tig_wide16(namev)
    var h = tig_ext_call1("LoadLibraryW", w, types.named(TK_STR), types.named(TK_I64))
    g_builtin_res = h
    return 0
}
}

// 动态加载原语（p.6.6.20 std/sqlite：winsqlite3.dll C ABI 桥）
// 内置 `get_proc`（p.9.21.2 两步制①：自 builtin_expr 提取）
pub func bi_get_proc(nm: string, id: i64) -> i64 {
if nm == "get_proc" {
    var hnd = tig_expr(call_arg(id, 0))
    if hnd < 0 {
        return -1
    }
    var nmv = tig_expr(call_arg(id, 1))
    if nmv < 0 {
        return -1
    }
    var hty = node_types[call_arg(id, 0)]
    if hty != types.named(TK_I64) && hty != types.named(TK_U64) && hty >= 0 {
        var sh = tig_sext(hnd, hty, types.named(TK_I64))
        if sh < 0 {
            return -1
        }
        hnd = sh
    }
    var ats: table<i64> = table_new_i64()
    var avs: table<i64> = table_new_i64()
    table_push(ats, types.named(TK_I64)); table_push(avs, hnd)
    table_push(ats, types.named(TK_STR)); table_push(avs, nmv)
    var p = tig_ext_call_typed("GetProcAddress", ats, avs, types.named(TK_I64))
    g_builtin_res = p
    return 0
}
}

// 动态加载原语（p.6.6.20 std/sqlite：winsqlite3.dll C ABI 桥）
// 内置 `cstr_to_string`（p.9.21.2 两步制①：自 builtin_expr 提取）
pub func bi_cstr_to_string(nm: string, id: i64) -> i64 {
if nm == "cstr_to_string" {
    var addr = tig_expr(call_arg(id, 0))
    if addr < 0 {
        return -1
    }
    // addr 是 i64 指针整数（dyn_call_p/get_proc 返回值）→ inttoptr → ptr，
    // 否则 s21_gep 基址被 to_ptr 原样输出（i64 当 ptr → LLVM 类型错）
    var ap = ir.new_inst(g_cur_block, 25, types.named(TK_STR))
    ir.add_operand(ap, addr, 0)
    var addrp = ir.get_value(ap)
    var hv = s21_sb_new()
    var ia = ir.new_inst(g_cur_block, 20, types.named(TK_I64))
    ir.add_operand(ia, types.named(TK_I64), 2)
    var ip = ir.get_value(ia)
    s21_store(ip, tig_int_lit(0), types.named(TK_I64))
    var hd = ir.new_block(g_cur_func, interner.intern("cs.h"))
    var bd = ir.new_block(g_cur_func, interner.intern("cs.b"))
    var ex = ir.new_block(g_cur_func, interner.intern("cs.x"))
    var br0 = ir.new_inst(g_cur_block, 30, -1)
    ir.add_operand(br0, hd, 1)
    g_cur_block = hd
    var iv = s21_load(ip, types.named(TK_I64))
    var byt = s21_zext(s21_load(s21_gep(addrp, iv, false), types.named(TK_I8)), types.named(TK_I8))
    var nul = tig_cmp_zero(byt, 0)
    var cb = ir.new_inst(g_cur_block, 31, -1)
    ir.add_operand(cb, nul, 0)
    ir.add_operand(cb, ex, 1)
    ir.add_operand(cb, bd, 1)
    g_cur_block = bd
    var iv2 = s21_load(ip, types.named(TK_I64))
    s21_sb_append_byte(hv, byt)
    s21_store(ip, s21_bin(0, iv2, tig_int_lit(1)), types.named(TK_I64))
    var brb = ir.new_inst(g_cur_block, 30, -1)
    ir.add_operand(brb, hd, 1)
    g_cur_block = ex
    g_builtin_res = s21_sb_build(hv)
    return 0
}
}

// 动态加载原语（p.6.6.20 std/sqlite：winsqlite3.dll C ABI 桥）
// 内置 `to_string`（p.9.21.2 两步制①：自 builtin_expr 提取）
pub func bi_to_string(nm: string, id: i64) -> i64 {
if nm == "to_string" {
    var v = tig_expr(call_arg(id, 0))
    if v < 0 {
        return -1
    }
    // 实参类型：f64 → 用 i128 内联除数换成「浮点暂保留 Rust 桥」见下；
    // i64/u64 → tig_i64_to_str（去 Rust）；窄整数 sext → i64 后再内联。
    var vt = node_types[call_arg(id, 0)]
    if vt == types.named(TK_STR) {
        // p.8.2.3 字符串插值：to_string(string) 返回自身（插值拼接链
        // 统一包 to_string——string 段直通，数字/布尔段走数值转换）
        g_builtin_res = v
    } else if vt == types.named(TK_BOOL) {
        // p.8.2.3 bool 插值：cond_br + phi → "true"/"false"
        //（const_str 是 i64 指针整数，llvmgen 字符串 phi 分支自动转真 ptr）
        var t_str = tig_str_lit(interner.intern("\"true\""))
        var f_str = tig_str_lit(interner.intern("\"false\""))
        var bcond = tig_cond_to_bool(v, types.named(TK_BOOL))
        var t_blk = ir.new_block(g_cur_func, interner.intern("tos.t"))
        var f_blk = ir.new_block(g_cur_func, interner.intern("tos.f"))
        var m_blk = ir.new_block(g_cur_func, interner.intern("tos.m"))
        var cbr = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cbr, bcond, 0)
        ir.add_operand(cbr, t_blk, 1)
        ir.add_operand(cbr, f_blk, 1)
        g_cur_block = t_blk
        var br1 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br1, m_blk, 1)
        g_cur_block = f_blk
        var br2 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br2, m_blk, 1)
        g_cur_block = m_blk
        var phi = ir.new_inst(g_cur_block, 33, types.named(TK_STR))
        ir.add_operand(phi, t_str, 0)
        ir.add_operand(phi, t_blk, 1)
        ir.add_operand(phi, f_str, 0)
        ir.add_operand(phi, f_blk, 1)
        g_builtin_res = ir.get_value(phi)
    } else if vt == types.named(TK_F64) || vt == types.named(TK_F32) {
        // p.6.4.4：去 Rust 桥（tie_to_string_f64）→ 内联 tig_f64_to_str
        //（CRT snprintf "%.17g" → 带头串；Rust 最短表示差异可接受）。
        var fv = v
        if vt == types.named(TK_F32) {
            fv = tig_coerce(v, types.named(TK_F32), types.named(TK_F64))  // fpext → f64
        }
        g_builtin_res = tig_f64_to_str(fv)
    } else if vt == types.named(TK_I128) || vt == types.named(TK_U128) {
        // 批次 2（i128/u128）：内联除法循环生成十进制串
        g_builtin_res = tig_i128_to_str(v, vt == types.named(TK_I128))
    } else if vt == types.named(TK_I64) {
        g_builtin_res = tig_i64_to_str(v, true)
    } else if vt == types.named(TK_U64) {
        g_builtin_res = tig_i64_to_str(v, false)
    } else if vt < 0 {
        g_builtin_res = tig_i64_to_str(v, false)
    } else {
        // 窄类型（trit/char/i8/i16/i32/u8/u16/u32 等）：sext → i64
        var sv = tig_sext(v, vt, types.named(TK_I64))
        if sv < 0 {
            return -1
        }
        g_builtin_res = tig_i64_to_str(sv, true)
    }
    return 0
}
}

// 动态加载原语（p.6.6.20 std/sqlite：winsqlite3.dll C ABI 桥）
// 内置 `parse_int`（p.9.21.2 两步制①：自 builtin_expr 提取）
pub func bi_parse_int(nm: string, id: i64) -> i64 {
if nm == "parse_int" {
    // 去 Rust 桥（批次A）：tig_parse_int 内联 IR 生成（字节循环累加），
    // 替代 Rust 桥 tie_parse_int。签名 (s, ok 出参槽) -> i64。不再置 g_used_interp。
    var v = tig_expr(call_arg(id, 0))
    if v < 0 {
        return -1
    }
    var pio = ir.new_inst(g_cur_block, 20, types.named(TK_I8))  // alloca i8 ok
    ir.add_operand(pio, types.named(TK_I8), 2)
    g_builtin_res = tig_parse_int(v, ir.get_value(pio))
    return 0
}
}

