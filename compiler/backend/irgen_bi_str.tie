// S2.1 字符串 {ptr,len} 原语
// 内置 `string_builder`（p.9.21.2 两步制①：自 builtin_expr 提取）
pub func bi_string_builder(nm: string, id: i64) -> i64 {
if nm == "string_builder" {
    // string_builder()：新建 StringBuilder 句柄（i64；两级指针 {cap,len,data}）
    g_builtin_res = s21_sb_new()
    return 0
}
}

// S2.1 字符串 {ptr,len} 原语
// 内置 `sb_append`（p.9.21.2 两步制①：自 builtin_expr 提取）
pub func bi_sb_append(nm: string, id: i64) -> i64 {
if nm == "sb_append" {
    // sb_append(h, s)：原地追加字符串（容量不足自动倍增重分配）；返回 0
    var h = tig_expr(call_arg(id, 0))
    if h < 0 {
        return -1
    }
    var v = tig_expr(call_arg(id, 1))
    if v < 0 {
        return -1
    }
    s21_sb_append(h, v)
    g_builtin_res = tig_int_lit(0)
    return 0
}
}

