type tie<class>
// compiler/backend/irgen_bi_str.tie —— 内置生成器：字符串 {ptr,len} 原语（S2.1）
// ============================================================
// 自 irgen_expr.tie 的 builtin_expr 拆出（p.9.21.2 两步制①）。
// 范式：同 namespace 跨文件（文本内联）——只含函数与注释，
// 顶层全局 var 与 import 树留在 irgen.tie 主文件。
namespace irgen {
// S2.1 字符串 {ptr,len} 原语
// 内置 `str_byte`（p.9.21.2 两步制①：自 builtin_expr 提取）
pub func bi_str_byte(nm: string, id: i64) -> i64 {
if nm == "str_byte" {
    // str_byte(s, i)：取第 i 字节（0 ≤ i < len(s)；越界未定义——调用方保证）
    var v = tig_expr(call_arg(id, 0))
    if v < 0 {
        return -1
    }
    var i = tig_expr(call_arg(id, 1))
    if i < 0 {
        return -1
    }
    g_builtin_res = s21_str_byte(v, i)
    return 0
}
}

