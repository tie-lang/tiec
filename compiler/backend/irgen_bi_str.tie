if nm == "utf8_seq_len" {
    // utf8_seq_len(s, i)：字节 i 起的 UTF-8 序列长度（1-4，按首字节判定）
    var v = tig_expr(call_arg(id, 0))
    if v < 0 {
        return -1
    }
    var i = tig_expr(call_arg(id, 1))
    if i < 0 {
        return -1
    }
    g_builtin_res = s21_utf8_seq_len(v, i)
    return 0
}
}

