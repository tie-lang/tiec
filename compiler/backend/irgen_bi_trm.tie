// channel 原语（p.6.5.7：mailbox 承载，静态链接 trm_lite.a）
// 内置 `ch_send`（p.9.21.2 两步制①：自 builtin_expr 提取）
pub func bi_ch_send(nm: string, id: i64) -> i64 {
if nm == "ch_send" {
    g_used_trmlite = true
