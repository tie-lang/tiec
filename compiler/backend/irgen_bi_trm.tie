// p.6.7.12 ch_select：多路收发（平行数组承载）
// 内置 `ch_select`（p.9.21.2 两步制①：自 builtin_expr 提取）
pub func bi_ch_select(nm: string, id: i64) -> i64 {
if nm == "ch_select" {
    g_used_trmlite = true
    if sstate.fn_def_node("trm_lite_chan::ch_select") >= 0 ||
        sstate.fn_def_node("tl_runtime_ctx::ctx_ch_select") >= 0 {
        sm_err_msg = "ch_select 内置与 import trm-lite 冲突：内置与 import 是替代运行时路径，不能混用（函数 " + g_cur_fn_name + "）"
        return -1
    }
    var T64cs = types.named(TK_I64)
    var ats_cs: table<i64> = table_new_i64()
    var avs_cs: table<i64> = table_new_i64()
    var k2: i64 = 0
    while k2 < 3 {
        var av = tig_expr(call_arg(id, k2))
        if av < 0 {
            return -1
        }
        table_push(ats_cs, T64cs)
        table_push(avs_cs, t21_ptri(av))   // 表 → 句柄 i64
        k2 = k2 + 1
    }
    g_builtin_res = tig_trmlite_call("trm_lite_chan$ch_select", ats_cs, avs_cs, T64cs)
    return 0
}
}

