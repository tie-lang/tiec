type tie<class>
// compiler/backend/irgen_bi_num.tie —— 内置生成器：显式数值转换 as_* 与 checked_* 溢出检测（S1.3）
// ============================================================
// 自 irgen_expr.tie 的 builtin_expr 拆出（p.9.21.2 两步制①）。
// 范式：同 namespace 跨文件（文本内联）——只含函数与注释，
// 顶层全局 var 与 import 树留在 irgen.tie 主文件。
namespace irgen {
// S1.3 checked_* 溢出检测族
// 内置 `exec_code`（p.9.21.2 两步制①：自 builtin_expr 提取）
pub func bi_exec_code(nm: string, id: i64) -> i64 {
if nm == "exec_code" {
    // runtime.a 退役：内联到 libc system（返回 i64，RAX 零扩展保证同旧 tie_exec_code）
    var cv = tig_expr(call_arg(id, 0))
    if cv < 0 {
        return -1
    }
    g_builtin_res = tig_ext_call1("system", cv, types.named(TK_STR), types.named(TK_I64))
    return 0
}
}

// S1.3 checked_* 溢出检测族
// 内置 `time_now`（p.9.21.2 两步制①：自 builtin_expr 提取）
pub func bi_time_now(nm: string, id: i64) -> i64 {
if nm == "time_now" {
    // runtime.a 退役：内联到 libc time(0)（0 = NULL，返回 Unix 秒数）
    g_builtin_res = tig_ext_call1("time", tig_int_lit(0), types.named(TK_I64), types.named(TK_I64))
    return 0
}
}

// S1.3 checked_* 溢出检测族
// 内置 `get_env`（p.9.21.2 两步制①：自 builtin_expr 提取）
pub func bi_get_env(nm: string, id: i64) -> i64 {
if nm == "get_env" {
    // runtime.a 退役：内联到 libc getenv（返回 char* → 自动补头为 tie 串）
    var gv = tig_expr(call_arg(id, 0))
    if gv < 0 {
        return -1
    }
    g_builtin_res = tig_ext_call1("getenv", gv, types.named(TK_STR), types.named(TK_STR))
    return 0
}
}

// S1.3 checked_* 溢出检测族
// 内置 `exec_output`（p.9.21.2 两步制①：自 builtin_expr 提取）
pub func bi_exec_output(nm: string, id: i64) -> i64 {
if nm == "exec_output" {
    // p.6.4.6：内联 CreatePipe+CreateProcessW+ReadFile 捕获子进程 stdout（零 Rust 桥）。
    // 不再经 tig_runtime_call（g_used_interp 桥）→ 不置位，不链接 tie_interp.lib。
    var ev = tig_expr(call_arg(id, 0))
    if ev < 0 {
        return -1
    }
    g_builtin_res = tig_exec_output_inline(ev)
    return 0
}
}

// S1.3 checked_* 溢出检测族
// 内置 `str_len`（p.9.21.2 两步制①：自 builtin_expr 提取）
pub func bi_str_len(nm: string, id: i64) -> i64 {
if nm == "str_len" {
    // 去 Rust 桥（dev33 批次3 关联）：码点计数改为纯 tie 内联——
    // 复用 s21_utf8_seq_len 步进循环累加（等价 tie_str_len），不再链接
    // tie_interp.lib。返回码点数。
    var v = tig_expr(call_arg(id, 0))
    if v < 0 {
        return -1
    }
    // 计数槽（i64）：初值 0；字节位置槽：初值 0
    var cnt_a = ir.new_inst(g_cur_block, 20, types.named(TK_I64))
    ir.add_operand(cnt_a, types.named(TK_I64), 2)
    var cnt_ptr = ir.get_value(cnt_a)
    var pos_a = ir.new_inst(g_cur_block, 20, types.named(TK_I64))
    ir.add_operand(pos_a, types.named(TK_I64), 2)
    var pos_ptr = ir.get_value(pos_a)
    var zlit = tig_int_lit_ty(0, types.named(TK_I64))
    var st0 = ir.new_inst(g_cur_block, 22, -1)
    ir.add_operand(st0, types.named(TK_I64), 2)
    ir.add_operand(st0, zlit, 0)
    ir.add_operand(st0, cnt_ptr, 0)
    var st0b = ir.new_inst(g_cur_block, 22, -1)
    ir.add_operand(st0b, types.named(TK_I64), 2)
    ir.add_operand(st0b, zlit, 0)
    ir.add_operand(st0b, pos_ptr, 0)
    // 四块：cond / body / step / exit
    var cond_blk = ir.new_block(g_cur_func, interner.intern("sl.cond"))
    var body_blk = ir.new_block(g_cur_func, interner.intern("sl.body"))
    var step_blk = ir.new_block(g_cur_func, interner.intern("sl.step"))
    var exit_blk = ir.new_block(g_cur_func, interner.intern("sl.exit"))
    var b0 = ir.new_inst(g_cur_block, 30, -1)
    ir.add_operand(b0, cond_blk, 1)
    // cond：pos < byte_len(s) → body，否则 exit
    g_cur_block = cond_blk
    var cur = ir.new_inst(g_cur_block, 21, types.named(TK_I64))
    ir.add_operand(cur, pos_ptr, 0)
    var cur_v = ir.get_value(cur)
    var blen = s21_str_head_len(v)
    var ol = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))
    ir.add_operand(ol, cur_v, 0)
    ir.add_operand(ol, blen, 0)
    ir.add_operand(ol, 6, 2)  // ult
    var ol_v = ir.get_value(ol)
    var cb = ir.new_inst(g_cur_block, 31, -1)
    ir.add_operand(cb, ol_v, 0)
    ir.add_operand(cb, body_blk, 1)
    ir.add_operand(cb, exit_blk, 1)
    // body：cnt = cnt + 1；pos += utf8_seq_len(s, pos)
    g_cur_block = body_blk
    var curc = ir.new_inst(g_cur_block, 21, types.named(TK_I64))
    ir.add_operand(curc, cnt_ptr, 0)
    var curc_v = ir.get_value(curc)
    var inc = s21_bin(0, curc_v, tig_int_lit(1))
    var stc = ir.new_inst(g_cur_block, 22, -1)
    ir.add_operand(stc, types.named(TK_I64), 2)
    ir.add_operand(stc, inc, 0)
    ir.add_operand(stc, cnt_ptr, 0)
    var cur2 = ir.new_inst(g_cur_block, 21, types.named(TK_I64))
    ir.add_operand(cur2, pos_ptr, 0)
    var cur2_v = ir.get_value(cur2)
    var sl = s21_utf8_seq_len(v, cur2_v)
    var np = s21_bin(0, cur2_v, sl)
    var stp = ir.new_inst(g_cur_block, 22, -1)
    ir.add_operand(stp, types.named(TK_I64), 2)
    ir.add_operand(stp, np, 0)
    ir.add_operand(stp, pos_ptr, 0)
    var bbr = ir.new_inst(g_cur_block, 30, -1)
    ir.add_operand(bbr, step_blk, 1)
    // step → cond（空 step，跳回 cond 即可；此处直接 br cond）
    g_cur_block = step_blk
    var sb2 = ir.new_inst(g_cur_block, 30, -1)
    ir.add_operand(sb2, cond_blk, 1)
    // exit：结果 = cnt
    g_cur_block = exit_blk
    var ld = ir.new_inst(g_cur_block, 21, types.named(TK_I64))
    ir.add_operand(ld, cnt_ptr, 0)
    g_builtin_res = ir.get_value(ld)
    return 0
}
}

// S1.3 checked_* 溢出检测族
// 内置 `char_code`（p.9.21.2 两步制①：自 builtin_expr 提取）
pub func bi_char_code(nm: string, id: i64) -> i64 {
if nm == "char_code" {
    // 去 Rust 桥（dev33 批次3 关联）：单字符 → 码点，用已内联的
    // s21_utf8_char_at(字符, 0)（等价 tie_char_code，纯 tie 生成，不再
    // 链接 tie_interp.lib）。语义：UTF-8 解码单字符首码点 = 该码点。
    var cc_arg = call_arg(id, 0)
    var v = tig_expr(cc_arg)
    if v < 0 {
        return -1
    }
    // r.1 复查修复：char_code(<char> 值) —— char 是 i32 标量码点，
    // 直接 zext i32→i64 返回；仅 string（ptr）走 UTF-8 首码点解码。
    // 此前把 char 值当 ptr 交给 s21_utf8_char_at → opt "i32 used as ptr"。
    if node_types[cc_arg] == types.named(TK_CHAR) {
        g_builtin_res = s21_zext(v, types.named(TK_CHAR))
        return 0
    }
    var zlit = tig_int_lit_ty(0, types.named(TK_I64))
    g_builtin_res = s21_utf8_char_at(v, zlit)
    return 0
}
}

// S1.3 checked_* 溢出检测族
// 内置 `str_char`（p.9.21.2 两步制①：自 builtin_expr 提取）
pub func bi_str_char(nm: string, id: i64) -> i64 {
if nm == "str_char" {
    // 去 Rust 桥：取第 i 个码点字符，irgen 内联生成——字节位置循环跳过
    // i 个码点（s21_utf8_seq_len 步进）→ s21_utf8_char_at 解码码点 →
    // s21_codepoint_to_str 得单字符。不链接 tie_interp.lib。
    // p6.x 缺陷根治：字节定位循环原仅以 k < i 终止，无 pos 边界检查——
    // 调用方以 len(s)（字节数，O(1) 读头）为上界遍历含多字节 UTF-8
    // （中文等码点 < 字节）的串时，i 会超过实际码点数，pos 越过串尾
    // 继续读（s21_utf8_seq_len/s21_str_byte 越界 GEP+load → 0xC0000005，
    // jcc-pack extract 崩溃根因）。修复：cond 增补 pos < blen 终止，
    // 定位失败（pos >= blen）返回空串而非越界读。
    var v = tig_expr(call_arg(id, 0))
    if v < 0 {
        return -1
    }
    var i = tig_expr(call_arg(id, 1))
    if i < 0 {
        return -1
    }
    var blen = s21_str_head_len(v)
    // 位置槽（字节 pos）与步进计数器槽（已跳码点数）
    var pos_a = ir.new_inst(g_cur_block, 20, types.named(TK_I64))
    ir.add_operand(pos_a, types.named(TK_I64), 2)
    var pos_ptr = ir.get_value(pos_a)
    var k_a = ir.new_inst(g_cur_block, 20, types.named(TK_I64))
    ir.add_operand(k_a, types.named(TK_I64), 2)
    var k_ptr = ir.get_value(k_a)
    var zlit = tig_int_lit_ty(0, types.named(TK_I64))
    var stp = ir.new_inst(g_cur_block, 22, -1)
    ir.add_operand(stp, types.named(TK_I64), 2)
    ir.add_operand(stp, zlit, 0)
    ir.add_operand(stp, pos_ptr, 0)
    var stk = ir.new_inst(g_cur_block, 22, -1)
    ir.add_operand(stk, types.named(TK_I64), 2)
    ir.add_operand(stk, zlit, 0)
    ir.add_operand(stk, k_ptr, 0)
    // 五块：cond / body / exit 判定（after）/ ok / bad / merge
    // cond：k < i 且 pos < blen → body；否则 → after
    // after：pos < blen（定位到第 i 个码点）→ ok 解码；否则 → bad 空串
    var cond_blk = ir.new_block(g_cur_func, interner.intern("sc.cond"))
    var body_blk = ir.new_block(g_cur_func, interner.intern("sc.body"))
    var after_blk = ir.new_block(g_cur_func, interner.intern("sc.after"))
    var ok_blk = ir.new_block(g_cur_func, interner.intern("sc.ok"))
    var bad_blk = ir.new_block(g_cur_func, interner.intern("sc.bad"))
    var merge_blk = ir.new_block(g_cur_func, interner.intern("sc.merge"))
    var res_a = ir.new_inst(g_cur_block, 20, types.named(TK_STR))
    ir.add_operand(res_a, types.named(TK_STR), 2)
    var res_ptr = ir.get_value(res_a)
    var b0 = ir.new_inst(g_cur_block, 30, -1)
    ir.add_operand(b0, cond_blk, 1)
    // cond：k < i 且 pos < blen → body，否则 after
    g_cur_block = cond_blk
    var ku = ir.new_inst(g_cur_block, 21, types.named(TK_I64))
    ir.add_operand(ku, k_ptr, 0)
    var ku_v = ir.get_value(ku)
    var ok = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))  // icmp
    ir.add_operand(ok, ku_v, 0)
    ir.add_operand(ok, i, 0)
    ir.add_operand(ok, 2, 2)  // slt
    var ok_v = ir.get_value(ok)
    var pu = ir.new_inst(g_cur_block, 21, types.named(TK_I64))
    ir.add_operand(pu, pos_ptr, 0)
    var pu_v = ir.get_value(pu)
    var inb = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))  // icmp
    ir.add_operand(inb, pu_v, 0)
    ir.add_operand(inb, blen, 0)
    ir.add_operand(inb, 6, 2)  // ult
    var inb_v = ir.get_value(inb)
    var both = tig_and_i1(ok_v, inb_v)
    var cb = ir.new_inst(g_cur_block, 31, -1)
    ir.add_operand(cb, both, 0)
    ir.add_operand(cb, body_blk, 1)
    ir.add_operand(cb, after_blk, 1)
    // body：pos += utf8_seq_len(s, pos)；k += 1
    g_cur_block = body_blk
    var pu2 = ir.new_inst(g_cur_block, 21, types.named(TK_I64))
    ir.add_operand(pu2, pos_ptr, 0)
    var pu2_v = ir.get_value(pu2)
    var sl = s21_utf8_seq_len(v, pu2_v)
    var np = s21_bin(0, pu2_v, sl)  // add
    var stp2 = ir.new_inst(g_cur_block, 22, -1)
    ir.add_operand(stp2, types.named(TK_I64), 2)
    ir.add_operand(stp2, np, 0)
    ir.add_operand(stp2, pos_ptr, 0)
    var ku2 = ir.new_inst(g_cur_block, 21, types.named(TK_I64))
    ir.add_operand(ku2, k_ptr, 0)
    var ku2_v = ir.get_value(ku2)
    var nk = s21_bin(0, ku2_v, tig_int_lit(1))
    var stk2 = ir.new_inst(g_cur_block, 22, -1)
    ir.add_operand(stk2, types.named(TK_I64), 2)
    ir.add_operand(stk2, nk, 0)
    ir.add_operand(stk2, k_ptr, 0)
    var bbr = ir.new_inst(g_cur_block, 30, -1)
    ir.add_operand(bbr, cond_blk, 1)
    // after：pos < blen → ok（定位成功，解码），否则 bad（空串）
    g_cur_block = after_blk
    var pu3 = ir.new_inst(g_cur_block, 21, types.named(TK_I64))
    ir.add_operand(pu3, pos_ptr, 0)
    var pu3_v = ir.get_value(pu3)
    var inb2 = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))  // icmp
    ir.add_operand(inb2, pu3_v, 0)
    ir.add_operand(inb2, blen, 0)
    ir.add_operand(inb2, 6, 2)  // ult
    var inb2_v = ir.get_value(inb2)
    var cb2 = ir.new_inst(g_cur_block, 31, -1)
    ir.add_operand(cb2, inb2_v, 0)
    ir.add_operand(cb2, ok_blk, 1)
    ir.add_operand(cb2, bad_blk, 1)
    // bad：定位失败（pos 越过串尾仍未到第 i 个码点）→ 空串
    g_cur_block = bad_blk
    var empty = tig_str_lit(interner.intern("\"\""))
    var stb = ir.new_inst(g_cur_block, 22, -1)
    ir.add_operand(stb, types.named(TK_STR), 2)
    ir.add_operand(stb, empty, 0)
    ir.add_operand(stb, res_ptr, 0)
    var brb = ir.new_inst(g_cur_block, 30, -1)
    ir.add_operand(brb, merge_blk, 1)
    // ok：解码 pos 处码点 → 单字符字符串
    g_cur_block = ok_blk
    var pz = ir.new_inst(g_cur_block, 21, types.named(TK_I64))
    ir.add_operand(pz, pos_ptr, 0)
    var pz_v = ir.get_value(pz)
    var cp = s21_utf8_char_at(v, pz_v)
    var cps = s21_codepoint_to_str(cp)
    var sto = ir.new_inst(g_cur_block, 22, -1)
    ir.add_operand(sto, types.named(TK_STR), 2)
    ir.add_operand(sto, cps, 0)
    ir.add_operand(sto, res_ptr, 0)
    var bro = ir.new_inst(g_cur_block, 30, -1)
    ir.add_operand(bro, merge_blk, 1)
    // merge：结果 = res 槽
    g_cur_block = merge_blk
    g_builtin_res = s21_load(res_ptr, types.named(TK_STR))
    return 0
}
}

// S1.3 checked_* 溢出检测族
// 内置 `str_from_code`（p.9.21.2 两步制①：自 builtin_expr 提取）
pub func bi_str_from_code(nm: string, id: i64) -> i64 {
if nm == "str_from_code" {
    // 去 Rust 桥：码点 → 单字符 UTF-8 字符串，改 irgen 内联生成
    // s21_codepoint_to_str（纯 tie 内联，不链接 tie_interp.lib）。
    var v = tig_expr(call_arg(id, 0))
    if v < 0 {
        return -1
    }
    // 窄整数（trit/char/i8/i16/i32 等）先 sext 到 i64（s21 编码期望 i64）
    var vt = node_types[call_arg(id, 0)]
    var sv = v
    if vt >= 0 && vt != types.named(TK_I64) && vt != types.named(TK_U64) {
        var se = tig_sext(v, vt, types.named(TK_I64))
        if se < 0 {
            return -1
        }
        sv = se
    }
    g_builtin_res = s21_codepoint_to_str(sv)
    return 0
}
}

}