type tie<class>
// compiler/backend/llvmgen_sc.tie —— p.9.17.1 str_char 码点索引缓存 段发射
// ============================================================
// 范式：同 namespace 跨文件（文本内联）——只含函数与注释。
// 从 llvmgen_p1.tie 拆出（单文件 ≤800 行纪律）。
namespace llvmgen {
// p.9.17.1：str_char 码点索引缓存段（仅 g_sc_enabled 时输出）。
//   @tie_sc_addr [2 x ptr]           每槽缓存串基址（null = 空）
//   @tie_sc_len  [2 x i64]           每槽缓存字节长
//   @tie_sc_n    [2 x i64]           每槽已映射码点数（= 表项数）
//   @tie_sc_tab  [2 x [131072 x i64]]  每槽码点序号 → 字节偏移表（各 1MB .bss）
// @tie_sc_off(s, i) -> i64：命中查表返回字节偏移；未命中重建（写满槽后存
// addr/len/n——**n 存循环 phi 的 k = 已写项数**，此即旧实现 phi 差一根因的
// 修正）；i >= 131072 或 i < 0 走 legacy 线性步进（i<0 时 pos=0 → 返回 0，
// 与旧实现「负索引取首码点」语义逐位一致）；i 超出码点数返回 -1（irgen 侧
// 据此产空串）。双槽按 (addr>>3)&1 选槽（字符串指针 8 对齐，bit3 随分配
// 翻转，零 LRU 成本覆盖交替串对）。
// @tie_sc_inval(b)：free 路径失效钩子——块基址等于某槽缓存地址则清该槽
//（malloc 同址同长复用是 (ptr,len) 键唯一的陈旧命中来源，根治性防御）。
func emit_sc_globals() {
    if g_sc_enabled != 1 {
        return
    }
    line("@tie_sc_addr = private global [2 x ptr] zeroinitializer")
    line("@tie_sc_len = private global [2 x i64] zeroinitializer")
    line("@tie_sc_n = private global [2 x i64] zeroinitializer")
    line("@tie_sc_tab = private global [2 x [131072 x i64]] zeroinitializer")
    line("define private i64 @tie_sc_off(ptr %s, i64 %i) {")
    line("entry:")
    line("  %hgep = getelementptr inbounds i8, ptr %s, i64 -8")
    line("  %blen = load i64, ptr %hgep")
    line("  %lip = ptrtoint ptr %s to i64")
    line("  %sh = lshr i64 %lip, 3")
    line("  %sl = and i64 %sh, 1")
    line("  %agep = getelementptr inbounds [2 x ptr], ptr @tie_sc_addr, i64 0, i64 %sl")
    line("  %caddr = load ptr, ptr %agep")
    line("  %eqa = icmp eq ptr %caddr, %s")
    line("  %lgep = getelementptr inbounds [2 x i64], ptr @tie_sc_len, i64 0, i64 %sl")
    line("  %clen = load i64, ptr %lgep")
    line("  %eql = icmp eq i64 %clen, %blen")
    line("  %ngep = getelementptr inbounds [2 x i64], ptr @tie_sc_n, i64 0, i64 %sl")
    line("  %cn = load i64, ptr %ngep")
    line("  %inr = icmp ult i64 %i, %cn")
    line("  %h1 = and i1 %eqa, %eql")
    line("  %hit = and i1 %h1, %inr")
    line("  br i1 %hit, label %dec, label %miss")
    line("miss:")
    line("  %cap = icmp ult i64 %i, 131072")
    line("  br i1 %cap, label %rb, label %legacy")
    line("rb:")
    line("  br label %rbc")
    line("rbc:")
    line("  %pos = phi i64 [ 0, %rb ], [ %npos, %rbb ]")
    line("  %k = phi i64 [ 0, %rb ], [ %nk, %rbb ]")
    line("  %more = icmp ult i64 %pos, %blen")
    line("  %kin = icmp ult i64 %k, 131072")
    line("  %go = and i1 %more, %kin")
    line("  br i1 %go, label %rbb, label %rbd")
    line("rbb:")
    line("  %tgep = getelementptr inbounds [2 x [131072 x i64]], ptr @tie_sc_tab, i64 0, i64 %sl, i64 %k")
    line("  store i64 %pos, ptr %tgep")
    line("  %dq = getelementptr inbounds i8, ptr %s, i64 %pos")
    line("  %b0 = load i8, ptr %dq")
    line("  %b0x = zext i8 %b0 to i32")
    line("  %c1 = icmp ult i32 %b0x, 128")
    line("  %c2 = icmp ult i32 %b0x, 224")
    line("  %c3 = icmp ult i32 %b0x, 240")
    line("  %l12 = select i1 %c1, i64 1, i64 2")
    line("  %l23 = select i1 %c2, i64 %l12, i64 3")
    line("  %slen = select i1 %c3, i64 %l23, i64 4")
    line("  %npos = add i64 %pos, %slen")
    line("  %nk = add i64 %k, 1")
    line("  br label %rbc")
    line("rbd:")
    line("  store ptr %s, ptr %agep")
    line("  store i64 %blen, ptr %lgep")
    line("  store i64 %k, ptr %ngep")
    line("  %in2 = icmp ult i64 %i, %k")
    line("  br i1 %in2, label %dec, label %oob")
    line("dec:")
    line("  %tgep2 = getelementptr inbounds [2 x [131072 x i64]], ptr @tie_sc_tab, i64 0, i64 %sl, i64 %i")
    line("  %off = load i64, ptr %tgep2")
    line("  ret i64 %off")
    line("oob:")
    line("  ret i64 -1")
    line("legacy:")
    line("  br label %lgc")
    line("lgc:")
    line("  %lpos = phi i64 [ 0, %legacy ], [ %lnpos, %lgb ]")
    line("  %lk = phi i64 [ 0, %legacy ], [ %lnk, %lgb ]")
    line("  %lc1 = icmp slt i64 %lk, %i")
    line("  %lc2 = icmp ult i64 %lpos, %blen")
    line("  %lgo = and i1 %lc1, %lc2")
    line("  br i1 %lgo, label %lgb, label %lgd")
    line("lgb:")
    line("  %ldq = getelementptr inbounds i8, ptr %s, i64 %lpos")
    line("  %lb0 = load i8, ptr %ldq")
    line("  %lb0x = zext i8 %lb0 to i32")
    line("  %lb1 = icmp ult i32 %lb0x, 128")
    line("  %lb2 = icmp ult i32 %lb0x, 224")
    line("  %lb3 = icmp ult i32 %lb0x, 240")
    line("  %lm12 = select i1 %lb1, i64 1, i64 2")
    line("  %lm23 = select i1 %lb2, i64 %lm12, i64 3")
    line("  %lslen = select i1 %lb3, i64 %lm23, i64 4")
    line("  %lnpos = add i64 %lpos, %lslen")
    line("  %lnk = add i64 %lk, 1")
    line("  br label %lgc")
    line("lgd:")
    line("  %lok = icmp ult i64 %lpos, %blen")
    line("  %lres = select i1 %lok, i64 %lpos, i64 -1")
    line("  ret i64 %lres")
    line("}")
    line("define private void @tie_sc_inval(ptr %b) {")
    line("entry:")
    line("  %a0 = load ptr, ptr @tie_sc_addr")
    line("  %m0 = icmp eq ptr %a0, %b")
    line("  br i1 %m0, label %z0, label %c1")
    line("z0:")
    line("  store ptr null, ptr @tie_sc_addr")
    line("  br label %c1")
    line("c1:")
    line("  %agep = getelementptr inbounds [2 x ptr], ptr @tie_sc_addr, i64 0, i64 1")
    line("  %a1 = load ptr, ptr %agep")
    line("  %m1 = icmp eq ptr %a1, %b")
    line("  br i1 %m1, label %z1, label %d")
    line("z1:")
    line("  store ptr null, ptr %agep")
    line("  br label %d")
    line("d:")
    line("  ret void")
    line("}")
    line("")
}

}   // namespace llvmgen
