type tie<class>
// compiler/backend/irgen_stmt_gen_p1.tie —— 分片 1（p.9.21.3 单文件 ≤800 行）
// ============================================================
// 由 split_parts.py 按行数贪心分片：只搬函数与紧邻注释，
// 顶层全局 var 与 import 树仍留在 irgen_stmt_gen.tie。
namespace irgen {
pub func tig_stmt_b_100_VarDecl(id: i64) -> i64 {
    var tag = s_tags[id]
        // VarDecl：children=[ty 或 -1, init]
        var nm = s_names[id]
        var ty_node = sstate.child(id, 0)
        var init = sstate.child(id, 1)
        var ty: i64 = types.named(3)  // 默认 i64
        if ty_node >= 0 {
            ty = sgen.parse_generic_type_node(ty_node)
            if ty < 0 {
                return -1
            }
            // 宽类型归约：num/text/misc 是宽类型框（对齐 Rust 语义层展开），
            // llvm_ty 无映射（兜底 ptr）——按 init 的实际推断类型定槽型：
            //   num + 整数 → i64；num + 浮点 → f64；text + 字符串 → ptr；
            //   misc + bool → i1
            if init >= 0 && (ty == types.named(TK_NUM) || ty == types.named(TK_TEXT) ||
                ty == types.named(TK_MISC)) {
                var wt = node_types[init]
                if wt >= 0 {
                    ty = wt
                }
            }
        } else if init >= 0 {
            // 无类型标注：按初始化表达式的推断类型定槽型。
            // 表/映射/字符串 → TK_STR（ptr 槽：表指针 / 字符串指针统一 ptr，
            // 与 llvmgen store 的 to_ptr 转换配套）；bool → TK_BOOL（i1 槽，
            // icmp 结果是 i1——曾默认 i64 槽导致 store i64 %i1 类型错）；
            // 元组/struct → 聚合类型 id（alloca {..} 聚合槽）；
            // 其余默认 i64。
            var it = node_types[init]
            if it >= 0 && (types.is_table(it) || types.is_map(it) || it == types.named(TK_STR)) {
                ty = types.named(TK_STR)
            } else if it == types.named(TK_TRIT) {
                // trit：i8 槽（compare() 返回 trit 变量——曾落入 is_bool_like
                // 判为 i1 槽，store i8 %i1 类型错）
                ty = types.named(TK_TRIT)
            } else if it == types.named(TK_ANY) {
                // P2c：any 推断 → {i64,i64} 聚合槽（异构值存储；init 已是 any
                // 或下方统一装箱）
                ty = it
            } else if it >= 0 && types.is_bool_like(it) {
                ty = types.named(TK_BOOL)
            } else if it >= 0 && types.is_float(it) {
                // 浮点推断（f64/f32）：mean(...) 返回 f64 → alloca double 槽
                //（曾落默认 i64 → store i64 %double 类型错）
                ty = it
            } else if it >= 0 && types.is_int(it) {
                // S1.3 窄整数推断（后缀字面量 `var a = 42i32`）：窄槽
                //（语义类型 i32 与槽型须一致，否则 load i64 被按 i32 sext 类型错）
                ty = it
            } else if it >= 0 && types.is_unsafe_ty(it) {
                // S1.2：指针/切片/原子类型推断（`var p = addr_of(x)`）→
                // 对应槽（alloca ptr / alloca {ptr,i64} / alloca 元素型）
                ty = it
            } else if it >= 0 && types.kind(it) == K_ACTOR {
                // 一期并发：actor 句柄变量推断 → 保留句柄类型（LLVM=i64 槽，
                // 但须保留 K_ACTOR 供方法转发 scope 查类型）
                ty = it
            } else if it >= 0 && types.kind(it) == K_GUARD {
                // 三期 A 组：guard<cap> 凭据变量推断 → i64 槽（凭据运行期占位）
                ty = it
            } else if it >= 0 && (types.kind(it) == K_TUPLE || types.kind(it) == K_STRUCT || types.kind(it) == K_ENUM || types.kind(it) == K_FN || types.kind(it) == K_PORT || types.kind(it) == K_ARRAY) {
                // 聚合变量：alloca 聚合槽，init（构造调用/元组字面量/返回）求聚合值
                // （K_ENUM 2026-08-15：枚举变量同 struct——alloca %enum.X 槽，
                // init 的 FieldAccess/MethodCall 构造求聚合值，store 类型匹配；
                // K_FN S2.2：闭包字面量/函数值参数 → alloca %fn.X 槽；
                // K_PORT S2.4：port 对象（ptr 表示）→ alloca ptr 槽；
                // K_ARRAY L1：定长数组 → alloca [N x T] 槽）
                ty = it
            }
        }
        // alloca + store
        // p.9.12.6 行池变量：声明类型是 table<struct>（struct 元素）→ 列式行池
        //（多列聚合表示），不入通用表变量路径（单句柄 + retain/release 假设）。
        // row pool 仅存在符号存储位，无面向值传递；读写/len 由 rp_* 分支处理。
        if types.is_table(ty) {
            var te_rp = types.table_elem(ty)
            if te_rp > 0 && types.kind(te_rp) == K_STRUCT {
                return rp_decl(nm, ty)
            }
        }
        var alloca = ir.new_inst(g_cur_block, 20, ty)  // alloca
        ir.add_operand(alloca, ty, 2)  // 类型立即数（占位）
        var av = ir.get_value(alloca)
        if init >= 0 {
            // S2.4：port 对象变量初始化——提升（struct → port 打包）或
            // port 拷贝（ptr 复制）。见 tig_port_coerce 注释。
            if types.kind(ty) == K_PORT {
                var it4 = node_types[init]
                var pv: i64 = -1
                if it4 >= 0 && types.kind(it4) == K_STRUCT {
                    pv = tig_port_coerce(init, ty)
                } else {
                    pv = tig_expr(init)
                }
                if pv < 0 {
                    return -1
                }
                var store = ir.new_inst(g_cur_block, 22, -1)  // store
                ir.add_operand(store, ty, 2)
                ir.add_operand(store, pv, 0)
                ir.add_operand(store, av, 0)
                scope_put(nm, av, ty)
                return 0
            }
            // DEBUG 临时
            // IntLit 初始化：按声明类型生成常量（i32 变量存 i32 值，否则
            // llvmgen 的 store i32 %N 会因 %N 是 i64 const_i 而类型不匹配）；
            // 其余表达式走 tig_expr（结果恒 i64，与 llvmgen store 的 vty 匹配
            // 需初始化类型为 i64——非 i64 初始化目前仅支持整数常量）。
            var iv: i64 = -1
            if s_tags[init] == 4 && ty == types.named(TK_TRIT) {
                // BoolLit 适配 trit（语义层 node_types 仍标 TK_BOOL，但标注类型
                // trit 需生成 i8 值：true→1 / false→-1——否则 store i8 %i1 类型错）
                var tv: i64 = -1
                if s_vals[init] == 1 {
                    tv = 1
                }
                iv = tig_trit_lit(tv)
            } else if s_tags[init] == 1 && ty == types.named(TK_F32) {
                // FloatLit 适配 f32 声明：按 f32 生成常量（S1.3，默认 f64）
                iv = tig_float_lit_ty(s_names[init], types.named(TK_F32))
            } else if s_tags[init] == 0 {
                // P2b：any 声明的整数字面量先按 i64 生成，装箱在后续统一处理
                var lit_ty = ty
                if lit_ty == types.named(TK_ANY) {
                    lit_ty = types.named(TK_I64)
                }
                iv = tig_int_lit_ty(s_vals[init], lit_ty)
            } else if s_tags[init] == 14 && types.kind(ty) == K_TUPLE {
                // 元组字面量 + 元组类型标注：按目标类型构造（(i32,i64) 标注 +
                // (7,8) 字面量——语义层推断字面量为 (i64,i64)，不按目标类型
                // 构造会 store {i64,i64} 到 {i32,i64} 槽，LLVM 类型不匹配）
                iv = tig_tuple_lit_typed(init, ty)
            } else if s_tags[init] == 12 && types.is_array(ty) {
                // L1 定长数组：`var b: array<f32, 3> = [1.0, 2.0, 3.0]`——
                // 按目标数组类型构造 [N x T] 聚合值（语义层已校验元素个数/类型）
                iv = tig_array_lit_typed(init, ty)
            } else if s_tags[init] == 7 && types.is_array(ty) && sstate.name_str(init) == "array_init" {
                // L1 定长数组：`var z: array<f32, 64> = array_init(0.0)`——
                // 广播填充 [N x T]（编译期展开 N 次 store）
                iv = tig_array_init_typed(init, ty)
            } else {
                iv = tig_expr(init)
                // S1.3 C2：表达式类型 ≠ 声明类型（数字族）→ 转换。
                // IntLit/FloatLit 已按类型生成（tig_int_lit_ty / 浮点常量），
                // 变量/运算结果按语义层拓宽规则转换（i16 变量 → i64 声明）。
                if iv >= 0 {
                    var it3 = node_types[init]
                    if it3 >= 0 && (types.is_int(it3) || types.is_float(it3)) &&
                        (types.is_int(ty) || types.is_float(ty)) && it3 != ty {
                        var cv2 = tig_coerce(iv, it3, ty)
                        if cv2 < 0 {
                            return -1
                        }
                        iv = cv2
                    }
                }
            }
            if iv < 0 {
                return -1
            }
            // p.6.10.3：VarDecl 表引用接管——init 是表表达式（非 table_new_* 构造、
            // 非函数调用返回——后者已在 callee 的 return 处 retain）→ retain（槽接收
            // 引用，出口析构与之守恒）。**必须先于 any 装箱**：装箱后 iv 是 {i64,i64}
            // 聚合值，ptrtoint 会类型错（r.1.4.2 根因：`var x: any = <table>` 把盒值
            // 当表句柄 retain）。
            // r.1.1.4：表字面量（tag 12）同调用一样是**瞬态值**（新表 rc=1，仅本槽
            // 持有）→ 免 retain（否则 rc=2、出口析构只 -1 → 每处字面量初始化泄漏 1）。
            if init >= 0 {
                var iv4 = node_types[init]
                if iv4 >= 0 && types.is_table(iv4) && s_tags[init] != 7 && s_tags[init] != 12 {
                    // p.6.1.7-RCA-3【2026-09-06】：元组**解构**字段读（var (a,b)=f() 由
                    // 解析器降级为 `var a = _tmp.Item1`，tag 15）——元素表所有权已随被调
                    // 函数返回转移给调用方，此处再 retain(+1) 会与 loopvar 的 -1 不对等，
                    // 剩 base 孤儿每欧几里得步泄漏（invmod 的 qx/rem/mag）。跳过：解构
                    // 槽直接持有那单份引用；结构体字段（K_STRUCT）仍 retain。
                    var skip_ret: bool = false
                    if s_tags[init] == 15 {
                        var bnode = sstate.child(init, 0)
                        if bnode >= 0 && node_types[bnode] >= 0 && types.kind(node_types[bnode]) == K_TUPLE {
                            skip_ret = true
                        }
                    }
                    if !skip_ret {
                        tig_tbl_retain_call(iv)
                    }
                }
            }
            // P2b any 装箱：声明类型 any 且初始化值是具体类型 → box 为 {tag,payload}
            if ty == types.named(TK_ANY) {
                var it5 = node_types[init]
                if it5 >= 0 && it5 != types.named(TK_ANY) {
                    var bx = tig_box_any(iv, it5)
                    if bx < 0 {
                        return -1
                    }
                    iv = bx
                }
            }
            // p.6.10.3：entry 级析构候选登记——表变量且在 entry 块创建（循环/分支内
            // var 的 alloca 在非 entry 块，出口析构 load 会触发「not dominate」）。
            // p.6.1.7-RCA-2【2026-09-06】：此前仅登记 is_table(ty)，而表变量推断时
            // ty 已被 line 1046 clobber 成 TK_STR → 出口析构从不释放 inferred 表局部
            // → 关键泄漏（bigint/ed25519 的 点阶梯每轮泄漏全部中间表）。补齐：init 的
            // 类型是 table/map 的表局部亦登记（decl retain 或 table_new 槽所有权由
            // 出口析构 release 守恒）。
            // r.1.4.2：槽类型为 any（盒值 {i64,i64}，非表句柄）不登记——出口析构
            // load ptr 会对聚合槽类型错，且盒不由容器/出口释放（与 table<any> 元素
            // 约定一致；盒内表的引用在装箱前 retain 守恒，生命周期随函数出口）。
            var cand_tbl: bool = (types.is_table(ty) || types.is_map(ty)) && ty != types.named(TK_ANY)
            if !cand_tbl && init >= 0 && node_types[init] >= 0 && ty != types.named(TK_ANY) &&
               !types.is_array(ty) &&
               (types.is_table(node_types[init]) || types.is_map(node_types[init])) {
                cand_tbl = true
            }
            // p.6.1.7-RCA-5【2026-09-06】：登记**全部**表/map 局部（含非 entry 块）到出口
            // 析构候选。此前仅登记 entry 级：非 entry 块（if/else 分支、早退后块）创建的
            // 一次性表局部（bigint.invmod 的 m/a/r0/r1/sy0/sy1、divrem 单 limb 的 qb1/rt
            // 等）在函数出口从未 release → 每 divrem/invmod 泄漏 ~2.5KB → ed25519 阶梯
            // 累积 800MB+（e_keygen2 812MB 根因）。现在安全的原因：
            //  1) variant C（36c54f6）llvmgen 已把**全部** op==20 alloca 提升到 entry 并
            //     入口零初始化（ptr→null）→ 出口块 load 该 alloca 满足支配；
            //  2) 未执行分支的槽保持 null，tl_tbl$tbl_release(null) 运行时守卫跳过
            //     （p.6.10.2 既定契约：赋值旧值 release、loopvar 哨兵均依赖空句柄守卫）。
            //  3) 循环体表局部的「上一轮值」由 loopvar_release 哨兵在声明处逐次释放
            //     （RCA-6 恢复了回边 release 旧值语义），出口 release 只碰**最终值**
            //     （槽跨迭代持久）→ 单次释放，无双重释放。
            //  4) 返回/全局外传的 retain 与出口 release 净 0（p.6.10.3 守恒不变）。
            if cand_tbl {
                table_push(g_tblcand_allocas, av)
            }
            // p.6.10.4：循环/分支内表变量自遮蔽——非 entry 块声明的表变量，槽在回边
            // 重执行时被 `store 新表` 覆盖旧值 → 旧表引用丢失泄漏。store 前须 release
            // 槽内当前持有，但**首次**进入该声明时槽未初始化（load 即崩）。用零值全局
            // 哨兵 + select 归零实参区分首次（跳过 release）与回边重写（release 上一轮
            // 表），内存有界且安全。entry 级表变量由 p.6.10.3 出口析构覆盖，不在此列。
            // r.1.4.2：槽类型为 any（盒值）不入回边 release——load ptr 对聚合槽类型
            // 错；盒内表引用在装箱前 retain 守恒（与出口不析构的约定一致）。
            var ivla = node_types[init]
            if g_cur_block != g_entry_block && ivla >= 0 && types.is_table(ivla) && ty != types.named(TK_ANY) && !types.is_array(ty) {
                // p.6.1.7-RCA-6【2026-09-06】：回边重写前 **release 旧值**（原 p.6.10.4
                // 哨兵语义）。p.6.1.8-RCA 的「先 store null 再 loopvar_release」在**非提升
                // alloca**时代正确（循环体 alloca 每迭代重新分配 → 槽是未初始化垃圾，
                // release 会释放垃圾 → 0xC0000005）；variant C（36c54f6）已把全部 alloca
                // 提升到 entry 并入口零初始化 → 槽跨迭代**持久**且首版为 null：
                //   - 首次进入：哨兵 0 → select(0,槽,null)=null → release(null) 跳过；
                //   - 回边重写：哨兵 1 → release 槽内**上一轮真表**（不再泄漏），随后
                //     store 新值。
                // 移除 store-null：否则旧表引用被静默丢弃（refcount 不减）→ 每欧几里得
                // 步泄漏 qx/rem 两表（~750B/步 × 200 步 × invmod → e_keygen2 448MB 残余
                // 主源）。RCA-5 的出口 release 仍守恒最终值（单次释放，无双重释放——
                // 回边由哨兵逐次减，最终值由出口减）。
                tig_loopvar_release(av)
            }
            var store = ir.new_inst(g_cur_block, 22, -1)  // store
            ir.add_operand(store, ty, 2)
            ir.add_operand(store, iv, 0)
            ir.add_operand(store, av, 0)
        } else {
            // p.6.10.2 步2：无 init 的表类型变量 → 槽预置空句柄（null）——赋值插桩的
            // 旧值 release 依赖槽初值确定（避免释放未初始化的垃圾句柄）。
            if types.is_table(ty) {
                var nv0 = tig_null_ptr()
                var st0 = ir.new_inst(g_cur_block, 22, -1)  // store
                ir.add_operand(st0, ty, 2)
                ir.add_operand(st0, nv0, 0)
                ir.add_operand(st0, av, 0)
            }
        }
        scope_put(nm, av, ty)
        // 表变量元素类型登记（table_push/table_at 选桥用）：
        // init 是 table<T>（含 table_new_* 调用）→ 记录元素类型。语义层
        // var_table_elem 已过期（per-function），table_new_f64() 返回裸 table
        // 无法从 node_types 得知元素类型。
        if init >= 0 {
            var tv_te: i64 = -1
            var it2 = node_types[init]
            if types.is_table(it2) && types.table_elem(it2) > 0 {
                tv_te = types.table_elem(it2)
            } else if s_tags[init] == 7 {
                var init_nm = sstate.name_str(init)
                if init_nm == "table_new_f64" {
                    tv_te = types.named(TK_F64)
                } else if init_nm == "table_new_string" {
                    tv_te = types.named(TK_STR)
                } else if init_nm == "table_new_bool" {
                    tv_te = types.named(TK_BOOL)
                } else if init_nm == "table_new_i64" {
                    tv_te = types.named(TK_I64)
                }
            }
            if tv_te >= 0 {
                // 键统一用 interner.intern（s_names[id] 是 parser 的 intern 池，
                // 与 table_push 的 interner.intern(tname) 不同池，id 不可比）
                tblvar_put(interner.intern(sstate.name_str(id)), tv_te)

            }
        }
        return 0
}

pub func tig_stmt_b_102_ExprStmt(id: i64) -> i64 {
    var tag = s_tags[id]
        // ExprStmt。语句级宏（dev33 批次10 任务28）：`$body` 插值块形式 code
        // 值后，子节点可能是块形式 N_CODE_LIT（val=1）/嵌套 StmtList——
        // 按语句序列生成而非表达式。
        var e = sstate.child(id, 0)
        if e >= 0 {
            var et = s_tags[e]
            if et == 136 && s_vals[e] == 1 {
                var inner = sstate.child(e, 0)
                if inner >= 0 {
                    return tig_stmtlist_as_stmt(inner)
                }
            }
            if et == 122 {
                return tig_stmtlist_as_stmt(e)
            }
        }
        return tig_expr(e)
}

pub func tig_stmt_b_130_S1(id: i64) -> i64 {
    var tag = s_tags[id]
        // S1.2 U3 unsafe 块：语义层已校验块内操作合法（unsafe 上下文），
        // irgen 只遍历子 StmtList 生成（无额外安全检查）
        var blk = sstate.child(id, 0)
        if blk < 0 {
            return 0
        }
        var n = sstate.nchild(blk)
        var i: i64 = 0
        while i < n {
            var r = tig_stmt(sstate.child(blk, i))
            if r < 0 {
                return -1
            }
            i = i + 1
        }
        return 0
}

pub func tig_stmt_b_104_Return(id: i64) -> i64 {
    var tag = s_tags[id]
        // Return：children=[expr 或 -1]。ret 类型 = 表达式语义类型（i64/f64/
        // 聚合/字符串 ptr——曾硬编码 i64，元组/浮点返回会类型不匹配）。
        // BoolLit 适配 trit：返回 trit 的函数里 `return false/true` → i8
        var v = sstate.child(id, 0)
        if v >= 0 {
            // p.6.1.7-RCA-2【2026-09-06】：tuple 返回含表元素 → 构造时对表元素 retain
            //（交给调用方），出口析构减回；先判 tuple 再求值（rty 须在 tig_expr 前）。
            var vty = node_types[v]
        // p.9.12.6 边界：行池 table<R> 不能作函数返回值（无运行期值形态）
        if vty >= 0 && types.is_table(vty) {
            var tev = types.table_elem(vty)
            if tev > 0 && types.kind(tev) == K_STRUCT {
                sm_err_msg = "行池 table<R> 不能作函数返回值（p.9.12.6 边界，函数 " + g_cur_fn_name + "）"
                return -1
            }
        }
        var tup_ret: bool = (vty >= 0 && types.kind(vty) == K_TUPLE)
            if tup_ret {
                g_ret_tup_tbl = 1
            }
            var rv: i64 = -1
            if s_tags[v] == 4 && g_cur_ret_ty == types.named(TK_TRIT) {
                var tv: i64 = -1
                if s_vals[v] == 1 {
                    tv = 1
                }
                rv = tig_trit_lit(tv)
            } else {
                rv = tig_expr(v)
            }
            g_ret_tup_tbl = 0   // p.6.1.7-RCA-2：标记仅作用于返回表达式构造
            if rv < 0 {
                return -1
            }
            var rty = node_types[v]
            if rty < 0 {
                rty = types.named(TK_I64)
            }
            // S1.3 C2：返回值类型 ≠ 函数返回类型（数字族）→ 转换
            // （窄返回类型函数：`return i64 表达式` → trunc 到返回宽度）
            if g_cur_ret_ty >= 0 && (types.is_int(rty) || types.is_float(rty)) &&
                (types.is_int(g_cur_ret_ty) || types.is_float(g_cur_ret_ty)) &&
                rty != g_cur_ret_ty {
                var cr = tig_coerce(rv, rty, g_cur_ret_ty)
                if cr < 0 {
                    return -1
                }
                rv = cr
                rty = g_cur_ret_ty
            }
            // P2c：any 返回类型装箱——`func f() -> any { return 42 }` → box 为
            // {tag,payload}（对齐 var 声明装箱；返回值已是 any 则跳过）
            if g_cur_ret_ty == types.named(TK_ANY) && rty != types.named(TK_ANY) {
                var bx2 = tig_box_any(rv, rty)
                if bx2 < 0 {
                    return -1
                }
                rv = bx2
                rty = types.named(TK_ANY)
            }
            // p.6.10.3：返回表值 → retain（返回值接管归调用方；出口析构会减回——net 0，
            // 调用方持有返回表）；随后析构本函数非参数局部表。须在 ret（terminator）之前。
            // p.6.1.7-RCA-7【2026-09-06】：retain 仅当返回值是**槽持/结构体持引用**：
            //  - tag 6 普通变量读：其槽被出口析构 -1 平衡（net 0），或形参（调用方仍持有，
            //    retain +1 转给本层调用方）；
            //  - tag 15 且基为 K_STRUCT：结构体表字段在存储时已 retain（p.6.1.8），结构体
            //    仍持引用 → 返回须 retain 复制一份给调用方；
            //  **表达式返回**（tag 7 调用结果，如 `return trim(r)` / `return table_new_i64()`；
            //  tag 15 且基为 K_TUPLE——解构字段读）→ 表所有权已由被调方 return 转移
            //  （rc=1），此处再 retain(+1) 无出口析构平衡 → 每表返回函数泄漏其返回值 1 引用
            //  （ed25519 阶梯：divrem/mul/sub 各 ~200 次/步的 trim 结果全漏 → invmod
            //  120KB/次 → keygen 阶梯 800MB+ 主源）。
            var ret_needs_retain: bool = false
            if s_tags[v] == 6 {
                ret_needs_retain = true
            }
            if s_tags[v] == 15 {
                var bnode_v = sstate.child(v, 0)
                if bnode_v >= 0 && node_types[bnode_v] >= 0 && types.kind(node_types[bnode_v]) == K_STRUCT {
                    ret_needs_retain = true
                }
            }
            if rty >= 0 && types.is_table(rty) && ret_needs_retain {
                tig_tbl_retain_call(rv)
            }
            // p.9.11.4 defer：return（表达式）前运行函数级全部 defer（`?` 输出
            // 表前，保证 defer body 仍可见作用域变量）
            if len(g_def_flags) > 0 {
                if tig_run_defers_all() < 0 {
                    return -1
                }
            }
            tig_tbl_exit_release()
            var ret = ir.new_inst(g_cur_block, 32, rty)  // ret
            ir.add_operand(ret, rv, 0)
        } else {
            // void 无值 return：main 特判 ret i32 0（CRT 退出码正确性，对齐 Rust 侧
            // tig_stmt 的 void main return 处理——define i32 @main 与 ret void 不匹配）；
            // 其余 void 函数 ret void。
            // p.9.11.4 defer：return（void）前运行函数级全部 defer
            if len(g_def_flags) > 0 {
                if tig_run_defers_all() < 0 {
                    return -1
                }
            }
            tig_tbl_exit_release()   // p.6.10.3：无值返回前同样析构非参数局部表
            if g_gen_tbl >= 0 {
                // p.9.11.15 生成器 `return;`：提前结束 → 返回产出表（scheck 已
                // 拦截带值 return；表所有权随返回转移，出口析构已释放普通局部表）
                var gv = ir.new_inst(g_cur_block, 21, types.named(TK_STR))  // load
                ir.add_operand(gv, g_gen_tbl, 0)
                var gre = ir.new_inst(g_cur_block, 32, g_cur_ret_ty)
                ir.add_operand(gre, ir.get_value(gv), 0)
            } else if g_cur_fn_name == "main" {
                var ret = ir.new_inst(g_cur_block, 32, types.named(TK_I32))  // ret i32 0
                ir.add_operand(ret, 0, 2)
            } else {
                var ret = ir.new_inst(g_cur_block, 32, -1)  // ret void
            }
        }
        return 0
}

pub func tig_stmt_b_161(id: i64) -> i64 {
    var tag = s_tags[id]
        if g_gen_tbl < 0 {
            sm_err_msg = "yield 出现在非生成器上下文（函数 " + g_cur_fn_name + "）"
            return -1
        }
        var yv = tig_expr(sstate.child(id, 0))
        if yv < 0 {
            return -1
        }
        var ytbl = ir.new_inst(g_cur_block, 21, types.named(TK_STR))  // load 表句柄
        ir.add_operand(ytbl, g_gen_tbl, 0)
        s21_table_push(ir.get_value(ytbl), g_gen_elem, yv)
        return 0
}

pub func tig_stmt_b_105_If(id: i64) -> i64 {
    var tag = s_tags[id]
        // If：children=[cond, then, else]
        var cond_nid = sstate.child(id, 0)
        var cond = tig_expr(cond_nid)
        if cond < 0 {
            return -1
        }
        // p.6.5.2：条件归一化 i1（`if x` x:i64 / 整型字面量 → icmp ne 0）
        cond = tig_cond_to_bool(cond, node_types[cond_nid])
        var then_blk = ir.new_block(g_cur_func, interner.intern("if.then"))
        var else_blk = ir.new_block(g_cur_func, interner.intern("if.else"))
        var merge_blk = ir.new_block(g_cur_func, interner.intern("if.merge"))
        // cond_br：条件 + then + else
        var cbr = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cbr, cond, 0)
        ir.add_operand(cbr, then_blk, 1)
        ir.add_operand(cbr, else_blk, 1)
        // then 分支
        g_cur_block = then_blk
        var then_list = sstate.child(id, 1)
        var t = tig_block_stmts(then_list)
        if t < 0 {
            return -1
        }
        if !block_terminated() {
            var br1 = ir.new_inst(g_cur_block, 30, -1)  // br merge
            ir.add_operand(br1, merge_blk, 1)
        }
        // else 分支
        g_cur_block = else_blk
        var else_list = sstate.child(id, 2)
        if else_list >= 0 {
            var e = tig_block_stmts(else_list)
            if e < 0 {
                return -1
            }
        }
        if !block_terminated() {
            var br2 = ir.new_inst(g_cur_block, 30, -1)
            ir.add_operand(br2, merge_blk, 1)
        }
        // merge
        g_cur_block = merge_blk
        return 0
}

pub func tig_stmt_b_153_p(id: i64) -> i64 {
    var tag = s_tags[id]
        // p.8.2.11 guard else 早退：children=[cond, else_list]，等价 if not(cond)
        // { else_list }。条件为真 → 继续（merge）；为假 → 进入 else 块（scheck
        // 已约束块尾为跳转，不会向 merge 落回）。
        var gcond_nid = sstate.child(id, 0)
        var gcond = tig_expr(gcond_nid)
        if gcond < 0 {
            return -1
        }
        gcond = tig_cond_to_bool(gcond, node_types[gcond_nid])
        var body_blk = ir.new_block(g_cur_func, interner.intern("guard.body"))
        var merge_blk = ir.new_block(g_cur_func, interner.intern("guard.merge"))
        var cbr = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cbr, gcond, 0)
        ir.add_operand(cbr, merge_blk, 1)   // 条件真 → 继续
        ir.add_operand(cbr, body_blk, 1)    // 条件假 → guard else 块
        g_cur_block = body_blk
        var gbody_list = sstate.child(id, 1)
        var ge = tig_block_stmts(gbody_list)
        if ge < 0 {
            return -1
        }
        g_cur_block = merge_blk
        return 0
}

pub func tig_stmt_b_158_p(id: i64) -> i64 {
    var tag = s_tags[id]
        // p.9.11.4 defer 资源释放：注册（非立即执行）。分配运行时标志 alloca 并
        // 立即置 true（= 已武装，仅当本 defer 语句所在路径执行时才为 true；被
        // 条件跳过/零迭代循环跳过的路径其标志未写入——边界裁决见报告），按
        // 作用域 g_def_sc 登记，供各退出出口在作用域退出时 LIFO 发射执行。
        var dbody = sstate.child(id, 0)
        var flag_a = ir.new_inst(g_cur_block, 20, types.named(TK_BOOL))  // alloca i1
        ir.add_operand(flag_a, types.named(TK_BOOL), 2)
        var flag_ptr = ir.get_value(flag_a)
        var fz = tig_bool_lit(1)  // true = 武装
        var fs = ir.new_inst(g_cur_block, 22, -1)  // store true → flag
        ir.add_operand(fs, types.named(TK_BOOL), 2)
        ir.add_operand(fs, fz, 0)
        ir.add_operand(fs, flag_ptr, 0)
        table_push(g_def_bodies, dbody)
        table_push(g_def_flags, flag_ptr)
        table_push(g_def_scopes, g_lp_top)   // 作用域 0=函数体；>0=循环嵌套层
        g_def_cnt = len(g_def_flags)
        return 0
}

pub func tig_stmt_b_107_For(id: i64) -> i64 {
    var tag = s_tags[id]
        // For：name=迭代变量, children=[iter, body]
        // 范围 0..N 最小集；表遍历 `for item in arr`（iter 为 Var 表变量）；
        // 字符串码点迭代 `for c in s.chars()`（dev33 批次4，iter 为 MethodCall）。
        var iter = sstate.child(id, 0)
        var body = sstate.child(id, 1)
        var iter_tag = s_tags[iter]
        if iter_tag == 18 {
            // 字符串码点迭代器 `.chars()`：走 UTF-8 码点步进循环
            if is_chars_method(iter) {
                var fc = tig_for_chars(id, iter, body)
                if fc < 0 {
                    return -1
                }
                return 0
            }
        }
        if iter_tag != 11 {
            // p.9.11.16 迭代器协议对象（struct 实现 has_next/next）：先于表迭代
            // 探测（语义层已登记 node_types[iter]；协议命中 → 方法调用循环）。
            var itp = node_types[iter]
            if itp >= 0 && sinfer.iter_proto_elem(itp) >= 0 {
                var fp = tig_for_iter(id, iter, body, itp)
                if fp < 0 {
                    return -1
                }
                return 0
            }
            // for-in 表迭代（动态表）：计数器 0..len(t) + tie_table_at 读取
            var fr = tig_for_table(id, iter, body)
            if fr < 0 {
                return -1
            }
            return 0
        }
        var start = tig_expr(sstate.child(iter, 0))
        if start < 0 {
            return -1
        }
        var end = tig_expr(sstate.child(iter, 1))
        if end < 0 {
            return -1
        }
        // 循环变量 alloca + 初始值
        var var_alloca = ir.new_inst(g_cur_block, 20, types.named(3))
        ir.add_operand(var_alloca, types.named(3), 2)
        var va = ir.get_value(var_alloca)
        var sv = ir.new_inst(g_cur_block, 22, -1)
        ir.add_operand(sv, types.named(3), 2)
        ir.add_operand(sv, start, 0)
        ir.add_operand(sv, va, 0)
        scope_put(s_names[id], va, types.named(3))
        // cond/body/step/exit 块
        var cond_blk = ir.new_block(g_cur_func, interner.intern("for.cond"))
        var body_blk = ir.new_block(g_cur_func, interner.intern("for.body"))
        var step_blk = ir.new_block(g_cur_func, interner.intern("for.step"))
        var exit_blk = ir.new_block(g_cur_func, interner.intern("for.exit"))
        // 循环上下文：continue → step（自增后），break → exit
        loop_push(s_aux[id], exit_blk, step_blk)
        var b0 = ir.new_inst(g_cur_block, 30, -1)  // br cond
        ir.add_operand(b0, cond_blk, 1)
        // cond 块：cur < end → body，否则 exit
        g_cur_block = cond_blk
        var cur = ir.new_inst(g_cur_block, 21, types.named(3))
        ir.add_operand(cur, va, 0)
        var cur_v = ir.get_value(cur)
        var cmp = ir.new_inst(g_cur_block, 12, types.named(10))  // icmp, i1
        ir.add_operand(cmp, cur_v, 0)
        ir.add_operand(cmp, end, 0)
        ir.add_operand(cmp, 2, 2)  // lt
        var cmp_v = ir.get_value(cmp)
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, cmp_v, 0)
        ir.add_operand(cb, body_blk, 1)
        ir.add_operand(cb, exit_blk, 1)
        // body 块
        g_cur_block = body_blk
        var bb = tig_block_stmts(body)
        if bb < 0 {
            return -1
        }
        if !block_terminated() {
            var bb2 = ir.new_inst(g_cur_block, 30, -1)  // br step
            ir.add_operand(bb2, step_blk, 1)
        }
        // step 块：cur + 1 → store → br cond
        g_cur_block = step_blk
        var add1 = ir.new_inst(g_cur_block, 0, types.named(3))  // add
        ir.add_operand(add1, cur_v, 0)
        ir.add_operand(add1, 1, 2)  // 立即数 1
        var add_v = ir.get_value(add1)
        var st = ir.new_inst(g_cur_block, 22, -1)
        ir.add_operand(st, types.named(3), 2)
        ir.add_operand(st, add_v, 0)
        ir.add_operand(st, va, 0)
        var sb = ir.new_inst(g_cur_block, 30, -1)  // br cond
        ir.add_operand(sb, cond_blk, 1)
        // exit 块
        g_cur_block = exit_blk
        // p.9.11.4 defer：范围 for 退出（break/自然结束汇于 exit_blk）→ 运行本
        // 循环体作用域 defer（g_lp_top 此刻 = 本循环体作用域，逆序）
        if len(g_def_flags) > 0 {
            var drr = tig_run_defers(g_lp_top)
            if drr < 0 {
                return -1
            }
        }
        loop_pop()
        return 0
}

}