type tie<class>
// compiler/backend/irgen_expr.tie —— 生成器 L3 表达式层 子模块
// ============================================================
// 从 irgen.tie 拆分而来：这是 irgen LLVM 风格分层重构的 S4（第四步）。
// 本文件承载 L3 表达式层：表达式主调度器 tig_expr、内置原语名判定
// is_builtin_name、巨型内置表达式生成器 builtin_expr（各 tag 表达式分发 /
// 内置调用 → tie_* 桥 / libc / 内联生成）。它们被上层语句/表达式生成层
// 裸名调用，是表达式求值的核心。L6 调用分派层（tig_runtime_call 等）
// 不属于本轮，留在 irgen.tie 主文件。
//
// 拆分范式：【同 namespace 跨文件】（文本内联）。
// 同 irgen_arith.tie（S3）/ irgen_builder.tie（S1）/ irgen_lit.tie（S2）。
// irgen.tie 顶层 import 本文件后，本文件被文本内联进同一编译单元，声明与
// irgen.tie 相同的 `namespace irgen`，同名 namespace 跨文件闭合并集：
//   - 同 namespace 函数可互相裸名调用（主文件照常裸名调用 tig_expr 等）；
//   - 可访问主文件顶层全局 var（g_cur_block/g_cur_func/node_types/s_tags 等）；
//   - 本文件只含函数与注释，不含顶层全局 var 声明、不含 import——
//     全局 var 与 import 树均留在 irgen.tie 主文件，避免重复定义。
namespace irgen {
// 表达式生成：返回结果值 id；-1 错误
func tig_expr(id: i64) -> i64 {
    var tag = s_tags[id]
    if tag == 0 {
        // IntLit：按推断类型生成常量（后缀字面量 i128/u128/窄整数 → 对应
        // 类型；默认 i64）。曾固定 tig_int_lit(i64)——`1i128 << 64` 左操作数
        // 落 i64，移位生成 trunc i128 %i64 类型错（批次 2 修复）。
        var lt = node_types[id]
        if lt >= 0 && lt != types.named(TK_I64) && types.is_int(lt) {
            return tig_int_lit_ty(s_vals[id], lt)
        }
        return tig_int_lit(s_vals[id])
    }
    if tag == 1 {
        // FloatLit：f64 常量（lexeme 文本存池，llvmgen 规范化输出）
        return tig_float_lit(s_names[id])
    }
    if tag == 2 {
        // StrLit
        return tig_str_lit(s_names[id])
    }
    if tag == 3 {
        // CharLit：'a' / 转义 → i32 码点常量（对齐 Rust CharLit → i32）
        return tig_char_lit(s_names[id])
    }
    if tag == 5 {
        // TritLit：zero → i8 0（true/false 走 BoolLit + trit 上下文改写）
        return tig_trit_lit(s_vals[id])
    }
    if tag == 6 {
        // Var
        var vnid6 = interner.intern(sstate.name_str(id))
        if scope_get_global(vnid6) >= 0 {
            return tig_var_ref(vnid6)
        }
        // S2.2 命名函数提升：变量未入作用域但语义类型是 fn 类型 → 命名函数名
        // 用作函数值（生成适配器 + 构造 {null, @adapt}）。节点类型由 sinfer
        // S_N_VAR 分支登记（fn_sig 命中 → fn 类型）。
        if node_types[id] >= 0 && types.is_fn(node_types[id]) {
            var full_nm = resolve_call_name(sstate.name_str(id))
            return tig_named_fn_value(id, full_nm, node_types[id])
        }
        return tig_var_ref(vnid6)
    }
    if tag == 16 {
        // p.9.12.4：命名空间路径作值 = 命名空间常量引用（ns::NAME → 全名
        // 查全局 gb_*，与 sinfer S_N_PATH 分支对齐；标量全局 load @ns$NAME）
        var pfull = sinfer.recv_path_name(id)
        var pnid = interner.intern(pfull)
        if scope_get_global(pnid) >= 0 {
            return tig_var_ref(pnid)
        }
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "命名空间路径 '" + pfull + "' 不能作为值使用（只能用于调用，如 'x::f()'）"
        return -1
    }
    if tag == 9 {
        // Binary
        return tig_binary(s_vals[id], sstate.child(id, 0), sstate.child(id, 1))
    }
    if tag == 10 {
        // Ternary：cond ? then : else → cond_br + phi（对齐 Rust 三块短路结构）
        return tig_ternary(id)
    }
    if tag == 11 {
        // Range：for 迭代起点/终点
        return tig_expr(sstate.child(id, 0))
    }
    if tag == 7 {
        // Call：println/print / tie 运行时桥内置 / 字符串表数学内置 / 用户函数
        var nm = sstate.name_str(id)
        if nm == "" {
        }
        if nm == "println" || nm == "print" {
            return tig_println(id, nm == "println")
        }
        // S2.2 函数值调用：调用名是 fn 类型变量（闭包字面量/函数值参数/全局 fn）
        // → 间接调用 entry(env, args...)。语义层已校验（sinfer 函数值调用分支），
        // 此处先于 struct/enum/内置/用户函数解析——fn 变量名不可能与类型/函数重名。
        var fv_nid = interner.intern(nm)
        if scope_get_global(fv_nid) >= 0 && types.is_fn(g_lookup_ty) {
            return tig_call_indirect(id, nm)
        }
        // struct 构造调用：StructName(args...) → 聚合值（优先级高于内置/用户
        // 函数解析——构造名不可能与函数/内置重名，语义层已校验）
        if is_struct_name(nm) {
            return tig_struct_construct(id, nm)
        }
        // 枚举构造调用（防御路径：旧式点号名 `EnumName.Variant(...)` 若 parser
        // 产出 Call 则在此处理；现行 parser 对枚举构造产 FieldAccess/MethodCall，
        // 见 tag 15/tag 18 分支。nm 为点号全名时只取枚举段匹配。）
        if is_enum_name(nm) {
            return tig_enum_construct(sstate.bs_find(en_keys, interner.intern(nm)), "", id, sstate.slot_off(id))
        }
        // 内置（语言底座原语 → tie_* 桥或 libc）：非用户函数。
        // 名字命中内置集后失败必须传播（-1 保留原 sm_err_msg），绝不降级为
        // 用户调用——否则内置参数内的未支持表达式会连锁成"函数 X 无签名"
        // 误导错误（历史根因：table_push(j_fvals, 0.0) 曾报 table_push 无签名）
        if is_builtin_name(nm) {
            var br = builtin_expr(nm, id)
            if br >= 0 {
                return g_builtin_res
            }
            if str_len(sm_err_msg) == 0 {
                sm_err_msg = "内置调用 '" + nm + "' 生成失败（函数 " + g_cur_fn_name + "）"
            }
            return -1
        }
        // 用户函数：裸调用名解析（当前命名空间补全）
        var full = resolve_call_name(nm)
        // Call children = [泛型槽, 实参...] → 实参从 children[slot_off] 起
        var aoff = sstate.slot_off(id)
        // 兼容旧式点号名（历史 parser 曾对 `myns.add(...)` 生成 children=[接收者,
        // 实参...]；新 parser 不再产出，防御保留 +1 语义）
        if ig_find_char(nm, ".") >= 0 {
            aoff = aoff + 1
        }
        return tig_user_call_from(full, id, aoff)
    }
    if tag == 148 {
        // P2a 调用表达式 `t[0](5)`：被调者为 fn 值表达式 → 间接调用
        return tig_call_expr(id)
    }
    if tag == 4 {
        // BoolLit → i1 常量（trit 上下文 → i8：true=1 / false=-1，对齐 Rust）
        if node_types[id] == types.named(TK_TRIT) {
            var tv: i64 = -1
            if s_vals[id] == 1 {
                tv = 1
            }
            return tig_trit_lit(tv)
        }
        return tig_bool_lit(s_vals[id])
    }
    if tag == 8 {
        // Unary：0=Neg 1=Not（driver 树无 ++/--）
        var op = s_vals[id]
        var operand = sstate.child(id, 0)
        var ov = tig_expr(operand)
        if ov < 0 {
            return -1
        }
        var oty = node_types[operand]
        if op == 2 || op == 3 || op == 4 || op == 5 {
            // 自增/自减（M4）：2=++i 3=--i 4=i++ 5=i--；操作数必须是变量
            // （语义层保证），直接读写其槽：load → add/sub 1 → store；
            // 前缀返回新值，后缀返回旧值（对齐 Rust tig_inc_dec）
            return tig_inc_dec(op, operand)
        }
        if op == 0 {
            // Neg：整数 → sub 0, x；浮点 → fsub 0.0, x（对齐 Rust fneg 语义）。
            // 立即数 0 在浮点上下文必须为 0.0（LLVM：fsub double 0, %x 非法）
            // p.8.2.4：操作数为用户 struct 且声明 op_neg → 发射方法调用。
            var noty = node_types[operand]
            if noty >= 0 && types.kind(noty) == K_STRUCT {
                var ofull = op_method_full_ir(noty, 0, 0)
                if ofull != "" {
                    var onone: table<i64> = table_new_i64()
                    return tig_op_overload(ofull, operand, noty, onone)
                }
            }
            if oty == types.named(TK_TRIT) {
                // trit 取反（-1↔1，0 保持）：i8 width，sub i8 0, x（与 Not 同款
                // 平衡三值；对齐 interp eval_unary op==0 的 T_TRIT 分支）
                var tneg = ir.new_inst(g_cur_block, 1, types.named(TK_I8))  // sub i8
                ir.add_operand(tneg, 0, 2)
                ir.add_operand(tneg, ov, 0)
                return ir.get_value(tneg)
            }
            if oty == types.named(TK_F64) || oty == types.named(TK_F32) {
                var zf = tig_float_lit(interner.intern("0.0"))
                var fneg = ir.new_inst(g_cur_block, 14, types.named(TK_F64))  // fsub
                ir.add_operand(fneg, zf, 0)
                ir.add_operand(fneg, ov, 0)
                return ir.get_value(fneg)
            }
            // S1.3 A1 窄整数取负：按操作数宽度生成 sub（i8 取负 → sub i8 0, x）
            var nty = types.named(TK_I64)
            if types.is_int(oty) {
                nty = oty
            }
            var inst = ir.new_inst(g_cur_block, 1, nty)  // sub
            ir.add_operand(inst, 0, 2)
            ir.add_operand(inst, ov, 0)
            return ir.get_value(inst)
        }
        if op == 1 {
            // Not：bool → xor i1 true；trit → sub i8 0, x（取反，-1↔1，0 保持）
            if oty == types.named(TK_TRIT) {
                var tnot = ir.new_inst(g_cur_block, 1, types.named(TK_I8))  // sub i8
                ir.add_operand(tnot, 0, 2)
                ir.add_operand(tnot, ov, 0)
                return ir.get_value(tnot)
            }
            var inst = ir.new_inst(g_cur_block, 8, types.named(TK_BOOL))  // xor
            ir.add_operand(inst, ov, 0)
            ir.add_operand(inst, 1, 2)
            return ir.get_value(inst)
        }
        return -1
    }
    if tag == 18 {
        // MethodCall：命名空间函数调用（receiver 路径 + 方法名）
        return tig_method_call(id)
    }
    if tag == 13 {
        // Index：t[i] 表下标读（动态表 → tie_table_at 桥）
        return tig_index_read(id)
    }
    if tag == 150 {
        // p.8.1.5 可空链安全访问：`a?[i]` / `opt?.field` → Option 包装传播
        return tig_safe_access(id)
    }
    if tag == 14 {
        // TupleLit：元组字面量 (a, b) → 聚合值（alloca + 逐字段 store + load）
        return tig_tuple_lit(id)
    }
    if tag == 15 {
        // FieldAccess：.q / .Item1 / .0 字段访问（元组/struct）→ 地址 + GEP + load。
        // 枚举变体常量探测（EnumName.Variant 无 payload）：base 是未绑定变量且
        // 命中 en_keys → 枚举构造（仿 sinfer FieldAccess 分支，必须先于
        // tig_field_access——否则枚举名被当变量查作用域报错）
        var base_node15 = sstate.child(id, 0)
        if s_tags[base_node15] == 6 {  // Var
            var bnm15 = sstate.name_str(base_node15)
            var eidx15 = sstate.bs_find(en_keys, interner.intern(bnm15))
            if eidx15 >= 0 {
                return tig_enum_construct(eidx15, sstate.name_str(id), id, -1)
            }
        }
        return tig_field_access(id)
    }
    if tag == 12 {
        // TableLit：动态表创建（仅 var 初始化/实参场景；直接求值 → 建表）
        return tig_table_lit(id)
    }
    if tag == N_COMPREHENSION {
        // p.8.2.5 表/数组推导式：`[expr for x in src if cond]` → 新建表
        return tig_comprehension(id)
    }
    if tag == N_WITH {
        // p.9.11.6 表不可变更新 `t with {k: v}` → 新表/新映射（见 irgen_agg）
        return tig_with(id)
    }
    if tag == N_SLICE {
        // p.9.11.7 切片/区间 `t[1..3]`/string 子串（见 irgen_agg）
        return tig_slice(id)
    }
    if tag == 131 {
        // S1.2 I1 asm!：生成 inline_asm 指令（模板池 id + 操作数方向/值对）。
        // 第一个 out 操作数 → 结果类型（call 返回值）；其余 out 第一版忽略。
        // 任务17：平台条件编译——target("arch") 标注按当前编译目标分支：
        //   无 target 标注 → 始终发射（向后兼容）；
        //   有 target 标注 → 当前目标匹配任一 → 发射；全不匹配 → 明确报错。
        var nc = sstate.nchild(id)
        // ---------- 平台条件编译判定（任务17）----------
        var has_target: bool = false
        var matched: bool = false
        var listed = ""
        var kt: i64 = 0
        while kt < nc {
            var opx = sstate.child(id, kt)
            if s_vals[opx] == 3 {
                has_target = true
                // 平台名（带引号 lexeme 池 id）→ 去引号纯文本
                var arch = interner.lookup(str_unescape_quoted(s_names[opx]))
                if str_len(listed) > 0 {
                    listed = listed + "/"
                }
                listed = listed + arch
                if asm_target_matches(arch) {
                    matched = true
                }
            }
            kt = kt + 1
        }
        if has_target && !matched {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            var cur_t = g_asm_target
            if str_len(cur_t) == 0 {
                cur_t = "（未设置）"
            }
            sm_err_msg = "asm! 平台 target(" + listed + ") 与当前编译目标 " + cur_t + " 不匹配（无目标平台分支可编译）"
            return -1
        }
        var tmpl = s_names[id]
        var out_slot: i64 = -1
        var out_ty: i64 = -1
        var k: i64 = 0
        while k < nc {
            var op0 = sstate.child(id, k)
            if s_vals[op0] == 1 {  // out
                var e0 = sstate.child(op0, 0)
                if s_tags[e0] == 6 {  // Var
                    var nid0 = interner.intern(sstate.name_str(e0))
                    if scope_get_global(nid0) >= 0 {
                        out_slot = g_lookup_alloca
                        out_ty = g_lookup_ty
                    }
                }
                break
            }
            k = k + 1
        }
        var inst = ir.new_inst(g_cur_block, 65, out_ty)  // void（-1）或 out 类型
        ir.add_operand(inst, tmpl, 0)
        k = 0
        while k < nc {
            var op = sstate.child(id, k)
            var dir = s_vals[op]
            if dir == 3 {
                // target("arch") 平台标注（任务17）：不占 asm 操作数，跳过
                k = k + 1
                continue
            }
            var e = sstate.child(op, 0)
            if dir != 1 {
                // in/inout：求值入参（类型 IMM + 值）
                var ev = tig_expr(e)
                if ev < 0 {
                    return -1
                }
                var et2 = node_types[e]
                if et2 < 0 {
                    et2 = types.named(TK_I64)
                }
                ir.add_operand(inst, dir, 2)
                ir.add_operand(inst, et2, 2)
                ir.add_operand(inst, ev, 0)
            } else {
                // out：不占参数（call 返回值承载）；第一版只支持第一个 out
                ir.add_operand(inst, dir, 2)
                ir.add_operand(inst, types.named(TK_I64), 2)
                ir.add_operand(inst, 0, 2)
            }
            k = k + 1
        }
        if out_slot >= 0 {
            // 结果写回 out 变量槽
            var st = ir.new_inst(g_cur_block, 22, -1)
            ir.add_operand(st, out_ty, 2)
            ir.add_operand(st, ir.get_value(inst), 0)
            ir.add_operand(st, out_slot, 0)
        }
        return tig_int_lit(0)  // 哑值（asm 表达式无值）
    }
    if tag == 132 {
        // S2.2 闭包字面量（N_FN_LIT）：生成入口函数 + 构造闭包值 {env, entry}
        return tig_closure_lit(id)
    }
    if tag == 133 {
        // S2.3：`expr ?` 解包（N_TRY）：Result/Option 枚举——Err/None 提前
        // return，Ok/Some 解包 payload。语义由 sinfer.infer_try_unwrap 校验。
        return tig_try(id)
    }
    if tag == S_N_RUN_ACTOR {
        // 一期并发 A4（Step3）：`run <Actor>(...)` 分配 per-actor state（含初始化
        // OS 锁/条件变量）并返回真实句柄（record 指针 i64）。Step4 起在 record 上
        // 接线程消息循环（mailbox + dispatch + 同步 RPC）。
        return tig_actor_run(id)
    }
    if tag == S_N_GUARD_GET {
        // 三期 A 组 `unsafe.get(share)` 凭据获取（§7.1.1 + unsafe-model §13.4）：
        // guard<cap> 凭据运行期无操作（门禁在编译期语义层强制），LLVM 表示 = i64
        // 占位值 0。对象绑定表达式（children[1]）若存在先求值（取其地址语义由
        // 语义层定义，此处仅保证对象表达式编译通过）。
        var bind = sstate.child(id, 1)
        if bind >= 0 {
            var bv = tig_expr(bind)
            if bv < 0 {
                return -1
            }
        }
        return tig_int_lit(0)
    }
    // p.9.10.1 match/switch 表达式：按模式链短路求值各分支表达式 → phi 汇合。
    if tag == N_SWITCH_EXPR {
        return tig_switch_expr(id)
    }
    // p.9.11.3 try 错误聚合块（N_TRY_BLOCK=157）：线性发射块体语句（块内 `?`
    // 传播到当前函数），末表达式值为 try 块值。
    if tag == 157 {
        return tig_try_block(id)
    }
    // 其他表达式后续扩展
    sm_err_line = s_lines[id]
    sm_err_col = s_cols[id]
    sm_err_msg = "irgen 未支持的表达式（tag=" + to_string(tag) + "，函数 " + g_cur_fn_name + "）"
    return -1
}

// 内置原语名判定（builtin_expr 支持集；与 sbuitin 语义层原语表对齐）。
// 命中即内置——调用失败传播错误，不降级为用户函数路径。
func is_builtin_name(nm: string) -> bool {
    // ---------- S1.2 unsafe 指针/内存内置 ----------
    if nm == "addr_of" || nm == "addr_of_field" || nm == "deref" || nm == "deref_write" ||
        nm == "is_null" || nm == "ptr_add" || nm == "ptr_to_int" || nm == "int_to_ptr" ||
        nm == "alloc" || nm == "free" || nm == "memcpy" || nm == "memset" ||
        nm == "slice_of" || nm == "slice_len" || nm == "slice_index" ||
        nm == "volatile_load" || nm == "volatile_store" {
        return true
    }
    // ---------- S1.3 as_* 显式数值转换族 ----------
    if nm == "as_i8" || nm == "as_i16" || nm == "as_i32" || nm == "as_i64" ||
        nm == "as_u8" || nm == "as_u16" || nm == "as_u32" || nm == "as_u64" ||
        nm == "as_f32" || nm == "as_f64" ||
        nm == "as_i128" || nm == "as_u128" {
        return true
    }
    // ---------- S1.3 checked_* 溢出检测族 ----------
    if nm == "checked_add" || nm == "checked_sub" || nm == "checked_mul" ||
        nm == "checked_div" || nm == "checked_shl" || nm == "checked_shr" ||
        nm == "checked_neg" {
        return true
    }
    if nm == "exec_code" || nm == "time_now" || nm == "get_env" || nm == "exec_output" {
        return true
    }
    if nm == "str_len" || nm == "char_code" || nm == "str_char" || nm == "str_from_code" {
        return true
    }
    // ---------- S2.1 字符串 {ptr,len} 原语 ----------
    // 二进制安全字节访问（str_byte）、UTF-8 码点解码（utf8_seq_len/utf8_char_at）、
    // StringBuilder 句柄（string_builder/sb_append/sb_append_byte/sb_build）
    if nm == "str_byte" || nm == "utf8_seq_len" || nm == "utf8_char_at" ||
        nm == "string_builder" || nm == "sb_append" || nm == "sb_append_byte" ||
        nm == "sb_build" || nm == "sb_reset" || nm == "str_sub_bytes" ||
        nm == "sso_malloc_count" || nm == "catch_panic" || nm == "cb_ptr" {
        return true
    }
    // ---------- 网络原语（P0：std/net）----------
    if nm == "net_close" || nm == "net_tcp_accept" || nm == "net_tcp_connect" ||
        nm == "net_tcp_listen" || nm == "net_tcp_recv" || nm == "net_tcp_send" ||
        nm == "net_udp_bind" || nm == "net_udp_recv" || nm == "net_udp_send" ||
        nm == "net_tcp_recv_bytes" || nm == "net_tcp_send_bytes" ||
        nm == "net_udp_recv_bytes" || nm == "net_udp_send_bytes" {
        return true
    }
    // ---------- 动态加载原语（p.6.6.20 std/sqlite：winsqlite3.dll C ABI 桥）----------
    if nm == "load_library" || nm == "get_proc" ||
        nm == "dyn_call" || nm == "dyn_call_p" || nm == "cstr_to_string" {
        return true
    }
    if nm == "to_string" || nm == "parse_int" || nm == "parse_float" || nm == "parse_trit" ||
        nm == "to_trit" || nm == "trit_val" {
        return true
    }
    if nm == "bitcast_f64_i64" || nm == "bitcast_i64_f64" {
        return true
    }
    if nm == "len" {
        return true
    }
    // P2b：any 拆箱转换（运行时 tag 检查；不匹配 → 运行时错误）
    // P2d：as_table_* 拆箱为元素化表（tag = 精确表类型 id，须与装箱时一致）
    if nm == "as_i64" || nm == "as_f64" || nm == "as_bool" || nm == "as_string" || nm == "as_char" ||
        nm == "as_table_i64" || nm == "as_table_string" || nm == "as_table_bool" ||
        nm == "as_table_f64" || nm == "as_table_char" || nm == "as_table_any" {
        return true
    }
    // P2c：any 运行时辅助——any_tag(x) 读 {tag,payload} 的 tag 字段
    if nm == "any_tag" {
        return true
    }
    // P2d-D3：map 高阶——map_keys(m)/map_values(m)/map_contains(m, key)
    if nm == "map_keys" || nm == "map_values" || nm == "map_contains" {
        return true
    }
    if nm == "table_new_i64" || nm == "table_new_f64" || nm == "table_new_string" || nm == "table_new_bool" {
        return true
    }
    if nm == "table_push" || nm == "table_at" || nm == "table_pop" || nm == "table_trunc" || nm == "exit" {
        return true
    }
    if nm == "arg_count" || nm == "arg_string" {
        return true
    }
    if nm == "file_read" || nm == "file_write" || nm == "file_append" || nm == "file_exists" || nm == "file_delete" {
        return true
    }
    // 完整 fs 元数据（UTF-8 桥）：大小 / 类型判定
    if nm == "file_size" || nm == "file_is_dir" || nm == "file_is_file" {
        return true
    }
    if nm == "print_err" || nm == "mkdir_all" || nm == "remove_dir_all" || nm == "regex_find_all" {
        return true
    }
    if nm == "regex_match" || nm == "regex_find" || nm == "regex_replace" || nm == "regex_group" {
        return true
    }
    if nm == "sqrt" || nm == "sin" || nm == "cos" || nm == "tan" ||
        nm == "exp" || nm == "log" || nm == "floor" || nm == "ceil" || nm == "round" || nm == "pow" ||
        nm == "tanh" || nm == "sinh" || nm == "cosh" || nm == "asin" || nm == "acos" ||
        nm == "atan" || nm == "log2" || nm == "log10" || nm == "expm1" || nm == "log1p" ||
        nm == "cbrt" || nm == "exp2" || nm == "trunc" ||
        nm == "atan2" || nm == "copysign" || nm == "fmod" || nm == "remainder" || nm == "hypot" {
        return true
    }
    if nm == "read_line" || nm == "cwd" || nm == "list_dir" || nm == "walk_dir" ||
        nm == "byte_read" || nm == "byte_write" || nm == "byte_concat" ||
        nm == "stdin_read" || nm == "stdout_write_bytes" || nm == "stdout_write_str" {
        return true
    }
    if nm == "bit_read" || nm == "bit_write" {
        return true
    }
    if nm == "path_basename" || nm == "path_dirname" || nm == "path_abs" ||
        nm == "path_normalize" || nm == "path_join" {
        return true
    }
    if nm == "http_get" || nm == "http_get_file" || nm == "untar_gz" || nm == "unzip" ||
        nm == "copy_dir" || nm == "file_copy" || nm == "file_move" {
        return true
    }
    if nm == "eval" || nm == "eval_call" || nm == "set_env" {
        return true
    }
    if nm == "msg_set_lang" || nm == "msg_get_lang" || nm == "msg_register" ||
        nm == "msg_t" || nm == "msg_t_lang" {
        return true
    }
    if nm == "rand_range" {
        return true
    }
    // ---------- trm-lite 轻量执行体原语（阶段1块2：spawn/yield/collect）----------
    if nm == "spawn" || nm == "yield" || nm == "collect" || nm == "gosched" {
        return true
    }
    // ---------- channel 原语（p.6.5.7：ch_open/ch_send/ch_recv/ch_close，静态链接 trm_lite.a）----------
    if nm == "ch_open" || nm == "ch_send" || nm == "ch_send_block" || nm == "ch_recv" || nm == "ch_close" || nm == "ch_select" {
        return true
    }
    // ---------- WaitGroup 原语（p.6.7.11：wg_new/wg_add/wg_done/wg_wait/wg_count）----------
    if nm == "wg_new" || nm == "wg_add" || nm == "wg_done" || nm == "wg_wait" || nm == "wg_count" {
        return true
    }
    return false
}



    // 背景：byte_read/byte_write/byte_concat/bit_read/bit_write 原以 tie_interp Rust
    // 桥实现（tie_byte_*）。Rust 桥对**原生 32 字节表句柄**（s21 表布局
    // {cap,len,data,esz}）的 ABI 约定不匹配，运行即 0xC0000005 崩溃（与 871d65f
    // alloc 补头扫描同族）。此处改为 tie 内联 IR 全量重写，**零 Rust 依赖、跨
    // Unix/Windows**（文件 IO 走 libc fopen/fread/fwrite/fseek/ftell/fclose，CRT
    // 提供，无需任何系统头/链接库；路径 = tie 串数据指针 UTF-8 char*，Windows 下
    // libc fopen 按 ANSI 代码页解释 → 中文路径受限，与旧 fopen 立场一致）。
    // 表操作走原生句柄 + malloc/memcpy；位操作纯指令（shr/and/shl/or/xor）零依赖。












    // ============ p.6.4.1 内联基础原语 + UTF-16 宽字符桥 ============
    // 新基础设施：UTF-16 宽字符转换（Windows 系统调用面）。tie 字符串为 UTF-8
    //（{8 字节长度头}{数据}{\0}）；SetEnvironmentVariableW / CommandLineToArgvW /
    // GetCurrentDirectoryW 等需要 UTF-16LE（wchar_t*）。编译器后端不能 import
    // std/utf.tie，故在 IR 层手排「码点解码 + 代理对编码」（本组辅助全部生成普通
    // tie-IR 指令；零 Rust 桥、零 tie_interp.lib；UTF-8 逐字节序列判定复用
    // s21_utf8_seq_len / s21_utf8_char_at，代理对编码按 Unicode 规范）。











    // ==================== p.6.9.1 stdio 原语内联（stdin/stdout 字节 IO，零 Rust 桥） ====================
    // 背景：LSP 服务端（JSON-RPC over stdio，p.6.9.2）与 tink 桥共用——与 byte_read/
    // read_line 同范式：GetStdHandle + ReadFile/CRT _write，全 kernel32/CRT 符号
    // （is_libc_sym 免 interp 链接），零 Rust 桥、零 g_used_interp。






    // ==================== p.6.4.7 消息系统原语（纯 tie，运行期全局表） ====================
    // 原 tie_msg_* Rust 桥（g_used_interp=true）改为编译器内联：状态 = 运行期程序
    // 全局槽（惰性登记，仅含 msg_* 的程序才生成；对齐「编译器给用户程序建全局变量」）：
    //   @__msg_lang  : string        当前语言（默认 ""，对齐原 Rust 桥初始态）
    //   @__msg_keys  : table<string> 键平行表
    //   @__msg_langs : table<string> 语言平行表
    //   @__msg_texts : table<string> 文本平行表
    // 语义：msg_register(key,lang,text) 线性扫 (key,lang) 命中覆盖 texts[i] 未命中
    // 三表 append；msg_t(key) 按当前语言查未命中返 key；msg_t_lang(key,lang) 按指定
    // 语言查未命中返空串 ""（对齐 Rust 桥原语义，ext/log 回退链 lookup 依赖）。
    // msg_set_lang/msg_get_lang 读写 @__msg_lang。
    // 模块级惰性登记标记 g_msg_reg_done 声明见 irgen.tie（文件顶层，每模块一次重置）。





























    // ==================== r.1.6.2 Linux POSIX 文件系统分支 ====================
    // file_* 内置（tig_read_file/tig_write_file/tig_mkdir_all/tig_list_dir 等）在
    // Windows 内联 Win32 API（UTF-16 宽字符）；Linux 目标改生成 POSIX 符号调用，
    // **UTF-8 直通**（tie string 即 UTF-8 字节，POSIX 路径天然接受；'\\' 在 POSIX
    // 是普通字符）。以下辅助按 g_asm_target（driver set_target 注入，恒非空）在
    // **编译期**分派——Windows 编译时恒走原 Win32 路径，生成 IR 逐字节不变。
    // ABI 依赖（仅 Linux x86_64，glibc/musl 布局一致，CI 为 ubuntu-latest）：
    //   struct stat   : st_mode@24 (u32)，st_size@48 (i64)，结构全尺寸 144B；
    //   struct dirent : d_type@18 (u8)，d_name@19 (char[256]，NUL 结尾 UTF-8)。
    // 符号位（open/read/write/...）已登记 is_libc_sym（irgen.tie）——非 interp 桥，
    // Linux 目标不触发 tie_interp.lib 链接（link_exe 对 Linux 直接报错）。















    // ==================== p.6.4.9 HTTP 原语内联（Winsock + HTTP/1.1） ====================
    // http_get / http_get_file 从 Rust 桥（tie_http_get/tie_http_get_file，g_used_interp
    // 置位）改为编译器内联 IR：URL 解析 → gethostbyname/connect → GET 请求 →
    // 响应头/体解析。零 Rust 桥（仅复用 p.6.4.5 net_* 内联）。
    // 仅 http://（https 需 TLS，p.6.6.1 再做，本任务 https 返回空串/失败）。
    // 协议：GET + Host + Connection: close → 读全部到 EOF（服务端因 Connection: close
    // 会关闭连接）；解析头找 Content-Length 截取 body；无 Content-Length 读到 EOF。
    // 局限：http_get 返回 tie string，body 含 ≥0x80 字节会破坏 UTF-8 语义（真正二进制
    // 走 p.6.6.1 TLS 后的字节版）；连接/解析/非 2xx 均返回空串。
    // 全部辅助生成内联 tie-IR（零新 opcode、零 tie_interp 桥调用）。










    // ==================== p.6.4.9 通用 inflate 引擎（DEFLATE，纯 tie IR） ====================
    // 编译器内联 DEFLATE inflate：RFC 1951（存储块/固定 Huffman/动态 Huffman + LZ77）。
    // 供 untar_gz（gzip RFC 1952）与 unzip（raw DEFLATE）共用；也是后续 p.6.6 图像 PNG
    //（zlib inflate）的可复用底座。零 Rust 桥、零系统依赖（纯算法）。
    // 数据结构约定：
    //   inflate 状态 st = 32B {src ptr@0, srclen@8, bitpos@16, status@24}（status!=0=失败）
    //   Huffman 表 huff = {counts[16]@0, first[16]@128, offset[16]@256, symbol[n]@384}（i64 槽）
    //   lengths = n 字节 i8 缓冲（码长数组）；输出走 StringBuilder（out_hv）。








    // ==================== p.6.4.9 untar_gz / unzip 内联（gzip+tar / zip 容器解析） ====================
    // untar_gz：gzip（RFC 1952）解压 → tar（ustar 512B 头）逐条目提取；
    // unzip：EOCD + 中央目录 + 本地头解析，stored/deflate 条目提取。
    // 两者共用 tig_inflate_raw（raw DEFLATE）。失败返回 false。路径 UTF-16 安全。













}













