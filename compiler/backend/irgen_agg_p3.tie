type tie<class>
// compiler/backend/irgen_agg_p3.tie —— irgen_agg 分片 3（p.9.21.3 单文件 ≤800 行）
// ============================================================
// 由 split_parts.py 按行数贪心分片：只搬函数与紧邻注释，
// 顶层全局 var 与 import 树仍留在 irgen_agg.tie。
namespace irgen {
// struct 构造调用：StructName(args...) → 聚合值。
// 布局：alloca 聚合 → 逐字段 store（实参覆盖前 n 个；缺省字段零值——
// 字段默认字面量未登记，与 Rust 行为差异留待后续）→ load 聚合值。
func tig_struct_construct(id: i64, nm: string) -> i64 {
    var nid = interner.intern(nm)
    var sidx = sstate.bs_find(st_keys, nid)
    if sidx < 0 {
        sm_err_msg = "struct '" + nm + "' 未定义（函数 " + g_cur_fn_name + "）"
        return -1
    }
    var si = st_vals[sidx]
    var agg = types.struct_of(si)
    var alloca = ir.new_inst(g_cur_block, 20, agg)  // alloca
    ir.add_operand(alloca, agg, 2)
    var ap = ir.get_value(alloca)
    var off = cls_fldoff[si]
    var nf = cls_nfld[si]
    // 构造调用 children = [泛型槽, 实参...]：实参从 children[slot_off] 起
    var soff = sstate.slot_off(id)
    var nc = sstate.nchild(id) - soff
    var i: i64 = 0
    while i < nf {
        var fty = fld_tys[off + i]
        var v: i64 = -1
        var vt: i64 = -1  // v 的来源类型：窄整数字段按 fty 收窄的依据
        if i < nc {
            var an = sstate.child(id, soff + i)
            if types.is_array(fty) && s_tags[an] == 12 {
                // L1 定长数组字段：按字段类型构造字面量
                v = tig_array_lit_typed(an, fty)
            } else if types.is_array(fty) && s_tags[an] == 7 && sstate.name_str(an) == "array_init" {
                // L1 定长数组字段：array_init 广播填充
                v = tig_array_init_typed(an, fty)
            } else {
                v = tig_expr(an)
            }
            if v < 0 {
                return -1
            }
            vt = node_types[an]
        } else if off + i < len(fld_defs) && fld_defs[off + i] >= 0 {
            // 字段默认值（`var y: i64 = 10` → Point(5) 缺省 y 用 10）
            var dn = fld_defs[off + i]
            v = tig_expr(dn)
            if v < 0 {
                return -1
            }
            // 默认值多为字面量：vt 取「tig_expr 实际发射类型」，与 tig_expr 对
            // IntLit/FloatLit 的发射规则逐字对齐——
            //   · IntLit（tag 0）：node_types 若为窄整型（语义收窄且非 i64）则
            //     发射该窄型；否则恒定 i64。**f64/f32 字段的整数字面量默认值
            //     （`var w: f64 = 5`）node_types 会被收窄为浮点 fty，非 int →
            //     发射 i64**——旧逻辑按 fty 类别猜 vt（float fty 一律记 F64），
            //     把该 i64 误当作 f64，致下方 S1.3 收窄跳过、i64 直 store 到
            //     double 槽 → opt 崩溃（%2 defined i64 but expected double）。
            //   · FloatLit（tag 1）：恒定 f64。
            //   其余表达式按语义节点类型 fty 记。
            var dn_ty = node_types[dn]
            if s_tags[dn] == 0 {
                if dn_ty >= 0 && dn_ty != types.named(TK_I64) && types.is_int(dn_ty) {
                    vt = dn_ty
                } else {
                    vt = types.named(TK_I64)
                }
            } else if s_tags[dn] == 1 {
                vt = types.named(TK_F64)
            } else {
                vt = fty
            }
        } else {
            // 无默认值字段：零值（i64=0 / string 空串指针 / bool false）
            v = tig_default_val(fty)
            // 零值来源类型：tig_default_val 对整数落 i64 零（仅 i8 特例直接用
            // 字段类型），f32/f64 → f64 零；string/bool/聚合等与 fty 匹配。
            if types.is_float(fty) {
                vt = types.named(TK_F64)
            } else if fty == types.named(TK_I8) {
                vt = fty
            } else if types.is_int(fty) {
                vt = types.named(TK_I64)
            } else {
                vt = fty
            }
        }
        // S1.3 窄整数字段：无论来源（实参/默认值/零值），store 前统一按字段
        // 类型收窄。修复：tig_default_val / 默认字面量对 u32/u16 等返回 i64，
        // 直接 store 到窄字段致 LLVM 类型不匹配（opt: '%X' defined i64 but expected i32）。
        if vt >= 0 && (types.is_int(vt) || types.is_float(vt)) &&
            (types.is_int(fty) || types.is_float(fty)) && vt != fty {
            var cv = tig_coerce(v, vt, fty)
            if cv < 0 {
                return -1
            }
            v = cv
        }
        // P2c：any 字段装箱——实参/默认值是具体类型 → box（对齐 var/return/参数装箱）
        if fty == types.named(TK_ANY) && vt >= 0 && vt != types.named(TK_ANY) {
            var bx4 = tig_box_any(v, vt)
            if bx4 < 0 {
                return -1
            }
            v = bx4
        }
        var gp = ir.new_inst(g_cur_block, 27, agg)  // agg_gep
        ir.add_operand(gp, ap, 0)
        ir.add_operand(gp, i, 2)
        var gpp = ir.get_value(gp)
        var st = ir.new_inst(g_cur_block, 22, -1)  // store
        ir.add_operand(st, fty, 2)
        ir.add_operand(st, v, 0)
        ir.add_operand(st, gpp, 0)
        i = i + 1
    }
    var ld = ir.new_inst(g_cur_block, 21, agg)  // load 聚合值
    ir.add_operand(ld, ap, 0)
    return ir.get_value(ld)
}

// 行池登记查询：name 池 id → 登记序号；-1 未登记（非行池）。
func rp_find(nm: i64) -> i64 {
    var i: i64 = 0
    while i < len(rp_keys) {
        if rp_keys[i] == nm {
            return i
        }
        i = i + 1
    }
    return -1
}

func rp_is(nm: i64) -> bool {
    return rp_find(nm) >= 0
}

func rp_fld_ty(si: i64, fi: i64) -> i64 {
    return fld_tys[cls_fldoff[si] + fi]
}

// struct si 字段 fi 是否有显式默认值
func rp_fld_has_default(si: i64, fi: i64) -> bool {
    var off = cls_fldoff[si]
    var nf = cls_nfld[si]
    if fi >= nf {
        return false
    }
    return off + fi < len(fld_defs) && fld_defs[off + fi] >= 0
}

// 字段默认值（含 S1.3 收窄/浮点转整数字面量，对齐 tig_struct_construct）；表字段
// 无显式默认 → 有效空表（非 tig_default_val 的 "" 伪句柄）。fele 表元素类型。
func rp_fld_default_val(si: i64, fi: i64, fty: i64) -> i64 {
    var off = cls_fldoff[si]
    var has_def: bool = off + fi < len(fld_defs) && fld_defs[off + fi] >= 0
    var v: i64 = -1
    var vt: i64 = fty
    if has_def {
        var dn = fld_defs[off + fi]
        v = tig_expr(dn)
        if v < 0 {
            return -1
        }
        var nt = node_types[dn]
        if s_tags[dn] == 0 {
            // IntLit：f64/f32 字段的整数字面量默认（`var w: f64 = 5`）发射 i64；窄整数收窄
            if nt >= 0 && nt != types.named(TK_I64) && types.is_int(nt) {
                vt = nt
            } else {
                vt = types.named(TK_I64)
            }
        } else if s_tags[dn] == 1 {
            vt = types.named(TK_F64)
        } else {
            vt = fty
        }
    } else if types.is_table(fty) {
        // 表字段无显式默认 → 有效空表（零值表柄；null 非合法句柄，读会崩）
        var fele = types.table_elem(fty)
        if fele <= 0 {
            fele = types.named(TK_I64)
        }
        v = s21_table_new_ty(fele, tig_int_lit_ty(elem_size(fele), types.named(TK_I64)))
        vt = fty
    } else {
        v = tig_default_val(fty)
        if types.is_float(fty) {
            vt = types.named(TK_F64)
        } else if fty == types.named(TK_I8) {
            vt = fty
        } else if types.is_int(fty) {
            vt = types.named(TK_I64)
        } else {
            vt = fty
        }
    }
    // S1.3 收窄：默认字面量按目标字段类型转换（f64 整数字面量默认 → sitofp；窄型 → trunc）
    if vt >= 0 && (types.is_int(vt) || types.is_float(vt)) &&
        (types.is_int(fty) || types.is_float(fty)) && vt != fty {
        v = tig_coerce(v, vt, fty)
    }
    return v
}

// 构造默认行（R 各字段取默认值）的 struct **值**（供读越界返回默认行）。
func rp_default_row_val(si: i64) -> i64 {
    var agg = types.struct_of(si)
    var alloca = ir.new_inst(g_cur_block, 20, agg)
    ir.add_operand(alloca, agg, 2)
    var ap = ir.get_value(alloca)
    var nf = cls_nfld[si]
    var fi: i64 = 0
    while fi < nf {
        var fty = rp_fld_ty(si, fi)
        var v = rp_fld_default_val(si, fi, fty)
        if v < 0 {
            return -1
        }
        var gp = ir.new_inst(g_cur_block, 27, agg)
        ir.add_operand(gp, ap, 0)
        ir.add_operand(gp, fi, 2)
        var gpp = ir.get_value(gp)
        var st = ir.new_inst(g_cur_block, 22, -1)
        ir.add_operand(st, fty, 2)
        ir.add_operand(st, v, 0)
        ir.add_operand(st, gpp, 0)
        fi = fi + 1
    }
    var ld = ir.new_inst(g_cur_block, 21, agg)
    ir.add_operand(ld, ap, 0)
    return ir.get_value(ld)
}

// 单列扩写：need = i+1；handle 长 < need → 逐槽 push 字段默认值扩到 need，再
// tbl_set(handle, i, &src_addr)。表字段每槽补**新**空表（值语义，防默认行共享）。
func rp_col_grow_set(handle: i64, i: i64, need: i64, fty: i64, defv: i64, src_addr: i64) {
    var T64 = types.named(TK_I64)
    var lenv = s21_table_len(handle)
    var growc = tig_icmp_c(need, lenv, 3)  // need > len
    var gt = ir.new_block(g_cur_func, interner.intern("rp.gt"))
    var ge = ir.new_block(g_cur_func, interner.intern("rp.ge"))
    var cb = ir.new_inst(g_cur_block, 31, -1)
    ir.add_operand(cb, growc, 0)
    ir.add_operand(cb, gt, 1)
    ir.add_operand(cb, ge, 1)
    g_cur_block = gt
    var idx_a = ir.new_inst(g_cur_block, 20, T64)
    ir.add_operand(idx_a, T64, 2)
    var idx_p = ir.get_value(idx_a)
    s21_store(idx_p, lenv, T64)
    var lc = ir.new_block(g_cur_func, interner.intern("rp.gc"))
    var lb = ir.new_block(g_cur_func, interner.intern("rp.gb"))
    var le = ir.new_block(g_cur_func, interner.intern("rp.gx"))
    var bj = ir.new_inst(g_cur_block, 30, -1)
    ir.add_operand(bj, lc, 1)
    g_cur_block = lc
    var cur = s21_load(idx_p, T64)
    var lcnd = tig_icmp_c(cur, need, 2)  // cur < need
    var lcb = ir.new_inst(g_cur_block, 31, -1)
    ir.add_operand(lcb, lcnd, 0)
    ir.add_operand(lcb, lb, 1)
    ir.add_operand(lcb, le, 1)
    g_cur_block = lb
    if types.is_table(fty) {
        // 表字段：每槽新建空表（值语义隔离）
        var fele = types.table_elem(fty)
        if fele <= 0 {
            fele = types.named(TK_I64)
        }
        s21_table_push(handle, fty, s21_table_new_ty(fele, tig_int_lit_ty(elem_size(fele), T64)))
    } else {
        s21_table_push(handle, fty, defv)
    }
    s21_store(idx_p, s21_bin(0, cur, tig_int_lit(1)), T64)  // cur+1
    var bb = ir.new_inst(g_cur_block, 30, -1)
    ir.add_operand(bb, lc, 1)
    g_cur_block = le
    var brg = ir.new_inst(g_cur_block, 30, -1)
    ir.add_operand(brg, ge, 1)
    g_cur_block = ge
    tl_void_3("tl_tbl$tbl_set", t21_ptri(handle), i, t21_ptri(src_addr))
    return
}

// 行池整行写 t[i]=v：负下标诊断；need=i+1；各字段列同步扩（rp_col_grow_set）到
// need 后逐字段 set。字段值取自 row alloca（store v 后 agg_gep）。
func rp_write(nm: i64, i: i64, v: i64) -> i64 {
    var r = rp_find(nm)
    if r < 0 {
        sm_err_msg = "内部错误：行池变量未登记（函数 " + g_cur_fn_name + "）"
        return -1
    }
    var si = rp_si[r]
    var agg = types.struct_of(si)
    var nf = cls_nfld[si]
    // 落 row alloca 供字段 GEP 取地址
    var row_a = ir.new_inst(g_cur_block, 20, agg)
    ir.add_operand(row_a, agg, 2)
    var row_p = ir.get_value(row_a)
    var rst = ir.new_inst(g_cur_block, 22, -1)
    ir.add_operand(rst, agg, 2)
    ir.add_operand(rst, v, 0)
    ir.add_operand(rst, row_p, 0)
    // 负下标诊断（复用 s21_index_raise，p.9.12.2 裁决）
    var negc = tig_icmp_c(i, tig_int_lit(0), 2)  // i < 0
    var nb = ir.new_block(g_cur_func, interner.intern("rp.n"))
    var mg = ir.new_block(g_cur_func, interner.intern("rp.m"))
    var cb0 = ir.new_inst(g_cur_block, 31, -1)
    ir.add_operand(cb0, negc, 0)
    ir.add_operand(cb0, nb, 1)
    ir.add_operand(cb0, mg, 1)
    g_cur_block = nb
    s21_index_raise(mg)
    g_cur_block = mg
    var need = s21_bin(0, i, tig_int_lit(1))  // i+1
    var k: i64 = 0
    while k < nf {
        var fty = rp_fld_ty(si, k)
        var ch = s21_load(rp_allocas[r][k], types.named(TK_STR))  // 列句柄
        var defv = rp_fld_default_val(si, k, fty)
        if defv < 0 {
            return -1
        }
        var gp = ir.new_inst(g_cur_block, 27, agg)  // agg_gep 字段 k
        ir.add_operand(gp, row_p, 0)
        ir.add_operand(gp, k, 2)
        var src_addr = ir.get_value(gp)
        rp_col_grow_set(ch, i, need, fty, defv, src_addr)
        k = k + 1
    }
    return 0
}

// 行池整行读 r = rows[i]：id >= len → 默认行；否则逐字段 tbl_at + 聚合构造赋值。返回 R 值。
func rp_read(nm: i64, i: i64) -> i64 {
    var r = rp_find(nm)
    if r < 0 {
        sm_err_msg = "内部错误：行池变量未登记（函数 " + g_cur_fn_name + "）"
        return -1
    }
    var si = rp_si[r]
    var agg = types.struct_of(si)
    var nf = cls_nfld[si]
    var h0 = s21_load(rp_allocas[r][0], types.named(TK_STR))
    var len = s21_table_len(h0)
    var res_a = ir.new_inst(g_cur_block, 20, agg)
    ir.add_operand(res_a, agg, 2)
    var res_p = ir.get_value(res_a)
    var inb = ir.new_block(g_cur_func, interner.intern("rp.r1"))
    var outb = ir.new_block(g_cur_func, interner.intern("rp.r0"))
    var merge = ir.new_block(g_cur_func, interner.intern("rp.rm"))
    var chk = tig_icmp_c(i, len, 2)  // i < len
    var cbr = ir.new_inst(g_cur_block, 31, -1)
    ir.add_operand(cbr, chk, 0)
    ir.add_operand(cbr, inb, 1)
    ir.add_operand(cbr, outb, 1)
    g_cur_block = inb
    var agg_a = ir.new_inst(g_cur_block, 20, agg)
    ir.add_operand(agg_a, agg, 2)
    var agg_p = ir.get_value(agg_a)
    var j: i64 = 0
    while j < nf {
        var fty = rp_fld_ty(si, j)
        var chj = s21_load(rp_allocas[r][j], types.named(TK_STR))
        var ok = ir.new_inst(g_cur_block, 20, types.named(TK_I8))
        ir.add_operand(ok, types.named(TK_I8), 2)
        var fv = s21_table_at(chj, i, ir.get_value(ok), fty)
        if fv < 0 {
            return -1
        }
        var gp = ir.new_inst(g_cur_block, 27, agg)
        ir.add_operand(gp, agg_p, 0)
        ir.add_operand(gp, j, 2)
        var gpp = ir.get_value(gp)
        var st = ir.new_inst(g_cur_block, 22, -1)
        ir.add_operand(st, fty, 2)
        ir.add_operand(st, fv, 0)
        ir.add_operand(st, gpp, 0)
        j = j + 1
    }
    var in_val = ir.new_inst(g_cur_block, 21, agg)
    ir.add_operand(in_val, agg_p, 0)
    var st_in = ir.new_inst(g_cur_block, 22, -1)
    ir.add_operand(st_in, agg, 2)
    ir.add_operand(st_in, ir.get_value(in_val), 0)
    ir.add_operand(st_in, res_p, 0)
    var bi = ir.new_inst(g_cur_block, 30, -1)
    ir.add_operand(bi, merge, 1)
    g_cur_block = outb
    var drow = rp_default_row_val(si)
    if drow < 0 {
        return -1
    }
    var st_out = ir.new_inst(g_cur_block, 22, -1)
    ir.add_operand(st_out, agg, 2)
    ir.add_operand(st_out, drow, 0)
    ir.add_operand(st_out, res_p, 0)
    var bo = ir.new_inst(g_cur_block, 30, -1)
    ir.add_operand(bo, merge, 1)
    g_cur_block = merge
    var rv = ir.new_inst(g_cur_block, 21, agg)
    ir.add_operand(rv, res_p, 0)
    return ir.get_value(rv)
}

// 行池变量声明：各字段建空列表句柄存独立 alloca；scope 槽存第 0 列 alloca；登记；
// 全部字段列 alloca 入 g_tblcand_allocas（出口 release 释放各列）。返回 0。ty = 完整
// table<R> 类型（scope 登记 + 元素取用）。
func rp_decl(nm: i64, ty: i64) -> i64 {
    var elem = types.table_elem(ty)
    // struct 类型 id = 3<<40 | struct 索引（types.struct_of(si)），故 si = elem - 3<<40。
    // 该 si 与 sstate st_vals/cls_fldoff 的行号一致（tig_struct_construct 同用）。
    var si = elem - (3 << 40)
    var agg = types.struct_of(si)
    var nf = cls_nfld[si]
    var colh: table<i64> = table_new_i64()
    var first_alloca: i64 = -1
    var k: i64 = 0
    while k < nf {
        var fty = rp_fld_ty(si, k)
        var fele: i64 = fty
        var h = s21_table_new_ty(fele, tig_int_lit_ty(elem_size(fele), types.named(TK_I64)))
        var ac = ir.new_inst(g_cur_block, 20, types.named(TK_STR))
        ir.add_operand(ac, types.named(TK_STR), 2)
        var acp = ir.get_value(ac)
        var sts = ir.new_inst(g_cur_block, 22, -1)
        ir.add_operand(sts, types.named(TK_STR), 2)
        ir.add_operand(sts, h, 0)
        ir.add_operand(sts, acp, 0)
        if k == 0 {
            first_alloca = acp
        }
        table_push(colh, acp)
        table_push(g_tblcand_allocas, acp)
        k = k + 1
    }
    table_push(rp_keys, nm)
    table_push(rp_si, si)
    table_push(rp_ncol, nf)
    table_push(rp_allocas, colh)
    // scope 存第 0 列 alloca（类型 = 完整 table<R>，读/写/len 经 rp_* 或 len 直读第 0 列）
    if first_alloca < 0 {
        return 0
    }
    scope_put(nm, first_alloca, ty)
    return 0
}

// 表字面量 → 动态表指针（tie_table_new + 逐元素 push）。
// 元素类型：语义 node_types 首元素推断；空表 → i64 兜底。
func tig_table_lit(id: i64) -> i64 {
    // E3 键值表（map）字面量：任一个 cell 带字符串键（TableCell → TableId，
    // TableId name = 字符串键池 id >= 0；数字键 name=-1 不算 map）→ 走 map 桥：
    // tie_table_new(16) + 逐对 tie_map_set / tie_map_set_string（键为字符串 ptr）。
    // 对齐 Rust 基线 gen_table_lit_arg / gen_dyn_table_var 的 map 展开（元素 16 字节）。
    // 背景（普适段错误根因）：map 字面量曾落入普通表路径——tie_table_new(8) +
    // tie_table_push_i64，键全部丢弃、元素宽度 8 与运行时 map 的 16 字节元素不符，
    // 后续 tie_map_set 按 16 字节越界写堆 → 0xC0000374 / 0xC0000005 崩溃，
    // m["a"] 读回 0（键从未写入）。
    var nc = sstate.nchild(id)
    var has_str_key: bool = false
    var ci: i64 = 0
    while ci < nc {
        var ccell = sstate.child(id, ci)
        var cid = sstate.child(ccell, 0)
        if cid >= 0 && s_names[cid] >= 0 {
            has_str_key = true
        }
        ci = ci + 1
    }
    if has_str_key {
        // map 值类型：node_types[id] = map<V> → low 解码 V；裸 map 兜底 i64；
        // 值为 string → tie_map_set_string（对齐 tig_index_read/assign 的 map 分支）。
        var mval_ty: i64 = types.named(TK_I64)
        var lit_ty = node_types[id]
        if types.is_map(lit_ty) {
            var lv = types.low(lit_ty)
            if lv > 0 {
                mval_ty = lv
            }
        }
        var pty_v = types.named(TK_I64)
        if mval_ty == types.named(TK_STR) {
            pty_v = types.named(TK_STR)
        } else if mval_ty == types.named(TK_ANY) {
            pty_v = types.named(TK_ANY)
        }
        var t = s21_map_new()  // 数组模式句柄（esz=16，复用表基座）
        var i: i64 = 0
        while i < nc {
            var cell = sstate.child(id, i)
            var cid2 = sstate.child(cell, 0)
            if cid2 < 0 || s_names[cid2] < 0 {
                sm_err_msg = "键值表字面量元素缺少字符串键（函数 " + g_cur_fn_name + "）"
                return -1
            }
            // 键字符串 → @.str.N 全局（tig_str_lit 去引号 + 登记常量；键借用约定：
            // 字符串字面量是全局常量，比表存活更久——对齐 Rust string_global）
            var k = tig_str_lit(s_names[cid2])
            var val = sstate.child(cell, 1)
            var v = tig_expr(val)
            if v < 0 {
                return -1
            }
            // P2c：map<any> 值——装箱 + 堆拷贝，值槽存堆指针（any 16 字节
            // 放不进 8 字节值槽；容器布局不变）。值已是 any → 直接堆拷贝。
            if mval_ty == types.named(TK_ANY) {
                var vt3 = node_types[val]
                var src3: i64 = v
                if vt3 >= 0 && vt3 != types.named(TK_ANY) {
                    var bx3 = tig_box_any(v, vt3)
                    if bx3 < 0 {
                        return -1
                    }
                    src3 = bx3
                }
                var any_ty3 = types.named(TK_ANY)
                var hp = s21_raw_alloc_str(tig_int_lit(16))
                if hp < 0 {
                    return -1
                }
                s21_store(hp, src3, any_ty3)
                v = hp
                pty_v = types.named(TK_STR)  // 值槽存堆指针
            }
            s21_map_set(t, k, v, pty_v)  // 有序插入（内联二分，替代 tie_map_set 桥）
            i = i + 1
        }
        return t
    }
    // 普通表字面量（元素类型推断）
    // 空表/空 map `[]`：无 cell，has_str_key=false 落本分支。由语义层
    // node_types[id]（标注类型引导，见 scheck.check_var_decl）区分：
    // map → 生成 map 句柄（esz=16，复用表基座）；否则普通空表（esz 按元素
    // 类型，空表兜底 i64=8）。
    if nc == 0 && types.is_map(node_types[id]) {
        return s21_map_new()
    }
    var elem: i64 = types.named(TK_I64)
    // P2b 异构表：字面量语义类型（sinfer 已登记 node_types[id] = table<elem>）
    // 是元素类型的权威来源——`[1,"a",true]` → table<any>，取 elem=any 使逐
    // 元素装箱分支命中；若只按首元素推断会取 i64，bool/string 元素跳过装箱
    //（`store i64 %i1` 类型错）。空表 `[]` 的 esz 也由此获得（曾 i64=8 兜底，
    // 复合元素多字 esz 不匹配 → 越界写崩溃）。未登记/非参数化才回退首元素。
    var lit_ty2 = node_types[id]
    if types.is_table(lit_ty2) {
        var le2 = types.table_elem(lit_ty2)
        if le2 > 0 {
            elem = le2
        }
    }
    if elem == types.named(TK_I64) && nc > 0 {
        var cell0 = sstate.child(id, 0)
        var val0 = sstate.child(cell0, 1)
        var vt0 = node_types[val0]
        if vt0 >= 0 {
            elem = vt0
        }
    }
    var size = elem_size(elem)
    // 数字实参必须先转值 id（gen_ext_call* 的实参都是值 id，直接传数字
    // 会被当作值引用生成前向引用 %N）
    var size_v = tig_int_lit_ty(size, types.named(TK_I64))
    var t = s21_table_new_ty(elem, size_v)  // r.1.1.4：元素为表 → 深表（release 逐元素释放）
    // 逐元素 push
    var i: i64 = 0
    while i < nc {
        var cell = sstate.child(id, i)
        var val = sstate.child(cell, 1)
        var v = tig_expr(val)
        if v < 0 {
            return -1
        }
        // 桥选择按**值**的实际类型判定（对齐 table_push 内建路径 + Rust
        // table_elem_suffix）：嵌套表/键值表/字符串值 → push_string 存 ptr；
        // 浮点值 → push_f64；否则按声明元素类型（i64/bool）。
        // 背景：二维表/嵌套表字面量 `[[1,2],[3,4]]` 的外层元素类型是
        // table<i64>，若按 elem 选桥会 push_i64(ptr) 类型错（LLVM 拒收）；
        // 且空内层表 `[]` 的 node_types 落 i64 兜底——只要 elem 本身是表，
        // 全部元素一律 push_string（元素全是 ptr）。
        // S2.4：port 对象元素（table<Drawable>）LLVM 表示 = ptr（堆打包
        // {data,vtable}）——走 string 桥（参数类型 TK_STR = ptr，类型匹配）；
        // 返回场景（at）由调用处把返回类型标为 K_PORT 本身，避开 S2.1 的
        // TK_STR 补头逻辑（补头会对 port 对象 ptr 做 strlen → 崩溃）。
        var suffix = bridge_suffix(elem)
        var pty = types.named(TK_I64)
        var elem_k = types.kind(elem)
        if elem_k == K_STRUCT || elem_k == K_ENUM || elem_k == K_FN || elem_k == K_TUPLE || elem == types.named(TK_ANY) {
            // P2a/P2b 复合元素：槽类型 = 元素类型 id（llvmgen 映射 %struct.X/%enum.X/
            // %fn.N / {i64,i64}），类型化 store/load 多字元素；esz 由 elem_size 精确计算。
            pty = elem
        } else if types.is_table(elem) || types.is_map(elem) || types.kind(elem) == K_PORT {
            suffix = "string"
            pty = types.named(TK_STR)
        } else {
            var vt = node_types[val]
            if vt >= 0 && (types.is_table(vt) || types.is_map(vt) || vt == types.named(TK_STR) || types.kind(vt) == K_PORT) {
                suffix = "string"
                pty = types.named(TK_STR)
            } else if vt >= 0 && (vt == types.named(TK_F64) || vt == types.named(TK_F32)) {
                suffix = "f64"
                pty = types.named(TK_F64)
            } else if suffix == "string" {
                pty = types.named(TK_STR)
            } else if suffix == "bool" {
                pty = types.named(TK_BOOL)
            }
        }
        if pty == types.named(TK_ANY) {
            // P2b 异构元素装箱：元素值 → any {tag, payload}
            var vt2 = node_types[val]
            if vt2 >= 0 && vt2 != types.named(TK_ANY) {
                var bx = tig_box_any(v, vt2)
                if bx < 0 {
                    return -1
                }
                v = bx
            }
        }
        // r.1.1.4：字面量元素为**别名表值**（变量/下标/字段读，tag≠7/12）→
        // retain——容器元素持引用，深容器 release 时 -1 守恒（否则内层表所有权
        // 只挂在别名变量上：变量先析构 → 容器深释放读悬垂句柄 → 双重释放
        // 0xC0000374）。瞬态值（调用 tag 7 / 表字面量 tag 12）所有权转移给容器
        //（rc 不变）——与 table_push 内建路径同纪律。仅深容器（元素为表）需要；
        // 元素为 any 盒（flat 容器）不 retain（盒本就不由容器释放）。
        if types.is_table(elem) && pty != types.named(TK_ANY) {
            var vte = node_types[val]
            var vte_tag = s_tags[val]
            if vte >= 0 && types.is_table(vte) && vte_tag != 7 && vte_tag != 12 {
                tig_tbl_retain_call(v)
            }
        }
        s21_table_push(t, pty, v)
        i = i + 1
    }
    return t
}

}