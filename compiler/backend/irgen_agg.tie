type tie<class>
// compiler/backend/irgen_agg.tie —— 生成器 L5 聚合结构子模块（元组/struct/enum/table 字面量与字段访问）
// ============================================================
// 从 irgen.tie 的 L5 聚合结构层拆出（同 namespace irgen 文本内联跨文件）；本文件只含函数，
// 不含顶层全局 var。依赖经主文件 import 链内联可达，不重复 import。
namespace irgen {


// ==================== p.9.12.6：table<R> 结构化行池（列式 SoA）====================
// 行池变量 = R 各字段的平行列表（每字段一根 table<fld>），共享行数（各列恒齐平，
// len 取第 0 列句柄长度）。以下为 irgen 发射辅助：默认行构造 / 整行写（多列同步
// 扩）+ 整行读（逐字段取 + 聚合）共用。字段默认值/零值语义与 tig_struct_construct
// 对齐（f64 整数字面量默认 → sitofp 等），表字段默认缺省时补有效空表（非 null）。


}
import "./irgen_agg_p1.tie"
import "./irgen_agg_p2.tie"
import "./irgen_agg_p3.tie"
import "./irgen_agg_p4.tie"
