type tie<class>
// compiler/backend/irgen_agg.tie —— 生成器 L5 聚合结构子模块（元组/struct/enum/table 字面量与字段访问）
// ============================================================
// 从 irgen.tie 的 L5 聚合结构层拆出（同 namespace irgen 文本内联跨文件）；本文件只含函数，
// 不含顶层全局 var。依赖经主文件 import 链内联可达，不重复 import。
namespace irgen {

// 取聚合 base 的地址（alloca 指针）：Var → 作用域槽地址；表达式 → 求聚合值
// 后 alloca + store（寄存器聚合值落内存，供 GEP 寻址）。
func tig_agg_addr(base: i64, agg: i64) -> i64 {
    if s_tags[base] == 6 {
        var nm = interner.intern(sstate.name_str(base))
        if scope_get_global(nm) >= 0 && g_lookup_is_global == 0 {
            return g_lookup_alloca  // 局部聚合变量槽
        }
    }
    // 表达式（构造调用 / 函数返回 / 字段链）→ 落内存
    var v = tig_expr(base)
    if v < 0 {
        return -1
    }
    var alloca = ir.new_inst(g_cur_block, 20, agg)  // alloca 聚合
    ir.add_operand(alloca, agg, 2)
    var ap = ir.get_value(alloca)
    var st = ir.new_inst(g_cur_block, 22, -1)  // store 聚合值
    ir.add_operand(st, agg, 2)
    ir.add_operand(st, v, 0)
    ir.add_operand(st, ap, 0)
    return ap
}

// 元组字面量 (a, b) → 聚合值：alloca 聚合 → 逐字段 agg_gep + store → load。
// 字段类型取自语义层 tup_tys（node_types[id] 已登记元组类型）。
func tig_tuple_lit(id: i64) -> i64 {
    var agg = node_types[id]
    if agg < 0 {
        sm_err_msg = "元组字面量缺少语义类型（函数 " + g_cur_fn_name + "）"
        return -1
    }
    return tig_tuple_lit_typed(id, agg)
}

// 元组字面量按**目标类型**构造（类型标注适配）：`var w: (i32, i64) = (7, 8)`
// 时语义层把字面量推断为 (i64,i64)，必须按目标 (i32,i64) 构造——IntLit 字段
// 按目标字段类型生成常量（i32 槽存 i32 值；f64 槽转浮点字面量）。
func tig_tuple_lit_typed(id: i64, agg: i64) -> i64 {
    var alloca = ir.new_inst(g_cur_block, 20, agg)  // alloca
    ir.add_operand(alloca, agg, 2)
    var ap = ir.get_value(alloca)
    var nc = sstate.nchild(id)
    var i: i64 = 0
    while i < nc {
        var f = sstate.child(id, i)  // N_TUPLE_FIELD
        var vnode = sstate.child(f, 0)
        var fty = agg_field_ty(agg, i)
        var v: i64 = -1
        if s_tags[vnode] == 0 {
            // IntLit：按目标字段类型生成常量（i32 槽 i32 值 / f64 槽浮点文本）
            if fty == types.named(TK_F64) || fty == types.named(TK_F32) {
                v = tig_float_lit(interner.intern(to_string(s_vals[vnode]) + ".0"))
            } else {
                v = tig_int_lit_ty(s_vals[vnode], fty)
            }
        } else {
            v = tig_expr(vnode)
        }
        if v < 0 {
            return -1
        }
        var gp = ir.new_inst(g_cur_block, 27, agg)  // agg_gep
        ir.add_operand(gp, ap, 0)
        ir.add_operand(gp, i, 2)
        var gpp = ir.get_value(gp)
        var st = ir.new_inst(g_cur_block, 22, -1)  // store
        ir.add_operand(st, fty, 2)
        ir.add_operand(st, v, 0)
        ir.add_operand(st, gpp, 0)
        // p.6.1.7-RCA-2【2026-09-06】：tuple **返回**（Return 置 g_ret_tup_tbl）的
        // 表元素 retain 交调用方——仅当元素是**直接变量引用**（tag==6，即 exit_release
        // 会释放的本地槽，如 point_add 的 return (x3,y3)）：retain 给调用方、出口减回。
        // 元素是表达式/调用（tag==7，如 divrem 的 return (trim(q),trim(r0))）→ 返回的
        // 是全新临时表，非被析构槽，不 retain（否则调用方多持 +1 → 循环内孤儿泄漏）。
        if g_ret_tup_tbl == 1 && types.is_table(fty) && s_tags[vnode] == 6 {
            tig_tbl_retain_call(v)
        }
        i = i + 1
    }
    var ld = ir.new_inst(g_cur_block, 21, agg)  // load 聚合值
    ir.add_operand(ld, ap, 0)
    return ir.get_value(ld)
}

// 字段访问（读）：base.field → 地址 + agg_gep + load。
// 计算属性读：语义层登记 getter（g_cmp_getter[id] > 0）或字段缺失时按方法约定
// 独立探测（<Struct>::<fname> getter 存在）→ 发射 getter 方法调用（接收者 = base
// 表达式，arg 为空），返回属性值。独立探测与 op_add 判定同源，保证自举两期一致。
func tig_computed_getter(id: i64, base: i64, base_ty: i64, fname: string) -> i64 {
    var gidx = g_cmp_getter[id]
    if gidx < 0 {
        gidx = 0
    }
    var gfull = ""
    if gidx > 0 {
        gfull = interner.lookup(gidx)
    } else if types.kind(base_ty) == K_STRUCT {
        var cgsi = types.low(base_ty)
        var cand = sstate.struct_name_of(cgsi) + "::" + fname
        if sstate.fn_sig(cand) >= 0 {
            gfull = cand
        }
    }
    if gfull != "" {
        var gnone: table<i64> = table_new_i64()
        return tig_op_overload(gfull, base, base_ty, gnone)
    }
    return -2
}

func tig_field_access(id: i64) -> i64 {
    var base = sstate.child(id, 0)
    var fname = sstate.name_str(id)
    var base_ty = node_types[base]
    var bk = types.kind(base_ty)
    if base_ty < 0 || (bk != K_TUPLE && bk != K_STRUCT && bk != K_MAP) {
        sm_err_msg = "字段访问 '.' 的对象不是元组/struct/映射记录（类型 " + types.type_name(base_ty) + "，函数 " + g_cur_fn_name + "）"
        return -1
    }
    // p.9.11.5 记录字段读取：`rec.k` ↔ `rec["k"]`（键化表 map 模型）——
    // 字段名作字符串键 → s21_map_get(base, "k")，与下标读（tig_index_read 的
    // map 分支）一致。复合 map 值（map<any>/map<struct>）沿用 map_get 槽语义。
    if bk == K_MAP {
        var mt = tig_expr(base)
        if mt < 0 {
            return -1
        }
        var mvty = types.table_elem(base_ty)
        if mvty < 0 {
            mvty = types.named(TK_I64)
        }
        var key = tig_str_lit(interner.intern(fname))
        return s21_map_get(mt, key, mvty)
    }
    var gres = tig_computed_getter(id, base, base_ty, fname)
    if gres >= 0 {
        return gres
    }
    var fidx = agg_field_index(base_ty, fname)
    if fidx < 0 {
        sm_err_msg = "字段 '" + fname + "' 解析失败（函数 " + g_cur_fn_name + "）"
        return -1
    }
    var fty = agg_field_ty(base_ty, fidx)
    var addr = tig_agg_addr(base, base_ty)
    if addr < 0 {
        return -1
    }
    var gp = ir.new_inst(g_cur_block, 27, base_ty)  // agg_gep
    ir.add_operand(gp, addr, 0)
    ir.add_operand(gp, fidx, 2)
    var gpp = ir.get_value(gp)
    var ld = ir.new_inst(g_cur_block, 21, fty)  // load
    ir.add_operand(ld, gpp, 0)
    return ir.get_value(ld)
}

// 字段赋值（FieldAssign 115）：base.field op= value → 地址 + agg_gep + store。
// 复合赋值（op ≥ 0）先 load 旧值运算再写回（对齐 tig_compound_assign）。
// P2a：base 为表下标 t[i]（元素 struct/tuple）→ 读-改-写回槽（OOB 安全：
// 读越界→零值、写越界→静默），避免写进 tig_agg_addr 的临时副本丢失。
func tig_field_assign(id: i64) -> i64 {
    var fname = sstate.name_str(id)
    var base = sstate.child(id, 0)
    var val = sstate.child(id, 1)
    var op = s_vals[id]
    var base_ty = node_types[base]
    var bk = types.kind(base_ty)
    if base_ty < 0 || (bk != K_TUPLE && bk != K_STRUCT) {
        sm_err_msg = "字段赋值的目标不是元组/struct（类型 " + types.type_name(base_ty) + "，函数 " + g_cur_fn_name + "）"
        return -1
    }
    // p.8.2.7 计算属性写：语义层登记 setter（g_cmp_setter[id] > 0）或字段缺失时
    // 按方法约定独立探测（<Struct>::<fname>_set 存在）→ 发射 setter 方法调用
    // （接收者 = base，实参 = value）。setter 通常 void，tig_op_overload 对 void
    // 返回哑值 0，赋值语句丢弃结果。命中计算属性 → 返回其发射值；否则 -2 走普通
    // 字段存储路径。
    var sidx = g_cmp_setter[id]
    if sidx < 0 {
        sidx = 0
    }
    var sfull = ""
    if sidx > 0 {
        sfull = interner.lookup(sidx)
    } else if types.kind(base_ty) == K_STRUCT {
        var cgsi2 = types.low(base_ty)
        var cand2 = sstate.struct_name_of(cgsi2) + "::" + fname + "_set"
        if sstate.fn_sig(cand2) >= 0 {
            sfull = cand2
        }
    }
    if sfull != "" {
        var onearg: table<i64> = table_new_i64()
        table_push(onearg, val)
        return tig_op_overload(sfull, base, base_ty, onearg)
    }
    var fidx = agg_field_index(base_ty, fname)
    if fidx < 0 {
        sm_err_msg = "字段 '" + fname + "' 解析失败（函数 " + g_cur_fn_name + "）"
        return -1
    }
    var fty = agg_field_ty(base_ty, fidx)
    var is_idx = s_tags[base] == 13  // t[i] 下标 base
    var tbl_v: i64 = -1
    var idx_v: i64 = -1
    var copy_slot: i64 = -1
    var addr: i64 = -1
    if is_idx {
        // 表下标字段赋值：读元素（OOB→零值）→ 副本改字段 → 末尾写回槽
        var tnode = sstate.child(base, 0)
        var inode = sstate.child(base, 1)
        tbl_v = tig_expr(tnode)
        if tbl_v < 0 {
            return -1
        }
        idx_v = tig_expr(inode)
        if idx_v < 0 {
            return -1
        }
        var ok_slot = ir.new_inst(g_cur_block, 20, types.named(TK_I8))  // alloca i8
        ir.add_operand(ok_slot, types.named(TK_I8), 2)
        var elem = s21_table_at(tbl_v, idx_v, ir.get_value(ok_slot), base_ty)
        if elem < 0 {
            return -1
        }
        var alloca = ir.new_inst(g_cur_block, 20, base_ty)  // 副本槽
        ir.add_operand(alloca, base_ty, 2)
        copy_slot = ir.get_value(alloca)
        s21_store(copy_slot, elem, base_ty)
        addr = copy_slot
    } else {
        addr = tig_agg_addr(base, base_ty)
        if addr < 0 {
            return -1
        }
    }
    var gp = ir.new_inst(g_cur_block, 27, base_ty)  // agg_gep
    ir.add_operand(gp, addr, 0)
    ir.add_operand(gp, fidx, 2)
    var gpp = ir.get_value(gp)
    if op >= 0 {
        // 复合字段赋值：load 旧值 → 运算 → store
        var cur = ir.new_inst(g_cur_block, 21, fty)  // load
        ir.add_operand(cur, gpp, 0)
        var cur_v = ir.get_value(cur)
        var rv = tig_expr(val)
        if rv < 0 {
            return -1
        }
        var res = tig_compound_assign(op, cur_v, rv, fty)
        if res < 0 {
            sm_err_msg = "复合字段赋值运算失败（字段 " + fname + "，函数 " + g_cur_fn_name + "）"
            return -1
        }
        var st = ir.new_inst(g_cur_block, 22, -1)  // store
        ir.add_operand(st, fty, 2)
        ir.add_operand(st, res, 0)
        ir.add_operand(st, gpp, 0)
    } else {
        var vv = tig_expr(val)
        if vv < 0 {
            return -1
        }
        // S1.3 窄整数字段：赋值值按字段类型转换（i64 值 → i32 字段）
        var vt = node_types[val]
        if vt >= 0 && (types.is_int(vt) || types.is_float(vt)) &&
            (types.is_int(fty) || types.is_float(fty)) && vt != fty {
            var cv = tig_coerce(vv, vt, fty)
            if cv < 0 {
                return -1
            }
            vv = cv
        }
        // P2c：any 字段赋值装箱——值是具体类型 → box（对齐构造/var/return 装箱）
        if fty == types.named(TK_ANY) && vt >= 0 && vt != types.named(TK_ANY) {
            var bx5 = tig_box_any(vv, vt)
            if bx5 < 0 {
                return -1
            }
            vv = bx5
        }
        // p.6.1.8-RCA【2026-09-06】：struct/元组**字段**表赋值缺引用计数——p.6.1.7
        // 的变量赋值修复未覆盖字段槽：不 retain(新) 则字段只是「借用」源局部（TLS
        // Session 实测：finish13 把 sched_keys 返回的表存入 s.c_key，返回时源局部
        // ca_k 经出口 release 计数到 0 → 字段悬垂 → 应用数据阶段 UAF）。修：store
        // 前 retain(新) 使字段持有自己的引用（RHS 直接构造 table_new_* 所有权已转移
        // 则免；参数 base 借用语义不插桩；下标元素 base 的元素生命周期已持有）。
        // **不 release(旧)**：struct 是值类型、复制别名同一表指针，旧值可能仍被
        // 另一份 struct 副本引用——提前 release 会提前释放（p.6.1.8 自举验证：
        // release 旧字段使编译器自编译失稳，非不动点）。旧字段泄漏，本设计普遍接受。
        var fld_is_tbl: bool = false
        var fld_new_tbl: bool = false
        if fty >= 0 && types.is_table(fty) {
            fld_is_tbl = true
            // r.1.1.4：表字面量（tag 12）同 table_new_* 构造是瞬态新表 → 免 retain
            //（所有权随存储转移给字段；字段不 release 旧值，设计已接受）。
            if s_tags[val] == 12 {
                fld_new_tbl = true
            } else if s_tags[val] == 7 {
                var cnmf2 = sstate.name_str(val)
                if cnmf2 == "table_new_i64" || cnmf2 == "table_new_f64" ||
                    cnmf2 == "table_new_string" || cnmf2 == "table_new_bool" {
                    fld_new_tbl = true
                }
            }
        }
        if fld_is_tbl && !fld_new_tbl {
            tig_tbl_retain_call(vv)
        }
        var st2 = ir.new_inst(g_cur_block, 22, -1)  // store
        ir.add_operand(st2, fty, 2)
        ir.add_operand(st2, vv, 0)
        ir.add_operand(st2, gpp, 0)
    }
    if is_idx {
        // 写回表槽：读副本完整元素 → s21_table_set（越界静默）
        var ne = s21_load(copy_slot, base_ty)
        s21_table_set(tbl_v, idx_v, base_ty, ne)
    }
    return 0
}

// P2b 装箱：具体值 v（vty）→ any {tag, payload} 16 字节值。
// tag 约定：0=i64/整数 1=f64 2=bool 3=string 4=char（payload 直接存/
// type-punned；bool/char/窄整数提升为 i64）。
// P2c 复合类型（struct/enum/fn）：tag = 类型 id（复合 id 远大于标量 0-4），
// payload = 指向堆上按值拷贝聚合的指针（any 的 8 字节 payload 放不下多字聚合）。
// 拆箱由 as_*（T3）/switch 类型匹配（T4、P2c 复合 case 绑定）按 tag 提取。
func tig_box_any(v: i64, vty: i64) -> i64 {
    var any_ty = types.named(TK_ANY)
    var T64 = types.named(TK_I64)
    var slot = ir.new_inst(g_cur_block, 20, any_ty)  // alloca {i64,i64}
    ir.add_operand(slot, any_ty, 2)
    var sp = ir.get_value(slot)
    var tag: i64 = 0
    var pv: i64 = v
    var pty: i64 = T64
    if vty == types.named(TK_STR) {
        tag = 3
        pty = types.named(TK_STR)  // 存 ptr（type-punned 进 i64 槽）
    } else if vty == types.named(TK_F64) {
        tag = 1
        pty = types.named(TK_F64)  // 存 double（8 字节 type-punned）
    } else if vty == types.named(TK_BOOL) {
        tag = 2
        pv = s21_zext(v, types.named(TK_BOOL))  // i1 → i64
    } else if vty == types.named(TK_CHAR) {
        tag = 4
        pv = s21_zext(v, types.named(TK_CHAR))  // i32 → i64
    } else if types.is_int(vty) {
        tag = 0
        if vty != T64 {
            pv = s21_zext(v, vty)  // 窄整数 → i64
        }
    } else if types.kind(vty) == K_STRUCT || types.kind(vty) == K_ENUM || types.kind(vty) == K_FN {
        // P2c 复合装箱：tag = 类型 id（唯一标识，供 switch 类型匹配）；
        // 堆分配 type_byte_size 字节按值拷贝聚合，payload = 堆指针（i64）。
        tag = vty
        var sz = tig_int_lit_ty(type_byte_size(vty), T64)
        var hp = s21_raw_alloc_str(sz)
        if hp < 0 {
            return -1
        }
        s21_store(hp, v, vty)
        var pi2 = ir.new_inst(g_cur_block, 24, T64)  // ptrtoint → i64
        ir.add_operand(pi2, hp, 0)
        pv = ir.get_value(pi2)
        pty = T64
    } else if types.is_table(vty) || types.is_map(vty) {
        // P2d 嵌套表：table/map 值是 ptr（引用类型，句柄在指针后）——tag =
        // 表/映射类型 id，payload = ptrtoint(表 ptr)（8 字节直接容纳，无需堆拷贝）
        tag = vty
        var pi3 = ir.new_inst(g_cur_block, 24, T64)  // ptrtoint → i64
        ir.add_operand(pi3, v, 0)
        pv = ir.get_value(pi3)
        pty = T64
    } else {
        sm_err_msg = "any 装箱暂不支持类型 " + types.type_name(vty) + "（函数 " + g_cur_fn_name + "）"
        return -1
    }
    // tag 常量须先于 store 生成：ir_ops 是全局线性缓冲，指令操作数切片由
    // (ops_off, cnt) 界定——若内联调用 tig_int_lit_ty（其内部 add_operand 也会
    // 推入 ir_ops），会交错进 s0 的操作数切片，导致 tag store 值/地址错位
    //（曾生成 `store i64 0, ptr %const_i` 前向引用错误）。对齐 tig_enum_construct
    // 的同款正确写法：常量先存变量，再逐项 add_operand。
    var tagv = tig_int_lit_ty(tag, T64)
    // tag @ [0]
    var g0 = ir.new_inst(g_cur_block, 27, any_ty)  // agg_gep 字段 0
    ir.add_operand(g0, sp, 0)
    ir.add_operand(g0, 0, 2)
    var g0p = ir.get_value(g0)
    var s0 = ir.new_inst(g_cur_block, 22, -1)  // store tag
    ir.add_operand(s0, T64, 2)
    ir.add_operand(s0, tagv, 0)
    ir.add_operand(s0, g0p, 0)
    // payload @ [1]
    var g1 = ir.new_inst(g_cur_block, 27, any_ty)  // agg_gep 字段 1
    ir.add_operand(g1, sp, 0)
    ir.add_operand(g1, 1, 2)
    var s1 = ir.new_inst(g_cur_block, 22, -1)  // store payload
    ir.add_operand(s1, pty, 2)
    ir.add_operand(s1, pv, 0)
    ir.add_operand(s1, ir.get_value(g1), 0)
    // load any 值
    var ld = ir.new_inst(g_cur_block, 21, any_ty)
    ir.add_operand(ld, sp, 0)
    return ir.get_value(ld)
}

// P2c map<any>：具体值 → 装箱 → 堆拷贝 16 字节 any 盒 → 返回堆指针。
// map 容器条目 16 字节（key@0 8B + value@8 8B），any 值 16 字节放不进 8 字节
// 值槽——值槽存指向堆上 any 盒的指针（容器布局零改动）。读取侧由消费方
// s21_load(ptr, any) 还原。堆内存不回收（与 any 复合装箱一致的借用约定）。
func tig_map_any_heapbox(v: i64, vty: i64) -> i64 {
    var bx = tig_box_any(v, vty)
    if bx < 0 {
        return -1
    }
    var any_ty = types.named(TK_ANY)
    var p = s21_raw_alloc_str(tig_int_lit(16))
    if p < 0 {
        return -1
    }
    s21_store(p, bx, any_ty)
    return p
}

// P2b 拆箱：any 值 v → 目标类型 vty（运行时 tag 检查；不匹配 → 运行时错误）。
// 与 tig_box_any 的 tag 约定对称：0=i64/整数 1=f64 2=bool 3=string 4=char。
// 结构：any 值落 alloca → 读 tag@[0] → icmp 期望 tag → 匹配块取 payload@[1]
//（bool/char 槽存 i64，从 i64 槽 load 后 trunc 还原 i1/i32）；不匹配块
// printf（含期望类型名 + 实际 tag）+ exit(1)（+ 死 br 满足 terminator）。
// 供 as_* 内置（T3）调用；返回 payload 值 id，调用后 g_cur_block = 匹配块。
func tig_unbox_any(v: i64, vty: i64, fname: string) -> i64 {
    var any_ty = types.named(TK_ANY)
    var T64 = types.named(TK_I64)
    // 期望 tag（与 tig_box_any 对称）：标量族 0-4；复合/表/映射 = 类型 id
    var exp_tag: i64 = 0
    if vty == types.named(TK_STR) {
        exp_tag = 3
    } else if vty == types.named(TK_F64) {
        exp_tag = 1
    } else if vty == types.named(TK_BOOL) {
        exp_tag = 2
    } else if vty == types.named(TK_CHAR) {
        exp_tag = 4
    } else if types.is_table(vty) || types.is_map(vty) {
        // P2d 嵌套表：tag = 表/映射类型 id（payload 存 ptrtoint）
        exp_tag = vty
    }
    // payload 槽 LLVM 类型：f64 存 double、string 存 ptr；bool/char/i64 存 i64
    var plty: i64 = T64
    if vty == types.named(TK_F64) {
        plty = types.named(TK_F64)
    } else if vty == types.named(TK_STR) {
        plty = types.named(TK_STR)
    }
    // any 值落 alloca（v 是聚合寄存器，须落内存供 GEP 寻址）
    var slot = ir.new_inst(g_cur_block, 20, any_ty)
    ir.add_operand(slot, any_ty, 2)
    var sp = ir.get_value(slot)
    var st = ir.new_inst(g_cur_block, 22, -1)
    ir.add_operand(st, any_ty, 2)
    ir.add_operand(st, v, 0)
    ir.add_operand(st, sp, 0)
    // 读 tag @[0]
    var g0 = ir.new_inst(g_cur_block, 27, any_ty)  // agg_gep 字段 0
    ir.add_operand(g0, sp, 0)
    ir.add_operand(g0, 0, 2)
    var g0p = ir.get_value(g0)
    var ld0 = ir.new_inst(g_cur_block, 21, T64)
    ir.add_operand(ld0, g0p, 0)
    var tag_v = ir.get_value(ld0)
    // 期望 tag 常量 + icmp eq（对齐 tig_box_any：常量先存变量再 add_operand）
    var expv = tig_int_lit_ty(exp_tag, T64)
    var cmp = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))  // icmp eq
    ir.add_operand(cmp, tag_v, 0)
    ir.add_operand(cmp, expv, 0)
    ir.add_operand(cmp, 0, 2)  // 比较码 eq
    var cmp_v = ir.get_value(cmp)
    // 分支 ok/fail
    var okblk = ir.new_block(g_cur_func, interner.intern("as.ok"))
    var failblk = ir.new_block(g_cur_func, interner.intern("as.fail"))
    var cb = ir.new_inst(g_cur_block, 31, -1)  // cond_br
    ir.add_operand(cb, cmp_v, 0)
    ir.add_operand(cb, okblk, 1)
    ir.add_operand(cb, failblk, 1)
    // failblk：printf（期望类型名 + 实际 tag）+ exit(1)（+ 死 br 满足 terminator）
    g_cur_block = failblk
    var fmt = interner.intern(fname + ": any 值类型不匹配（期望 " + types.type_name(vty) + "，实际 tag=%lld）\n")
    var pinst = ir.new_inst(g_cur_block, 41, types.named(TK_I32))  // call_vararg
    ir.add_operand(pinst, fmt, 0)
    ir.add_operand(pinst, tag_v, 0)
    var one = tig_int_lit_ty(1, types.named(TK_I64))
    tig_ext_call1("exit", one, types.named(TK_I64), -1)
    var db = ir.new_inst(g_cur_block, 30, -1)  // br okblk（死代码）
    ir.add_operand(db, okblk, 1)
    // okblk：load payload + bool/char trunc 还原
    g_cur_block = okblk
    var g1 = ir.new_inst(g_cur_block, 27, any_ty)  // agg_gep 字段 1
    ir.add_operand(g1, sp, 0)
    ir.add_operand(g1, 1, 2)
    var g1p = ir.get_value(g1)
    var ld1 = ir.new_inst(g_cur_block, 21, plty)
    ir.add_operand(ld1, g1p, 0)
    var pv = ir.get_value(ld1)
    // P2d 嵌套表：payload 是 ptrtoint(表 ptr) → inttoptr 还原为表值（ptr）
    if types.is_table(vty) || types.is_map(vty) {
        var ip2 = ir.new_inst(g_cur_block, 25, types.named(TK_STR))  // inttoptr
        ir.add_operand(ip2, pv, 0)
        pv = ir.get_value(ip2)
        // r.1.4.2：as_table_* 返回**别名句柄**，按「表返回函数在 return 处 retain」
        // 契约补 retain——调用方 `var x = as_table_i64(...)` 存变量并登记出口析构，
        // 不 retain 会提前把源表引用减到 0 → 出口析构双重释放（p2d 嵌套表路径
        // 0xC0000374 根因：back_i/m_i/inner_back 与 inner_i 互别名）。
        tig_tbl_retain_call(pv)
    }
    if vty == types.named(TK_BOOL) {
        var tr = ir.new_inst(g_cur_block, 37, types.named(TK_BOOL))  // trunc i64→i1
        ir.add_operand(tr, T64, 2)
        ir.add_operand(tr, pv, 0)
        pv = ir.get_value(tr)
    } else if vty == types.named(TK_CHAR) {
        var tr2 = ir.new_inst(g_cur_block, 37, types.named(TK_CHAR))  // trunc i64→i32
        ir.add_operand(tr2, T64, 2)
        ir.add_operand(tr2, pv, 0)
        pv = ir.get_value(tr2)
    }
    return pv
}

// struct 名判定（构造调用：Call 名命中 st_keys）
func is_struct_name(nm: string) -> bool {
    var nid = interner.intern(nm)
    return sstate.bs_find(st_keys, nid) >= 0
}

// enum 名判定（2026-08-15 enum 语言特性）：枚举名命中 en_keys。
// 仿 is_struct_name——构造分派点（FieldAccess/MethodCall/Call）用。
func is_enum_name(nm: string) -> bool {
    var nid = interner.intern(nm)
    return sstate.bs_find(en_keys, nid) >= 0
}

// 枚举变体 tag 解析：枚举名 + 变体名 → tag 值（0..nvar-1）；-1 = 未找到。
// 在 en_vnames 拍平段（en_varoff[ei] 起 en_nvar[ei] 个）线性查找变体名。
// 供 tig_enum_construct（构造）与 tig_switch（case 模式 → tag 常量）共用。
func enum_variant_tag(ei: i64, vname: string) -> i64 {
    var varoff = en_varoff[ei]
    var nvar = en_nvar[ei]
    var k: i64 = 0
    while k < nvar {
        if intern.lookup(en_vnames[varoff + k]) == vname {
            return en_vtags[varoff + k]
        }
        k = k + 1
    }
    return -1
}

// 枚举 switch 的 case 模式 → tag 常量（-1 = 非法模式）。
// 模式形态：FieldAccess(Enum.Variant)——base 是枚举名 Var，name 是变体名。
// 枚举名解析：普通 enum 直接查 en_keys；泛型 enum 模板名（如 Option）经
// gin 记录反查——subject 是对应模板的实例化时，解析到 subject 的实例
//（scheck 已做同款校验，此处防御性复核）。返回变体 tag 值（0..nvar-1）。
func enum_case_tag(pat: i64, subj_ty: i64) -> i64 {
    var ei = types.low(subj_ty)
    // 批次 7：N_CASE_BIND（`case Ok(v)` 解构）→ 取其变体引用子节点
    if s_tags[pat] == N_CASE_BIND {
        pat = sstate.child(pat, 0)
    }
    // 变体引用：FieldAccess（Enum.Variant）或裸 Var（Variant，枚举名取 subject）
    if s_tags[pat] != 15 && s_tags[pat] != 6 {
        return -1  // 非变体引用（scheck 已拦截，防御）
    }
    var bname = ""
    if s_tags[pat] == 15 {
        var base = sstate.child(pat, 0)
        if s_tags[base] != 6 {
            return -1  // base 非 Var（scheck 已拦截，防御）
        }
        bname = sstate.name_str(base)
    } else {
        bname = sstate.enum_name_of(ei)
    }
    var eidx = sstate.bs_find(en_keys, interner.intern(bname))
    var ei2: i64 = -1
    if eidx >= 0 {
        ei2 = en_vals[eidx]
    } else {
        // 泛型 enum 模板：subject 必须是对应模板的实例化
        var gidx = sstate.gt_find(bname)
        if gidx >= 0 && gty_is_struct[gidx] == 2 {
            var rec = sstate.gin_find(sstate.enum_name_of(ei))
            if rec >= 0 && gin_tmpl[rec] == gidx {
                ei2 = ei
            }
        }
    }
    if ei2 != ei {
        return -1  // base 不是同枚举（scheck 已拦截，防御）
    }
    return enum_variant_tag(ei, sstate.name_str(pat))
}

// 批次 7：枚举变体解构 `case Ok(v)` 的 payload 绑定（在绑定块内调用）。
// p.8.1.4：多字段解构 `case Both(x, t)`——逐 payload 槽（1..nfld）提取绑定。
// subject 已求值（tig_expr 结果，聚合值）；从槽 j 提取 payload，还原成绑定
// 变量类型（string/table → inttoptr / f64 → load double / 窄整数 → trunc），
// 存入新建 alloca 并 scope_put。
func tig_case_bind_body(subject: i64, subj_ty: i64, pat: i64) -> i64 {
    var ei = types.low(subj_ty)
    var ptag = enum_case_tag(pat, subj_ty)
    if ptag < 0 {
        return -1
    }
    var T64 = types.named(TK_I64)
    // payload 类型段（变体 nfld 字段，scheck 已校验绑定数一致）
    var varoff = en_varoff[ei]
    var foff = en_vfldoff[varoff + ptag]
    var nfld = en_vnfld[varoff + ptag]
    // subject 聚合地址
    var eaddr = tig_agg_addr(subject, subj_ty)
    if eaddr < 0 {
        return -1
    }
    var j: i64 = 0
    while j < nfld {
        var pty = en_ftys[foff + j]
        var gj = ir.new_inst(g_cur_block, 27, subj_ty)  // agg_gep 下标 1+j
        ir.add_operand(gj, eaddr, 0)
        ir.add_operand(gj, 1 + j, 2)
        var gjp = ir.get_value(gj)
        var ld = ir.new_inst(g_cur_block, 21, T64)  // load i64 payload
        ir.add_operand(ld, gjp, 0)
        var pv = ir.get_value(ld)
        // 还原 payload 类型（对齐 tig_try：string → inttoptr；f64 → load double；
        // table/map → inttoptr；窄整数 → trunc）
        var bv: i64 = pv
        if pty == types.named(TK_STR) {
            var ip = ir.new_inst(g_cur_block, 25, types.named(TK_STR))  // inttoptr
            ir.add_operand(ip, pv, 0)
            bv = ir.get_value(ip)
        } else if pty == types.named(TK_F64) {
            // f64 payload（p.6.2.1）：槽存 double（8B type-punned）→ load double 直用
            var ldf = ir.new_inst(g_cur_block, 21, pty)
            ir.add_operand(ldf, gjp, 0)
            bv = ir.get_value(ldf)
        } else if types.is_table(pty) || types.is_map(pty) {
            // table/map payload（p.6.2.1）：槽存 ptrtoint → inttoptr 还原 ptr
            var ip2 = ir.new_inst(g_cur_block, 25, pty)  // inttoptr → ptr
            ir.add_operand(ip2, pv, 0)
            bv = ir.get_value(ip2)
        } else if pty != T64 && pty != types.named(TK_U64) && types.is_int(pty) {
            var cv = tig_coerce(bv, T64, pty)
            if cv < 0 {
                return -1
            }
            bv = cv
        }
        // 绑定变量：新建 alloca（payload 类型）+ store + 登记作用域（body 可引用）
        var bind_name = sstate.child(pat, 1 + j)
        var va = ir.new_inst(g_cur_block, 20, pty)  // alloca pty
        ir.add_operand(va, pty, 2)
        var vap = ir.get_value(va)
        s21_store(vap, bv, pty)
        scope_put(bind_name, vap, pty)
        j = j + 1
    }
    return 0
}

// P2c：any 主体 struct 解构——`case Point(p):` 命中后调用。subject 是 any 值，
// payload@[1] = 指向堆上按值拷贝的 Point 的指针（i64）→ inttoptr → load struct →
// 绑定变量 p（alloca + store + scope_put，body 可引用）。
func tig_case_struct_bind_body(subject: i64, subj_ty: i64, pat: i64) -> i64 {
    var sref_n = sstate.child(pat, 0)
    var bind_name = sstate.child(pat, 1)
    var sname = sstate.name_str(sref_n)
    var sidx = sstate.bs_find(st_keys, interner.intern(sname))
    if sidx < 0 {
        return -1
    }
    var s_ty = types.struct_of(st_vals[sidx])
    var T64 = types.named(TK_I64)
    // subject any 落 alloca → 读 payload@[1]（堆指针 i64）
    var saddr = tig_agg_addr(subject, subj_ty)
    if saddr < 0 {
        return -1
    }
    var g1 = ir.new_inst(g_cur_block, 27, subj_ty)  // agg_gep 下标 1
    ir.add_operand(g1, saddr, 0)
    ir.add_operand(g1, 1, 2)
    var g1p = ir.get_value(g1)
    var ld1 = ir.new_inst(g_cur_block, 21, T64)
    ir.add_operand(ld1, g1p, 0)
    var pv = ir.get_value(ld1)
    // inttoptr → 堆 ptr → load struct
    var ip = ir.new_inst(g_cur_block, 25, types.named(TK_STR))  // inttoptr
    ir.add_operand(ip, pv, 0)
    var spp = ir.get_value(ip)
    var ld2 = ir.new_inst(g_cur_block, 21, s_ty)  // load struct
    ir.add_operand(ld2, spp, 0)
    var sv = ir.get_value(ld2)
    // 绑定变量：alloca struct + store + 登记作用域（body 可引用）
    var va = ir.new_inst(g_cur_block, 20, s_ty)
    ir.add_operand(va, s_ty, 2)
    var vap = ir.get_value(va)
    s21_store(vap, sv, s_ty)
    scope_put(bind_name, vap, s_ty)
    return 0
}

// p.9.11.6 表不可变更新 `t with {k: v}` → 新表/新映射（左表不被修改，值语义）。
// 实现（映射/记录路径；数组 with 因 RHS 是 ident/string 键故不表达，留待）：
//   1. s21_map_new 建新映射；
//   2. 拷贝 base 全部键值对（map_keys → 循环 map_get + map_set 入新映射）——
//      未变部分也逐对复制（裁决：容器为扁平数组无结构化共享，故全复制，
//      非零拷贝共享）；
//   3. 应用 with 右侧更新 map 字面量各 (键:值) → map_set 覆盖。
// 值类型：base 的 map 值类型（scalar/string）；any 走 P2c 装箱路径。
func tig_with(id: i64) -> i64 {
    var base = sstate.child(id, 0)
    var upd = sstate.child(id, 1)
    var T64 = types.named(TK_I64)
    var t = tig_expr(base)
    if t < 0 {
        return -1
    }
    // 值类型与槽类型：map 值类型（table_elem）；字符串/表/映射/端口 → ptr 槽
    var vty: i64 = types.named(TK_I64)
    var bt = node_types[base]
    if types.is_map(bt) || types.is_table(bt) {
        var le = types.table_elem(bt)
        if le > 0 {
            vty = le
        }
    }
    var is_any: bool = (vty == types.named(TK_ANY))
    var pty = types.named(TK_I64)
    if vty == types.named(TK_STR) || vty == types.named(TK_BOOL) {
        pty = vty
    } else if is_any {
        // any 值槽存堆指针 → ptr 槽
        pty = types.named(TK_STR)
    } else if types.is_table(vty) || types.is_map(vty) || types.kind(vty) == K_PORT {
        pty = types.named(TK_STR)
    }
    var nm = s21_map_new()
    // ---- 步骤 2：拷贝 base 键值对 ----
    var keys = s21_map_extract(t, types.named(TK_STR), true)  // table<string> 键
    if keys < 0 {
        return -1
    }
    var klen = s21_table_len(keys)
    var idx_a = ir.new_inst(g_cur_block, 20, T64)
    ir.add_operand(idx_a, T64, 2)
    var idx_p = ir.get_value(idx_a)
    s21_store(idx_p, tig_int_lit(0), T64)
    var kc = ir.new_block(g_cur_func, interner.intern("wth.c"))
    var kb = ir.new_block(g_cur_func, interner.intern("wth.b"))
    var ks = ir.new_block(g_cur_func, interner.intern("wth.s"))
    var kx = ir.new_block(g_cur_func, interner.intern("wth.x"))
    var b0 = ir.new_inst(g_cur_block, 30, -1)
    ir.add_operand(b0, kc, 1)
    g_cur_block = kc
    var ci = s21_load(idx_p, T64)
    var clt = tig_icmp_c(ci, klen, 2)  // idx < klen
    var cb = ir.new_inst(g_cur_block, 31, -1)
    ir.add_operand(cb, clt, 0)
    ir.add_operand(cb, kb, 1)
    ir.add_operand(cb, kx, 1)
    g_cur_block = kb
    var ok1 = ir.new_inst(g_cur_block, 20, types.named(TK_I8))
    ir.add_operand(ok1, types.named(TK_I8), 2)
    var kv = s21_table_at(keys, ci, ir.get_value(ok1), types.named(TK_STR))
    if kv < 0 {
        return -1
    }
    var srcv: i64 = -1
    if is_any {
        // any 读：值槽存堆指针 → 读堆还原 {i64,i64}（对齐 tig_index_read map<any>）
        var hp0 = s21_map_get(t, kv, types.named(TK_STR))
        srcv = s21_load(hp0, types.named(TK_ANY))
    } else {
        srcv = s21_map_get(t, kv, pty)
    }
    if srcv < 0 {
        return -1
    }
    if is_any {
        // any 写：装箱拷贝到新堆 → 存指针
        var hp = s21_raw_alloc_str(tig_int_lit(16))
        if hp < 0 {
            return -1
        }
        s21_store(hp, srcv, types.named(TK_ANY))
        s21_map_set(nm, kv, hp, types.named(TK_STR))
    } else {
        s21_map_set(nm, kv, srcv, pty)
    }
    var sb = ir.new_inst(g_cur_block, 30, -1)
    ir.add_operand(sb, ks, 1)
    g_cur_block = ks
    var nxt_i = s21_bin(0, ci, tig_int_lit(1))
    s21_store(idx_p, nxt_i, T64)
    var sb2 = ir.new_inst(g_cur_block, 30, -1)
    ir.add_operand(sb2, kc, 1)
    g_cur_block = kx
    // ---- 步骤 3：应用 RHS 覆盖 ----
    var nc = sstate.nchild(upd)
    var i: i64 = 0
    while i < nc {
        var cell = sstate.child(upd, i)
        var cid = sstate.child(cell, 0)   // TableId（字符串键）
        var keyname = sstate.name_str(cid)
        var k2 = tig_str_lit(interner.intern(keyname))
        var val = sstate.child(cell, 1)
        var vv = tig_expr(val)
        if vv < 0 {
            return -1
        }
        if is_any {
            var vt3 = node_types[val]
            var sv: i64 = vv
            if vt3 >= 0 && vt3 != types.named(TK_ANY) {
                var bx = tig_box_any(vv, vt3)
                if bx < 0 {
                    return -1
                }
                sv = bx
            }
            var hp3 = s21_raw_alloc_str(tig_int_lit(16))
            if hp3 < 0 {
                return -1
            }
            s21_store(hp3, sv, types.named(TK_ANY))
            s21_map_set(nm, k2, hp3, types.named(TK_STR))
        } else {
            s21_map_set(nm, k2, vv, pty)
        }
        i = i + 1
    }
    return nm
}
// 元素 LLVM 槽类型（s21_table_at/table_push 的槽类型）：复合 → 自身；表/映射/端口
// → ptr（TK_STR）；标量按 bridge_suffix。
func elem_llvm_slot(elem: i64) -> i64 {
    var k = types.kind(elem)
    if k == K_STRUCT || k == K_ENUM || k == K_FN || k == K_TUPLE || elem == types.named(TK_ANY) {
        return elem
    }
    if types.is_table(elem) || types.is_map(elem) || types.kind(elem) == K_PORT {
        return types.named(TK_STR)
    }
    var suffix = bridge_suffix(elem)
    if suffix == "string" {
        return types.named(TK_STR)
    }
    if suffix == "bool" {
        return types.named(TK_BOOL)
    }
    if suffix == "f64" {
        return types.named(TK_F64)
    }
    return types.named(TK_I64)
}

// p.9.11.7 切片/区间 `t[1..3]`：base 为表/数组 → 建同元素类型新表 + 复制
// [start,end) 子区间（左闭右开）；base 为字符串 → 字节子串。端点 -1 表示缺省
//（start→0、end→len）。越界裁决：**clamp** 到 [0,len]（对齐 str_sub_bytes 内建
// clamp，与一维下标越界报错不同——切片默认收敛）；负端 clamp 至 0/len；
// start≥end 空结果。表切片 = 新表（拷贝非视图）。
func tig_slice(id: i64) -> i64 {
    var base = sstate.child(id, 0)
    var s1 = sstate.child(id, 1)
    var s2 = sstate.child(id, 2)
    var T64 = types.named(TK_I64)
    var base_ty = node_types[base]
    if base_ty == types.named(TK_STR) {
        // 字符串字节子串（str_sub_bytes 已内建 clamp；end 缺省 + 大数钳到 len）
        var vs = tig_expr(base)
        if vs < 0 {
            return -1
        }
        var lo: i64 = tig_int_lit(0)
        if s1 >= 0 {
            lo = tig_expr(s1)
            if lo < 0 {
                return -1
            }
        }
        var hi: i64 = tig_int_lit(1073741824)  // 1<<30（clamp 到 len 的大上界）
        if s2 >= 0 {
            hi = tig_expr(s2)
            if hi < 0 {
                return -1
            }
        }
        return s21_str_sub_bytes(vs, lo, hi)
    }
    // ---- 表/数组切片 ----
    var elem: i64 = types.named(TK_I64)
    if types.is_table(base_ty) {
        var le = types.table_elem(base_ty)
        if le > 0 {
            elem = le
        }
    }
    var t = tig_expr(base)
    if t < 0 {
        return -1
    }
    var tlen = s21_table_len(t)
    if tlen < 0 {
        return -1
    }
    // lo/hi（运行时值）：start 缺省 0；end 缺省 len；再 clamp 到 [0,len]
    var lo0: i64 = tig_int_lit(0)
    if s1 >= 0 {
        lo0 = tig_expr(s1)
        if lo0 < 0 {
            return -1
        }
    }
    var hi0: i64 = tlen
    if s2 >= 0 {
        hi0 = tig_expr(s2)
        if hi0 < 0 {
            return -1
        }
    }
    var lo_neg = tig_cmp_zero(lo0, 4)           // lo0 < 0
    var lo1 = tig_select_i(lo_neg, tig_int_lit(0), lo0, T64)
    var lo_big = tig_icmp_c(lo1, tlen, 3)       // lo1 > tlen
    var lo = tig_select_i(lo_big, tlen, lo1, T64)
    var hi_neg = tig_cmp_zero(hi0, 4)
    var hi1 = tig_select_i(hi_neg, tig_int_lit(0), hi0, T64)
    var hi_big = tig_icmp_c(hi1, tlen, 3)
    var hi = tig_select_i(hi_big, tlen, hi1, T64)
    // 结果表
    var esz = elem_size(elem)
    var esz_v = tig_int_lit_ty(esz, T64)
    var rt = s21_table_new_ty(elem, esz_v)
    // 循环 i in [lo, hi)：push t[i]
    var idx_a = ir.new_inst(g_cur_block, 20, T64)
    ir.add_operand(idx_a, T64, 2)
    var idx_p = ir.get_value(idx_a)
    s21_store(idx_p, lo, T64)
    var sc = ir.new_block(g_cur_func, interner.intern("slc.c"))
    var sb2 = ir.new_block(g_cur_func, interner.intern("slc.b"))
    var ss = ir.new_block(g_cur_func, interner.intern("slc.s"))
    var sx = ir.new_block(g_cur_func, interner.intern("slc.x"))
    var b0 = ir.new_inst(g_cur_block, 30, -1)
    ir.add_operand(b0, sc, 1)
    g_cur_block = sc
    var ci = s21_load(idx_p, T64)
    var clt = tig_icmp_c(ci, hi, 2)  // i < hi
    var cb = ir.new_inst(g_cur_block, 31, -1)
    ir.add_operand(cb, clt, 0)
    ir.add_operand(cb, sb2, 1)
    ir.add_operand(cb, sx, 1)
    g_cur_block = sb2
    var ok2 = ir.new_inst(g_cur_block, 20, types.named(TK_I8))
    ir.add_operand(ok2, types.named(TK_I8), 2)
    var ev = s21_table_at(t, ci, ir.get_value(ok2), elem_llvm_slot(elem))
    if ev < 0 {
        return -1
    }
    s21_table_push(rt, elem_llvm_slot(elem), ev)
    var sb3 = ir.new_inst(g_cur_block, 30, -1)
    ir.add_operand(sb3, ss, 1)
    g_cur_block = ss
    var ni2 = s21_bin(0, ci, tig_int_lit(1))
    s21_store(idx_p, ni2, T64)
    var sb4 = ir.new_inst(g_cur_block, 30, -1)
    ir.add_operand(sb4, sc, 1)
    g_cur_block = sx
    return rt
}
// 枚举构造：EnumName.Variant(args) → 聚合值。
// eidx：en_keys 下标（构造名反查的枚举）；vname：变体名；id：AST 节点
//（MethodCall 取实参；FieldAccess 无实参）；arg_start：实参起始 child
// 布局（对齐 tig_struct_construct）：alloca %enum.X → store tag（槽 0）→
// 逐 payload 槽 store（实参覆盖前 nfld 个；其余槽零值）→ load 聚合值。
// 槽类型统一 i64：窄整数/字符/布尔 payload 经 sext 升宽到 i64（一期白名单
// 限整数系；string payload 无现成 ptr↔i64 桥 → 报"暂不支持"）。
func tig_enum_construct(eidx: i64, vname: string, id: i64, arg_start: i64) -> i64 {
    var ei = en_vals[eidx]
    var ename = sstate.enum_name_of(ei)
    var tag = enum_variant_tag(ei, vname)
    if tag < 0 {
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "枚举 '" + ename + "' 没有变体 '" + vname + "'（函数 " + g_cur_fn_name + "）"
        return -1
    }
    var varoff = en_varoff[ei]
    var nfld = en_vnfld[varoff + tag]
    var foff = en_vfldoff[varoff + tag]
    var nslot = en_nslot[ei]
    var agg = types.enum_of(ei)
    // alloca 聚合（类型 = %enum.X）
    var alloca = ir.new_inst(g_cur_block, 20, agg)
    ir.add_operand(alloca, agg, 2)
    var ap = ir.get_value(alloca)
    // store tag（槽 0，i64）
    var tagv = tig_int_lit_ty(tag, types.named(TK_I64))
    var g0 = ir.new_inst(g_cur_block, 27, agg)  // agg_gep 下标 0
    ir.add_operand(g0, ap, 0)
    ir.add_operand(g0, 0, 2)
    var g0p = ir.get_value(g0)
    var st0 = ir.new_inst(g_cur_block, 22, -1)  // store
    ir.add_operand(st0, types.named(TK_I64), 2)
    ir.add_operand(st0, tagv, 0)
    ir.add_operand(st0, g0p, 0)
    // 逐 payload 槽（槽下标 1..nslot；i 从 0 起对应槽 1+i）
    var i: i64 = 0
    while i < nslot {
        var fty: i64 = types.named(TK_I64)
        var st_ty: i64 = types.named(TK_I64)  // 槽存储类型（f64 payload → double，8B type-punned）
        var v: i64 = -1
        if i < nfld {
            fty = en_ftys[foff + i]
            var arg = sstate.child(id, arg_start + i)
            if fty == types.named(TK_STR) {
                // string payload（S2.3）：槽是 i64，已按 i64 指针值发射的 string
                // 表达式可直接存储——两类：字符串字面量（const_str 发射为
                // ptrtoint i64）与字符串拼接（str_cat 输出同为 ptrtoint i64，
                // 见 llvmgen op==56）；其余 string 变量/调用返回值是 ptr 值，
                // 需 ptrtoint 转 i64 后存储。读取侧（switch case 绑定 / ? 解包）
                // 由消费方按需 inttoptr 还原 ptr。
                v = tig_expr(arg)
                if v < 0 {
                    return -1
                }
                // 跳过转换：字面量（S_N_STR_LIT=2）或字符串拼接（S_N_BINARY=9
                // 且语义类型为 string——比较类二元返回 bool 不会命中）
                var is_i64_ptrval = s_tags[arg] == 2 ||
                    (s_tags[arg] == 9 && node_types[arg] == types.named(TK_STR))
                if !is_i64_ptrval {
                    var pi = ir.new_inst(g_cur_block, 24, types.named(TK_I64))  // ptrtoint
                    ir.add_operand(pi, v, 0)
                    v = ir.get_value(pi)
                }
            } else if fty == types.named(TK_F64) {
                // f64 payload（p.6.2.1）：double 与 i64 槽同宽 8B，type-punned 直存
                //（对齐 any 装箱 P2b tag=1 的 f64 处理；读侧以 double 还原）
                v = tig_expr(arg)
                if v < 0 {
                    return -1
                }
                st_ty = fty
            } else if types.is_table(fty) || types.is_map(fty) {
                // table/map payload（p.6.2.1）：值是 ptr → ptrtoint 存 i64 槽
                //（与 string 桥同构；读侧按消费方 inttoptr 还原 ptr）
                v = tig_expr(arg)
                if v < 0 {
                    return -1
                }
                var pi = ir.new_inst(g_cur_block, 24, types.named(TK_I64))  // ptrtoint
                ir.add_operand(pi, v, 0)
                v = ir.get_value(pi)
            } else {
                // 窄整数字段 + 整数字面量：按字段类型生成常量（i32 槽 i32 值）——
                // 否则字面量走 tig_expr 恒 i64，sext i32 %i64 类型不匹配。
                // 非字面量（变量/表达式）tig_expr 产出天然窄类型（i32 变量 load i32、
                // 字符/布尔字面量 i32/i1），sext 源类型与 fty 一致。
                if fty != types.named(TK_I64) && fty != types.named(TK_U64) && s_tags[arg] == 0 {
                    v = tig_int_lit_ty(s_vals[arg], fty)
                } else {
                    v = tig_expr(arg)
                }
                if v < 0 {
                    return -1
                }
                // 窄整数/字符/布尔/trit → sext 升宽到 i64（槽统一 i64；u 类型
                // 升宽用 sext——一期仅 i64 payload 参与验收，符号扩展边界已注释；
                // string 已是 i64 指针值，不参与升宽）
                if fty != types.named(TK_I64) && fty != types.named(TK_U64) {
                    var se = ir.new_inst(g_cur_block, 19, types.named(TK_I64))  // sext
                    ir.add_operand(se, fty, 2)
                    ir.add_operand(se, v, 0)
                    v = ir.get_value(se)
                }
            }
        } else {
            // 无 payload 变体 / 超出实参的槽：零值（聚合不含未定义位）
            v = tig_int_lit_ty(0, types.named(TK_I64))
        }
        var gp = ir.new_inst(g_cur_block, 27, agg)  // agg_gep 下标 1+i
        ir.add_operand(gp, ap, 0)
        ir.add_operand(gp, 1 + i, 2)
        var gpp = ir.get_value(gp)
        var st = ir.new_inst(g_cur_block, 22, -1)  // store i64
        ir.add_operand(st, st_ty, 2)
        ir.add_operand(st, v, 0)
        ir.add_operand(st, gpp, 0)
        i = i + 1
    }
    var ld = ir.new_inst(g_cur_block, 21, agg)  // load 聚合值
    ir.add_operand(ld, ap, 0)
    return ir.get_value(ld)
}

// struct 构造调用：StructName(args...) → 聚合值。
// 布局：alloca 聚合 → 逐字段 store（实参覆盖前 n 个；缺省字段零值——
// 字段默认字面量未登记，与 Rust 行为差异留待后续）→ load 聚合值。
func tig_struct_construct(id: i64, nm: string) -> i64 {
    var nid = interner.intern(nm)
    var sidx = sstate.bs_find(st_keys, nid)
    if sidx < 0 {
        sm_err_msg = "struct '" + nm + "' 未定义（函数 " + g_cur_fn_name + "）"
        return -1
    }
    var si = st_vals[sidx]
    var agg = types.struct_of(si)
    var alloca = ir.new_inst(g_cur_block, 20, agg)  // alloca
    ir.add_operand(alloca, agg, 2)
    var ap = ir.get_value(alloca)
    var off = cls_fldoff[si]
    var nf = cls_nfld[si]
    // 构造调用 children = [泛型槽, 实参...]：实参从 children[slot_off] 起
    var soff = sstate.slot_off(id)
    var nc = sstate.nchild(id) - soff
    var i: i64 = 0
    while i < nf {
        var fty = fld_tys[off + i]
        var v: i64 = -1
        var vt: i64 = -1  // v 的来源类型：窄整数字段按 fty 收窄的依据
        if i < nc {
            v = tig_expr(sstate.child(id, soff + i))
            if v < 0 {
                return -1
            }
            var an = sstate.child(id, soff + i)
            vt = node_types[an]
        } else if off + i < len(fld_defs) && fld_defs[off + i] >= 0 {
            // 字段默认值（`var y: i64 = 10` → Point(5) 缺省 y 用 10）
            var dn = fld_defs[off + i]
            v = tig_expr(dn)
            if v < 0 {
                return -1
            }
            // 默认值多为字面量：vt 取「tig_expr 实际发射类型」，与 tig_expr 对
            // IntLit/FloatLit 的发射规则逐字对齐——
            //   · IntLit（tag 0）：node_types 若为窄整型（语义收窄且非 i64）则
            //     发射该窄型；否则恒定 i64。**f64/f32 字段的整数字面量默认值
            //     （`var w: f64 = 5`）node_types 会被收窄为浮点 fty，非 int →
            //     发射 i64**——旧逻辑按 fty 类别猜 vt（float fty 一律记 F64），
            //     把该 i64 误当作 f64，致下方 S1.3 收窄跳过、i64 直 store 到
            //     double 槽 → opt 崩溃（%2 defined i64 but expected double）。
            //   · FloatLit（tag 1）：恒定 f64。
            //   其余表达式按语义节点类型 fty 记。
            var dn_ty = node_types[dn]
            if s_tags[dn] == 0 {
                if dn_ty >= 0 && dn_ty != types.named(TK_I64) && types.is_int(dn_ty) {
                    vt = dn_ty
                } else {
                    vt = types.named(TK_I64)
                }
            } else if s_tags[dn] == 1 {
                vt = types.named(TK_F64)
            } else {
                vt = fty
            }
        } else {
            // 无默认值字段：零值（i64=0 / string 空串指针 / bool false）
            v = tig_default_val(fty)
            // 零值来源类型：tig_default_val 对整数落 i64 零（仅 i8 特例直接用
            // 字段类型），f32/f64 → f64 零；string/bool/聚合等与 fty 匹配。
            if types.is_float(fty) {
                vt = types.named(TK_F64)
            } else if fty == types.named(TK_I8) {
                vt = fty
            } else if types.is_int(fty) {
                vt = types.named(TK_I64)
            } else {
                vt = fty
            }
        }
        // S1.3 窄整数字段：无论来源（实参/默认值/零值），store 前统一按字段
        // 类型收窄。修复：tig_default_val / 默认字面量对 u32/u16 等返回 i64，
        // 直接 store 到窄字段致 LLVM 类型不匹配（opt: '%X' defined i64 but expected i32）。
        if vt >= 0 && (types.is_int(vt) || types.is_float(vt)) &&
            (types.is_int(fty) || types.is_float(fty)) && vt != fty {
            var cv = tig_coerce(v, vt, fty)
            if cv < 0 {
                return -1
            }
            v = cv
        }
        // P2c：any 字段装箱——实参/默认值是具体类型 → box（对齐 var/return/参数装箱）
        if fty == types.named(TK_ANY) && vt >= 0 && vt != types.named(TK_ANY) {
            var bx4 = tig_box_any(v, vt)
            if bx4 < 0 {
                return -1
            }
            v = bx4
        }
        var gp = ir.new_inst(g_cur_block, 27, agg)  // agg_gep
        ir.add_operand(gp, ap, 0)
        ir.add_operand(gp, i, 2)
        var gpp = ir.get_value(gp)
        var st = ir.new_inst(g_cur_block, 22, -1)  // store
        ir.add_operand(st, fty, 2)
        ir.add_operand(st, v, 0)
        ir.add_operand(st, gpp, 0)
        i = i + 1
    }
    var ld = ir.new_inst(g_cur_block, 21, agg)  // load 聚合值
    ir.add_operand(ld, ap, 0)
    return ir.get_value(ld)
}

// ==================== p.9.12.6：table<R> 结构化行池（列式 SoA）====================
// 行池变量 = R 各字段的平行列表（每字段一根 table<fld>），共享行数（各列恒齐平，
// len 取第 0 列句柄长度）。以下为 irgen 发射辅助：默认行构造 / 整行写（多列同步
// 扩）+ 整行读（逐字段取 + 聚合）共用。字段默认值/零值语义与 tig_struct_construct
// 对齐（f64 整数字面量默认 → sitofp 等），表字段默认缺省时补有效空表（非 null）。

// 行池登记查询：name 池 id → 登记序号；-1 未登记（非行池）。
func rp_find(nm: i64) -> i64 {
    var i: i64 = 0
    while i < len(rp_keys) {
        if rp_keys[i] == nm {
            return i
        }
        i = i + 1
    }
    return -1
}
func rp_is(nm: i64) -> bool {
    return rp_find(nm) >= 0
}
func rp_fld_ty(si: i64, fi: i64) -> i64 {
    return fld_tys[cls_fldoff[si] + fi]
}
// struct si 字段 fi 是否有显式默认值
func rp_fld_has_default(si: i64, fi: i64) -> bool {
    var off = cls_fldoff[si]
    var nf = cls_nfld[si]
    if fi >= nf {
        return false
    }
    return off + fi < len(fld_defs) && fld_defs[off + fi] >= 0
}
// 字段默认值（含 S1.3 收窄/浮点转整数字面量，对齐 tig_struct_construct）；表字段
// 无显式默认 → 有效空表（非 tig_default_val 的 "" 伪句柄）。fele 表元素类型。
func rp_fld_default_val(si: i64, fi: i64, fty: i64) -> i64 {
    var off = cls_fldoff[si]
    var has_def: bool = off + fi < len(fld_defs) && fld_defs[off + fi] >= 0
    var v: i64 = -1
    var vt: i64 = fty
    if has_def {
        var dn = fld_defs[off + fi]
        v = tig_expr(dn)
        if v < 0 {
            return -1
        }
        var nt = node_types[dn]
        if s_tags[dn] == 0 {
            // IntLit：f64/f32 字段的整数字面量默认（`var w: f64 = 5`）发射 i64；窄整数收窄
            if nt >= 0 && nt != types.named(TK_I64) && types.is_int(nt) {
                vt = nt
            } else {
                vt = types.named(TK_I64)
            }
        } else if s_tags[dn] == 1 {
            vt = types.named(TK_F64)
        } else {
            vt = fty
        }
    } else if types.is_table(fty) {
        // 表字段无显式默认 → 有效空表（零值表柄；null 非合法句柄，读会崩）
        var fele = types.table_elem(fty)
        if fele <= 0 {
            fele = types.named(TK_I64)
        }
        v = s21_table_new_ty(fele, tig_int_lit_ty(elem_size(fele), types.named(TK_I64)))
        vt = fty
    } else {
        v = tig_default_val(fty)
        if types.is_float(fty) {
            vt = types.named(TK_F64)
        } else if fty == types.named(TK_I8) {
            vt = fty
        } else if types.is_int(fty) {
            vt = types.named(TK_I64)
        } else {
            vt = fty
        }
    }
    // S1.3 收窄：默认字面量按目标字段类型转换（f64 整数字面量默认 → sitofp；窄型 → trunc）
    if vt >= 0 && (types.is_int(vt) || types.is_float(vt)) &&
        (types.is_int(fty) || types.is_float(fty)) && vt != fty {
        v = tig_coerce(v, vt, fty)
    }
    return v
}
// 构造默认行（R 各字段取默认值）的 struct **值**（供读越界返回默认行）。
func rp_default_row_val(si: i64) -> i64 {
    var agg = types.struct_of(si)
    var alloca = ir.new_inst(g_cur_block, 20, agg)
    ir.add_operand(alloca, agg, 2)
    var ap = ir.get_value(alloca)
    var nf = cls_nfld[si]
    var fi: i64 = 0
    while fi < nf {
        var fty = rp_fld_ty(si, fi)
        var v = rp_fld_default_val(si, fi, fty)
        if v < 0 {
            return -1
        }
        var gp = ir.new_inst(g_cur_block, 27, agg)
        ir.add_operand(gp, ap, 0)
        ir.add_operand(gp, fi, 2)
        var gpp = ir.get_value(gp)
        var st = ir.new_inst(g_cur_block, 22, -1)
        ir.add_operand(st, fty, 2)
        ir.add_operand(st, v, 0)
        ir.add_operand(st, gpp, 0)
        fi = fi + 1
    }
    var ld = ir.new_inst(g_cur_block, 21, agg)
    ir.add_operand(ld, ap, 0)
    return ir.get_value(ld)
}
// 单列扩写：need = i+1；handle 长 < need → 逐槽 push 字段默认值扩到 need，再
// tbl_set(handle, i, &src_addr)。表字段每槽补**新**空表（值语义，防默认行共享）。
func rp_col_grow_set(handle: i64, i: i64, need: i64, fty: i64, defv: i64, src_addr: i64) {
    var T64 = types.named(TK_I64)
    var lenv = s21_table_len(handle)
    var growc = tig_icmp_c(need, lenv, 3)  // need > len
    var gt = ir.new_block(g_cur_func, interner.intern("rp.gt"))
    var ge = ir.new_block(g_cur_func, interner.intern("rp.ge"))
    var cb = ir.new_inst(g_cur_block, 31, -1)
    ir.add_operand(cb, growc, 0)
    ir.add_operand(cb, gt, 1)
    ir.add_operand(cb, ge, 1)
    g_cur_block = gt
    var idx_a = ir.new_inst(g_cur_block, 20, T64)
    ir.add_operand(idx_a, T64, 2)
    var idx_p = ir.get_value(idx_a)
    s21_store(idx_p, lenv, T64)
    var lc = ir.new_block(g_cur_func, interner.intern("rp.gc"))
    var lb = ir.new_block(g_cur_func, interner.intern("rp.gb"))
    var le = ir.new_block(g_cur_func, interner.intern("rp.gx"))
    var bj = ir.new_inst(g_cur_block, 30, -1)
    ir.add_operand(bj, lc, 1)
    g_cur_block = lc
    var cur = s21_load(idx_p, T64)
    var lcnd = tig_icmp_c(cur, need, 2)  // cur < need
    var lcb = ir.new_inst(g_cur_block, 31, -1)
    ir.add_operand(lcb, lcnd, 0)
    ir.add_operand(lcb, lb, 1)
    ir.add_operand(lcb, le, 1)
    g_cur_block = lb
    if types.is_table(fty) {
        // 表字段：每槽新建空表（值语义隔离）
        var fele = types.table_elem(fty)
        if fele <= 0 {
            fele = types.named(TK_I64)
        }
        s21_table_push(handle, fty, s21_table_new_ty(fele, tig_int_lit_ty(elem_size(fele), T64)))
    } else {
        s21_table_push(handle, fty, defv)
    }
    s21_store(idx_p, s21_bin(0, cur, tig_int_lit(1)), T64)  // cur+1
    var bb = ir.new_inst(g_cur_block, 30, -1)
    ir.add_operand(bb, lc, 1)
    g_cur_block = le
    var brg = ir.new_inst(g_cur_block, 30, -1)
    ir.add_operand(brg, ge, 1)
    g_cur_block = ge
    tl_void_3("tl_tbl$tbl_set", t21_ptri(handle), i, t21_ptri(src_addr))
    return
}
// 行池整行写 t[i]=v：负下标诊断；need=i+1；各字段列同步扩（rp_col_grow_set）到
// need 后逐字段 set。字段值取自 row alloca（store v 后 agg_gep）。
func rp_write(nm: i64, i: i64, v: i64) -> i64 {
    var r = rp_find(nm)
    if r < 0 {
        sm_err_msg = "内部错误：行池变量未登记（函数 " + g_cur_fn_name + "）"
        return -1
    }
    var si = rp_si[r]
    var agg = types.struct_of(si)
    var nf = cls_nfld[si]
    // 落 row alloca 供字段 GEP 取地址
    var row_a = ir.new_inst(g_cur_block, 20, agg)
    ir.add_operand(row_a, agg, 2)
    var row_p = ir.get_value(row_a)
    var rst = ir.new_inst(g_cur_block, 22, -1)
    ir.add_operand(rst, agg, 2)
    ir.add_operand(rst, v, 0)
    ir.add_operand(rst, row_p, 0)
    // 负下标诊断（复用 s21_index_raise，p.9.12.2 裁决）
    var negc = tig_icmp_c(i, tig_int_lit(0), 2)  // i < 0
    var nb = ir.new_block(g_cur_func, interner.intern("rp.n"))
    var mg = ir.new_block(g_cur_func, interner.intern("rp.m"))
    var cb0 = ir.new_inst(g_cur_block, 31, -1)
    ir.add_operand(cb0, negc, 0)
    ir.add_operand(cb0, nb, 1)
    ir.add_operand(cb0, mg, 1)
    g_cur_block = nb
    s21_index_raise(mg)
    g_cur_block = mg
    var need = s21_bin(0, i, tig_int_lit(1))  // i+1
    var k: i64 = 0
    while k < nf {
        var fty = rp_fld_ty(si, k)
        var ch = s21_load(rp_allocas[r][k], types.named(TK_STR))  // 列句柄
        var defv = rp_fld_default_val(si, k, fty)
        if defv < 0 {
            return -1
        }
        var gp = ir.new_inst(g_cur_block, 27, agg)  // agg_gep 字段 k
        ir.add_operand(gp, row_p, 0)
        ir.add_operand(gp, k, 2)
        var src_addr = ir.get_value(gp)
        rp_col_grow_set(ch, i, need, fty, defv, src_addr)
        k = k + 1
    }
    return 0
}
// 行池整行读 r = rows[i]：id >= len → 默认行；否则逐字段 tbl_at + 聚合构造赋值。返回 R 值。
func rp_read(nm: i64, i: i64) -> i64 {
    var r = rp_find(nm)
    if r < 0 {
        sm_err_msg = "内部错误：行池变量未登记（函数 " + g_cur_fn_name + "）"
        return -1
    }
    var si = rp_si[r]
    var agg = types.struct_of(si)
    var nf = cls_nfld[si]
    var h0 = s21_load(rp_allocas[r][0], types.named(TK_STR))
    var len = s21_table_len(h0)
    var res_a = ir.new_inst(g_cur_block, 20, agg)
    ir.add_operand(res_a, agg, 2)
    var res_p = ir.get_value(res_a)
    var inb = ir.new_block(g_cur_func, interner.intern("rp.r1"))
    var outb = ir.new_block(g_cur_func, interner.intern("rp.r0"))
    var merge = ir.new_block(g_cur_func, interner.intern("rp.rm"))
    var chk = tig_icmp_c(i, len, 2)  // i < len
    var cbr = ir.new_inst(g_cur_block, 31, -1)
    ir.add_operand(cbr, chk, 0)
    ir.add_operand(cbr, inb, 1)
    ir.add_operand(cbr, outb, 1)
    g_cur_block = inb
    var agg_a = ir.new_inst(g_cur_block, 20, agg)
    ir.add_operand(agg_a, agg, 2)
    var agg_p = ir.get_value(agg_a)
    var j: i64 = 0
    while j < nf {
        var fty = rp_fld_ty(si, j)
        var chj = s21_load(rp_allocas[r][j], types.named(TK_STR))
        var ok = ir.new_inst(g_cur_block, 20, types.named(TK_I8))
        ir.add_operand(ok, types.named(TK_I8), 2)
        var fv = s21_table_at(chj, i, ir.get_value(ok), fty)
        if fv < 0 {
            return -1
        }
        var gp = ir.new_inst(g_cur_block, 27, agg)
        ir.add_operand(gp, agg_p, 0)
        ir.add_operand(gp, j, 2)
        var gpp = ir.get_value(gp)
        var st = ir.new_inst(g_cur_block, 22, -1)
        ir.add_operand(st, fty, 2)
        ir.add_operand(st, fv, 0)
        ir.add_operand(st, gpp, 0)
        j = j + 1
    }
    var in_val = ir.new_inst(g_cur_block, 21, agg)
    ir.add_operand(in_val, agg_p, 0)
    var st_in = ir.new_inst(g_cur_block, 22, -1)
    ir.add_operand(st_in, agg, 2)
    ir.add_operand(st_in, ir.get_value(in_val), 0)
    ir.add_operand(st_in, res_p, 0)
    var bi = ir.new_inst(g_cur_block, 30, -1)
    ir.add_operand(bi, merge, 1)
    g_cur_block = outb
    var drow = rp_default_row_val(si)
    if drow < 0 {
        return -1
    }
    var st_out = ir.new_inst(g_cur_block, 22, -1)
    ir.add_operand(st_out, agg, 2)
    ir.add_operand(st_out, drow, 0)
    ir.add_operand(st_out, res_p, 0)
    var bo = ir.new_inst(g_cur_block, 30, -1)
    ir.add_operand(bo, merge, 1)
    g_cur_block = merge
    var rv = ir.new_inst(g_cur_block, 21, agg)
    ir.add_operand(rv, res_p, 0)
    return ir.get_value(rv)
}
// 行池变量声明：各字段建空列表句柄存独立 alloca；scope 槽存第 0 列 alloca；登记；
// 全部字段列 alloca 入 g_tblcand_allocas（出口 release 释放各列）。返回 0。ty = 完整
// table<R> 类型（scope 登记 + 元素取用）。
func rp_decl(nm: i64, ty: i64) -> i64 {
    var elem = types.table_elem(ty)
    // struct 类型 id = 3<<40 | struct 索引（types.struct_of(si)），故 si = elem - 3<<40。
    // 该 si 与 sstate st_vals/cls_fldoff 的行号一致（tig_struct_construct 同用）。
    var si = elem - (3 << 40)
    var agg = types.struct_of(si)
    var nf = cls_nfld[si]
    var colh: table<i64> = table_new_i64()
    var first_alloca: i64 = -1
    var k: i64 = 0
    while k < nf {
        var fty = rp_fld_ty(si, k)
        var fele: i64 = fty
        var h = s21_table_new_ty(fele, tig_int_lit_ty(elem_size(fele), types.named(TK_I64)))
        var ac = ir.new_inst(g_cur_block, 20, types.named(TK_STR))
        ir.add_operand(ac, types.named(TK_STR), 2)
        var acp = ir.get_value(ac)
        var sts = ir.new_inst(g_cur_block, 22, -1)
        ir.add_operand(sts, types.named(TK_STR), 2)
        ir.add_operand(sts, h, 0)
        ir.add_operand(sts, acp, 0)
        if k == 0 {
            first_alloca = acp
        }
        table_push(colh, acp)
        table_push(g_tblcand_allocas, acp)
        k = k + 1
    }
    table_push(rp_keys, nm)
    table_push(rp_si, si)
    table_push(rp_ncol, nf)
    table_push(rp_allocas, colh)
    // scope 存第 0 列 alloca（类型 = 完整 table<R>，读/写/len 经 rp_* 或 len 直读第 0 列）
    if first_alloca < 0 {
        return 0
    }
    scope_put(nm, first_alloca, ty)
    return 0
}

// 表字面量 → 动态表指针（tie_table_new + 逐元素 push）。
// 元素类型：语义 node_types 首元素推断；空表 → i64 兜底。
func tig_table_lit(id: i64) -> i64 {
    // E3 键值表（map）字面量：任一个 cell 带字符串键（TableCell → TableId，
    // TableId name = 字符串键池 id >= 0；数字键 name=-1 不算 map）→ 走 map 桥：
    // tie_table_new(16) + 逐对 tie_map_set / tie_map_set_string（键为字符串 ptr）。
    // 对齐 Rust 基线 gen_table_lit_arg / gen_dyn_table_var 的 map 展开（元素 16 字节）。
    // 背景（普适段错误根因）：map 字面量曾落入普通表路径——tie_table_new(8) +
    // tie_table_push_i64，键全部丢弃、元素宽度 8 与运行时 map 的 16 字节元素不符，
    // 后续 tie_map_set 按 16 字节越界写堆 → 0xC0000374 / 0xC0000005 崩溃，
    // m["a"] 读回 0（键从未写入）。
    var nc = sstate.nchild(id)
    var has_str_key: bool = false
    var ci: i64 = 0
    while ci < nc {
        var ccell = sstate.child(id, ci)
        var cid = sstate.child(ccell, 0)
        if cid >= 0 && s_names[cid] >= 0 {
            has_str_key = true
        }
        ci = ci + 1
    }
    if has_str_key {
        // map 值类型：node_types[id] = map<V> → low 解码 V；裸 map 兜底 i64；
        // 值为 string → tie_map_set_string（对齐 tig_index_read/assign 的 map 分支）。
        var mval_ty: i64 = types.named(TK_I64)
        var lit_ty = node_types[id]
        if types.is_map(lit_ty) {
            var lv = types.low(lit_ty)
            if lv > 0 {
                mval_ty = lv
            }
        }
        var pty_v = types.named(TK_I64)
        if mval_ty == types.named(TK_STR) {
            pty_v = types.named(TK_STR)
        } else if mval_ty == types.named(TK_ANY) {
            pty_v = types.named(TK_ANY)
        }
        var t = s21_map_new()  // 数组模式句柄（esz=16，复用表基座）
        var i: i64 = 0
        while i < nc {
            var cell = sstate.child(id, i)
            var cid2 = sstate.child(cell, 0)
            if cid2 < 0 || s_names[cid2] < 0 {
                sm_err_msg = "键值表字面量元素缺少字符串键（函数 " + g_cur_fn_name + "）"
                return -1
            }
            // 键字符串 → @.str.N 全局（tig_str_lit 去引号 + 登记常量；键借用约定：
            // 字符串字面量是全局常量，比表存活更久——对齐 Rust string_global）
            var k = tig_str_lit(s_names[cid2])
            var val = sstate.child(cell, 1)
            var v = tig_expr(val)
            if v < 0 {
                return -1
            }
            // P2c：map<any> 值——装箱 + 堆拷贝，值槽存堆指针（any 16 字节
            // 放不进 8 字节值槽；容器布局不变）。值已是 any → 直接堆拷贝。
            if mval_ty == types.named(TK_ANY) {
                var vt3 = node_types[val]
                var src3: i64 = v
                if vt3 >= 0 && vt3 != types.named(TK_ANY) {
                    var bx3 = tig_box_any(v, vt3)
                    if bx3 < 0 {
                        return -1
                    }
                    src3 = bx3
                }
                var any_ty3 = types.named(TK_ANY)
                var hp = s21_raw_alloc_str(tig_int_lit(16))
                if hp < 0 {
                    return -1
                }
                s21_store(hp, src3, any_ty3)
                v = hp
                pty_v = types.named(TK_STR)  // 值槽存堆指针
            }
            s21_map_set(t, k, v, pty_v)  // 有序插入（内联二分，替代 tie_map_set 桥）
            i = i + 1
        }
        return t
    }
    // 普通表字面量（元素类型推断）
    // 空表/空 map `[]`：无 cell，has_str_key=false 落本分支。由语义层
    // node_types[id]（标注类型引导，见 scheck.check_var_decl）区分：
    // map → 生成 map 句柄（esz=16，复用表基座）；否则普通空表（esz 按元素
    // 类型，空表兜底 i64=8）。
    if nc == 0 && types.is_map(node_types[id]) {
        return s21_map_new()
    }
    var elem: i64 = types.named(TK_I64)
    // P2b 异构表：字面量语义类型（sinfer 已登记 node_types[id] = table<elem>）
    // 是元素类型的权威来源——`[1,"a",true]` → table<any>，取 elem=any 使逐
    // 元素装箱分支命中；若只按首元素推断会取 i64，bool/string 元素跳过装箱
    //（`store i64 %i1` 类型错）。空表 `[]` 的 esz 也由此获得（曾 i64=8 兜底，
    // 复合元素多字 esz 不匹配 → 越界写崩溃）。未登记/非参数化才回退首元素。
    var lit_ty2 = node_types[id]
    if types.is_table(lit_ty2) {
        var le2 = types.table_elem(lit_ty2)
        if le2 > 0 {
            elem = le2
        }
    }
    if elem == types.named(TK_I64) && nc > 0 {
        var cell0 = sstate.child(id, 0)
        var val0 = sstate.child(cell0, 1)
        var vt0 = node_types[val0]
        if vt0 >= 0 {
            elem = vt0
        }
    }
    var size = elem_size(elem)
    // 数字实参必须先转值 id（gen_ext_call* 的实参都是值 id，直接传数字
    // 会被当作值引用生成前向引用 %N）
    var size_v = tig_int_lit_ty(size, types.named(TK_I64))
    var t = s21_table_new_ty(elem, size_v)  // r.1.1.4：元素为表 → 深表（release 逐元素释放）
    // 逐元素 push
    var i: i64 = 0
    while i < nc {
        var cell = sstate.child(id, i)
        var val = sstate.child(cell, 1)
        var v = tig_expr(val)
        if v < 0 {
            return -1
        }
        // 桥选择按**值**的实际类型判定（对齐 table_push 内建路径 + Rust
        // table_elem_suffix）：嵌套表/键值表/字符串值 → push_string 存 ptr；
        // 浮点值 → push_f64；否则按声明元素类型（i64/bool）。
        // 背景：二维表/嵌套表字面量 `[[1,2],[3,4]]` 的外层元素类型是
        // table<i64>，若按 elem 选桥会 push_i64(ptr) 类型错（LLVM 拒收）；
        // 且空内层表 `[]` 的 node_types 落 i64 兜底——只要 elem 本身是表，
        // 全部元素一律 push_string（元素全是 ptr）。
        // S2.4：port 对象元素（table<Drawable>）LLVM 表示 = ptr（堆打包
        // {data,vtable}）——走 string 桥（参数类型 TK_STR = ptr，类型匹配）；
        // 返回场景（at）由调用处把返回类型标为 K_PORT 本身，避开 S2.1 的
        // TK_STR 补头逻辑（补头会对 port 对象 ptr 做 strlen → 崩溃）。
        var suffix = bridge_suffix(elem)
        var pty = types.named(TK_I64)
        var elem_k = types.kind(elem)
        if elem_k == K_STRUCT || elem_k == K_ENUM || elem_k == K_FN || elem_k == K_TUPLE || elem == types.named(TK_ANY) {
            // P2a/P2b 复合元素：槽类型 = 元素类型 id（llvmgen 映射 %struct.X/%enum.X/
            // %fn.N / {i64,i64}），类型化 store/load 多字元素；esz 由 elem_size 精确计算。
            pty = elem
        } else if types.is_table(elem) || types.is_map(elem) || types.kind(elem) == K_PORT {
            suffix = "string"
            pty = types.named(TK_STR)
        } else {
            var vt = node_types[val]
            if vt >= 0 && (types.is_table(vt) || types.is_map(vt) || vt == types.named(TK_STR) || types.kind(vt) == K_PORT) {
                suffix = "string"
                pty = types.named(TK_STR)
            } else if vt >= 0 && (vt == types.named(TK_F64) || vt == types.named(TK_F32)) {
                suffix = "f64"
                pty = types.named(TK_F64)
            } else if suffix == "string" {
                pty = types.named(TK_STR)
            } else if suffix == "bool" {
                pty = types.named(TK_BOOL)
            }
        }
        if pty == types.named(TK_ANY) {
            // P2b 异构元素装箱：元素值 → any {tag, payload}
            var vt2 = node_types[val]
            if vt2 >= 0 && vt2 != types.named(TK_ANY) {
                var bx = tig_box_any(v, vt2)
                if bx < 0 {
                    return -1
                }
                v = bx
            }
        }
        // r.1.1.4：字面量元素为**别名表值**（变量/下标/字段读，tag≠7/12）→
        // retain——容器元素持引用，深容器 release 时 -1 守恒（否则内层表所有权
        // 只挂在别名变量上：变量先析构 → 容器深释放读悬垂句柄 → 双重释放
        // 0xC0000374）。瞬态值（调用 tag 7 / 表字面量 tag 12）所有权转移给容器
        //（rc 不变）——与 table_push 内建路径同纪律。仅深容器（元素为表）需要；
        // 元素为 any 盒（flat 容器）不 retain（盒本就不由容器释放）。
        if types.is_table(elem) && pty != types.named(TK_ANY) {
            var vte = node_types[val]
            var vte_tag = s_tags[val]
            if vte >= 0 && types.is_table(vte) && vte_tag != 7 && vte_tag != 12 {
                tig_tbl_retain_call(v)
            }
        }
        s21_table_push(t, pty, v)
        i = i + 1
    }
    return t
}

// p.8.2.5 表/数组推导式 `[expr for x in src if cond]` → 新表。
// 发射：新建结果表 → for 源表逐元素循环（cond 块/body 块/step 块/exit 块，
// 模型自 tig_for_table，无 loop_push——本循环非用户循环）。
// body 里：可选 if 条件为假 → 跳过；否则求值元素表达式 → push 进结果表。
// 循环变量以源表元素类型绑定（scope_put/scope_pop），元素表达式经 tig_expr 求值。
// 返回结果表句柄（容器所有权转移给推导式值）。
func tig_comprehension(id: i64) -> i64 {
    var src_n = sstate.child(id, 0)
    var elem_n = sstate.child(id, 1)
    var cond_n = sstate.child(id, 2)
    // p.9.11.16 迭代器协议源：`[e for x in it]`（it 为 struct 实现 has_next/next）
    // → 循环形态 = 方法调用循环（接收者求值一次落槽），其余（筛选/push）复用
    // 表模式逻辑。协议未命中 → 表/范围源（既有路径）。
    var src_ty = node_types[src_n]
    var is_iter: i64 = 0
    var it_ptr: i64 = -1
    if src_ty >= 0 && sinfer.iter_proto_elem(src_ty) >= 0 {
        is_iter = 1
        var ia = ir.new_inst(g_cur_block, 20, src_ty)  // alloca struct 接收者
        ir.add_operand(ia, src_ty, 2)
        it_ptr = ir.get_value(ia)
        var iv0 = tig_expr(src_n)
        if iv0 < 0 {
            return -1
        }
        var st0r = ir.new_inst(g_cur_block, 22, -1)
        ir.add_operand(st0r, src_ty, 2)
        ir.add_operand(st0r, iv0, 0)
        ir.add_operand(st0r, it_ptr, 0)
    }
    // ---- 源表迭代：建循环并确定循环变量元素类型（对齐 tig_for_table）----
    var t: i64 = -1
    if is_iter == 0 {
        t = tig_expr(src_n)
        if t < 0 {
            return -1
        }
    }
    var elem: i64 = types.named(TK_I64)
    var matched: bool = false
    if is_iter == 1 {
        var ie = sinfer.iter_proto_elem(src_ty)
        if ie >= 0 {
            elem = ie
            matched = true
        }
    }
    var bt2 = node_types[src_n]
    if !matched && types.is_table(bt2) {
        var le2 = types.table_elem(bt2)
        if le2 > 0 {
            elem = le2
            matched = true
        }
    }
    if !matched {
        if s_tags[src_n] == 6 {
            var bname = interner.intern(sstate.name_str(src_n))
            var te = sinfer.var_table_elem(bname)
            if te >= 0 {
                elem = te
            }
        }
    }
    // 循环变量 LLVM 槽类型（源元素）
    var suffix = bridge_suffix(elem)
    var elem_llvm_ty = types.named(TK_I64)
    var fk2 = types.kind(elem)
    if fk2 == K_STRUCT || fk2 == K_ENUM || fk2 == K_FN || fk2 == K_TUPLE || elem == types.named(TK_ANY) {
        elem_llvm_ty = elem
    } else if types.is_table(elem) || types.is_map(elem) || types.kind(elem) == K_PORT {
        suffix = "string"
        elem_llvm_ty = elem
    } else if suffix == "string" {
        elem_llvm_ty = types.named(TK_STR)
    } else if suffix == "bool" {
        elem_llvm_ty = types.named(TK_BOOL)
    } else if suffix == "f64" {
        elem_llvm_ty = types.named(TK_F64)
    }
    // ---- 结果表元素类型（推导式结果的权威来源）----
    var res_elem: i64 = types.named(TK_I64)
    var lit_ty2 = node_types[id]
    if types.is_table(lit_ty2) {
        var re = types.table_elem(lit_ty2)
        if re > 0 {
            res_elem = re
        }
    }
    if res_elem == types.named(TK_I64) {
        var vt0 = node_types[elem_n]
        if vt0 >= 0 {
            res_elem = vt0
        }
    }
    var rsize = elem_size(res_elem)
    var rsize_v = tig_int_lit_ty(rsize, types.named(TK_I64))
    var rt = s21_table_new_ty(res_elem, rsize_v)
    // 结果 push 槽类型（对齐 tig_table_lit 的 pty 选择）
    var rsuffix = bridge_suffix(res_elem)
    var pty = types.named(TK_I64)
    var rk = types.kind(res_elem)
    if rk == K_STRUCT || rk == K_ENUM || rk == K_FN || rk == K_TUPLE || res_elem == types.named(TK_ANY) {
        pty = res_elem
    } else if types.is_table(res_elem) || types.is_map(res_elem) || types.kind(res_elem) == K_PORT {
        rsuffix = "string"
        pty = types.named(TK_STR)
    } else if rsuffix == "string" {
        pty = types.named(TK_STR)
    } else if rsuffix == "bool" {
        pty = types.named(TK_BOOL)
    } else if rsuffix == "f64" {
        pty = types.named(TK_F64)
    }
    // ---- 循环四块结构 ----
    var idx_a = ir.new_inst(g_cur_block, 20, types.named(TK_I64))  // alloca i64
    ir.add_operand(idx_a, types.named(TK_I64), 2)
    var idx_ptr = ir.get_value(idx_a)
    var i0 = tig_int_lit_ty(0, types.named(TK_I64))
    var st0 = ir.new_inst(g_cur_block, 22, -1)
    ir.add_operand(st0, types.named(TK_I64), 2)
    ir.add_operand(st0, i0, 0)
    ir.add_operand(st0, idx_ptr, 0)
    var item_a = ir.new_inst(g_cur_block, 20, elem_llvm_ty)
    ir.add_operand(item_a, elem_llvm_ty, 2)
    var item_ptr = ir.get_value(item_a)
    var cond_blk = ir.new_block(g_cur_func, interner.intern("cpr.cond"))
    var body_blk = ir.new_block(g_cur_func, interner.intern("cpr.body"))
    var step_blk = ir.new_block(g_cur_func, interner.intern("cpr.step"))
    var exit_blk = ir.new_block(g_cur_func, interner.intern("cpr.exit"))
    var b0 = ir.new_inst(g_cur_block, 30, -1)
    ir.add_operand(b0, cond_blk, 1)
    // cond: 表模式 cur >= len(t) → exit；迭代器模式 !has_next() → exit
    g_cur_block = cond_blk
    var done_v: i64 = -1
    var cur_v: i64 = -1
    if is_iter == 1 {
        var si_it = types.low(src_ty)
        var sname_it = sstate.struct_name_of(si_it)
        var hnv = tig_iter_call(sname_it + "::has_next", it_ptr, src_ty)
        if hnv < 0 {
            return -1
        }
        done_v = hnv
    } else {
        var cur = ir.new_inst(g_cur_block, 21, types.named(TK_I64))
        ir.add_operand(cur, idx_ptr, 0)
        cur_v = ir.get_value(cur)
        var tlen = s21_table_len(t)
        if tlen < 0 {
            return -1
        }
        var done = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))
        ir.add_operand(done, cur_v, 0)
        ir.add_operand(done, tlen, 0)
        ir.add_operand(done, 5, 2)  // sge
        done_v = ir.get_value(done)
    }
    var cb = ir.new_inst(g_cur_block, 31, -1)
    if is_iter == 1 {
        // 迭代器模式：has_next()=true（还有元素）→ body；false → exit
        ir.add_operand(cb, done_v, 0)
        ir.add_operand(cb, body_blk, 1)
        ir.add_operand(cb, exit_blk, 1)
    } else {
        // 表模式：cur >= len(t)=true（完成）→ exit；否则 body
        ir.add_operand(cb, done_v, 0)
        ir.add_operand(cb, exit_blk, 1)
        ir.add_operand(cb, body_blk, 1)
    }
    // body: 绑定循环变量 → 可选 if 筛选 → 求值元素 → push
    g_cur_block = body_blk
    var iv: i64 = -1
    if is_iter == 1 {
        var si_it2 = types.low(src_ty)
        var sname_it2 = sstate.struct_name_of(si_it2)
        iv = tig_iter_call(sname_it2 + "::next", it_ptr, src_ty)
        if iv < 0 {
            return -1
        }
    } else {
        var ok_slot = ir.new_inst(g_cur_block, 20, types.named(TK_I8))
        ir.add_operand(ok_slot, types.named(TK_I8), 2)
        iv = s21_table_at(t, cur_v, ir.get_value(ok_slot), elem_llvm_ty)
        if iv < 0 {
            return -1
        }
    }
    var ist = ir.new_inst(g_cur_block, 22, -1)
    ir.add_operand(ist, elem_llvm_ty, 2)
    ir.add_operand(ist, iv, 0)
    ir.add_operand(ist, item_ptr, 0)
    scope_put(s_names[id], item_ptr, elem_llvm_ty)
    // 有筛选：cond 为假 → 跳过 push（推 push_blk / skip_blk，最后汇入 step）
    var have_cond = cond_n >= 0
    var push_blk: i64 = -1
    var skip_blk: i64 = -1
    var body_terminated: bool = false
    if have_cond {
        var cv = tig_expr(cond_n)
        if cv < 0 {
            return -1
        }
        push_blk = ir.new_block(g_cur_func, interner.intern("cpr.push"))
        skip_blk = ir.new_block(g_cur_func, interner.intern("cpr.skip"))
        var cbr = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cbr, cv, 0)
        ir.add_operand(cbr, push_blk, 1)
        ir.add_operand(cbr, skip_blk, 1)
        // push 块：求值元素 → push → br step
        g_cur_block = push_blk
        var ev = tig_expr(elem_n)
        if ev < 0 {
            return -1
        }
        var pv = ev
        if pty == types.named(TK_ANY) {
            var vt2 = node_types[elem_n]
            if vt2 >= 0 && vt2 != types.named(TK_ANY) {
                var bx = tig_box_any(ev, vt2)
                if bx < 0 {
                    return -1
                }
                pv = bx
            }
        }
        s21_table_push(rt, pty, pv)
        var pb2 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(pb2, step_blk, 1)
        // skip 块：直接 br step
        g_cur_block = skip_blk
        var sb2 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(sb2, step_blk, 1)
        body_terminated = true
    } else {
        // 无筛选：当前块求值元素 → push → br step
        var ev2 = tig_expr(elem_n)
        if ev2 < 0 {
            return -1
        }
        var pv2 = ev2
        if pty == types.named(TK_ANY) {
            var vt3 = node_types[elem_n]
            if vt3 >= 0 && vt3 != types.named(TK_ANY) {
                var bx2 = tig_box_any(ev2, vt3)
                if bx2 < 0 {
                    return -1
                }
                pv2 = bx2
            }
        }
        s21_table_push(rt, pty, pv2)
        var nb = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(nb, step_blk, 1)
        body_terminated = true
    }
    scope_pop()
    // step: 表模式 cur + 1 → store → br cond；迭代器模式 next 自推进 → 直接 br cond
    g_cur_block = step_blk
    if is_iter == 0 {
        var add1 = ir.new_inst(g_cur_block, 0, types.named(TK_I64))
        ir.add_operand(add1, cur_v, 0)
        ir.add_operand(add1, 1, 2)
        var add_v = ir.get_value(add1)
        var st2 = ir.new_inst(g_cur_block, 22, -1)
        ir.add_operand(st2, types.named(TK_I64), 2)
        ir.add_operand(st2, add_v, 0)
        ir.add_operand(st2, idx_ptr, 0)
    }
    var sb = ir.new_inst(g_cur_block, 30, -1)
    ir.add_operand(sb, cond_blk, 1)
    g_cur_block = exit_blk
    return rt
}

}