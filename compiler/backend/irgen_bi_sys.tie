pub func bi_set_env(nm: string, id: i64) -> i64 {
if nm == "set_env" {
    var e1 = tig_expr(call_arg(id, 0))
    if e1 < 0 {
        return -1
    }
    var e2 = tig_expr(call_arg(id, 1))
    if e2 < 0 {
        return -1
    }
    tig_set_env(e1, e2)
    g_builtin_res = tig_int_lit(0)  // void：哑值
    return 0
}
}

