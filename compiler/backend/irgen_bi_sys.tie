// M4/M6 补齐：系统能力内置（对齐 Rust ir.rs 同名单分支）
// 内置 `eval`（p.9.21.2 两步制①：自 builtin_expr 提取）
pub func bi_eval(nm: string, id: i64) -> i64 {
if nm == "eval" {
    // p.6.4.10：eval 降级——tie:script 解释器未内嵌（完整实现=内嵌解释器，
    // 工作量巨大，留待 p.6.6 后补）。保留签名但语义降级：返回空串，**不置
    // g_used_interp**（不再经 tie_eval_expr Rust 桥，不链 tie_interp.lib）。
    // 原语义（docs/tie-script.md：eval 注册模块顶层定义）在纯 tie 解释器
    // compiler/interp（interp.eval）中已实现；builtin eval/eval_call 仅被
    // examples/script_demo.tie / repl/repl.tie（demo）使用。
    g_builtin_res = tig_str_lit(interner.intern("\"\""))
    return 0
}
}

// M4/M6 补齐：系统能力内置（对齐 Rust ir.rs 同名单分支）
// 内置 `eval_call`（p.9.21.2 两步制①：自 builtin_expr 提取）
pub func bi_eval_call(nm: string, id: i64) -> i64 {
if nm == "eval_call" {
    // p.6.4.10：eval_call 降级——同 eval（tie:script 解释器未内嵌，留待
    // p.6.6 后补）。保留签名但返回空串，**不置 g_used_interp**（去 tie_eval_call
    // Rust 桥，不链 tie_interp.lib）。原语义见 docs/tie-script.md。
    g_builtin_res = tig_str_lit(interner.intern("\"\""))
    return 0
}
}

