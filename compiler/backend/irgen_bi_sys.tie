type tie<class>
// compiler/backend/irgen_bi_sys.tie —— 内置生成器：系统能力（M4/M6）
// ============================================================
// 自 irgen_expr.tie 的 builtin_expr 拆出（p.9.21.2 两步制①）。
// 范式：同 namespace 跨文件（文本内联）——只含函数与注释，
// 顶层全局 var 与 import 树留在 irgen.tie 主文件。
namespace irgen {
// M4/M6 补齐：系统能力内置（对齐 Rust ir.rs 同名单分支）
// 内置 `pow`（p.9.21.2 两步制①：自 builtin_expr 提取）
pub func bi_pow(nm: string, id: i64) -> i64 {
if nm == "pow" {
    var pv1 = tig_expr(call_arg(id, 0))
    if pv1 < 0 {
        return -1
    }
    var pv2 = tig_expr(call_arg(id, 1))
    if pv2 < 0 {
        return -1
    }
    var p1t = node_types[call_arg(id, 0)]
    var p2t = node_types[call_arg(id, 1)]
    var pf1 = tig_to_f64(pv1, p1t)
    var pf2 = tig_to_f64(pv2, p2t)
    if pf1 < 0 || pf2 < 0 {
        return -1
    }
    g_builtin_res = tig_ext_call2("pow", pf1, types.named(TK_F64), pf2, types.named(TK_F64), types.named(TK_F64))
    return 0
}
}

