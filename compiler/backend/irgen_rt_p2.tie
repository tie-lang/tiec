type tie<class>
// compiler/backend/irgen_rt_p2.tie —— irgen_rt 分片 2（p.9.21.3 单文件 ≤800 行）
// ============================================================
// 由 split_parts.py 按行数贪心分片：只搬函数与紧邻注释，
// 顶层全局 var 与 import 树仍留在 irgen_rt.tie。
namespace irgen {
// 批次 8（任务 23）：`cb_ptr(f) -> string`——无捕获闭包/命名函数转 C 回调指针。
// f 须为无捕获闭包字面量（env=null）或命名函数（无 env）；捕获闭包无法作
// C 回调（C 函数指针不携带 env）。生成 thunk `cb_<节点id>`：签名 fn(A...) -> R
//（去掉隐藏 env 参数），体内 call 目标（闭包入口 call clos_<id>(ptr null, A...)；
// 命名函数 call @func(A...)）→ ret。返回 @cb_<节点id> 地址（opcode 63 ptrtoint，
// extern 函数指针参数按 string/ptr 槽消费，llvmgen to_ptr 直引 @sym）。
func tig_cb_ptr(id: i64) -> i64 {
    var fn_node = call_arg(id, 0)
    var fty = node_types[fn_node]
    if fty < 0 || !types.is_fn(fty) {
        sm_err_line = s_lines[fn_node]
        sm_err_col = s_cols[fn_node]
        sm_err_msg = "cb_ptr 参数必须是函数值（fn(A) -> R），函数 " + g_cur_fn_name
        return -1
    }
    var ret_ty = types.fn_ret_ty(fty)
    var nparams = types.fn_nparams_of(fty)
    // 目标符号与调用形态：with_env=1 → 闭包入口（call clos_<id>(null, ...)），
    // with_env=0 → 命名函数（call @func(...)）
    var target: string = ""
    var with_env: i64 = 0
    var tag = s_tags[fn_node]
    if tag == 132 {   // N_FN_LIT 闭包字面量
        // 捕获非空 → 无法作 C 回调（环境无处置）
        var ci = closure_index(fn_node)
        if ci >= 0 {
            var c_end = len(cl_capkeys)
            if ci + 1 < len(cl_capoff) {
                c_end = cl_capoff[ci + 1]
            }
            if c_end - cl_capoff[ci] > 0 {
                sm_err_line = s_lines[fn_node]
                sm_err_col = s_cols[fn_node]
                sm_err_msg = "cb_ptr 参数闭包含捕获变量（C 回调函数指针不携带环境），函数 " + g_cur_fn_name
                return -1
            }
        }
        // 生成闭包入口函数 clos_<id>（cb_ptr 只取地址、不构造闭包值，但入口
        // 须落地，否则 thunk 引用 @clos_<id> 未定义）；返回值（闭包聚合）丢弃
        var gv = tig_closure_lit(fn_node)
        if gv < 0 {
            return -1
        }
        target = "clos_" + to_string(fn_node)
        with_env = 1
    } else if tag == 6 {   // S_N_VAR 命名函数提升（变量名解析为函数）
        var full_nm = resolve_call_name(sstate.name_str(fn_node))
        var fsig = sstate.fn_sig(full_nm)
        if fsig < 0 {
            sm_err_line = s_lines[fn_node]
            sm_err_col = s_cols[fn_node]
            sm_err_msg = "cb_ptr 参数 '" + sstate.name_str(fn_node) + "' 不是命名函数（函数 " + g_cur_fn_name + "）"
            return -1
        }
        target = full_nm
        with_env = 0
    } else {
        sm_err_line = s_lines[fn_node]
        sm_err_col = s_cols[fn_node]
        sm_err_msg = "cb_ptr 参数必须是无捕获闭包字面量或命名函数（函数 " + g_cur_fn_name + "）"
        return -1
    }
    // 生成 thunk：fn(A...) -> R（无 env 参数，匹配 C 回调签名）
    var cb_name = "cb_" + to_string(fn_node)
    var params: table<i64> = table_new_i64()
    var k: i64 = 0
    while k < nparams {
        table_push(params, types.fn_param_of(fty, k))
        k = k + 1
    }
    var saved_func = g_cur_func
    var saved_block = g_cur_block
    var fid = ir.new_func(interner.intern(cb_name), ret_ty, params)
    g_cur_func = fid
    var entry = ir.new_block(fid, interner.intern("entry"))
    g_cur_block = entry
    // call 目标（闭包入口 env=null；命名函数直接传实参）
    var sym = interner.intern(target)
    llvmgen.call_sym_reg(sym)
    var ty35: i64 = -1
    if ret_ty != types.named(TK_VOID) {
        ty35 = ret_ty
    }
    // 注意：所有值产生指令（const_i/load）必须在 call 指令**之前**创建——
    // ir_ops 是全局尾插，子表达式指令的操作数会落到 call 操作数区间中间
    // 覆盖（历史：tig_int_lit 在 add_operand(call) 之间创建，const_i 的操作
    // 数 L+2 覆盖 call 的 opnd2 → env 类型错乱成 i8 13）。
    var env_ld: i64 = -1
    if with_env == 1 {
        // env=null：alloca ptr 槽 + store null（store 经 to_ptr 转 "null"）+
        // load → 真 ptr 值（不能直传 const_i——i64 与 ptr 形参类型不匹配）
        var ea = ir.new_inst(g_cur_block, 20, types.named(TK_STR))  // alloca ptr
        ir.add_operand(ea, types.named(TK_STR), 2)
        var eap = ir.get_value(ea)
        var nullv = tig_int_lit(0)  // const_i 0（store to_ptr → null）
        var stn = ir.new_inst(g_cur_block, 22, -1)  // store ptr null
        ir.add_operand(stn, types.named(TK_STR), 2)
        ir.add_operand(stn, nullv, 0)
        ir.add_operand(stn, eap, 0)
        var ldn = ir.new_inst(g_cur_block, 21, types.named(TK_STR))  // load ptr
        ir.add_operand(ldn, eap, 0)
        env_ld = ir.get_value(ldn)
    }
    var inst = ir.new_inst(g_cur_block, 35, ty35)  // call（子表达式指令已前置）
    ir.add_operand(inst, sym, 0)
    ir.add_operand(inst, ret_ty, 2)
    if with_env == 1 {
        ir.add_operand(inst, types.named(TK_STR), 2)
        ir.add_operand(inst, env_ld, 0)
    }
    k = 0
    while k < nparams {
        var pty = types.fn_param_of(fty, k)
        ir.add_operand(inst, pty, 2)
        ir.add_operand(inst, ir.param_val(fid, k), 0)
        k = k + 1
    }
    // ret（void → ret void；其余 → ret 调用结果）
    if ret_ty == types.named(TK_VOID) {
        var ret = ir.new_inst(g_cur_block, 32, -1)  // ret void
    } else {
        var ret = ir.new_inst(g_cur_block, 32, ret_ty)
        ir.add_operand(ret, ir.get_value(inst), 0)
    }
    // 恢复调用方上下文
    g_cur_func = saved_func
    g_cur_block = saved_block
    // 返回 @cb_<节点id> 地址（string/ptr 槽；extern 参数 to_ptr 直引 @sym）
    g_builtin_res = tig_func_addr(cb_name)
    return 0
}

// `run<Actor>(实参...)` 生成：求值实参（step4 起作初始消息）→ 分配 per-actor
// record（s21_raw_alloc_str，安全堆 + 尾部填充）→ 初始化消息队列头（原子槽
// 零初始化；T2 起队列内嵌 record，不再 ch_open 外部通道）→ 返回句柄（record
// 指针 ptrtoint → i64，K_ACTOR 槽承载）。
func tig_actor_run(id: i64) -> i64 {
    // 实参求值（丢弃；Step4 起作为初始消息/构造入队）
    var rnc = sstate.nchild(id)
    var rk: i64 = 1
    while rk < rnc {
        var rv = tig_expr(sstate.child(id, rk))
        if rv < 0 {
            return -1
        }
        rk = rk + 1
    }
    // 解析 actor 索引（children[0] = actor 类型名节点）
    var aty_node = sstate.child(id, 0)
    var anm = sstate.name_str(aty_node)
    var aidx = sstate.actor_find(anm)
    if aidx < 0 {
        sm_err_msg = "run 的 '" + anm + "' 不是已声明的 actor 类型（函数 " + g_cur_fn_name + "）"
        return -1
    }
    var T64 = types.named(TK_I64)
    // p.9.5.x T2 消息队列固定头（多槽 mailbox + 原子单飞，状态零锁）：
    // @0 magic|@8 保留|@16 保留（pending 废弃）|@24 当前 mid|@32 args[0..8)
    // （8 槽当前消息参）|@96 result|@104 done|@112 dispatch_addr|@120 fail
    // |@128 mq_head（原子，已消费计数）|@136 mq_resv（原子，槽预留计数）
    // |@144 mq_pub（原子，已发布计数）|@152 mq_act（原子，单飞标志 0/1）
    // |@160 mq_sync（原子，同步 RPC 门闩 0/1）|@168 mq_mid[64]|@680 mq_arg[64][8]
    // |@4776 mq_syncf[64]|@5288 字段区起（scollect FIELD_BASE 同步）。
    var FIELD_BASE = 5288
    // record 大小 = 固定头 5288 + 字段区
    var recsz = FIELD_BASE + sstate.actor_field_bytes(aidx)
    var rec = s21_raw_alloc_str(tig_int_lit_ty(recsz, T64))
    if rec < 0 {
        return -1
    }
    // magic @0：写 0xAC70524E（句柄/记录校验）
    var mg = tig_int_lit_ty(0xAC70524E, T64)
    s21_store(rec, mg, T64)
    // 私有状态字段默认值（store tig_default_val 于 rec + foff）
    var fbase = ac_fvoff[aidx]
    var fcnt = ac_fncnt[aidx]
    var fk: i64 = 0
    while fk < fcnt {
        var fty = ac_ftys[fbase + fk]
        var foff = ac_foffs[fbase + fk]
        var dv = tig_default_val(fty)
        s21_store(s21_gep(rec, foff, true), dv, fty)
        fk = fk + 1
    }
    // 消息队列头/固定槽零初始化（run 单线程期普通 store；此后仅原子访问，
    // 先写后线程建立（spawn 经 CreateThread 有 happens-before），无竞态）。
    s21_store(s21_gep(rec, 8, true), tig_int_lit_ty(0, T64), T64)
    s21_store(s21_gep(rec, 16, true), tig_int_lit_ty(0, T64), T64)
    s21_store(s21_gep(rec, 96, true), tig_int_lit_ty(0, T64), T64)
    s21_store(s21_gep(rec, 104, true), tig_int_lit_ty(0, T64), T64)
    s21_store(s21_gep(rec, 112, true), tig_func_addr("actor_disp_" + to_string(aidx)), T64)
    s21_store(s21_gep(rec, 120, true), tig_int_lit_ty(0, T64), T64)
    s21_store(s21_gep(rec, 128, true), tig_int_lit_ty(0, T64), T64)
    s21_store(s21_gep(rec, 136, true), tig_int_lit_ty(0, T64), T64)
    s21_store(s21_gep(rec, 144, true), tig_int_lit_ty(0, T64), T64)
    s21_store(s21_gep(rec, 152, true), tig_int_lit_ty(0, T64), T64)
    s21_store(s21_gep(rec, 160, true), tig_int_lit_ty(0, T64), T64)
    // 简单执行体承载（trm-lite 静态链接）。消息处理 = 池调度任务
    //（gen_actor_task_eager 生成通用 actor_task 单消费者）。零锁：不再初始化
    // OS 锁/条件变量、不再起 1:1 线程、不再 ch_open 外部 mailbox 通道。
    g_used_trmlite = true
    if sstate.fn_def_node("trm_lite_sched::spawn_task") >= 0 {
        sm_err_msg = "actor 与 import trm-lite 冲突：actor 默认由 trm-lite 简单执行体承载，与 import 是替代运行时路径，不能混用（函数 " + g_cur_fn_name + "）"
        return -1
    }
    // 句柄 = ptrtoint record（i64；var-decl 槽类型 K_ACTOR = i64，LLVM 类型匹配）
    var pi = ir.new_inst(g_cur_block, 24, T64)  // ptrtoint → i64
    ir.add_operand(pi, rec, 0)
    return ir.get_value(pi)
}

// 原子读（load atomic i64, ptr, seq_cst）
func s21_atomic_load64(addr: i64) -> i64 {
    var T64 = types.named(TK_I64)
    var ld = ir.new_inst(g_cur_block, 66, T64)  // atomic_load
    ir.add_operand(ld, addr, 0)
    ir.add_operand(ld, 4, 2)  // seq_cst
    return ir.get_value(ld)
}

// 原子写（store atomic i64 %v, ptr, seq_cst）
func s21_atomic_store64(addr: i64, val: i64) {
    var T64 = types.named(TK_I64)
    var st = ir.new_inst(g_cur_block, 67, -1)  // atomic_store
    ir.add_operand(st, T64, 2)  // ① 值类型 IMM
    ir.add_operand(st, addr, 0)  // ② 地址
    ir.add_operand(st, val, 0)  // ③ 值
    ir.add_operand(st, 4, 2)  // ④ order
}

// 原子读改写加（atomicrmw add，返回旧值）
func s21_atomic_fetch_add64(addr: i64, val: i64) -> i64 {
    var T64 = types.named(TK_I64)
    var rmw = ir.new_inst(g_cur_block, 68, T64)  // atomicrmw
    ir.add_operand(rmw, addr, 0)
    ir.add_operand(rmw, val, 0)
    ir.add_operand(rmw, 0, 2)  // op：add
    ir.add_operand(rmw, 4, 2)  // seq_cst
    return ir.get_value(rmw)
}

// 原子比较交换（cmpxchg，返回 i1 成功标志；期望/新值 i64）
func s21_cas64(addr: i64, exp: i64, newv: i64) -> i64 {
    var T64 = types.named(TK_I64)
    var inst = ir.new_inst(g_cur_block, 69, T64)  // cmpxchg
    ir.add_operand(inst, addr, 0)
    ir.add_operand(inst, exp, 0)
    ir.add_operand(inst, newv, 0)
    ir.add_operand(inst, 4, 2)  // succ seq_cst
    ir.add_operand(inst, 4, 2)  // fail seq_cst
    // cmpxchg 结果 {i64, i1}：落内存（tuple {i64,bool}）+ agg_gep 提取成功标志
    var tup = sinfer.tuple2_of(T64, types.named(TK_BOOL))
    var agg = ir.get_value(inst)
    var alloca = ir.new_inst(g_cur_block, 20, tup)
    ir.add_operand(alloca, tup, 2)
    var ap = ir.get_value(alloca)
    var st0 = ir.new_inst(g_cur_block, 22, -1)
    ir.add_operand(st0, tup, 2)
    ir.add_operand(st0, agg, 0)
    ir.add_operand(st0, ap, 0)
    var gp = ir.new_inst(g_cur_block, 27, tup)
    ir.add_operand(gp, ap, 0)
    ir.add_operand(gp, 1, 2)
    var ld = ir.new_inst(g_cur_block, 21, types.named(TK_BOOL))
    ir.add_operand(ld, ir.get_value(gp), 0)
    return ir.get_value(ld)
}

// 同步 RPC 门闩进入（仅同步调用）：等 mq_sync==0 → CAS(0→1) 抢占。
// 保证任一时刻至多一个同步 RPC 在途 → done@104/result@96 归属无歧义。
// async 投递不进门闩（per-message 槽独立，fire-and-forget）。
func tig_mq_sync_enter(rec_ptr: i64) {
    var T64 = types.named(TK_I64)
    var syncp = s21_gep(rec_ptr, 160, true)
    var loop = ir.new_block(g_cur_func, interner.intern("mqs.l"))
    var tryb = ir.new_block(g_cur_func, interner.intern("mqs.t"))
    var wait = ir.new_block(g_cur_func, interner.intern("mqs.w"))
    var done = ir.new_block(g_cur_func, interner.intern("mqs.d"))
    var br0 = ir.new_inst(g_cur_block, 30, -1)  // br loop
    ir.add_operand(br0, loop, 1)
    g_cur_block = loop
    var v = s21_atomic_load64(syncp)
    var z = tig_int_lit_ty(0, T64)
    var is0 = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))  // icmp eq
    ir.add_operand(is0, v, 0)
    ir.add_operand(is0, z, 0)
    ir.add_operand(is0, 0, 2)
    var cb = ir.new_inst(g_cur_block, 31, -1)
    ir.add_operand(cb, ir.get_value(is0), 0)
    ir.add_operand(cb, tryb, 1)
    ir.add_operand(cb, wait, 1)
    // try：CAS(sync, 0, 1)
    g_cur_block = tryb
    var one = tig_int_lit_ty(1, T64)
    var ok = s21_cas64(syncp, z, one)
    var cb2 = ir.new_inst(g_cur_block, 31, -1)
    ir.add_operand(cb2, ok, 0)
    ir.add_operand(cb2, done, 1)
    ir.add_operand(cb2, loop, 1)
    // wait：限时退让后重试
    g_cur_block = wait
    var ats: table<i64> = table_new_i64()
    var avs: table<i64> = table_new_i64()
    table_push(ats, T64)
    table_push(avs, tig_int_lit_ty(1, T64))
    tig_trmlite_call("tl_sync$sleep", ats, avs, -1)
    var bw = ir.new_inst(g_cur_block, 30, -1)  // br loop
    ir.add_operand(bw, loop, 1)
    g_cur_block = done
}

// 消息槽预留（背压）：等 (resv - head) < MQ_CAP（64）→ CAS 条件递增 resv。
// 返回槽号（0..63 = r & 63）。背压等待 = tl_sync$sleep(1) 限时轮询
//（T3 Go 阻塞 send 语义的务实降级：队满阻塞至消费者取走腾位）。
func tig_mq_reserve(rec_ptr: i64) -> i64 {
    var T64 = types.named(TK_I64)
    var headp = s21_gep(rec_ptr, 128, true)
    var resvp = s21_gep(rec_ptr, 136, true)
    var loop = ir.new_block(g_cur_func, interner.intern("mqr.l"))
    var tryb = ir.new_block(g_cur_func, interner.intern("mqr.t"))
    var wait = ir.new_block(g_cur_func, interner.intern("mqr.w"))
    var done = ir.new_block(g_cur_func, interner.intern("mqr.d"))
    var br0 = ir.new_inst(g_cur_block, 30, -1)  // br loop
    ir.add_operand(br0, loop, 1)
    g_cur_block = loop
    var h = s21_atomic_load64(headp)
    var r = s21_atomic_load64(resvp)
    // diff = r - h；有空位 = diff < 64
    var diff = ir.new_inst(g_cur_block, 1, T64)  // sub
    ir.add_operand(diff, r, 0)
    ir.add_operand(diff, h, 0)
    var cap = tig_int_lit_ty(64, T64)
    var has_room = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))  // icmp slt
    ir.add_operand(has_room, ir.get_value(diff), 0)
    ir.add_operand(has_room, cap, 0)
    ir.add_operand(has_room, 2, 2)
    var cbf = ir.new_inst(g_cur_block, 31, -1)
    ir.add_operand(cbf, ir.get_value(has_room), 0)
    ir.add_operand(cbf, tryb, 1)
    ir.add_operand(cbf, wait, 1)
    // try：CAS(resv, r, r+1) 条件预留（防止并发预留越过 head+cap 覆写活跃槽）
    g_cur_block = tryb
    var one = tig_int_lit_ty(1, T64)
    var r1 = ir.new_inst(g_cur_block, 0, T64)  // add r+1
    ir.add_operand(r1, r, 0)
    ir.add_operand(r1, one, 0)
    var ok = s21_cas64(resvp, r, ir.get_value(r1))
    var cb2 = ir.new_inst(g_cur_block, 31, -1)
    ir.add_operand(cb2, ok, 0)
    ir.add_operand(cb2, done, 1)
    ir.add_operand(cb2, loop, 1)
    // wait：队满背压——限时退让（消费者在其它 worker 排空）后重试
    g_cur_block = wait
    var ats: table<i64> = table_new_i64()
    var avs: table<i64> = table_new_i64()
    table_push(ats, T64)
    table_push(avs, tig_int_lit_ty(1, T64))
    tig_trmlite_call("tl_sync$sleep", ats, avs, -1)
    var bw = ir.new_inst(g_cur_block, 30, -1)  // br loop
    ir.add_operand(bw, loop, 1)
    // done：slot = r & 63
    g_cur_block = done
    var c63 = tig_int_lit_ty(63, T64)
    var slot = ir.new_inst(g_cur_block, 6, T64)  // and
    ir.add_operand(slot, r, 0)
    ir.add_operand(slot, c63, 0)
    return ir.get_value(slot)
}

// 消息写入 + 发布 + 单飞激活（发送方公共尾部）：写 mq_mid/mq_arg/mq_syncf →
// atomicrmw 发布 mq_pub → CAS 激活 mq_act(0→1)，成功才 spawn 消费者任务。
// is_sync：1 = 同步 RPC（消费者处理完写 done@104），0 = async。
func tig_mq_publish(rec_ptr: i64, slot: i64, mi: i64, args: table<i64>, is_sync: i64) {
    var T64 = types.named(TK_I64)
    var c8 = tig_int_lit_ty(8, T64)
    var c64 = tig_int_lit_ty(64, T64)
    var c0 = tig_int_lit_ty(0, T64)
    var c1 = tig_int_lit_ty(1, T64)
    var csync = tig_int_lit_ty(is_sync, T64)
    var cmi = tig_int_lit_ty(mi, T64)
    var midp = s21_gep(rec_ptr, 168, true)
    var mid_off = ir.new_inst(g_cur_block, 2, T64)  // mul slot*8
    ir.add_operand(mid_off, slot, 0)
    ir.add_operand(mid_off, c8, 0)
    s21_store(s21_gep(midp, ir.get_value(mid_off), false), cmi, T64)
    // 参数段（8 槽；真实 nargs 写实参，其余写 0——消费者恒拷 8 槽）
    var argp = s21_gep(rec_ptr, 680, true)
    var nargs = len(args)
    var k: i64 = 0
    while k < 8 {
        var c_k8 = tig_int_lit_ty(k * 8, T64)
        var off_v = ir.new_inst(g_cur_block, 2, T64)  // mul slot*64
        ir.add_operand(off_v, slot, 0)
        ir.add_operand(off_v, c64, 0)
        var off_k = ir.new_inst(g_cur_block, 0, T64)  // add +k*8
        ir.add_operand(off_k, ir.get_value(off_v), 0)
        ir.add_operand(off_k, c_k8, 0)
        var v: i64 = c0
        if k < nargs {
            v = args[k]
        }
        s21_store(s21_gep(argp, ir.get_value(off_k), false), v, T64)
        k = k + 1
    }
    // 同步标志槽
    var sfp = s21_gep(rec_ptr, 4776, true)
    var sf_off = ir.new_inst(g_cur_block, 2, T64)  // mul slot*8
    ir.add_operand(sf_off, slot, 0)
    ir.add_operand(sf_off, c8, 0)
    s21_store(s21_gep(sfp, ir.get_value(sf_off), false), csync, T64)
    // 发布：mq_pub += 1（release/seq_cst；此后消费者可见本槽）
    var pubp = s21_gep(rec_ptr, 144, true)
    s21_atomic_fetch_add64(pubp, c1)
    // 单飞激活：CAS(mq_act, 0, 1)；成功 → spawn 消费者任务（actor_task）
    var actp = s21_gep(rec_ptr, 152, true)
    var ok = s21_cas64(actp, c0, c1)
    var b_spawn = ir.new_block(g_cur_func, interner.intern("mqp.s"))
    var b_skip = ir.new_block(g_cur_func, interner.intern("mqp.k"))
    var b_join = ir.new_block(g_cur_func, interner.intern("mqp.j"))
    var cb = ir.new_inst(g_cur_block, 31, -1)
    ir.add_operand(cb, ok, 0)
    ir.add_operand(cb, b_spawn, 1)
    ir.add_operand(cb, b_skip, 1)
    // spawn 分支：actor_task(rec)（通用单消费者；dispatch 地址存 record@112）
    g_cur_block = b_spawn
    var rec_i = ir.new_inst(g_cur_block, 24, T64)  // ptrtoint rec_ptr → i64
    ir.add_operand(rec_i, rec_ptr, 0)
    // task 入口地址：op63 const_global 不能直接作 call 实参（arg_ref 会直引 @sym
    // 致类型错）——落临时 i64 槽（store 路径内联 ptrtoint 常量）再 load。
    var te_a = ir.new_inst(g_cur_block, 20, T64)  // alloca i64
    ir.add_operand(te_a, T64, 2)
    var te_ap = ir.get_value(te_a)
    s21_store(te_ap, tig_func_addr("actor_task"), T64)
    var te_i = s21_load(te_ap, T64)
    var ats: table<i64> = table_new_i64()
    var avs: table<i64> = table_new_i64()
    table_push(ats, T64)
    table_push(avs, te_i)
    table_push(ats, T64)
    table_push(avs, ir.get_value(rec_i))
    table_push(ats, T64)
    table_push(avs, tig_int_lit_ty(0, T64))  // retcode=0（i64）
    tig_trmlite_call("trm_lite_sched$spawn_task", ats, avs, T64)
    // 池启动（闸幂等）：actor 消息任务经 S-pool 常驻线程执行
    tig_s_pool_start()
    var bs = ir.new_inst(g_cur_block, 30, -1)  // br join
    ir.add_operand(bs, b_join, 1)
    g_cur_block = b_skip
    var bk = ir.new_inst(g_cur_block, 30, -1)  // br join
    ir.add_operand(bk, b_join, 1)
    g_cur_block = b_join
}

// actor 消息任务 `actor_task` 生成（fn(ptr rec) -> i64）。**急切生成**：模块
// 生成开始（tig_ast 内、任何用户函数之前）调用一次，避免指令编号交错。
// p.9.5.x T2 单消费者串行：本函数是 per-actor **唯一**消费者任务——单飞标志
// mq_act@152 保证同一 actor 任一时刻至多一个消费者任务在跑 → dispatch 天然串行，
// 状态零锁。循环：队列非空 → 取一条（mq_head@128 游标）→ 拷贝参数到当前消息
// 槽 @32 → 释放槽（head+1 原子）→ setjmp 捕 panic → dispatch → 写 result/fail
// → 同步消息置 done@104 → 继续；队列空 → CAS 清单飞(1→0) → 复查队列，非空则
// CAS 重新激活自己继续、仍空则退出任务。消息每槽独立（T4 async 纯入队不等待）。
func gen_actor_task_eager() {
    if len(ac_keys) == 0 {
        return
    }
    if g_actor_task_gen == 1 {
        return
    }
    g_actor_task_gen = 1
    g_used_trmlite = true  // 任务经 spawn_task/yield 走 trm_lite.a，须链接
    var T64 = types.named(TK_I64)
    var saved_func = g_cur_func
    var saved_block = g_cur_block
    var params: table<i64> = table_new_i64()
    table_push(params, types.named(TK_STR))  // param0 = rec ptr
    var fid = ir.new_func(interner.intern("actor_task"), T64, params)
    g_cur_func = fid
    var entry = ir.new_block(fid, interner.intern("at.entry"))
    g_cur_block = entry
    var recp = ir.param_val(fid, 0)
    var headp = s21_gep(recp, 128, true)
    var pubp = s21_gep(recp, 144, true)
    var actp = s21_gep(recp, 152, true)
    var resp = s21_gep(recp, 96, true)
    var donep = s21_gep(recp, 104, true)
    var failp = s21_gep(recp, 120, true)
    var dispp = s21_gep(recp, 112, true)
    var midp24 = s21_gep(recp, 24, true)
    var mq_midp = s21_gep(recp, 168, true)
    var mq_argp = s21_gep(recp, 680, true)
    var mq_syncfp = s21_gep(recp, 4776, true)
    llvmgen.catch_enable()
    var loop = ir.new_block(fid, interner.intern("at.loop"))
    var flagb = ir.new_block(fid, interner.intern("at.flag"))
    var procb = ir.new_block(fid, interner.intern("at.proc"))
    var exitb = ir.new_block(fid, interner.intern("at.exit"))
    var z64 = tig_int_lit_ty(0, T64)
    var o64 = tig_int_lit_ty(1, T64)
    var br0 = ir.new_inst(g_cur_block, 30, -1)  // br loop
    ir.add_operand(br0, loop, 1)
    // loop：h = load(head); p = load(pub); 空 = (h == p)
    g_cur_block = loop
    var h = s21_atomic_load64(headp)
    var p = s21_atomic_load64(pubp)
    var empty = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))  // icmp eq
    ir.add_operand(empty, h, 0)
    ir.add_operand(empty, p, 0)
    ir.add_operand(empty, 0, 2)
    var cbl = ir.new_inst(g_cur_block, 31, -1)
    ir.add_operand(cbl, ir.get_value(empty), 0)
    ir.add_operand(cbl, flagb, 1)
    ir.add_operand(cbl, procb, 1)
    // flag：队列空 → CAS 清单飞(1→0) → 复查 pub；仍空 → 退出；非空 → 重新激活
    g_cur_block = flagb
    var okclr = s21_cas64(actp, o64, z64)
    var p2 = s21_atomic_load64(pubp)
    var empty2 = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))  // icmp eq
    ir.add_operand(empty2, h, 0)
    ir.add_operand(empty2, p2, 0)
    ir.add_operand(empty2, 0, 2)
    var reactb = ir.new_block(fid, interner.intern("at.react"))
    var cbf = ir.new_inst(g_cur_block, 31, -1)
    ir.add_operand(cbf, ir.get_value(empty2), 0)
    ir.add_operand(cbf, exitb, 1)
    ir.add_operand(cbf, reactb, 1)
    // react：重新激活 CAS(0→1)；成功 → 继续取；失败（他人已激活）→ 退出
    g_cur_block = reactb
    var okre = s21_cas64(actp, z64, o64)
    var cbr = ir.new_inst(g_cur_block, 31, -1)
    ir.add_operand(cbr, okre, 0)
    ir.add_operand(cbr, loop, 1)
    ir.add_operand(cbr, exitb, 1)
    // proc：取一条消息（h 槽；参数已发布可见）
    g_cur_block = procb
    var c8b = tig_int_lit_ty(8, T64)
    var c64b = tig_int_lit_ty(64, T64)
    var c63b = tig_int_lit_ty(63, T64)
    var slot = ir.new_inst(g_cur_block, 6, T64)  // and h&63
    ir.add_operand(slot, h, 0)
    ir.add_operand(slot, c63b, 0)
    var slotv = ir.get_value(slot)
    var mid_off = ir.new_inst(g_cur_block, 2, T64)  // mul slot*8
    ir.add_operand(mid_off, slotv, 0)
    ir.add_operand(mid_off, c8b, 0)
    var midv = s21_load(s21_gep(mq_midp, ir.get_value(mid_off), false), T64)
    var sfv = s21_load(s21_gep(mq_syncfp, ir.get_value(mid_off), false), T64)
    // 拷贝参数段 mq_arg[slot][0..7] → 当前消息槽 rec@32+k*8（dispatch 读此）
    var ak: i64 = 0
    while ak < 8 {
        var c_k8b = tig_int_lit_ty(ak * 8, T64)
        var off_v = ir.new_inst(g_cur_block, 2, T64)  // mul slot*64
        ir.add_operand(off_v, slotv, 0)
        ir.add_operand(off_v, c64b, 0)
        var off_k = ir.new_inst(g_cur_block, 0, T64)  // add +k*8
        ir.add_operand(off_k, ir.get_value(off_v), 0)
        ir.add_operand(off_k, c_k8b, 0)
        var av = s21_load(s21_gep(mq_argp, ir.get_value(off_k), false), T64)
        s21_store(s21_gep(recp, 32 + ak * 8, true), av, T64)
        ak = ak + 1
    }
    // 释放槽：mq_head = h+1（原子；参数已拷出，dispatch 不再读队列槽）
    var h1 = ir.new_inst(g_cur_block, 0, T64)  // add h+1
    ir.add_operand(h1, h, 0)
    ir.add_operand(h1, o64, 0)
    s21_atomic_store64(headp, ir.get_value(h1))
    s21_store(midp24, midv, T64)  // 当前 mid（观测）
    // setjmp 捕获点（handler panic → longjmp 回此返回 1；mid/slot/syncf 定义在
    // setjmp 之前，longjmp 返回后仍有效，wcap 可直接收尾）
    var fa2 = ir.new_inst(g_cur_block, 36, types.ptr_of(types.named(TK_I8)))  // frameaddress
    ir.add_operand(fa2, interner.intern("llvm.frameaddress.p0"), 0)
    ir.add_operand(fa2, types.ptr_of(types.named(TK_I8)), 2)
    ir.add_operand(fa2, types.named(TK_I32), 2)
    ir.add_operand(fa2, 0, 2)
    var fa_v = ir.get_value(fa2)
    var jb_id = interner.intern("@tie_panic_jb")
    var sj = ir.new_inst(g_cur_block, 36, types.named(TK_I32))  // _setjmp
    ir.add_operand(sj, interner.intern("_setjmp"), 0)
    ir.add_operand(sj, types.named(TK_I32), 2)
    ir.add_operand(sj, types.named(TK_STR), 2)
    ir.add_operand(sj, jb_id, 3)
    ir.add_operand(sj, types.named(TK_STR), 2)
    ir.add_operand(sj, fa_v, 0)
    var sj_v = ir.get_value(sj)
    var z32 = tig_int_lit_ty(0, types.named(TK_I32))
    var is0 = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))  // icmp eq
    ir.add_operand(is0, sj_v, 0)
    ir.add_operand(is0, z32, 0)
    ir.add_operand(is0, 0, 2)
    var wok = ir.new_block(fid, interner.intern("at.wok"))
    var wcap = ir.new_block(fid, interner.intern("at.wcap"))
    var cbr2 = ir.new_inst(g_cur_block, 31, -1)
    ir.add_operand(cbr2, ir.get_value(is0), 0)
    ir.add_operand(cbr2, wok, 1)
    ir.add_operand(cbr2, wcap, 1)
    // wok：active=1 → 间接调 dispatch(rec, mid) → active=0 → result/fail →
    // 同步消息置 done → loop
    var act_id = interner.intern("@tie_panic_active")
    g_cur_block = wok
    var trA = tig_bool_lit(1)
    var stA1 = ir.new_inst(g_cur_block, 22, -1)
    ir.add_operand(stA1, types.named(TK_BOOL), 2)
    ir.add_operand(stA1, trA, 0)
    ir.add_operand(stA1, act_id, 3)
    var disp = s21_load(dispp, T64)
    var fp = ir.new_inst(g_cur_block, 25, types.named(TK_STR))  // inttoptr
    ir.add_operand(fp, disp, 0)
    var fpv = ir.get_value(fp)
    var ci = ir.new_inst(g_cur_block, 70, T64)  // call_indirect
    ir.add_operand(ci, fpv, 0)
    ir.add_operand(ci, T64, 2)
    ir.add_operand(ci, recp, 0)
    ir.add_operand(ci, T64, 2)
    ir.add_operand(ci, midv, 0)
    var res = ir.get_value(ci)
    var fA0 = tig_bool_lit(0)
    var stA2 = ir.new_inst(g_cur_block, 22, -1)  // active=0
    ir.add_operand(stA2, types.named(TK_BOOL), 2)
    ir.add_operand(stA2, fA0, 0)
    ir.add_operand(stA2, act_id, 3)
    s21_store(resp, res, T64)
    s21_store(failp, z64, T64)
    // if syncf != 0: done@104 = 1
    var is_sync = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))  // icmp ne
    ir.add_operand(is_sync, sfv, 0)
    ir.add_operand(is_sync, z64, 0)
    ir.add_operand(is_sync, 1, 2)
    var b_done = ir.new_block(fid, interner.intern("at.done"))
    var b_skip = ir.new_block(fid, interner.intern("at.skp"))
    var b_join = ir.new_block(fid, interner.intern("at.jn"))
    var cbd = ir.new_inst(g_cur_block, 31, -1)
    ir.add_operand(cbd, ir.get_value(is_sync), 0)
    ir.add_operand(cbd, b_done, 1)
    ir.add_operand(cbd, b_skip, 1)
    g_cur_block = b_done
    s21_store(donep, o64, T64)
    var bdj = ir.new_inst(g_cur_block, 30, -1)  // br join
    ir.add_operand(bdj, b_join, 1)
    g_cur_block = b_skip
    var bsk = ir.new_inst(g_cur_block, 30, -1)  // br join
    ir.add_operand(bsk, b_join, 1)
    g_cur_block = b_join
    var bj = ir.new_inst(g_cur_block, 30, -1)  // br loop
    ir.add_operand(bj, loop, 1)
    // wcap：panic（longjmp 回）→ active=0 → result=0/fail=1 → 同步置 done → loop
    g_cur_block = wcap
    var fA1 = tig_bool_lit(0)
    var stA3 = ir.new_inst(g_cur_block, 22, -1)  // active=0
    ir.add_operand(stA3, types.named(TK_BOOL), 2)
    ir.add_operand(stA3, fA1, 0)
    ir.add_operand(stA3, act_id, 3)
    s21_store(resp, z64, T64)
    s21_store(failp, o64, T64)
    var is_sync2 = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))  // icmp ne
    ir.add_operand(is_sync2, sfv, 0)
    ir.add_operand(is_sync2, z64, 0)
    ir.add_operand(is_sync2, 1, 2)
    var b_done2 = ir.new_block(fid, interner.intern("at.dn2"))
    var b_skip2 = ir.new_block(fid, interner.intern("at.sk2"))
    var b_join2 = ir.new_block(fid, interner.intern("at.jn2"))
    var cbd2 = ir.new_inst(g_cur_block, 31, -1)
    ir.add_operand(cbd2, ir.get_value(is_sync2), 0)
    ir.add_operand(cbd2, b_done2, 1)
    ir.add_operand(cbd2, b_skip2, 1)
    g_cur_block = b_done2
    s21_store(donep, o64, T64)
    var bd2 = ir.new_inst(g_cur_block, 30, -1)  // br join2
    ir.add_operand(bd2, b_join2, 1)
    g_cur_block = b_skip2
    var bs2 = ir.new_inst(g_cur_block, 30, -1)  // br join2
    ir.add_operand(bs2, b_join2, 1)
    g_cur_block = b_join2
    var bj2 = ir.new_inst(g_cur_block, 30, -1)  // br loop
    ir.add_operand(bj2, loop, 1)
    // exit：ret 0
    g_cur_block = exitb
    var zret = tig_int_lit_ty(0, T64)
    var ret = ir.new_inst(g_cur_block, 32, T64)  // ret i64 0
    ir.add_operand(ret, zret, 0)
    g_cur_func = saved_func
    g_cur_block = saved_block
}

// 取 actor 节点的第 mi 个方法 FnDef 节点（children 中按 N_FN_DEF 声明序；字段在前）
func actor_method_node(anode: i64, mi: i64) -> i64 {
    var nc = sstate.nchild(anode)
    var mcount: i64 = 0
    var k2: i64 = 0
    while k2 < nc {
        var c = sstate.child(anode, k2)
        if s_tags[c] == S_N_FN_DEF {
            if mcount == mi {
                return c
            }
            mcount = mcount + 1
        }
        k2 = k2 + 1
    }
    return -1
}

}