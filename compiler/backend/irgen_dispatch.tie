type tie<class>
// compiler/backend/irgen_dispatch.tie —— 生成器 L3：内置表达式调度器（builtin_expr，p.9.21.2 两步制①产物）
// ============================================================
// 自 irgen_expr.tie 按域拆出（p.9.21.2/3：单文件 ≤800 行）。
// 范式：同 namespace 跨文件（文本内联）——只含函数与注释，
// 顶层全局 var 与 import 树留在 irgen.tie 主文件。
namespace irgen {
// 内置表达式调用分派：返回 0 已处理（g_builtin_res 携带结果值 id）；-1 失败
// （名字已由 is_builtin_name 判定命中——本函数内 -1 一律为真失败，调用方传播）。
func builtin_expr(nm: string, id: i64) -> i64 {
// ---------- S1.2 unsafe 指针/内存内置 ----------
// 全部要求 unsafe 上下文（语义层 infer 已拦截安全代码调用）。
// ---------- S1.2 unsafe 指针/内存内置 ----------
if nm == "addr_of" { return bi_addr_of(nm, id) }
if nm == "addr_of_field" { return bi_addr_of_field(nm, id) }
if nm == "deref" { return bi_deref(nm, id) }
if nm == "deref_write" { return bi_deref_write(nm, id) }
if nm == "volatile_load" { return bi_volatile_load(nm, id) }
if nm == "volatile_store" { return bi_volatile_store(nm, id) }
if nm == "is_null" { return bi_is_null(nm, id) }
if nm == "ptr_add" { return bi_ptr_add(nm, id) }
if nm == "ptr_to_int" { return bi_ptr_to_int(nm, id) }
if nm == "int_to_ptr" { return bi_int_to_ptr(nm, id) }
if nm == "alloc" { return bi_alloc(nm, id) }
if nm == "free" { return bi_free(nm, id) }
if nm == "memcpy" { return bi_memcpy(nm, id) }
if nm == "memset" { return bi_memset(nm, id) }
if nm == "slice_of" { return bi_slice_of(nm, id) }
if nm == "slice_len" { return bi_slice_len(nm, id) }
if nm == "slice_index" { return bi_slice_index(nm, id) }
// ---------- S1.3 as_* 显式数值转换族 ----------
// as_i8/as_i16/as_i32/as_i64/as_u8/as_u16/as_u32/as_u64/as_f32/as_f64：
// 任意数字 → 目标类型（数值转换：截断/饱和由 LLVM 指令映射——trunc/sext/
// zext/fptosi/sitofp/fpext/fptrunc）。语义层已校验参数为数字。
var as_dst: i64 = -1
// ---------- S1.3 as_* 显式数值转换族 ----------
// ---------- S1.3 as_* 显式数值转换族 ----------
// as_i8/as_i16/as_i32/as_i64/as_u8/as_u16/as_u32/as_u64/as_f32/as_f64：
// 任意数字 → 目标类型（数值转换：截断/饱和由 LLVM 指令映射——trunc/sext/
// zext/fptosi/sitofp/fpext/fptrunc）。语义层已校验参数为数字。
var as_dst: i64 = -1
if nm == "as_i8" {
    as_dst = types.named(TK_I8)
} else if nm == "as_i16" {
    as_dst = types.named(TK_I16)
} else if nm == "as_i32" {
    as_dst = types.named(TK_I32)
} else if nm == "as_i64" {
    as_dst = types.named(TK_I64)
} else if nm == "as_u8" {
    as_dst = types.named(TK_U8)
} else if nm == "as_u16" {
    as_dst = types.named(TK_U16)
} else if nm == "as_u32" {
    as_dst = types.named(TK_U32)
} else if nm == "as_u64" {
    as_dst = types.named(TK_U64)
} else if nm == "as_f32" {
    as_dst = types.named(TK_F32)
} else if nm == "as_f64" {
    as_dst = types.named(TK_F64)
} else if nm == "as_i128" {
    as_dst = types.named(TK_I128)
} else if nm == "as_u128" {
    as_dst = types.named(TK_U128)
}
if as_dst >= 0 {
    var av = tig_expr(call_arg(id, 0))
    if av < 0 {
        return -1
    }
    var at = node_types[call_arg(id, 0)]
    // P2b：as_i64/as_f64 重载——参数是 any → 拆箱（运行时 tag 检查，
    // 不匹配 → 运行时错误）；数字 → 下方数值转换
    if at == types.named(TK_ANY) {
        var ux = tig_unbox_any(av, as_dst, nm)
        if ux < 0 {
            return -1
        }
        g_builtin_res = ux
        return 0
    }
    if at >= 0 && at != as_dst && (types.is_int(at) || types.is_float(at)) {
        var cv = tig_coerce(av, at, as_dst)
        if cv < 0 {
            return -1
        }
        g_builtin_res = cv
    } else {
        g_builtin_res = av
    }
    return 0
}
// ---------- S1.3 checked_* 溢出检测族 ----------
if nm == "checked_add" || nm == "checked_sub" || nm == "checked_mul" ||
    nm == "checked_div" || nm == "checked_shl" || nm == "checked_shr" ||
    nm == "checked_neg" {
    var cv2 = tig_checked(nm, id)
    if cv2 < 0 {
        return -1
    }
    g_builtin_res = cv2
    return 0
}
// ---------- S1.3 checked_* 溢出检测族 ----------
if nm == "exec_code" { return bi_exec_code(nm, id) }
if nm == "time_now" { return bi_time_now(nm, id) }
if nm == "get_env" { return bi_get_env(nm, id) }
if nm == "exec_output" { return bi_exec_output(nm, id) }
if nm == "str_len" { return bi_str_len(nm, id) }
if nm == "char_code" { return bi_char_code(nm, id) }
if nm == "str_char" { return bi_str_char(nm, id) }
if nm == "str_from_code" { return bi_str_from_code(nm, id) }
// ---------- S2.1 字符串 {ptr,len} 原语 ----------
// 二进制安全字节访问 / UTF-8 码点解码 / StringBuilder（实现见文件尾 s21_* 组）。
// ---------- S2.1 字符串 {ptr,len} 原语 ----------
if nm == "str_byte" { return bi_str_byte(nm, id) }
if nm == "utf8_seq_len" { return bi_utf8_seq_len(nm, id) }
if nm == "utf8_char_at" { return bi_utf8_char_at(nm, id) }
// SSO 短串池回退 malloc 累计次数（dev33 批次3 验收探针用：断言 = 0）
if nm == "sso_malloc_count" { return bi_sso_malloc_count(nm, id) }
// 可捕获 panic（dev33 批次7 任务18）：catch_panic(f) -> bool
if nm == "catch_panic" { return bi_catch_panic(nm, id) }
// 闭包 → C 回调函数指针（dev33 批次8 任务23）：cb_ptr(f) -> string
if nm == "cb_ptr" { return bi_cb_ptr(nm, id) }
if nm == "string_builder" { return bi_string_builder(nm, id) }
if nm == "sb_append" { return bi_sb_append(nm, id) }
if nm == "sb_append_byte" { return bi_sb_append_byte(nm, id) }
if nm == "sb_build" { return bi_sb_build(nm, id) }
if nm == "sb_reset" { return bi_sb_reset(nm, id) }
if nm == "str_sub_bytes" { return bi_str_sub_bytes(nm, id) }
// ---------- 网络原语（P0：std/net）----------
// 参数签名：i=整数（窄整数 sext 到 i64）、s=字符串（ptr 直传）；桥符号 tie_<name>；
// net_close 返回 i8→bool（icmp ne），两个 recv 返回堆串（tig_stmt 统一 free），其余 i64。
if nm == "net_close" || nm == "net_tcp_accept" || nm == "net_tcp_connect" ||
    nm == "net_tcp_listen" || nm == "net_tcp_recv" || nm == "net_tcp_send" ||
    nm == "net_udp_bind" || nm == "net_udp_recv" || nm == "net_udp_send" ||
    nm == "net_tcp_recv_bytes" || nm == "net_tcp_send_bytes" ||
    nm == "net_udp_recv_bytes" || nm == "net_udp_send_bytes" {
    // p.6.4.5：net_* 全部内联 Winsock2 直调（去 Rust 桥 tie_net_*）。
    // 置位 g_used_wsock → driver 链 ws2_32（详见 tig_net_* helper）。
    // r.1.6.4：Linux 目标走 POSIX socket 直调（g_asm_target 含 "linux"，
    // 见 tig_is_linux），不置位——ws2_32 只在 Windows 链接分支消费。
    if tig_is_linux() {
        var lnet_wsock: i64 = 0  // Linux net 直调：零 wsock 标记
    } else {
        g_used_wsock = true
    }
    if nm == "net_close" {
        // 单参句柄 → closesocket（0=成功）→ bool
        var h = tig_expr(call_arg(id, 0))
        if h < 0 {
            return -1
        }
        var ht = node_types[call_arg(id, 0)]
        if ht != types.named(TK_I64) && ht != types.named(TK_U64) && ht >= 0 {
            var sh = tig_sext(h, ht, types.named(TK_I64))
            if sh < 0 {
                return -1
            }
            h = sh
        }
        g_builtin_res = tig_net_close(h)
        return 0
    }
    // 通用参值提取：i 整数（窄 sext→i64）、s 串/表（ptr 直传）
    var pat: table<string> = table_new_string()
    if nm == "net_udp_send" || nm == "net_udp_send_bytes" {
        table_push(pat, "i")
        table_push(pat, "s")
        table_push(pat, "i")
        table_push(pat, "s")
    } else if nm == "net_tcp_connect" {
        table_push(pat, "s")
        table_push(pat, "i")
    } else if nm == "net_tcp_send" || nm == "net_tcp_send_bytes" {
        table_push(pat, "i")
        table_push(pat, "s")
    } else if nm == "net_tcp_recv" || nm == "net_udp_recv" ||
        nm == "net_tcp_recv_bytes" || nm == "net_udp_recv_bytes" {
        table_push(pat, "i")
        table_push(pat, "i")
    } else {
        // listen/accept/udp_bind：单 i 参（句柄/端口）
        table_push(pat, "i")
    }
    var avs: table<i64> = table_new_i64()
    var k: i64 = 0
    while k < len(pat) {
        var a = call_arg(id, k)
        var v = tig_expr(a)
        if v < 0 {
            return -1
        }
        if pat[k] == "i" {
            var vt = node_types[a]
            if vt != types.named(TK_I64) && vt != types.named(TK_U64) && vt >= 0 {
                var sv = tig_sext(v, vt, types.named(TK_I64))
                if sv < 0 {
                    return -1
                }
                v = sv
            }
        }
        table_push(avs, v)
        k = k + 1
    }
    // 按原语分派内联实现
    if nm == "net_tcp_listen" {
        g_builtin_res = tig_net_tcp_listen(avs[0])
    } else if nm == "net_tcp_accept" {
        g_builtin_res = tig_net_tcp_accept(avs[0])
    } else if nm == "net_tcp_connect" {
        g_builtin_res = tig_net_tcp_connect(avs[0], avs[1])
    } else if nm == "net_tcp_send" {
        g_builtin_res = tig_net_tcp_send(avs[0], avs[1])
    } else if nm == "net_tcp_recv" {
        g_builtin_res = tig_net_tcp_recv(avs[0], avs[1])
    } else if nm == "net_tcp_send_bytes" {
        g_builtin_res = tig_net_tcp_send_bytes(avs[0], avs[1])
    } else if nm == "net_tcp_recv_bytes" {
        g_builtin_res = tig_net_tcp_recv_bytes(avs[0], avs[1])
    } else if nm == "net_udp_bind" {
        g_builtin_res = tig_net_udp_bind(avs[0])
    } else if nm == "net_udp_send" {
        g_builtin_res = tig_net_udp_send(avs[0], avs[1], avs[2], avs[3])
    } else if nm == "net_udp_recv" {
        g_builtin_res = tig_net_udp_recv(avs[0], avs[1])
    } else if nm == "net_udp_send_bytes" {
        g_builtin_res = tig_net_udp_send_bytes(avs[0], avs[1], avs[2], avs[3])
    } else if nm == "net_udp_recv_bytes" {
        g_builtin_res = tig_net_udp_recv_bytes(avs[0], avs[1])
    } else {
        g_builtin_res = tig_net_close(avs[0])
    }
    return 0
}
// ---------- 动态加载原语（p.6.6.20 std/sqlite：winsqlite3.dll C ABI 桥）----------
// load_library(name) -> i64：宽名缓冲 + LoadLibraryW（kernel32；失败 0）。
// get_proc(handle, name) -> i64：GetProcAddress（kernel32；失败 0）。
// dyn_call / dyn_call_p（addr + 5×i64 实参）-> i64：op73 动态 C 调用
// （字符串实参按 TK_STR 原样传 ptr = const char*；整数传 i64；可空指针传 0）。
// cstr_to_string(addr) -> string：NUL 结尾 C 字符串 → tie 字符串。
// ---------- 动态加载原语（p.6.6.20 std/sqlite：winsqlite3.dll C ABI 桥） ----------
if nm == "load_library" { return bi_load_library(nm, id) }
if nm == "get_proc" { return bi_get_proc(nm, id) }
if nm == "dyn_call" || nm == "dyn_call_p" {
    var T64 = types.named(TK_I64)
    var retmode: i64 = 0
    if nm == "dyn_call_p" {
        retmode = 1
    }
    // 先求值全部 6 个实参（避免 add_operand 段交错：常量/求值必须发生在
    // 一切 new_inst+add_operand 序列之前）
    var avs: table<i64> = table_new_i64()
    var atys: table<i64> = table_new_i64()
    var k: i64 = 0
    while k < 6 {
        var anode = call_arg(id, k)
        var av = tig_expr(anode)
        if av < 0 {
            return -1
        }
        var at = node_types[anode]
        if at == types.named(TK_STR) {
            // 字符串实参：按 TK_STR 传（llvmgen 渲染 ptr <ref> = const char*），
            // 零拷贝直传 tie 字符串数据指针（{ptr,len} 布局 + 尾 NUL 兼容 C）
            table_push(atys, at)
            table_push(avs, av)
        } else {
            if at != T64 && at != types.named(TK_U64) && at >= 0 {
                var sa = tig_sext(av, at, T64)
                if sa < 0 {
                    return -1
                }
                av = sa
            }
            table_push(atys, T64)
            table_push(avs, av)
        }
        k = k + 1
    }
    // addr（实参 0）inttoptr → ptr（op73 entry 值）
    var fp = ir.new_inst(g_cur_block, 25, T64)
    ir.add_operand(fp, avs[0], 0)
    var fpv = ir.get_value(fp)
    var inst = ir.new_inst(g_cur_block, 73, T64)
    ir.add_operand(inst, fpv, 0)
    ir.add_operand(inst, retmode, 2)
    var k2: i64 = 1
    while k2 < 6 {
        ir.add_operand(inst, atys[k2], 2)
        ir.add_operand(inst, avs[k2], 0)
        k2 = k2 + 1
    }
    g_builtin_res = ir.get_value(inst)
    return 0
}
if nm == "cstr_to_string" { return bi_cstr_to_string(nm, id) }
if nm == "to_string" { return bi_to_string(nm, id) }
if nm == "parse_int" { return bi_parse_int(nm, id) }
if nm == "parse_float" { return bi_parse_float(nm, id) }
if nm == "parse_trit" { return bi_parse_trit(nm, id) }
if nm == "to_trit" { return bi_to_trit(nm, id) }
if nm == "trit_val" { return bi_trit_val(nm, id) }
if nm == "len" { return bi_len(nm, id) }
// P2b：any 拆箱（as_bool/as_string/as_char——仅 any 参数；as_i64/as_f64
// 已在上方 as_dst 块重载处理）。P2d：as_table_* 拆箱为对应元素类型表
//（返回表值 ptr，tag = 精确表类型 id，与装箱时的 tag 一致才匹配）。
if nm == "as_bool" || nm == "as_string" || nm == "as_char" ||
    nm == "as_table_i64" || nm == "as_table_string" || nm == "as_table_bool" ||
    nm == "as_table_f64" || nm == "as_table_char" || nm == "as_table_any" {
    var a0 = call_arg(id, 0)
    var av = tig_expr(a0)
    if av < 0 {
        return -1
    }
    var rty: i64 = types.named(TK_I64)
    if nm == "as_f64" {
        rty = types.named(TK_F64)
    } else if nm == "as_bool" {
        rty = types.named(TK_BOOL)
    } else if nm == "as_string" {
        rty = types.named(TK_STR)
    } else if nm == "as_char" {
        rty = types.named(TK_CHAR)
    } else if nm == "as_table_i64" {
        rty = types.table_of(types.named(TK_I64))
    } else if nm == "as_table_string" {
        rty = types.table_of(types.named(TK_STR))
    } else if nm == "as_table_bool" {
        rty = types.table_of(types.named(TK_BOOL))
    } else if nm == "as_table_f64" {
        rty = types.table_of(types.named(TK_F64))
    } else if nm == "as_table_char" {
        rty = types.table_of(types.named(TK_CHAR))
    } else if nm == "as_table_any" {
        rty = types.table_of(types.named(TK_ANY))
    }
    var ux = tig_unbox_any(av, rty, nm)
    if ux < 0 {
        return -1
    }
    g_builtin_res = ux
    return 0
}
// P2c：any_tag(x) → 读 {tag,payload} 的 tag 字段（标量 0-4 / 复合类型 id）
if nm == "any_tag" { return bi_any_tag(nm, id) }
// P2d-D3：map 高阶——map_keys(m)→table<string>；map_values(m)→table<V>
//（V 从实参 map<string,V> 类型解码）；map_contains(m, key)→bool（不 raise）
if nm == "map_keys" || nm == "map_values" {
    var m0 = call_arg(id, 0)
    var mv = tig_expr(m0)
    if mv < 0 {
        return -1
    }
    var m_vty: i64 = types.named(TK_I64)
    if nm == "map_values" {
        var m_arg_ty = node_types[m0]
        if types.is_map(m_arg_ty) {
            var lv = types.low(m_arg_ty)
            if lv > 0 {
                m_vty = lv
            }
        }
    }
    g_builtin_res = s21_map_extract(mv, m_vty, nm == "map_keys")
    return 0
}
if nm == "map_contains" { return bi_map_contains(nm, id) }
if nm == "table_new_i64" || nm == "table_new_f64" || nm == "table_new_string" || nm == "table_new_bool" {
    var elem: i64 = types.named(TK_I64)
    if nm == "table_new_string" {
        elem = types.named(TK_STR)
    } else if nm == "table_new_bool" {
        elem = types.named(TK_BOOL)
    } else if nm == "table_new_f64" {
        elem = types.named(TK_F64)
    }
    var esz_v = tig_int_lit_ty(elem_size(elem), types.named(TK_I64))
    g_builtin_res = s21_table_new(esz_v)
    return 0
}
if nm == "table_push" { return bi_table_push(nm, id) }
if nm == "exit" { return bi_exit(nm, id) }
if nm == "arg_count" { return bi_arg_count(nm, id) }
if nm == "arg_string" { return bi_arg_string(nm, id) }
if nm == "file_read" { return bi_file_read(nm, id) }
if nm == "file_write" || nm == "file_append" {
    var p = tig_expr(call_arg(id, 0))
    if p < 0 {
        return -1
    }
    var c = tig_expr(call_arg(id, 1))
    if c < 0 {
        return -1
    }
    g_builtin_res = tig_write_file(p, c, nm == "file_append")
    return 0
}
if nm == "file_size" { return bi_file_size(nm, id) }
if nm == "file_is_dir" || nm == "file_is_file" {
    var p = tig_expr(call_arg(id, 0))
    if p < 0 {
        return -1
    }
    if nm == "file_is_dir" {
        g_builtin_res = tig_is_dir_inline(p)
    } else {
        g_builtin_res = tig_is_file_inline(p)
    }
    return 0
}
if nm == "file_exists" { return bi_file_exists(nm, id) }
if nm == "file_delete" { return bi_file_delete(nm, id) }
if nm == "print_err" { return bi_print_err(nm, id) }
if nm == "mkdir_all" { return bi_mkdir_all(nm, id) }
if nm == "regex_find_all" { return bi_regex_find_all(nm, id) }
// ---------- M4/M6 补齐：系统能力内置（对齐 Rust ir.rs 同名单分支）----------
// 数学库（libm，llvmgen 无条件 declare；f64 → f64）。
// 整数实参（sqrt(4)）→ sitofp 提升为 f64（LLVM 类型必须匹配）
if nm == "sqrt" || nm == "sin" || nm == "cos" || nm == "tan" ||
    nm == "exp" || nm == "log" || nm == "floor" || nm == "ceil" || nm == "round" ||
    nm == "tanh" || nm == "sinh" || nm == "cosh" || nm == "asin" || nm == "acos" ||
    nm == "atan" || nm == "log2" || nm == "log10" || nm == "expm1" || nm == "log1p" ||
    nm == "cbrt" || nm == "exp2" || nm == "trunc" {
    var mv = tig_expr(call_arg(id, 0))
    if mv < 0 {
        return -1
    }
    var mvt = node_types[call_arg(id, 0)]
    var mf = tig_to_f64(mv, mvt)
    if mf < 0 {
        return -1
    }
    g_builtin_res = tig_ext_call1(nm, mf, types.named(TK_F64), types.named(TK_F64))
    return 0
}
// f64↔i64 位重解释（bitcast opcode 26，同宽 64 位直读；zd v2 §4.2）。
// 操作数 [0]=源类型 IMM，[1]=值；目标类型 = ins_ty。
if nm == "bitcast_f64_i64" || nm == "bitcast_i64_f64" {
    var bv = tig_expr(call_arg(id, 0))
    if bv < 0 {
        return -1
    }
    var dst_ty: i64 = types.named(TK_F64)
    var src_ty: i64 = types.named(TK_I64)
    if nm == "bitcast_f64_i64" {
        dst_ty = types.named(TK_I64)
        src_ty = types.named(TK_F64)
    }
    var bc = ir.new_inst(g_cur_block, 26, dst_ty)
    ir.add_operand(bc, src_ty, 2)  // 源类型 IMM
    ir.add_operand(bc, bv, 0)
    g_builtin_res = ir.get_value(bc)
    return 0
}
// ---------- M4/M6 补齐：系统能力内置（对齐 Rust ir.rs 同名单分支） ----------
if nm == "pow" { return bi_pow(nm, id) }
if nm == "atan2" || nm == "copysign" || nm == "fmod" || nm == "remainder" || nm == "hypot" {
    var dv1 = tig_expr(call_arg(id, 0))
    if dv1 < 0 {
        return -1
    }
    var dv2 = tig_expr(call_arg(id, 1))
    if dv2 < 0 {
        return -1
    }
    var d1t = node_types[call_arg(id, 0)]
    var d2t = node_types[call_arg(id, 1)]
    var df1 = tig_to_f64(dv1, d1t)
    var df2 = tig_to_f64(dv2, d2t)
    if df1 < 0 || df2 < 0 {
        return -1
    }
    g_builtin_res = tig_ext_call2(nm, df1, types.named(TK_F64), df2, types.named(TK_F64), types.named(TK_F64))
    return 0
}
// read_line：零参数 → string（p.6.4.10 内联 GetStdHandle(STD_INPUT_HANDLE) +
// ReadFile 逐字节读到 \n/EOF，去 Rust 桥 tie_read_line，**不置 g_used_interp**。
// 支持无缓冲管道（脚本交互）：`echo hello | probe` 读到 "hello"；\r\n 规整、
// \n 去除；EOF（管道关闭 / Ctrl-Z）返回已收集串或空串。
if nm == "read_line" { return bi_read_line(nm, id) }
if nm == "cwd" { return bi_cwd(nm, id) }
// 单字符串参数 → ptr 返回（previously list_dir/walk_dir 亦走此处；现已内联）；
// path_*/http_get/msg_t 仍走 tie_* 桥（path_* 留待 p.6.4.10，http 属 p.6.4.9）
if nm == "list_dir" || nm == "walk_dir" {
    var sv = tig_expr(call_arg(id, 0))
    if sv < 0 {
        return -1
    }
    if nm == "list_dir" {
        g_builtin_res = tig_list_dir(sv)
    } else {
        g_builtin_res = tig_walk_dir(sv)
    }
    return 0
}
if nm == "http_get" { return bi_http_get(nm, id) }
// path_* 原语：p.6.4.10 内联纯 tie IR 生成（tig_path_*，见 irgen_path.tie），
// 去 Rust tie_path_* 桥，不再置 g_used_interp（p.6.4 残留桥清零）。
if nm == "path_basename" { return bi_path_basename(nm, id) }
if nm == "path_dirname" { return bi_path_dirname(nm, id) }
if nm == "path_abs" { return bi_path_abs(nm, id) }
if nm == "path_normalize" { return bi_path_normalize(nm, id) }
if nm == "eval" { return bi_eval(nm, id) }
// 双字符串参数 → ptr 返回（path_join：p.6.4.10 仍留 tie_path_join Rust 桥，
// path_* 系列待后续去桥；eval_call：p.6.4.10 降级不置 g_used_interp）
if nm == "eval_call" { return bi_eval_call(nm, id) }
// path_join：p.6.4.10 内联纯 tie IR 生成（同 basename/dirname 系列）
if nm == "path_join" { return bi_path_join(nm, id) }
// regex_find：p.6.4.8 内联纯 tie 最小正则引擎
if nm == "regex_find" { return bi_regex_find(nm, id) }
// regex_replace：p.6.4.8 内联纯 tie 最小正则引擎
if nm == "regex_replace" { return bi_regex_replace(nm, id) }
// regex_group：p.6.4.8 内联纯 tie 最小正则引擎
if nm == "regex_group" { return bi_regex_group(nm, id) }
// regex_match：p.6.4.8 内联纯 tie 最小正则引擎
if nm == "regex_match" { return bi_regex_match(nm, id) }
// 单字符串参数 i8 返回 → bool（file_exists 已有；remove_dir_all/mkdir_all 已有
// mkdir_all；此处补 remove_dir_all）
if nm == "remove_dir_all" { return bi_remove_dir_all(nm, id) }
// file_copy/file_move/copy_dir：内联 CopyFileW/MoveFileW/SHFileOperationW
if nm == "file_copy" || nm == "file_move" || nm == "copy_dir" {
    var f1 = tig_expr(call_arg(id, 0))
    if f1 < 0 {
        return -1
    }
    var f2 = tig_expr(call_arg(id, 1))
    if f2 < 0 {
        return -1
    }
    if nm == "file_copy" {
        g_builtin_res = tig_copy_file(f1, f2)
    } else if nm == "file_move" {
        g_builtin_res = tig_move_file(f1, f2)
    } else {
        g_builtin_res = tig_copy_dir(f1, f2)
    }
    return 0
}
// 双字符串参数 i8 返回 → bool（untar_gz/unzip/http_get_file：p.6.4.9 内联，
// 不再走 tie_* 桥）
if nm == "untar_gz" || nm == "unzip" || nm == "http_get_file" {
    var f1 = tig_expr(call_arg(id, 0))
    if f1 < 0 {
        return -1
    }
    var f2 = tig_expr(call_arg(id, 1))
    if f2 < 0 {
        return -1
    }
    if nm == "http_get_file" {
        g_used_wsock = true
        g_builtin_res = tig_http_get_file(f1, f2)
    } else if nm == "untar_gz" {
        g_builtin_res = tig_untar_gz(f1, f2)
    } else {
        g_builtin_res = tig_unzip(f1, f2)
    }
    return 0
}
// byte_read：读文件为字节表（tig_byte_read 原生 libc 实现，失败 exit(1)）
if nm == "byte_read" { return bi_byte_read(nm, id) }
// byte_write：路径 + 字节表 → bool（tig_byte_write 原生 libc 实现）
if nm == "byte_write" { return bi_byte_write(nm, id) }
// p.6.9.1 stdio：stdin_read(n) → i64 字节表（tig_stdin_read 内联 GetStdHandle+ReadFile）
if nm == "stdin_read" { return bi_stdin_read(nm, id) }
// stdout_write_bytes(字节表) / stdout_write_str(串) → 写入字节数（tig_stdout_write_*）
if nm == "stdout_write_bytes" || nm == "stdout_write_str" {
    var so1 = tig_expr(call_arg(id, 0))
    if so1 < 0 {
        return -1
    }
    if nm == "stdout_write_bytes" {
        g_builtin_res = tig_stdout_write_bytes(so1)
    } else {
        g_builtin_res = tig_stdout_write_str(so1)
    }
    return 0
}
// bit_read：字节表 + 位置 → i64（tig_bit_read 原生实现，越界 0）
if nm == "bit_read" { return bi_bit_read(nm, id) }
// bit_write：字节表 + 位置 + 位 → bool（tig_bit_write 原生实现，越界 false）
if nm == "bit_write" { return bi_bit_write(nm, id) }
// byte_concat：字节表 + 字节表 → 字节表（tig_byte_concat 原生实现）
if nm == "byte_concat" { return bi_byte_concat(nm, id) }
// set_env：内联 SetEnvironmentVariableW（UTF-16 桥）；msg_set_lang：单参 void
if nm == "set_env" { return bi_set_env(nm, id) }
// ---------- p.6.4.7 消息系统原语（纯 tie：运行期全局表内联查表） ----------
// 不再走 tie_msg_* Rust 桥（g_used_interp=false）。状态 = 运行期程序全局槽
// @__msg_lang / @__msg_keys / @__msg_langs / @__msg_texts（惰性登记 + 惰性建表，
// 见 tig_msg_reg_globals / tig_msg_ensure）。
// ---------- p.6.4.7 消息系统原语（纯 tie：运行期全局表内联查表） ----------
if nm == "msg_set_lang" { return bi_msg_set_lang(nm, id) }
if nm == "msg_get_lang" { return bi_msg_get_lang(nm, id) }
if nm == "msg_register" { return bi_msg_register(nm, id) }
if nm == "msg_t" { return bi_msg_t(nm, id) }
if nm == "msg_t_lang" { return bi_msg_t_lang(nm, id) }
// rand_range：i64 半开区间 [min,max)；内联 libc rand()（非密码学安全）
if nm == "rand_range" { return bi_rand_range(nm, id) }
// table_at：表 + 下标 → 元素（与 t[i] 同语义；元素类型 fallback 判定）
if nm == "table_at" { return bi_table_at(nm, id) }
if nm == "table_pop" { return bi_table_pop(nm, id) }
if nm == "table_trunc" { return bi_table_trunc(nm, id) }
// ---------- trm-lite 轻量执行体原语（阶段1块2：spawn/yield/collect） ----------
if nm == "spawn" { return bi_spawn(nm, id) }
if nm == "yield" { return bi_yield(nm, id) }
if nm == "gosched" { return bi_gosched(nm, id) }
if nm == "collect" { return bi_collect(nm, id) }
// ---------- channel 原语（p.6.5.7：mailbox 承载，静态链接 trm_lite.a）----------
// ch_open() → i64 新通道句柄；入队前初始化各平行数组/环形缓冲（trm_lite.a 内部完成）。
// ---------- channel 原语（p.6.5.7：mailbox 承载，静态链接 trm_lite.a） ----------
if nm == "ch_open" { return bi_ch_open(nm, id) }
// ch_send(ch, v) → i64（0=入队成功 1=失败：通道关闭或队列满）。
if nm == "ch_send" { return bi_ch_send(nm, id) }
// ch_send_block(ch, v) → i64（p.9.5.x T3 背压：队满阻塞等待空位；0=已入队
// 1=通道关闭）。trm_lite_chan$ch_send_block 条件变量等待，Go 阻塞 send。
if nm == "ch_send_block" { return bi_ch_send_block(nm, id) }
// ch_recv(ch) → i64（消息值；0=空未关；-1=已关闭且空）。
if nm == "ch_recv" { return bi_ch_recv(nm, id) }
// ch_close(ch) → void：置关闭位（幂等）；唤醒等待者。trm_lite_chan$ch_close。
if nm == "ch_close" { return bi_ch_close(nm, id) }
// ---------- p.6.7.12 ch_select：多路收发（平行数组承载） ----------
// ch_select(handles: table<i64>, actions: table<i64>, values: table<i64>)
//   → i64（命中分支下标 0 起 / -1 无可执行分支）。actions[i]=1 recv / -1 send。
// 三个表实参经 t21_ptri 转 i64 句柄传入（运行时自行按容器布局读元素）。
// ---------- p.6.7.12 ch_select：多路收发（平行数组承载） ----------
if nm == "ch_select" { return bi_ch_select(nm, id) }
// ---------- WaitGroup 原语（p.6.7.11：Go sync.WaitGroup 语义，trm_lite_wg$*） ----------
// wg_new() → i64 新组句柄。
// ---------- WaitGroup 原语（p.6.7.11：Go sync.WaitGroup 语义，trm_lite_wg$*） ----------
if nm == "wg_new" { return bi_wg_new(nm, id) }
// wg_add(h, n) → void。
if nm == "wg_add" { return bi_wg_add(nm, id) }
// wg_done(h) → void。
if nm == "wg_done" { return bi_wg_done(nm, id) }
// wg_wait(h) → void。
if nm == "wg_wait" { return bi_wg_wait(nm, id) }
// wg_count(h) → i64（r.1.5.2）：剩余未 done 计数（观察量，wg_wait 轮询用；
// trm-lite wg 实现：计数归零钳 0，返回值即 g_wg_cnt[h-1]）。
if nm == "wg_count" { return bi_wg_count(nm, id) }
return -1  // 非内置
}
}