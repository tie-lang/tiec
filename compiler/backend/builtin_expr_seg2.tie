type tie<class>
// compiler/backend/builtin_expr_seg2.tie —— builtin_expr 分派链分段 2（p.9.21 G2 单函数 ≤300 行）
// ============================================================
// 只含函数与注释：import 树与顶层全局 var 仍留在原主文件；
// 与原函数同 namespace，跨文件裸名互调；段尾 return <sentinel> = 本段未命中。
namespace irgen {
    func builtin_expr_seg2(nm: string, id: i64) -> i64 {
        if nm == "to_string" { return bi_to_string(nm, id) }
        if nm == "parse_int" { return bi_parse_int(nm, id) }
        if nm == "parse_float" { return bi_parse_float(nm, id) }
        if nm == "parse_trit" { return bi_parse_trit(nm, id) }
        if nm == "to_trit" { return bi_to_trit(nm, id) }
        if nm == "trit_val" { return bi_trit_val(nm, id) }
        if nm == "len" { return bi_len(nm, id) }
        // P2b：any 拆箱（as_bool/as_string/as_char——仅 any 参数；as_i64/as_f64
        // 已在上方 as_dst 块重载处理）。P2d：as_table_* 拆箱为对应元素类型表
        //（返回表值 ptr，tag = 精确表类型 id，与装箱时的 tag 一致才匹配）。
        if nm == "as_bool" || nm == "as_string" || nm == "as_char" ||
        nm == "as_table_i64" || nm == "as_table_string" || nm == "as_table_bool" ||
        nm == "as_table_f64" || nm == "as_table_char" || nm == "as_table_any" {
            var a0 = call_arg(id, 0)
            var av = tig_expr(a0)
            if av < 0 {
                return -1
            }
            var rty: i64 = types.named(TK_I64)
            if nm == "as_f64" {
                rty = types.named(TK_F64)
            } else if nm == "as_bool" {
                rty = types.named(TK_BOOL)
            } else if nm == "as_string" {
                rty = types.named(TK_STR)
            } else if nm == "as_char" {
                rty = types.named(TK_CHAR)
            } else if nm == "as_table_i64" {
                rty = types.table_of(types.named(TK_I64))
            } else if nm == "as_table_string" {
                rty = types.table_of(types.named(TK_STR))
            } else if nm == "as_table_bool" {
                rty = types.table_of(types.named(TK_BOOL))
            } else if nm == "as_table_f64" {
                rty = types.table_of(types.named(TK_F64))
            } else if nm == "as_table_char" {
                rty = types.table_of(types.named(TK_CHAR))
            } else if nm == "as_table_any" {
                rty = types.table_of(types.named(TK_ANY))
            }
            var ux = tig_unbox_any(av, rty, nm)
            if ux < 0 {
                return -1
            }
            g_builtin_res = ux
            return 0
        }
        // P2c：any_tag(x) → 读 {tag,payload} 的 tag 字段（标量 0-4 / 复合类型 id）
        if nm == "any_tag" { return bi_any_tag(nm, id) }
        // P2d-D3：map 高阶——map_keys(m)→table<string>；map_values(m)→table<V>
        //（V 从实参 map<string,V> 类型解码）；map_contains(m, key)→bool（不 raise）
        if nm == "map_keys" || nm == "map_values" {
            var m0 = call_arg(id, 0)
            var mv = tig_expr(m0)
            if mv < 0 {
                return -1
            }
            var m_vty: i64 = types.named(TK_I64)
            if nm == "map_values" {
                var m_arg_ty = node_types[m0]
                if types.is_map(m_arg_ty) {
                    var lv = types.low(m_arg_ty)
                    if lv > 0 {
                        m_vty = lv
                    }
                }
            }
            g_builtin_res = s21_map_extract(mv, m_vty, nm == "map_keys")
            return 0
        }
        if nm == "map_contains" { return bi_map_contains(nm, id) }
        if nm == "table_new_i64" || nm == "table_new_f64" || nm == "table_new_string" || nm == "table_new_bool" {
            var elem: i64 = types.named(TK_I64)
            if nm == "table_new_string" {
                elem = types.named(TK_STR)
            } else if nm == "table_new_bool" {
                elem = types.named(TK_BOOL)
            } else if nm == "table_new_f64" {
                elem = types.named(TK_F64)
            }
            var esz_v = tig_int_lit_ty(elem_size(elem), types.named(TK_I64))
            g_builtin_res = s21_table_new(esz_v)
            return 0
        }
        if nm == "table_push" { return bi_table_push(nm, id) }
        if nm == "exit" { return bi_exit(nm, id) }
        if nm == "arg_count" { return bi_arg_count(nm, id) }
        if nm == "arg_string" { return bi_arg_string(nm, id) }
        if nm == "file_read" { return bi_file_read(nm, id) }
        if nm == "file_write" || nm == "file_append" {
            var p = tig_expr(call_arg(id, 0))
            if p < 0 {
                return -1
            }
            var c = tig_expr(call_arg(id, 1))
            if c < 0 {
                return -1
            }
            g_builtin_res = tig_write_file(p, c, nm == "file_append")
            return 0
        }
        if nm == "file_size" { return bi_file_size(nm, id) }
        if nm == "file_is_dir" || nm == "file_is_file" {
            var p = tig_expr(call_arg(id, 0))
            if p < 0 {
                return -1
            }
            if nm == "file_is_dir" {
                g_builtin_res = tig_is_dir_inline(p)
            } else {
                g_builtin_res = tig_is_file_inline(p)
            }
            return 0
        }
        if nm == "file_exists" { return bi_file_exists(nm, id) }
        if nm == "file_delete" { return bi_file_delete(nm, id) }
        if nm == "print_err" { return bi_print_err(nm, id) }
        if nm == "mkdir_all" { return bi_mkdir_all(nm, id) }
        if nm == "regex_find_all" { return bi_regex_find_all(nm, id) }
        // ---------- M4/M6 补齐：系统能力内置（对齐 Rust ir.rs 同名单分支）----------
        // 数学库（libm，llvmgen 无条件 declare；f64 → f64）。
        // 整数实参（sqrt(4)）→ sitofp 提升为 f64（LLVM 类型必须匹配）
        if nm == "sqrt" || nm == "sin" || nm == "cos" || nm == "tan" ||
        nm == "exp" || nm == "log" || nm == "floor" || nm == "ceil" || nm == "round" ||
        nm == "tanh" || nm == "sinh" || nm == "cosh" || nm == "asin" || nm == "acos" ||
        nm == "atan" || nm == "log2" || nm == "log10" || nm == "expm1" || nm == "log1p" ||
        nm == "cbrt" || nm == "exp2" || nm == "trunc" {
            var mv = tig_expr(call_arg(id, 0))
            if mv < 0 {
                return -1
            }
            var mvt = node_types[call_arg(id, 0)]
            var mf = tig_to_f64(mv, mvt)
            if mf < 0 {
                return -1
            }
            g_builtin_res = tig_ext_call1(nm, mf, types.named(TK_F64), types.named(TK_F64))
            return 0
        }
        // f64↔i64 位重解释（bitcast opcode 26，同宽 64 位直读；zd v2 §4.2）。
        // 操作数 [0]=源类型 IMM，[1]=值；目标类型 = ins_ty。
        if nm == "bitcast_f64_i64" || nm == "bitcast_i64_f64" {
            var bv = tig_expr(call_arg(id, 0))
            if bv < 0 {
                return -1
            }
            var dst_ty: i64 = types.named(TK_F64)
            var src_ty: i64 = types.named(TK_I64)
            if nm == "bitcast_f64_i64" {
                dst_ty = types.named(TK_I64)
                src_ty = types.named(TK_F64)
            }
            var bc = ir.new_inst(g_cur_block, 26, dst_ty)
            ir.add_operand(bc, src_ty, 2)  // 源类型 IMM
            ir.add_operand(bc, bv, 0)
            g_builtin_res = ir.get_value(bc)
            return 0
        }
        // ---------- M4/M6 补齐：系统能力内置（对齐 Rust ir.rs 同名单分支） ----------
        if nm == "pow" { return bi_pow(nm, id) }
        if nm == "atan2" || nm == "copysign" || nm == "fmod" || nm == "remainder" || nm == "hypot" {
            var dv1 = tig_expr(call_arg(id, 0))
            if dv1 < 0 {
                return -1
            }
            var dv2 = tig_expr(call_arg(id, 1))
            if dv2 < 0 {
                return -1
            }
            var d1t = node_types[call_arg(id, 0)]
            var d2t = node_types[call_arg(id, 1)]
            var df1 = tig_to_f64(dv1, d1t)
            var df2 = tig_to_f64(dv2, d2t)
            if df1 < 0 || df2 < 0 {
                return -1
            }
            g_builtin_res = tig_ext_call2(nm, df1, types.named(TK_F64), df2, types.named(TK_F64), types.named(TK_F64))
            return 0
        }
        // read_line：零参数 → string（p.6.4.10 内联 GetStdHandle(STD_INPUT_HANDLE) +
        // ReadFile 逐字节读到 \n/EOF，去 Rust 桥 tie_read_line，**不置 g_used_interp**。
        // 支持无缓冲管道（脚本交互）：`echo hello | probe` 读到 "hello"；\r\n 规整、
        // \n 去除；EOF（管道关闭 / Ctrl-Z）返回已收集串或空串。
        if nm == "read_line" { return bi_read_line(nm, id) }
        if nm == "cwd" { return bi_cwd(nm, id) }
        // 单字符串参数 → ptr 返回（previously list_dir/walk_dir 亦走此处；现已内联）；
        // path_*/http_get/msg_t 仍走 tie_* 桥（path_* 留待 p.6.4.10，http 属 p.6.4.9）
        if nm == "list_dir" || nm == "walk_dir" {
            var sv = tig_expr(call_arg(id, 0))
            if sv < 0 {
                return -1
            }
            if nm == "list_dir" {
                g_builtin_res = tig_list_dir(sv)
            } else {
                g_builtin_res = tig_walk_dir(sv)
            }
            return 0
        }
        if nm == "http_get" { return bi_http_get(nm, id) }
        // path_* 原语：p.6.4.10 内联纯 tie IR 生成（tig_path_*，见 irgen_path.tie），
        // 去 Rust tie_path_* 桥，不再置 g_used_interp（p.6.4 残留桥清零）。
        if nm == "path_basename" { return bi_path_basename(nm, id) }
        if nm == "path_dirname" { return bi_path_dirname(nm, id) }
        if nm == "path_abs" { return bi_path_abs(nm, id) }
        if nm == "path_normalize" { return bi_path_normalize(nm, id) }
        if nm == "eval" { return bi_eval(nm, id) }
        // 双字符串参数 → ptr 返回（path_join：p.6.4.10 仍留 tie_path_join Rust 桥，
        // path_* 系列待后续去桥；eval_call：p.6.4.10 降级不置 g_used_interp）
        if nm == "eval_call" { return bi_eval_call(nm, id) }
        // path_join：p.6.4.10 内联纯 tie IR 生成（同 basename/dirname 系列）
        if nm == "path_join" { return bi_path_join(nm, id) }
        // regex_find：p.6.4.8 内联纯 tie 最小正则引擎
        if nm == "regex_find" { return bi_regex_find(nm, id) }
        // regex_replace：p.6.4.8 内联纯 tie 最小正则引擎
        if nm == "regex_replace" { return bi_regex_replace(nm, id) }
        // regex_group：p.6.4.8 内联纯 tie 最小正则引擎
        if nm == "regex_group" { return bi_regex_group(nm, id) }
        // regex_match：p.6.4.8 内联纯 tie 最小正则引擎
        if nm == "regex_match" { return bi_regex_match(nm, id) }
        // 单字符串参数 i8 返回 → bool（file_exists 已有；remove_dir_all/mkdir_all 已有
        // mkdir_all；此处补 remove_dir_all）
        if nm == "remove_dir_all" { return bi_remove_dir_all(nm, id) }
        // file_copy/file_move/copy_dir：内联 CopyFileW/MoveFileW/SHFileOperationW
        if nm == "file_copy" || nm == "file_move" || nm == "copy_dir" {
            var f1 = tig_expr(call_arg(id, 0))
            if f1 < 0 {
                return -1
            }
            var f2 = tig_expr(call_arg(id, 1))
            if f2 < 0 {
                return -1
            }
            if nm == "file_copy" {
                g_builtin_res = tig_copy_file(f1, f2)
            } else if nm == "file_move" {
                g_builtin_res = tig_move_file(f1, f2)
            } else {
                g_builtin_res = tig_copy_dir(f1, f2)
            }
            return 0
        }
        // 双字符串参数 i8 返回 → bool（untar_gz/unzip/http_get_file：p.6.4.9 内联，
        // 不再走 tie_* 桥）
        if nm == "untar_gz" || nm == "unzip" || nm == "http_get_file" {
            var f1 = tig_expr(call_arg(id, 0))
            if f1 < 0 {
                return -1
            }
            var f2 = tig_expr(call_arg(id, 1))
            if f2 < 0 {
                return -1
            }
            if nm == "http_get_file" {
                g_used_wsock = true
                g_builtin_res = tig_http_get_file(f1, f2)
            } else if nm == "untar_gz" {
                g_builtin_res = tig_untar_gz(f1, f2)
            } else {
                g_builtin_res = tig_unzip(f1, f2)
            }
            return 0
        }
        // byte_read：读文件为字节表（tig_byte_read 原生 libc 实现，失败 exit(1)）
        if nm == "byte_read" { return bi_byte_read(nm, id) }
        // byte_write：路径 + 字节表 → bool（tig_byte_write 原生 libc 实现）
        if nm == "byte_write" { return bi_byte_write(nm, id) }
        // p.6.9.1 stdio：stdin_read(n) → i64 字节表（tig_stdin_read 内联 GetStdHandle+ReadFile）
        if nm == "stdin_read" { return bi_stdin_read(nm, id) }
        return -1  // 本段未命中
    }
}