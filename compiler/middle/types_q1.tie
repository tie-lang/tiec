type tie<class>
// compiler/middle/types_q1.tie —— 分片 1（p.9.21.3 单文件 ≤800 行）
// ============================================================
// 只搬函数与紧邻注释；顶层全局 var 与 import 树仍留在 types.tie。
// 顶层函数保持顶层身份（跨 ns 裸调依赖），ns 内函数按上下文包 namespace。
namespace types {
// Named 类型：id = TyKw 索引（0..20，见 TK_* 常量）。
pub func named(kw: i64) -> i64 {
    return kw
}

// table<T>：id = 1<<40 | T（T 为任意 type id，含嵌套）。
// 嵌套聚合元素（T ≥ 100）查/登记序号表，负载 = 100 + 序号——防止
// BASE_TABLE + 聚合进位碰撞 map 段（历史 bug：table<table<i64>> == map<i64>）。
pub func table_of(elem: i64) -> i64 {
    if elem < NEST_SLOT_OFF {
        return BASE_TABLE + elem  // 快路径：named 元素（0..99）
    }
    var n = len(nest_tbl_elems)
    var i: i64 = 0
    while i < n {
        if nest_tbl_elems[i] == elem {
            return BASE_TABLE + NEST_SLOT_OFF + i
        }
        i = i + 1
    }
    table_push(nest_tbl_elems, elem)
    return BASE_TABLE + NEST_SLOT_OFF + n
}

// map<V>：id = 2<<40 | V（嵌套聚合值同 table_of 的序号表方案）。
pub func map_of(v: i64) -> i64 {
    if v < NEST_SLOT_OFF {
        return BASE_MAP + v
    }
    var n = len(nest_map_vals)
    var i: i64 = 0
    while i < n {
        if nest_map_vals[i] == v {
            return BASE_MAP + NEST_SLOT_OFF + i
        }
        i = i + 1
    }
    table_push(nest_map_vals, v)
    return BASE_MAP + NEST_SLOT_OFF + n
}

// struct S：id = 3<<40 | struct_索引（struct 表行号）。
pub func struct_of(idx: i64) -> i64 {
    return BASE_STRUCT + idx
}

// tuple：id = 4<<40 | tuple_索引（tuple 表行号）。
pub func tuple_of(idx: i64) -> i64 {
    return BASE_TUPLE + idx
}

// TypeVar（泛型类型参数）：id = 5<<40 | intern.intern(name)。
// 名字即身份——同名类型参数全局同 id、跨函数稳定（mangling 友好）；
// intern 池 id < 2^40 保证不碰撞（named/table/map/struct/tuple 均 < 5<<40）。
// 供语义层登记泛型形参使用；还原名字走 type_name（interner.lookup(low(t))）。
pub func var_of(name: string) -> i64 {
    return BASE_TYPEVAR + interner.intern(name)
}

// enum E：id = 6<<40 | enum_索引（enum 表行号）。
pub func enum_of(idx: i64) -> i64 {
    return BASE_ENUM + idx
}

// ---------- S1.2 不安全类型（ptr/slice/atomic）构造 ----------
// 嵌套聚合负载（T ≥ NEST_SLOT_OFF）走各自序号表（同 table_of 方案防进位碰撞）。
// ptr<T>：id = 7<<40 | T。T 为任意类型 id（含嵌套聚合）。
pub func ptr_of(elem: i64) -> i64 {
    if elem < NEST_SLOT_OFF {
        return BASE_PTR + elem
    }
    var n = len(nest_ptr_elems)
    var i: i64 = 0
    while i < n {
        if nest_ptr_elems[i] == elem {
            return BASE_PTR + NEST_SLOT_OFF + i
        }
        i = i + 1
    }
    table_push(nest_ptr_elems, elem)
    return BASE_PTR + NEST_SLOT_OFF + n
}

// slice<T>：id = 8<<40 | T（指针 + 长度；元素类型）。
pub func slice_of(elem: i64) -> i64 {
    if elem < NEST_SLOT_OFF {
        return BASE_SLICE + elem
    }
    var n = len(nest_slice_elems)
    var i: i64 = 0
    while i < n {
        if nest_slice_elems[i] == elem {
            return BASE_SLICE + NEST_SLOT_OFF + i
        }
        i = i + 1
    }
    table_push(nest_slice_elems, elem)
    return BASE_SLICE + NEST_SLOT_OFF + n
}

// atomic<T>：id = 9<<40 | T（原子类型，第一版 i64/f64/bool）。
pub func atomic_of(elem: i64) -> i64 {
    if elem < NEST_SLOT_OFF {
        return BASE_ATOMIC + elem
    }
    var n = len(nest_atomic_elems)
    var i: i64 = 0
    while i < n {
        if nest_atomic_elems[i] == elem {
            return BASE_ATOMIC + NEST_SLOT_OFF + i
        }
        i = i + 1
    }
    table_push(nest_atomic_elems, elem)
    return BASE_ATOMIC + NEST_SLOT_OFF + n
}

// ---------- L1 定长数组类型构造 ----------
// array<T, N>：id = 14<<40 | NEST_SLOT_OFF + 序号。元素 + 长度经 nest_arr_elems /
// nest_arr_lens 平行登记（低负载 = 序号；恒 ≥ NEST_SLOT_OFF 防与 named 段碰撞）。
// 查重：元素类型 id + 长度双匹配返回既有序号（相同数组类型同 id，O(1) 比较）。
pub func array_of(elem: i64, len: i64) -> i64 {
    var n = len(nest_arr_elems)
    var i: i64 = 0
    while i < n {
        if nest_arr_elems[i] == elem && nest_arr_lens[i] == len {
            return BASE_ARRAY + NEST_SLOT_OFF + i
        }
        i = i + 1
    }
    table_push(nest_arr_elems, elem)
    table_push(nest_arr_lens, len)
    return BASE_ARRAY + NEST_SLOT_OFF + n
}

// 定长数组判据：kind == K_ARRAY（14<<40 段）。
pub func is_array(t: i64) -> bool {
    if kind(t) == K_ARRAY {
        return true
    }
    return false
}

// 定长数组元素类型：K_ARRAY → 元素类型 id；非数组返回 -1。
pub func array_elem(t: i64) -> i64 {
    var k = kind(t)
    if k == K_ARRAY {
        var la = low(t) - NEST_SLOT_OFF
        if la >= 0 && la < len(nest_arr_elems) {
            return nest_arr_elems[la]
        }
        return -1
    }
    return -1
}

// 定长数组长度：K_ARRAY → 元素个数 N（编译期常量）；非数组返回 -1。
pub func array_len(t: i64) -> i64 {
    var k = kind(t)
    if k == K_ARRAY {
        var lb = low(t) - NEST_SLOT_OFF
        if lb >= 0 && lb < len(nest_arr_lens) {
            return nest_arr_lens[lb]
        }
        return -1
    }
    return -1
}

// ---------- S2.2 fn 函数值类型构造 ----------
// fn(A, B) -> R：id = 10<<40 | 签名索引。签名 = 返回类型 + 参数类型列表，
// 查 fn 签名表编码（低负载为签名表行号）。参数可含任意类型 id（含嵌套聚合、
// 另一个 fn 类型——函数值作参数天然合法）。
// fn_of 查重/登记：按返回类型 + 参数列表逐一比对，命中返回既有索引；
// 未命中追加登记并返回新索引。参数类型存扁平段（fn_params），
// 每个签名记录参数个数与段偏移（fn_nparams / fn_paroff）。
pub func fn_of(ret: i64, params: table<i64>) -> i64 {
    var n = len(fn_ret)
    var i: i64 = 0
    while i < n {
        if fn_ret[i] == ret && fn_nparams[i] == len(params) {
            var off = fn_paroff[i]
            var ok: bool = true
            var j: i64 = 0
            while j < len(params) {
                if fn_params[off + j] != params[j] {
                    ok = false
                    break
                }
                j = j + 1
            }
            if ok {
                return BASE_FN + i
            }
        }
        i = i + 1
    }
    table_push(fn_ret, ret)
    table_push(fn_nparams, len(params))
    table_push(fn_paroff, len(fn_params))
    table_push(fn_has_var, 0)
    var k: i64 = 0
    while k < len(params) {
        table_push(fn_params, params[k])
        table_push(fn_param_refs, 0)
        k = k + 1
    }
    return BASE_FN + n
}

// p.6.2.4 闭包参数 ref / 变参：fn_of 扩展版，登记 ref 标志 + 变参标志。
// p_refs：并行表（0/1，按引用传递；仅表参数合法）；has_var：末位变参
// （参数列表末位 = table<T>，LLVM 表现同 table）。查重严格匹配全元数据。
// 旧 fn_of 调用仍可用（等价于全 0 refs + 非变参），新建的签名在扩容版
// 表中额外登记元数据——两版共享 fn_ret/fn_nparams/fn_paroff/fn_params
// 主段，仅 refs/var 归零差异不影响旧调用方读取。
pub func fn_of2(ret: i64, params: table<i64>, p_refs: table<i64>, has_var: i64) -> i64 {
    var n = len(fn_ret)
    var i: i64 = 0
    while i < n {
        if fn_ret[i] == ret && fn_nparams[i] == len(params) && fn_has_var[i] == has_var {
            var off = fn_paroff[i]
            var ok: bool = true
            var j: i64 = 0
            while j < len(params) {
                if fn_params[off + j] != params[j] {
                    ok = false
                    break
                }
                if fn_param_refs[off + j] != p_refs[j] {
                    ok = false
                    break
                }
                j = j + 1
            }
            if ok {
                return BASE_FN + i
            }
        }
        i = i + 1
    }
    table_push(fn_ret, ret)
    table_push(fn_nparams, len(params))
    table_push(fn_paroff, len(fn_params))
    table_push(fn_has_var, has_var)
    var k: i64 = 0
    while k < len(params) {
        table_push(fn_params, params[k])
        table_push(fn_param_refs, p_refs[k])
        k = k + 1
    }
    return BASE_FN + n
}

// fn 第 k 个参数是否按引用传递（p.6.2.4）：fn 类型 -> 0/1；越界/非 fn 返回 0。
pub func fn_param_ref(t: i64, k: i64) -> i64 {
    var idx = low(t)
    if idx >= 0 && idx < len(fn_nparams) {
        if k >= 0 && k < fn_nparams[idx] {
            return fn_param_refs[fn_paroff[idx] + k]
        }
    }
    return 0
}

// fn 变参标志（p.6.2.4）：fn 类型 -> 0/1；非 fn 返回 0。
pub func fn_has_var_of(t: i64) -> i64 {
    var idx = low(t)
    if idx >= 0 && idx < len(fn_has_var) {
        return fn_has_var[idx]
    }
    return 0
}

// fn 返回类型：fn 类型 -> 返回类型 id；非 fn 类型返回 -1。
pub func fn_ret_ty(t: i64) -> i64 {
    var idx = low(t)
    if idx >= 0 && idx < len(fn_ret) {
        return fn_ret[idx]
    }
    return -1
}

// fn 参数个数：fn 类型 -> 参数个数；非 fn 类型返回 -1。
pub func fn_nparams_of(t: i64) -> i64 {
    var idx = low(t)
    if idx >= 0 && idx < len(fn_nparams) {
        return fn_nparams[idx]
    }
    return -1
}

// fn 第 k 个参数类型：fn 类型 -> 参数类型 id；越界/非 fn 返回 -1。
pub func fn_param_of(t: i64, k: i64) -> i64 {
    var idx = low(t)
    if idx >= 0 && idx < len(fn_nparams) {
        if k >= 0 && k < fn_nparams[idx] {
            return fn_params[fn_paroff[idx] + k]
        }
    }
    return -1
}

// ---------- S2.4 port 对象类型构造 ----------
// port P：id = 11<<40 | port 索引（port 表行号，语义层登记顺序）。
pub func port_of(idx: i64) -> i64 {
    return BASE_PORT + idx
}

// port 类型判据：kind == K_PORT（11<<40 段）。
pub func is_port(t: i64) -> bool {
    if kind(t) == K_PORT {
        return true
    }
    return false
}

// 登记 port 索引 -> 名字（语义层收集 port 时调用；追加式，
// 索引 = 登记顺序，与语义 port 表行号对应）。
pub func set_port_name(idx: i64, nm: string) {
    while len(pt_names) < idx {
        table_push(pt_names, "")
    }
    table_push(pt_names, nm)
}

// ---------- 一期并发 actor 句柄类型构造 ----------
// actor A 句柄：id = 12<<40 | actor 表行号（语义层登记顺序）。
pub func actor_of(idx: i64) -> i64 {
    return BASE_ACTOR + idx
}

// actor 句柄判据：kind == K_ACTOR（12<<40 段）。
pub func is_actor(t: i64) -> bool {
    if kind(t) == K_ACTOR {
        return true
    }
    return false
}

// 登记 actor 索引 -> 名字（语义层收集 actor 时调用；追加式，索引 = 登记顺序）。
pub func set_actor_name(idx: i64, nm: string) {
    while len(act_names) < idx {
        table_push(act_names, "")
    }
    table_push(act_names, nm)
}

// ---------- 三期 A 组 guard<cap> 凭据类型构造 ----------
// guard<cap>：id = 13<<40 | 能力域索引（0=share 1=mem 2=ext）。
pub func guard_of(cap: i64) -> i64 {
    return BASE_GUARD + cap
}

// guard 能力域索引（0=share 1=mem 2=ext，与 guard_of 编码一致）
pub func guard_cap(t: i64) -> i64 {
    return low(t)
}

// guard 判据：kind == K_GUARD（13<<40 段）。
pub func is_guard(t: i64) -> bool {
    if kind(t) == K_GUARD {
        return true
    }
    return false
}

// guard 能力域名（type_name 用）：share / mem / ext
pub func guard_cap_name(t: i64) -> string {
    var c = low(t)
    if c == 0 {
        return "share"
    }
    if c == 1 {
        return "mem"
    }
    return "ext"
}

// 类型类别：0=Named 1=Table 2=Map 3=Struct 4=Tuple 5=TypeVar 6=Enum
// 7=Ptr 8=Slice 9=Atomic 10=Fn 11=Port 12=Actor 13=Guard 14=Array。
// Named 判定用 id < 100（TyKw 索引 0..20，留余量）；
// 其余按高位阈值顺序判别（Array 段 14<<40 最高必须最先判；之后 Guard
// 13<<40、Actor 12<<40、Port 11<<40、Fn 10<<40、Atomic 9<<40、Slice 8<<40、
// Ptr 7<<40、Enum 6<<40、TypeVar、Tuple、Struct、Map，其余为 Table
// ——与 semantic ty_kind 一致）。
pub func kind(id: i64) -> i64 {
    if id < 100 {
        return K_NAMED
    }
    // L1：BASE_ARRAY（14<<40）高于 guard 段，必须最先判（下一档 13<<40）
    if id >= BASE_ARRAY {
        return K_ARRAY
    }
    if id >= BASE_GUARD {
        return K_GUARD
    }
    if id >= BASE_ACTOR {
        return K_ACTOR
    }
    if id >= BASE_PORT {
        return K_PORT
    }
    if id >= BASE_FN {
        return K_FN
    }
    if id >= BASE_ATOMIC {
        return K_ATOMIC
    }
    if id >= BASE_SLICE {
        return K_SLICE
    }
    if id >= BASE_PTR {
        return K_PTR
    }
    if id >= BASE_ENUM {
        return K_ENUM
    }
    if id >= BASE_TYPEVAR {
        return K_TYPEVAR
    }
    if id >= BASE_TUPLE {
        return K_TUPLE
    }
    if id >= BASE_STRUCT {
        return K_STRUCT
    }
    if id >= BASE_MAP {
        return K_MAP
    }
    return K_TABLE
}

// 类型负载：Table/Map/Ptr/Slice/Atomic 的元素类型 id、Struct/Tuple/Enum/Port 的
// 索引、TypeVar 的 intern 池 id；Named 类型无意义（调用方先判 kind）。
pub func low(id: i64) -> i64 {
    if id >= BASE_ARRAY {
        return id - BASE_ARRAY
    }
    if id >= BASE_GUARD {
        return id - BASE_GUARD
    }
    if id >= BASE_ACTOR {
        return id - BASE_ACTOR
    }
    if id >= BASE_PORT {
        return id - BASE_PORT
    }
    if id >= BASE_FN {
        return id - BASE_FN
    }
    if id >= BASE_ATOMIC {
        return id - BASE_ATOMIC
    }
    if id >= BASE_SLICE {
        return id - BASE_SLICE
    }
    if id >= BASE_PTR {
        return id - BASE_PTR
    }
    if id >= BASE_ENUM {
        return id - BASE_ENUM
    }
    if id >= BASE_TYPEVAR {
        return id - BASE_TYPEVAR
    }
    if id >= BASE_TUPLE {
        return id - BASE_TUPLE
    }
    if id >= BASE_STRUCT {
        return id - BASE_STRUCT
    }
    if id >= BASE_MAP {
        return id - BASE_MAP
    }
    return id - BASE_TABLE
}

// 整数类型：i8/i16/i32/i64/i128/u8/u16/u32/u64/u128（Named 且 TyKw 在整数区间）。
pub func is_int(t: i64) -> bool {
    if t >= 100 {
        return false
    }
    if t == TK_I8 || t == TK_I16 || t == TK_I32 || t == TK_I64 || t == TK_I128 {
        return true
    }
    if t == TK_U8 || t == TK_U16 || t == TK_U32 || t == TK_U64 || t == TK_U128 {
        return true
    }
    return false
}

// 浮点类型：f32/f64。
pub func is_float(t: i64) -> bool {
    if t == TK_F32 || t == TK_F64 {
        return true
    }
    return false
}

// 数值类型：整数或浮点（算术运算合法域）。
pub func is_number(t: i64) -> bool {
    if is_int(t) {
        return true
    }
    return is_float(t)
}

// 布尔类：bool/trit（条件语境合法域，trit 三值逻辑）。
pub func is_bool_like(t: i64) -> bool {
    if t == TK_BOOL || t == TK_TRIT {
        return true
    }
    return false
}

// 宽类型：num/text/misc（类别框，未细化的泛化类型）。
pub func is_wide(t: i64) -> bool {
    if t == TK_NUM || t == TK_TEXT || t == TK_MISC {
        return true
    }
    return false
}

// 表类：裸 table 关键字或参数化 table<T>/map<V>（含裸 map）。
// 注意与 map 判据的区分：is_table 覆盖 map（semantic 同款，
// 表/映射统一按表处理，迭代/下标语义一致）。
pub func is_table(t: i64) -> bool {
    if t == TK_TABLE {
        return true
    }
    var k = kind(t)
    if k == K_TABLE {
        return true
    }
    if k == K_MAP {
        return true
    }
    return false
}

// 映射类：裸 map 关键字或参数化 map<V>。
pub func is_map(t: i64) -> bool {
    if t == TK_MAP {
        return true
    }
    if kind(t) == K_MAP {
        return true
    }
    return false
}

// 枚举判据：kind == K_ENUM（6<<40 段）。
// 供语义层识别枚举类型（构造/匹配/类型检查按 kind 分派）。
pub func is_enum(t: i64) -> bool {
    if kind(t) == K_ENUM {
        return true
    }
    return false
}

// TypeVar 判据：kind == K_TYPEVAR（5<<40 段）。
// 供语义层识别泛型形参（如函数签名类型槽位里出现 TypeVar 时走单态化
// 替换路径）；单态化替换后应还原为具体类型再走其余判据族。
pub func is_typevar(t: i64) -> bool {
    if kind(t) == K_TYPEVAR {
        return true
    }
    return false
}

// 表元素类型：参数化 table<T>/map<V>/ptr<T>/slice<T>/atomic<T> 返回负载 T；
// 裸 table/map 关键字返回 -1（元素类型未知）。
// 嵌套聚合负载（≥ NEST_SLOT_OFF）查序号表还原真实元素类型。
pub func table_elem(t: i64) -> i64 {
    var k = kind(t)
    if k == K_TABLE {
        var ld = low(t)
        if ld < NEST_SLOT_OFF {
            return ld  // named 元素（0..99）
        }
        var si = ld - NEST_SLOT_OFF
        if si >= 0 && si < len(nest_tbl_elems) {
            return nest_tbl_elems[si]
        }
        return -1
    }
    if k == K_MAP {
        var ld2 = low(t)
        if ld2 < NEST_SLOT_OFF {
            return ld2
        }
        var si2 = ld2 - NEST_SLOT_OFF
        if si2 >= 0 && si2 < len(nest_map_vals) {
            return nest_map_vals[si2]
        }
        return -1
    }
    if k == K_PTR {
        var lp = low(t)
        if lp < NEST_SLOT_OFF {
            return lp
        }
        var sp = lp - NEST_SLOT_OFF
        if sp >= 0 && sp < len(nest_ptr_elems) {
            return nest_ptr_elems[sp]
        }
        return -1
    }
    if k == K_SLICE {
        var ls = low(t)
        if ls < NEST_SLOT_OFF {
            return ls
        }
        var ss = ls - NEST_SLOT_OFF
        if ss >= 0 && ss < len(nest_slice_elems) {
            return nest_slice_elems[ss]
        }
        return -1
    }
    if k == K_ATOMIC {
        var la = low(t)
        if la < NEST_SLOT_OFF {
            return la
        }
        var sa = la - NEST_SLOT_OFF
        if sa >= 0 && sa < len(nest_atomic_elems) {
            return nest_atomic_elems[sa]
        }
        return -1
    }
    return -1
}

// ---------- S1.2 不安全类型判据 ----------
// ptr/slice/atomic 判据（kind 段判别）。
pub func is_ptr(t: i64) -> bool {
    if kind(t) == K_PTR {
        return true
    }
    return false
}

pub func is_slice(t: i64) -> bool {
    if kind(t) == K_SLICE {
        return true
    }
    return false
}

pub func is_atomic(t: i64) -> bool {
    if kind(t) == K_ATOMIC {
        return true
    }
    return false
}

// 是否不安全类型（指针/切片/原子——安全代码不可见，S1.2 S1 全归 unsafe）
pub func is_unsafe_ty(t: i64) -> bool {
    var k = kind(t)
    if k == K_PTR || k == K_SLICE || k == K_ATOMIC {
        return true
    }
    return false
}

// 登记 struct 索引 -> 名字（语义阶段收集 struct 时调用；
// 追加式，索引 = 登记顺序，与语义 struct 表行号对应）。
pub func set_struct_name(idx: i64, nm: string) {
    while len(st_names) < idx {
        table_push(st_names, "")
    }
    table_push(st_names, nm)
}

// 登记 enum 索引 -> 名字（语义阶段收集 enum 时调用；追加式，
// 索引 = 登记顺序，与语义 enum 表行号对应）。
pub func set_enum_name(idx: i64, nm: string) {
    while len(en_names) < idx {
        table_push(en_names, "")
    }
    table_push(en_names, nm)
}

// 构建 TyKw 索引 -> 类型名表（懒构建，仅 type_name 使用）。
func ensure_tykw_names() {
    if len(tykw_names) > 0 {
        return
    }
    tykw_names = table_new_string()
    table_push(tykw_names, "i8")
    table_push(tykw_names, "i16")
    table_push(tykw_names, "i32")
    table_push(tykw_names, "i64")
    table_push(tykw_names, "u8")
    table_push(tykw_names, "u16")
    table_push(tykw_names, "u32")
    table_push(tykw_names, "u64")
    table_push(tykw_names, "f32")
    table_push(tykw_names, "f64")
    table_push(tykw_names, "bool")
    table_push(tykw_names, "trit")
    table_push(tykw_names, "char")
    table_push(tykw_names, "string")
    table_push(tykw_names, "void")
    table_push(tykw_names, "code")
    table_push(tykw_names, "num")
    table_push(tykw_names, "text")
    table_push(tykw_names, "misc")
    table_push(tykw_names, "table")
    table_push(tykw_names, "map")
    // 批次 2（i128/u128）：索引 21/22 对齐 TK_I128/TK_U128
    table_push(tykw_names, "i128")
    table_push(tykw_names, "u128")
    // P2b：索引 23 对齐 TK_ANY（异构表动态元素类型）
    table_push(tykw_names, "any")
}

}