type tie<class>
// compiler/middle/tieir_asm.tie —— p.9.21.9 片段组装消费（装配器，与 write_mod_slice 对偶）
// ============================================================
// 全模块片段缓存命中时，跳过 irgen+passes（片段 = pass 后 IR，键含 t 档），
// 按装配序把各模块 .tir 片段重放为完整单元 IR（ir/ir_meta 全局状态）。
//
// # 装配序（driver 注入 asm_from_slices 的 order 参数）
//   order = [主片段头部合成（actor thunk/dispatch，保序）] + [g_extra_tops 序
//   的函数全名（driver 复刻 tig_fn_def/tig_ns 取名）] + [主片段尾部合成]。
//   g_extra_tops 是源码级交错序（import 就地展开），片段拼接序不成立
//   （findings §8.4）。合成识别：主片段（模块 0）中不匹配 order 的函数，
//   首个匹配之前的为头部合成、其余为尾部合成（合成由 irgen 前置/后置生成，
//   在主片段函数序中位于两端）。
//
// # 重放与字节一致（findings §8.2/§8.3）
//   - ir 构造调用（new_func/new_block/new_inst/add_operand）按原创建序重放 →
//     值空间/块 id/指令 id/params_off/ops_off/block start-end 自然复现；
//   - 操作数映射：kind 0 值 → 片段内偏移（v - vbase）< 参数数 ? 全局参数值
//     （ir.param_val）: 全局结果值（重放时按偏移登记）；池载荷操作数①
//     （const_str(62)/const_f(51)/call(35)/extern_call(36)/call_vararg(41)）
//     与 kind 3（全局名）→ 片段池 id → 全局池 id（str_pool 幂等 intern）；
//     kind 1 块 → 片段块 lid → 全局块 id；kind 2 原样；
//   - exported 重放（ir.func_export_set）；span 按全局指令位写回（行序 =
//     片段指令序）；符号/导出段在真实产物中恒空（编译器零调用点）→ 段 4/6
//     自动一致；池段允许排列差异（分段口径，findings §8.2）；
//   - 解析防御：段 4/6 行数非 0、span 行数与指令数不符 → 拒绝（driver 降级
//     全量路径，响亮打印）。
//
// # 语言边界（同 tieir_slice）
//   - namespace tieir（import tieir_ser 文本内联合并 → rd_i64/rd_str/
//     rd_sec_head/set_err/str_pool/SEC_*/TIEIR_VERSION 私有可见）；
//   - 片段字节表只读；转存走本文件全局扁平表（per-片段基址索引）。
//
// 自检：探针工程装配 vs 全量 --tieir-out 分段 SHA 对比（操作台验收）。

import "./tieir_ser.tie"

// ---------- 转存表（per-片段基址索引；tie 无二维表，扁平 + 基址） ----------
var asm_f_base: table<i64>;      // 片段 → 函数记录基址（len = n+1）
var asm_f_gname: table<i64>;     // 函数记录 → 全局池 id
var asm_f_ret: table<i64>;
var asm_f_pcnt: table<i64>;
var asm_f_ex: table<i64>;
var asm_f_vbase: table<i64>;     // 片段值基址（解析回填）
var asm_f_pty_base: table<i64>;  // 函数 → 参数类型扁平基址
var asm_f_pty: table<i64>;
var asm_f_blk_base: table<i64>;  // 函数 → 块段基址（下标进 asm_fb_idx，见下）
var asm_f_blk_cnt: table<i64>;
// p.9.21.9 收口：块/指令的**按函数分组**索引（原实现假设「块表内同函数的块
// 连续」——闭包/嵌套生成会让同一函数的块在块表里交错，导致指令区间串到别的
// 函数、值偏移整体错位。改为显式分组：asm_fb_idx = 每函数的块记录下标段（
// 块表相对序保序），asm_bi_base/cnt = 每块记录的指令区间）。
var asm_fb_idx: table<i64>;      // 扁平：函数段 → 块记录下标（块表序）
var asm_bi_base: table<i64>;     // 块记录 → 指令记录基址
var asm_bi_cnt: table<i64>;      // 块记录 → 指令数
var asm_f_used: table<i64>;      // 装配序命中标记（0/1）
var asm_b_base: table<i64>;      // 片段 → 块记录基址
var asm_b_fid: table<i64>;       // 块记录 → 全局函数记录下标
var asm_b_gname: table<i64>;     // 块记录 → 全局池 id
var asm_b_gid: table<i64>;       // 块记录 → 重放后全局块 id
var asm_i_base: table<i64>;      // 片段 → 指令记录基址
var asm_i_op: table<i64>;
var asm_i_ty: table<i64>;
var asm_i_val: table<i64>;       // 片段结果值（-1 = 无）
var asm_i_cnt: table<i64>;
var asm_i_obase: table<i64>;     // 指令 → 操作数基址
var asm_o_v: table<i64>;         // 操作数载荷（值 = 片段值；池类 = 全局池 id；块 = 片段块 lid；立即数原样）
var asm_o_k: table<i64>;         // 操作数 kind（原样）
var asm_o_pool: table<i64>;      // 1 = 池载荷（载荷已是全局池 id）
var asm_pr_base: table<i64>;     // 片段 → 池 remap 基址
var asm_pr: table<i64>;          // 片段池 id → 全局池 id
var asm_frag_fn: table<i64>;     // 片段 → 函数数
// p.9.21.9 收口：值映射表（片段值 id → 重放后的全局 ir 值 id；-1 = 未登记）。
// 替代原「per-fn 结果表 + 偏移」算法——后者隐含「同函数的值域连续」假设，而
// 闭包/嵌套生成会让两个函数的值在原始值空间**交错**（父函数体生成途中生成
// 闭包函数 → 闭包的值插在父函数值中间），偏移算法必然错位（实测 driver 树
// str::trim_start 报「值操作数引用未登记结果」）。显式按值 id 建表则与交错
// 无关：片段值 id 是唯一键，登记即查。
var asm_vmap: table<i64>;
// p.9.21.9 收口：指令 gid 回执表（下标 = 指令记录；重放两趟法的中间态）。
// 两趟法动因：真实 IR 存在**前向值引用**（phi/合并类指令 op33、load op21 等
// 的操作数指向创建序更靠后的值——irgen 先建指令、后补操作数，离线核查 driver
// 片段共 910 处）。单趟「建指令即加操作数」必然撞未登记值 → 装配失败降级。
// 两趟：①建函数/块/指令（值登记进 asm_vmap）→ ②按指令序补操作数（此时值
// 全部就绪）。操作数表顺序与单趟一致（仍按指令序、指令内操作数序）。
var asm_i_gid: table<i64>;
var asm_seq: table<i64>;         // 装配序 → 函数记录下标
var asm_flag_sso: bool = false;   // 片段引用 s21_sso_* 全局（llvmgen.sso_enable 恢复用）
var asm_flag_wsock: bool = false; // 片段引用 @g_wsock_init
var asm_flag_catch: bool = false; // 片段引用 tie_panic_jb/active
// p.9.21.9 收口：装配路径的 irgen 副作用恢复素材——
//   asm_grefs = 片段引用的全局名（kind 3 操作数池 id，去重）→ driver 据此
//     恢复全局登记族（linux_args/msg/rng/循环哨兵）与做「登记完备」校验；
//   asm_exts  = 片段 extern_call(36) 的符号名池 id（去重）→ driver 据此恢复
//     链接判据（g_used_trmlite/g_used_interp）。二者均为池 id（全局域）。
var asm_grefs: table<i64>;
var asm_exts: table<i64>;

namespace tieir {

// 全局名归一化（去 '@' 前缀）：IR 里全局名带/不带前缀两种写法并存，
// 白名单比对（置位恢复/登记完备校验）一律按裸名。
func asm_bare_name(s: string) -> string {
    if str_len(s) > 1 && str_char(s, 0) == "@" {
        var out: string = ""
        var i: i64 = 1
        while i < str_len(s) {
            out = out + str_char(s, i)
            i = i + 1
        }
        return out
    }
    return s
}

// 池 id 去重入表（is_ref = true → 全局名引用表 asm_grefs；false → extern
// 符号表 asm_exts）。装配路径的 irgen 副作用恢复只关心「出现与否」，不关心序。
func asm_push_dedup(gpid: i64, is_ref: bool) {
    var t = asm_exts
    if is_ref {
        t = asm_grefs
    }
    var i: i64 = 0
    while i < len(t) {
        if t[i] == gpid {
            return
        }
        i = i + 1
    }
    table_push(t, gpid)
}

// 指令记录 → 所属片段号（两趟法第二趟按指令序补操作数时用）
func asm_inst_frag(gi: i64) -> i64 {
    var m: i64 = 0
    while m + 1 < len(asm_i_base) {
        if gi >= asm_i_base[m] && gi < asm_i_base[m + 1] {
            return m
        }
        m = m + 1
    }
    return 0
}

// 值映射表写入（按需增长，未登记槽 = -1）
func asm_vmap_set(idx: i64, v: i64) {
    while len(asm_vmap) <= idx {
        table_push(asm_vmap, -1)
    }
    asm_vmap[idx] = v
}

// 记录下标 → 所属片段号（基址表线性定位；片段数十级，代价可忽略）。
func asm_rec_frag(r: i64) -> i64 {
    var m: i64 = 0
    while m + 1 < len(asm_f_base) {
        if r >= asm_f_base[m] && r < asm_f_base[m + 1] {
            return m
        }
        m = m + 1
    }
    return 0
}

// ---------- 解析：片段 m 的字节表 → 转存 ----------
// 返回 0 成功；失败 set_err 返回 -1。
func asm_parse_slice(t: table<i64>, m: i64) -> i64 {
    tieir_pos = 5
    var ver = rd_i64(t)
    if tieir_err != "" { return -1 }
    if ver != TIEIR_VERSION {
        set_err("asm: 片段版本不兼容（" + to_string(ver) + "）")
        return -1
    }
    // 段 2：模块头（片段自述；装配不消费——跳过）
    if !rd_sec_head(t, SEC_HEAD) { return -1 }
    tieir_pos = tieir_sec_end
    // 段 3：池 → str_pool 全局 intern，记 remap
    if !rd_sec_head(t, SEC_STRPOOL) { return -1 }
    var pn = rd_i64(t)
    if tieir_err != "" { return -1 }
    if pn < 0 || pn > 1000000 {
        set_err("asm: 片段池大小非法（" + to_string(pn) + "）")
        return -1
    }
    asm_pr_base[m] = len(asm_pr)
    var q: i64 = 0
    while q < pn {
        var s = rd_str(t)
        if tieir_err != "" { return -1 }
        table_push(asm_pr, str_pool(s))
        q = q + 1
    }
    asm_pr_base[m + 1] = len(asm_pr)
    tieir_pos = tieir_sec_end
    // 段 4：符号表（真实产物恒空；非 0 拒绝）
    if !rd_sec_head(t, SEC_SYMTAB) { return -1 }
    var sn = rd_i64(t)
    if tieir_err != "" { return -1 }
    if sn != 0 {
        set_err("asm: 片段符号表非空（" + to_string(sn) + "）——超出装配支持的产物形态")
        return -1
    }
    tieir_pos = tieir_sec_end
    // 段 5：IR 主体转存
    if !rd_sec_head(t, SEC_IRBODY) { return -1 }
    var f_base = len(asm_f_gname)
    asm_f_base[m] = f_base
    var fn_n = rd_i64(t)
    if tieir_err != "" { return -1 }
    if fn_n < 0 || fn_n > 100000 {
        set_err("asm: 片段函数数非法（" + to_string(fn_n) + "）")
        return -1
    }
    asm_frag_fn[m] = fn_n
    var fi: i64 = 0
    while fi < fn_n {
        var fnm = rd_i64(t)
        var frt = rd_i64(t)
        var fpo = rd_i64(t)   // 片段布局值——重放自然复现，忽略
        var fpc = rd_i64(t)
        var fen = rd_i64(t)   // 入口块——重放自然复现，忽略
        var fit = rd_i64(t)   // inst_total——重放决定，忽略
        var fex = rd_i64(t)
        if tieir_err != "" { return -1 }
        if fnm < 0 || fnm >= pn {
            set_err("asm: 片段函数名池 id 越界（" + to_string(fnm) + "）")
            return -1
        }
        table_push(asm_f_gname, asm_pr[asm_pr_base[m] + fnm])
        table_push(asm_f_ret, frt)
        table_push(asm_f_pcnt, fpc)
        table_push(asm_f_ex, fex)
        table_push(asm_f_vbase, -1)
        table_push(asm_f_used, 0)
        table_push(asm_f_pty_base, len(asm_f_pty))
        table_push(asm_f_blk_base, -1)
        table_push(asm_f_blk_cnt, 0)
        var pk: i64 = 0
        while pk < fpc {
            var pt = rd_i64(t)
            if tieir_err != "" { return -1 }
            table_push(asm_f_pty, pt)
            pk = pk + 1
        }
        fi = fi + 1
    }
    // 块表（块表序 = 函数分组连续 → per-fn base 首现即起点，cnt 累计）
    var b_base = len(asm_b_fid)
    asm_b_base[m] = b_base
    var blk_n = rd_i64(t)
    if tieir_err != "" { return -1 }
    if blk_n < 0 || blk_n > 1000000 {
        set_err("asm: 片段块数非法（" + to_string(blk_n) + "）")
        return -1
    }
    var bi: i64 = 0
    while bi < blk_n {
        var bfn = rd_i64(t)   // 片段内函数 lid
        var bnm = rd_i64(t)
        var bst = rd_i64(t)   // start——重放自然复现，忽略
        var ben = rd_i64(t)   // end——重放自然复现，忽略
        if tieir_err != "" { return -1 }
        if bfn < 0 || bfn >= fn_n || bnm < 0 || bnm >= pn {
            set_err("asm: 片段块记录越界（fn=" + to_string(bfn) + " nm=" + to_string(bnm) + "）")
            return -1
        }
        var frec = f_base + bfn
        asm_f_blk_cnt[frec] = asm_f_blk_cnt[frec] + 1
        table_push(asm_b_fid, frec)
        table_push(asm_b_gname, asm_pr[asm_pr_base[m] + bnm])
        table_push(asm_b_gid, -1)
        table_push(asm_bi_base, -1)
        table_push(asm_bi_cnt, 0)
        bi = bi + 1
    }
    asm_b_base[m + 1] = len(asm_b_fid)
    // 按函数分组（前缀和定段 + 二次填位）：块表内同函数的块**可能交错**
    // （闭包/嵌套生成），显式分组保证后续按函数遍历取到本函数的块与指令。
    var fb_cur: table<i64> = table_new_i64()
    var fb_i: i64 = 0
    while fb_i < fn_n {
        table_push(fb_cur, 0)
        fb_i = fb_i + 1
    }
    var fb_cum: i64 = len(asm_fb_idx)
    fb_i = 0
    while fb_i < fn_n {
        asm_f_blk_base[f_base + fb_i] = fb_cum
        fb_cum = fb_cum + asm_f_blk_cnt[f_base + fb_i]
        fb_i = fb_i + 1
    }
    fb_i = 0
    while fb_i < blk_n {
        table_push(asm_fb_idx, -1)
        fb_i = fb_i + 1
    }
    var bi2 = b_base
    while bi2 < b_base + blk_n {
        var fr2 = asm_b_fid[bi2]
        var li = fr2 - f_base
        var pos = asm_f_blk_base[fr2] + fb_cur[li]
        asm_fb_idx[pos] = bi2
        fb_cur[li] = fb_cur[li] + 1
        bi2 = bi2 + 1
    }
    // 指令表（指令序 = 块序 → 函数分组连续；per-fn base 首现 + cnt 累计）
    var i_base = len(asm_i_op)
    asm_i_base[m] = i_base
    var ins_n = rd_i64(t)
    if tieir_err != "" { return -1 }
    if ins_n < 0 || ins_n > 10000000 {
        set_err("asm: 片段指令数非法（" + to_string(ins_n) + "）")
        return -1
    }
    var ii: i64 = 0
    while ii < ins_n {
        var own = rd_i64(t)   // 片段内块 lid
        var iop = rd_i64(t)
        var ity = rd_i64(t)
        var ivl = rd_i64(t)
        var iof = rd_i64(t)   // ops_off——重放自然复现，忽略
        var icn = rd_i64(t)
        if tieir_err != "" { return -1 }
        if own < 0 || own >= blk_n || icn < 0 || icn > 100000 {
            set_err("asm: 片段指令记录越界（blk=" + to_string(own) + "）")
            return -1
        }
        var brec = b_base + own
        if asm_bi_base[brec] < 0 {
            asm_bi_base[brec] = len(asm_i_op)
        }
        asm_bi_cnt[brec] = asm_bi_cnt[brec] + 1
        table_push(asm_i_op, iop)
        table_push(asm_i_ty, ity)
        table_push(asm_i_val, ivl)
        table_push(asm_i_cnt, icn)
        table_push(asm_i_obase, len(asm_o_v))
        var okk: i64 = 0
        while okk < icn {
            var ov = rd_i64(t)
            var okd = rd_i64(t)
            if tieir_err != "" { return -1 }
            // 池载荷判定（与 write_mod_slice/deserialize 对齐）
            var is_pool = 0
            if okd == 3 {
                is_pool = 1
            }
            if okd == 0 && okk == 0 {
                if iop == 62 || iop == 51 || iop == 35 || iop == 36 || iop == 41 {
                    is_pool = 1
                }
            }
            if is_pool == 1 {
                if ov < 0 || ov >= pn {
                    set_err("asm: 片段池载荷越界（" + to_string(ov) + "）")
                    return -1
                }
                var gpid = asm_pr[asm_pr_base[m] + ov]
                // llvmgen 置位副作用恢复：白名单全局名引用 → enable 旗标
                //（irgen 生成引用时置位；装配路径经此处等价恢复）
                // 全局名在 IR 里有两种写法（irgen 多数点带 '@' 前缀，少数据点
                // 直存裸名）→ 比对前统一归一化去前缀。
                var gnm = asm_bare_name(interner.name_str(gpid))
                if gnm == "s21_sso_pool" || gnm == "s21_sso_off" || gnm == "s21_sso_malloc_cnt" {
                    asm_flag_sso = true
                }
                if gnm == "g_wsock_init" {
                    asm_flag_wsock = true
                }
                if gnm == "tie_panic_jb" || gnm == "tie_panic_active" {
                    asm_flag_catch = true
                }
                // p.9.21.9 收口：登记族恢复素材收集（去重）
                if okd == 3 {
                    asm_push_dedup(gpid, true)
                }
                if iop == 36 && okk == 0 {
                    asm_push_dedup(gpid, false)
                }
                table_push(asm_o_v, gpid)
            } else {
                table_push(asm_o_v, ov)
            }
            table_push(asm_o_k, okd)
            table_push(asm_o_pool, is_pool)
            // vbase 回填已移除：原「观测最小值」口径在参数未被任何操作数/结果
            // 引用时会偏大 → 值偏移整体错位（driver 树实测 str::trim_start 等）。
            // 改由指令表解析后按 vsize = 参数数 + 结果数 逐函数累计精确重算
            //（见 asm_parse_slice 末尾）。
            okk = okk + 1
        }
        ii = ii + 1
    }
    asm_i_base[m + 1] = len(asm_i_op)
    // 每函数值基址重算（p.9.21.9 收口）：write_mod_slice 的 f_vbase = 选中函数
    // 值空间累计（**含参数**），而解析期「观测最小值」在参数未被任何操作数/
    // 结果引用时会偏大 → 值偏移整体错位（装配报「值操作数引用未登记结果」或
    // 把结果误当参数）。按 vsize = 参数数 + 结果数 逐函数累计精确复现
    //（与 write_mod_slice 的 vcum 同式；每片段从 0 起算）。
    var cum: i64 = 0
    var ri = f_base
    while ri < f_base + fn_n {
        asm_f_vbase[ri] = cum
        var nres: i64 = 0
        var kb: i64 = 0
        while kb < asm_f_blk_cnt[ri] {
            var brec2 = asm_fb_idx[asm_f_blk_base[ri] + kb]
            var ib2 = asm_bi_base[brec2]
            var ic: i64 = 0
            while ic < asm_bi_cnt[brec2] {
                if asm_i_val[ib2 + ic] >= 0 {
                    nres = nres + 1
                }
                ic = ic + 1
            }
            kb = kb + 1
        }
        cum = cum + asm_f_pcnt[ri] + nres
        ri = ri + 1
    }
    tieir_pos = tieir_sec_end
    // 段 6：导出表（真实产物恒空；非 0 拒绝）
    if !rd_sec_head(t, SEC_EXPORT) { return -1 }
    var en = rd_i64(t)
    if tieir_err != "" { return -1 }
    if en != 0 {
        set_err("asm: 片段导出表非空（" + to_string(en) + "）")
        return -1
    }
    tieir_pos = tieir_sec_end
    // 段 7：span 段（行序 = 片段指令序；重放按全局指令位写回）
    if !rd_sec_head(t, SEC_SPAN) { return -1 }
    var spn = rd_i64(t)
    if tieir_err != "" { return -1 }
    if spn != ins_n {
        set_err("asm: 片段 span 行数与指令数不符（" + to_string(spn) + "/" + to_string(ins_n) + "）")
        return -1
    }
    // 片段 span = write_mod_slice 写入的全 0 冗余（真实编译产物 span 段恒空
    // ——ir_meta.set_inst_span 在编译器无调用点）；装配不转存、不写回。
    tieir_pos = tieir_sec_end
    return 0
}

// ---------- 装配序确定 ----------
// order = driver 注入的 g_extra_tops 序函数全名。合成函数（主片段中不匹配
// order 者）按首/尾分段。填充 asm_seq = [head] + [order 命中] + [tail]。
// 返回 0 成功；失败 set_err 返回 -1。
func asm_build_seq(order: table<string>) -> i64 {
    var head: table<i64> = table_new_i64()
    var tail: table<i64> = table_new_i64()
    var matched: table<i64> = table_new_i64()
    var f0 = asm_f_base[0]
    var f0_end = asm_f_base[1]
    var seen_match: bool = false
    var fi = f0
    while fi < f0_end {
        var nm = interner.name_str(asm_f_gname[fi])
        var is_m: bool = false
        var oi: i64 = 0
        while oi < len(order) {
            if order[oi] == nm {
                is_m = true
            }
            oi = oi + 1
        }
        if is_m {
            seen_match = true
        } else {
            if seen_match {
                table_push(tail, fi)
            } else {
                table_push(head, fi)
            }
        }
        fi = fi + 1
    }
    // order 序：每名找未用记录（全局线性查——native 下可接受）
    var oi2: i64 = 0
    while oi2 < len(order) {
        var found = -1
        var fi2 = asm_f_base[0]
        var fend = asm_f_base[len(asm_frag_fn)]
        while fi2 < fend {
            if asm_f_used[fi2] == 0 && interner.name_str(asm_f_gname[fi2]) == order[oi2] {
                found = fi2
                fi2 = fend
            }
            fi2 = fi2 + 1
        }
        if found >= 0 {
            asm_f_used[found] = 1
            table_push(matched, found)
        }
        // 未找到 = 模板声明等不产 IR 的项——跳过
        oi2 = oi2 + 1
    }
    var hi: i64 = 0
    while hi < len(head) {
        table_push(asm_seq, head[hi])
        hi = hi + 1
    }
    var mi: i64 = 0
    while mi < len(matched) {
        table_push(asm_seq, matched[mi])
        mi = mi + 1
    }
    var ti: i64 = 0
    while ti < len(tail) {
        table_push(asm_seq, tail[ti])
        ti = ti + 1
    }
    // 全覆盖校验：全部函数记录必须进入装配序（head/tail/used 三者之一）
    var fi3 = asm_f_base[0]
    var fend3 = asm_f_base[len(asm_frag_fn)]
    while fi3 < fend3 {
        if asm_f_used[fi3] == 0 {
            var in_head: bool = false
            var in_tail: bool = false
            var s1: i64 = 0
            while s1 < len(head) {
                if head[s1] == fi3 {
                    in_head = true
                }
                s1 = s1 + 1
            }
            var s2: i64 = 0
            while s2 < len(tail) {
                if tail[s2] == fi3 {
                    in_tail = true
                }
                s2 = s2 + 1
            }
            if !in_head && !in_tail {
                set_err("asm: 函数未被装配序覆盖（" + interner.name_str(asm_f_gname[fi3]) + "）")
                return -1
            }
        }
        fi3 = fi3 + 1
    }
    return 0
}

// ---------- 重放 ----------
// 按 asm_seq 把片段记录重放为 ir 全局状态。返回 0 成功；失败 set_err -1。
func asm_replay() -> i64 {
    ir.new_module()
    ir_meta.reset_meta()
    // 指令 gid 回执表（先占位，第一趟填）
    asm_i_gid = table_new_i64()
    var gi0: i64 = 0
    while gi0 < len(asm_i_op) {
        table_push(asm_i_gid, -1)
        gi0 = gi0 + 1
    }
    var k: i64 = 0
    while k < len(asm_seq) {
        var r = asm_seq[k]
        var pc = asm_f_pcnt[r]
        var ptys: table<i64> = table_new_i64()
        var j: i64 = 0
        while j < pc {
            table_push(ptys, asm_f_pty[asm_f_pty_base[r] + j])
            j = j + 1
        }
        var fid = ir.new_func(asm_f_gname[r], asm_f_ret[r], ptys)
        ir.func_export_set(fid, asm_f_ex[r])
        // 参数值登记（片段值域：f_vbase[r] + j；与 write_mod_slice 的 f_vbase
        // 同式——参数在 new_func 时连续领号，必落在 [vbase, vbase+pc)）
        var pj: i64 = 0
        while pj < pc {
            asm_vmap_set(asm_f_vbase[r] + pj, ir.param_val(fid, pj))
            pj = pj + 1
        }
        // 块重放（按函数分组段；段内即块表相对序 = 原创建序）
        var bb = asm_f_blk_base[r]
        var b: i64 = 0
        while b < asm_f_blk_cnt[r] {
            var brec = asm_fb_idx[bb + b]
            asm_b_gid[brec] = ir.new_block(fid, asm_b_gname[brec])
            b = b + 1
        }
        // 指令重放（逐块：块段序 → 块内指令序；建指令即补操作数）。
        // 单趟不可改两趟：ir.add_operand 断言操作数段紧接段尾（ops_off 在
        // new_inst 时定），延迟补会撞「操作数段交错」panic。前向引用无解
        // 的单元由 write_mod_slice 的区间单调护栏拒写片段（见 tieir_slice）。
        b = 0
        while b < asm_f_blk_cnt[r] {
            var brec3 = asm_fb_idx[bb + b]
            var ib = asm_bi_base[brec3]
            var i: i64 = 0
            while i < asm_bi_cnt[brec3] {
                var gid = ir.new_inst(asm_b_gid[brec3], asm_i_op[ib + i], asm_i_ty[ib + i])
                asm_i_gid[ib + i] = gid
                var vv = asm_i_val[ib + i]
                if vv >= 0 {
                    asm_vmap_set(vv, ir.get_value(gid))
                }
                var ok: i64 = 0
                while ok < asm_i_cnt[ib + i] {
                    var idx = asm_i_obase[ib + i] + ok
                    var ov = asm_o_v[idx]
                    var okd = asm_o_k[idx]
                    if asm_o_pool[idx] == 1 {
                        ir.add_operand(gid, ov, okd)
                    } else {
                        if okd == 0 {
                            // 值操作数：片段值 id 直查映射表（与值域是否交错无关）
                            if ov < 0 || ov >= len(asm_vmap) || asm_vmap[ov] < 0 {
                                set_err("asm: 值操作数未登记（fn " + interner.name_str(asm_f_gname[r]) + " v=" + to_string(ov) + "）")
                                return -1
                            }
                            ov = asm_vmap[ov]
                        } else {
                            if okd == 1 {
                                // 块操作数载荷 = **片段内块 lid**（write_mod_slice
                                // 写 blk_new[ov]，跨本片段全部选中函数连续编号），
                                // 与指令属块同域——按片段块表基址定位。
                                var fm = asm_rec_frag(r)
                                if ov < 0 || asm_b_base[fm] + ov >= asm_b_base[fm + 1] {
                                    set_err("asm: 块操作数越界（fn " + interner.name_str(asm_f_gname[r]) + " lid=" + to_string(ov) + "）")
                                    return -1
                                }
                                ov = asm_b_gid[asm_b_base[fm] + ov]
                            }
                        }
                        ir.add_operand(gid, ov, okd)
                    }
                    ok = ok + 1
                }
                i = i + 1
            }
            b = b + 1
        }
        k = k + 1
    }
    return 0
}

// ---------- 入口 ----------
// paths = 全部模块片段路径（模块序）；order = driver 注入的装配序全名。
// 返回 0 成功（ir/ir_meta 已就绪）；失败 set_err -1（driver 降级全量）。
// llvmgen 置位恢复查询（driver 装配成功后据此刻调 sso/wsock/catch_enable——
// 与 irgen 生成引用时的置位等价；白名单对齐 llvmgen_inst_p1）。
pub func asm_flag_sso() -> bool { return asm_flag_sso }
pub func asm_flag_wsock() -> bool { return asm_flag_wsock }
pub func asm_flag_catch() -> bool { return asm_flag_catch }
// p.9.21.9 收口：装配路径副作用恢复素材（池 id，driver 侧 interner.name_str 取文本）
pub func asm_gref_count() -> i64 { return len(asm_grefs) }
pub func asm_gref_id(i: i64) -> i64 { return asm_grefs[i] }
pub func asm_ext_count() -> i64 { return len(asm_exts) }
pub func asm_ext_id(i: i64) -> i64 { return asm_exts[i] }

pub func asm_from_slices(paths: table<string>, order: table<string>) -> i64 {
    var n = len(paths)
    if n == 0 {
        set_err("asm: 空片段表")
        return -1
    }
    // 复位转存表
    asm_f_base = table_new_i64()
    asm_f_gname = table_new_i64()
    asm_f_ret = table_new_i64()
    asm_f_pcnt = table_new_i64()
    asm_f_ex = table_new_i64()
    asm_f_vbase = table_new_i64()
    asm_f_pty_base = table_new_i64()
    asm_f_pty = table_new_i64()
    asm_f_blk_base = table_new_i64()
    asm_f_blk_cnt = table_new_i64()
    asm_fb_idx = table_new_i64()
    asm_bi_base = table_new_i64()
    asm_bi_cnt = table_new_i64()
    asm_f_used = table_new_i64()
    asm_b_base = table_new_i64()
    asm_b_fid = table_new_i64()
    asm_b_gname = table_new_i64()
    asm_b_gid = table_new_i64()
    asm_i_base = table_new_i64()
    asm_i_op = table_new_i64()
    asm_i_ty = table_new_i64()
    asm_i_val = table_new_i64()
    asm_i_cnt = table_new_i64()
    asm_i_obase = table_new_i64()
    asm_o_v = table_new_i64()
    asm_o_k = table_new_i64()
    asm_o_pool = table_new_i64()
    asm_pr_base = table_new_i64()
    asm_pr = table_new_i64()
    asm_frag_fn = table_new_i64()
    asm_vmap = table_new_i64()
    asm_i_gid = table_new_i64()
    asm_seq = table_new_i64()
    asm_grefs = table_new_i64()
    asm_exts = table_new_i64()
    asm_flag_sso = false
    asm_flag_wsock = false
    asm_flag_catch = false
    var m: i64 = 0
    while m < n {
        var t = bytes.read(paths[m])
        if len(t) == 0 {
            set_err("asm: 片段读取失败: " + paths[m])
            return -1
        }
        if asm_parse_slice(t, m) != 0 {
            return -1
        }
        m = m + 1
    }
    // 尾哨兵（per-片段基址表统一长度 n+1）
    asm_f_base[n] = len(asm_f_gname)
    asm_f_pty_base[n] = len(asm_f_pty)
    if asm_build_seq(order) != 0 {
        return -1
    }
    if asm_replay() != 0 {
        return -1
    }
    // 全覆盖：重放函数数 == 全部片段函数数
    var total: i64 = 0
    m = 0
    while m < n {
        total = total + asm_frag_fn[m]
        m = m + 1
    }
    if ir.func_count() != total {
        set_err("asm: 重放函数数不符（" + to_string(ir.func_count()) + "/" + to_string(total) + "）")
        return -1
    }
    return 0
}

}   // namespace tieir
