type tie<class>
// compiler/middle/tieir_asm.tie —— p.9.21.9 片段组装消费（装配器，与 write_mod_slice 对偶）
// ============================================================
// 全模块片段缓存命中时，跳过 irgen+passes（片段 = pass 后 IR，键含 t 档），
// 按装配序把各模块 .tir 片段重放为完整单元 IR（ir/ir_meta 全局状态）。
//
// # 装配序（driver 注入 asm_from_slices 的 order 参数）
//   order = [主片段头部合成（actor thunk/dispatch，保序）] + [g_extra_tops 序
//   的函数全名（driver 复刻 tig_fn_def/tig_ns 取名）] + [主片段尾部合成]。
//   g_extra_tops 是源码级交错序（import 就地展开），片段拼接序不成立
//   （findings §8.4）。合成识别：主片段（模块 0）中不匹配 order 的函数，
//   首个匹配之前的为头部合成、其余为尾部合成（合成由 irgen 前置/后置生成，
//   在主片段函数序中位于两端）。
//
// # 重放与字节一致（findings §8.2/§8.3）
//   - ir 构造调用（new_func/new_block/new_inst/add_operand）按原创建序重放 →
//     值空间/块 id/指令 id/params_off/ops_off/block start-end 自然复现；
//   - 操作数映射：kind 0 值 → 片段内偏移（v - vbase）< 参数数 ? 全局参数值
//     （ir.param_val）: 全局结果值（重放时按偏移登记）；池载荷操作数①
//     （const_str(62)/const_f(51)/call(35)/extern_call(36)/call_vararg(41)）
//     与 kind 3（全局名）→ 片段池 id → 全局池 id（str_pool 幂等 intern）；
//     kind 1 块 → 片段块 lid → 全局块 id；kind 2 原样；
//   - exported 重放（ir.func_export_set）；span 按全局指令位写回（行序 =
//     片段指令序）；符号/导出段在真实产物中恒空（编译器零调用点）→ 段 4/6
//     自动一致；池段允许排列差异（分段口径，findings §8.2）；
//   - 解析防御：段 4/6 行数非 0、span 行数与指令数不符 → 拒绝（driver 降级
//     全量路径，响亮打印）。
//
// # 语言边界（同 tieir_slice）
//   - namespace tieir（import tieir_ser 文本内联合并 → rd_i64/rd_str/
//     rd_sec_head/set_err/str_pool/SEC_*/TIEIR_VERSION 私有可见）；
//   - 片段字节表只读；转存走本文件全局扁平表（per-片段基址索引）。
//
// 自检：探针工程装配 vs 全量 --tieir-out 分段 SHA 对比（操作台验收）。

import "./tieir_ser.tie"
import "./tieir_fmt_v3.tie"

// ---------- 元数据转存（v3：片段头/sym/exp 不再拒收，重放回 ir_meta） ----------
var asm_m_pkg: table<i64>;       // 片段 → 包名池 id（set_pkg_name）
var asm_m_ver: table<i64>;       // 片段 → 版本串池 id（set_pkg_version）
var asm_m_irver: table<i64>;     // 片段 → ir 版本
var asm_m_topt: table<i64>;      // 片段 → t 档
var asm_m_pver: table<i64>;      // 片段 → pass 版本
var asm_m_cver: table<i64>;      // 片段 → 编译器版本串池 id
var asm_m_dep_base: table<i64>;  // 片段 → 依赖对基址（len = n+1）
var asm_m_dep: table<i64>;       // 扁平依赖对 [name_pid, ver_pid, ...]
var asm_sym_base: table<i64>;    // 片段 → sym 行基址（len = n+1）
var asm_sym: table<i64>;         // 扁平 sym 行 [name_pid, sig_pid, kind, vis, line, col]
var asm_exp_base: table<i64>;    // 片段 → exp 行基址（len = n+1）
var asm_exp: table<i64>;         // 扁平 exp 行 [name_pid, sig_pid, line, col]

// ---------- 转存表（per-片段基址索引；tie 无二维表，扁平 + 基址） ----------
var asm_f_base: table<i64>;      // 片段 → 函数记录基址（len = n+1）
var asm_f_gname: table<i64>;     // 函数记录 → 全局池 id
var asm_f_ret: table<i64>;
var asm_f_pcnt: table<i64>;
var asm_f_ex: table<i64>;
var asm_f_vbase: table<i64>;     // 片段值基址（解析回填）
var asm_f_pty_base: table<i64>;  // 函数 → 参数类型扁平基址
var asm_f_pty: table<i64>;
var asm_f_blk_base: table<i64>;  // 函数 → 块段基址（下标进 asm_fb_idx，见下）
var asm_f_blk_cnt: table<i64>;
// p.9.21.9 收口：块/指令的**按函数分组**索引（原实现假设「块表内同函数的块
// 连续」——闭包/嵌套生成会让同一函数的块在块表里交错，导致指令区间串到别的
// 函数、值偏移整体错位。改为显式分组：asm_fb_idx = 每函数的块记录下标段（
// 块表相对序保序），asm_bi_base/cnt = 每块记录的指令区间）。
var asm_fb_idx: table<i64>;      // 扁平：函数段 → 块记录下标（块表序）
var asm_bi_base: table<i64>;     // 块记录 → 指令记录基址
var asm_bi_cnt: table<i64>;      // 块记录 → 指令数
var asm_i_blk: table<i64>;       // 指令记录 → 全局块记录下标（重放单趟挂块用）
var asm_f_used: table<i64>;      // 装配序命中标记（0/1）
var asm_b_base: table<i64>;      // 片段 → 块记录基址
var asm_b_fid: table<i64>;       // 块记录 → 全局函数记录下标
var asm_b_gname: table<i64>;     // 块记录 → 全局池 id
var asm_b_gid: table<i64>;       // 块记录 → 重放后全局块 id
var asm_i_base: table<i64>;      // 片段 → 指令记录基址
var asm_i_op: table<i64>;
var asm_i_ty: table<i64>;
var asm_i_val: table<i64>;       // 片段结果值（-1 = 无）
var asm_i_cnt: table<i64>;
var asm_i_obase: table<i64>;     // 指令 → 操作数基址
var asm_o_v: table<i64>;         // 操作数载荷（值 = 片段值；池类 = 全局池 id；块 = 片段块 lid；立即数原样）
var asm_o_k: table<i64>;         // 操作数 kind（原样）
var asm_o_pool: table<i64>;      // 1 = 池载荷（载荷已是全局池 id）
var asm_pr_base: table<i64>;     // 片段 → 池 remap 基址
var asm_pr: table<i64>;          // 片段池 id → 全局池 id
var asm_frag_fn: table<i64>;     // 片段 → 函数数
// p.9.21.9 收口：值映射表（片段值 id → 重放后的全局 ir 值 id；-1 = 未登记）。
// 替代原「per-fn 结果表 + 偏移」算法——后者隐含「同函数的值域连续」假设，而
// 闭包/嵌套生成会让两个函数的值在原始值空间**交错**（父函数体生成途中生成
// 闭包函数 → 闭包的值插在父函数值中间），偏移算法必然错位（实测 driver 树
// str::trim_start 报「值操作数引用未登记结果」）。显式按值 id 建表则与交错
// 无关：片段值 id 是唯一键，登记即查。
var asm_vmap: table<i64>;
// p.9.21.10：每片段值空间的全局基址——各片段值 id 独立从 0 压缩，vmap 是
// 全局键空间，必须加片段基址才唯一（否则跨片段键碰撞 → 装配错值）。
var asm_frag_vbase: table<i64>;
var asm_frag_vtotal: i64 = 0;    // 此前各片段值空间大小的全局累计
// p.9.21.9 收口：指令 gid 回执表（下标 = 指令记录；重放两趟法的中间态）。
// 两趟法动因：真实 IR 存在**前向值引用**（phi/合并类指令 op33、load op21 等
// 的操作数指向创建序更靠后的值——irgen 先建指令、后补操作数，离线核查 driver
// 片段共 910 处）。单趟「建指令即加操作数」必然撞未登记值 → 装配失败降级。
// 两趟：①建函数/块/指令（值登记进 asm_vmap）→ ②按指令序补操作数（此时值
// 全部就绪）。操作数表顺序与单趟一致（仍按指令序、指令内操作数序）。
var asm_i_gid: table<i64>;
var asm_seq: table<i64>;         // 装配序 → 函数记录下标
var asm_flag_sso: bool = false;   // 片段引用 s21_sso_* 全局（llvmgen.sso_enable 恢复用）
var asm_flag_wsock: bool = false; // 片段引用 @g_wsock_init
var asm_flag_catch: bool = false; // 片段引用 tie_panic_jb/active
var asm_flag_sc: bool = false;    // 片段 call @tie_sc_off（str_char 缓存 helper）
// p.9.21.9 收口：装配路径的 irgen 副作用恢复素材——
//   asm_grefs = 片段引用的全局名（kind 3 操作数池 id，去重）→ driver 据此
//     恢复全局登记族（linux_args/msg/rng/循环哨兵）与做「登记完备」校验；
//   asm_exts  = 片段 extern_call(36) 的符号名池 id（去重）→ driver 据此恢复
//     链接判据（g_used_trmlite/g_used_interp）。二者均为池 id（全局域）。
var asm_grefs: table<i64>;
var asm_exts: table<i64>;

namespace tieir {

// 全局名归一化（去 '@' 前缀）：IR 里全局名带/不带前缀两种写法并存，
// 白名单比对（置位恢复/登记完备校验）一律按裸名。
// p.9.21.11：单字符循环拼接 O(n²) → str_sub_bytes 单次拷贝（池载荷操作数
// 热路径，每池引用一次；'@' 后必为 ASCII 标识符，码点数 = 字节数）。
func asm_bare_name(s: string) -> string {
    if str_len(s) > 1 && str_byte(s, 0) == 64 {   // '@'
        return str_sub_bytes(s, 1, str_len(s))
    }
    return s
}

// 池 id 去重入表（is_ref = true → 全局名引用表 asm_grefs；false → extern
// 符号表 asm_exts）。装配路径的 irgen 副作用恢复只关心「出现与否」，不关心序。
func asm_push_dedup(gpid: i64, is_ref: bool) {
    var t = asm_exts
    if is_ref {
        t = asm_grefs
    }
    var i: i64 = 0
    while i < len(t) {
        if t[i] == gpid {
            return
        }
        i = i + 1
    }
    table_push(t, gpid)
}

// 指令记录 → 所属片段号（两趟法第二趟按指令序补操作数时用）
func asm_inst_frag(gi: i64) -> i64 {
    var m: i64 = 0
    while m + 1 < len(asm_i_base) {
        if gi >= asm_i_base[m] && gi < asm_i_base[m + 1] {
            return m
        }
        m = m + 1
    }
    return 0
}

// 值映射表写入（按需增长，未登记槽 = -1）
func asm_vmap_set(idx: i64, v: i64) {
    while len(asm_vmap) <= idx {
        table_push(asm_vmap, -1)
    }
    asm_vmap[idx] = v
}

// 记录下标 → 所属片段号（基址表线性定位；片段数十级，代价可忽略）。
func asm_rec_frag(r: i64) -> i64 {
    var m: i64 = 0
    while m + 1 < len(asm_f_base) {
        if r >= asm_f_base[m] && r < asm_f_base[m + 1] {
            return m
        }
        m = m + 1
    }
    return 0
}

// ---------- 解析：片段 m 的字节表 → 转存（v3 格式，见 tieir_fmt_v3 头注） ----------
// 返回 0 成功；失败 set_err 返回 -1。
func asm_parse_slice(t: table<i64>, m: i64) -> i64 {
    tieir_pos = 5
    var ver = rd_u32(t)
    if tieir_err != "" { return -1 }
    if ver != SLICE_VERSION {
        set_err("asm: 片段版本不兼容（" + to_string(ver) + "，须 " + to_string(SLICE_VERSION) + "；盐 bump 前的旧片段应已整体失效）")
        return -1
    }
    // 段 2：模块头（片段自述；转存供重放回 ir_meta）
    if !rd_sec3_head(t, SEC_HEAD) { return -1 }
    var h_pkg = rd_str3(t)
    if tieir_err != "" { return -1 }
    var h_ver = rd_str3(t)
    if tieir_err != "" { return -1 }
    var h_irver = rd_u32(t)
    if tieir_err != "" { return -1 }
    var h_cver = rd_str3(t)
    if tieir_err != "" { return -1 }
    var h_topt = rd_u32(t)
    if tieir_err != "" { return -1 }
    var h_pver = rd_u32(t)
    if tieir_err != "" { return -1 }
    var h_depc = rd_u32(t)
    if tieir_err != "" { return -1 }
    if h_depc > 100000 {
        set_err("asm: 片段依赖数非法（" + to_string(h_depc) + "）")
        return -1
    }
    asm_m_pkg[m] = str_pool(h_pkg)
    asm_m_ver[m] = str_pool(h_ver)
    asm_m_irver[m] = h_irver
    asm_m_topt[m] = h_topt
    asm_m_pver[m] = h_pver
    asm_m_cver[m] = str_pool(h_cver)
    asm_m_dep_base[m] = len(asm_m_dep)
    var hd: i64 = 0
    while hd < h_depc {
        var dn = rd_str3(t)
        if tieir_err != "" { return -1 }
        var dv = rd_str3(t)
        if tieir_err != "" { return -1 }
        table_push(asm_m_dep, str_pool(dn))
        table_push(asm_m_dep, str_pool(dv))
        hd = hd + 1
    }
    tieir_pos = tieir_sec_end
    // 段 3：池 → str_pool 全局 intern，记 remap
    if !rd_sec3_head(t, SEC_STRPOOL) { return -1 }
    var pn = rd_u32(t)
    if tieir_err != "" { return -1 }
    if pn > 1000000 {
        set_err("asm: 片段池大小非法（" + to_string(pn) + "）")
        return -1
    }
    asm_pr_base[m] = len(asm_pr)
    var q: i64 = 0
    while q < pn {
        var s = rd_str3(t)
        if tieir_err != "" { return -1 }
        table_push(asm_pr, str_pool(s))
        q = q + 1
    }
    asm_pr_base[m + 1] = len(asm_pr)
    tieir_pos = tieir_sec_end
    // 段 4：符号表（转存重放；池 id 就地映射为全局 id）
    if !rd_sec3_head(t, SEC_SYMTAB) { return -1 }
    var sn = rd_u32(t)
    if tieir_err != "" { return -1 }
    if sn > 100000 {
        set_err("asm: 片段符号表非法（" + to_string(sn) + "）")
        return -1
    }
    asm_sym_base[m] = len(asm_sym)
    var sy: i64 = 0
    while sy < sn {
        var snm = rd_u32(t)
        var ssg = rd_u32(t)
        var skd = rd_u32(t)
        var svs = rd_u32(t)
        var sln = rd_u32p1(t)
        var scl = rd_u32p1(t)
        if tieir_err != "" { return -1 }
        if snm >= pn || ssg >= pn {
            set_err("asm: 片段符号池 id 越界（" + to_string(snm) + "/" + to_string(ssg) + "）")
            return -1
        }
        table_push(asm_sym, asm_pr[asm_pr_base[m] + snm])
        table_push(asm_sym, asm_pr[asm_pr_base[m] + ssg])
        table_push(asm_sym, skd)
        table_push(asm_sym, svs)
        table_push(asm_sym, sln)
        table_push(asm_sym, scl)
        sy = sy + 1
    }
    tieir_pos = tieir_sec_end
    // 段 5：IR 主体转存
    if !rd_sec3_head(t, SEC_IRBODY) { return -1 }
    var f_base = len(asm_f_gname)
    asm_f_base[m] = f_base
    var fn_n = rd_u32(t)
    if tieir_err != "" { return -1 }
    if fn_n > 100000 {
        set_err("asm: 片段函数数非法（" + to_string(fn_n) + "）")
        return -1
    }
    asm_frag_fn[m] = fn_n
    var fi: i64 = 0
    while fi < fn_n {
        var fnm = rd_u32(t)
        var frt = rd_u32p1(t)
        var fpo = rd_u32(t)   // 片段布局值——重放自然复现，忽略
        var fpc = rd_u32(t)
        var fen = rd_u32p1(t) // 入口块——重放自然复现，忽略
        var fit = rd_u32(t)   // inst_total——重放决定，忽略
        var fex = rd_u32(t)
        if tieir_err != "" { return -1 }
        if fnm >= pn {
            set_err("asm: 片段函数名池 id 越界（" + to_string(fnm) + "）")
            return -1
        }
        table_push(asm_f_gname, asm_pr[asm_pr_base[m] + fnm])
        table_push(asm_f_ret, frt)
        table_push(asm_f_pcnt, fpc)
        table_push(asm_f_ex, fex)
        table_push(asm_f_vbase, -1)
        table_push(asm_f_used, 0)
        table_push(asm_f_pty_base, len(asm_f_pty))
        table_push(asm_f_blk_base, -1)
        table_push(asm_f_blk_cnt, 0)
        var pk: i64 = 0
        while pk < fpc {
            var pt = rd_u32p1(t)
            if tieir_err != "" { return -1 }
            table_push(asm_f_pty, pt)
            pk = pk + 1
        }
        fi = fi + 1
    }
    // 块表（块表序 = 函数分组连续 → per-fn base 首现即起点，cnt 累计）
    var b_base = len(asm_b_fid)
    asm_b_base[m] = b_base
    var blk_n = rd_u32(t)
    if tieir_err != "" { return -1 }
    if blk_n > 1000000 {
        set_err("asm: 片段块数非法（" + to_string(blk_n) + "）")
        return -1
    }
    var bi: i64 = 0
    while bi < blk_n {
        var bfn = rd_u32(t)   // 片段内函数 lid
        var bnm = rd_u32(t)
        var bst = rd_u32p1(t) // start——重放自然复现，忽略
        var ben = rd_u32p1(t) // end——重放自然复现，忽略
        if tieir_err != "" { return -1 }
        if bfn >= fn_n || bnm >= pn {
            set_err("asm: 片段块记录越界（fn=" + to_string(bfn) + " nm=" + to_string(bnm) + "）")
            return -1
        }
        var frec = f_base + bfn
        asm_f_blk_cnt[frec] = asm_f_blk_cnt[frec] + 1
        table_push(asm_b_fid, frec)
        table_push(asm_b_gname, asm_pr[asm_pr_base[m] + bnm])
        table_push(asm_b_gid, -1)
        table_push(asm_bi_base, -1)
        table_push(asm_bi_cnt, 0)
        bi = bi + 1
    }
    asm_b_base[m + 1] = len(asm_b_fid)
    // 按函数分组（前缀和定段 + 二次填位）：块表内同函数的块**可能交错**
    // （闭包/嵌套生成），显式分组保证后续按函数遍历取到本函数的块与指令。
    var fb_cur: table<i64> = table_new_i64()
    var fb_i: i64 = 0
    while fb_i < fn_n {
        table_push(fb_cur, 0)
        fb_i = fb_i + 1
    }
    var fb_cum: i64 = len(asm_fb_idx)
    fb_i = 0
    while fb_i < fn_n {
        asm_f_blk_base[f_base + fb_i] = fb_cum
        fb_cum = fb_cum + asm_f_blk_cnt[f_base + fb_i]
        fb_i = fb_i + 1
    }
    fb_i = 0
    while fb_i < blk_n {
        table_push(asm_fb_idx, -1)
        fb_i = fb_i + 1
    }
    var bi2 = b_base
    while bi2 < b_base + blk_n {
        var fr2 = asm_b_fid[bi2]
        var li = fr2 - f_base
        var pos = asm_f_blk_base[fr2] + fb_cur[li]
        asm_fb_idx[pos] = bi2
        fb_cur[li] = fb_cur[li] + 1
        bi2 = bi2 + 1
    }
    // 指令表（指令序 = 块序 → 函数分组连续；per-fn base 首现 + cnt 累计）
    var i_base = len(asm_i_op)
    asm_i_base[m] = i_base
    var ins_n = rd_u32(t)
    if tieir_err != "" { return -1 }
    if ins_n > 10000000 {
        set_err("asm: 片段指令数非法（" + to_string(ins_n) + "）")
        return -1
    }
    var ii: i64 = 0
    while ii < ins_n {
        var own = rd_u32(t)   // 片段内块 lid
        var iop = rd_u32(t)
        var ity = rd_u32p1(t)
        var ivl = rd_u32p1(t)
        var iof = rd_u32(t)   // ops_off——重放自然复现，忽略
        var icn = rd_u32(t)
        if tieir_err != "" { return -1 }
        if own >= blk_n || icn > 100000 {
            set_err("asm: 片段指令记录越界（blk=" + to_string(own) + "）")
            return -1
        }
        var brec = b_base + own
        if asm_bi_base[brec] < 0 {
            asm_bi_base[brec] = len(asm_i_op)
        }
        asm_bi_cnt[brec] = asm_bi_cnt[brec] + 1
        table_push(asm_i_blk, brec)
        table_push(asm_i_op, iop)
        table_push(asm_i_ty, ity)
        table_push(asm_i_val, ivl)
        table_push(asm_i_cnt, icn)
        table_push(asm_i_obase, len(asm_o_v))
        var okk: i64 = 0
        while okk < icn {
            // v3 操作数序 = [kind, payload]；kind 2（立即数）载荷全值域 i64 LE
            var okd = rd_u32(t)
            if tieir_err != "" { return -1 }
            var ov: i64 = 0
            if okd == 2 || okd > 3 {
                ov = rd_i64_le(t)
            } else {
                ov = rd_u32(t)
            }
            if tieir_err != "" { return -1 }
            // 池载荷判定（与 write_mod_slice/deserialize 对齐）
            var is_pool = 0
            if okd == 3 {
                is_pool = 1
            }
            if okd == 0 && okk == 0 {
                if iop == 62 || iop == 51 || iop == 35 || iop == 36 || iop == 41 {
                    is_pool = 1
                }
            }
            if is_pool == 1 {
                if ov < 0 || ov >= pn {
                    set_err("asm: 片段池载荷越界（" + to_string(ov) + "）")
                    return -1
                }
                var gpid = asm_pr[asm_pr_base[m] + ov]
                // llvmgen 置位副作用恢复：白名单全局名引用 → enable 旗标
                //（irgen 生成引用时置位；装配路径经此处等价恢复）
                // 全局名在 IR 里有两种写法（irgen 多数点带 '@' 前缀，少数据点
                // 直存裸名）→ 比对前统一归一化去前缀。
                var gnm = asm_bare_name(interner.name_str(gpid))
                if gnm == "s21_sso_pool" || gnm == "s21_sso_off" || gnm == "s21_sso_malloc_cnt" {
                    asm_flag_sso = true
                }
                if gnm == "g_wsock_init" {
                    asm_flag_wsock = true
                }
                if gnm == "tie_panic_jb" || gnm == "tie_panic_active" {
                    asm_flag_catch = true
                }
                // p.9.17.1：str_char 缓存 helper 调用（op 35 载荷）→ sc 段恢复
                //（sc_enable 同时隐含 sso 段——llvmgen emit 侧强制置位）
                if iop == 35 && gnm == "tie_sc_off" {
                    asm_flag_sc = true
                }
                // p.9.21.9 收口：登记族恢复素材收集（去重）
                if okd == 3 {
                    asm_push_dedup(gpid, true)
                }
                if iop == 36 && okk == 0 {
                    asm_push_dedup(gpid, false)
                }
                table_push(asm_o_v, gpid)
            } else {
                table_push(asm_o_v, ov)
            }
            table_push(asm_o_k, okd)
            table_push(asm_o_pool, is_pool)
            // vbase 回填已移除：原「观测最小值」口径在参数未被任何操作数/结果
            // 引用时会偏大 → 值偏移整体错位（driver 树实测 str::trim_start 等）。
            // 改由指令表解析后按 vsize = 参数数 + 结果数 逐函数累计精确重算
            //（见 asm_parse_slice 末尾）。
            okk = okk + 1
        }
        ii = ii + 1
    }
    asm_i_base[m + 1] = len(asm_i_op)
    // 每函数值基址重算（p.9.21.9 收口）：write_mod_slice 的 f_vbase = 选中函数
    // 值空间累计（**含参数**），而解析期「观测最小值」在参数未被任何操作数/
    // 结果引用时会偏大 → 值偏移整体错位（装配报「值操作数引用未登记结果」或
    // 把结果误当参数）。按 vsize = 参数数 + 结果数 逐函数累计精确复现
    //（与 write_mod_slice 的 vcum 同式；每片段从 0 起算）。
    // p.9.21.10：值基址按**跨度**累计（与 write_mod_slice 的 span 口径对齐）——
    // irgen 交错生成时他函数的值插进本函数值域内部（span > count），按 count
    // 累计会让相邻函数的片段值域交叠（vmap 键碰撞 → 装配错值）。
    var cum: i64 = 0
    var ri = f_base
    while ri < f_base + fn_n {
        asm_f_vbase[ri] = cum
        var maxv: i64 = -1
        if asm_f_pcnt[ri] > 0 {
            maxv = cum + asm_f_pcnt[ri] - 1
        }
        var kb: i64 = 0
        while kb < asm_f_blk_cnt[ri] {
            var brec2 = asm_fb_idx[asm_f_blk_base[ri] + kb]
            var ib2 = asm_bi_base[brec2]
            var ic: i64 = 0
            while ic < asm_bi_cnt[brec2] {
                var vv2 = asm_i_val[ib2 + ic]
                if vv2 >= 0 && vv2 > maxv {
                    maxv = vv2
                }
                ic = ic + 1
            }
            kb = kb + 1
        }
        if maxv >= cum {
            cum = maxv + 1
        }
        ri = ri + 1
    }
    // 本片段的全局基址 = 此前各片段值空间大小之和；累计后供下一段续接
    table_push(asm_frag_vbase, asm_frag_vtotal)
    asm_frag_vtotal = asm_frag_vtotal + cum
    tieir_pos = tieir_sec_end
    // 段 6：导出表（转存重放；池 id 就地映射为全局 id）
    if !rd_sec3_head(t, SEC_EXPORT) { return -1 }
    var en = rd_u32(t)
    if tieir_err != "" { return -1 }
    if en > 100000 {
        set_err("asm: 片段导出表非法（" + to_string(en) + "）")
        return -1
    }
    asm_exp_base[m] = len(asm_exp)
    var ex: i64 = 0
    while ex < en {
        var enm = rd_u32(t)
        var esg = rd_u32(t)
        var eln = rd_u32p1(t)
        var ecl = rd_u32p1(t)
        if tieir_err != "" { return -1 }
        if enm >= pn || esg >= pn {
            set_err("asm: 片段导出池 id 越界（" + to_string(enm) + "/" + to_string(esg) + "）")
            return -1
        }
        table_push(asm_exp, asm_pr[asm_pr_base[m] + enm])
        table_push(asm_exp, asm_pr[asm_pr_base[m] + esg])
        table_push(asm_exp, eln)
        table_push(asm_exp, ecl)
        ex = ex + 1
    }
    tieir_pos = tieir_sec_end
    // 段 7（span）：v3 已移除（写侧不再产出；全量路径 span 恒空，语义无损）
    return 0
}

// ---------- 装配序确定 ----------
// order = driver 注入的 g_extra_tops 序函数全名。合成函数（主片段中不匹配
// order 者）按首/尾分段。填充 asm_seq = [head] + [order 命中] + [tail]。
// 返回 0 成功；失败 set_err 返回 -1。
func asm_build_seq(order: table<string>) -> i64 {
    var head: table<i64> = table_new_i64()
    var tail: table<i64> = table_new_i64()
    var matched: table<i64> = table_new_i64()
    var f0 = asm_f_base[0]
    var f0_end = asm_f_base[1]
    var seen_match: bool = false
    // p.9.21.10 性能：名字匹配从 O(order×records) 字符串扫描（driver 实测
    // ~1100 万次比较）改为 interner id 直接索引（O(1) 查，索引表 ~interner 容量）。
    var cap = interner.len()
    var order_flag: table<i64> = table_new_i64()
    var t: i64 = 0
    while t < cap {
        table_push(order_flag, 0)
        t = t + 1
    }
    var oi0: i64 = 0
    if get_env("TIEC_ASMDBG") == "2" {
        println("ASMDBG order_len=" + to_string(len(order)) + " cap=" + to_string(cap))
    }
    while oi0 < len(order) {
        var oid0 = interner.intern(order[oi0])
        if get_env("TIEC_ASMDBG") == "2" {
            println("ASMDBG order[" + to_string(oi0) + "]=" + order[oi0])
        }
        if oid0 >= 0 && oid0 < cap {
            order_flag[oid0] = 1
        }
        oi0 = oi0 + 1
    }
    var fi0: i64 = f0
    while fi0 < f0_end {
        var nid0 = asm_f_gname[fi0]
        if nid0 >= 0 && nid0 < cap && order_flag[nid0] == 1 {
            seen_match = true
        } else {
            if seen_match {
                table_push(tail, fi0)
            } else {
                table_push(head, fi0)
            }
        }
        fi0 = fi0 + 1
    }
    // 全部函数记录按名登记（**同名链表**：泛型展开可在多/同模块产生同名函数
    // ——p.9.21.11 修复：a7d4211 的「name_rec 后写覆盖」单槽表在同名 ≥2 条记录
    // 时第二条永远无法被装配序匹配（driver 实测 assert::assert_eq$i64 未覆盖
    // 降级全量）。改 head/tail 链表（FIFO = 记录升序），每名匹配取链首未用
    // 记录，语义与旧 O(order×records) 线性扫描一致，查名仍 O(1)。
    var name_head: table<i64> = table_new_i64()
    var name_tail: table<i64> = table_new_i64()
    var t: i64 = 0
    while t < cap {
        table_push(name_head, -1)
        table_push(name_tail, -1)
        t = t + 1
    }
    var rec_next: table<i64> = table_new_i64()   // 记录（相对 f0）→ 下一同名记录
    var fr: i64 = f0
    var frend = asm_f_base[len(asm_frag_fn)]
    while fr < frend {
        var nidr = asm_f_gname[fr]
        table_push(rec_next, -1)
        if nidr >= 0 && nidr < cap {
            if name_head[nidr] < 0 {
                name_head[nidr] = fr
            } else {
                rec_next[name_tail[nidr] - f0] = fr
            }
            name_tail[nidr] = fr
        }
        fr = fr + 1
    }
    // order 序：每名取链首未用记录
    var oi2: i64 = 0
    while oi2 < len(order) {
        var found = -1
        var oid2 = interner.intern(order[oi2])
        if oid2 >= 0 && oid2 < cap {
            var w = name_head[oid2]
            while w >= 0 && found < 0 {
                if asm_f_used[w] == 0 {
                    found = w
                }
                w = rec_next[w - f0]
            }
        }
        if found >= 0 && asm_f_used[found] == 0 {
            asm_f_used[found] = 1
            table_push(matched, found)
        }
        // 未找到 = 模板声明等不产 IR 的项——跳过
        oi2 = oi2 + 1
    }
    var hi: i64 = 0
    while hi < len(head) {
        table_push(asm_seq, head[hi])
        hi = hi + 1
    }
    var mi: i64 = 0
    while mi < len(matched) {
        table_push(asm_seq, matched[mi])
        mi = mi + 1
    }
    // p.9.21.11：irgen 期展开的泛型函数 → extra 段。机制：调用点兜底实例化
    //（instantiate_fn）发生在 irgen 遍历中，clone 追加 g_extra_tops 与注册表
    // 登记都在装配序构建**之后**——装配序快照必然缺名（driver 实测
    // assert::assert_eq$i64 反复覆盖失败）。未匹配的非主片段记录即此类展开：
    // 按记录序插到 matched 之后、tail 之前——与 tig_ast 创建序一致（原始
    // 顶层 → 克隆（追加在遍历中、由同一遍历取用）→ 尾部合成）；重放函数表
    // 序不影响语义正确性（值/块/指令空间 per-function + per-fragment 基址，
    // 与重放序无关）。ASMDBG=1 打印 extra 明细备查。
    var covered: table<i64> = table_new_i64()
    var fc: i64 = f0
    while fc < frend {
        table_push(covered, 0)
        fc = fc + 1
    }
    var hc: i64 = 0
    while hc < len(head) {
        covered[head[hc] - f0] = 1
        hc = hc + 1
    }
    var tc: i64 = 0
    while tc < len(tail) {
        covered[tail[tc] - f0] = 1
        tc = tc + 1
    }
    var extra: table<i64> = table_new_i64()
    var fx: i64 = f0
    while fx < frend {
        if asm_f_used[fx] == 0 && covered[fx - f0] == 0 {
            table_push(extra, fx)
        }
        fx = fx + 1
    }
    if get_env("TIEC_ASMDBG") == "1" {
        var ei0: i64 = 0
        while ei0 < len(extra) {
            println("ASMDBG extra[" + to_string(ei0) + "] frag=" + to_string(asm_rec_frag(extra[ei0])) +
                " name=" + interner.name_str(asm_f_gname[extra[ei0]]))
            ei0 = ei0 + 1
        }
    }
    var xi: i64 = 0
    while xi < len(extra) {
        table_push(asm_seq, extra[xi])
        xi = xi + 1
    }
    var ti: i64 = 0
    while ti < len(tail) {
        table_push(asm_seq, tail[ti])
        ti = ti + 1
    }
    // 覆盖校验（p.9.21.11 重构）：全部记录必经 head/matched/extra/tail 四段
    // 之一（extra 段吸收 irgen 期泛型展开）——不再有「未覆盖」失败路径；
    // 片段记录全集 == 重放函数全集由 asm_from_slices 末尾的函数数校验兜底。
    return 0
}

// ---------- 重放 ----------
// 按 asm_seq 把片段记录重放为 ir 全局状态。返回 0 成功；失败 set_err -1。
func asm_replay() -> i64 {
    ir.new_module()
    ir_meta.reset_meta()
    // 元数据重放（v3：片段头/sym/exp 转存 → ir_meta；多片段后写覆盖——
    // 真实产物各片段头部一致，sym/exp 按片段子集并集恢复）
    var mm: i64 = 0
    while mm < len(asm_frag_fn) {
        ir_meta.set_pkg_name(asm_m_pkg[mm])
        ir_meta.set_pkg_version(asm_m_ver[mm])
        ir_meta.set_ir_version(asm_m_irver[mm])
        ir_meta.set_compiler_version(asm_m_cver[mm])
        ir_meta.set_tie_opt(asm_m_topt[mm])
        ir_meta.set_pass_ver(asm_m_pver[mm])
        var db = asm_m_dep_base[mm]
        while db < asm_m_dep_base[mm + 1] {
            ir_meta.set_dep(asm_m_dep[db], asm_m_dep[db + 1])
            db = db + 2
        }
        var sb2 = asm_sym_base[mm]
        while sb2 < asm_sym_base[mm + 1] {
            ir_meta.set_sym(asm_sym[sb2], asm_sym[sb2 + 1], asm_sym[sb2 + 2],
                            asm_sym[sb2 + 3], asm_sym[sb2 + 4], asm_sym[sb2 + 5])
            sb2 = sb2 + 6
        }
        var eb = asm_exp_base[mm]
        while eb < asm_exp_base[mm + 1] {
            ir_meta.export_add(asm_exp[eb], asm_exp[eb + 1], asm_exp[eb + 2], asm_exp[eb + 3])
            eb = eb + 4
        }
        mm = mm + 1
    }
    // 指令 gid 回执表（先占位，第一趟填）
    asm_i_gid = table_new_i64()
    var gi0: i64 = 0
    while gi0 < len(asm_i_op) {
        table_push(asm_i_gid, -1)
        gi0 = gi0 + 1
    }
    var k: i64 = 0
    while k < len(asm_seq) {
        var r = asm_seq[k]
        var pc = asm_f_pcnt[r]
        var ptys: table<i64> = table_new_i64()
        var j: i64 = 0
        while j < pc {
            table_push(ptys, asm_f_pty[asm_f_pty_base[r] + j])
            j = j + 1
        }
        var fid = ir.new_func(asm_f_gname[r], asm_f_ret[r], ptys)
        ir.func_export_set(fid, asm_f_ex[r])
        // 参数值登记（片段值域：f_vbase[r] + j；与 write_mod_slice 的 f_vbase
        // 同式——参数在 new_func 时连续领号，必落在 [vbase, vbase+pc)）
        var fm_r = asm_rec_frag(r)
        var pj: i64 = 0
        while pj < pc {
            asm_vmap_set(asm_frag_vbase[fm_r] + asm_f_vbase[r] + pj, ir.param_val(fid, pj))
            pj = pj + 1
        }
        // 块重放（按函数分组段；段内即块表相对序 = 原创建序）
        var bb = asm_f_blk_base[r]
        var b: i64 = 0
        while b < asm_f_blk_cnt[r] {
            var brec = asm_fb_idx[bb + b]
            asm_b_gid[brec] = ir.new_block(fid, asm_b_gname[brec])
            b = b + 1
        }
        // 指令重放见下方全局单趟（p.9.21.10：片段指令流已按 id 序 = 创建序
        // 写出，跨函数单趟重放即创建序；建指令即补操作数，无前向引用）
        k = k + 1
    }
    // 指令全局单趟重放：片段指令流 = id 序（write_mod_slice p.9.21.10 改造），
    // 建指令即补操作数（ir.add_operand 段连续断言满足）；每块指令在流中连续
    // → 重建后块区间仍连续。vmap 直查（值域是否交错无关）。
    var gi: i64 = 0
    while gi < len(asm_i_op) {
        var blkrec = asm_i_blk[gi]
        var fm_i = asm_rec_frag(asm_b_fid[blkrec])
        var gid = ir.new_inst(asm_b_gid[blkrec], asm_i_op[gi], asm_i_ty[gi])
        var vv = asm_i_val[gi]
        if vv >= 0 {
            asm_vmap_set(asm_frag_vbase[fm_i] + vv, ir.get_value(gid))
        }
        var ok: i64 = 0
        while ok < asm_i_cnt[gi] {
            var idx = asm_i_obase[gi] + ok
            var ov = asm_o_v[idx]
            var okd = asm_o_k[idx]
            if asm_o_pool[idx] == 1 {
                ir.add_operand(gid, ov, okd)
            } else {
                if okd == 0 {
                    // 值操作数：片段值 id + 片段基址 → 全局 vmap 键
                    var key = asm_frag_vbase[fm_i] + ov
                    if ov < 0 || key >= len(asm_vmap) || asm_vmap[key] < 0 {
                        set_err("asm: 值操作数未登记（v=" + to_string(ov) + "）")
                        return -1
                    }
                    ov = asm_vmap[key]
                } else {
                    if okd == 1 {
                        // 块操作数载荷 = 片段内块 lid，按片段块表基址定位
                        var fm = asm_rec_frag(asm_b_fid[blkrec])
                        if ov < 0 || asm_b_base[fm] + ov >= asm_b_base[fm + 1] {
                            set_err("asm: 块操作数越界（lid=" + to_string(ov) + "）")
                            return -1
                        }
                        ov = asm_b_gid[asm_b_base[fm] + ov]
                    }
                }
                ir.add_operand(gid, ov, okd)
            }
            ok = ok + 1
        }
        gi = gi + 1
    }
    return 0
}

// ---------- 入口 ----------
// paths = 全部模块片段路径（模块序）；order = driver 注入的装配序全名。
// 返回 0 成功（ir/ir_meta 已就绪）；失败 set_err -1（driver 降级全量）。
// llvmgen 置位恢复查询（driver 装配成功后据此刻调 sso/wsock/catch_enable——
// 与 irgen 生成引用时的置位等价；白名单对齐 llvmgen_inst_p1）。
pub func asm_flag_sso() -> bool { return asm_flag_sso }
pub func asm_flag_wsock() -> bool { return asm_flag_wsock }
pub func asm_flag_catch() -> bool { return asm_flag_catch }
pub func asm_flag_sc() -> bool { return asm_flag_sc }
// p.9.21.9 收口：装配路径副作用恢复素材（池 id，driver 侧 interner.name_str 取文本）
pub func asm_gref_count() -> i64 { return len(asm_grefs) }
pub func asm_gref_id(i: i64) -> i64 { return asm_grefs[i] }
pub func asm_ext_count() -> i64 { return len(asm_exts) }
pub func asm_ext_id(i: i64) -> i64 { return asm_exts[i] }

pub func asm_from_slices(paths: table<string>, order: table<string>) -> i64 {
    var n = len(paths)
    if n == 0 {
        set_err("asm: 空片段表")
        return -1
    }
    // 复位转存表
    asm_f_base = table_new_i64()
    asm_f_gname = table_new_i64()
    asm_f_ret = table_new_i64()
    asm_f_pcnt = table_new_i64()
    asm_f_ex = table_new_i64()
    asm_f_vbase = table_new_i64()
    asm_f_pty_base = table_new_i64()
    asm_f_pty = table_new_i64()
    asm_f_blk_base = table_new_i64()
    asm_f_blk_cnt = table_new_i64()
    asm_fb_idx = table_new_i64()
    asm_bi_base = table_new_i64()
    asm_bi_cnt = table_new_i64()
    asm_i_blk = table_new_i64()
    asm_f_used = table_new_i64()
    asm_b_base = table_new_i64()
    asm_b_fid = table_new_i64()
    asm_b_gname = table_new_i64()
    asm_b_gid = table_new_i64()
    asm_i_base = table_new_i64()
    asm_i_op = table_new_i64()
    asm_i_ty = table_new_i64()
    asm_i_val = table_new_i64()
    asm_i_cnt = table_new_i64()
    asm_i_obase = table_new_i64()
    asm_o_v = table_new_i64()
    asm_o_k = table_new_i64()
    asm_o_pool = table_new_i64()
    asm_pr_base = table_new_i64()
    asm_pr = table_new_i64()
    asm_frag_fn = table_new_i64()
    asm_vmap = table_new_i64()
    asm_frag_vbase = table_new_i64()
    asm_frag_vtotal = 0
    asm_i_gid = table_new_i64()
    asm_seq = table_new_i64()
    asm_grefs = table_new_i64()
    asm_exts = table_new_i64()
    asm_m_pkg = table_new_i64()
    asm_m_ver = table_new_i64()
    asm_m_irver = table_new_i64()
    asm_m_topt = table_new_i64()
    asm_m_pver = table_new_i64()
    asm_m_cver = table_new_i64()
    asm_m_dep_base = table_new_i64()
    asm_m_dep = table_new_i64()
    asm_sym_base = table_new_i64()
    asm_sym = table_new_i64()
    asm_exp_base = table_new_i64()
    asm_exp = table_new_i64()
    asm_flag_sso = false
    asm_flag_wsock = false
    asm_flag_catch = false
    asm_flag_sc = false
    var m: i64 = 0
    var dbg_t0: i64 = 0
    unsafe { dbg_t0 = GetTickCount() }
    var dbg_bytes: i64 = 0
    while m < n {
        var t = bytes.read(paths[m])
        if len(t) == 0 {
            set_err("asm: 片段读取失败: " + paths[m])
            return -1
        }
        dbg_bytes = dbg_bytes + len(t)
        if asm_parse_slice(t, m) != 0 {
            return -1
        }
        m = m + 1
    }
    // 元数据转存表尾哨兵（replay 的 [mm, mm+1) 区间扫描需要）
    asm_m_dep_base[n] = len(asm_m_dep)
    asm_sym_base[n] = len(asm_sym)
    asm_exp_base[n] = len(asm_exp)
    var dbg_t1: i64 = 0
    unsafe { dbg_t1 = GetTickCount() }
    var dbg_t2: i64 = 0
    unsafe { dbg_t2 = GetTickCount() }
    // 尾哨兵（per-片段基址表统一长度 n+1）
    asm_f_base[n] = len(asm_f_gname)
    // 注意：asm_f_pty_base 是**函数记录**索引（push 式），此处绝不能写 [n]
    //（n = 片段数）——曾越界改写第 n 号函数记录的类型基址，其参数类型全变
    // 零值（driver 实测 putil::slice_str 签名 (ptr,i64,i64) → (i8,i8,i8)）。
    // 该哨兵无消费者（重放只按函数记录读），直接移除。
    if asm_build_seq(order) != 0 {
        return -1
    }
    if asm_replay() != 0 {
        return -1
    }
    var dbg_t3: i64 = 0
    unsafe { dbg_t3 = GetTickCount() }
    if get_env("TIEC_ASMDBG") == "1" {
        println("ASMDIAG parse=" + to_string(dbg_t1 - dbg_t0) + "ms bytes=" + to_string(dbg_bytes) +
            " seq+replay=" + to_string(dbg_t3 - dbg_t2) + "ms")
    }
    // 全覆盖：重放函数数 == 全部片段函数数
    var total: i64 = 0
    m = 0
    while m < n {
        total = total + asm_frag_fn[m]
        m = m + 1
    }
    if ir.func_count() != total {
        set_err("asm: 重放函数数不符（" + to_string(ir.func_count()) + "/" + to_string(total) + "）")
        return -1
    }
    return 0
}

}   // namespace tieir
