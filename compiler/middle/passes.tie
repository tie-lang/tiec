type tie<class>
// compiler/middle/passes.tie —— p.9.20.2/3 中端 pass 管道（t 轴）
// ============================================================
// 双轴优化器（docs/designs/tiec-dual-axis-optimizer.md，ROAD p.9.20）：
// t 轴 = tie-IR pass 管道，挂 irgen 之后、llvmgen 之前（driver.kpass_irgen
// 成功后调用 passes.run(level)）。与后端无关——trm/WASM 无 LLVM 优化器，
// 本管道是其未来唯一优化层。
//
// 确定性硬门禁（design §6）：
//   - pass 集合与顺序**版本化固定**：新增/改动 pass 必须 +1 g_pass_pipeline_ver，
//     并同步缓存键（driver cache_key_str 的 M 段）与 tieir 单元头；
//   - 同 (源码, l, t, target) → 输出逐字节恒等；
//   - pass 禁止时间/地址/随机依赖；纯 tie，禁 Rust。
//
// 分期（ROAD p.9.20.3-5）：t1 单函数局部（常量折叠/代数化简/死值消除）→
// t2 过程内（CSE/LICM/边界检查消除，让位 --check-bounds）→ t3 过程间
// （小函数内联/tail call/字符串构建融合）。当前 t1 已接入；t>1 暂为 t1 超集
// 占位（分级裁剪语义：每级 = 前级超集，t2/t3 pass 依序补）。
//
// t1 算法（单遍、确定性、线性）：
//   A. 按块序/指令序扫描：const_i 登记值→常量表；整型算术/icmp 双常量
//      折叠（rewrite_to_const 改写为 const_i，除零不折叠；tie 无移位运算符，
//      shl/shr 不折叠）；恒等式（x+0 / x-0 / x|0 / x^0 / x<<0 / x>>0 /
//      x*1 / x/1 → x，x*0 / x&0 → 0，0+x → x）登记值替代表；
//   B. 替代表链压缩后全量回写操作数（值传播；dominance 安全——替代目标
//      支配原结果值，使用范围只缩不扩）；
//   C. DCE：无使用者的纯指令（NUM 组 + CONST 组 + ptrtoint/inttoptr/
//      bitcast）标记后经 ir.compact_dead 物理压缩；compact 拒绝（孤儿指令）
//      时保守放弃删除，折叠/传播效果保留。
//
// opcode 字面量与 irgen/llvmgen 一致（const_i=60 等；ir.tie 元数据表已于
// 2026-09-21 按实现权威重建，edd3eca）。
//
// 布局约束：全局 var 必须在文件顶层（命名空间体内只允许函数/类/嵌套命名空间），
// 函数入 namespace passes（driver 以 passes.run 跨命名空间调用）。

import "./ir.tie"
import "../lib/interner.tie"

var g_pass_pipeline_ver: i64 = 3;   // pass 集合版本（新增/改动 pass 必须 +1；3 = t2 块内 CSE 接入）

// 折叠涉及 opcode（实现权威字面量）
const P_ADD: i64 = 0;
const P_SUB: i64 = 1;
const P_MUL: i64 = 2;
const P_DIV: i64 = 3;
const P_MOD: i64 = 4;
const P_AND: i64 = 6;
const P_OR: i64 = 7;
const P_XOR: i64 = 8;
const P_SHL: i64 = 10;
const P_SHR: i64 = 11;
const P_ICMP: i64 = 12;
const P_CONST_I: i64 = 60;
const P_VAL: i64 = 0;
const P_IMM: i64 = 2;

namespace passes {

// pass 管道版本（缓存键 / tieir 单元头 / 诊断显示用）。
pub func pipeline_ver() -> i64 {
    return g_pass_pipeline_ver
}

// 运行 t 轴 pass 管道：level = 生效 tiec 优化档（0-3）。返回 0 = 成功，负 = 失败。
// t0：零 pass，直出（自举不动点不变）。
pub func run(level: i64) -> i64 {
    if level <= 0 {
        return 0
    }
    // t1 起接入；每级 = 前级超集（分级裁剪语义）
    var r = run_t1()
    if r != 0 {
        return r
    }
    if level >= 2 {
        var r2 = run_t2()
        if r2 != 0 {
            return r2
        }
    }
    // p.9.20.5 进行中（2026-09-21）：run_t3（小函数内联）已实现并通过探针级
    // 验证，但 driver 级自举存在未收敛的跨函数值引用（XREF）边界，t3 暂映射
    // t2 保证全档位产物自洽；内联代码保留，XREF 解开后恢复门控。
    return 0
}

// ---------- t1：常量折叠 / 代数化简 / 死值消除 ----------

// 操作数取常量值：IMM 直接取；VALUE 查常量表。非常量返回 (false, 0)。
func opnd_const(inst: i64, k: i64, const_of: table<i64>, has_const: table<bool>) -> (bool, i64) {
    var v = ir.ins_opnd(inst, k)
    var kind = ir.ins_opnd_kind(inst, k)
    if kind == P_IMM {
        return (true, v)
    }
    if kind == P_VAL && v >= 0 && v < len(has_const) {
        if has_const[v] {
            return (true, const_of[v])
        }
    }
    return (false, 0)
}

// 整型算术 / icmp 的折叠与化简（单指令）。
func fold_int(inst: i64, op: i64, rv: i64, const_of: table<i64>, has_const: table<bool>, repl: table<i64>) {
    var nvals = len(has_const)
    if rv < 0 || rv >= nvals {
        return
    }
    var (ok1, a) = opnd_const(inst, 0, const_of, has_const)
    var (ok2, b) = opnd_const(inst, 1, const_of, has_const)
    var k0val = ir.ins_opnd(inst, 0)
    var k0isval = ir.ins_opnd_kind(inst, 0) == P_VAL
    // ---- 恒等式化简（②侧常量）----
    if ok2 && k0isval {
        if b == 0 && (op == P_ADD || op == P_SUB || op == P_OR || op == P_XOR || op == P_SHL || op == P_SHR) {
            repl[rv] = k0val
            return
        }
        if b == 1 && (op == P_MUL || op == P_DIV) {
            repl[rv] = k0val
            return
        }
        if b == 0 && (op == P_MUL || op == P_AND) {
            ir.rewrite_to_const(inst, P_CONST_I, 0)
            has_const[rv] = true
            const_of[rv] = 0
            return
        }
    }
    // 0 + x → x（①侧字面 0；折叠暴露场景）
    if op == P_ADD && ok1 && a == 0 && ir.ins_opnd_kind(inst, 0) == P_IMM {
        if ir.ins_opnd_kind(inst, 1) == P_VAL && ir.ins_opnd(inst, 1) >= 0 && ir.ins_opnd(inst, 1) < nvals {
            repl[rv] = ir.ins_opnd(inst, 1)
            return
        }
    }
    // ---- 双常量折叠 ----
    if !(ok1 && ok2) {
        return
    }
    var r: i64 = 0
    var can = false
    if op == P_ADD {
        r = a + b
        can = true
    } else if op == P_SUB {
        r = a - b
        can = true
    } else if op == P_MUL {
        r = a * b
        can = true
    } else if op == P_DIV {
        if b != 0 {
            r = a / b
            can = true
        }
    } else if op == P_MOD {
        if b != 0 {
            r = a % b
            can = true
        }
    } else if op == P_AND {
        r = a & b
        can = true
    } else if op == P_OR {
        r = a | b
        can = true
    } else if op == P_XOR {
        r = a ^ b
        can = true
    }
    // shl/shr：tie 无移位运算符，不折叠（仅保留上面的恒等化简）
    if !can {
        return
    }
    ir.rewrite_to_const(inst, P_CONST_I, r)
    has_const[rv] = true
    const_of[rv] = r
}

// 符号池 id 槽判定：kind=0（VALUE）但内容是字符串池 id 的历史约定槽——
// call(35)/extern_call(36)/call_vararg(41)/const_f(51)/const_str(62)/
// const_global(63)/inline_asm(65) 的操作数①。值传播与 DCE 扫描必须跳过：
// 把池 id 当值 id 替换会改写被调符号名（llvmgen 查池得错名 → 非法 declare），
// 误标 used 会让 DCE 漏删/错保。
func is_sym_slot(op: i64, k: i64) -> bool {
    if k != 0 {
        return false
    }
    return op == 35 || op == 36 || op == 41 || op == 51 || op == 62 || op == 63 || op == 65
}

// 替代表链压缩 + 全量回写操作数（值传播）。
func apply_repl(repl: table<i64>, nvals: i64) {
    var v: i64 = 0
    while v < nvals {
        var r = repl[v]
        if r >= 0 {
            // 跟链至终点（depth 防御环；登记序保证无环，仅防御）
            var depth: i64 = 0
            while r >= 0 && r < nvals && repl[r] >= 0 && depth <= nvals {
                r = repl[r]
                depth = depth + 1
            }
            repl[v] = r
        }
        v = v + 1
    }
    var total = ir.inst_count()
    var inst: i64 = 0
    while inst < total {
        var op = ir.ins_op(inst)
        var cnt = ir.ins_ops_cnt(inst)
        var k: i64 = 0
        while k < cnt {
            if k == 0 && is_sym_slot(op, k) {
                k = k + 1
                continue
            }
            if ir.ins_opnd_kind(inst, k) == P_VAL {
                var val = ir.ins_opnd(inst, k)
                if val >= 0 && val < nvals && repl[val] >= 0 {
                    ir.set_opnd(inst, k, repl[val], P_VAL)
                }
            }
            k = k + 1
        }
        inst = inst + 1
    }
}

// 纯指令判定（无副作用、删除安全）：NUM 组全纯 + CONST 组全纯 +
// MEM 组仅 ptrtoint(24)/inttoptr(25)/bitcast(26)。
// 不删：alloca/load/store/gep（内存）、phi（块引用）、call 族、str_cat（malloc）、
// atomic/volatile（显式副作用）。
func is_pure_op(op: i64) -> bool {
    var g = ir.op_group(op)
    if g == 0 || g == 5 {
        return true
    }
    if op == 24 || op == 25 || op == 26 {
        return true
    }
    return false
}

// DCE：标记无使用者的纯指令并物理压缩。compact 拒绝（孤儿指令前提不满足）
// 时返回 0——保守放弃删除，不报错（折叠/传播效果已保留）。
func dce() -> i64 {
    var total = ir.inst_count()
    var nvals = ir.value_count()
    var used = table_new_bool()
    var i: i64 = 0
    while i < nvals {
        table_push(used, false)
        i = i + 1
    }
    // 函数形参保守标记（形参值可能被 llvmgen 隐式消费）
    var nf = ir.func_count()
    var f: i64 = 0
    while f < nf {
        var pc = ir.func_params_cnt(f)
        var k: i64 = 0
        while k < pc {
            var pv = ir.param_val(f, k)
            if pv >= 0 && pv < nvals {
                used[pv] = true
            }
            k = k + 1
        }
        f = f + 1
    }
    // 全量扫操作数（OK_BLOCK 块引用不进 used；符号池槽跳过——池 id 不是值）
    var inst: i64 = 0
    while inst < total {
        var op = ir.ins_op(inst)
        var cnt = ir.ins_ops_cnt(inst)
        var k: i64 = 0
        while k < cnt {
            if k == 0 && is_sym_slot(op, k) {
                k = k + 1
                continue
            }
            if ir.ins_opnd_kind(inst, k) == P_VAL {
                var val = ir.ins_opnd(inst, k)
                if val >= 0 && val < nvals {
                    used[val] = true
                }
            }
            k = k + 1
        }
        inst = inst + 1
    }
    var dead = table_new_bool()
    var n: i64 = 0
    inst = 0
    while inst < total {
        var op = ir.ins_op(inst)
        var rv = ir.ins_val(inst)
        var kill = false
        if rv >= 0 && rv < nvals && !used[rv] && is_pure_op(op) {
            kill = true
        }
        table_push(dead, kill)
        if kill {
            n = n + 1
        }
        inst = inst + 1
    }
    if n == 0 {
        return 0
    }
    var rc = ir.compact_dead(dead)
    if rc < 0 {
        // 前提不满足（存在孤儿指令）：放弃物理删除，保守成功
        return 0
    }
    return 0
}

func run_t1() -> i64 {
    var nvals = ir.value_count()
    var const_of = table_new_i64()
    var has_const = table_new_bool()
    var repl = table_new_i64()
    var i: i64 = 0
    while i < nvals {
        table_push(const_of, 0)
        table_push(has_const, false)
        table_push(repl, 0 - 1)
        i = i + 1
    }
    // A. 单遍扫描：const 登记 + 折叠/化简（定义先于使用，同序传播）
    var total = ir.inst_count()
    var inst: i64 = 0
    while inst < total {
        var op = ir.ins_op(inst)
        var rv = ir.ins_val(inst)
        if op == P_CONST_I {
            if rv >= 0 && rv < nvals && ir.ins_ops_cnt(inst) >= 1 && ir.ins_opnd_kind(inst, 0) == P_IMM {
                has_const[rv] = true
                const_of[rv] = ir.ins_opnd(inst, 0)
            }
        } else if op == P_ADD || op == P_SUB || op == P_MUL || op == P_DIV || op == P_MOD ||
            op == P_AND || op == P_OR || op == P_XOR {
            // icmp 不折叠（2026-09-21 实证：存在 ins_ty=TK_I64 的 icmp 指令，
            // rewrite 成 const_i 后 llvmgen 按 ins_ty 输出 i64，与 br i1 类型断裂；
            // 常量条件由前端 consteval 与 LLVM opt 兜底，此处收益低风险高）
            fold_int(inst, op, rv, const_of, has_const, repl)
        }
        inst = inst + 1
    }
    // B. 值传播
    apply_repl(repl, nvals)
    // C. 死值消除
    return dce()
}

// ---------- t2：过程内 pass（p.9.20.4）----------
//
// 范围（2026-09-21 实装裁定）：
//   - 块内 CSE：同一基本块内全等纯指令（同 opcode/ty/操作数）合并为首个，
//     走值替代 + DCE 清理。跨块 CSE 与 LICM 依赖支配分析，顺延至后续子项
//     （ROAD 落地要点已注明）。
//   - 边界检查消除（BCE）：按设计「让位 --check-bounds」语义实现为零操作——
//     检查指令仅在 --check-bounds 显式开启时生成（irgen_stmt.tig_array_bounds_check
//     的 g_check_bounds 门控），默认构建无检查可消；显式开启时用户要求检查，
//     t2 不消除。future：若检查转为默认生成，BCE 在此接入。

// 指令 CSE 签名：opcode / ty / 操作数（值+kind）织入乘法哈希（i64 wrap 无妨）。
func cse_hash(inst: i64, op: i64) -> i64 {
    var h = (op + 1) * 1000003 + ir.ins_ty(inst) * 31 + ir.ins_ops_cnt(inst) * 7
    var k: i64 = 0
    var cnt = ir.ins_ops_cnt(inst)
    while k < cnt {
        h = h * 1000003 + (ir.ins_opnd(inst, k) + 1) * (ir.ins_opnd_kind(inst, k) + 2)
        k = k + 1
    }
    if h < 0 {
        h = 0 - h
        if h < 0 {
            h = 1   // i64 最小值取负仍负（防御）
        }
    }
    return h
}

// 全等比对（防哈希碰撞误合并）：opcode / ty / 逐操作数（值+kind）。
func cse_same(a: i64, b: i64) -> bool {
    if ir.ins_op(a) != ir.ins_op(b) || ir.ins_ty(a) != ir.ins_ty(b) {
        return false
    }
    var ca = ir.ins_ops_cnt(a)
    if ca != ir.ins_ops_cnt(b) {
        return false
    }
    var k: i64 = 0
    while k < ca {
        if ir.ins_opnd(a, k) != ir.ins_opnd(b, k) || ir.ins_opnd_kind(a, k) != ir.ins_opnd_kind(b, k) {
            return false
        }
        k = k + 1
    }
    return true
}

// 块内 CSE：重复纯指令的结果值替代为首次出现者。返回替代登记数。
func cse_blockwise(repl: table<i64>, nvals: i64) -> i64 {
    var merged: i64 = 0
    var nb = ir.block_count()
    var bi: i64 = 0
    while bi < nb {
        var s = ir.block_start(bi)
        var e = ir.block_end(bi)
        var n = e - s
        if n > 1 {
            // 块内开放寻址哈希表（容量 2 的幂，负载 < 1/2）
            var cap = 64
            while cap < n * 2 {
                cap = cap * 2
            }
            var hkeys = table_new_i64()   // 签名（-1 = 空槽）
            var hinst = table_new_i64()   // 首现指令 id
            var i: i64 = 0
            while i < cap {
                table_push(hkeys, 0 - 1)
                table_push(hinst, 0 - 1)
                i = i + 1
            }
            var ii = s
            while ii < e {
                var op = ir.ins_op(ii)
                var rv = ir.ins_val(ii)
                if rv >= 0 && rv < nvals && is_pure_op(op) {
                    var h = cse_hash(ii, op)
                    var slot = h % cap
                    var probe: i64 = 0
                    var hit = 0 - 1
                    while probe < cap {
                        var kk = hkeys[slot]
                        if kk < 0 {
                            break   // 空槽：无匹配
                        }
                        if kk == h && cse_same(hinst[slot], ii) {
                            hit = hinst[slot]
                            break
                        }
                        slot = (slot + 1) % cap
                        probe = probe + 1
                    }
                    if hit >= 0 {
                        // 命中：当前指令的结果值替代为首现结果值（死指令由 DCE 清理）
                        repl[rv] = ir.ins_val(hit)
                        merged = merged + 1
                    } else if probe < cap {
                        // 空槽插入
                        hkeys[slot] = h
                        hinst[slot] = ii
                    }
                    // 探测耗尽（表满，负载 < 1/2 不可能）：放弃该指令
                }
                ii = ii + 1
            }
        }
        bi = bi + 1
    }
    return merged
}

func run_t2() -> i64 {
    var nvals = ir.value_count()
    var repl = table_new_i64()
    var i: i64 = 0
    while i < nvals {
        table_push(repl, 0 - 1)
        i = i + 1
    }
    cse_blockwise(repl, nvals)
    apply_repl(repl, nvals)
    return dce()
}

// ---------- t3：过程间 pass（p.9.20.5）----------
//
// 范围（2026-09-21 实装裁定，ROAD 如实标注）：
//   - **小函数内联**（本版核心）：被调函数满足「单块 + 唯一 ret 置于块尾 +
//     无 phi + 非递归 + 指令数 ≤ INLINE_MAX_INSTS」时，在调用点直线展开——
//     单块被调函数是纯直线代码，无需块切分 / br 链 / phi 合并（多 ret 需
//     phi、多块需块引用重映射与 CFG 切分，顺延后续子项）。
//   - **tail call**：IR 层无尾调用标志位，llvmgen 侧文本级识别
//     （call 结果仅被同块 ret 消费 → 输出 tail call）延后，与内联解耦。
//   - **字符串构建融合**：依赖 p.9.17.1 字符串原语的 IR 形态勘察，顺延。

const INLINE_MAX_INSTS: i64 = 24;   // 被调函数指令数阈值（保守起点）

// call(35) → 被调函数 id（符号名池 id 与函数名池 id 相等比较；-1 = 未找到）
func callee_of(inst: i64) -> i64 {
    var nid = ir.ins_opnd(inst, 0)
    var nf = ir.func_count()
    var f: i64 = 0
    while f < nf {
        if ir.func_name(f) == nid {
            return f
        }
        f = f + 1
    }
    return 0 - 1
}

// 被调函数是否为「单块 + 唯一 ret 置于块尾 + 无 phi + 非递归 + ≤阈值」候选。
// 单块是硬前提：多块函数（循环/分支，即使只有唯一尾置 ret，如 to_string 的
// 循环+尾部 return）的 CFG 不能直线展开——2026-09-21 RCA：漏检块数导致
// to_string 的循环块被拍平进调用者，块文本序错乱、空块炸 LLVM 解析。
func inline_candidate(fid: i64, lo: i64, hi: i64, nblocks: i64) -> bool {
    if fid < 0 || nblocks != 1 || hi - lo == 0 || hi - lo > INLINE_MAX_INSTS {
        return false
    }
    var name = ir.func_name(fid)
    var nret: i64 = 0
    var nphi: i64 = 0
    var ii = lo
    while ii < hi {
        var op = ir.ins_op(ii)
        if op == 32 {
            nret = nret + 1
            if ii != hi - 1 {
                return false   // ret 不在块尾（多语句后置返回），本版不展开
            }
        } else if op == 33 {
            nphi = nphi + 1
        }
        ii = ii + 1
    }
    if nret != 1 || nphi != 0 {
        return false
    }
    // 递归防护：块内任何 call 指向自己
    ii = lo
    while ii < hi {
        var op = ir.ins_op(ii)
        if op == 35 {
            var c = callee_of(ii)
            if c == fid {
                return false
            }
            // 内联链深控制：被调者又调用候选（展开放大），只查直接递归
        }
        ii = ii + 1
    }
    return true
}

// t3 主 pass：重建式展开（复用 compact 的线性保序 + 参数段搬移模式）。
// 返回展开的调用点数；无展开时不动任何表。
func inline_expand() -> i64 {
    var total = ir.inst_count()
    var nb = ir.block_count()
    var cover: i64 = 0
    var bi: i64 = 0
    while bi < nb {
        cover = cover + (ir_blocks_end[bi] - ir_blocks_start[bi])
        bi = bi + 1
    }
    if cover != total {
        return 0
    }
    // 归属表：指令 -> 块 / 函数
    var inst_blk = table_new_i64()
    var inst_fn = table_new_i64()
    var fill: i64 = 0
    while fill < total {
        table_push(inst_blk, 0 - 1)
        table_push(inst_fn, 0 - 1)
        fill = fill + 1
    }
    bi = 0
    while bi < nb {
        var s0 = ir_blocks_start[bi]
        var ii0 = s0
        while ii0 < ir_blocks_end[bi] {
            inst_blk[ii0] = bi
            inst_fn[ii0] = ir_blocks_func[bi]
            ii0 = ii0 + 1
        }
        bi = bi + 1
    }
    // 函数候选判定（按指令序首见区间 = 函数指令区间）
    var nvals0 = ir.value_count()
    var cand = table_new_bool()
    var f0: i64 = 0
    while f0 < ir.func_count() {
        table_push(cand, false)
        f0 = f0 + 1
    }
    // 每函数指令区间（沿用 g_fn_inst_lo/hi 的 min/max 语义）+ 块数
    var flo = table_new_i64()
    var fhi = table_new_i64()
    var fblocks = table_new_i64()
    f0 = 0
    while f0 < ir.func_count() {
        table_push(flo, total)
        table_push(fhi, 0 - 1)
        table_push(fblocks, 0)
        f0 = f0 + 1
    }
    bi = 0
    while bi < nb {
        var fid = ir_blocks_func[bi]
        if ir_blocks_start[bi] < flo[fid] {
            flo[fid] = ir_blocks_start[bi]
        }
        if ir_blocks_end[bi] > fhi[fid] {
            fhi[fid] = ir_blocks_end[bi]
        }
        fblocks[fid] = fblocks[fid] + 1
        bi = bi + 1
    }
    f0 = 0
    while f0 < ir.func_count() {
        if fhi[f0] > 0 {
            cand[f0] = inline_candidate(f0, flo[f0], fhi[f0], fblocks[f0])
        }
        f0 = f0 + 1
    }
    // 形参值快照：参数段搬移会更新 params_off，展开时的绑定必须与搬移解耦
    //（2026-09-21 RCA：被调函数参数段已搬（函数序在宿主前）后，绑定仍按新
    // off 读旧 ir_ops 表 → 形参读到垃圾值 → 展开体引用未定义寄存器）
    var psnap = table_new_i64()
    var psoff = table_new_i64()
    f0 = 0
    while f0 < ir.func_count() {
        table_push(psoff, len(psnap))
        var pj0: i64 = 0
        var pc0 = ir.func_params_cnt(f0)
        var po0 = ir.func_params_off(f0)
        while pj0 < pc0 {
            table_push(psnap, ir.param_val(f0, pj0))
            pj0 = pj0 + 1
        }
        f0 = f0 + 1
    }
    // 重建：线性扫旧指令；候选 call 直线展开，其余原样搬移
    var n_op = table_new_i64()
    var n_ty = table_new_i64()
    var n_val = table_new_i64()
    var n_off = table_new_i64()
    var n_cnt = table_new_i64()
    var n_ops = table_new_i64()
    var n_opsk = table_new_i64()
    var n_blk = table_new_i64()   // 产出指令的块归属（与 n_op 一一对应）
    var n_src = table_new_i64()   // 产出指令来源：-1 = 原生，否则 = 展开点旧指令 id
    var wlog = table_new_i64()    // 本调用点写过的 vmap 槽（展开后精确复位）
    var expanded: i64 = 0
    var last_fid: i64 = 0 - 1
    var handled = table_new_bool()
    var fh: i64 = 0
    while fh < ir.func_count() {
        table_push(handled, false)
        fh = fh + 1
    }
    // 内联值映射（被调旧值 id → 新值 id；大小 = 旧值计数，仅被调函数用到的槽有效）
    var vmap = table_new_i64()
    var vi: i64 = 0
    while vi < nvals0 {
        table_push(vmap, 0 - 1)
        vi = vi + 1
    }
    // call 结果值 → 被调 ret 值 的替代表（传播用）
    var repl = table_new_i64()
    vi = 0
    while vi < nvals0 {
        table_push(repl, 0 - 1)
        vi = vi + 1
    }
    // 复制一条被调指令：操作数经 vmap 重映射（无映射的值引用 → 放弃整点，
    // 理论不可达——被调块内引用必为形参或自身定义；防御返回 -1 由调用方回退）
    // 展开一个调用点。返回 0 成功 / -1 失败（失败时调用方原样保留 call）。
    // 实参取值：call 布局 [0]=符号池id [1]=返回类型IMM [2..]=每参 [类型IMM, 值VALUE]
    var ii: i64 = 0
    while ii < total {
        var fid = inst_fn[ii]
        if fid != last_fid && fid >= 0 && fid < len(ir_funcs_names) && !handled[fid] {
            var poff = ir_funcs_params_off[fid]
            var pcnt = ir_funcs_params_cnt[fid]
            ir_funcs_params_off[fid] = len(n_ops)
            handled[fid] = true
            var pk: i64 = 0
            while pk < pcnt {
                table_push(n_ops, ir_ops[poff + pk])
                table_push(n_opsk, ir_ops_kind[poff + pk])
                pk = pk + 1
            }
            last_fid = fid
        }
        var op = ir.ins_op(ii)
        var do_inline = false
        var callee = 0 - 1
        if op == 35 && ir.ins_ops_cnt(ii) >= 4 {
            callee = callee_of(ii)
            if callee >= 0 && callee < len(cand) && cand[callee] {
                do_inline = true
            }
        }
        if !do_inline {
            table_push(n_op, ir_insts_op[ii])
            table_push(n_ty, ir_insts_ty[ii])
            table_push(n_val, ir_insts_val[ii])
            table_push(n_off, len(n_ops))
            table_push(n_cnt, ir_insts_ops_cnt[ii])
            table_push(n_blk, inst_blk[ii])
            table_push(n_src, 0 - 1)
            var off = ir_insts_ops_off[ii]
            var cnt = ir_insts_ops_cnt[ii]
            var k: i64 = 0
            while k < cnt {
                table_push(n_ops, ir_ops[off + k])
                table_push(n_opsk, ir_ops_kind[off + k])
                k = k + 1
            }
        } else {
            // ---- 直线展开 callee（单块）----
            expanded = expanded + 1
            var cargs = ir.ins_ops_cnt(ii)
            // 形参绑定：vmap[形参值] = 实参值（实参 = 操作数 3, 5, 7...）
            var pcnt = ir.func_params_cnt(callee)
            var pso = psoff[callee]
            var pj: i64 = 0
            while pj < pcnt {
                var pval = psnap[pso + pj]
                var aval = ir.ins_opnd(ii, 2 + pj * 2 + 1)
                if pval >= 0 && pval < nvals0 {
                    vmap[pval] = aval
                    table_push(wlog, pval)
                }
                pj = pj + 1
            }
            // 复制被调指令（其唯一块 [flo, fhi)）；ret 跳过并绑定返回值
            var rv = ir.ins_val(ii)   // call 结果值（-1 = void）
            var csi = flo[callee]
            var cei = fhi[callee]
            var retv: i64 = 0 - 1
            var ci = csi
            while ci < cei {
                var cop = ir.ins_op(ci)
                if cop == 32 {
                    // ret：值绑定（ret 操作数① = 被调返回值；vmap 后才是新值）
                    if rv >= 0 && ir.ins_ops_cnt(ci) >= 1 {
                        var rsrc = ir.ins_opnd(ci, 0)
                        if rsrc >= 0 && rsrc < nvals0 && vmap[rsrc] >= 0 {
                            retv = vmap[rsrc]
                        }
                    }
                } else {
                    table_push(n_op, cop)
                    table_push(n_ty, ir.ins_ty(ci))
                    var nv = 0 - 1
                    var oval = ir.ins_val(ci)
                    if oval >= 0 {
                        nv = ir.new_value()
                        if oval < nvals0 {
                            vmap[oval] = nv
                            table_push(wlog, oval)
                        }
                    }
                    table_push(n_val, nv)
                    table_push(n_off, len(n_ops))
                    var ooff = ir.ins_ops_off(ci)
                    var ocnt = ir.ins_ops_cnt(ci)
                    table_push(n_cnt, ocnt)
                    table_push(n_blk, inst_blk[ii])
                    table_push(n_src, ii)
                    var k: i64 = 0
                    while k < ocnt {
                        var ov = ir_ops[ooff + k]
                        var ok = ir_ops_kind[ooff + k]
                        // 符号池槽跳过重映射（池 id 不是值 id；is_sym_slot 同 t2 防线）
                        if !(k == 0 && is_sym_slot(cop, k)) && ok == P_VAL && ov >= 0 && ov < nvals0 && vmap[ov] >= 0 {
                            ov = vmap[ov]
                        }
                        table_push(n_ops, ov)
                        table_push(n_opsk, ok)
                        k = k + 1
                    }
                }
                ci = ci + 1
            }
            // call 结果值 → 被调返回值（传播给使用者）
            if rv >= 0 && rv < nvals0 && retv >= 0 {
                repl[rv] = retv
            }
            // 按 wlog 精确复位本调用点写过的槽——同一函数可能有多个调用点，
            // 残留映射会串扰下一次展开（2026-09-21 RCA：全量复位的时机/覆盖
            // 都有遗漏，写日志复位是完备解）
            var wl: i64 = 0
            while wl < len(wlog) {
                vmap[wlog[wl]] = 0 - 1
                wl = wl + 1
            }
            wlog = table_new_i64()
            // 复位被调形参槽（vmap 复用防串扰：下一调用点重新绑定）
            pj = 0
            while pj < pcnt {
                var pval2 = ir_ops[poff + pj]
                if pval2 >= 0 && pval2 < nvals0 {
                    vmap[pval2] = 0 - 1
                }
                pj = pj + 1
            }
        }
        ii = ii + 1
    }
    if expanded == 0 {
        return 0
    }
    // 形参白名单（形参值入口虚拟无定义指令，(no def) 属正常）
    var is_formal = table_new_bool()
    var wi: i64 = 0
    while wi < nvals0 {
        table_push(is_formal, false)
        wi = wi + 1
    }
    var f9: i64 = 0
    while f9 < ir.func_count() {
        var pj9: i64 = 0
        while pj9 < ir.func_params_cnt(f9) {
            var pv9 = psnap[psoff[f9] + pj9]
            if pv9 >= 0 && pv9 < nvals0 {
                is_formal[pv9] = true
            }
            pj9 = pj9 + 1
        }
        f9 = f9 + 1
    }
    // T3DBG 自检（提交前）：UNDEF（非形参的值无定义）/ XREF（定义跨函数）
    var vc = ir.value_count()
    var defpos = table_new_i64()
    var z: i64 = 0
    while z < vc {
        table_push(defpos, 0 - 1)
        z = z + 1
    }
    var nn = len(n_op)
    var q: i64 = 0
    while q < nn {
        var dv = n_val[q]
        if dv >= 0 && dv < vc && defpos[dv] < 0 {
            defpos[dv] = q
        }
        q = q + 1
    }
    q = 0
    var bad: i64 = 0
    while q < nn && bad < 8 {
        var qop = n_op[q]
        if qop == 33 {
            q = q + 1
            continue
        }
        var qfn = ir.block_func(n_blk[q])
        var qoff = n_off[q]
        var qcnt = n_cnt[q]
        var k: i64 = 0
        while k < qcnt && bad < 8 {
            if k == 0 && is_sym_slot(qop, k) {
                k = k + 1
                continue
            }
            if n_opsk[qoff + k] == P_VAL {
                var vv = n_ops[qoff + k]
                var dnew = 0 - 1
                if vv >= 0 && vv < vc {
                    dnew = defpos[vv]
                }
                if dnew < 0 {
                    if !is_formal[vv] {
                        println("T3DBG UNDEF inst=" + to_string(q) + " op=" + to_string(qop) + " host=" + interner.lookup(ir.func_name(qfn)) + " src=" + to_string(n_src[q]) + " v=" + to_string(vv))
                        bad = bad + 1
                    }
                } else if ir.block_func(n_blk[dnew]) != qfn {
                    println("T3DBG XREF inst=" + to_string(q) + " op=" + to_string(qop) + " host=" + interner.lookup(ir.func_name(qfn)) + " src=" + to_string(n_src[q]) + " v=" + to_string(vv) + " defop=" + to_string(n_op[dnew]) + " deffn=" + interner.lookup(ir.func_name(ir.block_func(n_blk[dnew]))))
                    bad = bad + 1
                }
            }
            k = k + 1
        }
        q = q + 1
    }
    // 提交重建
    ir_insts_op = n_op
    ir_insts_ty = n_ty
    ir_insts_val = n_val
    ir_insts_ops_off = n_off
    ir_insts_ops_cnt = n_cnt
    ir_ops = n_ops
    ir_ops_kind = n_opsk
    // 块区间重算：直接按 n_blk（产出指令归属，与主重建一一对应）线性重放——
    // 2026-09-21 RCA：此前的重放在表提交之后用旧归属配新表内容，错位产生
    // 空块/块尾缺 terminator（LLVM: expected instruction opcode）。
    var new_start = table_new_i64()
    var new_end = table_new_i64()
    var zi: i64 = 0
    while zi < nb {
        table_push(new_start, 0 - 1)
        table_push(new_end, 0 - 1)
        zi = zi + 1
    }
    var nidx: i64 = 0
    var nb2 = len(n_blk)
    var r2i: i64 = 0
    while r2i < nb2 {
        var b5 = n_blk[r2i]
        if new_start[b5] < 0 {
            new_start[b5] = nidx
        }
        new_end[b5] = nidx + 1
        nidx = nidx + 1
        r2i = r2i + 1
    }
    ir_insts_op = n_op
    ir_insts_ty = n_ty
    ir_insts_val = n_val
    ir_insts_ops_off = n_off
    ir_insts_ops_cnt = n_cnt
    ir_ops = n_ops
    ir_ops_kind = n_opsk
    bi = 0
    while bi < nb {
        var nst = new_start[bi]
        if nst < 0 {
            nst = 0
        }
        var nen = new_end[bi]
        if nen < 0 {
            nen = 0
        }
        ir_blocks_start[bi] = nst
        ir_blocks_end[bi] = nen
        bi = bi + 1
    }
    // 函数指令总数重算
    var nf = len(ir_funcs_names)
    var ftotal = table_new_i64()
    var fi: i64 = 0
    while fi < nf {
        table_push(ftotal, 0)
        fi = fi + 1
    }
    bi = 0
    while bi < nb {
        var fid5 = ir_blocks_func[bi]
        if fid5 >= 0 && fid5 < nf {
            ftotal[fid5] = ftotal[fid5] + (ir_blocks_end[bi] - ir_blocks_start[bi])
        }
        bi = bi + 1
    }
    fi = 0
    while fi < nf {
        ir_funcs_inst_total[fi] = ftotal[fi]
        fi = fi + 1
    }
    // call 结果值 → 被调返回值 的传播 + DCE 清理死 call
    apply_repl(repl, nvals0)
    var d = dce()
    if d < 0 {
        return 0
    }
    return expanded
}

func run_t3() -> i64 {
    // inline_expand 返回展开数（正数）；调用约定 0 = 成功，仅负值向上传递
    var r = inline_expand()
    if r < 0 {
        return r
    }
    return 0
}

}
