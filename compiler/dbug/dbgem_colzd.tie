type tie<class>
// compiler/dbug/dbgem_colzd.tie —— 结构化输出·列登记与 zd 列编码（p.9.22.1-2）
// ============================================================
// 两条正交通道共用同一列登记：
//   ① zd：varint 标签（字段号<<3|2）+ varint 长度 + 载荷（zd 数组，元素自带标签）
//   ② td：同一列数据 → 可读表字面量（dbgem_coltd）
// push 式直写（每字节 table_push，无中间临时表、无 concat 二次复制）；
// 与 zdwrite.tie 的 enc_* 语义镜像——逐字节等价由 dbgem 探针覆盖（值域扫描）。
//
// 列登记（注册表全局在 dbgem.tie 主文件）：
//   dc_fno 字段号 · dc_kind 0=i64/1=str · dc_label 语义名（td 键）·
//   dc_len 行数 · dc_off 扁平段起点 · dc_i64/dc_str 列数据 · dc_ids 字符串列源 id
//   （tieir 段 8 用；非池来源列记 -1）
//
// 契约：字段号按阶段百位段只追加（design §3：ast 100-119 / symtab 150-199 /
// diag 200-219 / tokens 300-309）；列登记顺序 = 字段号升序（消费方顺序扫描）。

namespace dbgem {

// ---------- 原始编码（镜像 zdwrite.enc_*；ref 直写） ----------

// 追加 n 的大端定宽字节。
func push_be(dst: ref table<i64>, n: i64, width: i64) {
    var k: i64 = width - 1
    while k >= 0 {
        table_push(dst, (n >> (k * 8)) & 0xFF)
        k = k - 1
    }
}

// 追加 i64 紧凑编码（镜像 zdw.enc_i64：最短宽度优先）。
func push_i64(dst: ref table<i64>, n: i64) {
    if n >= 0 && n <= 127 {
        table_push(dst, n)
        return
    }
    if n >= -32 && n < 0 {
        table_push(dst, n & 0xFF)
        return
    }
    if n >= -128 && n < -32 {
        table_push(dst, 0xD0)
        table_push(dst, n & 0xFF)
        return
    }
    if n >= 128 && n <= 255 {
        table_push(dst, 0xCC)
        table_push(dst, n)
        return
    }
    if n >= -32768 && n < -128 {
        table_push(dst, 0xD1)
        push_be(dst, n & 0xFFFF, 2)
        return
    }
    if n >= 256 && n <= 65535 {
        table_push(dst, 0xCD)
        push_be(dst, n, 2)
        return
    }
    if n >= -2147483648 && n < -32768 {
        table_push(dst, 0xD2)
        push_be(dst, n & 0xFFFFFFFF, 4)
        return
    }
    if n >= 65536 && n <= 4294967295 {
        table_push(dst, 0xCE)
        push_be(dst, n, 4)
        return
    }
    if n >= 0 {
        table_push(dst, 0xCF)
        push_be(dst, n, 8)
        return
    }
    table_push(dst, 0xD3)
    push_be(dst, n, 8)
}

// 追加字符串（UTF-8 字节 + 长度头；镜像 zdw.enc_string / utf8_encode）。
// 两遍法：第一遍按码点算 UTF-8 字节长（零临时表），第二遍直写字节——
// 与 zdw 的语义逐位一致（代理区/越界码点跳过；str_char 按码点索引，
// 尾部空白索引取空串 → char_code < 0 跳过，同 zdw 行为）。
func push_str(dst: ref table<i64>, s: string) {
    var n = str_len(s)
    var blen: i64 = 0
    var i: i64 = 0
    while i < n {
        var cp = char_code(str_char(s, i))
        if cp < 0 {
            i = i + 1
            continue
        }
        if cp <= 0x7F {
            blen = blen + 1
        } else if cp <= 0x7FF {
            blen = blen + 2
        } else if cp <= 0xFFFF {
            if !(cp >= 0xD800 && cp <= 0xDFFF) {
                blen = blen + 3
            }
        } else if cp <= 0x10FFFF {
            blen = blen + 4
        }
        i = i + 1
    }
    if blen <= 31 {
        table_push(dst, 0xA0 | blen)
    } else if blen <= 255 {
        table_push(dst, 0xD9)
        table_push(dst, blen)
    } else if blen <= 65535 {
        table_push(dst, 0xDA)
        push_be(dst, blen, 2)
    } else {
        table_push(dst, 0xDB)
        push_be(dst, blen, 4)
    }
    i = 0
    while i < n {
        var cp = char_code(str_char(s, i))
        if cp < 0 {
            i = i + 1
            continue
        }
        if cp <= 0x7F {
            table_push(dst, cp)
        } else if cp <= 0x7FF {
            table_push(dst, 0xC0 | (cp >> 6))
            table_push(dst, 0x80 | (cp & 0x3F))
        } else if cp <= 0xFFFF {
            if !(cp >= 0xD800 && cp <= 0xDFFF) {
                table_push(dst, 0xE0 | (cp >> 12))
                table_push(dst, 0x80 | ((cp >> 6) & 0x3F))
                table_push(dst, 0x80 | (cp & 0x3F))
            }
        } else if cp <= 0x10FFFF {
            table_push(dst, 0xF0 | (cp >> 18))
            table_push(dst, 0x80 | ((cp >> 12) & 0x3F))
            table_push(dst, 0x80 | ((cp >> 6) & 0x3F))
            table_push(dst, 0x80 | (cp & 0x3F))
        }
        i = i + 1
    }
}

// 追加数组头（镜像 zdw.array_head）。
func push_array_head(dst: ref table<i64>, n: i64) {
    if n <= 15 {
        table_push(dst, 0x90 | n)
        return
    }
    if n <= 65535 {
        table_push(dst, 0xDC)
        push_be(dst, n, 2)
        return
    }
    table_push(dst, 0xDD)
    push_be(dst, n, 4)
}

// ---------- 列登记 ----------

// 清空列登记（每阶段 dump 前调用）。
pub func cols_reset() {
    dg_sym_ready = 0
    dc_fno = table_new_i64()
    dc_kind = table_new_i64()
    dc_label = table_new_string()
    dc_len = table_new_i64()
    dc_off = table_new_i64()
    dc_i64 = table_new_i64()
    dc_str = table_new_string()
    dc_ids = table_new_i64()
}

// i64 列登记。
pub func push_col_i64(fno: i64, label: string, t: table<i64>) {
    table_push(dc_fno, fno)
    table_push(dc_kind, 0)
    table_push(dc_label, label)
    table_push(dc_off, len(dc_i64))
    table_push(dc_len, len(t))
    var i: i64 = 0
    while i < len(t) {
        table_push(dc_i64, t[i])
        i = i + 1
    }
}

// 字符串列登记（源 = 池 id 表；-1 → 空串，缺失 id → 空串）。
pub func push_col_str_ids(fno: i64, label: string, ids: table<i64>) {
    table_push(dc_fno, fno)
    table_push(dc_kind, 1)
    table_push(dc_label, label)
    table_push(dc_off, len(dc_str))
    table_push(dc_len, len(ids))
    var i: i64 = 0
    while i < len(ids) {
        var id = ids[i]
        var s = ""
        if id >= 0 {
            s = interner.name_str(id)
        }
        table_push(dc_str, s)
        table_push(dc_ids, id)
        i = i + 1
    }
}

// 字符串列登记（源 = 文本表，非池来源：dc_ids 记 -1）。
pub func push_col_str_text(fno: i64, label: string, t: table<string>) {
    table_push(dc_fno, fno)
    table_push(dc_kind, 1)
    table_push(dc_label, label)
    table_push(dc_off, len(dc_str))
    table_push(dc_len, len(t))
    var i: i64 = 0
    while i < len(t) {
        table_push(dc_str, t[i])
        table_push(dc_ids, -1)
        i = i + 1
    }
}

// ---------- zd 列编码（登记段 → zd 数组字节） ----------

pub func col_zd_i64(col: i64) -> table<i64> {
    var out = table_new_i64()
    var off = dc_off[col]
    var n = dc_len[col]
    push_array_head(out, n)
    var i: i64 = 0
    while i < n {
        push_i64(out, dc_i64[off + i])
        i = i + 1
    }
    return out
}

pub func col_zd_str(col: i64) -> table<i64> {
    var out = table_new_i64()
    var off = dc_off[col]
    var n = dc_len[col]
    push_array_head(out, n)
    var i: i64 = 0
    while i < n {
        push_str(out, dc_str[off + i])
        i = i + 1
    }
    return out
}

}   // namespace dbgem
