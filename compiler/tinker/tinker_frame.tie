type tie<class>
// compiler/tinker/tinker_frame.tie —— tink 帧编解码（p.9.22.9；零依赖叶）
// ============================================================
// 帧格式（与 std/tink.tie 逐字节一致，语言无关）：
//   [ len: u32 BE ][ payload: len 字节 ][ crc: u32 BE ]
//   crc = CRC32-IEEE（反射式，poly 0xEDB88320，init/xorout 0xFFFFFFFF）
// 与 std/tink 的互验由 tinker 探针覆盖（tinker 编码 / std 解码 + 反向）。
//
// CRC32 用**查表法自实现**（256 项表惰性构建一次；与 rdu 逐位版逐位等价：
// 表项 = 逐位算法的合成，更新 = (crc>>8)^table[(crc^b)&0xFF]）。
// 本文件零 import（被 driver 链内联；自包含纪律同 zdw）。

// 查表（惰性构建；表项数与字节值域一致——1 次构建、全程复用）。
var tk_crc_tab: table<i64>;
var tk_crc_ready: i64 = 0;

namespace tinker {

// 构建 CRC 表（反射式：table[i] = i 经 8 次「(t>>1) ^ (lsb ? EDB88320 : 0)」）。
func crc_tab_build() {
    tk_crc_tab = table_new_i64()
    var i: i64 = 0
    while i < 256 {
        var c: i64 = i
        var k: i64 = 0
        while k < 8 {
            var lsb: i64 = c & 1
            c = c >> 1
            if lsb != 0 {
                c = c ^ 0xEDB88320
            }
            k = k + 1
        }
        table_push(tk_crc_tab, c)
        i = i + 1
    }
    tk_crc_ready = 1
}

// CRC32-IEEE 整段（表驱动；与 rdu_crc 逐位版逐字节等价）。
pub func crc32(p: table<i64>) -> i64 {
    if tk_crc_ready == 0 {
        crc_tab_build()
    }
    var c: i64 = 0xFFFFFFFF
    var n = len(p)
    var i: i64 = 0
    while i < n {
        var b = p[i]
        if b < 0 || b > 255 {
            b = 0
        }
        c = (c >> 8) ^ tk_crc_tab[(c ^ b) & 0xFF]
        i = i + 1
    }
    return c ^ 0xFFFFFFFF
}

// 帧编码：len(u32 BE) + payload + crc(u32 BE)。
pub func frame_encode(payload: table<i64>) -> table<i64> {
    var out = table_new_i64()
    var n = len(payload)
    table_push(out, (n >> 24) & 0xFF)
    table_push(out, (n >> 16) & 0xFF)
    table_push(out, (n >> 8) & 0xFF)
    table_push(out, n & 0xFF)
    var i: i64 = 0
    while i < n {
        table_push(out, payload[i])
        i = i + 1
    }
    var c = crc32(payload)
    table_push(out, (c >> 24) & 0xFF)
    table_push(out, (c >> 16) & 0xFF)
    table_push(out, (c >> 8) & 0xFF)
    table_push(out, c & 0xFF)
    return out
}

// 帧解析（校验 CRC）。bytes[pos..] → (payload, next_pos)；失败 (空表, -1)。
// 与 std/tink.frame_next 同语义（CRC 不符 = 拒帧，不静默传递损坏数据）。
pub func frame_next(bytes: table<i64>, pos: i64) -> (table<i64>, i64) {
    var empty = table_new_i64()
    var nb = len(bytes)
    if pos < 0 || pos + 7 >= nb {
        return (empty, -1)
    }
    var n = ((bytes[pos] & 0xFF) << 24) | ((bytes[pos + 1] & 0xFF) << 16) | ((bytes[pos + 2] & 0xFF) << 8) | (bytes[pos + 3] & 0xFF)
    if n < 0 || pos + 8 + n > nb {
        return (empty, -1)
    }
    var payload = table_new_i64()
    var i: i64 = 0
    while i < n {
        table_push(payload, bytes[pos + 4 + i])
        i = i + 1
    }
    var c = ((bytes[pos + 4 + n] & 0xFF) << 24) | ((bytes[pos + 5 + n] & 0xFF) << 16) | ((bytes[pos + 6 + n] & 0xFF) << 8) | (bytes[pos + 7 + n] & 0xFF)
    if crc32(payload) != c {
        return (empty, -1)
    }
    return (payload, pos + 8 + n)
}

// 帧跳过（不校验 CRC；快速定位）。失败 -1。
pub func frame_skip(bytes: table<i64>, pos: i64) -> i64 {
    var nb = len(bytes)
    if pos < 0 || pos + 7 >= nb {
        return -1
    }
    var n = ((bytes[pos] & 0xFF) << 24) | ((bytes[pos + 1] & 0xFF) << 16) | ((bytes[pos + 2] & 0xFF) << 8) | (bytes[pos + 3] & 0xFF)
    if n < 0 || pos + 8 + n > nb {
        return -1
    }
    return pos + 8 + n
}

}   // namespace tinker
