type tie<class>
// compiler/frontend/lex_scan.tie —— T2.4 token 扫描器（模块拆分）
// ============================================================
// 里程碑：自举 v2 计划 T2.4（.omo/plans/self-hosting-v2.md）完整词法器
// lexer.tie 拆分为 5 模块之一（本文件 = 各 token 扫描器 + 错误槽写入）。
// 共享状态（g_codes/g_n/g_src/g_line_starts/g_err_*）来自 ./lex_state.tie
// （经 ./lex_tokdefs.tie 传递可达），tag 常量来自 ./lex_tokdefs.tie，
// 关键字/符号查表走 ./lex_symtab.tie，错误消息走 ./errors.tie，
// 字符串函数走 /std/string.tie，池化走 ../lib/interner.tie。
// 依赖：./lex_tokdefs.tie（tag 常量 + 列式表 + 字符分类 + 行列反推，
// 经其传递可达 ./lex_state.tie 共享全局 + ../lib/interner.tie 池 +
// /std/string.tie 字符串函数）+ ./lex_symtab.tie（关键字/符号查表）
// + ./errors.tie（错误消息）。树状无环，唯一 import 路径。
// 由 lexer.tie import。

import "./lex_tokdefs.tie"
import "./lex_symtab.tie"
import "./errors.tie"

namespace lexscan {

// ---------- 错误槽位 ----------
// 记录词法错误（line/col 1 起；msg 为 errors 表消息或格式函数结果）
func set_err(line: i64, col: i64, msg: string) {
    g_err_line = line
    g_err_col = col
    g_err_msg = msg
}

// ---------- 各 token 扫描器 ----------
// 输入 pos（当前字符位置），返回扫描结束后的位置；出错置全局错误槽返回 -1。

// 码点区间快切（性能重构）：[a, b) 的 lexeme 切片走 g_byte_starts 字节偏移
// 表 + str_sub_bytes 字节 memcpy——O(len) 单次拷贝；替代 str.slice（码点
// 定位每次从头跳，全体 token 累计 O(T×N) 平方）。b == g_n 合法（哨兵项
// g_byte_starts[g_n] = 总字节数）。
func cp_slice(a: i64, b: i64) -> string {
    // 字节快切：g_byte_starts 码点→字节偏移表定位字节区间 + StringBuilder
    // 逐字节拷贝——O(len) 线性（str.slice 码点定位每次从头跳 O(n)，全体
    // token 累计 O(T×N) 平方，400 函数实测 parse 89% 耗时根源）。
    // 注：用 sb_append_byte 组合而非 str_sub_bytes 原语——自举兼容（旧
    // 编译器即认 S2.1 原语，免两阶段套娃构建）。
    var lo = g_byte_starts[a]
    var hi = g_byte_starts[b]
    var sb = string_builder()
    var k: i64 = lo
    while k < hi {
        sb_append_byte(sb, str_byte(g_src, k))
        k = k + 1
    }
    return sb_build(sb)
}

// 行尾定位：返回本行最后一个字符之后的位置（停在 '\n'，不消费）
func line_end(pos: i64) -> i64 {
    while pos < g_n {
        if g_codes[pos] == 10 {
            break
        }
        pos = pos + 1
    }
    return pos
}

// 块注释闭合定位：从 pos 起找 "*/"，返回其后位置；未闭合返回 -1
func find_block_close(pos: i64) -> i64 {
    while pos < g_n {
        if g_codes[pos] == 42 {        // '*'
            if pos + 1 < g_n {
                if g_codes[pos + 1] == 47 {   // '*/'
                    return pos + 2
                }
            }
        }
        pos = pos + 1
    }
    return -1
}

// 行注释 //...：不产 token，停在换行符
func scan_line_comment(pos: i64) -> i64 {
    return line_end(pos + 2)
}

// doc 行注释 ///...：内容收集为 doc
func scan_doc_line(pos: i64) -> i64 {
    var end = line_end(pos + 3)
    lextok.collect_doc(cp_slice(pos + 3, end))
    return end
}

// 块注释 /*...*/：未闭合报错（位置取注释起点）
func scan_block_comment(pos: i64) -> i64 {
    var close = find_block_close(pos + 2)
    if close < 0 {
        set_err(lextok.line_of(pos), lextok.col_of(pos), errors.err_msg("lex_block_unclosed"))
        return -1
    }
    return close
}

// doc 块注释 /**...*/：内容收集为 doc；未闭合同报「块注释未闭合」
func scan_doc_block(pos: i64) -> i64 {
    var close = find_block_close(pos + 3)
    if close < 0 {
        set_err(lextok.line_of(pos), lextok.col_of(pos), errors.err_msg("lex_block_unclosed"))
        return -1
    }
    lextok.collect_doc(cp_slice(pos + 3, close - 2))
    return close
}

// 合法转义：\n \t \r \\ \" \' \0（与 Rust scan_string/scan_char 一致）
func is_valid_escape(e: i64) -> bool {
    return e == 110 || e == 116 || e == 114 || e == 92 || e == 34 || e == 39 || e == 48
}

// 字符串（可跨行；lexeme = 原始切片含引号，parser 阶段再解码转义）。
// p.8.2.3 字符串插值：遇未转义 '{'（'{{' 转义字面）→ 当前段以合成 lexeme
// `"text"` 发 lex_str + 发 lex_interp_lbrace（插值专用 tag，区别于块开括号
// lex_lbrace，避免 `if s == "a" {` 的块 lbrace 被 parser 误认插值）标记插值
// 开始（g_str_interp=1），返回 `{` 后位置由主循环继续 lex 表达式；主循环遇
// `}`（g_str_interp==1）置 2，下一 token 经主循环分派本函数**续扫**（无开引号，
// g_str_interp==2）。
pub func scan_string(pos: i64) -> i64 {
    var start = pos
    var cont = g_str_interp == 2
    if !cont {
        pos = pos + 1   // 跳过开引号 '"'
    }
    // 段文本构建（字面 `{`/`}` 原样保留；`{{`/`}}` **不**在 lexer 折叠——
    // p.9.12.1：字符串字面量里的 `}}` 是 JSON/模板合法字节，逐字保留，不能
    // 折叠成 `}`（曾致 tsp 等 JSON 响应缺尾括号）。插值字符串段的花括号
    // 转义（{{→{ / }}→}）改由 parser 的 parse_interp_chain 折叠；\X 转义原样
    // 保留，由 parser 的 str_unescape_quoted 统一还原）
    var sb = string_builder()
    var done = false
    while pos < g_n {
        if g_codes[pos] == 92 {        // 反斜杠
            pos = pos + 1
            if pos >= g_n {
                set_err(lextok.line_of(start), lextok.col_of(start), errors.err_msg("lex_escape_missing"))
                return -1
            }
            var e = g_codes[pos]
            if !is_valid_escape(e) {
                set_err(lextok.line_of(start), lextok.col_of(start),
                    errors.lex_unknown_escape(str_char(g_src, pos)))
                return -1
            }
            sb_append_byte(sb, 92)     // '\' 原样
            sb_append_byte(sb, e)
            pos = pos + 1
        } else if g_codes[pos] == 34 { // 闭引号 '"'
            pos = pos + 1
            done = true
            break
        } else if g_codes[pos] == 123 && pos + 1 < g_n && g_codes[pos + 1] == 123 {
            // '{{' → '{'：插值字符串里 `{{` 表字面 `{`（且防 `{literal}` 起插值）。
            // p.9.12.1：仅折叠 `{{`；**不**折叠 `}}`——JSON/模板里的 `}}` 是合法
            // 字节，逐字保留（曾致 tsp 等 JSON 响应缺尾括号）。`}}`→`}` 的
            // 插值段转义改由 parse_interp_chain 折叠。
            sb_append_byte(sb, 123)    // '{{' → '{' 字面
            pos = pos + 2
        } else if g_codes[pos] == 123 {
            // 插值开始判定（前瞻）：`{` 后**紧邻**字符是表达式起始（数字/_/(/[/!/~/$
            // 或标识符——语句关键字与映射显示串排除）才触发插值；否则 `{` 是字面
            // （兼容既有 JSON `{"key": 1}`、代码片段 `"{ return ...; }"`、
            // `"{ 10; }"`、映射显示 `"{a: 1}"` 等，其 `{` 后是 `"`/空白/关键字）。
            var start_expr: bool = false
            // 判定只认 `{` 后**紧邻**字符（不跳空白）：`"{ 10; }"`/`"{ x }"` 带
            // 空格的花括号是字面（代码片段/模板，interp_eval 实测回归）——
            // 插值表达式按 `"{expr}"` 紧贴书写。
            var nx = pos + 1
            if nx < g_n {
                var c0 = g_codes[nx]
                // 注意：`+`/`-` 排除（`"{" + x` 拼接字面常见；`"{-n}"` 插值
                // 罕见）；`"`/`'` 排除（JSON `{"a":1}` 字面兼容）
                if lextok.is_digit(c0) || c0 == 95 || c0 == 40 || c0 == 91 ||
                    c0 == 33 || c0 == 126 || c0 == 36 {
                    start_expr = true
                } else if (c0 >= 65 && c0 <= 90) || (c0 >= 97 && c0 <= 122) {
                    // 标识符起始（**仅 ASCII 字母**——非 ASCII（中文等）不触发：
                    // 编译器/错误消息里的 `"{语句块}"` 等字面串保持原样，中文文本
                    // 写进字面段，插值表达式用 ASCII 标识符如 `"你好，{cn}！"`）。
                    // 语句/声明关键字不能起插值表达式——代码片段字面 `"{return ...}"`
                    // 保持字面；值字面量 true/false/zero 可起；普通标识符（变量/
                    // 函数名）可起——但后随 `:`（映射显示串 `"{a: 1, b: 2}"`）字面。
                    var j = nx + 1
                    while j < g_n && lextok.is_ident_cont(g_codes[j]) {
                        j = j + 1
                    }
                    var ktag = lexsym.kw_lookup(cp_slice(nx, j))
                    if ktag >= 0 {
                        if ktag == lex_true || ktag == lex_false || ktag == lex_zero {
                            start_expr = true
                        }
                    } else {
                        if j < g_n && g_codes[j] == 58 {   // ':' → 映射显示串
                            start_expr = false
                        } else {
                            start_expr = true
                        }
                    }
                }
            }
            if start_expr {
                // 插值：段 lexeme 合成（`"text"`，parser 复用 str_unescape_quoted）
                var seg = sb_build(sb)
                var lid = interner.intern("\"" + seg + "\"")
                lextok.push_token_at(lex_str, start, lid)
                var lb = interner.intern("{")
                lextok.push_token_at(lex_interp_lbrace, pos, lb)
                g_str_interp = 1
                return pos + 1
            }
            // 字面 '{'：继续作为普通字符
            sb_append_byte(sb, 123)
            pos = pos + 1
        } else {
            // 普通码点：按 UTF-8 字节序列追加（非 ASCII 码点 >255，不能直存字节）
            var bs = g_byte_starts[pos]
            var be = g_byte_starts[pos + 1]
            var bi: i64 = bs
            while bi < be {
                sb_append_byte(sb, str_byte(g_src, bi))
                bi = bi + 1
            }
            pos = pos + 1
        }
    }
    if !done {
        set_err(lextok.line_of(start), lextok.col_of(start), errors.err_msg("lex_str_unclosed"))
        return -1
    }
    var seg2 = sb_build(sb)
    var lid2 = interner.intern("\"" + seg2 + "\"")
    lextok.push_token_at(lex_str, start, lid2)
    if g_str_interp == 2 {
        g_str_interp = 0   // 续段闭合 → 退出插值模式
    }
    return pos
}

// p.9.11.30 三引号多行字符串 """..."""：跨行、raw 语义默认（\X 逐字保留，
// 仅 `\{` → 字面 `{` 防插值）、闭引号行基准缩进剥离（Swift 对齐语义）、
// 插值与单行同机制（`{` 前瞻判定复制自 scan_string 的 `{` 分支，双份维护）。
// 首行 `"""` 后紧跟换行 → 内容自下一行起；闭引号前最后一个换行剥离。
// 限制（v1）：内容中不可出现 `"""`；插值表达式内不可跨行（ASI 断句）。
// cont=1：g_str_interp==2 的续段重入（pos 为 `}` 之后，无开引号处理）。
func find_triple_end(pos: i64) -> i64 {
    while pos + 2 < g_n {
        if g_codes[pos] == 34 && g_codes[pos + 1] == 34 && g_codes[pos + 2] == 34 {
            return pos
        }
        pos = pos + 1
    }
    return -1
}

// 行内缩进（空白字符数）：从行起点到 pos 的空格/制表计数（margin 剥离基准）
func triple_line_indent(pos: i64) -> i64 {
    var ls = pos
    while ls > 0 && g_codes[ls - 1] != 10 {
        ls = ls - 1
    }
    var n: i64 = 0
    while ls < pos && (g_codes[ls] == 32 || g_codes[ls] == 9) {
        n = n + 1
        ls = ls + 1
    }
    return n
}

pub func scan_triple_string(pos: i64) -> i64 {
    var cont = g_str_interp == 2
    var start = pos
    var c0 = pos
    var close = -1
    var margin: i64 = 0
    if !cont {
        close = find_triple_end(pos + 3)
        if close < 0 {
            set_err(lextok.line_of(pos), lextok.col_of(pos), errors.err_msg("lex_str_unclosed"))
            return -1
        }
        margin = triple_line_indent(close)
        c0 = pos + 3
        // 首行 `"""` 后紧跟换行 → 内容自下一行起（LF/CR+LF）
        if c0 < close {
            if g_codes[c0] == 10 {
                c0 = c0 + 1
            } else if g_codes[c0] == 13 && c0 + 1 < g_n && g_codes[c0 + 1] == 10 {
                c0 = c0 + 2
            }
        }
    } else {
        close = find_triple_end(pos)
        if close < 0 {
            set_err(lextok.line_of(pos), lextok.col_of(pos), errors.err_msg("lex_str_unclosed"))
            return -1
        }
        margin = triple_line_indent(close)
    }
    // 闭引号行处理：若最后一行仅空白（闭引号独立成行的常规形态），连同其前的
    // 换行一并丢弃（Swift 对齐）；否则内容原样保留。
    var c1 = close
    var p2 = c1
    while p2 > c0 && (g_codes[p2 - 1] == 32 || g_codes[p2 - 1] == 9) {
        p2 = p2 - 1
    }
    if p2 > c0 && g_codes[p2 - 1] == 10 {
        c1 = p2 - 1
        if c1 > c0 && g_codes[c1 - 1] == 13 {
            c1 = c1 - 1
        }
    }
    var sb = string_builder()
    var p = c0
    var at_line_start: bool = !cont
    var pending_ws: i64 = 0   // 当前行已累积的行首空白（未超 margin 前暂存）
    while p < c1 {
        var ch = g_codes[p]
        // 行首空白：暂存不写，超过 margin 或遇非空白时按 margin 上限补写
        if at_line_start && (ch == 32 || ch == 9) {
            pending_ws = pending_ws + 1
            if pending_ws > margin {
                var bs0 = g_byte_starts[p]
                var be0 = g_byte_starts[p + 1]
                var bi0: i64 = bs0
                while bi0 < be0 {
                    sb_append_byte(sb, str_byte(g_src, bi0))
                    bi0 = bi0 + 1
                }
                at_line_start = false
            }
            p = p + 1
            continue
        }
        if at_line_start {
            at_line_start = false   // 行首空白不足 margin：无剥离
        }
        if ch == 10 {
            var bs1 = g_byte_starts[p]
            var be1 = g_byte_starts[p + 1]
            var bi1: i64 = bs1
            while bi1 < be1 {
                sb_append_byte(sb, str_byte(g_src, bi1))
                bi1 = bi1 + 1
            }
            at_line_start = true
            pending_ws = 0
            p = p + 1
        } else if ch == 13 && p + 1 < c1 && g_codes[p + 1] == 10 {
            p = p + 1   // CR+LF：只保留 LF（源内 CRLF 统一）
        } else if ch == 92 && p + 1 < c1 && g_codes[p + 1] == 123 {
            // `\{` → 字面 `{`（插值转义；raw 语义下其余 \X 逐字保留）
            sb_append_byte(sb, 123)
            p = p + 2
        } else if ch == 92 {
            // raw 语义：`\X` 逐字保留。但 lexeme 送 parser str_unescape_quoted
            // 统一还原，`\` 会被当转义前缀——此处双写 `\`（unesc 后还原为单）。
            sb_append_byte(sb, 92)
            sb_append_byte(sb, 92)
            var bs2 = g_byte_starts[p + 1]
            var be2 = g_byte_starts[p + 2]
            var bi2: i64 = bs2
            while bi2 < be2 {
                sb_append_byte(sb, str_byte(g_src, bi2))
                bi2 = bi2 + 1
            }
            p = p + 2
        } else if ch == 123 {
            // 插值开始判定：前瞻逻辑复制自 scan_string `{` 分支（双份维护）
            var start_expr: bool = false
            var nx = p + 1
            if nx < g_n {
                var c0x = g_codes[nx]
                if lextok.is_digit(c0x) || c0x == 95 || c0x == 40 || c0x == 91 ||
                    c0x == 33 || c0x == 126 || c0x == 36 {
                    start_expr = true
                } else if (c0x >= 65 && c0x <= 90) || (c0x >= 97 && c0x <= 122) {
                    var j = nx + 1
                    while j < g_n && lextok.is_ident_cont(g_codes[j]) {
                        j = j + 1
                    }
                    var ktag = lexsym.kw_lookup(cp_slice(nx, j))
                    if ktag >= 0 {
                        if ktag == lex_true || ktag == lex_false || ktag == lex_zero {
                            start_expr = true
                        }
                    } else {
                        if j < g_n && g_codes[j] == 58 {
                            start_expr = false
                        } else {
                            start_expr = true
                        }
                    }
                }
            }
            if start_expr {
                var seg = sb_build(sb)
                var lid = interner.intern("\"" + seg + "\"")
                lextok.push_token_at(lex_str, start, lid)
                var lb = interner.intern("{")
                lextok.push_token_at(lex_interp_lbrace, p, lb)
                g_str_interp = 1
                g_str_triple = 1
                return p + 1
            }
            var bs3 = g_byte_starts[p]
            var be3 = g_byte_starts[p + 1]
            var bi3: i64 = bs3
            while bi3 < be3 {
                sb_append_byte(sb, str_byte(g_src, bi3))
                bi3 = bi3 + 1
            }
            p = p + 1
        } else if ch == 34 && p + 2 < g_n && g_codes[p + 1] == 34 && g_codes[p + 2] == 34 {
            // 内容中 `"""` → 提前闭合（不应到达：close 已预扫，防御）
            break
        } else {
            var bs4 = g_byte_starts[p]
            var be4 = g_byte_starts[p + 1]
            var bi4: i64 = bs4
            while bi4 < be4 {
                sb_append_byte(sb, str_byte(g_src, bi4))
                bi4 = bi4 + 1
            }
            p = p + 1
        }
    }
    var seg2 = sb_build(sb)
    var lid2 = interner.intern("\"" + seg2 + "\"")
    lextok.push_token_at(lex_str, start, lid2)
    if g_str_interp == 2 {
        g_str_interp = 0
    }
    g_str_triple = 0
    return close + 3
}

// p.9.11.19 raw 字符串 r"..."：免转义字面（`\n` 保持两字符；**无插值**——`{`
// 原样字符，不触发 p.8.2.3 插值链）。内双引号转义形态裁决：`""` 双写 → 字面
// `"`（`r"a""b"` = a"b）；否则遇 `"` 结束（`r""` 空串）。跨行 raw 不做专门
// 支持（内容含换行照常原样收录，与普通字符串一致）。入口：scan_ident 扫到
// 标识符 "r" 且下一字符为 '"'（pos 已指向开引号）。产出 lex_str token，
// lexeme = `"` + 段（"" 已还原为 "）+ `"`（parser 复用 str_unescape_quoted）。
pub func scan_raw_string(pos: i64) -> i64 {
    var start = pos - 1   // 指向 'r'（token 起点）
    pos = pos + 1         // 跳过开引号 '"'
    var sb = string_builder()
    var done = false
    while pos < g_n {
        if g_codes[pos] == 34 {          // '"'
            if pos + 1 < g_n && g_codes[pos + 1] == 34 {
                sb_append_byte(sb, 34)   // "" → 字面 '"'
                pos = pos + 2
            } else {
                pos = pos + 1
                done = true
                break
            }
        } else {
            // 原样码点（UTF-8 字节序列追加；不处理 \ 转义）
            var bs = g_byte_starts[pos]
            var be = g_byte_starts[pos + 1]
            var bi: i64 = bs
            while bi < be {
                sb_append_byte(sb, str_byte(g_src, bi))
                bi = bi + 1
            }
            pos = pos + 1
        }
    }
    if !done {
        set_err(lextok.line_of(start), lextok.col_of(start), errors.err_msg("lex_str_unclosed"))
        return -1
    }
    var seg = sb_build(sb)
    // lexeme = `r"` + 段 + `"`（r 前缀标记 raw，str_unescape_quoted/unescape_str
    // 识别后不反转义；普通字符串 lexeme 无前缀）
    var lid = interner.intern("r\"" + seg + "\"")
    lextok.push_token_at(lex_str, start, lid)
    return pos
}

// 字符字面量 'a' / '\n' / '\''（单引号包裹恰好一个字符，支持转义）
pub func scan_char(pos: i64) -> i64 {
    var start = pos
    pos = pos + 1   // 开引号 '\''
    if pos >= g_n {
        set_err(lextok.line_of(start), lextok.col_of(start), errors.err_msg("lex_char_unclosed"))
        return -1
    }
    if g_codes[pos] == 92 {            // 反斜杠转义
        pos = pos + 1
        if pos >= g_n {
            set_err(lextok.line_of(start), lextok.col_of(start), errors.err_msg("lex_escape_missing"))
            return -1
        }
        var e = g_codes[pos]
        if !is_valid_escape(e) {
            set_err(lextok.line_of(start), lextok.col_of(start),
                errors.lex_unknown_escape(str_char(g_src, pos)))
            return -1
        }
        pos = pos + 1
    } else {
        pos = pos + 1   // 一个内容字符
    }
    if pos >= g_n {
        set_err(lextok.line_of(start), lextok.col_of(start), errors.err_msg("lex_char_unclosed"))
        return -1
    }
    if g_codes[pos] == 39 {            // 闭引号 '\''
        pos = pos + 1
        var lid = interner.intern(cp_slice(start, pos))
        lextok.push_token_at(lex_charlit, start, lid)
        return pos
    }
    set_err(lextok.line_of(start), lextok.col_of(start), errors.err_msg("lex_char_multi"))
    return -1
}

// 消费 [lo,hi] 码点区间的进制数字（0b/0o/0t 共用）。
// p.9.11.19 数字分隔符 `_`：进制数字内 `_` 且下一位仍在该进制区间 → 跳过
//（`0b1010_1010`）；否则停止（`1_` 尾分隔、`_x` 标识符不受影响——仅数字内）。
func scan_digit_range(pos: i64, lo: i64, hi: i64) -> i64 {
    while pos < g_n {
        var c = g_codes[pos]
        if c == 95 {   // '_'
            if pos + 1 < g_n && g_codes[pos + 1] >= lo && g_codes[pos + 1] <= hi {
                pos = pos + 1
            } else {
                break
            }
        } else if c >= lo {
            if c <= hi {
                pos = pos + 1
            } else {
                break
            }
        } else {
            break
        }
    }
    return pos
}

// 消费十六进制数字（0-9 a-f A-F）。p.9.11.19：`_` 后随十六进制数字 → 跳过
//（`0x_FF` / `0xCA_FE`）。
func scan_hex_digits(pos: i64) -> i64 {
    while pos < g_n {
        var c = g_codes[pos]
        if c == 95 {
            if pos + 1 < g_n && lextok.is_hex_digit(g_codes[pos + 1]) {
                pos = pos + 1
            } else {
                break
            }
        } else if lextok.is_hex_digit(c) {
            pos = pos + 1
        } else {
            break
        }
    }
    return pos
}

// 尝试解析指数 e/E [+-] 数字：成功返回消费后位置，失败返回 -1。
// p.9.11.19：指数数字内 `_` 且下一位是数字 → 跳过（`1e1_0`）。
func scan_exponent(pos: i64) -> i64 {
    var j = pos + 1
    if j >= g_n {
        return -1
    }
    if g_codes[j] == 45 || g_codes[j] == 43 {   // '-' / '+'
        j = j + 1
    }
    if j >= g_n {
        return -1
    }
    if !lextok.is_digit(g_codes[j]) {
        return -1
    }
    var end = j + 1
    while end < g_n {
        var c = g_codes[end]
        if lextok.is_digit(c) {
            end = end + 1
        } else if c == 95 {
            if end + 1 < g_n && lextok.is_digit(g_codes[end + 1]) {
                end = end + 1
            } else {
                break
            }
        } else {
            break
        }
    }
    return end
}

// 数字：整数（十进制/0x/0b/0o/0t）或浮点（小数点与指数）。边界对齐 Rust
// scan_number（1..10 的 .. 不被误吃；0xFF 等进制前缀只在恰好单个 "0" 时触发）。
pub func scan_number(pos: i64) -> i64 {
    var start = pos
    var is_float = false
    var saw_e = false
    var digits_consumed: i64 = 0
    var scanning = true
    while scanning {
        var c: i64 = 0
        if pos < g_n {              // 防护：消费完即终止（防 OOB 读）
            c = g_codes[pos]
        }
        if lextok.is_digit(c) {
            pos = pos + 1
            digits_consumed = digits_consumed + 1
        } else if c == 95 {         // '_' 数字分隔符（p.9.11.19）：仅当下一位
            // 是数字时跳过（`1_000` / `1_000.5`）；否则停止——`1_` 尾分隔、
            // `_x` 标识符起始都不在此路径（本函数只处理数字 token 内部）。
            if pos + 1 < g_n && lextok.is_digit(g_codes[pos + 1]) {
                pos = pos + 1
            } else {
                scanning = false
            }
        } else if c == 46 {         // '.'
            if is_float {
                scanning = false
            } else if pos + 1 < g_n {
                if lextok.is_digit(g_codes[pos + 1]) {   // 下一位是数字才视作小数
                    is_float = true
                    pos = pos + 1
                } else {
                    scanning = false
                }
            } else {
                scanning = false
            }
        } else if c == 101 || c == 69 {   // 'e' / 'E' 指数
            if saw_e {
                scanning = false
            } else {
                var eend = scan_exponent(pos)
                if eend > 0 {
                    saw_e = true
                    is_float = true
                    pos = eend
                }
                scanning = false
            }
        } else {
            scanning = false
        }
    }
    // 进制前缀：恰好单个 '0' 且未成浮点 → 查 0x/0b/0o/0t（大小写均可）
    if digits_consumed == 1 {
        if !is_float {
            if g_codes[start] == 48 {
                if pos < g_n {
                    var r = g_codes[pos]
                    if r == 120 || r == 88 {          // x/X → 十六进制
                        pos = scan_hex_digits(pos + 1)
                    } else if r == 98 || r == 66 {    // b/B → 二进制
                        pos = scan_digit_range(pos + 1, 48, 49)
                    } else if r == 111 || r == 79 {   // o/O → 八进制
                        pos = scan_digit_range(pos + 1, 48, 55)
                    } else if r == 116 || r == 84 {   // t/T → 三进制
                        // 仅当后随 0-2 数字才作三进制前缀（否则让位给 trit 后缀
                        // 0t —— 数字部分为纯十进制的 trit 字面量，见下 suffix 块）
                        if pos + 1 < g_n && g_codes[pos + 1] >= 48 && g_codes[pos + 1] <= 50 {
                            pos = scan_digit_range(pos + 1, 48, 50)
                        }
                    }
                }
            }
        }
    }
    var tag = lex_int
    if is_float {
        tag = lex_float
    }
    // S1.3 L3 后缀字面量：数字后紧跟类型后缀（i8/i16/i32/i64/u8/u16/u32/u64/
    // f32/f64，无空白）→ 吞并进 lexeme（如 "42i32" / "0x80u16" / "1.5f32"）。
    // 浮点后缀（f32/f64）把 token 标记为 lex_float（parser 按后缀定类型）。
    // 只吞精确后缀串：非后缀字母序列不吞（"42abc" 保持 42 + abc，parser 报错）。
    if pos < g_n {
        var c = g_codes[pos]
        if (c >= 97 && c <= 122) || (c >= 65 && c <= 90) {
            var j = pos
            var suf: string = ""
            while j < g_n {
                // 后缀串 = 字母开头 + 字母数字混合（i32/u8/f64）：
                // 收集 is_ident_cont（字母/数字/_）再精确匹配
                if lextok.is_ident_cont(g_codes[j]) {
                    suf = suf + str_char(g_src, j)
                    j = j + 1
                } else {
                    break
                }
            }
            if suf == "i8" || suf == "i16" || suf == "i32" || suf == "i64" ||
                suf == "u8" || suf == "u16" || suf == "u32" || suf == "u64" ||
                suf == "i128" || suf == "u128" {
                pos = j
            } else if suf == "f32" || suf == "f64" {
                tag = lex_float
                pos = j
            } else if suf == "t" || suf == "T" {
                // trit 字面量后缀：数字部分是纯十进制（-1t/0t/1t；-1 由一元
                // 负号 + 1t 表达）。2t/99t 等越界值也吞并（值域检查在 pexpr
                // 报「trit 字面量越界」）。进制前缀数字（0x1t / 0b1t）保留 +
                // 独立 t——非纯十进制不吞。
                var pre = cp_slice(start, pos)
                var is_dec = str_len(pre) >= 1
                var pi: i64 = 0
                while pi < str_len(pre) {
                    var pc = str_char(g_src, start + pi)
                    if pc < "0" || pc > "9" {
                        is_dec = false
                        break
                    }
                    pi = pi + 1
                }
                if is_dec {
                    tag = lex_int
                    pos = j
                }
            }
        }
    }
    var lid = interner.intern(cp_slice(start, pos))
    lextok.push_token_at(tag, start, lid)
    return pos
}

// 标识符 / 关键字：切片 intern 后查关键字表转 tag。
// p.9.11.19：标识符恰为 "r" 且下一字符是 '"' → raw 字符串 r"..."（转发
// scan_raw_string，pos 已指向开引号）；否则普通标识符/关键字。
pub func scan_ident(pos: i64) -> i64 {
    var start = pos
    while pos < g_n {
        if lextok.is_ident_cont(g_codes[pos]) {
            pos = pos + 1
        } else {
            break
        }
    }
    var lex = cp_slice(start, pos)
    if lex == "r" {
        if pos < g_n && g_codes[pos] == 34 {
            return scan_raw_string(pos)
        }
    }
    var lid = interner.intern(lex)
    var tag = lexsym.kw_lookup(lex)
    if tag < 0 {
        tag = lex_ident
    }
    lextok.push_token_at(tag, start, lid)
    return pos
}

// 符号：3→2→1 字符最长匹配查符号表；未命中报「无法识别的字符」
pub func scan_symbol(pos: i64) -> i64 {
    var start = pos
    // p.9.13.1 单箭头统一：`=>` 已移除。在最长匹配之前显式判定「`=` 后紧跟 `>`」，
    // 提前报精确诊断（避免退化成 `=` `>` 两个 token 的隐性误配误指）。相邻 `>=`
    //（首字符 `>`）、`==`、`=` 因首字符/第二字符不同不受影响。
    if pos + 1 < g_n && g_codes[pos] == 61 && g_codes[pos + 1] == 62 {
        set_err(lextok.line_of(start), lextok.col_of(start), errors.lex_fatarrow_removed())
        return -1
    }
    var want: i64 = 3
    while want >= 1 {
        if pos + want <= g_n {
            var lex = cp_slice(pos, pos + want)
            var tag = lexsym.sym_lookup(lex)
            if tag >= 0 {
                var lid = interner.intern(lex)
                lextok.push_token_at(tag, start, lid)
                return pos + want
            }
        }
        want = want - 1
    }
    set_err(lextok.line_of(start), lextok.col_of(start), errors.lex_unrecognized(str_char(g_src, pos)))
    return -1
}

// ---------- 主循环 '/' 分派 ----------
// '/' 分派：行注释 / doc 行 / 块注释 / doc 块 / 除号符号（返回新位置，-1 出错）。
// doc 块判定：'/**' 且第三字符不是 '/'——'/**/' 的空闭合按普通块注释。
pub func scan_slash(pos: i64) -> i64 {
    var n1: i64 = 0
    if pos + 1 < g_n {
        n1 = g_codes[pos + 1]
    }
    if n1 == 47 {                // '//'
        if pos + 2 < g_n {
            if g_codes[pos + 2] == 47 {   // '///'
                return scan_doc_line(pos)
            }
        }
        return scan_line_comment(pos)
    }
    if n1 == 42 {                // '/*'
        var is_doc: bool = false
        if pos + 2 < g_n {
            if g_codes[pos + 2] == 42 {   // '/**'
                if pos + 3 >= g_n {
                    is_doc = true
                } else if g_codes[pos + 3] != 47 {
                    is_doc = true
                }
            }
        }
        if is_doc {
            return scan_doc_block(pos)
        }
        return scan_block_comment(pos)
    }
    return scan_symbol(pos)      // '/' 单字符或 '/=' 等符号
}

}
