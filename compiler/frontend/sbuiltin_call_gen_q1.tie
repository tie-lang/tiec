pub func builtin_call_b_to_string(fn_name: string, args: table<i64>, call_node: i64) -> i64 {
    var nargs = len(args)
    // ---------- S1.2 unsafe 指针/内存内置（固定返回类型部分） ----------
    // 动态返回类型（addr_of/deref/slice_of/ptr_add）由调用点 infer 特判。
        if nargs != 1 {
            sm_err_line = s_lines[call_node]
            sm_err_col = s_cols[call_node]
            sm_err_msg = fn_name + "() 期望 1 个参数，实际 " + to_string(nargs) + " 个"
            return -2
        }
        if fn_name == "to_string" {
            return types.named(TK_STR)
        }
        if fn_name == "parse_float" {
            return types.named(TK_F64)
        }
        if fn_name == "parse_trit" {
            // trit 解析：桥返回 i8（值域 -1/0/1）——语义类型标 TK_TRIT，
            // 否则 to_string(parse_trit(x)) 会把 i8 值当 i64 直传类型错
            return types.named(TK_TRIT)
        }
        if fn_name == "to_trit" {
            // i64 → 饱和钳制 trit（>0→+1，<0→-1，0→0，对齐 interp_bin clamp_trit）
            return types.named(TK_TRIT)
        }
        if fn_name == "trit_val" {
            // trit → i64（-1/0/1 直接返回）
            return types.named(TK_I64)
        }
        return types.named(TK_I64)
}

pub func builtin_call_b_table_new_i64(fn_name: string, args: table<i64>, call_node: i64) -> i64 {
    var nargs = len(args)
    // ---------- S1.2 unsafe 指针/内存内置（固定返回类型部分） ----------
    // 动态返回类型（addr_of/deref/slice_of/ptr_add）由调用点 infer 特判。
        if nargs != 0 {
            sm_err_line = s_lines[call_node]
            sm_err_col = s_cols[call_node]
            sm_err_msg = fn_name + "() 期望 0 个参数，实际 " + to_string(nargs) + " 个"
            return -2
        }
        // 裸 table 返回（对齐 Rust 1947 行）：table_new_* 创建的空动态表，元素类型
        // 由调用名决定（VarDecl 分支 table_new_* 名字映射登记元素类型）。返回裸
        // table 而非 table<T>——赋值给标注 table<T> 变量时（如 `t = table_new_string()`
        // 且 t: table<i64>）Rust 侧 types_compatible(Table(x), Named(Table)) 放行，
        // 元素化返回会因元素类型严格比较而误报（见 T5 语义缺口修复记录）。
        return types.named(TK_TABLE)
}

