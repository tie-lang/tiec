type tie<class>
// compiler/frontend/stype.tie —— T2.6 语义类型辅助（模块拆分）
// ============================================================
// 里程碑：自举 v2 计划 T2.6（.omo/plans/self-hosting-v2.md）完整语义分析
// 拆分为 8 模块之一（本文件 = 类型节点解析 + 类型兼容/匹配判定）。
// 对应 proto/semantic.tie 755-857（parse_type_node）+ 1410-1476
// （types_compatible）+ 1478-1543（types_match）逻辑搬移。
// 类型系统复用 middle/types.tie（types.named/table_of/kind/low/判据族/
// type_name 与 proto 的 ty_* 完全同构）与 middle/data.tie（tag 段表）。
// 依赖：./sstate.tie（AST 全局 + 符号表 + 工具，经其裸名访问 s_*/tup_*/
// sm_err_*）+ ../middle/data.tie（经其传递可达 ../middle/types.tie）。
// 树式无环：由 scollect.tie import（传递可达上层全部）。
import "./sstate.tie"
import "../middle/data.tie"

// p.9.11.21 interface 诊断辅助全局（tie 约束：全局变量须在命名空间之前）
var g_iface_vio_missing: bool = true;

namespace stype {

// 类型节点 → 类型 id（types 自编码；含 tuple 查找/登记）
pub func parse_type_node(tid: i64) -> i64 {
    var tag = s_tags[tid]
    if tag == S_N_NAMED_TYPE {
        return types.named(s_vals[tid])
    }
    if tag == S_N_TABLE_TYPE {
        var elem = parse_type_node(sstate.child(tid, 0))
        if elem < 0 {
            return -1
        }
        return types.table_of(elem)
    }
    if tag == S_N_MAP_TYPE {
        var v = parse_type_node(sstate.child(tid, 0))
        if v < 0 {
            return -1
        }
        return types.map_of(v)
    }
    if tag == S_N_STRUCT_TYPE {
        var nm = sstate.name_str(tid)
        // S1.2 内建不安全类型引用：`ptr<T>` / `slice<T>` / `atomic<T>`
        // （与 sgen.parse_generic_type_node 同款特判；tuple 字段类型走本路径）
        if nm == "ptr" || nm == "slice" || nm == "atomic" {
            var tslot = sstate.child(tid, 0)
            if tslot < 0 || s_tags[tslot] != S_N_TYPE_ARGS {
                sm_err_line = s_lines[tid]
                sm_err_col = s_cols[tid]
                sm_err_msg = "类型 '" + nm + "' 必须显式指定元素类型（如 " + nm + "<i64>）"
                return -1
            }
            var targ0 = sstate.child(tslot, 0)
            if targ0 < 0 {
                sm_err_line = s_lines[tid]
                sm_err_col = s_cols[tid]
                sm_err_msg = "类型 '" + nm + "' 缺少元素类型实参"
                return -1
            }
            var telem = parse_type_node(targ0)
            if telem < 0 {
                return -1
            }
            if nm == "ptr" {
                return types.ptr_of(telem)
            }
            if nm == "slice" {
                return types.slice_of(telem)
            }
            return types.atomic_of(telem)
        }
        var nid = intern.intern(nm)
        var idx = sstate.bs_find(st_keys, nid)
        if idx < 0 {
            // 枚举类型引用（复用 N_STRUCT_TYPE 承载标识符类型，按名分派）：
            // 先查 st_keys（struct），未命中查 en_keys（enum）
            var eidx = sstate.bs_find(en_keys, nid)
            if eidx < 0 {
                sm_err_line = s_lines[tid]
                sm_err_col = s_cols[tid]
                sm_err_msg = "类型 '" + nm + "' 未定义"
                return -1
            }
            return types.enum_of(en_vals[eidx])
        }
        return types.struct_of(st_vals[idx])
    }
    if tag == S_N_TUPLE_TYPE {
        // 查找/登记 tuple 类型
        var nf = sstate.nchild(tid)
        var i: i64 = 0
        while i < len(tuple_tys) {
            // 逐 tuple 比较字段
            var off = tup_offs[i]
            var cnt = tup_n[i]
            if cnt == nf {
                var match: bool = true
                var j: i64 = 0
                while j < nf {
                    var f = sstate.child(tid, j)
                    var fname = sstate.name_str(f)
                    var fty = parse_type_node(sstate.child(f, 0))
                    var fnid: i64 = -1
                    if fname != "" {
                        fnid = intern.intern(fname)
                    }
                    if tup_names[off + j] != fnid {
                        match = false
                        break
                    }
                    if tup_tys[off + j] != fty {
                        match = false
                        break
                    }
                    j = j + 1
                }
                if match {
                    return types.tuple_of(i)
                }
            }
            i = i + 1
        }
        // 新 tuple 登记（先占位再填值保证字段段紧凑 [off, off+nf)）
        var idx = len(tuple_tys)
        var off = len(tup_names)
        table_push(tup_offs, off)
        table_push(tup_n, nf)
        table_push(tuple_tys, types.tuple_of(idx))
        var j: i64 = 0
        while j < nf {
            table_push(tup_names, -1)
            table_push(tup_tys, 0)
            j = j + 1
        }
        var j2: i64 = 0
        while j2 < nf {
            var f = sstate.child(tid, j2)
            var fname = sstate.name_str(f)
            var fnid: i64 = -1
            if fname != "" {
                fnid = intern.intern(fname)
            }
            var fty = parse_type_node(sstate.child(f, 0))
            if fty < 0 {
                return -1
            }
            tup_names[off + j2] = fnid
            tup_tys[off + j2] = fty
            j2 = j2 + 1
        }
        return types.tuple_of(idx)
    }
    if tag == S_N_ARRAY_TYPE {
        // L1 定长数组：array<elem, N>（children = [元素类型, N_INT_LIT | N_VAR]）。
        // N_VAR = const 名（v2，查整型常量表）或值参数（实例化后已被替换为
        // N_INT_LIT——若残留 N_VAR 且查表失败即报错，防跨档错配）。
        // 内存安全：长度受 MAX_ARRAY_LEN 上限约束（护栏，防后端爆炸）。
        var elem = parse_type_node(sstate.child(tid, 0))
        if elem < 0 {
            return -1
        }
        var len_node = sstate.child(tid, 1)
        if len_node < 0 || (s_tags[len_node] != S_N_INT_LIT && s_tags[len_node] != S_N_VAR) {
            sm_err_line = s_lines[tid]
            sm_err_col = s_cols[tid]
            sm_err_msg = "数组长度必须是编译期整数字面量或常量名（array<T, N>）"
            return -1
        }
        var nlen = sstate.resolve_int_len_node(len_node)
        if nlen <= 0 {
            sm_err_line = s_lines[tid]
            sm_err_col = s_cols[tid]
            if s_tags[len_node] == S_N_VAR {
                sm_err_msg = "数组长度引用的常量未定义或非正整数型常量（" + sstate.name_str(len_node) + "）"
            } else {
                sm_err_msg = "数组长度必须为正整数，实际是 " + to_string(nlen)
            }
            return -1
        }
        if nlen > 262144 {
            sm_err_line = s_lines[tid]
            sm_err_col = s_cols[tid]
            sm_err_msg = "数组长度超上限（上限 2^18=262144，实际 " + to_string(nlen) + "），请改用容量档位族或降低粒度"
            return -1
        }
        return types.array_of(elem, nlen)
    }
    if tag == S_N_FN_TYPE {
        // S2.2 函数值类型 `fn(A,B)->R`（N_FN_TYPE 布局：children=[返回类型]+参数类型...）。
        // 返回类型 = child(0)，参数 = child(1..n-1)。查重/登记走
        // types.fn_of（按返回类型+参数列表逐一比对，命中复用既有签名）。
        var nf = sstate.nchild(tid)
        var ret = parse_type_node(sstate.child(tid, 0))
        if ret < 0 {
            return -1
        }
        var ptys: table<i64> = table_new_i64()
        var k: i64 = 1
        while k < nf {
            var pt = parse_type_node(sstate.child(tid, k))
            if pt < 0 {
                return -1
            }
            table_push(ptys, pt)
            k = k + 1
        }
        return types.fn_of(ret, ptys)
    }
    sm_err_line = s_lines[tid]
    sm_err_col = s_cols[tid]
    sm_err_msg = "期望类型，实际是未知节点"
    return -1
}

// ---------- S2.4 port 提升/约束判定辅助 ----------
// struct/enum 类型 id 是否实现 port/interface（port 索引）——提升合法性 /
// 泛型约束校验共用。port（名义）：查显式 impl 记录；p.9.11.21 interface
// （结构性）：命名空间方法签名兼容即实现（鸭子多态，无需显式 impl 块）。
// 未实现返回 false。
pub func impl_has_ty(pi: i64, struct_ty: i64) -> bool {
    var k = types.kind(struct_ty)
    if k == K_STRUCT {
        var si = types.low(struct_ty)
        if si < 0 {
            return false
        }
        if sstate.impl_find(pi, si) >= 0 {
            return true
        }
        // p.9.11.21 interface 结构性实现：签名兼容即实现（首次判定合成
        // impl 记录 → vtable 生成 / 提升 / 约束校验全复用，后端零改动）
        if sstate.port_is_iface(pi) {
            return iface_struct_has_ty(pi, si)
        }
        return false
    }
    if k == K_ENUM {
        // p.9.11.21 interface 结构性实现（enum 关联方法，M2.1.8 自动 ref）：
        // 仅签名兼容判定（enum 不合成 impl 记录——impl 表存 struct 索引，
        // 与 port 现状一致：enum 可满足泛型约束，但不能提升为接口对象）
        if !sstate.port_is_iface(pi) {
            return false
        }
        var ei = types.low(struct_ty)
        if ei < 0 {
            return false
        }
        return iface_enum_has_ty(pi, ei)
    }
    return false
}

// p.9.11.21 interface 结构性实现判定（struct）：接口全部方法在该 struct 的
// 命名空间方法（<struct>::<m>，M2.1.8 首参自动 ref）中签名兼容（方法名 +
// 参数个数 + 去 self 参数类型 + 返回类型）。全匹配 → 合成 impl 记录返回
// true；任一缺失/不匹配返回 false（violation 细节经 iface_first_violation
// 供调用方构造诊断，见 sgen_inst / scheck）。
func iface_struct_has_ty(pi: i64, si: i64) -> bool {
    var sname = sstate.struct_name_of(si)
    var n = pm_n[pi]
    var mnames: table<i64> = table_new_i64()
    var mi: i64 = 0
    while mi < n {
        var mname = sstate.port_method_name(pi, mi)
        var full = sname + "::" + mname
        if !iface_method_matches(pi, mi, full) {
            return false
        }
        table_push(mnames, intern.intern(full))
        mi = mi + 1
    }
    // 全部签名兼容：合成 impl 记录（vtable 生成 / 提升 / 约束校验复用）
    if sstate.reg_impl(pi, si, mnames) < 0 {
        return false
    }
    return true
}

// p.9.11.21 interface 结构性实现判定（enum）：仅签名兼容检查，不合成
// impl 记录（enum 提升为接口对象后置，与 port 现状一致）。
func iface_enum_has_ty(pi: i64, ei: i64) -> bool {
    var ename = sstate.enum_name_of(ei)
    var n = pm_n[pi]
    var mi: i64 = 0
    while mi < n {
        var mname = sstate.port_method_name(pi, mi)
        var full = ename + "::" + mname
        if !iface_method_matches(pi, mi, full) {
            return false
        }
        mi = mi + 1
    }
    return true
}

// interface 方法签名与命名空间函数签名匹配（fn_sig 全名查找，去 self 槽）
func iface_method_matches(pi: i64, mi: i64, full: string) -> bool {
    var sig = sstate.fn_sig(full)
    if sig < 0 {
        return false
    }
    var pnp = sstate.port_method_nparams(pi, mi)  // 含 self
    if sg_nparams[sig] != pnp {
        return false
    }
    var j: i64 = 1
    while j < pnp {
        var want = sstate.port_method_param(pi, mi, j)
        var got = sp_tys[sg_off[sig] + j]
        if want != got {
            return false
        }
        j = j + 1
    }
    if sg_ret[sig] != sstate.port_method_ret(pi, mi) {
        return false
    }
    return true
}

// p.9.11.21 诊断辅助：第一个不满足 interface 的方法序号（-1 = 全满足；
// -2 = 非 struct/enum 类型）。g_iface_vio_missing 说明原因：true = 缺少
// 同名方法，false = 方法存在但签名不匹配（参数/返回类型）。
pub func iface_first_violation(pi: i64, ty: i64) -> i64 {
    var k = types.kind(ty)
    var tname = ""
    if k == K_STRUCT {
        tname = sstate.struct_name_of(types.low(ty))
    } else if k == K_ENUM {
        tname = sstate.enum_name_of(types.low(ty))
    } else {
        return -2
    }
    var n = pm_n[pi]
    var mi: i64 = 0
    while mi < n {
        var mname = sstate.port_method_name(pi, mi)
        var full = tname + "::" + mname
        var sig = sstate.fn_sig(full)
        if sig < 0 {
            g_iface_vio_missing = true
            return mi
        }
        var pnp = sstate.port_method_nparams(pi, mi)
        if sg_nparams[sig] != pnp {
            g_iface_vio_missing = true
            return mi
        }
        var j: i64 = 1
        while j < pnp {
            if sstate.port_method_param(pi, mi, j) != sp_tys[sg_off[sig] + j] {
                g_iface_vio_missing = false
                return mi
            }
            j = j + 1
        }
        if sg_ret[sig] != sstate.port_method_ret(pi, mi) {
            g_iface_vio_missing = false
            return mi
        }
        mi = mi + 1
    }
    return -1
}

// 最近一次 iface_first_violation 的原因：true = 缺少方法，false = 签名不匹配
pub func iface_vio_missing() -> bool {
    return g_iface_vio_missing
}

// ---------- S1.3 窄整数辅助（位宽/符号性） ----------
// 整数位宽：i8/u8=8 ... i64/u64=64、i128/u128=128；非整数返回 0。
// 批次 2：i128/u128 → 128（LLVM i128 原生，拓宽/缩窄判定自动覆盖）。
// pub：sinfer/irgen 在命名空间外调用（窄整数拓宽/缩窄判定）。
pub func int_width(t: i64) -> i64 {
    if t == TK_I8 || t == TK_U8 {
        return 8
    }
    if t == TK_I16 || t == TK_U16 {
        return 16
    }
    if t == TK_I32 || t == TK_U32 {
        return 32
    }
    if t == TK_I64 || t == TK_U64 {
        return 64
    }
    if t == TK_I128 || t == TK_U128 {
        return 128
    }
    return 0
}

// 有符号判定：i 族（u 族 false；非整数 false）
// pub：sinfer/irgen 在命名空间外调用（窄整数拓宽/缩窄判定）。
pub func is_signed(t: i64) -> bool {
    if t == TK_I8 || t == TK_I16 || t == TK_I32 || t == TK_I64 || t == TK_I128 {
        return true
    }
    return false
}

// 类型兼容判定（宽类型框/裸表/嵌套逐层，对齐 Rust wide_accepts 与
// proto types_compatible）
pub func types_compatible(a: i64, b: i64) -> bool {
    if a == b {
        return true
    }
    var ka = types.kind(a)
    var kb = types.kind(b)
    // 宽类型 num/text/misc 是「类别框」
    if a == TK_NUM && (types.is_int(b) || types.is_float(b)) {
        return true
    }
    if b == TK_NUM && (types.is_int(a) || types.is_float(a)) {
        return true
    }
    if a == TK_TEXT && (b == TK_STR || b == TK_CHAR) {
        return true
    }
    if b == TK_TEXT && (a == TK_STR || a == TK_CHAR) {
        return true
    }
    // P2b any 动态类型：目标侧接受一切（装箱）；反向（any→具体）须显式转换
    if a == TK_ANY {
        return true
    }
    if a == TK_MISC && !types.is_wide(b) {
        return true
    }
    if b == TK_MISC && !types.is_wide(a) {
        return true
    }
    // 裸 table/map 与具体类型兼容
    if a == TK_TABLE || a == TK_MAP {
        if kb == K_TABLE || kb == K_MAP {
            return true
        }
    }
    if b == TK_TABLE || b == TK_MAP {
        if ka == K_TABLE || ka == K_MAP {
            return true
        }
    }
    if ka == K_TABLE && kb == K_TABLE {
        return types_compatible(types.table_elem(a), types.table_elem(b))
    }
    // L1 定长数组：同长度 + 元素类型兼容（值类型，结构兼容）
    if ka == K_ARRAY && kb == K_ARRAY {
        if types.array_len(a) != types.array_len(b) {
            return false
        }
        return types_compatible(types.array_elem(a), types.array_elem(b))
    }
    if ka == K_MAP && kb == K_MAP {
        return types_compatible(types.table_elem(a), types.table_elem(b))
    }
    if ka == K_STRUCT && kb == K_STRUCT {
        return a == b
    }
    if ka == K_ENUM && kb == K_ENUM {
        // 枚举按名等价：同名同类型（不同 enum 不兼容）
        return a == b
    }
    if ka == K_TUPLE && kb == K_TUPLE {
        // 逐字段比较
        var ia = types.low(a)
        var ib = types.low(b)
        if tup_n[ia] != tup_n[ib] {
            return false
        }
        var offa = tup_offs[ia]
        var offb = tup_offs[ib]
        var i: i64 = 0
        while i < tup_n[ia] {
            if tup_tys[offa + i] != tup_tys[offb + i] {
                return false
            }
            i = i + 1
        }
        return true
    }
    // ---------- S1.3 C2 隐式拓宽 ----------
    // 同符号整数窄→宽：i8→i16→i32→i64、u8→u16→u32→u64（got 宽度严格小于
    // want）。同宽度 i↔u 不隐式（C4：必须显式 as_*）。
    // u → i 拓宽（目标有符号且严格更宽）：u8/u16/u32 → i64（zext 无损——
    // i64 值域容纳全部无符号窄值）。反向 i → u 不隐式（负值无法表示，C4）。
    if types.is_int(a) && types.is_int(b) {
        if int_width(b) < int_width(a) && is_signed(a) == is_signed(b) {
            return true
        }
        if !is_signed(b) && is_signed(a) && int_width(b) < int_width(a) {
            return true
        }
        return false
    }
    // 整数 → 浮点隐式（C2 无损方向：i64 → f64；窄整数 → f32/f64）。
    // 反向 float → int 不隐式（C4：必须显式 as_*）。
    if types.is_float(a) && types.is_int(b) {
        return true
    }
    // f32 → f64 隐式拓宽（f64 → f32 缩窄不隐式，走 as_f32）
    if types.is_float(a) && types.is_float(b) {
        if (a == TK_F32 && b == TK_F64) || (a == TK_F64 && b == TK_F32) {
            return true
        }
    }
    return false
}

// S1.3 C2 扩展——整数窄化兼容（U2 通道）：want 与 got 都是整数，且 want 位宽
// 严格更窄（i64 → u32/u16/u8/i32/i8 等）→ 允许隐式缩窄（语义层放行；IR 层
// tig_coerce 生成 trunc，值回绕语义）。仅整数族（float/struct/string/any 等
// 保持严格）；同宽 i↔u 不隐式（C4：必须显式 as_*）。用于函数参数传递与
// 变量初始化/赋值处的类型检查（TSHA1 U2：位平面热路径 i64 → u32 签名改造）。
// 常量表达式（字面量/常量算术）不走窄化：由 types_match 的 C3/O3 范围检查
// 决定——超范围字面量必须报错（`var a: i8 = 200` 仍拒绝），不能因窄化放行
// 静默截断。窄化只针对运行期值（变量/调用/下标/非纯常量算术等）。
pub func types_narrow_int(want: i64, got: i64, node: i64) -> bool {
    if !types.is_int(want) || !types.is_int(got) {
        return false
    }
    if int_width(want) >= int_width(got) {
        return false
    }
    if node >= 0 {
        var tag = s_tags[node]
        // 单字面量：C3 范围检查已覆盖（在范围内 types_match 放行，超范围拒绝）
        if tag == S_N_INT_LIT {
            return false
        }
        // 纯常量算术（两侧都是字面量）：O3 窄域常量检查已覆盖
        if tag == S_N_BINARY {
            var ln = sstate.child(node, 0)
            var rn = sstate.child(node, 1)
            if s_tags[ln] == S_N_INT_LIT && s_tags[rn] == S_N_INT_LIT {
                return false
            }
        }
        // 负字面量（Neg + IntLit）：C3 负常量范围检查已覆盖
        if tag == S_N_UNARY {
            var un = sstate.child(node, 0)
            if s_vals[node] == 0 && s_tags[un] == S_N_INT_LIT {
                return false
            }
        }
    }
    return true
}

// 元组结构相等（递归）：字段类型逐层比较（含嵌套元组字段）。
// 背景：types_compatible 的元组分支用 `!=` 逐字段比较，嵌套元组字段
// 每处字面量独立登记 tuple id（如 ((1,2),3) 的字段类型 tuple#0/tuple#1），
// 数值不等 → 误判不兼容。元组 ==/!= 比较需深层结构相等判定。
pub func tuple_equal(a: i64, b: i64) -> bool {
    var ka = types.kind(a)
    var kb = types.kind(b)
    if ka != K_TUPLE || kb != K_TUPLE {
        return false
    }
    var ia = types.low(a)
    var ib = types.low(b)
    if tup_n[ia] != tup_n[ib] {
        return false
    }
    var offa = tup_offs[ia]
    var offb = tup_offs[ib]
    var i: i64 = 0
    while i < tup_n[ia] {
        var fa = tup_tys[offa + i]
        var fb = tup_tys[offb + i]
        if fa != fb {
            // 字段不同：同为元组 → 递归结构比较；否则不等
            if types.kind(fa) == K_TUPLE && types.kind(fb) == K_TUPLE {
                if !tuple_equal(fa, fb) {
                    return false
                }
            } else {
                return false
            }
        }
        i = i + 1
    }
    return true
}

// 类型匹配（含字面量适配：整数字面量可作任意整数/浮点/trit 标注等）
pub func types_match(want: i64, got: i64, init_node: i64) -> bool {
    if types_compatible(want, got) {
        return true
    }
    // 字面量适配
    if init_node >= 0 {
        var tag = s_tags[init_node]
        // 空表/空 map 字面量 `[]`：无元素，infer 兜底 i64；标注 table/map 时
        // 放行（元素类型由后续 push 定型；irgen 经 node_types 引导生成对应句柄）
        if tag == S_N_TABLE_LIT && sstate.nchild(init_node) == 0 {
            if types.is_table(want) || types.is_map(want) {
                return true
            }
        }
        // L1 定长数组字面量适配：`var b: array<f32, 3> = [1.0, 2.0, 3.0]`。
        // 元素个数必须 == array_len(want)，且逐元素与元素类型匹配
        //（子元素 node_types 已由 sinfer.infer_expr 填充——scheck 检查先于
        // 本调用已对整棵树做类型推断）。
        if types.kind(want) == K_ARRAY {
            var want_len = types.array_len(want)
            var want_elem = types.array_elem(want)
            if tag == S_N_TABLE_LIT {
                var nc_a = sstate.nchild(init_node)
                if nc_a != want_len {
                    return false
                }
                var je: i64 = 0
                while je < nc_a {
                    var cell = sstate.child(init_node, je)
                    var vnode = sstate.child(cell, 1)
                    var vty = node_types[vnode]
                    if vty < 0 {
                        return false
                    }
                    if !types_match(want_elem, vty, vnode) && !types_compatible(want_elem, vty) {
                        return false
                    }
                    je = je + 1
                }
                return true
            }
            // `var z: array<f32, 64> = array_init(0.0)`：广播初始化，实参类型
            // 与元素类型匹配即可（长度由数组类型决定，实参个数恒 1）。
            if tag == S_N_CALL && sstate.name_str(init_node) == "array_init" {
                var a0 = sstate.child(init_node, sstate.slot_off(init_node))
                if a0 < 0 {
                    return false
                }
                var a0t = node_types[a0]
                if a0t < 0 {
                    return false
                }
                if types_match(want_elem, a0t, a0) || types_compatible(want_elem, a0t) {
                    return true
                }
                return false
            }
            return false
        }
        // 元组字面量：逐字段适配
        if tag == S_N_TUPLE_LIT {
            var kw = types.kind(want)
            var kg = types.kind(got)
            if kw == K_TUPLE && kg == K_TUPLE {
                var wi = types.low(want)
                var gi = types.low(got)
                if tup_n[wi] == tup_n[gi] {
                    var cnt2 = tup_n[wi]
                    var owi = tup_offs[wi]
                    var ogi = tup_offs[gi]
                    var i2: i64 = 0
                    var all_ok: bool = true
                    while i2 < cnt2 {
                        var fe = sstate.child(init_node, i2)
                        var fv = sstate.child(fe, 0)
                        if !types_match(tup_tys[owi + i2], tup_tys[ogi + i2], fv) {
                            all_ok = false
                            break
                        }
                        i2 = i2 + 1
                    }
                    if all_ok {
                        return true
                    }
                }
            }
        }
        if tag == S_N_INT_LIT {
            // IntLit：整数/浮点标注 + trit（对齐 Rust）+ S1.3 C3 常量缩窄范围
            // 检查——窄类型标注的字面量必须在类型范围内（超范围 = 编译错误，
            // 非回绕；防止静默截断）。i64/u64 原生范围不查。
            // S1.2 A1：atomic<T> 初始化字面量适配元素类型（`var c: atomic<i64> = 0`）
            if types.kind(want) == K_ATOMIC {
                want = types.table_elem(want)
            }
            if types.is_int(want) || types.is_float(want) {
                var lit = s_vals[init_node]
                if want == TK_I8 && (lit < -128 || lit > 127) {
                    return false
                }
                if want == TK_I16 && (lit < -32768 || lit > 32767) {
                    return false
                }
                if want == TK_I32 && (lit < -2147483648 || lit > 2147483647) {
                    return false
                }
                if want == TK_U8 && (lit < 0 || lit > 255) {
                    return false
                }
                if want == TK_U16 && (lit < 0 || lit > 65535) {
                    return false
                }
                if want == TK_U32 && (lit < 0 || lit > 4294967295) {
                    return false
                }
                return true
            }
            if want == TK_TRIT {
                return true
            }
        }
        if tag == S_N_FLOAT_LIT {
            // FloatLit：浮点标注
            if types.is_float(want) {
                return true
            }
        }
        if tag == S_N_BOOL_LIT {
            // BoolLit：bool → bool；true/false 可适配 trit
            if want == TK_BOOL || want == TK_TRIT {
                return true
            }
        }
        if tag == S_N_TRIT_LIT {
            // TritLit（zero）：适配 trit 标注
            if want == TK_TRIT {
                return true
            }
        }
        // S1.3 O3 窄域常量算术：目标窄整数 + 二元运算两侧都是 IntLit 且
        // 常量都在目标类型范围 → 放行（irgen 按目标类型截断 = 回绕语义，
        // `var c: i8 = 100 + 100` → -56。与 C3 的单字面量超范围报错区分：
        // 表达式在窄域计算，字面量直接标注超范围仍拒绝）。
        if tag == S_N_BINARY {
            if types.is_int(want) && int_width(want) < 64 {
                var ln = sstate.child(init_node, 0)
                var rn = sstate.child(init_node, 1)
                if s_tags[ln] == 0 && s_tags[rn] == 0 {
                    if lit_in_range_stype(s_vals[ln], want) && lit_in_range_stype(s_vals[rn], want) {
                        return true
                    }
                }
            }
        }
        // S1.3 负数字面量适配：`var g: i8 = -4` → Unary(Neg, IntLit)，
        // 常量取负后仍在目标范围 → 放行（irgen coerce 截断）
        if tag == S_N_UNARY {
            if types.is_int(want) && int_width(want) < 64 {
                var un = sstate.child(init_node, 0)
                if s_vals[init_node] == 0 && s_tags[un] == 0 {
                    if lit_in_range_stype(0 - s_vals[un], want) {
                        return true
                    }
                }
            }
        }
    }
    return false
}

// L1 定长数组：索引节点 → 编译期常量值（纯字面量：IntLit 或 Neg+IntLit）。
// 返回 (c, v)：c=true 时 v = 常量值（可为负）；c=false 非编译期常量。
// sinfer/irgen 共用（编译期越界检查 + 常量 GEP vs 动态 GEP 分派）。
pub func arr_const_index(node: i64) -> (c: bool, v: i64) {
    if node < 0 {
        return (false, 0)
    }
    if s_tags[node] == S_N_INT_LIT {
        return (true, s_vals[node])
    }
    if s_tags[node] == S_N_UNARY && s_vals[node] == 0 && sstate.nchild(node) >= 1 {
        var inn = sstate.child(node, 0)
        if s_tags[inn] == S_N_INT_LIT {
            return (true, 0 - s_vals[inn])
        }
    }
    return (false, 0)
}

// 常量值是否在类型范围内（C3 边界；与 sinfer.lit_in_range 同套逻辑，
// stype 侧独立副本避免循环依赖）
func lit_in_range_stype(v: i64, ty: i64) -> bool {
    if ty == TK_I8 && (v < -128 || v > 127) {
        return false
    }
    if ty == TK_I16 && (v < -32768 || v > 32767) {
        return false
    }
    if ty == TK_I32 && (v < -2147483648 || v > 2147483647) {
        return false
    }
    if ty == TK_U8 && (v < 0 || v > 255) {
        return false
    }
    if ty == TK_U16 && (v < 0 || v > 65535) {
        return false
    }
    if ty == TK_U32 && (v < 0 || v > 4294967295) {
        return false
    }
    return true
}

}
