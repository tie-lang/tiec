type tie<class>
// compiler/frontend/sinfer_ie_ie1.tie —— infer_expr 分支提子函数分片 1（p.9.21 G2 单函数 ≤300 行）
// ============================================================
// 只含函数与注释：import 树与顶层全局 var 仍留在原主文件；
// 分片内函数与原调度器同 namespace，跨文件裸名互调。
namespace sinfer {
pub func infer_expr_spread_arg(id: i64) -> i64 {
    var tag = s_tags[id]
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "展开实参 `...` 仅支持用于带变长形参 `...T` 的普通函数调用；当前调用语境不支持展开"
        return -1
}

pub func infer_expr_comprehension(id: i64) -> i64 {
    var tag = s_tags[id]
        var cvname = sstate.name_str(id)
        var cvnid = intern.intern(cvname)
        var csrc = sstate.child(id, 0)
        var celem = sstate.child(id, 1)
        var ccond = sstate.child(id, 2)
        var cst = infer_expr(csrc)
        if cst < 0 {
            return -1
        }
        // p.9.11.16 迭代器协议源：struct 实现 has_next/next → 循环变量元素 =
        // next 返回类型（与 for-in 消费分派一致）。协议未命中 → 表/数组源。
        var celem_loop: i64 = types.named(TK_I64)
        if !types.is_table(cst) {
            var ip_c = iter_proto_elem(cst)
            if ip_c >= 0 {
                celem_loop = ip_c
                lv_insert(cvnid, celem_loop, 0, -1, 0)
                var celem_ty = infer_expr(celem)
                if celem_ty < 0 {
                    return -1
                }
                if ccond >= 0 {
                    var ccond_ty = infer_expr(ccond)
                    if ccond_ty < 0 {
                        return -1
                    }
                    if ccond_ty != types.named(TK_BOOL) {
                        sm_err_line = s_lines[id]
                        sm_err_col = s_cols[id]
                        sm_err_msg = "推导式 if 筛选条件必须是 bool，实际是 " + types.type_name(ccond_ty)
                        return -1
                    }
                }
                node_types[id] = types.table_of(celem_ty)
                g_typed = g_typed + 1
                return types.table_of(celem_ty)
            }
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "推导式迭代源必须是表/数组或迭代器协议对象（struct 实现 has_next/next），实际是 " + types.type_name(cst)
            return -1
        }
        var cte = types.table_elem(cst)
        if cte >= 0 {
            celem_loop = cte
        }
        // 登记循环变量（源元素类型；解构临时变量同此登记——字段访问再取 ItemK）
        lv_insert(cvnid, celem_loop, 0, -1, 0)
        var celem_ty = infer_expr(celem)
        if celem_ty < 0 {
            return -1
        }
        if ccond >= 0 {
            var ccond_ty = infer_expr(ccond)
            if ccond_ty < 0 {
                return -1
            }
            if ccond_ty != types.named(TK_BOOL) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "推导式 if 筛选条件必须是 bool，实际是 " + types.type_name(ccond_ty)
                return -1
            }
        }
        node_types[id] = types.table_of(celem_ty)
        g_typed = g_typed + 1
        return types.table_of(celem_ty)
}

pub func infer_expr_tag0(id: i64) -> i64 {
    var tag = s_tags[id]
        // S1.3 L3 后缀字面量：aux = 后缀类型 TyKw（-1 = 无后缀 → i64）
        // 批次 2（i128/u128）：后缀类型含 TK_I128(21)/TK_U128(22)——
        // 原 `sfx <= 9` 只覆盖 i8..f64，i128/u128 会落默认 i64 槽。
        var sfx = s_aux[id]
        if (sfx >= 0 && sfx <= 9) || sfx == TK_I128 || sfx == TK_U128 {
            node_types[id] = types.named(sfx)
            g_typed = g_typed + 1
            return types.named(sfx)
        }
        node_types[id] = types.named(TK_I64)
        g_typed = g_typed + 1
        return types.named(TK_I64)
}

pub func infer_expr_tag1(id: i64) -> i64 {
    var tag = s_tags[id]
        // S1.3 L3 浮点后缀：aux = f32(8)/f64(9)（parser 已定，无后缀默认 f64）
        var sfx2 = s_aux[id]
        if sfx2 == TK_F32 {
            node_types[id] = types.named(TK_F32)
            g_typed = g_typed + 1
            return types.named(TK_F32)
        }
        node_types[id] = types.named(TK_F64)
        g_typed = g_typed + 1
        return types.named(TK_F64)
}

pub func infer_expr_tag2(id: i64) -> i64 {
    var tag = s_tags[id]
        node_types[id] = types.named(TK_STR)
        g_typed = g_typed + 1
        return types.named(TK_STR)
}

pub func infer_expr_tag3(id: i64) -> i64 {
    var tag = s_tags[id]
        node_types[id] = types.named(TK_CHAR)
        g_typed = g_typed + 1
        return types.named(TK_CHAR)
}

pub func infer_expr_tag4(id: i64) -> i64 {
    var tag = s_tags[id]
        node_types[id] = types.named(TK_BOOL)
        g_typed = g_typed + 1
        return types.named(TK_BOOL)
}

pub func infer_expr_tag5(id: i64) -> i64 {
    var tag = s_tags[id]
        node_types[id] = types.named(TK_TRIT)
        g_typed = g_typed + 1
        return types.named(TK_TRIT)
}

pub func infer_expr_tag136(id: i64) -> i64 {
    var tag = s_tags[id]
        node_types[id] = types.named(TK_CODE)
        g_typed = g_typed + 1
        return types.named(TK_CODE)
}

pub func infer_expr_tag137(id: i64) -> i64 {
    var tag = s_tags[id]
        node_types[id] = types.named(TK_CODE)
        g_typed = g_typed + 1
        return types.named(TK_CODE)
}

pub func infer_expr_var(id: i64) -> i64 {
    var tag = s_tags[id]
        var nm = sstate.name_str(id)
        var nid = intern.intern(nm)
        var lt = lv_find(nid)
        if lt >= 0 {
            // S2.2 闭包捕获分析：闭包体检查期间（g_clo_depth > 0）引用变量，
            // 且该变量既非闭包参数（cl_params 段）、也非闭包体内局部（cl_locals
            // 段）→ 属于登记时快照中的外层变量 → 捕获。登记 (名 id, 类型 id)
            // 到 cl_capkeys/cl_capvals（当前闭包段内查重，重复引用只登记一次）。
            if g_clo_depth > 0 && g_clo_cur >= 0 {
                var ci = g_clo_cur
                var is_param = sstate.seg_has(cl_params, cl_paramoff[ci], cl_nparams[ci], nid)
                if is_param == 0 {
                    var is_local = sstate.seg_has(cl_locals, cl_locloff[ci], len(cl_locals) - cl_locloff[ci], nid)
                    if is_local == 0 {
                        var is_cap = sstate.seg_has(cl_capkeys, cl_capoff[ci], len(cl_capkeys) - cl_capoff[ci], nid)
                        if is_cap == 0 {
                            table_push(cl_capkeys, nid)
                            table_push(cl_capvals, lt)
                        }
                    }
                }
            }
            node_types[id] = lt
            g_typed = g_typed + 1
            return lt
        }
        var gt = gb_find_ns(nid)
        if gt >= 0 {
            node_types[id] = gt
            g_typed = g_typed + 1
            return gt
        }
        // S2.2 命名函数提升：变量查找失败后查函数签名（裸名 + 命名空间补全），
        // 命中 → 构造 fn 类型（命名函数名可直接用作函数值，如 `var f: fn(A)->R
        // = my_func`）。泛型模板（gt_find）暂不提升（单态化后函数值未定义）。
        var full_f = resolve_call_name(nm)
        var fsig = sstate.fn_sig(full_f)
        if fsig >= 0 {
            var fret = sg_ret[fsig]
            var fnp = sg_nparams[fsig]
            var foff = sg_off[fsig]
            var fpts: table<i64> = table_new_i64()
            var k2: i64 = 0
            while k2 < fnp {
                table_push(fpts, sp_tys[foff + k2])
                k2 = k2 + 1
            }
            var fnty = types.fn_of(fret, fpts)
            node_types[id] = fnty
            g_typed = g_typed + 1
            return fnty
        }
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "未声明的变量 '" + nm + "'"
        return -1
}

pub func infer_expr_range(id: i64) -> i64 {
    var tag = s_tags[id]
        var st = infer_expr(sstate.child(id, 0))
        if st < 0 {
            return -1
        }
        var en = infer_expr(sstate.child(id, 1))
        if en < 0 {
            return -1
        }
        if !types.is_int(st) || !types.is_int(en) {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "范围两端必须是整数"
            return -1
        }
        node_types[id] = types.named(TK_I64)
        g_typed = g_typed + 1
        return types.named(TK_I64)
}

pub func infer_expr_unary(id: i64) -> i64 {
    var tag = s_tags[id]
        var op = s_vals[id]
        var operand = infer_expr(sstate.child(id, 0))
        if operand < 0 {
            return -1
        }
        if op == 0 {
            // Neg：数字；trit 也允许（平衡取反 -1t/-(trit)，-1↔1、0 保持）
            // p.8.2.4：操作数为用户 struct 且声明 op_neg → 重写为方法调用。
            var ngres = try_op_overload_neg(sstate.child(id, 0), id)
            if ngres >= 0 {
                return ngres
            }
            if ngres < 0 && ngres != -2 {
                return -1
            }
            if !types.is_number(operand) && operand != types.named(TK_TRIT) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "取负运算的操作数必须是数字"
                return -1
            }
        } else if op == 1 {
            // Not：bool 或 trit
            if !types.is_bool_like(operand) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "逻辑非的操作数必须是 bool"
                return -1
            }
        } else {
            // 自增/自减：可写数字变量
            var target = sstate.child(id, 0)
            if s_tags[target] != S_N_VAR {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "自增/自减的操作数必须是可写数字变量"
                return -1
            }
            var nm = sstate.name_str(target)
            var nid2 = intern.intern(nm)
            if lv_const_of(nid2) == 1 {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "不能对 const 变量 '" + nm + "' 自增/自减"
                return -1
            }
            // p.9.11.11 immut 只读形参：自增/自减亦为重写，拒绝。
            if sstate.im_is(nid2) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "不能对 immut 形参 '" + nm + "' 自增/自减；immut 形参只读"
                return -1
            }
            if !types.is_number(operand) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "自增/自减的操作数必须是可写数字变量"
                return -1
            }
        }
        node_types[id] = operand
        g_typed = g_typed + 1
        return operand
}

pub func infer_expr_binary(id: i64) -> i64 {
    var tag = s_tags[id]
        var op = s_vals[id]
        // P1 数据流箭头：非算术/比较——先分派（裸 Var 目标：fn → 传参 /
        // 变量 → 赋值；调用/下标/字段目标已在解析器脱糖，不达此处）
        if op == B_ARROW_FWD || op == B_ARROW_REV {
            return infer_arrow(id, op)
        }
        var lhs = infer_expr(sstate.child(id, 0))
        if lhs < 0 {
            return -1
        }
        var rhs = infer_expr(sstate.child(id, 1))
        if rhs < 0 {
            return -1
        }
        // p.8.2.4 运算符重载：任一操作数为用户 struct 且声明对应 op_ 方法 →
        // 重写为方法调用（返回方法返回类型）；否则 -2 沿用原算术/比较路径。
        var ores = try_op_overload_binary(op, sstate.child(id, 0), sstate.child(id, 1), id)
        if ores >= 0 {
            return ores
        }
        if ores < 0 && ores != -2 {
            return -1
        }
        // 枚举 ==/!= 比较拦截（一期）：枚举按 tag 比较语义未定义，报错
        if op == 5 || op == 6 {
            if types.kind(lhs) == K_ENUM || types.kind(rhs) == K_ENUM {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "枚举暂不支持 == 比较"
                return -1
            }
        }
        // 两侧类型一致（trit×i64 例外；int×float 混用；string+string 拼接）
        var type_ok: bool = false
        if lhs == rhs {
            type_ok = true
        } else if op == 20 && option_payload_ty(lhs) >= 0 {
            // p.8.1.5 `?:` 安全默认值：Option<T> ?: T——类型兼容由下方特判校验
            type_ok = true
        } else if types.is_bool_like(lhs) && types.is_bool_like(rhs) {
            type_ok = true
        } else if lhs == TK_TRIT && types.is_int(rhs) {
            type_ok = true
        } else if rhs == TK_TRIT && types.is_int(lhs) {
            type_ok = true
        } else if types.is_int(lhs) && types.is_int(rhs) {
            type_ok = true
        } else if types.is_float(lhs) && types.is_float(rhs) {
            type_ok = true
        } else if types.is_int(lhs) && types.is_float(rhs) {
            type_ok = true
        } else if types.is_float(lhs) && types.is_int(rhs) {
            type_ok = true
        } else if op == 0 && lhs == TK_STR && rhs == TK_STR {
            // 字符串拼接
            type_ok = true
        } else if op >= 5 && op <= 10 && types.kind(lhs) == K_TUPLE &&
            types.kind(rhs) == K_TUPLE && stype.tuple_equal(lhs, rhs) {
            // 元组比较：结构相等（逐字段类型一致，嵌套元组递归）即合法——
            // `(1,2) == (1,2)` 两侧各登记独立 tuple 类型 id，须按字段结构
            // 比较（对齐 Rust 行为）；==/!= 放行，< > <= >= 在下文 op 分组
            // 检查中报「比较运算符不能用于 tuple」
            type_ok = true
        } else if op >= 5 && op <= 10 && types.is_ptr(lhs) && types.is_ptr(rhs) {
            // p.6.8.1 指针比较：==/!= 允许任意元素类型（地址等值比较）；< > <= >=
            // 由比较运算符分组（op 5/6 之外）拒绝——指针是地址值，元素类型不影响
            // 地址是否相等。
            type_ok = true
        }
        if !type_ok {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "二元运算两侧类型不一致：" + types.type_name(lhs) + " 与 " + types.type_name(rhs)
            return -1
        }
        // 按运算符分组校验
        if op <= 4 || op == 13 || op == 14 || op == 15 || op == 16 || op == 17 ||
            (op >= 21 && op <= 23) {
            // 算术/位运算：数字（位运算需整数）；p.9.11.9 checked 运算（21/22/23）仅整数
            if !types.is_number(lhs) && lhs != TK_STR && !(lhs == TK_TRIT || rhs == TK_TRIT) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "算术运算符不能用于 " + types.type_name(lhs)
                return -1
            }
            // p.9.11.9 checked 运算溢出检测仅对整数有效（f64 溢出 = inf 不属于
            // checked 溢出语义；trit 饱和算术也无溢出可言）——非整数报错。
            if op >= 21 && op <= 23 && !types.is_int(lhs) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "checked 运算（+?/-?/*?）只支持整数，不能用于 " + types.type_name(lhs)
                return -1
            }
            if op >= 13 && !types.is_int(lhs) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "位运算只支持整数，不能用于 " + types.type_name(lhs)
                return -1
            }
            // S1.3 B2 移位语义（r.1.4.3）：**编译期常量**移位量必须在
            // 0..操作数位宽 范围内——负数移位/越界移位 = 编译错误（负例
            // shift_neg_free 未拒根因）。运行期变量移位量保持既有定义行为
            // （llvmgen & 63 掩码 / 窄类型 select 保护，shift_bound 探针不变）。
            // i128 常量移位（1i128 << 100/127）按 128 位宽放行。
            if op == 16 || op == 17 {
                var sc = sstate.child(id, 1)
                var cnt: i64 = 0
                var is_const: bool = false
                if s_tags[sc] == S_N_INT_LIT {
                    cnt = s_vals[sc]
                    is_const = true
                } else if s_tags[sc] == S_N_UNARY && s_vals[sc] == 0 {
                    // -N 字面量（U_NEG 包 IntLit）
                    var oc = sstate.child(sc, 0)
                    if s_tags[oc] == S_N_INT_LIT {
                        cnt = 0 - s_vals[oc]
                        is_const = true
                    }
                }
                if is_const {
                    var w = stype.int_width(lhs)
                    if w > 0 && (cnt < 0 || cnt >= w) {
                        sm_err_line = s_lines[id]
                        sm_err_col = s_cols[id]
                        sm_err_msg = "移位量超出操作数位宽（" + to_string(w) + " 位，当前 " + to_string(cnt) + "）"
                        return -1
                    }
                }
            }
            if op == 4 && !types.is_int(lhs) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "取模运算只支持整数"
                return -1
            }
        } else if op <= 10 {
            // 比较：数字/字符串/bool/trit；元组仅 ==/!=（逐字段），< > <= >= 仍报错；
            // ptr 仅 ==/!=（typed ptr 一等指针相等门禁，p.6.8.1）
            if types.kind(lhs) == K_TUPLE || types.is_ptr(lhs) {
                if op == 5 || op == 6 {
                    // 元组/指针相等比较：合法（结果 bool，rt 在下方比较分支统一处理；
                    // 指针经 ptrtoint 后整数比较，见 tig_binary_ptr）
                } else {
                    sm_err_line = s_lines[id]
                    sm_err_col = s_cols[id]
                    sm_err_msg = "比较运算符不能用于 " + types.type_name(lhs)
                    return -1
                }
            } else if !types.is_number(lhs) && lhs != TK_STR && !types.is_bool_like(lhs) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "比较运算符不能用于 " + types.type_name(lhs)
                return -1
            }
        } else if op <= 12 {
            // 逻辑：bool 或 trit
            if !types.is_bool_like(lhs) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "逻辑运算符两侧必须是 bool（或两侧同为 trit）"
                return -1
            }
        } else if op == 20 {
            // p.8.1.5 `?:` 安全默认值：Option<T> ?: T → T（Some 解包 / None 用默认值）
            var opt_pt = option_payload_ty(lhs)
            if opt_pt < 0 {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "'?:' 左侧必须是 Option<T>（Some/None 形态枚举），实际是 " + types.type_name(lhs)
                return -1
            }
            var rhs_node = sstate.child(id, 1)
            if !stype.types_compatible(opt_pt, rhs) && !stype.types_match(opt_pt, rhs, rhs_node) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "'?:' 右侧类型 " + types.type_name(rhs) + " 与 Option 载荷 " + types.type_name(opt_pt) + " 不匹配"
                return -1
            }
            node_types[id] = opt_pt
            g_typed = g_typed + 1
            return opt_pt
        }
        // p.6.9.15 警告（核心消息与 diagcode 警告目录逐字一致）：
        // W0001 浮点相等比较（==/!= 对 f64/f32）；W0002 整数除法截断。
        if op == 5 || op == 6 {
            if types.is_float(lhs) && types.is_float(rhs) {
                sm_warn_add(s_lines[id], s_cols[id], "浮点相等比较（==/!= 对 f64/f32 结果不可靠）")
            }
        }
        if op == 3 {
            if types.is_int(lhs) && types.is_int(rhs) {
                sm_warn_add(s_lines[id], s_cols[id], "整数除法结果截断（如 7/2 == 3）")
            }
        }
        // W00027：整数除法 / 取模的除数为「字面量 0」→ 运行期崩溃
        //（LLVM sdiv/srem 除数为 0 未定义行为）。仅整数运算（op 3=除法，4=取模；
        // 浮点除 0 得 inf，不崩，故不报）；除数是字面量才可静态判定，非字面量不报。
        if op == 3 || op == 4 {
            if types.is_int(lhs) && types.is_int(rhs) {
                var w27r = sstate.child(id, 1)
                if s_tags[w27r] == S_N_INT_LIT && s_vals[w27r] == 0 {
                    sm_warn_add(s_lines[id], s_cols[id], "整数除零（字面量 0 作除数，运行期崩溃）")
                }
            }
        }
        var rt = lhs
        if types.is_int(lhs) && types.is_float(rhs) {
            rt = rhs
        }
        if types.is_float(lhs) && types.is_int(rhs) {
            rt = lhs
        }
        // S1.3 A1 混合宽度整数运算：结果 = 宽度更大者（i8 + i16 → i16 算术；
        // i8 + u16 → 16 位算术。同宽度 i/u 混合 → 保持 lhs（LLVM 位模式一致，
        // 无符号性区分——与 tie 现状有符号语义保持一致）。
        // L2 上下文推断：字面量侧常量在对方窄类型范围内 → 按对方类型
        // （`f + 1`：f 是 u8，常量 1 在 u8 范围 → u8 算术，结果 u8）
        if types.is_int(lhs) && types.is_int(rhs) {
            var l_node = sstate.child(id, 0)
            var r_node = sstate.child(id, 1)
            var l_lit = s_tags[l_node] == 0
            var r_lit = s_tags[r_node] == 0
            var lw = stype.int_width(lhs)
            var rw = stype.int_width(rhs)
            if l_lit && !r_lit {
                // 左字面量、右变量：左常量在右类型范围 → 右类型；否则宽者
                if lit_in_range(s_vals[l_node], rhs) {
                    rt = rhs
                } else {
                    // W00018：字面量落在窄类型范围外（i64 不会溢出，不报）
                    if rw < 64 {
                        sm_warn_add(s_lines[id], s_cols[id], "大整数字面量溢出风险（超出目标窄类型范围）")
                    }
                    if rw > lw {
                        rt = rhs
                    } else {
                        rt = lhs
                    }
                }
            } else if r_lit && !l_lit {
                // 右字面量、左变量：右常量在左类型范围 → 左类型；否则宽者
                if lit_in_range(s_vals[r_node], lhs) {
                    rt = lhs
                } else {
                    if lw < 64 {
                        sm_warn_add(s_lines[id], s_cols[id], "大整数字面量溢出风险（超出目标窄类型范围）")
                    }
                    if lw > rw {
                        rt = lhs
                    } else {
                        rt = rhs
                    }
                }
            } else if !l_lit && !r_lit {
                // 两侧变量：宽者
                if rw > lw {
                    rt = rhs
                } else {
                    rt = lhs
                }
            }
            // 两侧字面量：无上下文 → 保持 i64（默认），由目标标注截断
        }
        // S1.3 f32 算术：f32 与 f64 混合 → f64；f32+f32 → 提升 f64 计算
        // （f32 仅 extern/repr(C) 互操作，算术统一 f64——int-model 未决问题 1）
        if (lhs == TK_F32 || rhs == TK_F32) && (lhs == TK_F64 || rhs == TK_F64) {
            rt = types.named(TK_F64)
        }
        // trit × i64 混合（t + 5 / 5 - t）：结果 i64（irgen 生成 i64 运算并
        // sext trit 侧——曾按 lhs 标 TK_TRIT，IR 结果 i64 却被当 i8 转换/打印）
        if lhs == TK_TRIT && types.is_int(rhs) {
            rt = rhs
        }
        if rhs == TK_TRIT && types.is_int(lhs) {
            rt = lhs
        }
        if op <= 10 && op >= 5 {
            // 比较/逻辑：结果 bool
            rt = types.named(TK_BOOL)
        }
        node_types[id] = rt
        g_typed = g_typed + 1
        return rt
}

}