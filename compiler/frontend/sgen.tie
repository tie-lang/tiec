type tie<class>
// compiler/frontend/sgen.tie —— 泛型单态化展开器（T3b，2026-08-14）
// ============================================================
// # 职责
//   泛型系统核心语义的「机制层」：符号 mangling、AST 复制替换（TypeVar → 具体
//   类型）、模板实例化（函数/struct）、类型实参推断辅助（AST 模式匹配绑定）。
//   调用点推断的「策略层」在 sinfer（infer_call / infer_struct_method），
//   预扫描展开在 semantic.expand_generics——本模块只提供原子操作。
// # 依赖（树式无环）
//   import ./stype.tie（类型解析/匹配；传递可达 ./sstate.tie 与 types 类型系统）。
//   被 sinfer.tie import（sinfer → sgen → stype → sstate/data）。
// # 单态化机制概述
//   模板定义登记在 sstate 的 gt_* 表（T3a），本模块以 mangled 名实例化：
//     1. mangle：函数/struct 全名 + `$` + 类型实参片段（i64→i64、table<T>→table_T
//        嵌套递归）；方法模板前缀是模板 struct 时替换为实例化 struct 名。
//     2. clone_subst：深拷贝模板定义节点树到 sstate 表尾；FnDef/Struct 泛型槽
//        （N_TYPE_PARAMS）→ -1；类型参数引用（N_STRUCT_TYPE(name=参数名)）→
//        实参类型节点；模板 struct 引用（如 Box<i64>）→ 实例化后 mangled 节点。
//     3. instantiate_fn / instantiate_struct：复制 → 改名 mangled → 登记签名/
//        struct 字段（内联拍平）→ 追加 g_extra_tops → gin 去重记录。
//     4. 实例化产物走现有 collect/check 全流程（fn_keys 增长后主循环覆盖、
//        check_fn_walk 按 mangled 名找到节点检查函数体）。
//   去重：sstate.gin_* 表（mangled 名 → 记录），fn_sig / st_keys 二次幂等。
//   错误：sm_err_* 三件套 + 返回 -1（与语义族一致）。
import "./stype.tie"
import "./sgen_inst.tie"

// p.9.11.32 别名展开深度护栏（防循环别名；文件顶层变量——命名空间体内
// 不允许 var 声明）
var alias_depth: i64 = 0

namespace sgen {

// ==================== 符号 mangling（§generics.md 符号 mangling）====================


// 泛型全名 + 类型实参 → 实例化符号名。
// 特殊规则：命名空间前缀是**模板 struct** 时（如模板方法 `Box::get`，前缀
// "Box"），前缀替换为实例化 struct 名（"Box$i64"）——irgen 的方法分派按
// struct 实例名::方法名 构造目标（gen_method_call 用 struct_name_of），
// 必须一致。普通函数/struct：全名 + `$` + 实参片段。
pub func mangle(full_name: string, args: table<i64>) -> string {
    var last = sstate.rfind_ns(full_name)
    if last >= 0 {
        var prefix = ig_slice(full_name, 0, last)
        var gti = sstate.gt_find(prefix)
        if gti >= 0 && gty_is_struct[gti] == 1 {
            var struct_mangled = prefix + mangle_suffix(args)
            var bare = ig_slice(full_name, last + 2, str_len(full_name))
            return struct_mangled + "::" + bare
        }
    }
    return full_name + mangle_suffix(args)
}

// ==================== AST 类型节点构造（type id → 类型节点）====================
// 把具体类型 id 还原为 AST 类型节点（追加到 sstate 表尾）——clone_subst 替换
// TypeVar 引用时生成实参类型节点用。struct → N_STRUCT_TYPE(mangled 名)；
// table<T> → N_TABLE_TYPE(元素)；map<V> → N_MAP_TYPE；named → N_NAMED_TYPE。
// tuple 类型实参首轮不支持（报错）。
pub func type_node_from_id(t: i64) -> i64 {
    var k = types.kind(t)
    if k == K_NAMED {
        var nm = types.type_name(t)
        return push_node(S_N_NAMED_TYPE, intern.intern(nm), t, -1, 0, 0)
    }
    if k == K_TABLE {
        var elem = type_node_from_id(types.table_elem(t))
        if elem < 0 {
            return -1
        }
        var kids: table<i64> = table_new_i64()
        table_push(kids, elem)
        var nd = push_node(S_N_TABLE_TYPE, -1, -1, -1, 0, 0)
        set_children_ast(nd, kids)
        return nd
    }
    if k == K_MAP {
        var v = type_node_from_id(types.table_elem(t))
        if v < 0 {
            return -1
        }
        var kids: table<i64> = table_new_i64()
        table_push(kids, v)
        var nd = push_node(S_N_MAP_TYPE, -1, -1, -1, 0, 0)
        set_children_ast(nd, kids)
        return nd
    }
    if k == K_STRUCT {
        var sname = sstate.struct_name_of(types.low(t))
        var kids: table<i64> = table_new_i64()
        table_push(kids, -1)
        var nd = push_node(S_N_STRUCT_TYPE, intern.intern(sname), -1, -1, 0, 0)
        set_children_ast(nd, kids)
        return nd
    }
    if k == K_ENUM {
        // 枚举类型实参（2026-08-15 泛型 enum）：复用 N_STRUCT_TYPE 承载标识符
        // 类型，name = 枚举名（mangled）。语义层按名分派：st_keys 未命中查
        // en_keys（枚举实例已 reg_enum 登记 mangled 名）。
        var ename = sstate.enum_name_of(types.low(t))
        var kids: table<i64> = table_new_i64()
        table_push(kids, -1)
        var nd = push_node(S_N_STRUCT_TYPE, intern.intern(ename), -1, -1, 0, 0)
        set_children_ast(nd, kids)
        return nd
    }
    sm_err_line = 0
    sm_err_col = 0
    sm_err_msg = "类型实参不能是元组类型（泛型系统首轮不支持 tuple 实参）"
    return -1
}


// ==================== AST 复制 + TypeVar 替换（clone_subst）====================
// 深拷贝模板定义节点树，同时：
//   - FnDef / Struct 的泛型槽（children[0] = N_TYPE_PARAMS）→ -1 哨兵；
//   - 类型参数引用（N_STRUCT_TYPE(name ∈ 模板类型参数名)）→ 实参类型节点
//     （type_node_from_id，独立节点不与原树共享）；
//   - 模板 struct 引用（N_STRUCT_TYPE(name = 模板 struct，children[0] =
//     N_TYPE_ARGS，如模板体内 `Box<i64>`）→ 递归替换 children 后实例化，
//     整个节点替换为 N_STRUCT_TYPE(mangled 实例化名)。
// 其余节点递归复制（children 逐个子节点复制，-1 哨兵保持）。
// 返回新节点 id；失败 -1（sm_err_* 已置）。


pub func clone_subst(node: i64, gti: i64, args: table<i64>) -> i64 {
    var tp_names = sstate.gt_param_names(gti)
    var kinds = sstate.gt_param_kinds(gti)
    return clone_inner(node, tp_names, kinds, args)
}


// ==================== 类型实参解析（调用点显式实参，泛型感知）====================

// N_TYPE_ARGS 节点 → 类型实参 id 表（显式类型实参，如 max<i64> / Box<table<i64>>）。
// 逐实参用 parse_generic_type_node 解析（模板 struct 引用自动实例化）。
// 返回类型实参表；失败返回空表（sm_err_* 已置）。
pub func parse_type_args_ast(targs_node: i64) -> table<i64> {
    var out: table<i64> = table_new_i64()
    if targs_node < 0 {
        return out
    }
    if s_tags[targs_node] != S_N_TYPE_ARGS {
        return out
    }
    var n = sstate.nchild(targs_node)
    var k: i64 = 0
    while k < n {
        var slot_id = sstate.child(targs_node, k)
        if s_tags[slot_id] == S_N_INT_LIT {
            // v2 值实参：整型字面量 → 值编码 -1-值（与类型实参 id 空间分离；
            // 值 > 0，编码 ≤ -2，-1 留给"未指定"哨兵无歧义）
            var v = s_vals[slot_id]
            if v <= 0 {
                sm_err_line = s_lines[targs_node]
                sm_err_col = s_cols[targs_node]
                sm_err_msg = "值实参必须为正整数，实际是 " + to_string(v)
                out = table_new_i64()
                return out
            }
            table_push(out, -1 - v)
        } else {
            var ty = parse_generic_type_node(slot_id)
            if ty < 0 {
                out = table_new_i64()
                return out
            }
            table_push(out, ty)
        }
        k = k + 1
    }
    return out
}

// v2：整型常量节点 → 编译期整值（委托 sstate.resolve_int_len_node；N_VAR 查
// 整型常量表 gval，const 名在数组长度/值参数默认值处引用时登记与查询）。
pub func resolve_int_len_node(id: i64) -> i64 {
    return sstate.resolve_int_len_node(id)
}

// 类型节点 → 类型 id（泛型感知版）：N_STRUCT_TYPE 带 N_TYPE_ARGS 且名字是
// **模板 struct** → 自动实例化（mangle + reg_struct + 字段拍平 + gin 记录），
// 返回 struct 类型 id。普通 struct 带类型实参 → 报错。其余复用 stype。
// 调用点显式类型实参、模板体内嵌套 struct 引用实例化共用。
pub func parse_generic_type_node(tid: i64) -> i64 {
    var tag = s_tags[tid]
    if tag == S_N_NAMED_TYPE {
        return types.named(s_vals[tid])
    }
    if tag == S_N_ARRAY_TYPE {
        // L1 定长数组：array<elem, N>（children = [元素类型, N_INT_LIT | N_VAR]）。
        // N_VAR = const 名（v2，查整型常量表）或值参数（实例化后已被 clone 替换
        // 为 N_INT_LIT；残留 N_VAR 且查表失败即报错，防跨档错配）。
        // 内存安全：长度受 MAX_ARRAY_LEN 上限约束（护栏，防后端爆炸）。
        var elem = parse_generic_type_node(sstate.child(tid, 0))
        if elem < 0 {
            return -1
        }
        var len_node = sstate.child(tid, 1)
        if len_node < 0 || (s_tags[len_node] != S_N_INT_LIT && s_tags[len_node] != S_N_VAR) {
            sm_err_line = s_lines[tid]
            sm_err_col = s_cols[tid]
            sm_err_msg = "数组长度必须是编译期整数字面量或常量名（array<T, N>）"
            return -1
        }
        var nlen = sstate.resolve_int_len_node(len_node)
        if nlen <= 0 {
            sm_err_line = s_lines[tid]
            sm_err_col = s_cols[tid]
            if s_tags[len_node] == S_N_VAR {
                sm_err_msg = "数组长度引用的常量未定义或非正整数型常量（" + sstate.name_str(len_node) + "）"
            } else {
                sm_err_msg = "数组长度必须为正整数，实际是 " + to_string(nlen)
            }
            return -1
        }
        if nlen > 262144 {
            sm_err_line = s_lines[tid]
            sm_err_col = s_cols[tid]
            sm_err_msg = "数组长度超上限（上限 2^18=262144，实际 " + to_string(nlen) + "），请改用容量档位族或降低粒度"
            return -1
        }
        return types.array_of(elem, nlen)
    }
    if tag == S_N_TABLE_TYPE {
        var e = parse_generic_type_node(sstate.child(tid, 0))
        if e < 0 {
            return -1
        }
        return types.table_of(e)
    }
    if tag == S_N_MAP_TYPE {
        var v = parse_generic_type_node(sstate.child(tid, 0))
        if v < 0 {
            return -1
        }
        return types.map_of(v)
    }
    if tag == S_N_STRUCT_TYPE {
        var nm = sstate.name_str(tid)
        // S1.2 内建不安全类型引用：`ptr<T>` / `slice<T>` / `atomic<T>`
        // （N_STRUCT_TYPE 承载标识符类型引用，按名特判——不做关键字，
        // 避免与 str.slice 等方法名冲突）
        if nm == "ptr" || nm == "slice" || nm == "atomic" || nm == "guard" {
            var slot = sstate.child(tid, 0)
            if slot < 0 || s_tags[slot] != S_N_TYPE_ARGS {
                sm_err_line = s_lines[tid]
                sm_err_col = s_cols[tid]
                sm_err_msg = "类型 '" + nm + "' 必须显式指定元素类型（如 " + nm + "<i64>）"
                return -1
            }
            var arg0 = sstate.child(slot, 0)
            if arg0 < 0 {
                sm_err_line = s_lines[tid]
                sm_err_col = s_cols[tid]
                sm_err_msg = "类型 '" + nm + "' 缺少元素类型实参"
                return -1
            }
            // guard<cap>：cap 是能力名（share/mem/ext 标识符），非类型实参
            if nm == "guard" {
                var capn = sstate.name_str(arg0)
                var gidx2: i64 = -1
                if capn == "share" {
                    gidx2 = 0
                } else if capn == "mem" {
                    gidx2 = 1
                } else if capn == "ext" {
                    gidx2 = 2
                }
                if gidx2 < 0 {
                    sm_err_line = s_lines[tid]
                    sm_err_col = s_cols[tid]
                    sm_err_msg = "guard<cap> 能力域必须是 share/mem/ext，实际是 '" + capn + "'"
                    return -1
                }
                return types.guard_of(gidx2)
            }
            var elem = parse_generic_type_node(arg0)
            if elem < 0 {
                return -1
            }
            if nm == "ptr" {
                return types.ptr_of(elem)
            }
            if nm == "slice" {
                return types.slice_of(elem)
            }
            return types.atomic_of(elem)
        }
        var nid = intern.intern(nm)
        // p.9.11.32 类型别名展开：命中别名注册表 → 目标类型（泛型别名做形参代换）。
        // 挂在 struct/enum/port 查找之前——别名注册表与类型注册表互斥（重复即报错）。
        var alidx = sstate.bs_find(alias_keys, nid)
        if alidx >= 0 {
            return alias_expand(alidx, tid)
        }
        var sidx = sstate.bs_find(st_keys, nid)
        var eidx = sstate.bs_find(en_keys, nid)
        var gidx = sstate.gt_find(nm)
        // S2.4 port 类型引用：st/en/gt 均未命中时查 port 表（port 名 -> 索引）。
        // port 对象类型（11<<40 | port 索引）可作变量/参数/返回/字段/表元素
        // 类型标注——LLVM 表示 = ptr（指向堆打包 {data,vtable}）。
        var pidx = sstate.port_find(nm)
        // 带类型实参槽（N_TYPE_ARGS）
        if sstate.nchild(tid) > 0 {
            var slot = sstate.child(tid, 0)
            if slot >= 0 && s_tags[slot] == S_N_TYPE_ARGS {
                if gidx >= 0 && gty_is_struct[gidx] == 1 {
                    var args = parse_type_args_ast(slot)
                    if len(args) == 0 {
                        return -1
                    }
                    var si = instantiate_struct(gidx, args)
                    if si < 0 {
                        return -1
                    }
                    return types.struct_of(si)
                }
                if gidx >= 0 && gty_is_struct[gidx] == 2 {
                    // 泛型 enum 实例化（2026-08-15）：Option<i64> → instantiate_enum
                    var args = parse_type_args_ast(slot)
                    if len(args) == 0 {
                        return -1
                    }
                    var ei = instantiate_enum(gidx, args)
                    if ei < 0 {
                        return -1
                    }
                    return types.enum_of(ei)
                }
                if sidx >= 0 {
                    sm_err_line = s_lines[tid]
                    sm_err_col = s_cols[tid]
                    sm_err_msg = "struct '" + nm + "' 不接受类型参数（非泛型 struct）"
                    return -1
                }
                if eidx >= 0 {
                    sm_err_line = s_lines[tid]
                    sm_err_col = s_cols[tid]
                    sm_err_msg = "枚举 '" + nm + "' 不接受类型参数（非泛型 enum）"
                    return -1
                }
                if pidx >= 0 {
                    // S2.4：port 不接受类型参数（第一版 port 不支持泛型）
                    sm_err_line = s_lines[tid]
                    sm_err_col = s_cols[tid]
                    sm_err_msg = "port '" + nm + "' 不接受类型参数（第一版 port 不支持泛型）"
                    return -1
                }
                sm_err_line = s_lines[tid]
                sm_err_col = s_cols[tid]
                sm_err_msg = "类型 '" + nm + "' 未定义"
                return -1
            }
        }
        // 裸 struct / enum 引用
        if sidx >= 0 {
            return types.struct_of(st_vals[sidx])
        }
        if eidx >= 0 {
            return types.enum_of(en_vals[eidx])
        }
        if pidx >= 0 {
            // S2.4：port 对象类型引用（`var d: Drawable`）
            if sstate.nchild(tid) > 0 {
                var pslot = sstate.child(tid, 0)
                if pslot >= 0 && s_tags[pslot] == S_N_TYPE_ARGS {
                    sm_err_line = s_lines[tid]
                    sm_err_col = s_cols[tid]
                    sm_err_msg = "port '" + nm + "' 不接受类型参数（第一版 port 不支持泛型）"
                    return -1
                }
            }
            return types.port_of(pidx)
        }
        if gidx >= 0 && gty_is_struct[gidx] == 1 {
            sm_err_line = s_lines[tid]
            sm_err_col = s_cols[tid]
            sm_err_msg = "泛型 struct '" + nm + "' 必须显式指定类型参数（如 " + nm + "<i64>）"
            return -1
        }
        if gidx >= 0 && gty_is_struct[gidx] == 2 {
            sm_err_line = s_lines[tid]
            sm_err_col = s_cols[tid]
            sm_err_msg = "泛型 enum '" + nm + "' 必须显式指定类型参数（如 " + nm + "<i64>）"
            return -1
        }
        sm_err_line = s_lines[tid]
        sm_err_col = s_cols[tid]
        sm_err_msg = "类型 '" + nm + "' 未定义"
        return -1
    }
    // tuple 等：复用现有解析（首轮 tuple 类型实参内不含模板 struct）
    return stype.parse_type_node(tid)
}

// ==================== 泛型 enum 实例化（2026-08-15 enum 语言特性）====================

// 实例化泛型 enum 模板 → enum 索引。仿 instantiate_struct：
//  1. mangle 模板名 + 类型实参（如 Option + i64 → Option$i64）
//  2. 幂等：en_keys 已命中（reg_enum 登记过 mangled 名）→ 直接返回
//  3. 实参个数校验（gtyp_nparams 对比）
//  4. clone_subst 克隆模板 N_ENUM 节点（TypeVar → 实参类型替换）
//  5. reg_enum(mangled) + 变体收集（payload 类型已具体化）
//  6. set_enum_name + gin_reg 登记
// 返回 enum 索引（types.enum_of 负载）；-1 错误（sm_err_* 已置）。
pub func instantiate_enum(gti: i64, args: table<i64>) -> i64 {
    var full = intern.lookup(gty_full[gti])
    var mangled = mangle(full, args)
    var eidx = sstate.bs_find(en_keys, intern.intern(mangled))
    if eidx >= 0 {
        return en_vals[eidx]  // 已实例化（幂等）
    }
    // 实参个数校验
    var n_tp = gtyp_nparams[gti]
    if len(args) != n_tp {
        sm_err_line = 1
        sm_err_col = 1
        sm_err_msg = "泛型 enum '" + full + "' 需要 " + to_string(n_tp) + " 个类型参数，实际 " + to_string(len(args)) + " 个"
        return -1
    }
    g_inst_depth = g_inst_depth + 1
    if g_inst_depth > 64 {
        g_inst_depth = g_inst_depth - 1
        sm_err_msg = "泛型实例化深度超限（超过 64 层），疑似无限递归实例化：'" + full + "'"
        return -1
    }
    var node = gty_node[gti]
    var new_node = clone_subst(node, gti, args)
    if new_node < 0 {
        g_inst_depth = g_inst_depth - 1
        return -1
    }
    // enum 名 → mangled（collect_enum_variants 经 find_enum_node 按名查找）
    s_names[new_node] = intern.intern(mangled)
    // 登记 enum（重名检查）+ 追加 g_extra_tops（须先于变体收集——find_enum_node
    // 在 g_extra_tops 里找定义节点）
    var ei = sstate.reg_enum(intern.intern(mangled))
    if ei < 0 {
        g_inst_depth = g_inst_depth - 1
        sm_err_line = 1
        sm_err_col = 1
        return -1
    }
    // enum 名登记（types.type_name 还原 / mangle 片段用；须在变体收集前——
    // collect_enum_variants 用 enum_name_of 还原名字）
    types.set_enum_name(ei, mangled)
    table_push(g_extra_tops, new_node)
    // 变体收集（TypeVar 已替换为具体类型；en_done 置位 → collect_all_enums 跳过）
    var cr = scollect.collect_enum_variants(ei)
    if cr < 0 {
        g_inst_depth = g_inst_depth - 1
        return -1
    }
    // 去重记录（is_struct=2 与模板登记的 enum 类别对齐）
    sstate.gin_reg(mangled, gti, args, 2)
    g_inst_depth = g_inst_depth - 1
    return ei
}

// 推断泛型 **enum** 模板的类型实参（构造调用 Option.Some(42)）：
// 模板 enum 布局 = children[slot_off + k] 是 N_ENUM_VARIANT（name = 变体名，
// children = payload 类型）；本函数定位变体后用 match_type_node 把 payload
// 类型节点中的 TypeVar 绑定到实参类型。explicit / arg_tys / 返回约定同
// infer_type_args。variant_name：构造的变体名（用于定位 payload 布局）。
pub func infer_type_args_variants(tmpl_node: i64, gti: i64, variant_name: string, explicit: table<i64>, arg_tys: table<i64>, call_id: i64) -> table<i64> {
    var tp_names = sstate.gt_param_names(gti)
    var n_tp = len(tp_names)
    var bk: table<i64> = table_new_i64()
    var bv: table<i64> = table_new_i64()
    var e: i64 = 0
    while e < len(explicit) {
        if explicit[e] != -1 {
            table_push(bk, tp_names[e])
            table_push(bv, explicit[e])
        }
        e = e + 1
    }
    if len(explicit) > n_tp {
        sm_err_line = s_lines[call_id]
        sm_err_col = s_cols[call_id]
        sm_err_msg = "类型实参过多：enum 模板需要 " + to_string(n_tp) + " 个类型参数，实际 " + to_string(len(explicit)) + " 个"
        return table_new_i64()
    }
    // 定位变体（模板 children[slot_off + k]，name = 变体名）
    var soff = sstate.slot_off(tmpl_node)
    var nv = sstate.nchild(tmpl_node) - soff
    var vi: i64 = -1
    var k: i64 = 0
    while k < nv {
        var v = sstate.child(tmpl_node, soff + k)
        if sstate.name_str(v) == variant_name {
            vi = k
            break
        }
        k = k + 1
    }
    if vi < 0 {
        sm_err_line = s_lines[call_id]
        sm_err_col = s_cols[call_id]
        sm_err_msg = "枚举 '" + sstate.name_str(tmpl_node) + "' 没有变体 '" + variant_name + "'"
        return table_new_i64()
    }
    var v = sstate.child(tmpl_node, soff + vi)
    var np = sstate.nchild(v)
    // 逐个 payload 类型匹配实参（bind TypeVar）
    var j: i64 = 0
    while j < len(arg_tys) {
        if j >= np {
            sm_err_line = s_lines[call_id]
            sm_err_col = s_cols[call_id]
            sm_err_msg = "构造 '" + sstate.name_str(tmpl_node) + "." + variant_name + "' 参数过多（payload 字段数 " + to_string(np) + "）"
            return table_new_i64()
        }
        var pty_node = sstate.child(v, j)
        var mr = match_type_node(pty_node, arg_tys[j], tp_names, bk, bv, call_id)
        if mr == -2 {
            return table_new_i64()
        }
        j = j + 1
    }
    return finish_args(gti, tp_names, bk, bv, call_id)
}


// ==================== 类型实参推断辅助（AST 模式匹配绑定）====================
// 把模板形参/字段类型 AST 节点与实参具体类型匹配，递归绑定 TypeVar。
// 返回：0 = 匹配成功（可能绑定）；-1 = 类型不匹配（未绑定、未报错）；
// -2 = 绑定冲突（已设置 sm_err_*）。


// 模板类型节点与具体类型递归匹配（TypeVar 位置绑定）
// bk/bv：绑定表（类型参数名 id → 类型实参 id），ref 语义由调用方持有
pub func match_type_node(tnode: i64, arg_ty: i64, tp_names: table<i64>, bk: ref table<i64>, bv: ref table<i64>, call_id: i64) -> i64 {
    if tnode < 0 {
        return -1
    }
    var tag = s_tags[tnode]
    if tag == S_N_NAMED_TYPE {
        var want = types.named(s_vals[tnode])
        if want == arg_ty {
            return 0
        }
        return -1
    }
    if tag == S_N_STRUCT_TYPE {
        var nm = sstate.name_str(tnode)
        var tpi = find_tp(tp_names, nm)
        if tpi >= 0 {
            // bind_tp 按「名字 id」登记（finish_args 用 tp_names[k] 查找）
            return bind_tp(tp_names[tpi], arg_ty, bk, bv, call_id)
        }
        // 具体 struct/enum 引用
        var nid = intern.intern(nm)
        var sidx = sstate.bs_find(st_keys, nid)
        var gidx = sstate.gt_find(nm)
        if types.kind(arg_ty) != K_STRUCT && types.kind(arg_ty) != K_ENUM {
            return -1
        }
        var sname = ""
        if types.kind(arg_ty) == K_STRUCT {
            sname = sstate.struct_name_of(types.low(arg_ty))
        } else {
            sname = sstate.enum_name_of(types.low(arg_ty))
        }
        if sidx >= 0 && gidx < 0 {
            // 普通 struct：精确名匹配
            if sname == nm {
                return 0
            }
            return -1
        }
        // 模板 struct/enum 引用（Box<T> / MyResult<T,E>）：arg 必须是该模板的实例化
        if gidx < 0 || (gty_is_struct[gidx] != 1 && gty_is_struct[gidx] != 2) {
            return -1
        }
        var rec = sstate.gin_find(sname)
        if rec < 0 {
            return -1
        }
        if gin_tmpl[rec] != gidx {
            return -1
        }
        // 递归匹配 N_TYPE_ARGS 与实例化实参
        var nc = sstate.nchild(tnode)
        if nc > 0 {
            var ta = sstate.child(tnode, 0)
            if ta >= 0 && s_tags[ta] == S_N_TYPE_ARGS {
                var n_args = sstate.nchild(ta)
                var k: i64 = 0
                while k < n_args {
                    var at = sstate.gin_arg_at(rec, k)
                    if at < 0 {
                        return -1
                    }
                    var mr = match_type_node(sstate.child(ta, k), at, tp_names, bk, bv, call_id)
                    if mr != 0 {
                        return mr
                    }
                    k = k + 1
                }
            }
        }
        return 0
    }
    if tag == S_N_TABLE_TYPE {
        var kt = types.kind(arg_ty)
        if kt != K_TABLE || types.is_map(arg_ty) {
            return -1
        }
        var ety = types.table_elem(arg_ty)
        if ety < 0 {
            return -1
        }
        return match_type_node(sstate.child(tnode, 0), ety, tp_names, bk, bv, call_id)
    }
    if tag == S_N_MAP_TYPE {
        if types.kind(arg_ty) != K_MAP {
            return -1
        }
        var ety = types.table_elem(arg_ty)
        if ety < 0 {
            return -1
        }
        return match_type_node(sstate.child(tnode, 0), ety, tp_names, bk, bv, call_id)
    }
    if tag == S_N_FN_TYPE {
        // S2.2 函数值类型模板匹配：`fn(T)->R` 实参必须是 K_FN，且返回类型
        // 与各参数类型逐项 match（返回类型/参数类型可为类型参数引用 → 绑定）。
        // 支撑泛型高阶函数：`func apply<T>(f: fn(T)->T, x: T) -> T`。
        if types.kind(arg_ty) != K_FN {
            return -1
        }
        var nc = sstate.nchild(tnode)
        if nc < 1 {
            return -1
        }
        // 返回类型匹配（children[0]）
        var wr = types.fn_ret_ty(arg_ty)
        var mr = match_type_node(sstate.child(tnode, 0), wr, tp_names, bk, bv, call_id)
        if mr != 0 {
            return mr
        }
        // 参数个数必须一致
        var n_params = types.fn_nparams_of(arg_ty)
        if n_params != nc - 1 {
            return -1
        }
        var k: i64 = 1
        while k < nc {
            var wp = types.fn_param_of(arg_ty, k - 1)
            var mr2 = match_type_node(sstate.child(tnode, k), wp, tp_names, bk, bv, call_id)
            if mr2 != 0 {
                return mr2
            }
            k = k + 1
        }
        return 0
    }
    return -1
}


// 推断模板**函数**的类型实参（FnDef 布局：形参 = children[slot_off+1+k]）。
// explicit：按模板参数顺序的已显式指定实参（-1 = 未指定，长度 ≤ n_tp）。
// param_start：从第几个形参开始匹配（方法调用跳过接收者首参 = 1；普通 = 0）。
// arg_tys：实参类型表（调用点已推断）。
// 返回完整 args 表；失败返回空表（sm_err_* 已置）。
pub func infer_type_args(tmpl_node: i64, gti: i64, explicit: table<i64>, param_start: i64, arg_tys: table<i64>, call_id: i64) -> table<i64> {
    var tp_names = sstate.gt_param_names(gti)
    var n_tp = len(tp_names)
    var bk: table<i64> = table_new_i64()
    var bv: table<i64> = table_new_i64()
    // 显式实参填充（按模板参数序；-1 = 未指定；v2 值编码 <0 同样入绑定表）
    var e: i64 = 0
    while e < len(explicit) {
        if explicit[e] != -1 {
            table_push(bk, tp_names[e])
            table_push(bv, explicit[e])
        }
        e = e + 1
    }
    if len(explicit) > n_tp {
        sm_err_line = s_lines[call_id]
        sm_err_col = s_cols[call_id]
        sm_err_msg = "类型实参过多：模板需要 " + to_string(n_tp) + " 个类型参数，实际 " + to_string(len(explicit)) + " 个"
        return table_new_i64()
    }
    // 逐实参匹配
    var nparams = s_aux[tmpl_node]
    var j: i64 = 0
    while j < len(arg_tys) {
        var pi = param_start + j
        if pi >= nparams {
            // p.8.1.3 变长泛型：形参最后一个为变参（`name: ...T`）→ 剩余实参
            // 全部匹配变参的元素类型节点（TypeVar T），逐个绑定（冲突由
            // match_type_node 报「推断冲突」）。
            if nparams > 0 {
                var lastp = sstate.child(tmpl_node, sstate.slot_off(tmpl_node) + 1 + (nparams - 1))
                if s_aux[lastp] == 1 {
                    var lty_node = sstate.child(lastp, 0)
                    var mr = match_type_node(lty_node, arg_tys[j], tp_names, bk, bv, call_id)
                    if mr == -2 {
                        return table_new_i64()
                    }
                    j = j + 1
                    continue
                }
            }
            sm_err_line = s_lines[call_id]
            sm_err_col = s_cols[call_id]
            sm_err_msg = "函数 '" + sstate.name_str(tmpl_node) + "' 实参过多（泛型推断）"
            return table_new_i64()
        }
        var pnode = sstate.child(tmpl_node, sstate.slot_off(tmpl_node) + 1 + pi)
        var pty_node = sstate.child(pnode, 0)
        var mr = match_type_node(pty_node, arg_tys[j], tp_names, bk, bv, call_id)
        if mr == -2 {
            return table_new_i64()
        }
        j = j + 1
    }
    return finish_args(gti, tp_names, bk, bv, call_id)
}

// 推断模板 **struct** 的类型实参（Struct 布局：字段 = children[1+k]，ClassField 的
// 类型在 child(f, 0)）。explicit / arg_tys / 返回约定同 infer_type_args。
pub func infer_type_args_fields(tmpl_node: i64, gti: i64, explicit: table<i64>, arg_tys: table<i64>, call_id: i64) -> table<i64> {
    var tp_names = sstate.gt_param_names(gti)
    var n_tp = len(tp_names)
    var bk: table<i64> = table_new_i64()
    var bv: table<i64> = table_new_i64()
    var e: i64 = 0
    while e < len(explicit) {
        if explicit[e] != -1 {
            table_push(bk, tp_names[e])
            table_push(bv, explicit[e])
        }
        e = e + 1
    }
    if len(explicit) > n_tp {
        sm_err_line = s_lines[call_id]
        sm_err_col = s_cols[call_id]
        sm_err_msg = "类型实参过多：struct 模板需要 " + to_string(n_tp) + " 个类型参数，实际 " + to_string(len(explicit)) + " 个"
        return table_new_i64()
    }
    var nfld = sstate.nchild(tmpl_node) - 1
    var j: i64 = 0
    while j < len(arg_tys) {
        if j >= nfld {
            break  // 实参个数已在调用方校验（最多字段数）
        }
        var f = sstate.child(tmpl_node, 1 + j)
        var ft_node = sstate.child(f, 0)
        var mr = match_type_node(ft_node, arg_tys[j], tp_names, bk, bv, call_id)
        if mr == -2 {
            return table_new_i64()
        }
        j = j + 1
    }
    return finish_args(gti, tp_names, bk, bv, call_id)
}

// ---------- p.9.11.32 类型别名展开 ----------
// 展开深度护栏 alias_depth 在文件顶层（命名空间体内不允许 var）


}

import "./sgen_p1.tie"
