type tie<class>
// compiler/frontend/lex_scan_p1.tie —— 分片 1（p.9.21.3 单文件 ≤800 行）
// ============================================================
// 由 split_parts.py 按行数贪心分片：只搬函数与紧邻注释，
// 顶层全局 var 与 import 树仍留在 lex_scan.tie。
namespace lexscan {
// ---------- 错误槽位 ----------
// 记录词法错误（line/col 1 起；msg 为 errors 表消息或格式函数结果）
func set_err(line: i64, col: i64, msg: string) {
    g_err_line = line
    g_err_col = col
    g_err_msg = msg
}

// 码点区间快切（性能重构）：[a, b) 的 lexeme 切片走 g_byte_starts 字节偏移
// 表 + str_sub_bytes 字节 memcpy——O(len) 单次拷贝；替代 str.slice（码点
// 定位每次从头跳，全体 token 累计 O(T×N) 平方）。b == g_n 合法（哨兵项
// g_byte_starts[g_n] = 总字节数）。
func cp_slice(a: i64, b: i64) -> string {
    // 字节快切：g_byte_starts 码点→字节偏移表定位字节区间 + StringBuilder
    // 逐字节拷贝——O(len) 线性（str.slice 码点定位每次从头跳 O(n)，全体
    // token 累计 O(T×N) 平方，400 函数实测 parse 89% 耗时根源）。
    // 注：用 sb_append_byte 组合而非 str_sub_bytes 原语——自举兼容（旧
    // 编译器即认 S2.1 原语，免两阶段套娃构建）。
    var lo = g_byte_starts[a]
    var hi = g_byte_starts[b]
    var sb = string_builder()
    var k: i64 = lo
    while k < hi {
        sb_append_byte(sb, str_byte(g_src, k))
        k = k + 1
    }
    return sb_build(sb)
}

// 行尾定位：返回本行最后一个字符之后的位置（停在 '\n'，不消费）
func line_end(pos: i64) -> i64 {
    while pos < g_n {
        if g_codes[pos] == 10 {
            break
        }
        pos = pos + 1
    }
    return pos
}

// 块注释闭合定位：从 pos 起找 "*/"，返回其后位置；未闭合返回 -1
func find_block_close(pos: i64) -> i64 {
    while pos < g_n {
        if g_codes[pos] == 42 {        // '*'
            if pos + 1 < g_n {
                if g_codes[pos + 1] == 47 {   // '*/'
                    return pos + 2
                }
            }
        }
        pos = pos + 1
    }
    return -1
}

// 行注释 //...：不产 token，停在换行符
func scan_line_comment(pos: i64) -> i64 {
    return line_end(pos + 2)
}

// doc 行注释 ///...：内容收集为 doc
func scan_doc_line(pos: i64) -> i64 {
    var end = line_end(pos + 3)
    lextok.collect_doc(cp_slice(pos + 3, end))
    return end
}

// 块注释 /*...*/：未闭合报错（位置取注释起点）
func scan_block_comment(pos: i64) -> i64 {
    var close = find_block_close(pos + 2)
    if close < 0 {
        set_err(lextok.line_of(pos), lextok.col_of(pos), errors.err_msg("lex_block_unclosed"))
        return -1
    }
    return close
}

// doc 块注释 /**...*/：内容收集为 doc；未闭合同报「块注释未闭合」
func scan_doc_block(pos: i64) -> i64 {
    var close = find_block_close(pos + 3)
    if close < 0 {
        set_err(lextok.line_of(pos), lextok.col_of(pos), errors.err_msg("lex_block_unclosed"))
        return -1
    }
    lextok.collect_doc(cp_slice(pos + 3, close - 2))
    return close
}

// 合法转义：\n \t \r \\ \" \' \0（与 Rust scan_string/scan_char 一致）
func is_valid_escape(e: i64) -> bool {
    return e == 110 || e == 116 || e == 114 || e == 92 || e == 34 || e == 39 || e == 48
}

// p.9.11.30 三引号多行字符串 """..."""：跨行、raw 语义默认（\X 逐字保留，
// 仅 `\{` → 字面 `{` 防插值）、闭引号行基准缩进剥离（Swift 对齐语义）、
// 插值与单行同机制（`{` 前瞻判定复制自 scan_string 的 `{` 分支，双份维护）。
// 首行 `"""` 后紧跟换行 → 内容自下一行起；闭引号前最后一个换行剥离。
// 限制（v1）：内容中不可出现 `"""`；插值表达式内不可跨行（ASI 断句）。
// cont=1：g_str_interp==2 的续段重入（pos 为 `}` 之后，无开引号处理）。
func find_triple_end(pos: i64) -> i64 {
    while pos + 2 < g_n {
        if g_codes[pos] == 34 && g_codes[pos + 1] == 34 && g_codes[pos + 2] == 34 {
            return pos
        }
        pos = pos + 1
    }
    return -1
}

// 行内缩进（空白字符数）：从行起点到 pos 的空格/制表计数（margin 剥离基准）
func triple_line_indent(pos: i64) -> i64 {
    var ls = pos
    while ls > 0 && g_codes[ls - 1] != 10 {
        ls = ls - 1
    }
    var n: i64 = 0
    while ls < pos && (g_codes[ls] == 32 || g_codes[ls] == 9) {
        n = n + 1
        ls = ls + 1
    }
    return n
}

// 消费 [lo,hi] 码点区间的进制数字（0b/0o/0t 共用）。
// p.9.11.19 数字分隔符 `_`：进制数字内 `_` 且下一位仍在该进制区间 → 跳过
//（`0b1010_1010`）；否则停止（`1_` 尾分隔、`_x` 标识符不受影响——仅数字内）。
func scan_digit_range(pos: i64, lo: i64, hi: i64) -> i64 {
    while pos < g_n {
        var c = g_codes[pos]
        if c == 95 {   // '_'
            if pos + 1 < g_n && g_codes[pos + 1] >= lo && g_codes[pos + 1] <= hi {
                pos = pos + 1
            } else {
                break
            }
        } else if c >= lo {
            if c <= hi {
                pos = pos + 1
            } else {
                break
            }
        } else {
            break
        }
    }
    return pos
}

// 消费十六进制数字（0-9 a-f A-F）。p.9.11.19：`_` 后随十六进制数字 → 跳过
//（`0x_FF` / `0xCA_FE`）。
func scan_hex_digits(pos: i64) -> i64 {
    while pos < g_n {
        var c = g_codes[pos]
        if c == 95 {
            if pos + 1 < g_n && lextok.is_hex_digit(g_codes[pos + 1]) {
                pos = pos + 1
            } else {
                break
            }
        } else if lextok.is_hex_digit(c) {
            pos = pos + 1
        } else {
            break
        }
    }
    return pos
}

// 尝试解析指数 e/E [+-] 数字：成功返回消费后位置，失败返回 -1。
// p.9.11.19：指数数字内 `_` 且下一位是数字 → 跳过（`1e1_0`）。
func scan_exponent(pos: i64) -> i64 {
    var j = pos + 1
    if j >= g_n {
        return -1
    }
    if g_codes[j] == 45 || g_codes[j] == 43 {   // '-' / '+'
        j = j + 1
    }
    if j >= g_n {
        return -1
    }
    if !lextok.is_digit(g_codes[j]) {
        return -1
    }
    var end = j + 1
    while end < g_n {
        var c = g_codes[end]
        if lextok.is_digit(c) {
            end = end + 1
        } else if c == 95 {
            if end + 1 < g_n && lextok.is_digit(g_codes[end + 1]) {
                end = end + 1
            } else {
                break
            }
        } else {
            break
        }
    }
    return end
}

}