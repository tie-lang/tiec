type tie<class>
// compiler/frontend/scheck.tie —— T2.6 语句/函数检查（模块拆分）
// ============================================================
// 里程碑：自举 v2 计划 T2.6（.omo/plans/self-hosting-v2.md）完整语义分析
// 拆分为 8 模块之一（本文件 = 语句检查 + 函数体检查 + switch case 检查）。
// 对应 proto/semantic.tie 3007-3437（check_stmt/check_switch_case/check_block/
// check_var_decl）+ 3554-3597（check_fn）+ 3694-3768（check_fn_walk）逻辑搬移。
// 依赖：./sstate.tie（AST 全局 + 符号表 + 工具）+ ./stype.tie（类型匹配）+
// ./sinfer.tie（表达式推断）。树式无环：由 semantic.tie import。
import "./scollect.tie"

// switch case 值去重表（跨 case 检测重复；switch 分支检查时重置）
var g_case_seen: table<string>;
// 三期 goto 标签表（§7.1.5，函数级）：标签名 → 所在块链/块内序号/全局序号。
// 每函数 check_fn 重置。R1 同函数 / R2 同块或已执行外层块 / R3 不越过初始化。
var g_gt_keys: table<i64>;      // 标签名池 id
var g_gt_chain: table<string>;  // 标签所在块链（"/" 分隔块 id）
var g_gt_blkidx: table<i64>;    // 标签在所在块内语句序号
var g_gt_seq: table<i64>;       // 标签全局语句序号（函数内单调）
var g_gt_depths: table<i64>;    // 标签块深度
var g_gt_blknode: table<i64>;   // 标签所在块 StmtList 节点（R3 扫描用）
// goto 请求表（延迟校验）：goto 可能在标签前（前向跳），函数体检查完统一校验。
// 与标签表同位布局：目标名 / goto 所在块链 / 块内序号 / 全局序号 / 行列。
var g_gtg_keys: table<i64>;
var g_gtg_chain: table<string>;
var g_gtg_blkidx: table<i64>;
var g_gtg_seq: table<i64>;
var g_gtg_line: table<i64>;
var g_gtg_col: table<i64>;
// 当前块追踪（函数级）：块链 / 块深度 / 块内语句序号 / 当前块 StmtList 节点
var g_cur_chain: string = "";   // 当前块链
var g_cur_depth: i64 = 0;       // 当前块深度
var g_cur_blkidx: i64 = 0;      // 当前块内语句序号（check_block 循环设置）
var g_cur_blknode: i64 = -1;    // 当前块 StmtList 节点（R3 扫描用）
var g_gt_seq_cnt: i64 = 0;      // 函数内语句全局序号
var g_gt_blk_seq: i64 = 0;      // 块 id 计数器（函数级）
// 警告辅助：当前块内已声明名集合（控制变量遮蔽 vs 重复声明的判定）。
// check_block 进入/退出 save/restore，使同名内层声明可被识别为遮蔽外层。
var g_block_names: table<i64> = []
// 警告辅助：控制流嵌套深度（W00017，进入 if/while/for/switch/try/... 体 +1）
var g_cf_depth: i64 = 0

// W00008 / W00005 判定：声明同名变量 / for 变量时调用（lv_insert 之前）。
// 已存在 lv_keys 的绑定：若也在当前块声明集合 g_block_names → 同块重复声明
//（W00005）；否则为内层遮蔽外层（W00008）。最后把本名记入当前块集合。
func decl_warn(nid: i64, line: i64, col: i64) {
    var ex = sstate.bs_find(lv_keys, nid)
    if ex >= 0 {
        if sstate.seg_has(g_block_names, 0, len(g_block_names), nid) == 1 {
            sm_warn_add(line, col, "变量重复声明（同名变量再次声明，后者覆盖前者）")
        } else {
            sm_warn_add(line, col, "变量遮蔽（内层同名变量遮蔽外层）")
        }
    }
    table_push(g_block_names, nid)
}

// W00010：完全空的块（StmtList nchild==0）报警。仅用于控制流体
//（if/while/for/try/defer/unsafe/guard），函数体与 switch 缺省分支不报
//（合法空实现，且无法读取注释区分占位，宁可漏报避免误伤）。
func warn_empty_block(blk: i64, s: i64) {
    if blk >= 0 && blk != s && s_tags[blk] == S_N_STMTLIST && sstate.nchild(blk) == 0 {
        // 位置取父语句而非块节点：块节点（StmtList）不记录自身位置，
        // s_lines[blk] 拿到的是继承/默认值，会把空块报到上一条语句上
        // （实测 `if n>0 {}` 报成前一行 @4:14 / @4:5）。父语句行列可靠。
        sm_warn_add(s_lines[s], s_cols[s], "空语句块（无内容且无注释占位）")
    }
}

// W00013 辅助：子树内是否存在对 nm 的写方法调用（追加/删除类）。
// 不依赖 MethodCall 的 children 精确布局——扫描该节点全部子节点，
// 只要同时出现「名字 == nm」与「名字是写方法」即认定（同名即同一张表）。
func mod_walk(node: i64, nm: string) -> i64 {
    if node < 0 {
        return 0
    }
    // 不判节点 tag：tie 的表操作是函数式 API（table_push(t, v)），其调用节点的
    // tag 不一定是 S_N_CALL。只要某节点同时含有「写函数名」与「被遍历的表名」
    // 两个子名字，就认定在遍历中改表（同名即同一张表）。
    var has_recv: bool = false
    var is_write: bool = false
    var nc = sstate.nchild(node)
    var k: i64 = 0
    while k < nc {
        var cn = sstate.name_str(sstate.child(node, k))
        if cn == nm {
            has_recv = true
        }
        if cn == "table_push" || cn == "table_pop" || cn == "table_set" ||
            cn == "table_remove" || cn == "table_insert" || cn == "table_clear" ||
            cn == "table_trunc" {
            is_write = true
        }
        k = k + 1
    }
    if has_recv && is_write {
        return 1
    }
    var n = sstate.nchild(node)
    var i: i64 = 0
    while i < n {
        if mod_walk(sstate.child(node, i), nm) == 1 {
            return 1
        }
        i = i + 1
    }
    return 0
}

// W00005 / W00011 / W00015 子树遍历：收集全部局部声明节点（decls）、可变 var
// 声明节点（mvars）、被赋值目标名、被读取名。
// 递归覆盖闭包体（FN_LIT 子树），故闭包内对外层变量的读取/修改均计入，
// 避免对捕获变量误报「未使用 / 未修改」。
func diag_walk(node: i64, mvars: table<i64>, assigned: table<i64>, reads: table<i64>, decls: table<i64>) {
    if node < 0 {
        return
    }
    var t = s_tags[node]
    if t == S_N_VAR_DECL {
        // 全部局部声明（var 与 const）登记，供 W00005「未使用变量」判定
        table_push(decls, node)
        if s_vals[node] == 0 {
            table_push(mvars, node)
        }
    } else if t == S_N_VAR {
        var nid = s_names[node]
        if nid >= 0 {
            table_push(reads, nid)
        }
    } else if t == S_N_CALL {
        // N_CALL 的**被调名存于节点自身的 name**（pexpr：new_node(N_CALL, 被调名, …)；
        // children[0] 是泛型槽、其余是实参）。fn 值变量以 `fv(args)` 被调用时，被调名
        // 不会作为 S_N_VAR 子节点出现，故显式把被调名登记为「读取」，避免对「仅被调用
        // 读取」的 fn 值变量误报未使用。名字为全局函数名时不会命中任何局部声明，无副作用。
        var cnm = sstate.name_str(node)
        if len(cnm) > 0 {
            table_push(reads, intern.intern(cnm))
        }
    } else if t == S_N_ASSIGN {
        var nid = s_names[node]
        if nid >= 0 {
            table_push(assigned, nid)
        }
    } else if t == S_N_FIELD_ASSIGN {
        var root = sstate.im_root(sstate.child(node, 0))
        if root >= 0 {
            table_push(assigned, root)
        }
    } else if t == S_N_INDEX_ASSIGN {
        var tgt = sstate.child(node, 0)
        if tgt >= 0 {
            var root = sstate.im_root(sstate.child(tgt, 0))
            if root >= 0 {
                table_push(assigned, root)
            }
        }
    }
    var nc = sstate.nchild(node)
    var k: i64 = 0
    while k < nc {
        diag_walk(sstate.child(node, k), mvars, assigned, reads, decls)
        k = k + 1
    }
}

// ==================== W00019 / W00016 全局状态与辅助 ====================

// W00019：静态长度可确定的表变量（`var t = [字面量...]`）长度表（名池 id → 长度）。
var w19_len_keys: table<i64> = []
var w19_len_vals: table<i64> = []
// 名池 id → 出现次数（S_N_VAR 读节点数）
var w19_occ_keys: table<i64> = []
var w19_occ_vals: table<i64> = []
// 名池 id → 作为下标赋值目标的次数（S_N_INDEX_ASSIGN 的根变量）
var w19_idx_keys: table<i64> = []
var w19_idx_vals: table<i64> = []

// W00016：全局可变表写点累积（名池 id → 写点计数 / 首个写点位置）。
var w16_keys: table<i64> = []
var w16_cnt: table<i64> = []
var w16_ln: table<i64> = []
var w16_cl: table<i64> = []

namespace scheck {

// 名 → 计数递增（线性查找，表很小）
func wbump(keys: table<i64>, vals: table<i64>, nid: i64) {
    var i: i64 = 0
    while i < len(keys) {
        if keys[i] == nid {
            vals[i] = vals[i] + 1
            return
        }
        i = i + 1
    }
    table_push(keys, nid)
    table_push(vals, 1)
}

// 名 → 计数读取（0 = 无记录；W00019 仅登记正长度，故 0 安全表示「未记录」）
func wget(keys: table<i64>, vals: table<i64>, nid: i64) -> i64 {
    var i: i64 = 0
    while i < len(keys) {
        if keys[i] == nid {
            return vals[i]
        }
        i = i + 1
    }
    return 0
}

// W00019 每函数重置（在 check_fn 入口调用）。
func w19_reset() {
    w19_len_keys = table_new_i64()
    w19_len_vals = table_new_i64()
    w19_occ_keys = table_new_i64()
    w19_occ_vals = table_new_i64()
    w19_idx_keys = table_new_i64()
    w19_idx_vals = table_new_i64()
}

// W00019 单遍遍历：登记「表字面量声明」的静态长度 + 名字出现次数 + 下标赋值目标次数。
func w19_collect(node: i64) {
    if node < 0 {
        return
    }
    var t = s_tags[node]
    if t == S_N_VAR_DECL {
        var init = sstate.child(node, 1)
        if init >= 0 && s_tags[init] == S_N_TABLE_LIT && sstate.nchild(init) > 0 {
            var nid = s_names[node]
            if nid >= 0 && wget(w19_len_keys, w19_len_vals, nid) == 0 {
                table_push(w19_len_keys, nid)
                table_push(w19_len_vals, sstate.nchild(init))
            }
        }
    } else if t == S_N_VAR {
        var nid = s_names[node]
        if nid >= 0 {
            wbump(w19_occ_keys, w19_occ_vals, nid)
        }
    } else if t == S_N_INDEX_ASSIGN {
        var root = sstate.im_root(sstate.child(node, 0))
        if root >= 0 {
            wbump(w19_idx_keys, w19_idx_vals, root)
        }
    }
    var nc = sstate.nchild(node)
    var k: i64 = 0
    while k < nc {
        w19_collect(sstate.child(node, k))
        k = k + 1
    }
}

// W00019 单遍遍历：对「仅被下标赋值使用」的表字面量变量，检查常量下标是否越界。
func w19_check(node: i64) {
    if node < 0 {
        return
    }
    if s_tags[node] == S_N_INDEX_ASSIGN {
        var target = sstate.child(node, 0)
        if s_tags[target] == S_N_INDEX {
            var base_node = sstate.child(target, 0)
            if s_tags[base_node] == S_N_VAR {
                var nid = s_names[base_node]
                if nid >= 0 {
                    var ln = wget(w19_len_keys, w19_len_vals, nid)
                    // 安全条件：该变量的全部出现都是下标赋值目标（无读取/传参/重赋值），
                    // 故声明时的字面量长度在整段函数体内恒定不变。
                    if ln > 0 && wget(w19_occ_keys, w19_occ_vals, nid) == wget(w19_idx_keys, w19_idx_vals, nid) {
                        var (ic, iv) = stype.arr_const_index(sstate.child(target, 1))
                        if ic && iv >= ln {
                            sm_warn_add(s_lines[node], s_cols[node], "表元素越界写静默失败（t[i] = v 且 i >= len 时丢弃）")
                        }
                    }
                }
            }
        }
    }
    var nc = sstate.nchild(node)
    var k: i64 = 0
    while k < nc {
        w19_check(sstate.child(node, k))
        k = k + 1
    }
}

// W00016：登记一个全局可变表的写点（nid = 已解析的全局键，见调用点）。
func w16_record(nid: i64, ln: i64, cl: i64) {
    if nid < 0 {
        return
    }
    var ty = sinfer.gb_find(nid)
    if ty < 0 || !types.is_table(ty) {
        return
    }
    if sinfer.gb_const_of(nid) == 1 {
        return
    }
    var i: i64 = 0
    while i < len(w16_keys) {
        if w16_keys[i] == nid {
            w16_cnt[i] = w16_cnt[i] + 1
            return
        }
        i = i + 1
    }
    table_push(w16_keys, nid)
    table_push(w16_cnt, 1)
    table_push(w16_ln, ln)
    table_push(w16_cl, cl)
}

// W00016：每编译重置累积（由 semantic.sm_warn_reset 调用）。
pub func w16_reset() {
    w16_keys = table_new_i64()
    w16_cnt = table_new_i64()
    w16_ln = table_new_i64()
    w16_cl = table_new_i64()
}

// W00016：全部函数检查完后发射（写点 >= 2 的全局可变表）。
pub func w16_emit() {
    var i: i64 = 0
    while i < len(w16_keys) {
        if w16_cnt[i] >= 2 {
            sm_warn_add(w16_ln[i], w16_cl[i], "可变全局表共享状态（被多处修改）")
        }
        i = i + 1
    }
}

// 判定 for 迭代对象是否为字符串码点迭代器调用 `s.chars()`（dev33 批次4）。
// 结构：MethodCall，方法名 == "chars"，接收者（child[slot_off]）类型为 string
// 且无实参。用于 S_N_FOR 分支把循环变量登记为单字符 string。
func is_chars_iter(iter: i64) -> bool {
    if s_tags[iter] != S_N_METHOD_CALL {
        return false
    }
    if sstate.name_str(iter) != "chars" {
        return false
    }
    // 接收者类型须为 string（全局/局部变量或表达式均可，.chars() 语义上
    // 恒作用于字符串）；实参个数须为 0。
    var recv = sstate.child(iter, sstate.slot_off(iter))
    var rt = sinfer.infer_expr(recv)
    if rt < 0 || rt != types.named(TK_STR) {
        return false
    }
    if sstate.nchild(iter) > sstate.slot_off(iter) + 1 {
        return false
    }
    return true
}

// 语句块检查（StmtList）。每块分配递增块 id，进入块时把 id 追加到块链
// g_cur_chain（"/" 分隔），出块恢复——goto 标签 R2 校验依赖块链关系。
pub func check_block(blk: i64) -> i64 {
    var saved_chain = g_cur_chain
    var saved_depth = g_cur_depth
    var saved_blknode = g_cur_blknode
    var saved_bn = g_block_names
    g_gt_blk_seq = g_gt_blk_seq + 1
    g_cur_chain = g_cur_chain + "/" + to_string(g_gt_blk_seq)
    g_cur_depth = g_cur_depth + 1
    g_cur_blknode = blk
    g_block_names = table_new_i64()
    var n = sstate.nchild(blk)
    var i: i64 = 0
    var reachable: bool = true
    while i < n {
        g_cur_blkidx = i
        g_gt_seq_cnt = g_gt_seq_cnt + 1
        var s = sstate.child(blk, i)
        // W00009：不可达语句（return/panic/goto/break/continue 之后的语句）
        if !reachable {
            sm_warn_add(s_lines[s], s_cols[s], "return 后不可达语句（语句恒不执行）")
        }
        var r = check_stmt(s)
        if r < 0 {
            return -1
        }
        // 更新可达性：块级无条件终止语句使后续语句不可达
        if reachable {
            var t = s_tags[s]
            if t == S_N_RETURN || t == S_N_PANIC || t == S_N_GOTO ||
                t == S_N_BREAK || t == S_N_CONTINUE {
                reachable = false
            }
        }
        i = i + 1
    }
    g_cur_chain = saved_chain
    g_cur_depth = saved_depth
    g_cur_blknode = saved_blknode
    g_block_names = saved_bn
    return 0
}

// W00017：控制流嵌套深度计数包装。进入控制流体 +1，深度 > 5 报警。
// 位置要求：check_block 之后（依赖它）、所有控制流调用点之前（tie 先定义后使用）。
func check_cf_block(blk: i64, s: i64) -> i64 {
    g_cf_depth = g_cf_depth + 1
    if g_cf_depth > 5 {
        sm_warn_add(s_lines[s], s_cols[s], "嵌套过深（控制流嵌套超过 5 层）")
    }
    var r = check_block(blk)
    g_cf_depth = g_cf_depth - 1
    return r
}

// p.8.2.11：guard else 块（N_STMTLIST）是否以跳转语句收尾。
func guard_else_ends_in_jump(list: i64) -> bool {
    var n = sstate.nchild(list)
    if n == 0 {
        return false
    }
    var last = sstate.child(list, n - 1)
    var t = s_tags[last]
    return t == S_N_RETURN || t == S_N_BREAK || t == S_N_CONTINUE || t == S_N_GOTO || t == S_N_PANIC
}

// p.9.11.4 defer 块内禁止的流控语句判定（return/break/continue/goto/panic）。
func defer_forbidden_jump(t: i64) -> bool {
    return t == S_N_RETURN || t == S_N_BREAK || t == S_N_CONTINUE ||
        t == S_N_GOTO || t == S_N_PANIC
}

// p.9.11.4 defer 语句检查：检查块体（表达式/赋值/读变量均正常推断），并
// 递归拒绝块内出现 return/break/continue/goto/panic/嵌套 defer（资源释放
// 语句在退出时线性执行，不允许提前跳转/不可恢复退出/再注册）。递归扫描
// 允许结构块（if/while/for/switch/try/unsafe），但在仍碰见禁止语句即报诊断。
func check_defer(s: i64) -> i64 {
    var body = sstate.child(s, 0)
    // 先拒绝块内禁止的流控语句（return/break/continue/goto/panic/嵌套 defer）
    var rf = check_defer_block(body)
    if rf < 0 {
        return -1
    }
    if body < 0 {
        return 0
    }
    // 再类型检查块体语句（表达式/赋值/读作用域变量正常推断）
    warn_empty_block(body, s)
    return check_cf_block(body, s)
}

// 递归校验 defer 块体。返回 0 成功，-1 失败（诊断）。
func check_defer_block(blk: i64) -> i64 {
    var n = sstate.nchild(blk)
    var i: i64 = 0
    while i < n {
        var st = sstate.child(blk, i)
        var stag = s_tags[st]
        if defer_forbidden_jump(stag) {
            sm_err_line = s_lines[st]
            sm_err_col = s_cols[st]
            sm_err_msg = "defer 块内禁止 return/break/continue/goto/panic（资源释放应线性执行到块尾）"
            return -1
        }
        if stag == S_N_DEFER {
            sm_err_line = s_lines[st]
            sm_err_col = s_cols[st]
            sm_err_msg = "defer 块内禁止嵌套 defer"
            return -1
        }
        // 结构块递归下潜（查其上层禁止语句）
        if stag == S_N_IF {
            if check_defer_sub(sstate.child(st, 1)) < 0 {
                return -1
            }
            if check_defer_sub(sstate.child(st, 2)) < 0 {
                return -1
            }
        } else if stag == S_N_WHILE || stag == S_N_FOR {
            if check_defer_sub(sstate.child(st, 1)) < 0 {
                return -1
            }
        } else if stag == S_N_SWITCH {
            var c2: i64 = 1
            while c2 < sstate.nchild(st) {
                if check_defer_sub(sstate.child(st, c2)) < 0 {
                    return -1
                }
                c2 = c2 + 1
            }
        } else if stag == S_N_TRY_BLOCK || stag == S_N_UNSAFE_BLOCK {
            if check_defer_sub(sstate.child(st, 0)) < 0 {
                return -1
            }
        }
        i = i + 1
    }
    return 0
}

// 单语句或块下潜（结构块的子树，子节点为 StmtList）。
func check_defer_sub(n: i64) -> i64 {
    if n < 0 {
        return 0
    }
    return check_defer_block(n)
}

// p.9.11.3 try 错误聚合块检查：检查块体所有语句（含 `?` 传播校验）；末语句若为
// N_EXPR_STMT 只取表达式值类型为 try 块的值类型（node_types），否则值为 -1（try
// 仅作语句）。供 infer_expr(S_N_TRY_BLOCK) 调用（sinfer 无 check_block 能力）。
pub func check_try(s: i64) -> i64 {
    var body = sstate.child(s, 0)
    warn_empty_block(body, s)
    var r = check_cf_block(body, s)
    if r < 0 {
        return -1
    }
    var vt: i64 = -1
    var nb = sstate.nchild(body)
    if nb > 0 {
        var last = sstate.child(body, nb - 1)
        if s_tags[last] == S_N_EXPR_STMT && sstate.nchild(last) > 0 {
            vt = node_types[sstate.child(last, 0)]
            if vt < 0 {
                vt = types.named(TK_I64)
            }
        }
    }
    node_types[s] = vt
    g_typed = g_typed + 1
    return 0
}

// 块链前缀判定：prefix 是 full 的前缀（同块或外层块）。"/" 分隔段精确匹配，
// 避免 "1" 误配 "12"（块 id 整数段）。prefix == full 也算前缀（同块）。
func chain_is_prefix(prefix: string, full: string) -> bool {
    if str.starts_with(full, prefix) {
        var pn = str_len(prefix)
        var fn = str_len(full)
        if pn == fn {
            return true
        }
        if pn > 0 && str_char(full, pn) == "/" {
            return true
        }
    }
    return false
}

// 查 goto 标签表（函数级），返回下标；未找到 -1
func gt_find(name_id: i64) -> i64 {
    var i: i64 = 0
    while i < len(g_gt_keys) {
        if g_gt_keys[i] == name_id {
            return i
        }
        i = i + 1
    }
    return -1
}

// 指定块 StmtList 的 [lo, hi) 直接语句区间内是否存在 var/const 声明（R3 用）
func blk_has_var_decl(blk: i64, lo: i64, hi: i64) -> bool {
    var j = lo
    while j < hi {
        var st = sstate.child(blk, j)
        if st >= 0 && s_tags[st] == S_N_VAR_DECL {
            return true
        }
        j = j + 1
    }
    return false
}

// 字面量节点 → 整数值（IntLit 取 val；CharLit 取 name 池 id 对应码点；
// Unary NEG + IntLit 取负值）。用于 switch case 区间的 start < end 比较
// （对齐 Rust literal_cmp/literal_value）。
func int_lit_val(n: i64) -> i64 {
    var tag = s_tags[n]
    if tag == S_N_INT_LIT {
        return s_vals[n]
    }
    if tag == S_N_CHAR_LIT {
        var lid = s_names[n]
        if lid >= 0 {
            var txt = intern.lookup(lid)
            if str_len(txt) >= 3 {
                // 引号剥掉后取第一个码点
                return char_code(str_char(txt, 1))
            }
        }
        return 0
    }
    if tag == S_N_UNARY {
        // 前缀负号 + 整数 → 取负值（case -1 等）
        var op = s_vals[n]
        var operand = sstate.child(n, 0)
        if op == 0 {
            var v = int_lit_val(operand)
            return 0 - v
        }
    }
    return 0
}

// 字面量 key（重复检测用）：int → "i:<val>"，char → "c:<code>"，str → "s:<lexeme>"，bool → "b:<0/1>"
func lit_key(n: i64) -> string {
    var tag = s_tags[n]
    if tag == S_N_INT_LIT {
        return "i:" + to_string(s_vals[n])
    }
    if tag == S_N_UNARY {
        // case -1：前缀负号 + 整数 → "i:-<val>"
        var op = s_vals[n]
        if op == 0 {
            var v = int_lit_val(n)
            return "i:" + to_string(v)
        }
    }
    if tag == S_N_CHAR_LIT {
        return "c:" + to_string(int_lit_val(n))
    }
    if tag == S_N_BOOL_LIT {
        return "b:" + to_string(s_vals[n])
    }
    if tag == S_N_STR_LIT {
        return "s:" + sstate.name_str(n)
    }
    return "?"
}

// case 值是否编译期字面量（对齐 Rust is_const_literal：整数/浮点/字符/布尔/字符串；
// 前缀负号 + 数字字面量也算——case -1 是 Unary NEG + IntLit）
func is_case_literal(n: i64) -> bool {
    var tag = s_tags[n]
    if tag == S_N_INT_LIT || tag == S_N_FLOAT_LIT || tag == S_N_CHAR_LIT || tag == S_N_BOOL_LIT || tag == S_N_STR_LIT {
        return true
    }
    if tag == S_N_UNARY {
        var op = s_vals[n]
        if op == 0 {
            var operand = sstate.child(n, 0)
            var otag = s_tags[operand]
            if otag == S_N_INT_LIT || otag == S_N_FLOAT_LIT {
                return true
            }
        }
    }
    return false
}

// switch case 检查（语句位）。模式/守卫检查拆分到 check_arm_patterns（供
// p.9.10.1 表达式位复用），此处统一走模式检查后校验分支体（语句块）。
pub func check_switch_case(c: i64, subj_ty: i64) -> i64 {
    var rp = check_arm_patterns(c, subj_ty)
    if rp < 0 {
        return -1
    }
    var body = sstate.child(c, 2)
    warn_empty_block(body, c)
    return check_cf_block(body, c)
}

// 模式 + when 守卫检查（不含分支体——供 p.9.10.1 表达式位 switch 复用）。
// 按 subject 类型分派：枚举 → check_arm_patterns_enum；否则 → plain。
pub func check_arm_patterns(c: i64, subj_ty: i64) -> i64 {
    if types.kind(subj_ty) == K_ENUM {
        return check_arm_patterns_enum(c, subj_ty)
    }
    return check_arm_patterns_plain(c, subj_ty)
}

// 非枚举 subject 的 case 模式/守卫检查（原 check_switch_case 非枚举段）。
func check_arm_patterns_plain(c: i64, subj_ty: i64) -> i64 {
    var plist = sstate.child(c, 0)
    var when_n = sstate.child(c, 1)
    var np = sstate.nchild(plist)
    var i: i64 = 0
    while i < np {
        var p = sstate.child(plist, i)
        // 区间 pattern：通用 range 只允许整数，但 switch case 区间允许整数或字符
        if s_tags[p] == S_N_RANGE {
            var st = sinfer.infer_expr(sstate.child(p, 0))
            if st < 0 {
                return -1
            }
            var en = sinfer.infer_expr(sstate.child(p, 1))
            if en < 0 {
                return -1
            }
            var st_int = types.is_int(st)
            var en_int = types.is_int(en)
            var st_chr = st == TK_CHAR
            var en_chr = en == TK_CHAR
            if !((st_int && en_int) || (st_chr && en_chr)) {
                sm_err_line = s_lines[c]
                sm_err_col = s_cols[c]
                sm_err_msg = "case 区间两端必须是整数或字符字面量（浮点区间不支持）"
                return -1
            }
            // start < end（对齐 Rust：左闭右开，字符按码点比较）
            var stv = int_lit_val(sstate.child(p, 0))
            var env = int_lit_val(sstate.child(p, 1))
            if stv >= env {
                sm_err_line = s_lines[c]
                sm_err_col = s_cols[c]
                sm_err_msg = "case 区间必须 start < end（左闭右开）"
                return -1
            }
            if (st_chr && subj_ty != TK_CHAR) || (st_int && !types.is_int(subj_ty)) {
                sm_err_line = s_lines[c]
                sm_err_col = s_cols[c]
                sm_err_msg = "case 区间类型与 switch 对象类型 " + types.type_name(subj_ty) + " 不匹配"
                return -1
            }
            i = i + 1
            continue
        }
        // P2c：any 主体 struct 匹配/绑定——`case Point:`（N_VAR 解析为 struct 名）
        // 与 `case Point(p):`（N_CASE_BIND 解构，绑定变量类型 = struct）
        if subj_ty == types.named(TK_ANY) {
            var bind_id2: i64 = -1
            var ref2 = p
            if s_tags[p] == N_CASE_BIND {
                ref2 = sstate.child(p, 0)
                bind_id2 = sstate.child(p, 1)
            }
            if s_tags[ref2] == S_N_VAR {
                var sname = sstate.name_str(ref2)
                var sidx = sstate.bs_find(st_keys, intern.intern(sname))
                if sidx >= 0 {
                    // struct 类型匹配（case Point: / case Point(p): 绑定）
                    var s_ty = types.struct_of(st_vals[sidx])
                    if bind_id2 >= 0 {
                        sinfer.lv_insert(bind_id2, s_ty, 0, -1, 0)
                    }
                    var key2 = "s:" + sname
                    var dd: i64 = 0
                    var dup2: bool = false
                    while dd < len(g_case_seen) {
                        if g_case_seen[dd] == key2 {
                            dup2 = true
                            break
                        }
                        dd = dd + 1
                    }
                    if dup2 {
                        sm_err_line = s_lines[c]
                        sm_err_col = s_cols[c]
                        sm_err_msg = "重复的 case 值 " + key2
                        return -1
                    }
                    table_push(g_case_seen, key2)
                    i = i + 1
                    continue
                }
            }
        }
        // case 类型匹配 pattern（对齐 Rust）：any 动态对象上匹配可装箱类型
        //（tag 约定见 tig_box_any）；其余静态类型一律报错（须在 infer_expr 前
        // 拦截，因为 infer_expr 对 TypeLit 直接报通用错误）
        if s_tags[p] == S_N_TYPE_LIT {
            var tynode = sstate.child(p, 0)
            var tmatch_ty = sgen.parse_generic_type_node(tynode)
            var tyname = types.type_name(tmatch_ty)
            if subj_ty == types.named(TK_ANY) {
                // P2b：any 主体类型匹配——case 类型必须可装箱
                //（整数/浮点/bool/string/char；装箱 tag 见 tig_box_any）
                var boxable: bool = false
                if types.is_int(tmatch_ty) || types.is_float(tmatch_ty) ||
                    tmatch_ty == types.named(TK_BOOL) || tmatch_ty == types.named(TK_STR) ||
                    tmatch_ty == types.named(TK_CHAR) {
                    boxable = true
                }
                if !boxable {
                    sm_err_line = s_lines[c]
                    sm_err_col = s_cols[c]
                    sm_err_msg = "case 类型匹配（" + tyname + "）不是可装箱类型（整数/浮点/bool/string/char）"
                    return -1
                }
                i = i + 1
                continue
            }
            sm_err_line = s_lines[c]
            sm_err_col = s_cols[c]
            sm_err_msg = "case 类型匹配（" + tyname + "）仅支持 any 动态类型，当前 switch 对象是 " + types.type_name(subj_ty)
            return -1
        }
        var pt = sinfer.infer_expr(p)
        if pt < 0 {
            return -1
        }
        // case 值必须是编译期字面量（对齐 Rust is_const_literal）
        if !is_case_literal(p) {
            sm_err_line = s_lines[c]
            sm_err_col = s_cols[c]
            sm_err_msg = "case 值必须是字面量（整数/浮点/字符/布尔/字符串）"
            return -1
        }
        if !stype.types_compatible(subj_ty, pt) && !stype.types_match(subj_ty, pt, p) {
            sm_err_line = s_lines[c]
            sm_err_col = s_cols[c]
            sm_err_msg = "case 值类型 " + types.type_name(pt) + " 与 switch 对象类型 " + types.type_name(subj_ty) + " 不匹配"
            return -1
        }
        // 重复 case 检测（对齐 Rust seen 表）
        var key = lit_key(p)
        var d: i64 = 0
        var dup: bool = false
        while d < len(g_case_seen) {
            if g_case_seen[d] == key {
                dup = true
                break
            }
            d = d + 1
        }
        if dup {
            sm_err_line = s_lines[c]
            sm_err_col = s_cols[c]
            sm_err_msg = "重复的 case 值 " + key
            return -1
        }
        table_push(g_case_seen, key)
        i = i + 1
    }
    if when_n >= 0 {
        var wt = sinfer.infer_expr(when_n)
        if wt < 0 {
            return -1
        }
        if !types.is_bool_like(wt) {
            sm_err_line = s_lines[c]
            sm_err_col = s_cols[c]
            sm_err_msg = "when 守卫必须是布尔表达式，实际是 " + types.type_name(wt)
            return -1
        }
    }
    return 0
}

// 枚举 switch 的 case 模式/守卫检查（原 check_enum_switch_case 的枚举段，
// 不含分支体检查）。
func check_arm_patterns_enum(c: i64, subj_ty: i64) -> i64 {
    var plist = sstate.child(c, 0)
    var when_n = sstate.child(c, 1)
    var ei = types.low(subj_ty)
    var ename = sstate.enum_name_of(ei)
    var np = sstate.nchild(plist)
    var i: i64 = 0
    while i < np {
        var p = sstate.child(plist, i)
        // 批次 7：N_CASE_BIND（`Ok(v)` 解构）→ 变体引用 + 绑定变量名池 id
        var bind_id: i64 = -1
        var vr = p
        if s_tags[p] == N_CASE_BIND {
            vr = sstate.child(p, 0)
            bind_id = sstate.child(p, 1)
        }
        // 变体引用解析：FieldAccess（Enum.Variant）或裸 Var（Variant，枚举名取 subject）
        if s_tags[vr] != S_N_FIELD_ACCESS && s_tags[vr] != S_N_VAR {
            sm_err_line = s_lines[c]
            sm_err_col = s_cols[c]
            sm_err_msg = "case 值必须是枚举变体引用（如 " + ename + ".Variant / " + ename + ".Variant(v)）"
            return -1
        }
        var bname = ""
        var vname = ""
        if s_tags[vr] == S_N_FIELD_ACCESS {
            var base = sstate.child(vr, 0)
            if s_tags[base] != S_N_VAR {
                sm_err_line = s_lines[c]
                sm_err_col = s_cols[c]
                sm_err_msg = "case 值必须是枚举变体引用（如 " + ename + ".Variant）"
                return -1
            }
            bname = sstate.name_str(base)
            vname = sstate.name_str(vr)
        } else {
            // 裸变体名（`case Ok(v)`）：枚举名取 switch 对象类型
            bname = sstate.enum_name_of(ei)
            vname = sstate.name_str(vr)
        }
        var eidx = sstate.bs_find(en_keys, intern.intern(bname))
        if eidx < 0 {
            // 泛型 enum 模板：switch 对象必须是对应模板的实例化
            //（如 subject 是 Option$i64，case 写 Option.Some）。
            // 通过 gin 记录反查：subject 的 mangled 名 → 记录 → 模板匹配。
            var gidx = sstate.gt_find(bname)
            if gidx < 0 || gty_is_struct[gidx] != 2 {
                sm_err_line = s_lines[c]
                sm_err_col = s_cols[c]
                sm_err_msg = "case 值 '" + bname + "' 与 switch 对象枚举类型 " + types.type_name(subj_ty) + " 不匹配"
                return -1
            }
            var rec = sstate.gin_find(sstate.enum_name_of(ei))
            if rec < 0 || gin_tmpl[rec] != gidx {
                sm_err_line = s_lines[c]
                sm_err_col = s_cols[c]
                sm_err_msg = "case 值 '" + bname + "' 与 switch 对象枚举类型 " + types.type_name(subj_ty) + " 不匹配（泛型 enum 实例）"
                return -1
            }
        } else if en_vals[eidx] != ei {
            sm_err_line = s_lines[c]
            sm_err_col = s_cols[c]
            sm_err_msg = "case 值 '" + bname + "' 与 switch 对象枚举类型 " + types.type_name(subj_ty) + " 不匹配"
            return -1
        }
        // 在变体段中找该变体（返回 tag 值 0..nvar-1）
        var varoff = en_varoff[ei]
        var nvar = en_nvar[ei]
        var tag: i64 = -1
        var k: i64 = 0
        while k < nvar {
            if intern.lookup(en_vnames[varoff + k]) == vname {
                tag = en_vtags[varoff + k]
                break
            }
            k = k + 1
        }
        if tag < 0 {
            sm_err_line = s_lines[c]
            sm_err_col = s_cols[c]
            sm_err_msg = "枚举 '" + ename + "' 没有变体 '" + vname + "'"
            return -1
        }
        // p.8.1.4：多字段解构绑定变量登记（绑定变量数须 == 变体 payload 字段数；
        // 逐个按字段类型 lv_insert）
        if bind_id >= 0 {
            var foff = en_vfldoff[varoff + tag]
            var nfld = en_vnfld[varoff + tag]
            var nbinds = sstate.nchild(p) - 1
            if nbinds != nfld {
                sm_err_line = s_lines[c]
                sm_err_col = s_cols[c]
                sm_err_msg = "case 解构要求变体 '" + vname + "' 恰有 " + to_string(nfld) + " 个 payload 字段，实际绑定 " + to_string(nbinds) + " 个变量"
                return -1
            }
            var b: i64 = 0
            while b < nfld {
                sinfer.lv_insert(sstate.child(p, 1 + b), en_ftys[foff + b], 0, -1, 0)
                b = b + 1
            }
        }
        // 重复 case 检测（tag 为去重键，对齐字面量 key 风格）。
        // p.8.1.4：带 when 守卫的 case 不判重（守卫使同变体多分支语义不同，
        // 如 `case Circle(r) when r<10:` 与 `case Circle(r):` 共存合法）。
        var key = "e:" + ename + ":" + vname
        if when_n < 0 {
            var d: i64 = 0
            var dup: bool = false
            while d < len(g_case_seen) {
                if g_case_seen[d] == key {
                    dup = true
                    break
                }
                d = d + 1
            }
            if dup {
                sm_err_line = s_lines[c]
                sm_err_col = s_cols[c]
                sm_err_msg = "重复的 case 值 " + key
                return -1
            }
            table_push(g_case_seen, key)
        }
        i = i + 1
    }
    if when_n >= 0 {
        var wt = sinfer.infer_expr(when_n)
        if wt < 0 {
            return -1
        }
        if !types.is_bool_like(wt) {
            sm_err_line = s_lines[c]
            sm_err_col = s_cols[c]
            sm_err_msg = "when 守卫必须是布尔表达式，实际是 " + types.type_name(wt)
            return -1
        }
    }
    return 0
}

// 重置 switch case 去重表（每个 switch 独立；表达式位由 sinfer 入口调用）。
pub func reset_case_seen() {
    g_case_seen = table_new_string()
}

// p.8.1.4 穷尽检查：无 default 的 enum switch 必须覆盖全部变体。
// 带 when 守卫的 case 不视为穷尽（守卫可能失败 → 运行期仍可能无分支命中）。
// 返回 0 通过 / -1 未穷尽（sm_err_* 已置）。pub 供 p.9.10.1 表达式位复用。
pub func check_enum_exhaustive(subj_ty: i64, s: i64) -> i64 {
    var ei = types.low(subj_ty)
    var ename = sstate.enum_name_of(ei)
    var varoff = en_varoff[ei]
    var nvar = en_nvar[ei]
    var covered: table<i64> = table_new_i64()
    var ncases = s_aux[s]
    var k: i64 = 0
    while k < ncases {
        var c = sstate.child(s, 1 + k)
        // 守卫 case 不算穷尽覆盖
        var when_n = sstate.child(c, 1)
        if when_n >= 0 {
            k = k + 1
            continue
        }
        var pl = sstate.child(c, 0)
        var npat = sstate.nchild(pl)
        var i: i64 = 0
        while i < npat {
            var p = sstate.child(pl, i)
            var vr = p
            if s_tags[p] == N_CASE_BIND {
                vr = sstate.child(p, 0)
            }
            var vname = ""
            if s_tags[vr] == S_N_FIELD_ACCESS || s_tags[vr] == S_N_VAR {
                vname = sstate.name_str(vr)
            }
            if str_len(vname) > 0 {
                var t: i64 = -1
                var j: i64 = 0
                while j < nvar {
                    if intern.lookup(en_vnames[varoff + j]) == vname {
                        t = en_vtags[varoff + j]
                    }
                    j = j + 1
                }
                if t >= 0 {
                    table_push(covered, t)
                }
            }
            i = i + 1
        }
        k = k + 1
    }
    var m: i64 = 0
    while m < nvar {
        var found: bool = false
        var c2: i64 = 0
        while c2 < len(covered) {
            if covered[c2] == m {
                found = true
                break
            }
            c2 = c2 + 1
        }
        if !found {
            sm_err_line = s_lines[s]
            sm_err_col = s_cols[s]
            sm_err_msg = "switch 不穷尽：无 default 时须覆盖全部变体，缺少 '" + ename + "." + intern.lookup(en_vnames[varoff + m]) + "'"
            return -1
        }
        m = m + 1
    }
    return 0
}

// 语句检查
pub func check_stmt(s: i64) -> i64 {
    var tag = s_tags[s]
    if tag == S_N_STMTLIST {
        // 语句级宏（dev33 批次10 任务28）展开残留的嵌套 StmtList
        //（`$body` 插值块后）：逐语句检查（与 check_block 语义一致）。
        return check_block(s)
    }
    if tag == S_N_CODE_LIT {
        // 块形式 code 字面量（val=1）作语句：检查内部 StmtList。
        if s_vals[s] == 1 {
            var inner = sstate.child(s, 0)
            if inner >= 0 {
                return check_block(inner)
            }
            return 0
        }
        sm_err_line = s_lines[s]
        sm_err_col = s_cols[s]
        sm_err_msg = "code 字面量不能作为语句"
        return -1
    }
    if tag == S_N_UNSAFE_BLOCK {
        // S1.2 U3：unsafe 块 → 块内开启 unsafe 上下文（+1 深度）
        var saved2 = g_unsafe_depth
        g_unsafe_depth = g_unsafe_depth + 1
        var blk2 = sstate.child(s, 0)
        var r2: i64 = 0
        if blk2 >= 0 {
            warn_empty_block(blk2, s)
            r2 = check_cf_block(blk2, s)
        }
        g_unsafe_depth = saved2
        return r2
    }
    if tag == S_N_GUARD_USE {
        // 三期 A 组 `unsafe use g { ... }` 持证越界块（§7.1.1 + unsafe-model §13.4）：
        // 仅 unsafe 上下文合法；g 必须是 guard<cap> 类型变量（持证才能越界）。
        // 块内开启 unsafe 上下文（+1 深度）——凭据身份越界。
        if g_unsafe_depth == 0 {
            sm_err_line = s_lines[s]
            sm_err_col = s_cols[s]
            sm_err_msg = "unsafe use 只能在 unsafe 上下文使用（unsafe 块或 unsafe 函数内）"
            return -1
        }
        var gname = s_names[s]
        var gnid = gname   // s_names 已是 intern 池 id（N_GUARD_USE 解析时 intern）
        var gty = sinfer.lv_find(gnid)
        if gty < 0 {
            gty = sinfer.gb_find(gnid)
        }
        if gty < 0 || !types.is_guard(gty) {
            sm_err_line = s_lines[s]
            sm_err_col = s_cols[s]
            sm_err_msg = "unsafe use 的 '" + sstate.name_str(s) + "' 必须是 guard<cap> 凭据变量（来自 unsafe.get(share) 等）"
            return -1
        }
        var saved_u = g_unsafe_depth
        g_unsafe_depth = g_unsafe_depth + 1
        var body_u = sstate.child(s, 0)
        var r_u: i64 = 0
        if body_u >= 0 {
            warn_empty_block(body_u, s)
            r_u = check_cf_block(body_u, s)
        }
        g_unsafe_depth = saved_u
        return r_u
    }
    if tag == S_N_GUARD_WITH {
        // 三期 A 组 `unsafe with(share) { ... }` 临时凭据块（§7.1.1 + unsafe-model
        // §13.4）：仅 unsafe 上下文合法；块内创建临时 guard<cap>，退块自动回收。
        if g_unsafe_depth == 0 {
            sm_err_line = s_lines[s]
            sm_err_col = s_cols[s]
            sm_err_msg = "unsafe with 只能在 unsafe 上下文使用（unsafe 块或 unsafe 函数内）"
            return -1
        }
        var capn = sstate.name_str(sstate.child(s, 0))
        if capn != "share" && capn != "mem" && capn != "ext" {
            sm_err_line = s_lines[s]
            sm_err_col = s_cols[s]
            sm_err_msg = "unsafe with 的能力域必须是 share/mem/ext，实际是 '" + capn + "'"
            return -1
        }
        var saved_w = g_unsafe_depth
        g_unsafe_depth = g_unsafe_depth + 1
        var body_w = sstate.child(s, 1)
        var r_w: i64 = 0
        if body_w >= 0 {
            warn_empty_block(body_w, s)
            r_w = check_cf_block(body_w, s)
        }
        g_unsafe_depth = saved_w
        return r_w
    }
    if tag == S_N_PANIC {
        // S2.3：panic("消息") —— 消息必须是 string 表达式（可配置目标行为：
        // 桌面打印+退出 / 嵌入式 halt / wasm trap，irgen 按 target 发射）
        var msg = sstate.child(s, 0)
        var mt = sinfer.infer_expr(msg)
        if mt < 0 {
            return -1
        }
        if !stype.types_match(types.named(TK_STR), mt, msg) {
            sm_err_line = s_lines[s]
            sm_err_col = s_cols[s]
            sm_err_msg = "panic 消息必须是 string，实际是 " + types.type_name(mt)
            return -1
        }
        return 0
    }
    if tag == S_N_VAR_DECL {
        return check_var_decl(s)
    }
    if tag == S_N_EXPR_STMT {
        var e = sstate.child(s, 0)
        // 语句级宏（dev33 批次10 任务28）：`$body` 插值块形式 code 值后子节点
        // 可能是块形式 N_CODE_LIT（val=1）/嵌套 StmtList——按语句块检查，
        // 而非表达式推断（否则内部字面量不推断 → irgen 默认 i8 类型错）。
        if e >= 0 {
            var et = s_tags[e]
            if et == S_N_CODE_LIT && s_vals[e] == 1 {
                var inner = sstate.child(e, 0)
                if inner >= 0 {
                    return check_block(inner)
                }
                return 0
            }
            if et == S_N_STMTLIST {
                return check_block(e)
            }
        }
        var t = sinfer.infer_expr(e)
        if t < 0 {
            return -1
        }
        return 0
    }
    if tag == S_N_ASSIGN {
        var nm = sstate.name_str(s)
        var nid = intern.intern(nm)
        var target_ty = sinfer.lv_find(nid)
        var is_global: bool = false
        var gkey: i64 = -1
        if target_ty < 0 {
            // p.9.12.4：全局目标查带命名空间前缀补全（命名空间内 const 以
            // ns::NAME 全名登记 gb_*，函数体内裸名重赋值须命中该键才能走
            // const 只读拦截；命中键存 gkey 供 gb_const_of 查询）
            gkey = sinfer.gb_find_ns_key(nid)
            if gkey < 0 {
                sm_err_line = s_lines[s]
                sm_err_col = s_cols[s]
                sm_err_msg = "赋值目标 '" + nm + "' 未声明"
                return -1
            }
            target_ty = sinfer.gb_find(gkey)
            is_global = true
        }
        if is_global {
            if sinfer.gb_const_of(gkey) == 1 {
                sm_err_line = s_lines[s]
                sm_err_col = s_cols[s]
                sm_err_msg = "不能给 const 变量 '" + nm + "' 赋值"
                return -1
            }
            // W00016：全局可变表的（整体）重赋值写点
            w16_record(gkey, s_lines[s], s_cols[s])
        } else {
            if sinfer.lv_const_of(nid) == 1 {
                sm_err_line = s_lines[s]
                sm_err_col = s_cols[s]
                sm_err_msg = "不能给 const 变量 '" + nm + "' 赋值"
                return -1
            }
            // p.9.11.11 immut 只读形参：直接重写（= / += 等复合）拒绝。
            if sstate.im_is(nid) {
                sm_err_line = s_lines[s]
                sm_err_col = s_cols[s]
                sm_err_msg = "不能给 immut 形参 '" + nm + "' 赋值；immut 形参只读"
                return -1
            }
        }
        var vt = sinfer.infer_expr(sstate.child(s, 0))
        if vt < 0 {
            // S2.3 目标类型引导：泛型 enum 构造（Result.Err("x")）类型参数推断不全
            // 时（Err 不含 T，T 无法从实参推出），用赋值目标类型补全
            var sv_l = sm_err_line
            var sv_c = sm_err_col
            var sv_m = sm_err_msg
            var hv = sinfer.try_enum_construct_hinted(sstate.child(s, 0), target_ty)
            if hv >= 0 {
                sm_err_line = 0
                sm_err_col = 0
                sm_err_msg = ""
                vt = hv
            } else {
                if sm_err_msg == sv_m {
                    // 引导未命中（非泛型 enum 构造）：恢复原错误
                    sm_err_line = sv_l
                    sm_err_col = sv_c
                    sm_err_msg = sv_m
                }
                return -1
            }
        }
        // r.1.1.5：空表字面量赋值目标引导（与 check_var_decl 同款）——
        // `t = []` 若目标是 table<T>/map<V>，node_types[rhs] = 目标类型；
        // 否则 irgen 空表兜底 i64 元素宽，fn/struct 等复合元素 push 越界写崩溃
        //（全局 table<fn() -> i64> 惰性 = [] 重赋值缺陷根因）。
        var rhs_node = sstate.child(s, 0)
        if vt == types.named(TK_I64) && s_tags[rhs_node] == S_N_TABLE_LIT &&
            sstate.nchild(rhs_node) == 0 && (types.is_table(target_ty) || types.is_map(target_ty)) {
            node_types[rhs_node] = target_ty
        }
        // p.6.9.15 警告 W0003：循环内字符串拼接累积（+= 或 x = x + y）。
        // 仅限循环体内（len(lp_stack) > 0）——单次拼接无 O(n²) 风险。
        var op = s_vals[s]
        if op >= 0 {
            if op == 0 && target_ty == TK_STR && len(lp_stack) > 0 {
                sm_warn_add(s_lines[s], s_cols[s], "循环内字符串拼接累积（x = x + y 逐次整体复制，O(n²)）")
            }
        } else {
            if target_ty == TK_STR && len(lp_stack) > 0 {
                var rn = sstate.child(s, 0)
                if s_tags[rn] == S_N_BINARY && s_vals[rn] == 0 {
                    var c0 = sstate.child(rn, 0)
                    var c1 = sstate.child(rn, 1)
                    var self_ref: bool = false
                    if s_tags[c0] == S_N_VAR && sstate.name_str(c0) == nm {
                        self_ref = true
                    }
                    if s_tags[c1] == S_N_VAR && sstate.name_str(c1) == nm {
                        self_ref = true
                    }
                    if self_ref {
                        sm_warn_add(s_lines[s], s_cols[s], "循环内字符串拼接累积（x = x + y 逐次整体复制，O(n²)）")
                    }
                }
            }
        }
        // 复合赋值校验（对齐 Rust check_compound_assign，M4）：op >= 0 为复合
        if op >= 0 {
            // `+=` 对 string：value 必须 string（拼接）
            if op == 0 && target_ty == TK_STR {
                if !stype.types_match(target_ty, vt, sstate.child(s, 0)) {
                    sm_err_line = s_lines[s]
                    sm_err_col = s_cols[s]
                    sm_err_msg = "复合赋值类型不匹配：目标类型 " + types.type_name(target_ty) + " 与表达式 " + types.type_name(vt)
                    return -1
                }
                return 0
            }
            // `+=` `-=` `*=` `/=`：target 必须 number
            if op >= 0 && op <= 3 {
                if !types.is_number(target_ty) {
                    sm_err_line = s_lines[s]
                    sm_err_col = s_cols[s]
                    sm_err_msg = "复合赋值运算符不能用于 " + types.type_name(target_ty)
                    return -1
                }
                if !stype.types_match(target_ty, vt, sstate.child(s, 0)) {
                    sm_err_line = s_lines[s]
                    sm_err_col = s_cols[s]
                    sm_err_msg = "复合赋值类型不匹配：目标类型 " + types.type_name(target_ty) + " 与表达式 " + types.type_name(vt)
                    return -1
                }
                return 0
            }
            // `%=`：target 必须 int
            if op == 4 {
                if !types.is_int(target_ty) {
                    sm_err_line = s_lines[s]
                    sm_err_col = s_cols[s]
                    sm_err_msg = "复合赋值取模只支持整数，目标类型是 " + types.type_name(target_ty)
                    return -1
                }
                if !stype.types_match(target_ty, vt, sstate.child(s, 0)) {
                    sm_err_line = s_lines[s]
                    sm_err_col = s_cols[s]
                    sm_err_msg = "复合赋值类型不匹配：目标类型 " + types.type_name(target_ty) + " 与表达式 " + types.type_name(vt)
                    return -1
                }
                return 0
            }
            // 位运算复合 `&=` `|=` `^=` `<<=` `>>=`：target 必须 int
            if op >= 13 && op <= 17 {
                if !types.is_int(target_ty) {
                    sm_err_line = s_lines[s]
                    sm_err_col = s_cols[s]
                    sm_err_msg = "复合赋值位运算只支持整数，目标类型是 " + types.type_name(target_ty)
                    return -1
                }
                // r.1.4.3：`<<=`/`>>=` 编译期常量移位量越界/负 → 编译错误
                //（与 sinfer 二元移位同规则：0 ≤ 常量移位量 < 目标位宽）。
                if op == 16 || op == 17 {
                    var sc2 = sstate.child(s, 0)
                    var cnt2: i64 = 0
                    var is_const2: bool = false
                    if s_tags[sc2] == S_N_INT_LIT {
                        cnt2 = s_vals[sc2]
                        is_const2 = true
                    } else if s_tags[sc2] == S_N_UNARY && s_vals[sc2] == 0 {
                        var oc2 = sstate.child(sc2, 0)
                        if s_tags[oc2] == S_N_INT_LIT {
                            cnt2 = 0 - s_vals[oc2]
                            is_const2 = true
                        }
                    }
                    if is_const2 {
                        var w2 = stype.int_width(target_ty)
                        if w2 > 0 && (cnt2 < 0 || cnt2 >= w2) {
                            sm_err_line = s_lines[s]
                            sm_err_col = s_cols[s]
                            sm_err_msg = "移位量超出操作数位宽（" + to_string(w2) + " 位，当前 " + to_string(cnt2) + "）"
                            return -1
                        }
                    }
                }
                if !stype.types_match(target_ty, vt, sstate.child(s, 0)) {
                    sm_err_line = s_lines[s]
                    sm_err_col = s_cols[s]
                    sm_err_msg = "复合赋值类型不匹配：目标类型 " + types.type_name(target_ty) + " 与表达式 " + types.type_name(vt)
                    return -1
                }
                return 0
            }
        }
        if !stype.types_compatible(target_ty, vt) && !stype.types_match(target_ty, vt, sstate.child(s, 0)) &&
            !stype.types_narrow_int(target_ty, vt, sstate.child(s, 0)) {
            sm_err_line = s_lines[s]
            sm_err_col = s_cols[s]
            sm_err_msg = "赋值类型不匹配：变量 '" + nm + "' 类型为 " + types.type_name(target_ty) + "，表达式为 " + types.type_name(vt)
            return -1
        }
        return 0
    }
    if tag == S_N_RETURN {
        var v = sstate.child(s, 0)
        if v >= 0 {
            // p.9.11.15 生成器函数禁止带值 return（产出走 yield；`return;`
            // 无值提前结束）。闭包体内 return 不受此限（闭包非生成器）。
            if g_clo_ret_top == 0 && sstate.is_gen(g_curfn) == 1 {
                sm_err_line = s_lines[s]
                sm_err_col = s_cols[s]
                sm_err_msg = "生成器函数不允许带值 return（产出请用 yield；`return;` 可提前结束）"
                return -1
            }
            var vt = sinfer.infer_expr(v)
            if vt < 0 {
// S2.3 目标类型引导：return 泛型 enum 构造时类型参数推断不全，
            // 用函数返回类型补全（如 return Result.Err("bad") 于 Result<i64,string>）
            // S2.2 闭包：闭包体内用闭包返回类型（g_clo_ret_stack 栈顶）替代
            var h_ret = sg_ret[g_curfn]
            if g_clo_ret_top > 0 {
                h_ret = g_clo_ret_stack[g_clo_ret_top - 1]
            }
            var rv_l = sm_err_line
            var rv_c = sm_err_col
            var rv_m = sm_err_msg
            var hv = sinfer.try_enum_construct_hinted(v, h_ret)
                if hv >= 0 {
                    sm_err_line = 0
                    sm_err_col = 0
                    sm_err_msg = ""
                    vt = hv
                } else {
                    if sm_err_msg == rv_m {
                        sm_err_line = rv_l
                        sm_err_col = rv_c
                        sm_err_msg = rv_m
                    }
                    return -1
                }
            }
            var ret_ty = sg_ret[g_curfn]
            // S2.2 闭包：闭包体内 return 类型基准用闭包返回类型（栈顶）
            if g_clo_ret_top > 0 {
                ret_ty = g_clo_ret_stack[g_clo_ret_top - 1]
            }
            if !stype.types_compatible(ret_ty, vt) && !stype.types_match(ret_ty, vt, v) {
                sm_err_line = s_lines[s]
                sm_err_col = s_cols[s]
                sm_err_msg = "return 类型不匹配：函数返回 " + types.type_name(ret_ty) + "，实际返回 " + types.type_name(vt)
                return -1
            }
        }
        return 0
    }
    // p.9.11.15 yield 生成器产出语句：仅具名函数体内合法（闭包内禁止——生成器
    // = 具名函数，闭包无独立产出通道）；产出值类型须与生成器声明返回类型
    // （签名 = table<elem>）的元素兼容。生成器标记由 scollect.collect_fn
    // 在收集阶段完成（含 yield → 签名返回类型 = table<elem>）。
    if tag == S_N_YIELD {
        if g_clo_ret_top > 0 {
            sm_err_line = s_lines[s]
            sm_err_col = s_cols[s]
            sm_err_msg = "yield 只能在生成器函数（具名函数）体内使用，闭包内不允许"
            return -1
        }
        if g_curfn < 0 {
            sm_err_line = s_lines[s]
            sm_err_col = s_cols[s]
            sm_err_msg = "yield 只能在生成器函数体内使用（函数体内声明 `-> 元素类型`）"
            return -1
        }
        var yv = sstate.child(s, 0)
        var yt = sinfer.infer_expr(yv)
        if yt < 0 {
            return -1
        }
        var yret = sg_ret[g_curfn]   // 生成器签名返回类型 = table<elem>
        var yelem: i64 = types.named(TK_I64)
        if types.is_table(yret) {
            var ye2 = types.table_elem(yret)
            if ye2 >= 0 {
                yelem = ye2
            }
        }
        if !stype.types_compatible(yelem, yt) && !stype.types_match(yelem, yt, yv) &&
            !stype.types_narrow_int(yelem, yt, yv) {
            sm_err_line = s_lines[s]
            sm_err_col = s_cols[s]
            sm_err_msg = "yield 值类型不匹配：生成器产出元素类型 " + types.type_name(yelem) + "，实际 " + types.type_name(yt)
            return -1
        }
        return 0
    }
    if tag == S_N_IF {
        var cond = sinfer.infer_expr(sstate.child(s, 0))
        if cond < 0 {
            return -1
        }
        if !types.is_bool_like(cond) {
            sm_err_line = s_lines[s]
            sm_err_col = s_cols[s]
            sm_err_msg = "if 条件必须是 bool"
            return -1
        }
        // p.6.9.15 警告 W0006/W0007：if 条件为布尔常量（恒真/恒假）
        var cond_node = sstate.child(s, 0)
        if s_tags[cond_node] == S_N_BOOL_LIT {
            if s_vals[cond_node] == 0 {
                sm_warn_add(s_lines[s], s_cols[s], "条件恒假（if/while 条件为常量 0/false）")
            } else {
                sm_warn_add(s_lines[s], s_cols[s], "条件恒真（if/while 条件为常量 true/非零值）")
            }
        }
        var then_blk = sstate.child(s, 1)
        warn_empty_block(then_blk, s)
        var r = check_cf_block(then_blk, s)
        if r < 0 {
            return -1
        }
        var els = sstate.child(s, 2)
        // 注意：`if` 无 else 时 els 不是 -1 而是空 StmtList（nchild==0），
        // 仅判 els >= 0 会把"没有 else"误报成空语句块。故要求 if 实际
        // 有第三个子节点才检查。
        if els >= 0 && sstate.nchild(s) > 2 {
            warn_empty_block(els, s)
            r = check_cf_block(els, s)
            if r < 0 {
                return -1
            }
        }
        return 0
    }
    // p.8.2.11 guard else 早退：children=[cond, else_list]，语义等价 if not(cond)
    // { else_list }。约束：else 块必须以跳转语句收尾（否则 guard 退化为 if，
    // 前置检查失去"不再继续"的语义）。
    if tag == S_N_GUARD_STMT {
        var gcond = sinfer.infer_expr(sstate.child(s, 0))
        if gcond < 0 {
            return -1
        }
        if !types.is_bool_like(gcond) {
            sm_err_line = s_lines[s]
            sm_err_col = s_cols[s]
            sm_err_msg = "guard 条件必须是 bool"
            return -1
        }
        var gbody = sstate.child(s, 1)
        warn_empty_block(gbody, s)
        var gr = check_cf_block(gbody, s)
        if gr < 0 {
            return -1
        }
        if !guard_else_ends_in_jump(gbody) {
            sm_err_line = s_lines[s]
            sm_err_col = s_cols[s]
            sm_err_msg = "guard 的 else 块必须以跳转语句（return/break/continue/goto/panic）收尾，否则 guard 退化为 if"
            return -1
        }
        return 0
    }
    if tag == S_N_DEFER {
        // p.9.11.4 defer 资源释放语句：检查块内容 + 约束（禁 return/break/
        // continue/goto/panic/嵌套 defer/yield，仅允许表达式与赋值/读变量）。
        return check_defer(s)
    }
    if tag == S_N_WHILE {
        var cond = sinfer.infer_expr(sstate.child(s, 0))
        if cond < 0 {
            return -1
        }
        if !types.is_bool_like(cond) && !types.is_number(cond) {
            sm_err_line = s_lines[s]
            sm_err_col = s_cols[s]
            sm_err_msg = "while 条件必须是 bool"
            return -1
        }
        // p.6.9.15 警告 W0006/W0007：while 条件为常量（布尔/整数字面量，恒真/恒假）
        var wcond_node = sstate.child(s, 0)
        var wval: i64 = -1
        var wconst: bool = false
        if s_tags[wcond_node] == S_N_BOOL_LIT {
            wconst = true
            wval = s_vals[wcond_node]
        } else if s_tags[wcond_node] == S_N_INT_LIT {
            wconst = true
            wval = s_vals[wcond_node]
        }
        if wconst {
            if wval == 0 {
                sm_warn_add(s_lines[s], s_cols[s], "条件恒假（if/while 条件为常量 0/false）")
            } else {
                sm_warn_add(s_lines[s], s_cols[s], "条件恒真（if/while 条件为常量 true/非零值）")
            }
        }
        var lbl = s_names[s]
        // 逻辑压栈：复用槽位（lp_stack 表不截断，lp_top 游标定位）
        if lp_top < len(lp_stack) {
            lp_stack[lp_top] = lbl
        } else {
            table_push(lp_stack, lbl)
        }
        lp_top = lp_top + 1
        var wbody = sstate.child(s, 1)
        warn_empty_block(wbody, s)
        var r = check_cf_block(wbody, s)
        lp_top = lp_top - 1
        if r < 0 {
            return -1
        }
        return 0
    }
    if tag == S_N_FOR {
        var vname = sstate.name_str(s)
        var vnid = intern.intern(vname)
        var iter = sstate.child(s, 0)
        var it = sinfer.infer_expr(iter)
        if it < 0 {
            return -1
        }
        var elem_ty: i64 = types.named(TK_I64)
        // 字符串码点迭代器：`for c in s.chars()`（dev33 批次4 语法糖）。
        // 循环变量元素类型 = 单字符 string；须先于 is_table 分支（iter 的
        // 推断类型也是 string，但 is_table(string)=false 不影响）。
        if it == types.named(TK_STR) && is_chars_iter(iter) {
            elem_ty = types.named(TK_STR)
        } else if types.is_table(it) {
            var te = types.table_elem(it)
            if te >= 0 {
                elem_ty = te
            } else {
                if s_tags[iter] == S_N_VAR {
                    var itname = sstate.name_str(iter)
                    var itnid = intern.intern(itname)
                    var vte = sinfer.var_table_elem(itnid)
                    if vte >= 0 {
                        elem_ty = vte
                    }
                }
            }
        } else if types.is_int(it) {
            elem_ty = types.named(TK_I64)
        } else {
            // p.9.11.16 迭代器协议对象（struct 实现 has_next/next）：循环变量
            // 元素类型 = next 返回类型。协议探测失败 → 报错（消息含协议提示）。
            var ip_e = sinfer.iter_proto_elem(it)
            if ip_e >= 0 {
                elem_ty = ip_e
            } else {
                sm_err_line = s_lines[s]
                sm_err_col = s_cols[s]
                sm_err_msg = "for 迭代对象仅支持范围（0..10）、表变量或迭代器协议对象（struct 实现 has_next/next），实际是 " + types.type_name(it)
                return -1
            }
        }
        // W00008 / W00005：for 迭代变量重名判定（覆盖语义）
        decl_warn(vnid, s_lines[s], s_cols[s])
        // for 迭代变量：lv_insert 已实现覆盖
        sinfer.lv_insert(vnid, elem_ty, 0, -1, 0)
        var lbl = s_aux[s]
        // 逻辑压栈：复用槽位
        if lp_top < len(lp_stack) {
            lp_stack[lp_top] = lbl
        } else {
            table_push(lp_stack, lbl)
        }
        lp_top = lp_top + 1
        var fbody = sstate.child(s, 1)
        // W00013：for 遍历表时修改表（循环体内对该表追加/删除元素，
        // 使遍历结果不可预期）。迭代对象名为空（如范围 0..10）则跳过。
        // p.9.14.2：mod_walk 是每个 for 的一次全子树递归（嵌套 for 下退化），
        // 仅当警告 pass 启用才执行。
        if semantic.sm_warn_enabled() {
            var w13_nm = sstate.name_str(sstate.child(s, 0))
            if len(w13_nm) > 0 {
                if mod_walk(fbody, w13_nm) == 1 {
                    sm_warn_add(s_lines[s], s_cols[s], "for 遍历表时修改表（循环体内追加/删除元素）")
                }
            }
        }
        warn_empty_block(fbody, s)
        var r = check_cf_block(fbody, s)
        lp_top = lp_top - 1
        if r < 0 {
            return -1
        }
        return 0
    }
    if tag == S_N_BREAK || tag == S_N_CONTINUE {
        if lp_top == 0 {
            var kw = "break"
            if tag == S_N_CONTINUE {
                kw = "continue"
            }
            sm_err_line = s_lines[s]
            sm_err_col = s_cols[s]
            sm_err_msg = kw + " 只能出现在循环体内"
            return -1
        }
        var lbl = s_names[s]
        if lbl >= 0 {
            var found: bool = false
            var i: i64 = lp_top - 1
            while i >= 0 {
                if lp_stack[i] == lbl {
                    found = true
                    break
                }
                i = i - 1
            }
            if !found {
                var kw = "break"
                if tag == S_N_CONTINUE {
                    kw = "continue"
                }
                sm_err_line = s_lines[s]
                sm_err_col = s_cols[s]
                sm_err_msg = kw + " 的标签 '" + intern.lookup(lbl) + "' 未匹配任何外层循环"
                return -1
            }
        }
        return 0
    }
    if tag == S_N_GOTO_LABEL {
        // 三期 goto 标签（§7.1.5）：`#[tag.x]` 语句位置登记。
        // 登记标签名 → 当前块链/块内序号/全局序号（R2/R3 校验用）。
        var lnm = s_names[s]
        var dup = gt_find(lnm)
        if dup >= 0 {
            sm_err_line = s_lines[s]
            sm_err_col = s_cols[s]
            sm_err_msg = "goto 标签 '#" + intern.lookup(lnm) + "' 重复定义（同函数内标签名必须唯一）"
            return -1
        }
        table_push(g_gt_keys, lnm)
        table_push(g_gt_chain, g_cur_chain)
        table_push(g_gt_blkidx, g_cur_blkidx)
        table_push(g_gt_seq, g_gt_seq_cnt)
        table_push(g_gt_depths, g_cur_depth)
        table_push(g_gt_blknode, g_cur_blknode)
        return 0
    }
    if tag == S_N_GOTO {
        // 三期 goto 语句（§7.1.5）：`unsafe goto #x`。goto 仅在 unsafe 上下文合法。
        // 校验延迟到函数体检查完（标签可能在前向/后向任意位置，须全表收集后统一
        // 判定 R1/R2/R3）；此处仅做 unsafe 上下文检查 + 登记 goto 请求。
        if g_unsafe_depth == 0 {
            sm_err_line = s_lines[s]
            sm_err_col = s_cols[s]
            sm_err_msg = "goto 只能在 unsafe 上下文使用（unsafe 块或 unsafe 函数内）"
            return -1
        }
        table_push(g_gtg_keys, s_names[s])
        table_push(g_gtg_chain, g_cur_chain)
        table_push(g_gtg_blkidx, g_cur_blkidx)
        table_push(g_gtg_seq, g_gt_seq_cnt)
        table_push(g_gtg_line, s_lines[s])
        table_push(g_gtg_col, s_cols[s])
        return 0
    }
    if tag == S_N_SWITCH {
        var subj = sinfer.infer_expr(sstate.child(s, 0))
        if subj < 0 {
            return -1
        }
        // P2b：switch 对象新增 any 动态类型（case 类型匹配，见 check_switch_case）
        if !types.is_number(subj) && !types.is_bool_like(subj) && subj != TK_STR && subj != TK_CHAR && types.kind(subj) != K_ENUM && subj != types.named(TK_ANY) {
            sm_err_line = s_lines[s]
            sm_err_col = s_cols[s]
            sm_err_msg = "switch 对象仅支持数字、布尔、字符、字符串、枚举或 any 类型，实际是 " + types.type_name(subj)
            return -1
        }
        var ncases = s_aux[s]
        var i: i64 = 0
        // 重置 case 去重表（每个 switch 独立）
        g_case_seen = table_new_string()
        while i < ncases {
            var c = sstate.child(s, 1 + i)
            var r = check_switch_case(c, subj)
            if r < 0 {
                return -1
            }
            i = i + 1
        }
        var dflt = sstate.child(s, 1 + ncases)
        // 无 default：parser 对缺省 default 生成**空 StmtList** 节点（nchild==0）
        var has_default: bool = dflt >= 0 && sstate.nchild(dflt) > 0
        if has_default {
            var r = check_cf_block(dflt, s)
            if r < 0 {
                return -1
            }
        } else if types.kind(subj) == K_ENUM {
            // p.8.1.4 穷尽检查：无 default 的 enum switch 必须覆盖全部变体
            //（带 when 守卫的 case 不视为穷尽——守卫可能失败，对齐 Rust 语义）
            var r = check_enum_exhaustive(subj, s)
            if r < 0 {
                return -1
            }
        } else {
            // W00028：switch 无 default 且非 enum（enum 已有穷尽检查兜底，不重复报）。
            // 未匹配任何 case 时静默无操作，通常是漏写 default。
            sm_warn_add(s_lines[s], s_cols[s], "switch 缺少 default（未匹配值时静默无操作）")
        }
        return 0
    }
    if tag == S_N_FIELD_ASSIGN {
        var base = sinfer.infer_expr(sstate.child(s, 0))
        if base < 0 {
            return -1
        }
        // p.9.11.11 immut 只读形参：字段写（t.k = v）目标根变量为 immut 形参 → 拒绝
        //（覆盖 struct/tuple 接收者；计算属性 setter 亦属内容写，一并拒绝）。
        var froot = sstate.im_root(sstate.child(s, 0))
        if froot >= 0 && sstate.im_is(froot) {
            sm_err_line = s_lines[s]
            sm_err_col = s_cols[s]
            sm_err_msg = "不能修改 immut 形参 '" + sstate.im_name(froot) + "' 的字段；immut 形参只读"
            return -1
        }
        var fnm = sstate.name_str(s)
        var bk = types.kind(base)
        if bk != K_STRUCT && bk != K_TUPLE {
            sm_err_line = s_lines[s]
            sm_err_col = s_cols[s]
            sm_err_msg = "字段赋值的对象必须是 struct 实例，实际是 " + types.type_name(base)
            return -1
        }
        if bk == K_STRUCT {
            var si = types.low(base)
            var off = cls_fldoff[si]
            var cnt = cls_nfld[si]
            var found: bool = false
            var ft: i64 = -1
            var i: i64 = 0
            while i < cnt {
                if intern.lookup(fld_names[off + i]) == fnm {
                    found = true
                    ft = fld_tys[off + i]
                    break
                }
                i = i + 1
            }
            if !found {
                // p.8.2.7 计算属性写：命中 setter（<Struct>::<name>_set，接收者+新值）
                // → 校验 setter 参数并登记 g_cmp_setter，供 irgen 发射 setter 调用。
                var sname = sstate.struct_name_of(si)
                var setfull = sname + "::" + fnm + "_set"
                var ssig = sstate.fn_sig(setfull)
                if ssig >= 0 {
                    var srec = sp_tys[sg_off[ssig]]
                    if !stype.types_compatible(srec, base) {
                        sm_err_line = s_lines[s]
                        sm_err_col = s_cols[s]
                        sm_err_msg = "计算属性 setter '" + setfull + "' 接收者类型不匹配：期望 " + types.type_name(srec) + "，实际 " + types.type_name(base)
                        return -1
                    }
                    if sg_nparams[ssig] != 2 {
                        sm_err_line = s_lines[s]
                        sm_err_col = s_cols[s]
                        sm_err_msg = "计算属性 setter '" + setfull + "' 必须恰好 2 个参数（接收者 + 新值），实际 " + to_string(sg_nparams[ssig]) + " 个"
                        return -1
                    }
                    var want_v = sp_tys[sg_off[ssig] + 1]
                    var vt = sinfer.infer_expr(sstate.child(s, 1))
                    if vt < 0 {
                        return -1
                    }
                    if !stype.types_compatible(want_v, vt) && !stype.types_match(want_v, vt, sstate.child(s, 1)) {
                        sm_err_line = s_lines[s]
                        sm_err_col = s_cols[s]
                        sm_err_msg = "计算属性 setter '" + setfull + "' 参数类型不匹配：期望 " + types.type_name(want_v) + "，实际 " + types.type_name(vt)
                        return -1
                    }
                    g_cmp_setter[s] = interner.intern(setfull)
                    return 0
                }
                sm_err_line = s_lines[s]
                sm_err_col = s_cols[s]
                sm_err_msg = "类 '" + sname + "' 没有字段 '" + fnm + "'"
                return -1
            }
            var vt = sinfer.infer_expr(sstate.child(s, 1))
            if vt < 0 {
                return -1
            }
            if !stype.types_compatible(ft, vt) && !stype.types_match(ft, vt, sstate.child(s, 1)) {
                sm_err_line = s_lines[s]
                sm_err_col = s_cols[s]
                sm_err_msg = "字段赋值类型不匹配：期望 " + types.type_name(ft) + "，实际 " + types.type_name(vt)
                return -1
            }
        }
        return 0
    }
    if tag == S_N_INDEX_ASSIGN {
        // 目标必须是下标表达式 t[i]（Index 节点）
        var target = sstate.child(s, 0)
        if s_tags[target] != S_N_INDEX {
            sm_err_line = s_lines[s]
            sm_err_col = s_cols[s]
            sm_err_msg = "下标赋值的目标必须是表元素访问（t[i]）"
            return -1
        }
        var base_node = sstate.child(target, 0)
        var idx_node = sstate.child(target, 1)
        // p.9.11.11 immut 只读形参：下标写（t[i] = v）目标根变量为 immut 形参 → 拒绝
        //（覆盖表元素写与字符串下标写；immut 限定「容器内容写」一并拒绝）。
        var iroot = sstate.im_root(base_node)
        if iroot >= 0 && sstate.im_is(iroot) {
            sm_err_line = s_lines[s]
            sm_err_col = s_cols[s]
            sm_err_msg = "不能修改 immut 形参 '" + sstate.im_name(iroot) + "' 的下标元素；immut 形参只读"
            return -1
        }
        // W00016：全局可变表的下标写点（根变量非局部 → 按全局键解析后登记）
        if iroot >= 0 && sinfer.lv_find(iroot) < 0 {
            var gk16 = sinfer.gb_find_ns_key(iroot)
            if gk16 >= 0 {
                w16_record(gk16, s_lines[s], s_cols[s])
            }
        }
        var base = sinfer.infer_expr(base_node)
        if base < 0 {
            return -1
        }
        var idx = sinfer.infer_expr(idx_node)
        if idx < 0 {
            return -1
        }
        var vt = sinfer.infer_expr(sstate.child(s, 1))
        if vt < 0 {
            return -1
        }
        if !types.is_table(base) && base != TK_STR && !types.is_array(base) {
            sm_err_line = s_lines[s]
            sm_err_col = s_cols[s]
            sm_err_msg = "下标赋值的对象必须是表，实际是 " + types.type_name(base)
            return -1
        }
        // 下标类型：map 键值表允许字符串键（E3：m["key"] = v → tie_map_set_string）
        // 与整数键；普通表下标必须是整数
        if !types.is_map(base) {
            if !types.is_int(idx) {
                sm_err_line = s_lines[s]
                sm_err_col = s_cols[s]
                sm_err_msg = "下标必须是整数，实际是 " + types.type_name(idx)
                return -1
            }
        }
        // L1 定长数组写：编译期常量越界检查 + 值类型须与元素类型匹配
        //（LLVM store 是类型化 store，类型不符会在 llvmgen/opt 报错前崩溃）。
        if types.is_array(base) {
            var elem_a = types.array_elem(base)
            if !stype.types_match(elem_a, vt, sstate.child(s, 1)) && !stype.types_compatible(elem_a, vt) {
                sm_err_line = s_lines[s]
                sm_err_col = s_cols[s]
                sm_err_msg = "数组元素赋值类型不匹配：期望 " + types.type_name(elem_a) + "，实际 " + types.type_name(vt)
                return -1
            }
            var (ciw, cvw) = stype.arr_const_index(idx_node)
            if ciw {
                if cvw < 0 {
                    sm_err_line = s_lines[s]
                    sm_err_col = s_cols[s]
                    sm_err_msg = "数组下标越界：索引为负数"
                    return -1
                }
                if cvw >= types.array_len(base) {
                    sm_err_line = s_lines[s]
                    sm_err_col = s_cols[s]
                    sm_err_msg = "数组下标越界：索引 " + to_string(cvw) + " ≥ 长度 " + to_string(types.array_len(base))
                    return -1
                }
            }
        }
        return 0
    }
    if tag == S_N_IMPORT || tag == S_N_USING || tag == S_N_NAMESPACE || tag == S_N_STRUCT || tag == S_N_ENUM || tag == S_N_FN_DEF || tag == S_N_EXTERN {
        sm_err_line = s_lines[s]
        sm_err_col = s_cols[s]
        sm_err_msg = "语句只能出现在文件顶层"
        return -1
    }
    return 0
}

// 变量声明检查（函数内）
pub func check_var_decl(s: i64) -> i64 {
    var nm = sstate.name_str(s)
    var nid = intern.intern(nm)
    var is_const = s_vals[s]
    // 重复声明对齐 Rust 版：不报错（scope.insert 覆盖语义）
    var ty_node = sstate.child(s, 0)
    var init = sstate.child(s, 1)
    if ty_node >= 0 {
        var ty = sgen.parse_generic_type_node(ty_node)
        if ty < 0 {
            return -1
        }
        // S2.4 port 对象变量：`var d: Drawable = button`（提升）或
        // `var d2: Drawable = d`（port 拷贝）。提升 = 取 data 地址 + 打包
        // vtable（借用语义归 unsafe，docs/plans/port-model.md §4.5）：
        //   - 提升（struct → port）必须在 unsafe 上下文
        //   - port → port 拷贝无新借用，安全代码允许
        if types.kind(ty) == K_PORT {
            if init < 0 {
                sm_err_line = s_lines[s]
                sm_err_col = s_cols[s]
                sm_err_msg = "port 对象变量 '" + nm + "' 必须初始化（如 unsafe { var " + nm + ": " + types.type_name(ty) + " = 具体实例 }）"
                return -1
            }
            var it_p = sinfer.infer_expr(init)
            if it_p < 0 {
                return -1
            }
            if types.kind(it_p) == K_STRUCT {
                // 提升：必须在 unsafe 上下文（借用语义归 unsafe）
                if g_unsafe_depth == 0 {
                    sm_err_line = s_lines[s]
                    sm_err_col = s_cols[s]
                    sm_err_msg = "提升 '" + types.type_name(it_p) + "' 到 port '" + types.type_name(ty) + "' 必须在 unsafe 块或 unsafe 函数中（接口对象借用具体对象，指针操作归 unsafe）"
                    return -1
                }
                var pi_l = types.low(ty)
                if !stype.impl_has_ty(pi_l, it_p) {
                    sm_err_line = s_lines[s]
                    sm_err_col = s_cols[s]
                    if sstate.port_is_iface(pi_l) {
                        // p.9.11.21 interface 提升不满足：定位第一个违规方法
                        var vio2 = stype.iface_first_violation(pi_l, it_p)
                        if vio2 >= 0 {
                            var vname2 = sstate.port_method_name(pi_l, vio2)
                            if stype.iface_vio_missing() {
                                sm_err_msg = "类型 '" + types.type_name(it_p) + "' 未实现 interface '" + types.type_name(ty) + "'，不能提升（缺少方法 '" + vname2 + "'）"
                            } else {
                                sm_err_msg = "类型 '" + types.type_name(it_p) + "' 未实现 interface '" + types.type_name(ty) + "'，不能提升（方法 '" + vname2 + "' 签名不匹配）"
                            }
                        } else {
                            sm_err_msg = "类型 '" + types.type_name(it_p) + "' 未实现 interface '" + types.type_name(ty) + "'，不能提升"
                        }
                    } else {
                        sm_err_msg = "类型 '" + types.type_name(it_p) + "' 未实现 port '" + types.type_name(ty) + "'，不能提升（请先写 impl " + types.type_name(ty) + " for " + types.type_name(it_p) + "）"
                    }
                    return -1
                }
            } else if types.kind(it_p) == K_PORT {
                // port → port 拷贝（指针拷贝，无新借用）
                if it_p != ty {
                    sm_err_line = s_lines[s]
                    sm_err_col = s_cols[s]
                    sm_err_msg = "port 对象变量 '" + nm + "' 类型不匹配：标注 " + types.type_name(ty) + "，表达式推导为 " + types.type_name(it_p)
                    return -1
                }
            } else {
                sm_err_line = s_lines[s]
                sm_err_col = s_cols[s]
                sm_err_msg = "port 对象变量 '" + nm + "' 的初始化必须是实现了该 port 的具体类型实例（提升）或同 port 对象，实际是 " + types.type_name(it_p)
                return -1
            }
            // W00008 / W00005：同名变量再次声明（作用域覆盖语义，后者遮蔽前者）
            decl_warn(nid, s_lines[s], s_cols[s])
            // 登记局部变量（port 对象 = ptr 槽）
            sinfer.lv_insert(nid, ty, is_const, -1, 0)
            return 0
        }
        // S1.2 S1 指针全归 unsafe：安全代码不能声明指针/切片/原子类型变量
        if types.is_unsafe_ty(ty) && g_unsafe_depth == 0 {
            sm_err_line = s_lines[s]
            sm_err_col = s_cols[s]
            sm_err_msg = "变量 '" + nm + "' 的指针/切片/原子类型 '" + types.type_name(ty) + "' 只能在 unsafe 代码中使用"
            return -1
        }
        // S3.3：code 类型只能在宏函数体内使用（编译期值，运行期无表示）。
        // 宏体不经过语义检查（interp 编译期执行），此检查拦截普通函数里的
        // code 变量/参数（含展开残留的准引用）。
        if ty == types.named(TK_CODE) {
            sm_err_line = s_lines[s]
            sm_err_col = s_cols[s]
            sm_err_msg = "code 类型值只能在宏函数体内使用（宏 = 编译期 AST→AST 函数；准引用/插值/宏参数都是编译期构造）"
            return -1
        }
        var it: i64 = -1
        if init >= 0 {
            it = sinfer.infer_expr(init)
            if it < 0 {
                // S2.3 目标类型引导：`var b: Result<i64, string> = Result.Err("bad")`
                // 泛型 enum 构造类型参数推断不全时，用标注类型补全
                var d_l = sm_err_line
                var d_c = sm_err_col
                var d_m = sm_err_msg
                var hv = sinfer.try_enum_construct_hinted(init, ty)
                if hv >= 0 {
                    sm_err_line = 0
                    sm_err_col = 0
                    sm_err_msg = ""
                    it = hv
                } else {
                    if sm_err_msg == d_m {
                        sm_err_line = d_l
                        sm_err_col = d_c
                        sm_err_msg = d_m
                    }
                    return -1
                }
            }
        }
        // 空表/空 map 字面量目标引导：`var em: map = []` / `var t: table = []`。
        // 空 [] 无元素，infer_expr 兜底 i64（无法区分 table/map），由标注类型
        // 定型：node_types[init] = ty 供 irgen gen_table_lit 选择句柄
        // （map → esz=16 / table → esz=8），it = ty 使下方类型匹配放行。
        if it == types.named(TK_I64) && s_tags[init] == S_N_TABLE_LIT &&
            sstate.nchild(init) == 0 && (types.is_table(ty) || types.is_map(ty)) {
            node_types[init] = ty
            it = ty
        }
        var telem: i64 = -1
        var dyn: i64 = 0
        if types.is_table(ty) {
            if init >= 0 {
                var itag = s_tags[init]
                if itag == S_N_TABLE_LIT {
                    telem = types.table_elem(it)
                    if telem < 0 {
                        telem = types.named(TK_I64)
                    }
                } else if itag == S_N_CALL {
                    var fnm = sstate.name_str(init)
                    if fnm == "table_new_i64" {
                        telem = types.named(TK_I64)
                    } else if fnm == "table_new_f64" {
                        telem = types.named(TK_F64)
                    } else if fnm == "table_new_string" {
                        telem = types.named(TK_STR)
                    } else if fnm == "table_new_bool" {
                        telem = types.named(TK_BOOL)
                    } else {
                        // 用解析后全名查返回表元素
                        var te2 = sinfer.table_ret_elem(sinfer.resolve_call_name(fnm))
                        if te2 >= 0 {
                            telem = te2
                        }
                    }
                    dyn = 1
                } else if itag == S_N_VAR {
                    var iname = sstate.name_str(init)
                    var inid = intern.intern(iname)
                    var vte = sinfer.var_table_elem(inid)
                    if vte >= 0 {
                        telem = vte
                    }
                    if sinfer.var_dyn(inid) == 1 {
                        dyn = 1
                    }
                    // p.6.9.15 警告 W0004：`var b = a` 拷贝动态表变量 → 引用共享
                    if iname != nm && sinfer.var_dyn(inid) == 1 {
                        sm_warn_add(s_lines[s], s_cols[s], "表变量拷贝共享底层数组（var b = a 后 b 的修改会反映到 a）")
                    }
                }
            } else {
                var te3 = types.table_elem(ty)
                if te3 >= 0 {
                    telem = te3
                }
                dyn = 1
            }
        }
        if init >= 0 {
            if !stype.types_match(ty, it, init) && !stype.types_compatible(ty, it) &&
                !stype.types_narrow_int(ty, it, init) {
                sm_err_line = s_lines[s]
                sm_err_col = s_cols[s]
                if types.kind(ty) == K_ARRAY && s_tags[init] == S_N_TABLE_LIT {
                    sm_err_msg = "变量 '" + nm + "' 类型不匹配：标注 " + types.type_name(ty) + "；数组字面量元素个数必须为 " + to_string(types.array_len(ty)) + "（实际 " + to_string(sstate.nchild(init)) + "），且元素类型必须与 " + types.type_name(types.array_elem(ty)) + " 一致"
                } else {
                    sm_err_msg = "变量 '" + nm + "' 类型不匹配：标注 " + types.type_name(ty) + "，表达式推导为 " + types.type_name(it)
                }
                return -1
            }
        }
        // W00008 / W00005：同名变量再次声明（作用域覆盖语义，后者遮蔽前者）
        decl_warn(nid, s_lines[s], s_cols[s])
        sinfer.lv_insert(nid, ty, is_const, telem, dyn)
        // S2.2 闭包：闭包体内声明的局部登记到当前闭包局部段（捕获遮蔽判定用）
        if g_clo_depth > 0 && g_clo_cur >= 0 {
            table_push(cl_locals, nid)
        }
        return 0
    }
    if init < 0 {
        sm_err_line = s_lines[s]
        sm_err_col = s_cols[s]
        sm_err_msg = "变量 '" + nm + "' 必须标注类型或初始化"
        return -1
    }
    var it2 = sinfer.infer_expr(init)
    if it2 < 0 {
        return -1
    }
    var telem2: i64 = -1
    var dyn2: i64 = 0
    if types.is_table(it2) {
        telem2 = types.table_elem(it2)
        if telem2 < 0 {
            // 调用/方法调用返回的裸表：查返回表元素类型
            if s_tags[init] == S_N_CALL {
                var fnm2 = sstate.name_str(init)
                // table_new_*：元素类型由调用名决定（对齐 Rust dynamic_table_elem_ty
                // 3844 行 table_new_elem_ty——Rust 侧 table_new_* 表达式类型是裸 table，
                // 元素类型在 VarDecl 处按调用名解析登记）
                var te4: i64 = -1
                if fnm2 == "table_new_i64" {
                    te4 = types.named(TK_I64)
                } else if fnm2 == "table_new_f64" {
                    te4 = types.named(TK_F64)
                } else if fnm2 == "table_new_string" {
                    te4 = types.named(TK_STR)
                } else if fnm2 == "table_new_bool" {
                    te4 = types.named(TK_BOOL)
                }
                if te4 >= 0 {
                    telem2 = te4
                } else {
                    var te2 = sinfer.table_ret_elem(sinfer.resolve_call_name(fnm2))
                    if te2 >= 0 {
                        telem2 = te2
                    } else {
                        telem2 = types.named(TK_I64)
                    }
                }
            } else if s_tags[init] == S_N_METHOD_CALL {
                // 方法调用返回表：recv::mname 查返回表元素（如 str.split → str::split）
                // MethodCall 接收者 = children[slot_off]（新布局 children[0]=泛型槽）
                var recv = sstate.child(init, sstate.slot_off(init))
                var rname = sstate.name_str(recv)
                var mname = sstate.name_str(init)
                var full2 = rname + "::" + mname
                var te3 = sinfer.table_ret_elem(full2)
                if te3 >= 0 {
                    telem2 = te3
                } else {
                    telem2 = types.named(TK_I64)
                }
            } else {
                telem2 = types.named(TK_I64)
            }
        }
        if s_tags[init] != S_N_TABLE_LIT {
            dyn2 = 1
        }
        // p.6.9.15 警告 W0004（无标注路径）：`var b = a` 拷贝动态表变量 → 引用共享
        if s_tags[init] == S_N_VAR && types.is_table(it2) {
            var iname2 = sstate.name_str(init)
            var inid2 = intern.intern(iname2)
            if iname2 != nm && sinfer.var_dyn(inid2) == 1 {
                sm_warn_add(s_lines[s], s_cols[s], "表变量拷贝共享底层数组（var b = a 后 b 的修改会反映到 a）")
            }
        }
    }
    // W00008 / W00005（无标注路径）：同名变量再次声明（作用域覆盖语义）
    decl_warn(nid, s_lines[s], s_cols[s])
    sinfer.lv_insert(nid, it2, is_const, telem2, dyn2)
    // S2.2 闭包：闭包体内声明的局部登记到当前闭包局部段（捕获遮蔽判定用）
    if g_clo_depth > 0 && g_clo_cur >= 0 {
        table_push(cl_locals, nid)
    }
    return 0
}

// W00012 收窄版的统计遍历：递归收集整数字面量的值 / 出现次数 / 首次位置。
// 只覆盖单棵函数体子树（含闭包 FN_LIT 子树），因此计数天然是「同一函数内」。
// 0 / 1 / -1 不计（正常用法）。
func lit_scan(node: i64, vals: table<i64>, cnts: table<i64>, lns: table<i64>, cls_ln: table<i64>) {
    if node < 0 {
        return
    }
    if s_tags[node] == S_N_INT_LIT {
        var v = s_vals[node]
        if v != 0 && v != 1 && v != -1 {
            var idx: i64 = -1
            var i: i64 = 0
            var nv = len(vals)
            while i < nv {
                if vals[i] == v {
                    idx = i
                    i = nv
                } else {
                    i = i + 1
                }
            }
            if idx >= 0 {
                cnts[idx] = cnts[idx] + 1
            } else {
                table_push(vals, v)
                table_push(cnts, 1)
                table_push(lns, s_lines[node])
                table_push(cls_ln, s_cols[node])
            }
        }
    }
    var n = sstate.nchild(node)
    var k: i64 = 0
    while k < n {
        lit_scan(sstate.child(node, k), vals, cnts, lns, cls_ln)
        k = k + 1
    }
}

// 函数体检查
pub func check_fn(fn_node: i64, full: string) -> i64 {
    var sig = sstate.fn_sig(full)
    if sig < 0 {
        sm_err_line = s_lines[fn_node]
        sm_err_col = s_cols[fn_node]
        sm_err_msg = "内部错误：函数 '" + full + "' 无签名"
        return -1
    }
    g_curfn = sig
    sstate.im_reset()   // p.9.11.11 immut 收集重置（每函数）
    lv_keys = table_new_i64()
    lv_vals = table_new_i64()
    lv_const = table_new_i64()
    lv_telem = table_new_i64()
    lv_dyn = table_new_i64()
    lp_stack = table_new_i64()
    lp_top = 0
    // 三期 goto（§7.1.5）：每函数重置 goto 标签表与块追踪（R1 同函数 = 表隔离）
    g_gt_keys = table_new_i64()
    g_gt_chain = table_new_string()
    g_gt_blkidx = table_new_i64()
    g_gt_seq = table_new_i64()
    g_gt_depths = table_new_i64()
    g_gtg_keys = table_new_i64()
    g_gtg_chain = table_new_string()
    g_gtg_blkidx = table_new_i64()
    g_gtg_seq = table_new_i64()
    g_gtg_line = table_new_i64()
    g_gtg_col = table_new_i64()
    g_cur_chain = ""
    g_cur_depth = 0
    g_cur_blkidx = 0
    g_cur_blknode = -1
    g_gt_seq_cnt = 0
    g_gt_blk_seq = 0
    g_cf_depth = 0
    g_block_names = table_new_i64()
    var nparams = sg_nparams[sig]
    var off = sg_off[sig]
    var i: i64 = 0
    while i < nparams {
        // 第 i 个参数节点：children[slot_off + 1 + i]（slot_off 双布局兼容）
        var pnode = sstate.child(fn_node, sstate.slot_off(fn_node) + 1 + i)
        var pname = sstate.name_str(pnode)
        var pnid = intern.intern(pname)
        var pty = sp_tys[off + i]
        var prefs = sp_refs[off + i]
        var telem: i64 = -1
        var dyn: i64 = 0
        if types.is_table(pty) {
            telem = types.table_elem(pty)
            if telem < 0 {
                telem = types.named(TK_STR)
            }
            dyn = 1
        }
        sinfer.lv_insert(pnid, pty, 0, telem, dyn)
        // p.9.11.11 immut 只读形参：N_PARAM val bit1 = immut（parser 登记；by_ref
        // 在 bit0 与既有 sp_refs 读取一致——此处读 bit1）。登记到 immut 集合。
        if (s_vals[pnode] & 2) != 0 {
            sstate.im_insert(pnid)
        }
        i = i + 1
    }
    // 函数体：children[slot_off + 1 + nparams]
    var body = sstate.child(fn_node, sstate.slot_off(fn_node) + 1 + nparams)
    // 无函数体声明（如 extern 声明）：body 子节点不存在（index == nchild），
    // child() 越界读会把相邻/后续节点（import 多时常为其它文件顶层节点的 tag）
    // 误当函数体成员扫到 → 假报「语句只能出现在文件顶层」。声明无需检查体，
    // 直接返回（goto 表为空，check_goto_refs 亦为空操作，语义等价）。
    if sstate.slot_off(fn_node) + 1 + nparams >= sstate.nchild(fn_node) {
        return 0
    }
    // S1.2：unsafe 函数体内开启 unsafe 上下文（safe 代码进 unsafe fn 已被调用
    // 检查拦截；unsafe fn 内部零标记触底）
    var saved_depth = g_unsafe_depth
    if sstate.sig_unsafe(sig) == 1 {
        g_unsafe_depth = g_unsafe_depth + 1
    }
    // W00012（收窄版）：同一函数内同一整数字面量出现 >= 3 次才报——单次或两次
    // 出现属正常写法，只有反复出现的无名常量才对应「局部修改易遗漏」。
    // p.9.14.2：lit_scan 是全函数子树遍历，仅当警告 pass 启用才执行。
    if semantic.sm_warn_enabled() {
        var w12_vals: table<i64> = table_new_i64()
        var w12_cnts: table<i64> = table_new_i64()
        var w12_lns: table<i64> = table_new_i64()
        var w12_cls: table<i64> = table_new_i64()
        lit_scan(body, w12_vals, w12_cnts, w12_lns, w12_cls)
        var w12_i: i64 = 0
        while w12_i < len(w12_vals) {
            if w12_cnts[w12_i] >= 3 {
                sm_warn_add(w12_lns[w12_i], w12_cls[w12_i], "魔法数字（非 0/1 的字面量直接参与运算）")
            }
            w12_i = w12_i + 1
        }
    }
    var r = check_block(body)
    g_unsafe_depth = saved_depth
    if r < 0 {
        return -1
    }
    // p.9.14.2 独立警告 pass：W00011/15/5/19 四趟全函数子树遍历是自举性能病态
    // 主因（每函数 3-4 趟 O(subtree) 递归；mod_walk 在嵌套 for 还会退化）。仅当
    // 警告 pass 启用（-w）才执行；默认只报错时整段短路，零额外成本。
    if semantic.sm_warn_enabled() {
        // W00011 / W00015：遍历函数体子树收集「参数读取 / 可变绑定重赋值 /
        // 可变声明」信息。闭包体作为函数体子树的一部分一并遍历，故闭包内读取 /
        // 修改外层变量也会计入，避免对捕获变量误报「未使用 / 未修改」。
        var dw_mvars: table<i64> = table_new_i64()
        var dw_assigned: table<i64> = table_new_i64()
        var dw_reads: table<i64> = table_new_i64()
        var dw_decls: table<i64> = table_new_i64()
        diag_walk(body, dw_mvars, dw_assigned, dw_reads, dw_decls)
        // W00011：函数参数从未被读取（或写入）
        var pi2: i64 = 0
        while pi2 < nparams {
            var pnode = sstate.child(fn_node, sstate.slot_off(fn_node) + 1 + pi2)
            var pnid = intern.intern(sstate.name_str(pnode))
            var used: bool = false
            if sstate.seg_has(dw_reads, 0, len(dw_reads), pnid) == 1 {
                used = true
            }
            if sstate.seg_has(dw_assigned, 0, len(dw_assigned), pnid) == 1 {
                used = true
            }
            if !used {
                sm_warn_add(s_lines[pnode], s_cols[pnode], "函数参数未使用（参数从未被读取）")
            }
            pi2 = pi2 + 1
        }
        // W00015：可变绑定（var）声明后从未被重赋值
        var mi: i64 = 0
        while mi < len(dw_mvars) {
            var dv = dw_mvars[mi]
            var dnid = intern.intern(sstate.name_str(dv))
            if sstate.seg_has(dw_assigned, 0, len(dw_assigned), dnid) == 0 {
                sm_warn_add(s_lines[dv], s_cols[dv], "可变绑定未修改（var 声明后从未赋值）")
            }
            mi = mi + 1
        }
        // W00005：局部变量（const / var）声明后从未被读取。
        //  - 以 `_` 开头的名字不报（约定为有意不使用，含解构脱糖产生的 _tmpN/_cN）。
        //  - 只扫函数体子树（body）：形参在 fn_node 子节点里，天然不在 body 内，
        //    交给 W00011，不重复报。
        //  - 与 W00015 分工：W00005 = 从未被读；W00015 = var 从未被写。两者可能同时命中
        //    同一变量（声明后既不读也不写），此重叠可接受。
        var w5i: i64 = 0
        while w5i < len(dw_decls) {
            var dv5 = dw_decls[w5i]
            var dnm5 = sstate.name_str(dv5)
            if len(dnm5) > 0 && !str.starts_with(dnm5, "_") {
                var dnid5 = intern.intern(dnm5)
                if sstate.seg_has(dw_reads, 0, len(dw_reads), dnid5) == 0 {
                    sm_warn_add(s_lines[dv5], s_cols[dv5], "未使用变量（声明后从未被读取）")
                }
            }
            w5i = w5i + 1
        }
        // W00019：表元素越界写（t[i] = v 且 i 为常量 >= 静态长度）。静态长度仅在
        // 「var t = [字面量...] 且 t 在函数体内只被下标赋值使用」时可安全确定；长度
        // 可能被 push/pop/传参/重赋值改变的场景一律不报（窄化，宁缺勿滥）。
        w19_reset()
        w19_collect(body)
        w19_check(body)
    }
    // 三期 goto（§7.1.5）：函数体检查完后统一校验 goto（标签表已收集全——
    // goto 可前向/后向任意位置，须全表收集后判定 R1/R2/R3）
    var gr = check_goto_refs()
    if gr < 0 {
        return -1
    }
    return 0
}

// 三期 goto 统一校验（函数体检查完后）：逐 goto 请求校验 R1/R2/R3。
// R1 同函数：标签必须存在（函数级标签表）。
// R2 同块或已执行外层块：目标链是 goto 链前缀（同块或外层块）；外层块须向后跳
// （标签全局序号 < goto 全局序号 = 已执行）。禁止跳入更内层块（非前缀）。
// R3 不越过初始化：同块前向跳（goto 序号 < 标签序号）不得跨 var/const 声明。
func check_goto_refs() -> i64 {
    var i: i64 = 0
    while i < len(g_gtg_keys) {
        var gnm = g_gtg_keys[i]
        var gi = gt_find(gnm)
        if gi < 0 {
            sm_err_line = g_gtg_line[i]
            sm_err_col = g_gtg_col[i]
            sm_err_msg = "goto 的目标标签 '#" + intern.lookup(gnm) + "' 未定义（R1 同函数：同函数内必须有 #[tag." + intern.lookup(gnm) + "] 标签）"
            return -1
        }
        var tchain = g_gt_chain[gi]
        var gchain = g_gtg_chain[i]
        // R2：目标链是 goto 链前缀（同块或外层块）
        if !chain_is_prefix(tchain, gchain) {
            sm_err_line = g_gtg_line[i]
            sm_err_col = g_gtg_col[i]
            sm_err_msg = "goto 目标 '#" + intern.lookup(gnm) + "' 不在同块或外层块（禁止跳入更内层块/跨块跳转，R2）"
            return -1
        }
        if str_len(tchain) < str_len(gchain) {
            // 外层块：须向后跳（标签已执行，标签序号 < goto 序号）
            if g_gt_seq[gi] >= g_gtg_seq[i] {
                sm_err_line = g_gtg_line[i]
                sm_err_col = g_gtg_col[i]
                sm_err_msg = "goto 目标 '#" + intern.lookup(gnm) + "' 在外层块但位于 goto 之后（只能向后跳到已执行的外层块头，R2）"
                return -1
            }
        } else if tchain == gchain {
            // 同块：R3 不越过初始化——仅前向跳（goto 序号 < 标签序号，跳过后续
            // 声明）违规；向后跳同块头合法（重新初始化）。
            if g_gt_seq[gi] > g_gtg_seq[i] {
                // 块内语句区间 (goto_idx, label_idx)：标签与 goto 同块，块内序号
                // 可比较。扫描标签所在块 StmtList 的 (goto_idx+1 .. label_idx)
                // 直接语句，若有 var/const 声明 → 违规。
                var lo = g_gtg_blkidx[i]
                var hi = g_gt_blkidx[gi]
                if blk_has_var_decl(g_gt_blknode[gi], lo + 1, hi) {
                    sm_err_line = g_gtg_line[i]
                    sm_err_col = g_gtg_col[i]
                    sm_err_msg = "goto 向前跳过局部变量初始化（goto 与标签之间不得经过 var/const 声明，R3）"
                    return -1
                }
            }
        }
        i = i + 1
    }
    return 0
}

// full 名 "::" 段（除最后一段函数名）压 ns_stack，返回压入段数。
// check_fn_walk 快路径的命名空间上下文重建（对齐旧扫描路径的 ns_push 行为）。
func push_ns_of(full: string) -> i64 {
    var cnt: i64 = 0
    var n = str_len(full)
    var pos: i64 = 0
    var seg_start: i64 = 0
    while pos < n {
        // 找 "::" 分隔（段边界）
        if pos + 1 < n && str_char(full, pos) == ":" && str_char(full, pos + 1) == ":" {
            var seg = str.slice(full, seg_start, pos)
            sstate.ns_push(intern.intern(seg))
            cnt = cnt + 1
            pos = pos + 2
            seg_start = pos
        } else {
            pos = pos + 1
        }
    }
    return cnt
}

// 带命名空间上下文的函数检查（顶层遍历 g_extra_tops，进入 namespace 时压段）
pub func check_fn_walk(full: string) -> i64 {
    // 快路径（性能重构）：fn_def_nodes 平行表 O(log n) 定位定义节点——
    // 旧版每函数线性扫全部顶层 + 每候选拼 ns_full_name + strcmp，N 函数 ×
    // M 顶层构成语义阶段最大平方（自举实测 sem 占 99.8%）。查表 miss 再走
    // 旧扫描兜底（泛型展开等未登记路径）。
    // 命名空间上下文：full 的 :: 段（除最后一段函数名）压 ns_stack——
    // 命名空间内私有函数的裸调用解析依赖该栈（曾漏压导致「未定义的函数」）。
    var fast_node = sstate.fn_def_node(full)
    if fast_node >= 0 {
        var segs = push_ns_of(full)
        var r0 = check_fn(fast_node, full)
        var pp: i64 = 0
        while pp < segs {
            ns_top = ns_top - 1
            pp = pp + 1
        }
        if r0 < 0 {
            return -1
        }
        return 1
    }
    var n = len(g_extra_tops)
    var i: i64 = 0
    while i < n {
        var s = g_extra_tops[i]
        var tag = s_tags[s]
        if tag == S_N_FN_DEF {
            if sstate.ns_full_name(sstate.name_str(s)) == full {
                var r = check_fn(s, full)
                if r < 0 {
                    return -1
                }
                return 1
            }
        } else if tag == S_N_NAMESPACE {
            var nsegs = s_aux[s]
            var j: i64 = 0
            while j < nsegs {
                var seg = sstate.child(s, j)
                sstate.ns_push(s_names[seg])
                j = j + 1
            }
            var body = sstate.child(s, nsegs)
            var r = check_fn_walk_in_ns(body, full)
            j = 0
            while j < nsegs {
                ns_top = ns_top - 1
                j = j + 1
            }
            if r < 0 {
                return -1
            }
            if r == 1 {
                return 1
            }
        }
        i = i + 1
    }
    return 0
}

// 命名空间体内递归检查（含嵌套 namespace）
func check_fn_walk_in_ns(blk: i64, full: string) -> i64 {
    var n = sstate.nchild(blk)
    var i: i64 = 0
    while i < n {
        var s = sstate.child(blk, i)
        var tag = s_tags[s]
        if tag == S_N_FN_DEF {
            if sstate.ns_full_name(sstate.name_str(s)) == full {
                var r = check_fn(s, full)
                if r < 0 {
                    return -1
                }
                return 1
            }
        } else if tag == S_N_NAMESPACE {
            var nsegs = s_aux[s]
            var j: i64 = 0
            while j < nsegs {
                var seg = sstate.child(s, j)
                sstate.ns_push(s_names[seg])
                j = j + 1
            }
            var body = sstate.child(s, nsegs)
            var r = check_fn_walk_in_ns(body, full)
            j = 0
            while j < nsegs {
                ns_top = ns_top - 1
                j = j + 1
            }
            if r < 0 {
                return -1
            }
            if r == 1 {
                return 1
            }
        }
        i = i + 1
    }
    return 0
}

// ==================== S2.2 闭包：延迟闭包体检查 ====================
// 语义主流程末尾调用。FIFO 处理 g_clo_pending（登记顺序 = 检查顺序；
// 嵌套闭包在外层闭包体检查期间登记，仍按 FIFO 排在外层之后）。
// 每个闭包体用「登记时 lv 快照 + 闭包参数 + 闭包局部」重建独立作用域
// 检查，结束后恢复外层作用域（函数检查残留的 lv 表）。
// 注意：用**动态** len(g_clo_pending) 作循环边界——嵌套闭包是在检查外层
// 闭包体时才被 infer_expr 登记到队尾，若固定 n 则嵌套闭包被漏检，其捕获集
// 为空，内层闭包体对外层变量的引用在 irgen 阶段「变量未入作用域」。每个
// N_FN_LIT 节点只被 infer 并登记一次，动态边界不会造成重复处理死循环。
pub func check_pending_closures() -> i64 {
    var i: i64 = 0
    while i < len(g_clo_pending) {
        var r = check_closure_body(i)
        if r < 0 {
            return -1
        }
        i = i + 1
    }
    // 捕获传播（任务21 嵌套闭包）：所有闭包体检查完后重算各闭包捕获集
    if propagate_captures() < 0 {
        return -1
    }
    // W00016：全部函数检查完后发射「全局可变表被多处修改」警告
    w16_emit()
    return 0
}

// S2.2 捕获传播（嵌套闭包，任务21）：闭包 k 的有效捕获 = 直接捕获 ∪ 子闭包
// 传播捕获，再减自身参数/局部（自身参数/局部走本地槽，无需进 env）。
// 后处理：所有闭包体检查完后调用（cl_params/cl_locals/cl_cap* 均已定型）。
// 处理顺序：闭包索引越大越内层（FIFO 登记），从内到外收集——内层闭包的有效
// 捕获先算好，传播给祖先闭包时直接读子闭包已算好的有效段。
// 例（probe6 三层）：C3 直接捕获 a/b/c → C2 有效 = {a,b}（c 是 C2 局部排除）→
// C1 有效 = {a}（b 是 C1 局部排除）。闭包值构造点的 gen_var_ref 才找得到外层变量。
func propagate_captures() -> i64 {
    var n = len(g_clo_pending)
    if n == 0 {
        return 0
    }
    // eff_start[c]/eff_len[c]：闭包 c 有效捕获段（eff_keys/eff_vals）
    // 注意：tie 表下标写 i>=len 静默失败（须 table_push），先按闭包数预填，
    // 后续用下标回填 eff_start[c]/eff_len[c]（读侧 cl_capoff 等已由登记预填）。
    var eff_start: table<i64> = table_new_i64()
    var eff_len: table<i64> = table_new_i64()
    var eff_keys: table<i64> = table_new_i64()
    var eff_vals: table<i64> = table_new_i64()
    var pf: i64 = 0
    while pf < n {
        table_push(eff_start, 0)
        table_push(eff_len, 0)
        pf = pf + 1
    }
    var c: i64 = n - 1
    while c >= 0 {
        eff_start[c] = len(eff_keys)
        // ① 直接捕获（现有 cl_capkeys 段，检查期间已登记）
        var off = cl_capoff[c]
        var end = len(cl_capkeys)
        if c + 1 < len(cl_capoff) {
            end = cl_capoff[c + 1]
        }
        var j: i64 = off
        while j < end {
            var v = cl_capkeys[j]
            if is_closure_own(c, v) == 0 && sstate.seg_has(eff_keys, eff_start[c], len(eff_keys) - eff_start[c], v) == 0 {
                table_push(eff_keys, v)
                table_push(eff_vals, cl_capvals[j])
            }
            j = j + 1
        }
        // ② 子闭包传播：cl_parent[ch] == c 的子闭包有效捕获并入（减自身参数/局部）
        var ch: i64 = c + 1
        while ch < n {
            if cl_parent[ch] == c {
                var k: i64 = 0
                while k < eff_len[ch] {
                    var v2 = eff_keys[eff_start[ch] + k]
                    if is_closure_own(c, v2) == 0 && sstate.seg_has(eff_keys, eff_start[c], len(eff_keys) - eff_start[c], v2) == 0 {
                        table_push(eff_keys, v2)
                        table_push(eff_vals, eff_vals[eff_start[ch] + k])
                    }
                    k = k + 1
                }
            }
            ch = ch + 1
        }
        eff_len[c] = len(eff_keys) - eff_start[c]
        c = c - 1
    }
    // 重建 cl_capoff/cl_capkeys/cl_capvals（闭包索引升序布局，后端 gen_closure_lit
    // 按 [cl_capoff[c], cl_capoff[c+1]) 读段）
    cl_capoff = table_new_i64()
    cl_capkeys = table_new_i64()
    cl_capvals = table_new_i64()
    var i2: i64 = 0
    while i2 < n {
        table_push(cl_capoff, len(cl_capkeys))
        var j2: i64 = 0
        while j2 < eff_len[i2] {
            table_push(cl_capkeys, eff_keys[eff_start[i2] + j2])
            table_push(cl_capvals, eff_vals[eff_start[i2] + j2])
            j2 = j2 + 1
        }
        i2 = i2 + 1
    }
    return 0
}

// 闭包 c 自身可直访名：参数段 ∪ 局部段（命中 → 走本地槽，不捕获）。
// 局部段边界取 [cl_locloff[c], cl_locloff[c+1])（闭包检查 FIFO 序，c 的局部
// 全部在 c+1 检查开始前追加；末段到 len(cl_locals)）。
func is_closure_own(c: i64, v: i64) -> i64 {
    if sstate.seg_has(cl_params, cl_paramoff[c], cl_nparams[c], v) == 1 {
        return 1
    }
    var lend = len(cl_locals)
    if c + 1 < len(cl_locloff) {
        lend = cl_locloff[c + 1]
    }
    if sstate.seg_has(cl_locals, cl_locloff[c], lend - cl_locloff[c], v) == 1 {
        return 1
    }
    return 0
}

// 检查单个闭包体：重建独立 lv 作用域 + 闭包返回类型栈 + 检查后恢复
func check_closure_body(ci: i64) -> i64 {
    var fn_node = g_clo_pending[ci]
    // 保存外层 lv 五表与 loop 栈（函数检查残留，闭包体检查后恢复）
    var s_keys = lv_keys
    var s_vals = lv_vals
    var s_const = lv_const
    var s_telem = lv_telem
    var s_dyn = lv_dyn
    var s_lp = lp_stack
    var s_lpt = lp_top
    // p.9.11.11 immut：闭包体重建作用域时重置 immut 集合（闭包无 immut 形参
    // 语法；外层函数 immut 集此刻已随 check_fn 结束而清空——若沿用会残留最后
    // 一个检查函数的陈旧集合导致误报。捕获外层 immut 形参的闭包写**不拦截**，
    // 属已知边界：immut 保证作用于函数体直接写的形参绑定）。
    sstate.im_reset()
    // 重建 lv = 登记时快照段（cl_o* 五表并行段，登记时已排序，直拷保持序）
    lv_keys = table_new_i64()
    lv_vals = table_new_i64()
    lv_const = table_new_i64()
    lv_telem = table_new_i64()
    lv_dyn = table_new_i64()
    lp_stack = table_new_i64()
    lp_top = 0
    var ooff = cl_off[ci]
    var nouter = cl_nouter[ci]
    var j: i64 = 0
    while j < nouter {
        table_push(lv_keys, cl_okeys[ooff + j])
        table_push(lv_vals, cl_ovals[ooff + j])
        table_push(lv_const, cl_oconst[ooff + j])
        table_push(lv_telem, cl_otelem[ooff + j])
        table_push(lv_dyn, cl_odyn[ooff + j])
        j = j + 1
    }
    // 闭包参数插入 lv（telem/dyn 表类型处理同 check_fn 参数模板）
    var nparams = cl_nparams[ci]
    var poff = cl_paramoff[ci]
    var tyoff = cl_paroff[ci]
    var k: i64 = 0
    while k < nparams {
        var pnid = cl_params[poff + k]
        var pty = cl_ptys[tyoff + k]
        var telem: i64 = -1
        var dyn: i64 = 0
        if types.is_table(pty) {
            telem = types.table_elem(pty)
            if telem < 0 {
                telem = types.named(TK_STR)
            }
            dyn = 1
        }
        sinfer.lv_insert(pnid, pty, 0, telem, dyn)
        k = k + 1
    }
    // 闭包局部/捕获段起点：检查开始时定位（覆盖登记时占位值，避免
    // 嵌套闭包登记后外层闭包继续追加局部/捕获造成的段污染）
    cl_locloff[ci] = len(cl_locals)
    cl_capoff[ci] = len(cl_capkeys)
    // 压闭包返回类型（S_N_RETURN 检查优先取栈顶而非 sg_ret[g_curfn]）。
    // 复用槽位模式（同 lp_stack/ns_push）：表不截断、top 游标定位——
    // 直接 table_push 会让旧值残留错位（第二次 push 后栈顶索引指到残留值）。
    if g_clo_ret_top < len(g_clo_ret_stack) {
        g_clo_ret_stack[g_clo_ret_top] = cl_ret[ci]
    } else {
        table_push(g_clo_ret_stack, cl_ret[ci])
    }
    g_clo_ret_top = g_clo_ret_top + 1
    // 进入闭包体上下文（S_N_VAR 捕获登记 / check_var_decl 局部登记）
    g_clo_cur = ci
    g_clo_depth = g_clo_depth + 1
    // 闭包体：children[slot+1+nparams]（泛型槽0、返回类型1、参数2..、体末尾）
    var slot = sstate.slot_off(fn_node)
    var body = sstate.child(fn_node, slot + 1 + nparams)
    g_cf_depth = 0   // 闭包嵌套深度独立计（不继承外层函数）
    var r = check_block(body)
    // 退出闭包体上下文
    g_clo_depth = g_clo_depth - 1
    g_clo_cur = -1
    g_clo_ret_top = g_clo_ret_top - 1
    // 恢复外层 lv 五表与 loop 栈
    lv_keys = s_keys
    lv_vals = s_vals
    lv_const = s_const
    lv_telem = s_telem
    lv_dyn = s_dyn
    lp_stack = s_lp
    lp_top = s_lpt
    if r < 0 {
        return -1
    }
    return 0
}

}
