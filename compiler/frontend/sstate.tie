type tie<class>
// compiler/frontend/sstate.tie —— T2.6 语义分析全局状态（模块拆分）
// ============================================================
// 里程碑：自举 v2 计划 T2.6（.omo/plans/self-hosting-v2.md）完整语义分析
// 拆分为 8 模块之一（本文件 = AST 9 列 + 符号表全局 + 协议解析 + 节点访问 +
// 工具/登记函数，零依赖除 interner/string/lex 原语）。import 树最深层。
// 对应 proto/semantic.tie 142-231（状态）+ 238-377（load_ast）+ 380-520
// （节点访问/可寻址/可见性）+ 642-755（bs_find/sorted_insert/reg_fn/
// reg_struct/fn_sig）+ 1250-1264（ns_push/ns_pop）逻辑搬移。
// 依赖：无（intern/str 原语直接可用，与 T2.4/T2.5 一致不显式 import）。
// S2.4：port 登记调用 types.set_port_name（port 名表还原）——types 在
// middle（../middle/types.tie），须显式 import（interp_eval 等独立场景
// 的 import 链不保证传递可见；s24 分支曾因缺 import 报未定义）。
import "../middle/types.tie"
// 由 stype.tie import（传递可达上层全部）。

// ==================== AST 全局列式表（协议解析结果）====================
var s_tags: table<i64>;       // 节点 tag
var s_names: table<i64>;      // 字符串池 id（-1=无）
var s_vals: table<i64>;       // 主整数值（字面量值/运算符/标志）
var s_aux: table<i64>;        // 次整数值（nparams/nsegs/ncases/label）
var s_coff: table<i64>;       // 子节点偏移（s_children 段起点）
var s_nchild: table<i64>;     // 子节点数
var s_children: table<i64>;   // 扁平子节点 id 段
var s_lines: table<i64>;      // 起始行（1-based）
var s_cols: table<i64>;       // 起始列（1-based）
var s_n: i64 = 0;             // 节点总数

// ==================== 符号表全局 ====================
var fn_keys: table<i64>;      // 函数全名 id（升序）
var fn_vals: table<i64>;      // 签名 id
var fn_def_nodes: table<i64>; // 函数定义 AST 节点 id（与 fn_keys 平行；性能重构：
                              // check_fn_walk 查表 O(log n) 定位，替代每函数线性
                              // 扫全部顶层 + ns_full_name 拼串比较的 O(N×M) 平方）
var sg_nparams: table<i64>;   // 签名表：参数总数
var sg_required: table<i64>;  // 必选参数数（默认值前）
var sg_ret: table<i64>;       // 返回类型 id
var sg_pub: table<i64>;       // 0/1
var sg_off: table<i64>;       // 参数段偏移（sp_tys/sp_refs/sp_defs）
var sp_tys: table<i64>;       // 参数类型 id（扁平段）
var sp_refs: table<i64>;      // 参数 by_ref 标志（扁平段）
var sp_defs: table<i64>;      // 参数有默认值（扁平段）
var sp_vars: table<i64>;      // 参数变参标志（扁平段；1 = `name: ...T`）
// p.9.11.15 生成器标记（与 sg_* 下标对齐）：0=普通函数 1=生成器函数（含 yield；
// 签名返回类型已登记为 table<elem>）。scheck/irgen 读 is_gen 分派。
var gen_marks: table<i64>;

// p.9.11.11 immut 只读形参名集合（每函数 check_fn 重置；变量名池 id）。
var g_im_keys: table<i64>;
var g_im_vals: table<i64>;

var st_keys: table<i64>;      // struct 名 id（升序）
var st_vals: table<i64>;      // struct 索引
// p.9.11.32 类型别名注册表（名 id 升序；val = S_N_TYPE_ALIAS 节点 id）
var alias_keys: table<i64>;
var alias_vals: table<i64>;
var cls_parent: table<i64>;   // struct 父名 id（-1=无）
var cls_fldoff: table<i64>;   // 字段段偏移（fld_names/fld_tys）
var cls_nfld: table<i64>;     // 字段数（含继承拍平）
var cls_done: table<i64>;     // struct 字段收集完成标志（0/1，拍平递归防重）
var st_reprc: table<i64>;     // struct 索引 -> repr(C) 显式 C ABI 布局标志（1=repr(C)/0=默认；p.6.8.2）
var fld_names: table<i64>;    // 拍平字段名 id
var fld_tys: table<i64>;      // 拍平字段类型 id
var fld_defs: table<i64>;     // 拍平字段默认值表达式节点 id（-1 = 无；Point.y = 10）

// ==================== enum 状态表（2026-08-15 enum 语言特性）====================
// enum 表按「名 id（升序）→ 索引」登记，索引行号 = types.enum_of 的负载。
// 变体信息拍平段（en_vnames/en_vtags/en_vfldoff/en_vnfld 共用 en_varoff 段偏移；
// payload 类型单独拍平进 en_ftys，变体经 en_vfldoff 定位其字段段）。
var en_keys: table<i64>;      // enum 名 id（升序，二分）
var en_vals: table<i64>;      // enum 索引
var en_done: table<i64>;      // 变体收集完成标志（0/1，防重复收集）
var en_nvar: table<i64>;      // 变体数
var en_varoff: table<i64>;    // 变体段偏移（en_vnames/en_vtags/en_vfldoff/en_vnfld 共用段）
var en_nslot: table<i64>;     // 槽数 K（所有变体 payload 字段数最大值；后端聚合布局用）
var en_vnames: table<i64>;    // 变体名 id（拍平段）
var en_vtags: table<i64>;     // 变体 tag 值（0..nvar-1，拍平段）
var en_vfldoff: table<i64>;   // 变体 payload 字段段偏移（en_ftys）
var en_vnfld: table<i64>;     // 变体 payload 字段数
var en_ftys: table<i64>;      // 变体 payload 字段类型 id（拍平段）

var gb_keys: table<i64>;      // 全局变量名 id（升序）
var gb_vals: table<i64>;      // 类型 id
var gb_const: table<i64>;     // 0/1
var gb_telem: table<i64>;     // 全局表元素类型 id（-1=非表）

var ext_keys: table<i64>;     // extern 函数名 id（升序）

// S1.2：unsafe 上下文深度（0 = 安全代码）。unsafe fn 体 / unsafe 块 /
// 文件级 type tie<unsafe> 各 +1；语义层触底操作检查 g_unsafe_depth == 0 报错。
var g_unsafe_depth: i64 = 0;

var tre_keys: table<i64>;     // 返回表的函数名 id（升序）
var tre_vals: table<i64>;     // 元素类型 id

var node_types: table<i64>;   // 节点 id -> 类型 id（-1=未推断）

// p.8.2.7 计算属性（computed property）：成员访问节点 id -> getter/setter 方法全名
//（intern id）。读取 `obj.attr` 命中 getter（<Struct>::attr）或写入 `obj.attr=v`
// 命中 setter（<Struct>::attr_set）时由语义层登记，irgen 据此发射方法调用而非
// 存储槽访问。实现形态 = 子项 p.8.2.4 的结构绑定命名空间方法（getter/setter 复用
// tig_op_overload 发射）。-1 = 普通字段（缺省，不产方法调用）。
var g_cmp_getter: table<i64>;  // 节点 id -> 计算属性 getter 全名（intern id）；-1 = 无
var g_cmp_setter: table<i64>;  // 节点 id -> 计算属性 setter 全名（intern id）；-1 = 无

// ==================== 每函数重置的局部状态 ====================
var lv_keys: table<i64>;      // 作用域变量名 id（升序）
var lv_vals: table<i64>;      // 类型 id
var lv_const: table<i64>;     // 0/1
var lv_telem: table<i64>;     // 表变量元素类型 id（-1=非表）
var lv_dyn: table<i64>;       // 表变量动态标志（0/1）
// S1.5 移动语义：变量状态跟踪（live/moved）。**独立升序表**（非 lv_* 并行）：
// 存在即 moved（bs_find >= 0）。移动规则（docs/plans/ui-framework.md §4.2）：
// 堆类型（string/table/含堆字段聚合）赋值/按值传参/返回即转移所有权，源变量
// moved；此后读取 = 编译错误（"use of moved value"）。栈类型不跟踪。
// 维护点：scheck.check_var_decl/check_stmt（赋值/返回移动登记）+ sinfer
// infer_expr S_N_VAR（读取检查）；函数边界（check_fn）重置。独立表的好处：
// 不依赖 lv_insert 同步（lv_* 并行表由 sinfer 维护，S1.2-1.4 并行会话在改）。
var lv_moved: table<i64>;     // 已移动变量名 id（升序，二分）

var lp_stack: table<i64>;     // 循环标签栈（break/continue 上下文；-1=无标签）
var lp_top: i64 = 0;          // lp_stack 逻辑栈顶游标（tie 表无法截断，用游标模拟 pop）
var ns_stack: table<i64>;     // 命名空间段栈（全名补全）
var ns_top: i64 = 0;          // ns_stack 逻辑栈顶游标（同 lp_top）
var using_prefixes: table<i64>;  // using 引入的命名空间段名 id（扁平段 + 长度表）
var using_lens: table<i64>;      // using 前缀段数（与 using_prefixes 并行，按段号分组）

// 返回表的内置函数预登记（元素类型 id）
var tre_bi_keys: table<i64>;  // 内置名 id
var tre_bi_vals: table<i64>;  // 元素类型 id

// ==================== 错误状态 ====================
var sm_err_line: i64 = 0;
var sm_err_col: i64 = 0;
var sm_err_msg: string = "";

// 当前函数全名 id（check_fn 期间；IR 全局初始化不支持负数）
var g_curfn: i64 = 0;
// 当前扫描函数节点（collect 阶段返回表元素预扫描用）
var g_cur_scan_fn: i64 = 0;
// 当前命名空间深度（裸名解析用）
var g_ns_depth: i64 = 0;
// 表达式类型计数（OK: 返回）
var g_typed: i64 = 0;

// struct/tuple 类型 id 缓存与 tuple 字段段
var struct_tys: table<i64>;   // struct 索引 -> 3<<40|idx
var tuple_tys: table<i64>;    // tuple 索引 -> 4<<40|idx
var tup_names: table<i64>;    // tuple 字段名 id（扁平段）
var tup_tys: table<i64>;      // tuple 字段类型 id（扁平段）
var tup_offs: table<i64>;     // tuple 字段段偏移
var tup_n: table<i64>;        // tuple 字段数

// ==================== 泛型模板登记（T3b 单态化展开器预置，2026-08-14）====================
// T1 泛型语法（`func max<T>` / `struct Box<T>`）落地后，本表预置模板登记
// 结构：供 T3b 单态化展开器使用（本任务只建结构 + 查询/登记辅助函数，不实现
// 展开）。登记时机：scollect.collect_fn / collect_struct_decl 检测到 children[0]
// == N_TYPE_PARAMS 时调用 sstate.reg_generic。所有表在 semantic.check_impl /
// check_ast 状态重置时清零。
var gty_keys: table<i64>;      // 泛型模板全名 id（intern，升序）
var gty_vals: table<i64>;      // 模板索引（与 gty_keys 并行，sorted_insert 同插）
var gty_full: table<i64>;      // 模板索引 -> 模板全名 id（intern；gty_keys 按名排序
                               // 是位置表，模板索引与其不一致时不能 gty_keys[gti] 取名）
var gtyp_nparams: table<i64>;  // 模板索引 -> 类型参数个数
var gtyp_off: table<i64>;      // 模板索引 -> 类型参数名段偏移（gtyp_names 扁平段）
var gtyp_names: table<i64>;    // 类型参数名 id（intern，扁平段；取自 N_TYPE_PARAM.name）
var gty_node: table<i64>;      // 模板索引 -> 定义 AST 节点 id（FnDef / Struct）
var gty_is_struct: table<i64>; // 模板索引 -> 0=函数模板 1=struct 模板
// S2.4 泛型约束段（port 约束，port-model.md §2.3）：gtyp_conoff[模板索引] ->
// gtyp_cons 段偏移；段长 = gtyp_nparams（每类型参数 1 槽，-1 = 无约束）。
// 槽值 = 约束 port 名 id（intern；语义层校验是已登记 port）。
// 实例化（sgen.instantiate_fn/struct）实参化时校验：实参类型必须 impl 该 port。
var gtyp_conoff: table<i64>;  // 模板索引 -> 约束段偏移（gtyp_cons）
var gtyp_cons: table<i64>;    // 约束 port 名 id 扁平段（-1 = 无约束）

// v2 值参数（容量参数）段：gtyp_kindoff[模板索引] -> gtyp_kinds 段偏移；段长 =
// gtyp_nparams（每参数 1 槽：0=类型参数，1=值参数(i64)）。值参数不占约束槽
//（cons = -1），其默认值节点（N_INT_LIT / N_VAR，取自 N_TYPE_PARAM.children[1]）
// 存于 gtyp_defs 段——语义层对值参数槽按「整型常量」解析而非类型。
var gtyp_kindoff: table<i64>;  // 模板索引 -> 参数 kind 段偏移（gtyp_kinds）
var gtyp_kinds: table<i64>;    // 参数 kind 扁平段（0=类型参数，1=值参数）

// 整型常量表（v2 数组长度/值参数求值）：gval_kkeys[名 id] -> gval_kvals[整型值]。
// const 名在数组长度 / 值参数默认值处引用时按此解析（编译期常量，值 > 0）。
var gval_kkeys: table<i64>;
var gval_kvals: table<i64>;

// p.8.2.6 泛型默认类型参数段：gtyp_defoff[模板索引] -> gtyp_defs 段偏移；
// 段长 = gtyp_nparams（每类型参数 1 槽）。槽值 = 默认类型**类型节点 id**
//（N_NAMED_TYPE/N_TABLE_TYPE/N_STRUCT_TYPE 等，取自 N_TYPE_PARAM.children[1]；
// 调用处用 sgen.parse_generic_type_node 解析为类型 id；-1 = 无默认类型）
var gtyp_defoff: table<i64>;  // 模板索引 -> 默认类型段偏移（gtyp_defs）
var gtyp_defs: table<i64>;    // 默认类型节点 id 扁平段（-1 = 无默认）

// 实例化记录表（gin_*，T3b 单态化展开器 2026-08-14）：
// 同（模板名, 类型实参组合）只展开一次——mangled 名即去重键。
// gin_keys/gin_vals：mangled 名 id（升序）→ 记录索引（sorted_insert 同插）。
// gin_tmpl/gin_off/gin_nargs/gin_is_struct：记录索引 → 模板索引 / 类型实参
// 段偏移（garg_vals 扁平段）/ 实参个数 / 0=函数 1=struct。
// garg_vals：类型实参 id 扁平段（按模板类型参数顺序）。
// 所有表在 semantic.check_impl / check_ast 状态重置时清零。
var gin_keys: table<i64>;      // 实例化 mangled 名 id（升序）
var gin_vals: table<i64>;      // 记录索引（与 gin_keys 并行）
var gin_tmpl: table<i64>;      // 记录索引 -> 模板索引（gty_vals）
var gin_off: table<i64>;       // 记录索引 -> 类型实参段偏移（garg_vals）
var gin_nargs: table<i64>;     // 记录索引 -> 类型实参个数
var gin_is_struct: table<i64>; // 记录索引 -> 0=函数 1=struct
var garg_vals: table<i64>;     // 类型实参 id 扁平段
// 实例化递归深度计数（防无限递归，上限 64）
var g_inst_depth: i64 = 0;

// ==================== 闭包语义状态表（S2.2，2026-08-16）====================
// 闭包（N_FN_LIT func 字面量）延迟检查队列 + 捕获分析。
// infer_expr 遇 N_FN_LIT 时：① 解析返回/参数类型 → types.fn_of 登记 fn 类型；
// ② 保存「登记时 lv 快照」（捕获基准：闭包体检查重建作用域用）；③ 入队
// g_clo_pending（FIFO）。闭包体（语句块）检查延迟到语义主流程末尾由
// scheck.check_pending_closures() 统一处理（sinfer 无 check_block 能力，且
// import 树禁止 sinfer → scheck）。捕获判定在 sinfer S_N_VAR 分支（命中
// lv 且非闭包参数/局部 → 登记 cl_capkeys/cl_capvals）。所有表在
// semantic.check_impl / check_ast 状态重置时清零。
var g_clo_pending: table<i64>;  // 待检查闭包 N_FN_LIT 节点 id（FIFO 登记顺序）
var cl_ret: table<i64>;         // 闭包索引 -> 返回类型 id
var cl_nparams: table<i64>;     // 闭包索引 -> 参数个数
var cl_paroff: table<i64>;      // 闭包索引 -> 参数类型段偏移（cl_ptys）
var cl_ptys: table<i64>;        // 参数类型 id 扁平段
var cl_off: table<i64>;         // 闭包索引 -> lv 快照段偏移（cl_okeys 等）
var cl_nouter: table<i64>;      // 闭包索引 -> 快照条数（登记时 lv_keys 长度）
var cl_okeys: table<i64>;       // 快照变量名 id（扁平段）
var cl_ovals: table<i64>;       // 快照类型 id
var cl_oconst: table<i64>;      // 快照 const 标志
var cl_otelem: table<i64>;      // 快照表元素类型 id
var cl_odyn: table<i64>;        // 快照动态标志
var cl_paramoff: table<i64>;    // 闭包索引 -> 参数名段偏移（cl_params）
var cl_params: table<i64>;      // 闭包参数名 id（扁平段；捕获遮蔽判定）
var cl_locloff: table<i64>;     // 闭包索引 -> 局部名段偏移（cl_locals）
var cl_locals: table<i64>;      // 闭包内声明局部名 id（扁平段；捕获遮蔽判定）
var cl_capoff: table<i64>;      // 闭包索引 -> 捕获段偏移（cl_capkeys/cl_capvals）
var cl_capkeys: table<i64>;     // 捕获变量名 id（扁平段）
var cl_capvals: table<i64>;     // 捕获变量类型 id（扁平段）
var g_clo_depth: i64 = 0;       // 闭包体检查深度（>0 = 在闭包体内）
var g_clo_cur: i64 = -1;        // 当前闭包索引（捕获登记目标；-1 = 无）
var g_clo_ret_stack: table<i64>;// 闭包返回类型栈（S_N_RETURN / ? 解包用）
var g_clo_ret_top: i64 = 0;     // 返回类型栈逻辑栈顶游标（tie 表无法截断）
var cl_parent: table<i64>;      // 闭包索引 -> 父闭包索引（sinfer 登记时 g_clo_cur；
                                // -1 = 直接嵌套在普通函数体）。捕获传播（任务21）
                                // 沿此链把内层闭包捕获上溯到祖先闭包的 env。

// ==================== 顶层 StmtList 根（parse_program 创建的最后节点 id）
var g_root: i64 = 0;

// ==================== 一期并发 actor 状态表 ====================
// actor 表：ac_keys（actor 名 id，升序）→ ac_vals（actor 索引）。索引与
// types.BASE_ACTOR 行号对应（scollect 收集时 set_actor_name 登记同名）。
var ac_keys: table<i64>;
var ac_vals: table<i64>;
// actor 方法签名表（行 = actor 索引）：
//   ac_moff[actor] -> 方法名段偏移（ac_mnames，声明顺序）
//   ac_mn[actor]   -> 方法个数
//   ac_mpar[actor] -> 参数个数表段偏移（ac_mnpars 扁平段）
//   ac_paroff[actor]-> 参数类型段偏移（ac_mptys 扁平段）
//   ac_mret[actor] -> 返回类型表段偏移（ac_mrets 扁平段）
// 方法 m 的签名：参数个数 = ac_mnpars[ac_mpar + m]，参数段 =
// ac_mptys[ac_paroff + m .. +个数]，返回 = ac_mrets[ac_mret + m]。
// actor 方法无显式 self 参数（状态隐式，msg 参数即显式形参）。
var ac_moff: table<i64>;
var ac_mn: table<i64>;
var ac_mpar: table<i64>;
var ac_paroff: table<i64>;
var ac_mret: table<i64>;
var ac_mnames: table<i64>;   // 方法名 id 扁平段（声明顺序）
var ac_mnpars: table<i64>;   // 每方法参数个数扁平段
var ac_mptys: table<i64>;    // 每方法参数类型扁平段
var ac_mrets: table<i64>;    // 每方法返回类型扁平段
var ac_masync: table<i64>;   // 每方法是否 async（fire-and-forget；与 ac_mrets 同位对齐）
// actor 私有状态字段布局（行 = actor 索引；Step4b 起 per-actor state 真实槽位）：
//   ac_fnoff[actor] -> 字段名段偏移（ac_fnames）
//   ac_fncnt[actor] -> 字段个数
//   ac_ftyoff[actor]-> 字段类型段偏移（ac_ftys）
//   ac_fvoff[actor] -> 记录内字节偏移段偏移（ac_foffs；relative 到字段区基址）
// // 同一字段名/类型/偏移按下标对齐。record 固定头 + 字段区（8 字节对齐）。
var ac_fnoff: table<i64>;
var ac_fncnt: table<i64>;
var ac_ftyoff: table<i64>;
var ac_fvoff: table<i64>;
var ac_fnames: table<i64>;   // 字段名 id 扁平段（声明顺序）
var ac_ftys: table<i64>;     // 字段类型扁平段
var ac_foffs: table<i64>;    // 字段在记录内的字节偏移扁平段（含固定头）

// ==================== S2.4 port / impl 状态表（接口模型）====================
// port 表：pt_keys（port 名 id，升序）→ pt_vals（port 索引）。
// port 方法签名表（行 = port 索引）：
//   pm_off[port]  -> pm_names 段偏移（方法名 id，声明顺序 = vtable 字段序）
//   pm_n[port]    -> 方法个数
//   pm_npar[port] -> 方法参数个数表段偏移（pm_npars 扁平段，含 self）
//   pm_paroff[port] -> 参数类型段偏移（pm_ptys 扁平段）
//   pm_ret[port]  -> 返回类型表段偏移（pm_rets 扁平段）
// 方法 m 的签名：参数个数 = pm_npars[pm_npar + m]，参数段 =
// pm_ptys[pm_paroff + m .. +个数]，返回 = pm_rets[pm_ret + m]。
// 参数 0 恒为 self（接收者，类型 = 实现 struct 的占位——签名匹配时跳过）。
var pt_keys: table<i64>;      // port 名 id（升序，二分）
var pt_vals: table<i64>;      // port 索引
var pm_off: table<i64>;       // port 索引 -> 方法名段偏移（pm_names）
var pm_n: table<i64>;         // port 索引 -> 方法个数
var pm_npar: table<i64>;      // port 索引 -> 参数个数表段偏移（pm_npars）
var pm_paroff: table<i64>;    // port 索引 -> 参数类型段偏移（pm_ptys）
var pm_ret: table<i64>;       // port 索引 -> 返回类型表段偏移（pm_rets）
var pm_names: table<i64>;     // 方法名 id 扁平段（声明顺序 = vtable 字段序）
var pm_npars: table<i64>;     // 每方法参数个数（含 self）扁平段
var pm_ptys: table<i64>;      // 每方法参数类型扁平段（含 self 槽位，签名匹配跳过）
var pm_rets: table<i64>;      // 每方法返回类型扁平段
// p.9.11.21 interface 标记段（行 = port 索引）：0=port（S2.4 名义接口，实现
// 关系 = 显式 impl 块登记）；1=interface（结构性接口，实现关系 = 该类型命名
// 空间方法签名兼容，无需显式 impl——鸭子多态的类型安全升级）。
var pm_iface: table<i64>;     // port 索引 -> 1=interface 0=port
// impl 表：im_keys（升序键 = intern(port名 + "::" + struct名)）→ im_vals（impl 索引）。
// impl 记录（行 = impl 索引）：
//   im_port[impl]  -> port 索引
//   im_struct[impl] -> struct 索引
//   im_poff[impl]  -> im_mnames 段偏移（按 port 方法声明顺序的实现函数全名 id）
//   im_n[impl]     -> 方法个数（= port 方法数，完整性检查后恒等）
var im_keys: table<i64>;      // impl 键 id（升序，二分）
var im_vals: table<i64>;      // impl 索引
var im_port: table<i64>;      // impl 索引 -> port 索引
var im_struct: table<i64>;    // impl 索引 -> struct 索引
var im_poff: table<i64>;      // impl 索引 -> 方法实现全名段偏移（im_mnames）
var im_n: table<i64>;         // impl 索引 -> 方法个数
var im_mnames: table<i64>;    // 方法实现函数全名 id 扁平段（"Struct::method"）

// ==================== import 展开状态（semantic 主入口驱动）====================
var g_imported: table<string>;   // 已导入文件路径集合（去重/防环）
var g_extra_tops: table<i64>;    // 全部文件顶层语句 id（主 + 被导入；collect/查找统一遍历）
// dev33 批次10 任务29 跨文件宏：文件起源跟踪——顶层 StmtList 根 id → 文件 id
//（主文件 0，导入文件按展开顺序递增），供 mexpand 判定宏定义/调用所属文件，
// 实现 pub 宏跨文件可见、非 pub 宏同文件私有。
var g_file_roots: table<i64>;    // 顶层 StmtList 根 id → 文件 id
var g_file_count: i64 = 1;       // 已分配文件 id 数（主文件 0 占位）
// p.9.11.14 import 别名登记（平行表：别名 → 导入路径；编译单元内别名唯一，
// 重复 = 诊断）。别名同时经 M2.1.7 语义把被导入文件顶层 namespace 首段改名。
var g_imp_alias_names: table<string>;   // 别名（字符串）
var g_imp_alias_paths: table<string>;   // 对应导入路径（归一化）
// p.9.21.6-1 模块边界显式化（p921-prompt §1 第 1 步）：来源模块维度。
// 模块 = import 的文件（主文件 = 模块 0，导入文件按展开顺序 1..k）。
// g_file_base：每文件 AST 节点基址（升序）——文件 k 的节点 id ∈
// [g_file_base[k], g_file_base[k+1])（append_ast_mem 逐文件连续追加；
// expand_imports 推进）。file_id_of_node 对基址二分定位任意节点的来源模块。
var g_file_base: table<i64>;    // 文件 id -> 该文件首节点基址（升序；主文件 0）
// 符号表来源模块列（与各表行对齐；登记时由 def_node 反查文件 id）：
var sg_mod: table<i64>;         // 签名行来源模块（行号 = 签名 id，与 sg_* 对齐）
var gb_mod: table<i64>;         // 全局变量行来源模块（与 gb_keys/vals 行对齐）
var st_mod: table<i64>;         // struct 行来源模块（行号 = struct 索引，与 cls_* 对齐）

const S_N_INT_LIT: i64 = 0;
const S_N_FLOAT_LIT: i64 = 1;
const S_N_STR_LIT: i64 = 2;
const S_N_CHAR_LIT: i64 = 3;
const S_N_BOOL_LIT: i64 = 4;
const S_N_TRIT_LIT: i64 = 5;
const S_N_VAR: i64 = 6;
const S_N_CALL: i64 = 7;
const S_N_UNARY: i64 = 8;
const S_N_BINARY: i64 = 9;
const S_N_TERNARY: i64 = 10;
const S_N_RANGE: i64 = 11;
const S_N_TABLE_LIT: i64 = 12;
const S_N_INDEX: i64 = 13;
const S_N_TUPLE_LIT: i64 = 14;
const S_N_FIELD_ACCESS: i64 = 15;
const S_N_PATH: i64 = 16;
const S_N_TYPE_LIT: i64 = 17;
const S_N_METHOD_CALL: i64 = 18;
const S_N_TABLE_CELL: i64 = 19;
const S_N_TABLE_ID: i64 = 20;
const S_N_TUPLE_FIELD: i64 = 21;
const S_N_SEGMENT: i64 = 22;
const S_N_VAR_DECL: i64 = 100;
const S_N_FN_DEF: i64 = 101;
const S_N_EXPR_STMT: i64 = 102;
const S_N_ASSIGN: i64 = 103;
const S_N_RETURN: i64 = 104;
const S_N_IF: i64 = 105;
const S_N_WHILE: i64 = 106;
const S_N_FOR: i64 = 107;
const S_N_BREAK: i64 = 108;
const S_N_CONTINUE: i64 = 109;
const S_N_SWITCH: i64 = 110;
const S_N_IMPORT: i64 = 111;
const S_N_NAMESPACE: i64 = 112;
const S_N_USING: i64 = 113;
const S_N_STRUCT: i64 = 114;
const S_N_FIELD_ASSIGN: i64 = 115;
const S_N_INDEX_ASSIGN: i64 = 116;
const S_N_EXTERN: i64 = 117;
const S_N_PARAM: i64 = 118;
const S_N_SWITCH_CASE: i64 = 120;
const S_N_PATTERN_LIST: i64 = 121;
const S_N_STMTLIST: i64 = 122;
const S_N_CLASS_FIELD: i64 = 123;
const S_N_TUPLE_TYPE_FIELD: i64 = 124;
const S_N_NAMED_TYPE: i64 = 200;
const S_N_TUPLE_TYPE: i64 = 201;
const S_N_STRUCT_TYPE: i64 = 202;
const S_N_TABLE_TYPE: i64 = 203;
const S_N_MAP_TYPE: i64 = 204;
// 泛型语法节点（2026-08-14，与 ast.tie 同号权威）：N_TYPE_PARAMS（声明点
// 类型参数列表）/ N_TYPE_PARAM（单个类型参数）/ N_TYPE_ARGS（使用点类型
// 实参列表）。语义层在 FnDef/Struct/Call/MethodCall/StructType 的 children
// 头部读取「泛型槽」时用这三个常量判定（配合 sstate.slot_off 统一偏移）。
const S_N_TYPE_PARAMS: i64 = 125;
const S_N_TYPE_PARAM: i64 = 126;
const S_N_TYPE_ARGS: i64 = 127;
const S_N_ENUM: i64 = 128;
const S_N_ENUM_VARIANT: i64 = 129;
const S_N_UNSAFE_BLOCK: i64 = 130;  // unsafe 块（S1.2 U3）
const S_N_ASM: i64 = 131;           // asm! 内联汇编（S1.2 I1）
const S_N_TRY: i64 = 133;           // ? 后缀解包（S2.3，与 ast.tie N_TRY 同号）
const S_N_PANIC: i64 = 134;         // panic 语句（S2.3，与 ast.tie N_PANIC 同号）
const S_N_FN_LIT: i64 = 132;        // func 字面量（S2.2 闭包，与 ast.tie N_FN_LIT 同号）
const S_N_CALL_EXPR: i64 = 148;     // 调用表达式（P2a，与 ast.tie N_CALL_EXPR 同号）
const S_N_FN_TYPE: i64 = 205;       // 函数值类型（S2.2，与 ast.tie N_FN_TYPE 同号）
const S_N_ARRAY_TYPE: i64 = 206;    // L1 定长数组类型（与 ast.tie N_ARRAY_TYPE 同号）
// S2.4 port 接口模型（与 ast.tie N_PORT/N_IMPL 同号权威）：
//   编号 138/139：与 S3.3 宏节点（135-137）错开（整合时统一，见 ast.tie）。
const S_N_PORT: i64 = 138;          // port 声明：Port[name=port 名, children=[泛型槽(-1), 方法 FnDef...]]
const S_N_IMPL: i64 = 139;          // impl 块：Impl[children=[port 类型, struct 类型, 方法 FnDef...]]
// S3.3 宏/元编程（与 ast.tie 同号）：
const S_N_MACRO_DEF: i64 = 135;     // 宏定义（M3）
const S_N_CODE_LIT: i64 = 136;      // 准引用字面量（C1）
const S_N_CODE_INTERP: i64 = 137;   // 插值表达式（$x / $(expr)）
// 一期并发 actor（与 ast.tie N_ACTOR 同号）：
const S_N_ACTOR: i64 = 141;         // actor 声明：Actor[name=actor 名, aux=items 数,
                                    //   children=[字段 ClassField..., 方法 FnDef...]]
                                    //   （方法 async 标记经 FnDef val bit2）
const S_N_RUN_ACTOR: i64 = 142;     // run 表达式（run 上下文识别，非保留字）
// 三期 goto/标签（与 ast.tie N_GOTO_LABEL/N_GOTO 同号）：
const S_N_GOTO_LABEL: i64 = 143;    // `#[tag.x]` 语句位置标签
const S_N_GOTO: i64 = 144;          // `unsafe goto #x` 无条件跳转
const S_N_GUARD_STMT: i64 = 153;    // p.8.2.11 guard else 早退（与 ast.tie N_GUARD_STMT 同号）
const S_N_SWITCH_EXPR: i64 = 156;   // p.9.10.1 match/switch 表达式（与 ast.tie 同号）
const S_N_TRY_BLOCK: i64 = 157;     // p.9.11.3 try 错误聚合块（与 ast.tie N_TRY_BLOCK 同号）
const S_N_DEFER: i64 = 158;         // p.9.11.4 defer 资源释放（与 ast.tie N_DEFER 同号）
const S_N_TYPE_ALIAS: i64 = 160;    // p.9.11.32 类型别名（与 ast.tie N_TYPE_ALIAS 同号）
const S_N_YIELD: i64 = 161;         // p.9.11.15 yield 产出语句（与 ast.tie N_YIELD 同号）
// 三期 A 组 guard<cap> 凭据（与 ast.tie N_GUARD_GET/N_GUARD_USE/N_GUARD_WITH 同号）
const S_N_GUARD_GET: i64 = 145;     // `unsafe.get(share)` 取得凭据（表达式）
const S_N_GUARD_USE: i64 = 146;     // `unsafe use g { ... }` 持证越界块
const S_N_GUARD_WITH: i64 = 147;    // `unsafe with(share) { ... }` 临时凭据块
namespace sstate {


// ==================== S1.5 移动语义：变量 live/moved 状态 ====================
// 独立升序表 lv_moved：存在即 moved（复用 bs_find 二分）。函数边界（check_fn
// 入口）调用 lv_moved_reset 清空；赋值/按值传参/返回移动时 lv_moved_mark 登记；
// 读取变量前 lv_moved_is 查询——moved 则报 "use of moved value"。
// 表为独立存储（不并入 lv_* 并行表）：S1.2-1.4 并行会话在改 sinfer 的
// lv_insert 五表同步，本表由 scheck/sinfer 额外维护，避免与该同步耦合。


// ==================== 泛型模板登记辅助（T3b 单态化展开器预置）====================


// ==================== S2.4 port / impl 登记辅助 ====================


// ==================== 实例化记录辅助（T3b 单态化展开器）====================


// v2 数组长度上限（内存安全护栏）：定长数组元素数不得超过此值——超过即拒绝，
// 防超大数组拖垮 LLVM 后端/clang（既有已知边界 N≥65536 编译崩溃，取 2^18 作
// 全局硬上限，留足容量池语义余量）。可调：与容量档位族共同治理。
const MAX_ARRAY_LEN: i64 = 262144


}

