type tie<class>
// compiler/frontend/sinfer_q2_q1.tie —— 分片 1（p.9.21.3 单文件 ≤800 行）
// ============================================================
// 只搬函数与紧邻注释；顶层全局 var 与 import 树仍留在 sinfer_q2.tie。
// 顶层函数保持顶层身份（跨 ns 裸调依赖），ns 内函数按上下文包 namespace。
namespace sinfer {
pub func infer_expr(id: i64) -> i64 {
    var tag = s_tags[id]
    // p.8.2.10 展开实参兜底：N_SPREAD_ARG 节点被当作独立表达式推断 = 其调用
    // 语境不受支持（方法/枚举构造/闭包调用/泛型等）。支持的普通变参调用已在
    // sinfer_ret.infer_call 显式处理（不会走到这里）。此处报诊断防崩溃。
    if tag == N_SPREAD_ARG {
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "展开实参 `...` 仅支持用于带变长形参 `...T` 的普通函数调用；当前调用语境不支持展开"
        return -1
    }
    // p.8.2.5 表/数组推导式：`[expr for x in src if cond]` → table<ElemTy>。
    // 校验源为表族、if 条件为 bool；循环变量以源表元素类型登记（解构形态在
    // 解析期已改写为 `_cN.ItemK`，此处只需登记临时变量 `_cN` 为源元素类型）。
    if tag == N_COMPREHENSION {
        var cvname = sstate.name_str(id)
        var cvnid = intern.intern(cvname)
        var csrc = sstate.child(id, 0)
        var celem = sstate.child(id, 1)
        var ccond = sstate.child(id, 2)
        var cst = infer_expr(csrc)
        if cst < 0 {
            return -1
        }
        // p.9.11.16 迭代器协议源：struct 实现 has_next/next → 循环变量元素 =
        // next 返回类型（与 for-in 消费分派一致）。协议未命中 → 表/数组源。
        var celem_loop: i64 = types.named(TK_I64)
        if !types.is_table(cst) {
            var ip_c = iter_proto_elem(cst)
            if ip_c >= 0 {
                celem_loop = ip_c
                lv_insert(cvnid, celem_loop, 0, -1, 0)
                var celem_ty = infer_expr(celem)
                if celem_ty < 0 {
                    return -1
                }
                if ccond >= 0 {
                    var ccond_ty = infer_expr(ccond)
                    if ccond_ty < 0 {
                        return -1
                    }
                    if ccond_ty != types.named(TK_BOOL) {
                        sm_err_line = s_lines[id]
                        sm_err_col = s_cols[id]
                        sm_err_msg = "推导式 if 筛选条件必须是 bool，实际是 " + types.type_name(ccond_ty)
                        return -1
                    }
                }
                node_types[id] = types.table_of(celem_ty)
                g_typed = g_typed + 1
                return types.table_of(celem_ty)
            }
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "推导式迭代源必须是表/数组或迭代器协议对象（struct 实现 has_next/next），实际是 " + types.type_name(cst)
            return -1
        }
        var cte = types.table_elem(cst)
        if cte >= 0 {
            celem_loop = cte
        }
        // 登记循环变量（源元素类型；解构临时变量同此登记——字段访问再取 ItemK）
        lv_insert(cvnid, celem_loop, 0, -1, 0)
        var celem_ty = infer_expr(celem)
        if celem_ty < 0 {
            return -1
        }
        if ccond >= 0 {
            var ccond_ty = infer_expr(ccond)
            if ccond_ty < 0 {
                return -1
            }
            if ccond_ty != types.named(TK_BOOL) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "推导式 if 筛选条件必须是 bool，实际是 " + types.type_name(ccond_ty)
                return -1
            }
        }
        node_types[id] = types.table_of(celem_ty)
        g_typed = g_typed + 1
        return types.table_of(celem_ty)
    }
    // 字面量
    if tag == 0 {
        // S1.3 L3 后缀字面量：aux = 后缀类型 TyKw（-1 = 无后缀 → i64）
        // 批次 2（i128/u128）：后缀类型含 TK_I128(21)/TK_U128(22)——
        // 原 `sfx <= 9` 只覆盖 i8..f64，i128/u128 会落默认 i64 槽。
        var sfx = s_aux[id]
        if (sfx >= 0 && sfx <= 9) || sfx == TK_I128 || sfx == TK_U128 {
            node_types[id] = types.named(sfx)
            g_typed = g_typed + 1
            return types.named(sfx)
        }
        node_types[id] = types.named(TK_I64)
        g_typed = g_typed + 1
        return types.named(TK_I64)
    }
    if tag == 1 {
        // S1.3 L3 浮点后缀：aux = f32(8)/f64(9)（parser 已定，无后缀默认 f64）
        var sfx2 = s_aux[id]
        if sfx2 == TK_F32 {
            node_types[id] = types.named(TK_F32)
            g_typed = g_typed + 1
            return types.named(TK_F32)
        }
        node_types[id] = types.named(TK_F64)
        g_typed = g_typed + 1
        return types.named(TK_F64)
    }
    if tag == 2 {
        node_types[id] = types.named(TK_STR)
        g_typed = g_typed + 1
        return types.named(TK_STR)
    }
    if tag == 3 {
        node_types[id] = types.named(TK_CHAR)
        g_typed = g_typed + 1
        return types.named(TK_CHAR)
    }
    if tag == 4 {
        node_types[id] = types.named(TK_BOOL)
        g_typed = g_typed + 1
        return types.named(TK_BOOL)
    }
    if tag == 5 {
        node_types[id] = types.named(TK_TRIT)
        g_typed = g_typed + 1
        return types.named(TK_TRIT)
    }
    // S3.3 准引用/插值表达式：code 类型（编译期 AST 片段值）。宏体不经过
    // 语义检查（编译期由 interp 执行）；普通代码里 code 值被 scheck 的
    // 变量类型检查/参数类型匹配拦截（code 只能在宏中使用）。
    if tag == 136 {   // N_CODE_LIT（准引用字面量）
        node_types[id] = types.named(TK_CODE)
        g_typed = g_typed + 1
        return types.named(TK_CODE)
    }
    if tag == 137 {   // N_CODE_INTERP（插值表达式）
        node_types[id] = types.named(TK_CODE)
        g_typed = g_typed + 1
        return types.named(TK_CODE)
    }
    // Var
    if tag == S_N_VAR {
        var nm = sstate.name_str(id)
        var nid = intern.intern(nm)
        var lt = lv_find(nid)
        if lt >= 0 {
            // S2.2 闭包捕获分析：闭包体检查期间（g_clo_depth > 0）引用变量，
            // 且该变量既非闭包参数（cl_params 段）、也非闭包体内局部（cl_locals
            // 段）→ 属于登记时快照中的外层变量 → 捕获。登记 (名 id, 类型 id)
            // 到 cl_capkeys/cl_capvals（当前闭包段内查重，重复引用只登记一次）。
            if g_clo_depth > 0 && g_clo_cur >= 0 {
                var ci = g_clo_cur
                var is_param = sstate.seg_has(cl_params, cl_paramoff[ci], cl_nparams[ci], nid)
                if is_param == 0 {
                    var is_local = sstate.seg_has(cl_locals, cl_locloff[ci], len(cl_locals) - cl_locloff[ci], nid)
                    if is_local == 0 {
                        var is_cap = sstate.seg_has(cl_capkeys, cl_capoff[ci], len(cl_capkeys) - cl_capoff[ci], nid)
                        if is_cap == 0 {
                            table_push(cl_capkeys, nid)
                            table_push(cl_capvals, lt)
                        }
                    }
                }
            }
            node_types[id] = lt
            g_typed = g_typed + 1
            return lt
        }
        var gt = gb_find_ns(nid)
        if gt >= 0 {
            node_types[id] = gt
            g_typed = g_typed + 1
            return gt
        }
        // S2.2 命名函数提升：变量查找失败后查函数签名（裸名 + 命名空间补全），
        // 命中 → 构造 fn 类型（命名函数名可直接用作函数值，如 `var f: fn(A)->R
        // = my_func`）。泛型模板（gt_find）暂不提升（单态化后函数值未定义）。
        var full_f = resolve_call_name(nm)
        var fsig = sstate.fn_sig(full_f)
        if fsig >= 0 {
            var fret = sg_ret[fsig]
            var fnp = sg_nparams[fsig]
            var foff = sg_off[fsig]
            var fpts: table<i64> = table_new_i64()
            var k2: i64 = 0
            while k2 < fnp {
                table_push(fpts, sp_tys[foff + k2])
                k2 = k2 + 1
            }
            var fnty = types.fn_of(fret, fpts)
            node_types[id] = fnty
            g_typed = g_typed + 1
            return fnty
        }
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "未声明的变量 '" + nm + "'"
        return -1
    }
    // Range
    if tag == S_N_RANGE {
        var st = infer_expr(sstate.child(id, 0))
        if st < 0 {
            return -1
        }
        var en = infer_expr(sstate.child(id, 1))
        if en < 0 {
            return -1
        }
        if !types.is_int(st) || !types.is_int(en) {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "范围两端必须是整数"
            return -1
        }
        node_types[id] = types.named(TK_I64)
        g_typed = g_typed + 1
        return types.named(TK_I64)
    }
    // Unary
    if tag == S_N_UNARY {
        var op = s_vals[id]
        var operand = infer_expr(sstate.child(id, 0))
        if operand < 0 {
            return -1
        }
        if op == 0 {
            // Neg：数字；trit 也允许（平衡取反 -1t/-(trit)，-1↔1、0 保持）
            // p.8.2.4：操作数为用户 struct 且声明 op_neg → 重写为方法调用。
            var ngres = try_op_overload_neg(sstate.child(id, 0), id)
            if ngres >= 0 {
                return ngres
            }
            if ngres < 0 && ngres != -2 {
                return -1
            }
            if !types.is_number(operand) && operand != types.named(TK_TRIT) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "取负运算的操作数必须是数字"
                return -1
            }
        } else if op == 1 {
            // Not：bool 或 trit
            if !types.is_bool_like(operand) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "逻辑非的操作数必须是 bool"
                return -1
            }
        } else {
            // 自增/自减：可写数字变量
            var target = sstate.child(id, 0)
            if s_tags[target] != S_N_VAR {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "自增/自减的操作数必须是可写数字变量"
                return -1
            }
            var nm = sstate.name_str(target)
            var nid2 = intern.intern(nm)
            if lv_const_of(nid2) == 1 {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "不能对 const 变量 '" + nm + "' 自增/自减"
                return -1
            }
            // p.9.11.11 immut 只读形参：自增/自减亦为重写，拒绝。
            if sstate.im_is(nid2) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "不能对 immut 形参 '" + nm + "' 自增/自减；immut 形参只读"
                return -1
            }
            if !types.is_number(operand) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "自增/自减的操作数必须是可写数字变量"
                return -1
            }
        }
        node_types[id] = operand
        g_typed = g_typed + 1
        return operand
    }
    // Binary
    if tag == S_N_BINARY {
        var op = s_vals[id]
        // P1 数据流箭头：非算术/比较——先分派（裸 Var 目标：fn → 传参 /
        // 变量 → 赋值；调用/下标/字段目标已在解析器脱糖，不达此处）
        if op == B_ARROW_FWD || op == B_ARROW_REV {
            return infer_arrow(id, op)
        }
        var lhs = infer_expr(sstate.child(id, 0))
        if lhs < 0 {
            return -1
        }
        var rhs = infer_expr(sstate.child(id, 1))
        if rhs < 0 {
            return -1
        }
        // p.8.2.4 运算符重载：任一操作数为用户 struct 且声明对应 op_ 方法 →
        // 重写为方法调用（返回方法返回类型）；否则 -2 沿用原算术/比较路径。
        var ores = try_op_overload_binary(op, sstate.child(id, 0), sstate.child(id, 1), id)
        if ores >= 0 {
            return ores
        }
        if ores < 0 && ores != -2 {
            return -1
        }
        // 枚举 ==/!= 比较拦截（一期）：枚举按 tag 比较语义未定义，报错
        if op == 5 || op == 6 {
            if types.kind(lhs) == K_ENUM || types.kind(rhs) == K_ENUM {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "枚举暂不支持 == 比较"
                return -1
            }
        }
        // 两侧类型一致（trit×i64 例外；int×float 混用；string+string 拼接）
        var type_ok: bool = false
        if lhs == rhs {
            type_ok = true
        } else if op == 20 && option_payload_ty(lhs) >= 0 {
            // p.8.1.5 `?:` 安全默认值：Option<T> ?: T——类型兼容由下方特判校验
            type_ok = true
        } else if types.is_bool_like(lhs) && types.is_bool_like(rhs) {
            type_ok = true
        } else if lhs == TK_TRIT && types.is_int(rhs) {
            type_ok = true
        } else if rhs == TK_TRIT && types.is_int(lhs) {
            type_ok = true
        } else if types.is_int(lhs) && types.is_int(rhs) {
            type_ok = true
        } else if types.is_float(lhs) && types.is_float(rhs) {
            type_ok = true
        } else if types.is_int(lhs) && types.is_float(rhs) {
            type_ok = true
        } else if types.is_float(lhs) && types.is_int(rhs) {
            type_ok = true
        } else if op == 0 && lhs == TK_STR && rhs == TK_STR {
            // 字符串拼接
            type_ok = true
        } else if op >= 5 && op <= 10 && types.kind(lhs) == K_TUPLE &&
            types.kind(rhs) == K_TUPLE && stype.tuple_equal(lhs, rhs) {
            // 元组比较：结构相等（逐字段类型一致，嵌套元组递归）即合法——
            // `(1,2) == (1,2)` 两侧各登记独立 tuple 类型 id，须按字段结构
            // 比较（对齐 Rust 行为）；==/!= 放行，< > <= >= 在下文 op 分组
            // 检查中报「比较运算符不能用于 tuple」
            type_ok = true
        } else if op >= 5 && op <= 10 && types.is_ptr(lhs) && types.is_ptr(rhs) {
            // p.6.8.1 指针比较：==/!= 允许任意元素类型（地址等值比较）；< > <= >=
            // 由比较运算符分组（op 5/6 之外）拒绝——指针是地址值，元素类型不影响
            // 地址是否相等。
            type_ok = true
        }
        if !type_ok {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "二元运算两侧类型不一致：" + types.type_name(lhs) + " 与 " + types.type_name(rhs)
            return -1
        }
        // 按运算符分组校验
        if op <= 4 || op == 13 || op == 14 || op == 15 || op == 16 || op == 17 ||
            (op >= 21 && op <= 23) {
            // 算术/位运算：数字（位运算需整数）；p.9.11.9 checked 运算（21/22/23）仅整数
            if !types.is_number(lhs) && lhs != TK_STR && !(lhs == TK_TRIT || rhs == TK_TRIT) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "算术运算符不能用于 " + types.type_name(lhs)
                return -1
            }
            // p.9.11.9 checked 运算溢出检测仅对整数有效（f64 溢出 = inf 不属于
            // checked 溢出语义；trit 饱和算术也无溢出可言）——非整数报错。
            if op >= 21 && op <= 23 && !types.is_int(lhs) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "checked 运算（+?/-?/*?）只支持整数，不能用于 " + types.type_name(lhs)
                return -1
            }
            if op >= 13 && !types.is_int(lhs) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "位运算只支持整数，不能用于 " + types.type_name(lhs)
                return -1
            }
            // S1.3 B2 移位语义（r.1.4.3）：**编译期常量**移位量必须在
            // 0..操作数位宽 范围内——负数移位/越界移位 = 编译错误（负例
            // shift_neg_free 未拒根因）。运行期变量移位量保持既有定义行为
            // （llvmgen & 63 掩码 / 窄类型 select 保护，shift_bound 探针不变）。
            // i128 常量移位（1i128 << 100/127）按 128 位宽放行。
            if op == 16 || op == 17 {
                var sc = sstate.child(id, 1)
                var cnt: i64 = 0
                var is_const: bool = false
                if s_tags[sc] == S_N_INT_LIT {
                    cnt = s_vals[sc]
                    is_const = true
                } else if s_tags[sc] == S_N_UNARY && s_vals[sc] == 0 {
                    // -N 字面量（U_NEG 包 IntLit）
                    var oc = sstate.child(sc, 0)
                    if s_tags[oc] == S_N_INT_LIT {
                        cnt = 0 - s_vals[oc]
                        is_const = true
                    }
                }
                if is_const {
                    var w = stype.int_width(lhs)
                    if w > 0 && (cnt < 0 || cnt >= w) {
                        sm_err_line = s_lines[id]
                        sm_err_col = s_cols[id]
                        sm_err_msg = "移位量超出操作数位宽（" + to_string(w) + " 位，当前 " + to_string(cnt) + "）"
                        return -1
                    }
                }
            }
            if op == 4 && !types.is_int(lhs) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "取模运算只支持整数"
                return -1
            }
        } else if op <= 10 {
            // 比较：数字/字符串/bool/trit；元组仅 ==/!=（逐字段），< > <= >= 仍报错；
            // ptr 仅 ==/!=（typed ptr 一等指针相等门禁，p.6.8.1）
            if types.kind(lhs) == K_TUPLE || types.is_ptr(lhs) {
                if op == 5 || op == 6 {
                    // 元组/指针相等比较：合法（结果 bool，rt 在下方比较分支统一处理；
                    // 指针经 ptrtoint 后整数比较，见 tig_binary_ptr）
                } else {
                    sm_err_line = s_lines[id]
                    sm_err_col = s_cols[id]
                    sm_err_msg = "比较运算符不能用于 " + types.type_name(lhs)
                    return -1
                }
            } else if !types.is_number(lhs) && lhs != TK_STR && !types.is_bool_like(lhs) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "比较运算符不能用于 " + types.type_name(lhs)
                return -1
            }
        } else if op <= 12 {
            // 逻辑：bool 或 trit
            if !types.is_bool_like(lhs) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "逻辑运算符两侧必须是 bool（或两侧同为 trit）"
                return -1
            }
        } else if op == 20 {
            // p.8.1.5 `?:` 安全默认值：Option<T> ?: T → T（Some 解包 / None 用默认值）
            var opt_pt = option_payload_ty(lhs)
            if opt_pt < 0 {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "'?:' 左侧必须是 Option<T>（Some/None 形态枚举），实际是 " + types.type_name(lhs)
                return -1
            }
            var rhs_node = sstate.child(id, 1)
            if !stype.types_compatible(opt_pt, rhs) && !stype.types_match(opt_pt, rhs, rhs_node) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "'?:' 右侧类型 " + types.type_name(rhs) + " 与 Option 载荷 " + types.type_name(opt_pt) + " 不匹配"
                return -1
            }
            node_types[id] = opt_pt
            g_typed = g_typed + 1
            return opt_pt
        }
        // p.6.9.15 警告（核心消息与 diagcode 警告目录逐字一致）：
        // W0001 浮点相等比较（==/!= 对 f64/f32）；W0002 整数除法截断。
        if op == 5 || op == 6 {
            if types.is_float(lhs) && types.is_float(rhs) {
                sm_warn_add(s_lines[id], s_cols[id], "浮点相等比较（==/!= 对 f64/f32 结果不可靠）")
            }
        }
        if op == 3 {
            if types.is_int(lhs) && types.is_int(rhs) {
                sm_warn_add(s_lines[id], s_cols[id], "整数除法结果截断（如 7/2 == 3）")
            }
        }
        // W00027：整数除法 / 取模的除数为「字面量 0」→ 运行期崩溃
        //（LLVM sdiv/srem 除数为 0 未定义行为）。仅整数运算（op 3=除法，4=取模；
        // 浮点除 0 得 inf，不崩，故不报）；除数是字面量才可静态判定，非字面量不报。
        if op == 3 || op == 4 {
            if types.is_int(lhs) && types.is_int(rhs) {
                var w27r = sstate.child(id, 1)
                if s_tags[w27r] == S_N_INT_LIT && s_vals[w27r] == 0 {
                    sm_warn_add(s_lines[id], s_cols[id], "整数除零（字面量 0 作除数，运行期崩溃）")
                }
            }
        }
        var rt = lhs
        if types.is_int(lhs) && types.is_float(rhs) {
            rt = rhs
        }
        if types.is_float(lhs) && types.is_int(rhs) {
            rt = lhs
        }
        // S1.3 A1 混合宽度整数运算：结果 = 宽度更大者（i8 + i16 → i16 算术；
        // i8 + u16 → 16 位算术。同宽度 i/u 混合 → 保持 lhs（LLVM 位模式一致，
        // 无符号性区分——与 tie 现状有符号语义保持一致）。
        // L2 上下文推断：字面量侧常量在对方窄类型范围内 → 按对方类型
        // （`f + 1`：f 是 u8，常量 1 在 u8 范围 → u8 算术，结果 u8）
        if types.is_int(lhs) && types.is_int(rhs) {
            var l_node = sstate.child(id, 0)
            var r_node = sstate.child(id, 1)
            var l_lit = s_tags[l_node] == 0
            var r_lit = s_tags[r_node] == 0
            var lw = stype.int_width(lhs)
            var rw = stype.int_width(rhs)
            if l_lit && !r_lit {
                // 左字面量、右变量：左常量在右类型范围 → 右类型；否则宽者
                if lit_in_range(s_vals[l_node], rhs) {
                    rt = rhs
                } else {
                    // W00018：字面量落在窄类型范围外（i64 不会溢出，不报）
                    if rw < 64 {
                        sm_warn_add(s_lines[id], s_cols[id], "大整数字面量溢出风险（超出目标窄类型范围）")
                    }
                    if rw > lw {
                        rt = rhs
                    } else {
                        rt = lhs
                    }
                }
            } else if r_lit && !l_lit {
                // 右字面量、左变量：右常量在左类型范围 → 左类型；否则宽者
                if lit_in_range(s_vals[r_node], lhs) {
                    rt = lhs
                } else {
                    if lw < 64 {
                        sm_warn_add(s_lines[id], s_cols[id], "大整数字面量溢出风险（超出目标窄类型范围）")
                    }
                    if lw > rw {
                        rt = lhs
                    } else {
                        rt = rhs
                    }
                }
            } else if !l_lit && !r_lit {
                // 两侧变量：宽者
                if rw > lw {
                    rt = rhs
                } else {
                    rt = lhs
                }
            }
            // 两侧字面量：无上下文 → 保持 i64（默认），由目标标注截断
        }
        // S1.3 f32 算术：f32 与 f64 混合 → f64；f32+f32 → 提升 f64 计算
        // （f32 仅 extern/repr(C) 互操作，算术统一 f64——int-model 未决问题 1）
        if (lhs == TK_F32 || rhs == TK_F32) && (lhs == TK_F64 || rhs == TK_F64) {
            rt = types.named(TK_F64)
        }
        // trit × i64 混合（t + 5 / 5 - t）：结果 i64（irgen 生成 i64 运算并
        // sext trit 侧——曾按 lhs 标 TK_TRIT，IR 结果 i64 却被当 i8 转换/打印）
        if lhs == TK_TRIT && types.is_int(rhs) {
            rt = rhs
        }
        if rhs == TK_TRIT && types.is_int(lhs) {
            rt = lhs
        }
        if op <= 10 && op >= 5 {
            // 比较/逻辑：结果 bool
            rt = types.named(TK_BOOL)
        }
        node_types[id] = rt
        g_typed = g_typed + 1
        return rt
    }
    // Ternary
    if tag == S_N_TERNARY {
        var cond = infer_expr(sstate.child(id, 0))
        if cond < 0 {
            return -1
        }
        if !types.is_bool_like(cond) {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "三目条件必须是 bool"
            return -1
        }
        var th = infer_expr(sstate.child(id, 1))
        if th < 0 {
            return -1
        }
        var el = infer_expr(sstate.child(id, 2))
        if el < 0 {
            return -1
        }
        if th != el && !(types.is_int(th) && types.is_int(el)) && !(types.is_float(th) && types.is_float(el)) {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "三目两分支类型不一致：" + types.type_name(th) + " 与 " + types.type_name(el)
            return -1
        }
        node_types[id] = th
        g_typed = g_typed + 1
        return th
    }
    // p.9.10.1 match/switch 表达式：分支体为表达式，整体取值。复用语句位
    // switch 的模式/守卫/穷尽检查（scheck.check_arm_patterns / check_enum_exhaustive），
    // 仅分支体改走 infer_expr 收集共同类型。布局见 ast.tie N_SWITCH_EXPR。
    if tag == S_N_SWITCH_EXPR {
        var subj = infer_expr(sstate.child(id, 0))
        if subj < 0 {
            return -1
        }
        if !types.is_number(subj) && !types.is_bool_like(subj) && subj != TK_STR &&
            subj != TK_CHAR && types.kind(subj) != K_ENUM && subj != types.named(TK_ANY) {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "switch 表达式对象仅支持数字、布尔、字符、字符串、枚举或 any 类型，实际是 " + types.type_name(subj)
            return -1
        }
        scheck.reset_case_seen()
        var ncases2 = s_aux[id]
        var res_ty: i64 = -1
        var k2: i64 = 0
        while k2 < ncases2 {
            var c = sstate.child(id, 1 + k2)
            var rp = scheck.check_arm_patterns(c, subj)
            if rp < 0 {
                return -1
            }
            var bty = infer_expr(sstate.child(c, 2))
            if bty < 0 {
                return -1
            }
            if res_ty < 0 {
                res_ty = bty
            } else if bty != res_ty && !(types.is_int(bty) && types.is_int(res_ty)) && !(types.is_float(bty) && types.is_float(res_ty)) {
                sm_err_line = s_lines[c]
                sm_err_col = s_cols[c]
                sm_err_msg = "switch 表达式各分支类型不一致：" + types.type_name(bty) + " 与 " + types.type_name(res_ty)
                return -1
            }
            k2 = k2 + 1
        }
        var has_wild = s_vals[id] == 1
        if has_wild {
            var dty = infer_expr(sstate.child(id, 1 + ncases2))
            if dty < 0 {
                return -1
            }
            if res_ty < 0 {
                res_ty = dty
            } else if dty != res_ty && !(types.is_int(dty) && types.is_int(res_ty)) && !(types.is_float(dty) && types.is_float(res_ty)) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "switch 表达式通配臂类型不一致：" + types.type_name(dty) + " 与 " + types.type_name(res_ty)
                return -1
            }
        } else if types.kind(subj) == K_ENUM {
            var re = scheck.check_enum_exhaustive(subj, id)
            if re < 0 {
                return -1
            }
        }
        if res_ty < 0 {
            res_ty = types.named(TK_I64)
        }
        node_types[id] = res_ty
        g_typed = g_typed + 1
        return res_ty
    }
    // Path：命名空间常量引用（ns::NAME → 全名查全局 gb_*）或不能作值
    if tag == S_N_PATH {
        // Path 名字在 Segment children 中（name 字段为空），拼接完整路径
        var pname = recv_path_name(id)
        // p.9.12.4：命名空间内 const 以全名登记 gb_*，`ns::NAME` 路径作值
        // 引用即为该全局常量（i64/string/f64/bool 标量；表/函数路径不在此列）
        var pnid = intern.intern(pname)
        var pgt = gb_find(pnid)
        if pgt >= 0 {
            node_types[id] = pgt
            g_typed = g_typed + 1
            return pgt
        }
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "命名空间路径 '" + pname + "' 不能作为值使用（只能用于调用，如 'x::f()'）"
        return -1
    }
    // TypeLit：仅 switch case
    if tag == S_N_TYPE_LIT {
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "类型字面量只能用作 switch 的 case 类型匹配"
        return -1
    }
    // S1.2 I1 asm!：unsafe 上下文 + 操作数表达式推断；返回 void
    if tag == S_N_ASM {
        if g_unsafe_depth == 0 {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "asm! 内联汇编必须在 unsafe 块或 unsafe 函数中使用（安全代码禁止触底）"
            return -1
        }
        var nc = sstate.nchild(id)
        var k: i64 = 0
        while k < nc {
            var op = sstate.child(id, k)
            if s_vals[op] == 3 {
                // target("arch") 平台条件编译标注（任务17）：非表达式操作数，跳过
                k = k + 1
                continue
            }
            var e = sstate.child(op, 0)
            var ot = infer_expr(e)
            if ot < 0 {
                return -1
            }
            k = k + 1
        }
        node_types[id] = types.named(TK_VOID)
        g_typed = g_typed + 1
        return types.named(TK_VOID)
    }
    // Index
    if tag == S_N_INDEX {
        var base = infer_expr(sstate.child(id, 0))
        if base < 0 {
            return -1
        }
        var idx = infer_expr(sstate.child(id, 1))
        if idx < 0 {
            return -1
        }
        if types.is_array(base) {
            // L1 定长数组 a[i]：元素类型 = array_elem(base)；索引必须是整数。
            // 编译期常量越界（负/超长）直接拒绝；动态索引 v1 默认零检查
            //（--check-bounds 调试开关见 1.4，暂未接线）。
            if !types.is_int(idx) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "数组下标必须是整数，实际是 " + types.type_name(idx)
                return -1
            }
            var (ci, cv) = stype.arr_const_index(sstate.child(id, 1))
            if ci {
                if cv < 0 {
                    sm_err_line = s_lines[id]
                    sm_err_col = s_cols[id]
                    sm_err_msg = "数组下标越界：索引为负数"
                    return -1
                }
                if cv >= types.array_len(base) {
                    sm_err_line = s_lines[id]
                    sm_err_col = s_cols[id]
                    sm_err_msg = "数组下标越界：索引 " + to_string(cv) + " ≥ 长度 " + to_string(types.array_len(base))
                    return -1
                }
            }
            node_types[id] = types.array_elem(base)
            g_typed = g_typed + 1
            return types.array_elem(base)
        }
        if types.is_table(base) {
            var elem = types.table_elem(base)
            if elem < 0 {
                // 表变量：查 var_table_elem
                var base_node = sstate.child(id, 0)
                if s_tags[base_node] == S_N_VAR {
                    var nm = sstate.name_str(base_node)
                    var nid = intern.intern(nm)
                    var te = var_table_elem(nid)
                    if te >= 0 {
                        node_types[id] = te
                        g_typed = g_typed + 1
                        return te
                    }
                }
                // 裸 table：元素类型未知，默认 i64
                node_types[id] = types.named(TK_I64)
                g_typed = g_typed + 1
                return types.named(TK_I64)
            }
            node_types[id] = elem
            g_typed = g_typed + 1
            return elem
        }
        if base == TK_STR {
            if !types.is_int(idx) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "下标必须是整数，实际是 " + types.type_name(idx)
                return -1
            }
            // 对齐 Rust 版：s[i] → 取第 i 个字符（char），非 string
            node_types[id] = types.named(TK_CHAR)
            g_typed = g_typed + 1
            return types.named(TK_CHAR)
        }
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "下标访问的对象必须是表或字符串，实际是 " + types.type_name(base)
        return -1
    }
    // p.9.11.7 切片 `t[1..3]`：结果类型 = 表/数组 → 同元素类型的新表 table<elem>
    //（仅起点不取元素）；字符串 → string（字节子串）。端点须为整数或缺省(-1)。
    if tag == N_SLICE {
        var sbase = infer_expr(sstate.child(id, 0))
        if sbase < 0 {
            return -1
        }
        var s1 = sstate.child(id, 1)
        if s1 >= 0 {
            var st = infer_expr(s1)
            if st < 0 {
                return -1
            }
            if !types.is_int(st) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "切片起始必须是整数，实际是 " + types.type_name(st)
                return -1
            }
        }
        var s2 = sstate.child(id, 2)
        if s2 >= 0 {
            var et = infer_expr(s2)
            if et < 0 {
                return -1
            }
            if !types.is_int(et) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "切片终点必须是整数，实际是 " + types.type_name(et)
                return -1
            }
        }
        if sbase == TK_STR {
            node_types[id] = types.named(TK_STR)
            g_typed = g_typed + 1
            return types.named(TK_STR)
        }
        if types.is_table(sbase) {
            var sle = types.table_elem(sbase)
            if sle < 0 {
                sle = types.named(TK_I64)
            }
            var rt = types.table_of(sle)
            node_types[id] = rt
            g_typed = g_typed + 1
            return rt
        }
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "切片对象必须是表/数组或字符串，实际是 " + types.type_name(sbase)
        return -1
    }
    // p.9.11.6 表不可变更新 `with`：类型 = 左侧表/映射类型；右侧须为记录/映射
    // 字面量（键化表 N_TABLE_LIT）。校验后登记，irgen 据此复制+合并。
    if tag == N_WITH {
        var wbase = infer_expr(sstate.child(id, 0))
        if wbase < 0 {
            return -1
        }
        // p.9.11.33：struct 基 → 结构体不可变更新（值语义复制 + 指定字段覆盖；
        // 字段名/类型校验在 irgen tig_with_struct 以诊断落位）
        if types.kind(wbase) == K_STRUCT {
            var wupd2 = infer_expr(sstate.child(id, 1))
            if wupd2 < 0 {
                return -1
            }
            if !types.is_map(wupd2) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "'with' 右侧必须是记录/映射字面量 {k: v}，实际是 " + types.type_name(wupd2)
                return -1
            }
            node_types[id] = wbase
            g_typed = g_typed + 1
            return wbase
        }
        if !types.is_table(wbase) && !types.is_map(wbase) {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "'with' 左侧必须是表/数组或映射记录，实际是 " + types.type_name(wbase)
            return -1
        }
        var wupd = infer_expr(sstate.child(id, 1))
        if wupd < 0 {
            return -1
        }
        if !types.is_map(wupd) {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "'with' 右侧必须是记录/映射字面量 {k: v}，实际是 " + types.type_name(wupd)
            return -1
        }
        node_types[id] = wbase
        g_typed = g_typed + 1
        return wbase
    }
    // p.8.1.5 可空链安全访问（N_SAFE_ACCESS）：
    //   a?[i] → Option<table<T>>?[i] → Option<T>（None/越界 → None）
    //   opt?.field → Option<Struct>?.field → Option<字段类型>
    //   opt?.method(args) → 第一版暂不支持（报错引导）
    if tag == N_SAFE_ACCESS {
        var base0 = sstate.child(id, 0)
        var bt = infer_expr(base0)
        if bt < 0 {
            return -1
        }
        var pt = option_payload_ty(bt)
        if pt < 0 {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "'?.': 左侧必须是 Option<T>（Some/None 形态枚举），实际是 " + types.type_name(bt)
            return -1
        }
        var sname = s_names[id]
        var rty: i64 = -1
        if sname < 0 {
            // 索引形态：pt 必须是表/map（元素类型为结果）
            var it = infer_expr(sstate.child(id, 1))
            if it < 0 {
                return -1
            }
            if !types.is_int(it) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "安全索引下标必须是整数，实际是 " + types.type_name(it)
                return -1
            }
            if (types.is_table(pt) || types.is_map(pt)) && pt != types.named(TK_TABLE) && pt != types.named(TK_MAP) {
                rty = types.table_elem(pt)
            }
            if rty < 0 {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "'?[i]' 的 Option 载荷必须是元素化表/映射（table<T>/map<V>），实际是 " + types.type_name(pt)
                return -1
            }
        } else {
            // 字段形态：pt 必须是 struct，字段类型为结果
            var fname = sstate.name_str(id)
            if types.kind(pt) != K_STRUCT {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "'?.' 安全字段访问的 Option 载荷必须是 struct，实际是 " + types.type_name(pt)
                return -1
            }
            var sidx = types.low(pt)
            var off = cls_fldoff[sidx]
            var nf = cls_nfld[sidx]
            var fk: i64 = 0
            while fk < nf {
                if intern.lookup(fld_names[off + fk]) == fname {
                    rty = fld_tys[off + fk]
                    break
                }
                fk = fk + 1
            }
            if rty < 0 {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "struct '" + types.type_name(pt) + "' 没有字段 '" + fname + "'"
                return -1
            }
            if sstate.nchild(id) > 1 {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "'?.' 安全方法调用第一版暂不支持（请先解包 Option 后普通调用）"
                return -1
            }
        }
        // 结果类型 = Option<结果类型>（模板实例化；幂等）
        var oty = option_ty_of(rty)
        if oty < 0 {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "内部错误：Option 模板实例化失败（结果 " + types.type_name(rty) + "）"
            return -1
        }
        node_types[id] = oty
        g_typed = g_typed + 1
        return oty
    }
    // FieldAccess
    if tag == S_N_FIELD_ACCESS {
        var base_node = sstate.child(id, 0)
        var fnm = sstate.name_str(id)
        // 枚举变体常量探测（EnumName.Variant）：base 是未绑定变量（枚举名）时，
        // 查 en_keys 命中 → 变体引用。必须在 infer_expr(base) 之前拦截——
        // 否则枚举名被当未声明变量报错。无 payload 变体 = 常量值；带 payload
        // 变体的裸引用报错（须用 EnumName.Variant(...) 构造）。
        if s_tags[base_node] == S_N_VAR {
            var bname = sstate.name_str(base_node)
            var eidx = sstate.bs_find(en_keys, intern.intern(bname))
            if eidx >= 0 {
                var ei = en_vals[eidx]
                var varoff = en_varoff[ei]
                var nvar = en_nvar[ei]
                var found: i64 = -1
                var k: i64 = 0
                while k < nvar {
                    if intern.lookup(en_vnames[varoff + k]) == fnm {
                        found = k
                        break
                    }
                    k = k + 1
                }
                if found >= 0 {
                    if en_vnfld[varoff + found] == 0 {
                        // 无 payload 变体：枚举常量值
                        node_types[id] = types.enum_of(ei)
                        g_typed = g_typed + 1
                        return types.enum_of(ei)
                    }
                    sm_err_line = s_lines[id]
                    sm_err_col = s_cols[id]
                    sm_err_msg = "变体 '" + bname + "." + fnm + "' 需要 payload 参数（不能裸引用，请用 " + bname + "." + fnm + "(...) 构造）"
                    return -1
                }
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "枚举 '" + bname + "' 没有变体 '" + fnm + "'"
                return -1
            }
            // 泛型 enum 模板的裸变体引用（Option.None）：无实参可推断类型实参 →
            // 报错（一期不支持；构造调用带 payload 实参可推断）
            var gidx2 = sstate.gt_find(bname)
            if gidx2 >= 0 && gty_is_struct[gidx2] == 2 {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "泛型枚举变体 '" + bname + "." + fnm + "' 无法推断类型参数（裸引用无实参，请用带 payload 的构造调用，如 " + bname + ".Some(...)）"
                return -1
            }
        }
        var base = infer_expr(base_node)
        if base < 0 {
            return -1
        }
        var bk = types.kind(base)
        if bk == K_TUPLE {
            var ti = types.low(base)
            var off = tup_offs[ti]
            var cnt = tup_n[ti]
            var i: i64 = 0
            while i < cnt {
                var fnid = tup_names[off + i]
                // 访问顺序：数字下标（.0 起）→ ItemN（1 起编号）→ 字段名
                var hit: bool = false
                if fnm == to_string(i) {
                    hit = true
                } else if fnm == "Item" + to_string(i + 1) {
                    hit = true
                } else if fnid >= 0 {
                    if intern.lookup(fnid) == fnm {
                        hit = true
                    }
                }
                if hit {
                    node_types[id] = tup_tys[off + i]
                    g_typed = g_typed + 1
                    return tup_tys[off + i]
                }
                i = i + 1
            }
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "元组没有字段 '" + fnm + "'"
            return -1
        }
        if bk == K_STRUCT {
            // 成员访问两种语义（p.8.2.7）：存储字段（普通，沿既有路径）/
            // 计算属性（<Struct>::name getter 方法，纯函数读，无需可寻址）。
            // 裁决：**字段优先**（若成员名命中真实字段 → 恒为普通字段，保证
            // 既有字段路径零变化）；字段缺失时才查 getter，命中即计算属性读。
            var base_node = sstate.child(id, 0)
            var si = types.low(base)
            var off = cls_fldoff[si]
            var cnt = cls_nfld[si]
            var field_found: bool = false
            var i: i64 = 0
            while i < cnt {
                if intern.lookup(fld_names[off + i]) == fnm {
                    field_found = true
                    break
                }
                i = i + 1
            }
            if field_found {
                // 普通字段路径（既有）：base 必须可寻址（P2a：表下标 t[i] 放行）。
                // p.9.11.17 fn 类型字段放宽：函数值读取（作被调者，如
                // make_cb().f(7) 改写后的 FieldAccess）不要求基可寻址——读值
                // 走 tig_agg_addr 表达式落内存；普通字段读取仍要求可寻址。
                if !sstate.is_addressable(base_node) && s_tags[base_node] != 13 {
                    var is_fnf: bool = types.is_fn(fld_tys[off + i])
                    if !is_fnf {
                        var cls_name = sstate.struct_name_of(si)
                        sm_err_line = s_lines[id]
                        sm_err_col = s_cols[id]
                        sm_err_msg = "struct 实例 '" + cls_name + "' 的字段访问需要可寻址对象（变量/字段链），"
                        return -1
                    }
                }
                node_types[id] = fld_tys[off + i]
                g_typed = g_typed + 1
                return fld_tys[off + i]
            }
            // 计算属性 getter：<Struct>::<field名>，零额外参数（仅接收者），返回属性类型。
            var gfull = sstate.struct_name_of(si) + "::" + fnm
            var gsig = sstate.fn_sig(gfull)
            if gsig >= 0 {
                var grec = sp_tys[sg_off[gsig]]
                if !stype.types_compatible(grec, base) {
                    sm_err_line = s_lines[id]
                    sm_err_col = s_cols[id]
                    sm_err_msg = "计算属性 getter '" + gfull + "' 接收者类型不匹配：期望 " + types.type_name(grec) + "，实际 " + types.type_name(base)
                    return -1
                }
                if sg_nparams[gsig] != 1 {
                    sm_err_line = s_lines[id]
                    sm_err_col = s_cols[id]
                    sm_err_msg = "计算属性 getter '" + gfull + "' 必须恰好 1 个参数（仅接收者），实际 " + to_string(sg_nparams[gsig]) + " 个"
                    return -1
                }
                var grt = sg_ret[gsig]
                g_cmp_getter[id] = interner.intern(gfull)
                node_types[id] = grt
                g_typed = g_typed + 1
                return grt
            }
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "类 '" + sstate.struct_name_of(si) + "' 没有字段 '" + fnm + "'"
            return -1
        }
        if bk == K_MAP {
            // p.9.11.5 记录字段读取：`rec.k` ↔ `rec["k"]` 一致（键化表 map 模型）。
            // 字段名作字符串键 → s21_map_get(base, "k")，结果类型 = map 值类型。
            var me = types.table_elem(base)
            if me < 0 {
                // 裸 map：值类型未知，默认 i64
                node_types[id] = types.named(TK_I64)
                g_typed = g_typed + 1
                return types.named(TK_I64)
            }
            node_types[id] = me
            g_typed = g_typed + 1
            return me
        }
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "字段访问 '.' 的对象必须是元组/类实例/映射记录，实际是 " + types.type_name(base)
        return -1
    }
    // TableLit
    if tag == S_N_TABLE_LIT {
        var nc = sstate.nchild(id)
        if nc == 0 {
            // 空表：i64
            node_types[id] = types.named(TK_I64)
            g_typed = g_typed + 1
            return types.named(TK_I64)
        }
        // map 检测：TableId 子节点存在
        var is_map: bool = false
        var i: i64 = 0
        while i < nc {
            var cell = sstate.child(id, i)
            var cid = sstate.child(cell, 0)
            if cid >= 0 {
                if s_tags[cid] == S_N_TABLE_ID {
                    is_map = true
                }
            }
            i = i + 1
        }
        if is_map {
            // map<val_ty>：值类型一致；P2c 异构值（非同类收窄）→ map<any>
            var val_ty: i64 = -1
            var i2: i64 = 0
            while i2 < nc {
                var cell = sstate.child(id, i2)
                var vt = infer_expr(sstate.child(cell, 1))
                if vt < 0 {
                    return -1
                }
                if val_ty < 0 {
                    val_ty = vt
                } else {
                    if vt != val_ty && !(types.is_int(vt) && types.is_int(val_ty)) {
                        if types.is_float(vt) && types.is_float(val_ty) {
                            val_ty = vt  // 浮点族（f32/f64）收窄
                        } else {
                            // P2c 异构 map 值（`["k1":1, "k2":"x"]`）→ map<any>
                            // 动态值类型（装箱在 irgen 层完成，对齐 table<any>）
                            val_ty = types.named(TK_ANY)
                        }
                    }
                }
                i2 = i2 + 1
            }
            node_types[id] = types.map_of(val_ty)
            g_typed = g_typed + 1
            return types.map_of(val_ty)
        }
        // 普通表：元素类型一致（空表字面量 [] 跳过——类型由兄弟元素决定，
        // 否则 [[1,2],[]] 会因空表 fallback i64 报"表元素类型不一致"）
        var elem_ty: i64 = -1
        var i3: i64 = 0
        while i3 < nc {
            var cell = sstate.child(id, i3)
            var val_node = sstate.child(cell, 1)
            if s_tags[val_node] == S_N_TABLE_LIT && sstate.nchild(val_node) == 0 {
                i3 = i3 + 1
                continue  // 空表：不取类型、不校验（由兄弟元素定型）
            }
            var vt = infer_expr(val_node)
            if vt < 0 {
                return -1
            }
            if elem_ty < 0 {
                elem_ty = vt
            } else {
                // p.8.2.2：tuple 字面量每次登记独立 tuple 类型 id——结构相等
                // 的元组（如 (1,"a") 与 (2,"b")）视为一致，不落 any 异构
                var tuple_same: bool = false
                if types.kind(vt) == K_TUPLE && types.kind(elem_ty) == K_TUPLE {
                    tuple_same = stype.tuple_equal(vt, elem_ty)
                }
                if !tuple_same && vt != elem_ty && !(types.is_int(vt) && types.is_int(elem_ty)) && !(types.is_float(vt) && types.is_float(elem_ty)) {
                    // P2b 异构元素：类型不一致（非同类收窄）→ 推断为 any 动态
                    // 类型（`[1, "a", true]` → table<any>；装箱在 irgen 层完成）
                    elem_ty = types.named(TK_ANY)
                }
            }
            i3 = i3 + 1
        }
        if elem_ty < 0 {
            elem_ty = types.named(TK_I64)  // 全空表：兜底 i64
        }
        node_types[id] = types.table_of(elem_ty)
        g_typed = g_typed + 1
        return types.table_of(elem_ty)
    }
    // TupleLit
    if tag == S_N_TUPLE_LIT {
        var nc = sstate.nchild(id)
        if nc == 0 {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "空元组 () 不支持"
            return -1
        }
        // 字段名查重
        var i: i64 = 0
        while i < nc {
            var f = sstate.child(id, i)
            var fnid = s_names[f]
            if fnid >= 0 {
                var j: i64 = 0
                while j < i {
                    var g = sstate.child(id, j)
                    if s_names[g] == fnid {
                        sm_err_line = s_lines[id]
                        sm_err_col = s_cols[id]
                        sm_err_msg = "元组字段名 '" + intern.lookup(fnid) + "' 重复"
                        return -1
                    }
                    j = j + 1
                }
            }
            i = i + 1
        }
        // 登记 tuple 类型（先占位再填值保证字段段紧凑）
        var idx = len(tuple_tys)
        var off = len(tup_names)
        table_push(tup_offs, off)
        table_push(tup_n, nc)
        table_push(tuple_tys, types.tuple_of(idx))
        var jj: i64 = 0
        while jj < nc {
            table_push(tup_names, -1)
            table_push(tup_tys, 0)
            jj = jj + 1
        }
        var i2: i64 = 0
        while i2 < nc {
            var f = sstate.child(id, i2)
            var ft = infer_expr(sstate.child(f, 0))
            if ft < 0 {
                return -1
            }
            tup_names[off + i2] = s_names[f]
            tup_tys[off + i2] = ft
            i2 = i2 + 1
        }
        var rt = types.tuple_of(idx)
        node_types[id] = rt
        g_typed = g_typed + 1
        return rt
    }
    // S2.2 闭包字面量（N_FN_LIT）：构造 fn 类型 + 登记延迟检查队列。
    // 布局（parse_fn_lit）：children = [泛型槽(-1), ret_ty, params..., body]，
    // aux = nparams。ret_ty 无 -> 时解析器已生成 void 节点（N_NAMED_TYPE）。
    // 闭包体（语句块）检查延迟到语义主流程末尾的 scheck.check_pending_closures()
    // （sinfer 无法调用 scheck——import 树反向）。此处只做：
    // ① 解析返回/参数类型 → types.fn_of 登记 fn 签名（含函数值作参数/返回）；
    // ② 保存登记时 lv 快照（捕获基准：闭包体检查重建独立作用域用）；
    // ③ 入队 g_clo_pending（FIFO）。捕获分析在 S_N_VAR 分支完成。
    if tag == S_N_FN_LIT {
        var slot = sstate.slot_off(id)
        var nparams = s_aux[id]
        // 返回类型节点：children[slot]（N_FN_LIT 布局 = 泛型槽(0)、返回类型(1)、
        // 参数(2..)、函数体(末尾)；slot_off 返回 1 = 有泛型槽）
        var ret_node = sstate.child(id, slot)
        var ret_ty = sgen.parse_generic_type_node(ret_node)
        if ret_ty < 0 {
            return -1
        }
        // 参数类型收集：children[slot+1 .. slot+1+nparams)，N_PARAM child(0)=pty
        // p.6.2.4：参数节点 s_vals = ref 标志（1=按引用）、s_aux = 变参标志。
        // 变参（`...T`）签名类型 = table<T>（对齐普通函数 scollect 变参登记）；
        // ref 仅支持表参数（对齐普通函数校验）。
        var ptys: table<i64> = table_new_i64()
        var p_refs: table<i64> = table_new_i64()
        var has_var: i64 = 0
        var k: i64 = 0
        while k < nparams {
            var pnode = sstate.child(id, slot + 1 + k)
            var pty_node = sstate.child(pnode, 0)
            var pty = sgen.parse_generic_type_node(pty_node)
            if pty < 0 {
                return -1
            }
            var p_ref = s_vals[pnode]
            var p_var = s_aux[pnode]
            if p_var == 1 {
                has_var = 1
                pty = types.table_of(pty)   // 变参 → table<T>
            }
            if p_ref == 1 && !types.is_table(pty) {
                sm_err_line = s_lines[pnode]
                sm_err_col = s_cols[pnode]
                sm_err_msg = "闭包参数 '" + sstate.name_str(pnode) + "' 的 ref 修饰仅支持表参数（table/table<T>），实际是 " + types.type_name(pty)
                return -1
            }
            table_push(ptys, pty)
            table_push(p_refs, p_ref)
            k = k + 1
        }
        // 变参必须是最后一个参数（对齐普通函数；parser 已拦非末尾，防御兜底）
        var kv: i64 = 0
        while kv < nparams - 1 {
            if s_aux[sstate.child(id, slot + 1 + kv)] == 1 {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "闭包变参参数必须是最后一个参数"
                return -1
            }
            kv = kv + 1
        }
        var fnty = types.fn_of2(ret_ty, ptys, p_refs, has_var)
        node_types[id] = fnty
        g_typed = g_typed + 1
        // 登记闭包：入队 + 签名段 + 登记时 lv 快照 + 父闭包链
        var ci = len(g_clo_pending)
        table_push(g_clo_pending, id)
        table_push(cl_parent, g_clo_cur)   // 父闭包索引（嵌套闭包捕获传播用）
        table_push(cl_ret, ret_ty)
        table_push(cl_nparams, nparams)
        table_push(cl_paroff, len(cl_ptys))
        var k2: i64 = 0
        while k2 < nparams {
            table_push(cl_ptys, ptys[k2])
            k2 = k2 + 1
        }
        // 参数名段（捕获遮蔽判定：闭包参数遮蔽外层同名变量）
        table_push(cl_paramoff, len(cl_params))
        var k3: i64 = 0
        while k3 < nparams {
            var pnode2 = sstate.child(id, slot + 1 + k3)
            table_push(cl_params, s_names[pnode2])
            k3 = k3 + 1
        }
        // 登记时 lv 快照（捕获基准：五表拍平进 cl_o* 段）
        table_push(cl_off, len(cl_okeys))
        var ni: i64 = 0
        while ni < len(lv_keys) {
            table_push(cl_okeys, lv_keys[ni])
            table_push(cl_ovals, lv_vals[ni])
            table_push(cl_oconst, lv_const[ni])
            table_push(cl_otelem, lv_telem[ni])
            table_push(cl_odyn, lv_dyn[ni])
            ni = ni + 1
        }
        table_push(cl_nouter, len(lv_keys))
        // 闭包局部段起点（检查闭包体时 check_var_decl 动态追加）
        table_push(cl_locloff, len(cl_locals))
        // 捕获段起点（S_N_VAR 捕获登记时动态追加）
        table_push(cl_capoff, len(cl_capkeys))
        return fnty
    }
    // Call
    if tag == S_N_CALL {
        // W00014：实参为 bool 字面量（foo(true) 无法表达参数语义）。
        // children[0] = 被调名，children[1..] = 实参。
        var nc_bc = sstate.nchild(id)
        var k_bc: i64 = 1
        while k_bc < nc_bc {
            var an_bc = sstate.child(id, k_bc)
            if s_tags[an_bc] == S_N_BOOL_LIT {
                sm_warn_add(s_lines[an_bc], s_cols[an_bc], "布尔参数调用（实参为 bool 字面量，语义不明）")
            }
            k_bc = k_bc + 1
        }
        return infer_call(id)
    }
    // P2a 调用表达式 `t[0](5)`：被调者为 fn 值表达式
    if tag == S_N_CALL_EXPR {
        return infer_call_expr(id)
    }
    // MethodCall
    if tag == S_N_METHOD_CALL {
        return infer_method_call(id)
    }
    // 一期并发：`run <Actor>(args...)` 表达式 → actor 句柄类型。
    // children[0] = actor 类型名（N_NAMED_TYPE），实参（children[1..]）逐个推断。
    if tag == S_N_RUN_ACTOR {
        var aty_node = sstate.child(id, 0)
        var anm = sstate.name_str(aty_node)
        var aidx = sstate.actor_find(anm)
        if aidx < 0 {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "run 的 '" + anm + "' 不是已声明的 actor 类型"
            return -1
        }
        // 构造实参逐个推断（类型一致性在 A4/A5 与消息契约校对）
        var nc = sstate.nchild(id)
        var k: i64 = 1
        while k < nc {
            var at = infer_expr(sstate.child(id, k))
            if at < 0 {
                return -1
            }
            k = k + 1
        }
        var ht = types.actor_of(aidx)
        node_types[id] = ht
        g_typed = g_typed + 1
        return ht
    }
    // 三期 A 组 `unsafe.get(share)` 凭据获取表达式 → guard<cap> 类型。
    // children[0] = 能力域名（N_NAMED_TYPE name=share/mem/ext），children[1] = 对象
    // 绑定表达式或 -1。仅 unsafe 上下文语义合法（安全代码持证被拦截）。
    if tag == S_N_GUARD_GET {
        // 三期 A 组 `unsafe.get(share)` 凭据获取 → guard<cap> 类型。仅 unsafe 上下文
        // 合法（安全代码取得凭据 = 无门禁 = 绕过机制，编译期拦截）。
        if g_unsafe_depth == 0 {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "unsafe.get 只能在 unsafe 上下文使用（unsafe 块或 unsafe 函数内）"
            return -1
        }
        var capn = sstate.name_str(sstate.child(id, 0))
        var cap: i64 = -1
        if capn == "share" {
            cap = 0
        } else if capn == "mem" {
            cap = 1
        } else if capn == "ext" {
            cap = 2
        } else {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "unsafe.get 的能力域必须是 share/mem/ext，实际是 '" + capn + "'"
            return -1
        }
        // 对象绑定表达式推断（凭据绑定的对象必须有类型）
        var bind = sstate.child(id, 1)
        if bind >= 0 {
            var bt = infer_expr(bind)
            if bt < 0 {
                return -1
            }
        }
        var gt = types.guard_of(cap)
        node_types[id] = gt
        g_typed = g_typed + 1
        return gt
    }
    // S2.3：`expr ?` 后缀解包（Result/Option）
    if tag == S_N_TRY {
        return infer_try_unwrap(id)
    }
    // p.9.11.3 try 错误聚合块：表达式位。块体由 scheck.check_try 检查（含 `?`
    // 传播校验），此处取末表达式值类型（无末值则 -1/仅作语句）。块内 `?` 传播
    // 目标 = 当前函数（与块外一致，try 仅语法分组）。
    if tag == S_N_TRY_BLOCK {
        var tr = scheck.check_try(id)
        if tr < 0 {
            return -1
        }
        var tv = node_types[id]
        if tv < 0 {
            tv = types.named(TK_I64)
        }
        return tv
    }
    sm_err_line = s_lines[id]
    sm_err_col = s_cols[id]
    sm_err_msg = "无法推断表达式（节点 " + to_string(tag) + "）"
    return -1
}

}