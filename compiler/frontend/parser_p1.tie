type tie<class>
// compiler/frontend/parser_p1.tie —— 分片 1（p.9.21.3 单文件 ≤800 行）
// ============================================================
// 由 split_parts.py 按行数贪心分片：只搬函数与紧邻注释，
// 顶层全局 var 与 import 树仍留在 parser.tie。
namespace parser {
// 顶层语句 tag 序列（Rust --ast 顶层语句变体对照用）
func top_seq(root: i64) -> string {
    var s: string = ""
    var k: i64 = 0
    while k < ast.child_count(root) {
        var c = ast.child_at(root, k)
        s = s + pnames.node_tag_name(ast.tag(c))
        if k + 1 < ast.child_count(root) {
            s = s + " "
        }
        k = k + 1
    }
    return s
}

// 递归树形输出：节点文本 + 子节点缩进
func dump_node(id: i64, depth: i64) -> string {
    var indent: string = ""
    var d: i64 = 0
    while d < depth {
        indent = indent + "  "
        d = d + 1
    }
    var txt: string = indent + node_text(id)
    var k: i64 = 0
    while k < ast.child_count(id) {
        var c = ast.child_at(id, k)
        if c >= 0 {
            txt = txt + "\n" + dump_node(c, depth + 1)
        } else {
            txt = txt + "\n" + indent + "  -1(空)"
        }
        k = k + 1
    }
    return txt
}

// 节点单行文本：tag 名 + 名字 lexeme + 关键标量字段 + span
func node_text(id: i64) -> string {
    var tag = ast.tag(id)
    var s: string = pnames.node_tag_name(tag)
    var nm = ast.name(id)
    if nm >= 0 {
        s = s + " '" + interner.lookup(nm) + "'"
    }
    var v = ast.val(id)
    if tag == N_BINARY {
        s = s + " " + op_symbol(v, false)
    } else if tag == N_UNARY {
        s = s + " " + op_symbol(v, true)
    } else if tag == N_INT_LIT {
        s = s + " " + to_string(v)
    } else if tag == N_BOOL_LIT {
        s = s + " " + to_string(v)
    } else if tag == N_TRIT_LIT {
        s = s + " " + to_string(v)
    } else if tag == N_ASSIGN {
        if v >= 0 {
            s = s + " " + op_symbol(v, false) + "="
        }
    } else if tag == N_FIELD_ASSIGN {
        if v >= 0 {
            s = s + " " + op_symbol(v, false) + "="
        }
    } else if tag == N_INDEX_ASSIGN {
        if v >= 0 {
            s = s + " " + op_symbol(v, false) + "="
        }
    } else if v >= 0 {
        s = s + " v=" + to_string(v)
    }
    s = s + " @" + to_string(ast.line(id)) + ":" + to_string(ast.col(id))
    return s
}

// 运算符编号 → 符号文本（parse_debug 展示用）
func op_symbol(op: i64, is_unary: bool) -> string {
    if is_unary {
        if op == 0 {
            return "-"
        }
        if op == 1 {
            return "!"
        }
        if op == 2 {
            return "++"
        }
        if op == 3 {
            return "--"
        }
        if op == 4 {
            return "++"
        }
        if op == 5 {
            return "--"
        }
        return "?" + to_string(op)
    }
    if op == 0 {
        return "+"
    }
    if op == 1 {
        return "-"
    }
    if op == 2 {
        return "*"
    }
    if op == 3 {
        return "/"
    }
    if op == 4 {
        return "%"
    }
    if op == 5 {
        return "=="
    }
    if op == 6 {
        return "!="
    }
    if op == 7 {
        return "<"
    }
    if op == 8 {
        return ">"
    }
    if op == 9 {
        return "<="
    }
    if op == 10 {
        return ">="
    }
    if op == 11 {
        return "&&"
    }
    if op == 12 {
        return "||"
    }
    if op == 13 {
        return "&"
    }
    if op == 14 {
        return "|"
    }
    if op == 15 {
        return "^"
    }
    if op == 16 {
        return "<<"
    }
    if op == 17 {
        return ">>"
    }
    return "?" + to_string(op)
}

// 分治合并行表：把 lines 中的每一行两两配对拼接成一个大字符串。
// 算法思路与 backend/llvmgen.tie 的 join_lines 完全相同（此处独立实现，
// 不 import backend 模块，避免 frontend → backend 的反向依赖环）。
// 原理：每轮把相邻两行拼成一行，行数减半，直到只剩一行——共 log₂N 轮，
// 每轮拷贝总量 ≈ 最终文本大小，总拷贝量 O(total · log N)，每行只参与
// log N 次拼接。相比旧的逐行 `out = out + line` 追加（每次拼接都复制整个
// 已累积输出，总拷贝 O(total · N)，3000+ 节点的大文件产生数百 MB 字符搬运）
// 是数量级差异。
// 语义约定（保证与旧实现逐字节一致）：行表首元素是头行 "<N>:"（无换行），
// 其余元素是节点行（无换行）；合并时在相邻两行之间插入一个 "\n"，整个表
// 合并为一行后再补末尾一个 "\n"。最终文本 =
//   "<N>:\n" + "行0\n" + "行1\n" + ... + "行N-1\n"
// 与旧的 "头行带 \n、每行带 \n" 的逐行拼接结果完全相同。
// 边界：空表（N 节点为 0 时行表仍含头行，故不会命中）返回空串；
// 奇数个行时每轮末位落单的行原样带过，留到下一轮与邻居合并。
func merge_lines(lines: table<string>) -> string {
    var cur = lines
    var n = len(cur)
    if n == 0 {
        return ""
    }
    while n > 1 {
        // 本轮结果表：相邻两行两两合并，行数减半
        var nxt = table_new_string()
        var i: i64 = 0
        while i + 1 < n {
            // 相邻两行拼成一行，中间插入 "\n"（该换行即两行之间的行分隔符）
            table_push(nxt, cur[i] + "\n" + cur[i + 1])
            i = i + 2
        }
        // 奇数个行时，最后落单的一行不带换行直接带过，下一轮再与邻居合并
        if i < n {
            table_push(nxt, cur[i])
        }
        cur = nxt
        n = len(cur)
    }
    // 只剩一行：整表合并完毕（行间换行均已插入），末尾补上最后一个 "\n"
    return cur[0] + "\n"
}

// 组装 AST 协议文本：首行 <N>:（节点总数），随后每行一个节点
// <id> <tag> <name_id> <val> <aux> <line> <col> <nchild> <c1> <c2> ...
// 输出格式与旧实现完全一致：语义分析器 semantic.load_ast 按此协议解析，
// 任何格式变化都会导致全编译器崩溃，故逐行内容与行分隔符均保持不变。
func build_protocol() -> string {
    // 行表逐行收集：头行 + 每个节点行（均不含换行符，换行在 merge_lines
    // 分治合并时统一插入）。表元素共享句柄语义：merge_lines 内部对表句柄的
    // 重新赋值不会改动本函数持有的 lines，行内容（字符串句柄）也不会被修改。
    var lines: table<string> = table_new_string()
    table_push(lines, to_string(ast.count()) + ":")
    var i: i64 = 0
    while i < ast.count() {
        var line: string = to_string(i) + " " + to_string(ast.tag(i)) + " " +
            to_string(ast.name(i)) + " " + to_string(ast.val(i)) + " " +
            to_string(ast.aux(i)) + " " + to_string(ast.line(i)) + " " +
            to_string(ast.col(i)) + " " + to_string(ast.child_count(i))
        var k: i64 = 0
        while k < ast.child_count(i) {
            line = line + " " + to_string(ast.child_at(i, k))
            k = k + 1
        }
        table_push(lines, line)
        i = i + 1
    }
    // 一次性分治合并行表为完整协议文本（O(n log n)，代替 O(n²) 逐行追加）
    return merge_lines(lines)
}

}