type tie<class>
// compiler/frontend/pstmt_top.tie — T2.5 parser 顶层声明（再拆分）
// ============================================================
// 里程碑：自举 v2 计划 T2.5 完整 parser 再拆分（2026-08-11）：
// 原 pstmt.tie（1091 行）拆为 pstmt_top（本文件：程序入口 + 顶层声明
// import/using/namespace/extern/fn/struct）+ pstmt_flow（语句分派+控制流）
// + pstmt（var 声明/表达式赋值）。
// 依赖：./pstmt_flow.tie（语句分派/控制流，经其传递可达 pstmt/pexpr/putil/ast）。
// 树式无环：由 parser.tie import。
import "./pstmt_flow.tie"

// 三期通用 `#[]` 属性通道（§7.1）：解析 `#[unsafe.share]` 等声明属性后暂存
// 在此，附着到下一 actor/func 声明节点（N_ACTOR / N_FN_DEF 的 val bit3）。
// 0 = 无 pending；>0 = 属性全名池 id。解析完声明即清零。
var g_pending_attr: i64 = 0;

// p.9.11.12 @注解/属性：声明前置注解 `@name` / `@name(args)`（元数据，无运行期
// 行为）。注册表按「声明节点 id → 注解条目」平行存放（每个注解一条记录）：
//   g_ann_nodes[序] = 声明节点 id（解析完声明回填；-1 = 尚未附着）
//   g_ann_names[序] = 注解名（字符串池 id）
//   g_ann_arg_off/cnt = 参数 AST 节点 id 在 g_ann_arg_ids 扁平段中的 [off, off+cnt)
//   g_ann_lines/cols = 注解起始位置（诊断/工具链展示）
// 每次 parse_program（含 import 展开的每份文件）独立重置；查询接口见
// pstmt_top 命名空间 pann_*（工具链消费（Keel 注册表/tieapi/tdiag）在组件层做）。
var g_ann_nodes: table<i64>;
var g_ann_names: table<i64>;
var g_ann_arg_off: table<i64>;
var g_ann_arg_cnt: table<i64>;
var g_ann_arg_ids: table<i64>;
var g_ann_lines: table<i64>;
var g_ann_cols: table<i64>;

// p.9.11.29 doc 注释 `///`：声明前连续 ///（或 /** */）行经词法 collect_doc/
// flush_doc 落表后，此处按「doc 声明起始行 == ast.line(声明节点)」完成归属
// 登记（@注解同路：解析期注册表，零运行时；tsp/工具链消费经 pdoc_* 接口，
// Keel/tdiag 落盘在组件层做）。每份文件 parse_program 独立重置（同 pann）。
// 附着面：函数/import/using/namespace/struct/enum/extern/宏/port/interface/
// actor/字段与全局变量（N_VAR）；walk 不进函数/宏体——体内局部 var 不附着。
var g_doc_nodes: table<i64>;     // 声明节点 id
var g_doc_texts: table<i64>;    // 文本池 id（与 lextok.doc_entry_text_id 同源）
var g_doc_dlines: table<i64>;   // 声明起始行（1 起，报告用）
var doc_claimed: table<i64>;    // doc 已消费标记（0/1，一条 doc 至多附着一个声明）

namespace pstmt_top {

pub func parse_program() -> i64 {
    var line = putil.peek_line()
    var col = putil.peek_col()
    // p.9.11.12：注解注册表重置（每份文件解析独立；import 展开的文件各自重置）
    g_ann_nodes = table_new_i64()
    g_ann_names = table_new_i64()
    g_ann_arg_off = table_new_i64()
    g_ann_arg_cnt = table_new_i64()
    g_ann_arg_ids = table_new_i64()
    g_ann_lines = table_new_i64()
    g_ann_cols = table_new_i64()
    // p.9.11.29：doc 注册表重置（同 pann——每份文件解析独立）
    g_doc_nodes = table_new_i64()
    g_doc_texts = table_new_i64()
    g_doc_dlines = table_new_i64()
    doc_claimed = table_new_i64()
    var stmts: table<i64> = table_new_i64()
    var done = false
    while !done {
        var tag = putil.peek_tag()
        if tag == lex_eof {
            done = true
        } else if tag == lex_func {
            var s = parse_fn_def()
            if s < 0 {
                return -1
            }
            ast.collect_stmt(stmts, s)
        } else if tag == lex_inline {
            // p.9.11.10 inline fn：`inline func ...`（inline 可跟 pub/const）
            var s = parse_fn_def()
            if s < 0 {
                return -1
            }
            ast.collect_stmt(stmts, s)
        } else if tag == lex_pub {
            // pub 后：pub func / pub macro / pub #[macro]（dev33 批次10 任务29
            // 跨文件宏：pub macro 导出跨文件可见，非 pub 宏同文件私有）。
            var nxt = putil.peek_n(1)
            if nxt == lex_macro {
                putil.advance()   // pub
                var s = parse_macro_def()
                if s < 0 {
                    return -1
                }
                ast.set_val(s, ast.val(s) + 2)   // val bit1 = ispub
                ast.collect_stmt(stmts, s)
            } else if nxt == lex_hash {
                putil.advance()   // pub
                var s = parse_proc_macro_attr()
                if s < 0 {
                    return -1
                }
                ast.set_val(s, ast.val(s) + 2)   // val bit1 = ispub
                ast.collect_stmt(stmts, s)
            } else if nxt == lex_import {
                // p.9.11.14 重导出：`pub import "path" [as 别名]`（内联模型
                // 零成本；parse_import 内部消化 pub 前缀）
                var s = parse_import()
                if s < 0 {
                    return -1
                }
                ast.collect_stmt(stmts, s)
            } else {
                var s = parse_fn_def()
                if s < 0 {
                    return -1
                }
                ast.collect_stmt(stmts, s)
            }
        } else if tag == lex_unsafe {
            // S1.2：`unsafe fn ...`（unsafe 函数）或 `unsafe extern fn ...`
            // （E3 强制 unsafe 标注的 extern 声明）。按下一 token 分派。
            var nxt = putil.peek_n(1)
            if nxt == lex_extern {
                var s = parse_extern()
                if s < 0 {
                    return -1
                }
                ast.collect_stmt(stmts, s)
            } else {
                var s = parse_fn_def()
                if s < 0 {
                    return -1
                }
                ast.collect_stmt(stmts, s)
            }
        } else if tag == lex_repr {
            // S1.2：`repr(C) struct ...`（C 内存布局结构体）
            var s = parse_struct()
            if s < 0 {
                return -1
            }
            ast.collect_stmt(stmts, s)
        } else if tag == lex_import {
            var s = parse_import()
            if s < 0 {
                return -1
            }
            ast.collect_stmt(stmts, s)
        } else if tag == lex_using {
            var s = parse_using()
            if s < 0 {
                return -1
            }
            ast.collect_stmt(stmts, s)
        } else if tag == lex_struct {
            var s = parse_struct()
            if s < 0 {
                return -1
            }
            ast.collect_stmt(stmts, s)
        } else if tag == lex_enum {
            var s = parse_enum()
            if s < 0 {
                return -1
            }
            ast.collect_stmt(stmts, s)
        } else if tag == lex_port {
            // S2.4：port 接口声明
            var s = parse_port()
            if s < 0 {
                return -1
            }
            ast.collect_stmt(stmts, s)
        } else if tag == lex_ident && putil.peek_lexeme() == "alias" {
            // p.9.11.32：类型别名声明（上下文关键字——顶层 `alias Name = ...`；
            // alias 不进保留字表，既有代码中作为标识符合法）
            var s = parse_alias()
            if s < 0 {
                return -1
            }
            ast.collect_stmt(stmts, s)
        } else if tag == lex_interface {
            // p.9.11.21：interface 结构性接口声明
            var s = parse_interface()
            if s < 0 {
                return -1
            }
            ast.collect_stmt(stmts, s)
        } else if tag == lex_impl {
            // S2.4：impl 实现块（impl Drawable for Button { ... }）
            var s = parse_impl()
            if s < 0 {
                return -1
            }
            ast.collect_stmt(stmts, s)
        } else if tag == lex_namespace {
            var s = parse_namespace()
            if s < 0 {
                return -1
            }
            ast.collect_stmt(stmts, s)
        } else if tag == lex_actor {
            // 一期并发：actor 原生语法（`actor Name { ... }`）
            var s = parse_actor()
            if s < 0 {
                return -1
            }
            ast.collect_stmt(stmts, s)
        } else if tag == lex_extern {
            var s = parse_extern()
            if s < 0 {
                return -1
            }
            ast.collect_stmt(stmts, s)
        } else if tag == lex_var {
            var s = pstmt.parse_var_decl(0)
            if s < 0 {
                return -1
            }
            ast.collect_stmt(stmts, s)
        } else if tag == lex_const {
            // p.8.1.1：`const fn` / `const func` → const fn 定义；否则 const 全局变量
            if putil.peek_lexeme_n(1) == "fn" || putil.peek_lexeme_n(1) == "func" {
                var s = parse_fn_def()
                if s < 0 {
                    return -1
                }
                ast.collect_stmt(stmts, s)
            } else {
                var s = pstmt.parse_var_decl(1)
                if s < 0 {
                    return -1
                }
                ast.collect_stmt(stmts, s)
            }
        } else if tag == lex_macro {
            // S3.3：宏定义 `macro name(...) -> code { ... }`（编译期函数）
            var s = parse_macro_def()
            if s < 0 {
                return -1
            }
            ast.collect_stmt(stmts, s)
        } else if tag == lex_hash {
            // M4（dev33 批次9）过程宏属性 `#[macro]` + 三期通用 `#[]` 属性通道
            // （§7.1，A/B/C 组声明属性 `#[unsafe.share]` 等）。按属性名分派：
            //   #[macro] → 过程宏定义（保留兼容）
            //   其他（#[unsafe.x]）→ 通用属性，附着到下一 actor/func 声明
            var an2 = putil.peek_lexeme_n(2)
            if an2 == "macro" {
                var ps = parse_proc_macro_attr()
                if ps < 0 {
                    return -1
                }
                ast.collect_stmt(stmts, ps)
            } else {
                var attr = parse_generic_attr()
                if attr < 0 {
                    return -1
                }
                g_pending_attr = attr   // 附着到下一声明（actor/func）
            }
        } else if tag == lex_at {
            // p.9.11.12 @注解/属性：`@name` / `@name(args)`（可堆叠）后跟声明
            var s2 = parse_annotated_decl()
            if s2 < 0 {
                return -1
            }
            ast.collect_stmt(stmts, s2)
        } else {
            putil.set_err(putil.peek_line(), putil.peek_col(), "顶层只允许函数定义、import、using、struct、enum、命名空间声明、extern 声明、全局变量或宏定义，实际是 " + putil.describe(tag))
            return -1
        }
    }
    // S2.2：回填延迟闭包函数体。parse_primary 解析闭包字面量时只解析头部
    // （pexpr 在 import 树底层无法调用 pstmt_flow 的语句解析——成环），
    // 函数体 token 流被配平跳过并登记快照；这里在整份文件解析完后统一
    // 恢复快照、parse_block 解析函数体、回填到 N_FN_LIT（见
    // pstmt_flow.parse_deferred_closures）。
    // S3.3：准引用块 `` `{ stmts } `` 同款延迟——parse_deferred_all 交替
    // 处理闭包表与准引用块表直到两者都稳定（嵌套/交错均可）。
    if parse_deferred_all() < 0 {
        return -1
    }
    // p.9.11.29：doc 注释归属回填（声明起始行匹配，详见 doc_attach_all）
    doc_attach_all(stmts)
    var root = ast.new_node(N_STMTLIST, -1, -1, -1, line, col)
    ast.set_children(root, stmts)
    return root
}

// S3.3：交替处理延迟闭包与延迟准引用块（parse_program 末尾调用）。
// 闭包体里可含准引用块、准引用块里可含闭包——两张延迟表互相登记，
// 单遍处理会漏：交替扫描直到两表长度都稳定（新增登记在解析过程中追加
// 到表尾，动态 count 循环处理到队尾；外层再检查另一张表是否有新增）。
func parse_deferred_all() -> i64 {
    var done = false
    while !done {
        var c1 = putil.defer_closure_count()
        var c2 = putil.defer_code_count()
        if pstmt_flow.parse_deferred_closures() < 0 {
            return -1
        }
        if pstmt_flow.parse_deferred_code_blocks() < 0 {
            return -1
        }
        if putil.defer_closure_count() == c1 {
            if putil.defer_code_count() == c2 {
                done = true
            }
        }
    }
    return 0
}

// S3.3 宏定义：`macro name(p1: code, ...) -> code { 函数体 }`。
// 布局与 N_FN_DEF 一致但**无泛型槽**：children = [返回类型, 参数..., 函数体]；
// name = 宏名，aux = 参数个数，val = 0。
// 参数/返回类型必须是 code（准引用/插值载体）；宏体是普通 tie 语句
// （编译期由 interp 执行，宏体错误在展开时报"宏执行错误"）。
//
// p.8.2.12 分支：**声明式宏**（裸形参 + 块体，无 `->`）走 N_DECL_MACRO_DEF：
//   `macro swap(a, b) { var __t = $a; $a = $b; $b = __t }`
// 形参名/`$名` 在体内 = 代换槽（替换为实参克隆）；`__` 前缀 = 卫生临时名，
// 每次展开唯一化。分派依据：`)` 后是 `->`=函数式宏，是 `{`=声明式宏。
func parse_macro_def() -> i64 {
    var line = putil.peek_line()
    var col = putil.peek_col()
    putil.advance()   // macro
    var name = putil.expect_ident()
    if name < 0 {
        return -1
    }
    if !putil.expect(lex_lparen, "'('") {
        return -1
    }
    var params: table<i64> = table_new_i64()
    var param_kind: i64 = 0   // 0=未定（无参或首个待定） 1=函数式(: code) 2=声明式(裸形参)
    if !putil.eat(lex_rparen) {
        var d = false
        while !d {
            var pname = putil.expect_ident()
            if pname < 0 {
                return -1
            }
            if putil.peek_tag() == lex_colon {
                // 函数式宏参数：必须是 code 类型
                if param_kind == 2 {
                    putil.set_err(putil.peek_line(), putil.peek_col(), "宏 '" + interner.lookup(name) + "' 形参类型不一致：声明式宏形参为裸标识符，不能混用 `: type`（请统一为裸形参或加 `: code` 全部转函数式宏）")
                    return -1
                }
                param_kind = 1
                putil.advance()
                var pty = pexpr_type.parse_type()
                if pty < 0 {
                    return -1
                }
                // 宏参数必须显式标注 code 类型（宏 = 编译期 AST → AST 函数）
                if !is_code_type_node(pty) {
                    putil.set_err(putil.peek_line(), putil.peek_col(), "宏参数 '" + interner.lookup(pname) + "' 必须是 code 类型（宏 = 编译期 AST→AST 函数）")
                    return -1
                }
                var p = ast.new_node(N_PARAM, pname, 0, 0, putil.peek_line(), putil.peek_col())
                var pkids: table<i64> = table_new_i64()
                table_push(pkids, pty)
                table_push(pkids, -1)
                ast.set_children(p, pkids)
                table_push(params, p)
            } else {
                // 声明式宏裸形参（p.8.2.12，模板代换槽）
                if param_kind == 1 {
                    putil.set_err(putil.peek_line(), putil.peek_col(), "宏 '" + interner.lookup(name) + "' 形参类型不一致：函数式宏形参须带 `: code`，不能混用裸标识符")
                    return -1
                }
                param_kind = 2
                var p = ast.new_node(N_PARAM, pname, 0, 0, putil.peek_line(), putil.peek_col())
                var pkids: table<i64> = table_new_i64()
                table_push(pkids, -1)
                ast.set_children(p, pkids)
                table_push(params, p)
            }
            if putil.eat(lex_comma) {
                // 继续
            } else {
                if !putil.expect(lex_rparen, "')'") {
                    return -1
                }
                d = true
            }
        }
    }
    // 分派：`)` 后 `->` = 函数式宏；`{` = 声明式宏（p.8.2.12）
    if putil.peek_tag() == lex_arrow {
        if param_kind == 2 {
            putil.set_err(putil.peek_line(), putil.peek_col(), "声明式宏 '" + interner.lookup(name) + "' 是裸形参模板宏，不能有 '->' 返回类型（如需编译期函数宏请给每个形参加 `: code` 并返回 code）")
            return -1
        }
        putil.advance()
        var ret_ty = pexpr_type.parse_type()
        if ret_ty < 0 {
            return -1
        }
        if !is_code_type_node(ret_ty) {
            putil.set_err(putil.peek_line(), putil.peek_col(), "宏 '" + interner.lookup(name) + "' 的返回类型必须是 code（宏 = 编译期 AST→AST 函数）")
            return -1
        }
        var body = pstmt_flow.parse_block()
        if body < 0 {
            return -1
        }
        var f = ast.new_node(N_MACRO_DEF, name, 0, len(params), line, col)
        var kids: table<i64> = table_new_i64()
        table_push(kids, ret_ty)
        var i: i64 = 0
        while i < len(params) {
            table_push(kids, params[i])
            i = i + 1
        }
        table_push(kids, body)
        ast.set_children(f, kids)
        return f
    }
    // 声明式宏：裸形参 + 块体（无 `->`）
    if param_kind == 1 {
        putil.set_err(putil.peek_line(), putil.peek_col(), "函数式宏 '" + interner.lookup(name) + "' 形参带 `: code`，必须跟 '-> code' 返回类型")
        return -1
    }
    var body = pstmt_flow.parse_block()
    if body < 0 {
        return -1
    }
    var df = ast.new_node(N_DECL_MACRO_DEF, name, 0, len(params), line, col)
    var dkids: table<i64> = table_new_i64()
    table_push(dkids, body)
    var j: i64 = 0
    while j < len(params) {
        table_push(dkids, params[j])
        j = j + 1
    }
    ast.set_children(df, dkids)
    return df
}

// 类型节点是否为 code 类型（N_NAMED_TYPE 且 TyKw 索引 == TK_CODE=15）。
func is_code_type_node(ty: i64) -> bool {
    if ty < 0 {
        return false
    }
    if ast.tag(ty) == N_NAMED_TYPE {
        if ast.val(ty) == 15 {
            return true
        }
    }
    return false
}

// M4（dev33 批次9）过程宏属性：`#[macro]` 已消费 '#'，解析 `[macro]` 后紧跟
// macro 定义，把 N_MACRO_DEF 的 val 置 1 标记为过程宏（token 流 API 驱动：
// mexpand 展开时把实参解引用为源码文本、绑定为字符串传给宏体）。
func parse_proc_macro_attr() -> i64 {
    var line = putil.peek_line()
    var col = putil.peek_col()
    putil.advance()   // #
    if !putil.expect(lex_lbracket, "'['") {
        return -1
    }
    // 属性名读取 lexeme（不限定标识符：`#[macro]` 中 macro 是关键字 token）
    var aname = interner.intern(putil.peek_lexeme())
    putil.advance()
    if !putil.expect(lex_rbracket, "']'") {
        return -1
    }
    if aname != interner.intern("macro") {
        putil.set_err(line, col, "未知属性 '#[" + interner.lookup(aname) +
            "]'（当前仅支持 #[macro] 过程宏标记）")
        return -1
    }
    // 属性后必须紧跟 macro 定义（`#[macro]` 行尾 ASI 可能补分号，先消费）
    putil.eat(lex_semi)
    if putil.peek_tag() != lex_macro {
        putil.set_err(putil.peek_line(), putil.peek_col(),
            "#[macro] 后必须紧跟宏定义（macro 关键字）")
        return -1
    }
    var s = parse_macro_def()
    if s < 0 {
        return -1
    }
    ast.set_val(s, 1)   // val=1 标记过程宏（普通宏 val=0）
    return s
}

// 三期通用 `#[]` 属性通道（concurrency-model.md §7.1，2026-08-23 定稿）：
// 点号命名空间风格属性 `#[ns.sub]`（如 `#[unsafe.share]` / `#[unsafe.trm]` /
// `#[unsafe.mem]` / `#[unsafe.ext]`），附着在声明（actor / func / 方法）前，
// 作为 unsafe 凭据门禁标记。`#[tag.x]` goto 标签走语句位置（parse_goto_label，
// 本处不处理）；`#[macro]` 过程宏走 parse_proc_macro_attr（本处不处理）。
// 已消费 '#': 解析 `[` ns `.` sub `]` → 返回属性全名池 id（如 "unsafe.share"）；
// 未知属性返回 -1 报错。属性仅作声明标记，语义层按需消费。
func parse_generic_attr() -> i64 {
    var line = putil.peek_line()
    var col = putil.peek_col()
    putil.advance()   // #
    if !putil.expect(lex_lbracket, "'['") {
        return -1
    }
    // ns 段：读 lexeme（unsafe 是关键字 token 非 ident）
    var ns = interner.intern(putil.peek_lexeme())
    putil.advance()
    if !putil.expect(lex_dot, "'.'") {
        return -1
    }
    // sub 段：标识符（如 share / trm / mem / ext）
    var sub = putil.expect_ident()
    if sub < 0 {
        return -1
    }
    if !putil.expect(lex_rbracket, "']'") {
        return -1
    }
    var full = interner.lookup(ns) + "." + interner.lookup(sub)
    // 白名单：仅 unsafe 凭据域属性（A/B/C 组标记）
    if interner.lookup(ns) != "unsafe" {
        putil.set_err(line, col, "未知属性 '#[" + full + "]'（属性命名空间仅支持 unsafe，如 #[unsafe.share]）")
        return -1
    }
    if interner.lookup(sub) != "share" && interner.lookup(sub) != "trm" &&
        interner.lookup(sub) != "mem" && interner.lookup(sub) != "ext" {
        putil.set_err(line, col, "未知 unsafe 属性 '#[" + full + "]'（支持 share/trm/mem/ext 四域）")
        return -1
    }
    putil.eat(lex_semi)   // 吃掉 ASI 补分号（属性后无分号语义）
    return interner.intern(full)
}

// ---------- p.9.11.12 @注解/属性（声明前置元数据） ----------

// 解析「一个或多个 @注解 + 声明」：@name / @name(args) 可堆叠，后必须跟
// func/struct/enum 声明（本批次边界；import/using/extern 等留后续批次）。
// 全部注解登记进 g_ann_* 注册表（声明节点 id 回填）；返回声明节点 id。
// 悬空注解（@ 后非声明）与同名重复注解均报诊断。
func parse_annotated_decl() -> i64 {
    var anns: table<i64> = table_new_i64()   // 本声明的注解注册表序号
    while putil.peek_tag() == lex_at {
        var ai = parse_annot_one()
        if ai < 0 {
            return -1
        }
        // ASI 会在行尾注解后补分号（`@x\n@y struct` → `@x;@y;struct`）；
        // 注解是声明修饰，分号无语义，直接吃掉（跨行堆叠注解依赖此处理）。
        putil.eat(lex_semi)
        table_push(anns, ai)
    }
    if len(anns) == 0 {
        // 防御：parse_program 只在 peek == lex_at 时进入本函数，理论上不空
        putil.set_err(putil.peek_line(), putil.peek_col(), errors.syn_annot_dangling())
        return -1
    }
    // 同名重复注解诊断（同一声明上）
    var di: i64 = 0
    while di < len(anns) {
        var dj: i64 = di + 1
        while dj < len(anns) {
            if g_ann_names[anns[di]] == g_ann_names[anns[dj]] {
                putil.set_err(g_ann_lines[anns[dj]], g_ann_cols[anns[dj]],
                    errors.syn_annot_dup(interner.lookup(g_ann_names[anns[dj]])))
                return -1
            }
            dj = dj + 1
        }
        di = di + 1
    }
    // 注解后必须跟声明：func（含 inline/const/pub/async/unsafe 前缀）、
    // struct（含 repr(C) 前缀）、enum。extern 等其它声明暂不支持（注明）。
    var tag = putil.peek_tag()
    var decl: i64 = -1
    if tag == lex_func || tag == lex_inline || tag == lex_pub ||
        tag == lex_const || tag == lex_async {
        decl = parse_fn_def()
    } else if tag == lex_unsafe {
        if putil.peek_n(1) == lex_extern {
            putil.set_err(putil.peek_line(), putil.peek_col(), errors.syn_annot_extern())
            return -1
        }
        decl = parse_fn_def()
    } else if tag == lex_repr || tag == lex_struct {
        decl = parse_struct()
    } else if tag == lex_enum {
        decl = parse_enum()
    } else {
        // 悬空注解：@ 后既非注解也非声明（EOF/其它语句起始）
        putil.set_err(putil.peek_line(), putil.peek_col(), errors.syn_annot_dangling())
        return -1
    }
    if decl < 0 {
        return -1
    }
    // 回填声明节点 id（注册表条目 → 声明）
    var r: i64 = 0
    while r < len(anns) {
        g_ann_nodes[anns[r]] = decl
        r = r + 1
    }
    return decl
}

// 解析单个注解 `@name` / `@name(args)`：返回注册表序号（-1 = 失败）。
// 参数为编译期字面量（数字/字符串/字符/布尔/表字面量，可嵌套）；
// 非字面量参数（变量/调用/算术）报诊断。
func parse_annot_one() -> i64 {
    var line = putil.peek_line()
    var col = putil.peek_col()
    putil.advance()   // @
    var name = putil.expect_ident()
    if name < 0 {
        return -1
    }
    var arg_off = len(g_ann_arg_ids)
    var argc: i64 = 0
    if putil.eat(lex_lparen) {
        if !putil.eat(lex_rparen) {
            var d = false
            while !d {
                var a = pexpr.parse_expr()
                if a < 0 {
                    return -1
                }
                if !is_annot_literal(a) {
                    putil.set_err(putil.peek_line(), putil.peek_col(), errors.syn_annot_arg_type())
                    return -1
                }
                table_push(g_ann_arg_ids, a)
                argc = argc + 1
                if putil.eat(lex_comma) {
                    // 继续
                } else {
                    if !putil.expect(lex_rparen, "')'") {
                        return -1
                    }
                    d = true
                }
            }
        }
    }
    // 登记条目（声明节点 id 由 parse_annotated_decl 回填）
    var idx = len(g_ann_nodes)
    table_push(g_ann_nodes, -1)
    table_push(g_ann_names, name)
    table_push(g_ann_arg_off, arg_off)
    table_push(g_ann_arg_cnt, argc)
    table_push(g_ann_lines, line)
    table_push(g_ann_cols, col)
    return idx
}

// 注解参数是否编译期字面量：数字/浮点/字符串/字符/布尔/trit 字面量、
// 一元正负/取反包字面量、表字面量（cell 值递归字面量）。其余一律非字面量。
func is_annot_literal(n: i64) -> bool {
    if n < 0 {
        return false
    }
    var tag = ast.tag(n)
    if tag == N_INT_LIT || tag == N_FLOAT_LIT || tag == N_STR_LIT ||
        tag == N_CHAR_LIT || tag == N_BOOL_LIT || tag == N_TRIT_LIT {
        return true
    }
    if tag == N_UNARY {
        // 一元负号/正号/取反包字面量（如 @test(-1) / @test(!true)）
        if ast.val(n) == U_NEG || ast.val(n) == U_NOT {
            return is_annot_literal(ast.child_at(n, 0))
        }
        return false
    }
    if tag == N_TABLE_LIT {
        // 表字面量 cell children = [TableId 或 -1, 值]；值递归字面量检查
        var k: i64 = 0
        while k < ast.child_count(n) {
            var cell = ast.child_at(n, k)
            if !is_annot_literal(ast.child_at(cell, 1)) {
                return false
            }
            k = k + 1
        }
        return true
    }
    return false
}

// ---------- p.9.11.12 注解查询接口（编译期元数据） ----------
// 工具链消费（Keel 注册表 / tieapi / tdiag）在组件层做；本批提供可查询入口：
//   pann_count(decl) / pann_name(decl,i) / pann_argc(decl,i) /
//   pann_arg_node(decl,i,k) / pann_line(decl,i) / pann_col(decl,i)
// 注意：注册表按「最近一次 parse_program」的生命周期（import 展开会重置），
// 跨文件/import 的注解查询需组件层按文件基址偏移处理（后续批次）。

// 声明节点上的注解条数（无注解返回 0）。
pub func pann_count(decl: i64) -> i64 {
    var c: i64 = 0
    var i: i64 = 0
    while i < len(g_ann_nodes) {
        if g_ann_nodes[i] == decl {
            c = c + 1
        }
        i = i + 1
    }
    return c
}

// 第 i 条注解的注册表序号（-1 = 越界/无）。
func pann_idx(decl: i64, i: i64) -> i64 {
    var c: i64 = 0
    var k: i64 = 0
    while k < len(g_ann_nodes) {
        if g_ann_nodes[k] == decl {
            if c == i {
                return k
            }
            c = c + 1
        }
        k = k + 1
    }
    return -1
}

// 第 i 条注解名（字符串池 id；-1 = 越界）。
pub func pann_name(decl: i64, i: i64) -> i64 {
    var idx = pann_idx(decl, i)
    if idx < 0 {
        return -1
    }
    return g_ann_names[idx]
}

// 第 i 条注解参数个数。
pub func pann_argc(decl: i64, i: i64) -> i64 {
    var idx = pann_idx(decl, i)
    if idx < 0 {
        return -1
    }
    return g_ann_arg_cnt[idx]
}

// 第 i 条注解第 k 个参数的 AST 节点 id（-1 = 越界）。
pub func pann_arg_node(decl: i64, i: i64, k: i64) -> i64 {
    var idx = pann_idx(decl, i)
    if idx < 0 {
        return -1
    }
    if k < 0 || k >= g_ann_arg_cnt[idx] {
        return -1
    }
    return g_ann_arg_ids[g_ann_arg_off[idx] + k]
}

// 第 i 条注解起始行（1 起）。
pub func pann_line(decl: i64, i: i64) -> i64 {
    var idx = pann_idx(decl, i)
    if idx < 0 {
        return -1
    }
    return g_ann_lines[idx]
}

// 第 i 条注解起始列（1 起）。
pub func pann_col(decl: i64, i: i64) -> i64 {
    var idx = pann_idx(decl, i)
    if idx < 0 {
        return -1
    }
    return g_ann_cols[idx]
}

// ---------- p.9.11.29 doc 注释注册表（解析收尾回填，查询接口） ----------
// 归属回填：整份文件解析完后对顶层声明做一次 walk，凡声明节点起始行与某条
// doc 的声明起始行相等且双方均未被消费即登记（容器声明递归进成员：struct
// 字段/方法、actor 字段/方法、port/interface 方法、impl 方法、namespace 内
// 声明、enum 变体层不再下钻——变体无可附着的声明起始 token）。

// 声明节点 tag 判别（可附着 doc 的声明）。
func doc_is_decl_tag(t: i64) -> bool {
    if t == N_FN_DEF || t == N_IMPORT || t == N_NAMESPACE || t == N_USING {
        return true
    }
    if t == N_STRUCT || t == N_ENUM || t == N_EXTERN || t == N_VAR {
        return true
    }
    if t == N_CLASS_FIELD || t == N_MACRO_DEF || t == N_PORT ||
        t == N_IMPL || t == N_ACTOR {
        return true
    }
    return false
}

// 容器声明 tag 判别（children 里可能有带 doc 的成员声明；walk 只进容器，
// 不进函数/宏体——体内局部 var 不附着 doc）。
func doc_is_container_tag(t: i64) -> bool {
    return t == N_NAMESPACE || t == N_STRUCT || t == N_ENUM ||
        t == N_PORT || t == N_IMPL || t == N_ACTOR
}

// 按行号匹配：第 k 条 doc 登记到节点 node（doc 与节点双向至多一次；
// 同行多声明先到先得）。
func doc_match_attach(k: i64, node: i64) {
    if doc_claimed[k] == 1 {
        return
    }
    var dl = lextok.doc_entry_line(k)
    if dl != ast.line(node) {
        return
    }
    var i: i64 = 0
    while i < len(g_doc_nodes) {
        if g_doc_nodes[i] == node {
            return
        }
        i = i + 1
    }
    doc_claimed[k] = 1
    table_push(g_doc_nodes, node)
    table_push(g_doc_texts, lextok.doc_entry_text_id(k))
    table_push(g_doc_dlines, dl)
}

// 递归 walk：StmtList 展开；声明节点尝试匹配，容器声明递归成员。
func doc_walk(node: i64) {
    if node < 0 {
        return
    }
    if ast.is_stmt_list(node) {
        var i: i64 = 0
        while i < ast.child_count(node) {
            doc_walk(ast.child_at(node, i))
            i = i + 1
        }
        return
    }
    var t = ast.tag(node)
    if !doc_is_decl_tag(t) {
        return
    }
    var k: i64 = 0
    while k < lextok.doc_entry_count() {
        doc_match_attach(k, node)
        k = k + 1
    }
    if doc_is_container_tag(t) {
        var i2: i64 = 0
        while i2 < ast.child_count(node) {
            doc_walk(ast.child_at(node, i2))
            i2 = i2 + 1
        }
    }
}

// 解析收尾：doc 归属回填入口（parse_program 在 parse_deferred_all 后调用）。
func doc_attach_all(stmts: table<i64>) {
    // 已消费标记重建（长度 = 本文件 doc 条数）
    doc_claimed = table_new_i64()
    var k: i64 = 0
    while k < lextok.doc_entry_count() {
        table_push(doc_claimed, 0)
        k = k + 1
    }
    var i: i64 = 0
    while i < len(stmts) {
        doc_walk(stmts[i])
        i = i + 1
    }
}

// 已登记 doc 条数。
pub func pdoc_count() -> i64 {
    return len(g_doc_nodes)
}

// 第 i 条 doc 的声明节点 id。
pub func pdoc_node(i: i64) -> i64 {
    return g_doc_nodes[i]
}

// 第 i 条 doc 的文本池 id。
pub func pdoc_text_id(i: i64) -> i64 {
    return g_doc_texts[i]
}

// 第 i 条 doc 文本（声明起始行前连续 /// 内容，\n 拼接）。
pub func pdoc_text(i: i64) -> string {
    return interner.name_str(g_doc_texts[i])
}

// 第 i 条 doc 的声明起始行（1 起）。
pub func pdoc_line(i: i64) -> i64 {
    return g_doc_dlines[i]
}

// 声明节点 doc 文本（未登记返回空串）。
pub func pdoc_of(decl: i64) -> string {
    var i: i64 = 0
    while i < len(g_doc_nodes) {
        if g_doc_nodes[i] == decl {
            return interner.name_str(g_doc_texts[i])
        }
        i = i + 1
    }
    return ""
}

// 注册表可读摘要（--dump-docs 调试输出；tsp hover/补全经 pdoc_* 消费）。
pub func pdoc_dump() -> string {
    var out: string = "共 " + to_string(len(g_doc_nodes)) + " 条声明 doc:\n"
    var i: i64 = 0
    while i < len(g_doc_nodes) {
        var node = g_doc_nodes[i]
        var nm: string = "<匿名>"
        var nid = ast.name(node)
        if nid >= 0 {
            nm = interner.name_str(nid)
        }
        out = out + "  [" + to_string(g_doc_dlines[i]) + "] " + nm + ": " +
            interner.name_str(g_doc_texts[i]) + "\n"
        i = i + 1
    }
    return out
}

// ---------- 语句分派 ----------

// 解析一条或多条语句（var 解构可能产生多条，返回 StmtList；单条返回语句节点）
func parse_import() -> i64 {
    var line = putil.peek_line()
    var col = putil.peek_col()
    // p.9.11.14 重导出：`pub import "path" [as 别名]`——内联模型下 import 本就
    // 全量可见（重导出零成本），pub 仅作登记标记（N_IMPORT val bit0 = is_pub，
    // 供后续工具/诊断显示）。非法别名 token 由下方 expect_ident 拒绝。
    var is_pub: i64 = 0
    if putil.eat(lex_pub) {
        is_pub = 1
    }
    putil.advance()   // import
    var path = -1
    if putil.peek_tag() == lex_str {
        // 路径去首尾引号（字符串 lexeme 是原始切片含引号；Rust 版 path 无引号）
        var raw = putil.peek_lexeme()
        var rn = str_len(raw)
        var clean = str.clone(raw)
        if rn >= 2 {
            if str_char(raw, 0) == "\"" {
                if str_char(raw, rn - 1) == "\"" {
                    clean = str.slice(raw, 1, rn - 1)
                }
            }
        }
        path = interner.intern(clean)
        putil.advance()
    } else {
        putil.set_err(putil.peek_line(), putil.peek_col(), "import 后必须是字符串路径，实际是 " + putil.describe(putil.peek_tag()))
        return -1
    }
    var alias = -1
    if putil.eat(lex_as) {
        if putil.peek_tag() == lex_ident {
            alias = interner.intern(putil.peek_lexeme())
            putil.advance()
        } else {
            putil.set_err(putil.peek_line(), putil.peek_col(), "as 后必须是别名标识符，实际是 " + putil.describe(putil.peek_tag()))
            return -1
        }
    }
    // p.9.11.31 选择性导入：`import "path".{a, b}`——路径后可跟 `.{` 逗号分隔
    // 标识符列表。选中名作为 N_IMPORT 的子节点（N_VAR，name = 名字池 id）随
    // AST 进 sstate，semantic.expand_one_import 按此过滤登记（子节点为空 =
    // 普通 import 全量可见）。
    var sel: table<i64> = table_new_i64()
    if putil.eat(lex_dot) {
        if !putil.expect(lex_lbrace, "'{'") {
            return -1
        }
        var dsel = false
        while !dsel {
            var snm = putil.expect_ident()
            if snm < 0 {
                return -1
            }
            table_push(sel, ast.new_node(N_VAR, snm, -1, -1, putil.peek_line(), putil.peek_col()))
            if putil.eat(lex_comma) {
                // 继续
            } else {
                if !putil.expect(lex_rbrace, "'}'") {
                    return -1
                }
                dsel = true
            }
        }
    }
    if len(sel) > 0 {
        // 选择列表以 `}` 结尾——ASI 在 `}` 行尾不补分号（与 `>` 同类），可选消费
        putil.eat(lex_semi)
    } else {
        if !putil.expect(lex_semi, "import 语句结束的分号") {
            return -1
        }
    }
    var nimp = ast.new_node(N_IMPORT, path, is_pub, alias, line, col)
    if len(sel) > 0 {
        ast.set_children(nimp, sel)
    }
    return nimp
}

// using 引入语句：`using fmt2;` / `using fmt.error;`（仅顶层）
func parse_using() -> i64 {
    var line = putil.peek_line()
    var col = putil.peek_col()
    putil.advance()   // using
    var segs: table<i64> = table_new_i64()
    var s = putil.expect_ident()
    if s < 0 {
        return -1
    }
    table_push(segs, s)
    while putil.eat(lex_dot) {
        s = putil.expect_ident()
        if s < 0 {
            return -1
        }
        table_push(segs, s)
    }
    if !putil.expect(lex_semi, "using 语句结束的分号") {
        return -1
    }
    var n = ast.new_node(N_USING, -1, -1, len(segs), line, col)
    var kids: table<i64> = table_new_i64()
    var i: i64 = 0
    while i < len(segs) {
        table_push(kids, ast.new_node(N_SEGMENT, segs[i], -1, -1, line, col))
        i = i + 1
    }
    ast.set_children(n, kids)
    return n
}

// 命名空间声明：
//   `namespace tcmsg { ... }` / `namespace tcmsg.error { ... }`（块式）
//   `namespace tcmsg` / `namespace tcmsg;`（单文件模式，2026-08-14）：无 '{'，
//     文件其余全部顶层语句（直到 EOF）归入该命名空间；其中再遇 namespace
//     声明（块式或单文件式）递归嵌套。
func parse_namespace() -> i64 {
    var line = putil.peek_line()
    var col = putil.peek_col()
    putil.advance()   // namespace
    var segs: table<i64> = table_new_i64()
    var s = putil.expect_ident()
    if s < 0 {
        return -1
    }
    table_push(segs, s)
    while putil.eat(lex_dot) {
        s = putil.expect_ident()
        if s < 0 {
            return -1
        }
        table_push(segs, s)
    }
    var body_stmts: table<i64> = table_new_i64()
    var done = false
    if putil.peek_tag() == lex_lbrace {
        // ---- 块式：{ ... } ----
        putil.advance()
        while !done {
            var tag = putil.peek_tag()
            if tag == lex_rbrace {
                putil.advance()
                done = true
            } else if tag == lex_eof {
                if !putil.expect(lex_rbrace, "命名空间声明必须跟 '}'") {
                    return -1
                }
                done = true
            } else if tag == lex_func {
                var st = parse_fn_def()
                if st < 0 {
                    return -1
                }
                table_push(body_stmts, st)
            } else if tag == lex_pub {
                var st = parse_fn_def()
                if st < 0 {
                    return -1
                }
                table_push(body_stmts, st)
            } else if tag == lex_unsafe {
                // S1.2：unsafe fn / unsafe extern（按下一 token 分派）
                var nxtb = putil.peek_n(1)
                if nxtb == lex_extern {
                    var st = parse_extern()
                    if st < 0 {
                        return -1
                    }
                    table_push(body_stmts, st)
                } else {
                    var st = parse_fn_def()
                    if st < 0 {
                        return -1
                    }
                    table_push(body_stmts, st)
                }
            } else if tag == lex_repr {
                var st = parse_struct()
                if st < 0 {
                    return -1
                }
                table_push(body_stmts, st)
            } else if tag == lex_struct {
                var st = parse_struct()
                if st < 0 {
                    return -1
                }
                table_push(body_stmts, st)
            } else if tag == lex_actor {
                // 一期并发：命名空间内 actor 声明
                var st = parse_actor()
                if st < 0 {
                    return -1
                }
                table_push(body_stmts, st)
            } else if tag == lex_enum {
                var st = parse_enum()
                if st < 0 {
                    return -1
                }
                table_push(body_stmts, st)
            } else if tag == lex_port {
                // S2.4：命名空间内 port 声明
                var st = parse_port()
                if st < 0 {
                    return -1
                }
                table_push(body_stmts, st)
            } else if tag == lex_interface {
                // p.9.11.21：命名空间内 interface 声明（结构性接口）
                var st = parse_interface()
                if st < 0 {
                    return -1
                }
                table_push(body_stmts, st)
            } else if tag == lex_impl {
                // S2.4：命名空间内 impl 块
                var st = parse_impl()
                if st < 0 {
                    return -1
                }
                table_push(body_stmts, st)
            } else if tag == lex_namespace {
                var st = parse_namespace()
                if st < 0 {
                    return -1
                }
                table_push(body_stmts, st)
            } else if tag == lex_const {
                // p.9.12.4：`const fn` / `const func`（命名空间内）→ const fn 定义；
                // 否则 const 命名空间常量（以 ns::NAME 全名登记全局符号，
                // 语义/IR 复用顶层 const 全局通道；引用端 ns::NAME / 裸名 + 前缀补全）
                if putil.peek_lexeme_n(1) == "fn" || putil.peek_lexeme_n(1) == "func" {
                    var st = parse_fn_def()
                    if st < 0 {
                        return -1
                    }
                    table_push(body_stmts, st)
                } else {
                    var st = pstmt.parse_var_decl(1)
                    if st < 0 {
                        return -1
                    }
                    table_push(body_stmts, st)
                }
            } else {
                putil.set_err(putil.peek_line(), putil.peek_col(), "命名空间体内只允许函数定义、类定义或嵌套命名空间，实际是 " + putil.describe(tag))
                return -1
            }
        }
    } else {
        // ---- 单文件模式：无 '{'，剩余全部顶层语句归入（直到 EOF） ----
        // 行尾分号（ASI 补全或显式 `namespace foo;`）与本模式等价，直接吞掉
        putil.eat(lex_semi)
        while !done {
            var tag = putil.peek_tag()
            if tag == lex_eof {
                done = true
            } else if tag == lex_pub {
                // pub 后：pub func（方法）/ p.9.11.14 pub import（重导出）
                if putil.peek_n(1) == lex_import {
                    var st = parse_import()
                    if st < 0 {
                        return -1
                    }
                    table_push(body_stmts, st)
                } else {
                    var st = parse_fn_def()
                    if st < 0 {
                        return -1
                    }
                    table_push(body_stmts, st)
                }
            } else if tag == lex_func {
                var st = parse_fn_def()
                if st < 0 {
                    return -1
                }
                table_push(body_stmts, st)
            } else if tag == lex_unsafe {
                // S1.2：unsafe fn / unsafe extern（按下一 token 分派）
                var nxts = putil.peek_n(1)
                if nxts == lex_extern {
                    var st = parse_extern()
                    if st < 0 {
                        return -1
                    }
                    table_push(body_stmts, st)
                } else {
                    var st = parse_fn_def()
                    if st < 0 {
                        return -1
                    }
                    table_push(body_stmts, st)
                }
            } else if tag == lex_repr {
                var st = parse_struct()
                if st < 0 {
                    return -1
                }
                table_push(body_stmts, st)
            } else if tag == lex_import {
                var st = parse_import()
                if st < 0 {
                    return -1
                }
                table_push(body_stmts, st)
            } else if tag == lex_using {
                var st = parse_using()
                if st < 0 {
                    return -1
                }
                table_push(body_stmts, st)
            } else if tag == lex_struct {
                var st = parse_struct()
                if st < 0 {
                    return -1
                }
                table_push(body_stmts, st)
            } else if tag == lex_actor {
                // 一期并发：命名空间内 actor 声明
                var st = parse_actor()
                if st < 0 {
                    return -1
                }
                table_push(body_stmts, st)
            } else if tag == lex_enum {
                var st = parse_enum()
                if st < 0 {
                    return -1
                }
                table_push(body_stmts, st)
            } else if tag == lex_port {
                // S2.4：命名空间内 port 声明
                var st = parse_port()
                if st < 0 {
                    return -1
                }
                table_push(body_stmts, st)
            } else if tag == lex_interface {
                // p.9.11.21：命名空间内 interface 声明（结构性接口）
                var st = parse_interface()
                if st < 0 {
                    return -1
                }
                table_push(body_stmts, st)
            } else if tag == lex_impl {
                // S2.4：命名空间内 impl 块
                var st = parse_impl()
                if st < 0 {
                    return -1
                }
                table_push(body_stmts, st)
            } else if tag == lex_namespace {
                var st = parse_namespace()
                if st < 0 {
                    return -1
                }
                table_push(body_stmts, st)
            } else if tag == lex_extern {
                var st = parse_extern()
                if st < 0 {
                    return -1
                }
                table_push(body_stmts, st)
            } else if tag == lex_var {
                var st = pstmt.parse_var_decl(0)
                if st < 0 {
                    return -1
                }
                table_push(body_stmts, st)
            } else if tag == lex_const {
                // p.8.1.1：`const fn` / `const func`（命名空间内）→ const fn 定义；
                // 否则 const 全局变量
                if putil.peek_lexeme_n(1) == "fn" || putil.peek_lexeme_n(1) == "func" {
                    var st = parse_fn_def()
                    if st < 0 {
                        return -1
                    }
                    table_push(body_stmts, st)
                } else {
                    var st = pstmt.parse_var_decl(1)
                    if st < 0 {
                        return -1
                    }
                    table_push(body_stmts, st)
                }
            } else {
                putil.set_err(putil.peek_line(), putil.peek_col(), "顶层只允许函数定义、import、using、struct、enum、命名空间声明、extern 声明或全局变量，实际是 " + putil.describe(tag))
                return -1
            }
        }
    }
    var n = ast.new_node(N_NAMESPACE, -1, -1, len(segs), line, col)
    var kids: table<i64> = table_new_i64()
    var i: i64 = 0
    while i < len(segs) {
        table_push(kids, ast.new_node(N_SEGMENT, segs[i], -1, -1, line, col))
        i = i + 1
    }
    table_push(kids, ast.new_node(N_STMTLIST, -1, -1, -1, line, col))
    ast.set_children(n, kids)
    // 最后一个子节点（body StmtList）填充体语句
    ast.set_children(ast.child_at(n, len(segs)), body_stmts)
    return n
}

// extern 函数声明（T0.7）：`[unsafe] extern fn name(a: i64, b: string) -> bool;`
// S1.2 E3：extern 声明必须带 unsafe 标注（val = 1），调用必须在 unsafe 上下文。
func parse_extern() -> i64 {
    var line = putil.peek_line()
    var col = putil.peek_col()
    var unsafe_flag: i64 = 0
    if putil.peek_tag() == lex_unsafe {
        unsafe_flag = 1
        putil.advance()
    }
    putil.advance()   // extern
    if putil.peek_tag() == lex_ident {
        if putil.peek_lexeme() == "fn" {
            putil.advance()
        } else {
            putil.set_err(putil.peek_line(), putil.peek_col(), "extern 声明必须跟 'fn'，实际是 " + putil.describe(lex_ident))
            return -1
        }
    } else {
        putil.set_err(putil.peek_line(), putil.peek_col(), "extern 声明必须跟 'fn'，实际是 " + putil.describe(putil.peek_tag()))
        return -1
    }
    var name = putil.expect_ident()
    if name < 0 {
        return -1
    }
    if !putil.expect(lex_lparen, "'('") {
        return -1
    }
    var params: table<i64> = table_new_i64()
    if !putil.eat(lex_rparen) {
        var d = false
        while !d {
            var pname = putil.expect_ident()
            if pname < 0 {
                return -1
            }
            if !putil.expect(lex_colon, "':'") {
                return -1
            }
            var pty = pexpr_type.parse_type()
            if pty < 0 {
                return -1
            }
            var p = ast.new_node(N_PARAM, pname, 0, -1, putil.peek_line(), putil.peek_col())
            var pkids: table<i64> = table_new_i64()
            table_push(pkids, pty)
            table_push(pkids, -1)
            ast.set_children(p, pkids)
            table_push(params, p)
            if putil.eat(lex_comma) {
                // 继续
            } else {
                if !putil.expect(lex_rparen, "')'") {
                    return -1
                }
                d = true
            }
        }
    }
    var ret_ty = -1
    if putil.eat(lex_arrow) {
        ret_ty = pexpr_type.parse_type()
        if ret_ty < 0 {
            return -1
        }
    } else {
        ret_ty = ast.new_node(N_NAMED_TYPE, interner.intern("void"), 14, -1, line, col)
    }
    if !putil.expect(lex_semi, "extern 声明结束的分号") {
        return -1
    }
    var e = ast.new_node(N_EXTERN, name, unsafe_flag, len(params), line, col)
    var kids: table<i64> = table_new_i64()
    table_push(kids, ret_ty)
    var i: i64 = 0
    while i < len(params) {
        table_push(kids, params[i])
        i = i + 1
    }
    ast.set_children(e, kids)
    return e
}

// ---------- 函数 / struct 定义 ----------

// 类型参数列表（声明点）：`<T1, T2, ...>` → N_TYPE_PARAMS 节点
// （children = N_TYPE_PARAM 序列，每个 name 字段 = 类型参数名）。
// S2.4 泛型约束：`<T: Drawable>` —— N_TYPE_PARAM 增加 children：
// [约束类型节点或 -1]（第一版单约束：`T: Port`；多约束后置，见
// port-model.md §2.3）。约束类型节点 = pexpr_type.parse_type 产出的
// N_STRUCT_TYPE（语义层校验必须是已登记的 port）。
// 前提：当前 peek 为 '<'（函数名/struct 名后）。函数/struct 名后的 '<'
// 一定是类型参数列表（非泛型场景不存在），解析失败直接报错，不做 try 回退。
// p.9.11.32 类型别名：`alias Name = TypeNode;` / `alias Pair<T, U> = (T, U);`
// 纯透明别名：无新类型、无标称区分，语义层（sgen.parse_generic_type_node）
// 命中别名注册表时展开替换为目标类型（泛型别名做形参代换）。
// 产出 N_TYPE_ALIAS[name=别名, children=[类型参数(-1 或 N_TYPE_PARAMS), 目标类型节点]]。
func parse_alias() -> i64 {
    var line = putil.peek_line()
    var col = putil.peek_col()
    putil.advance()   // alias
    var name = putil.expect_ident()
    if name < 0 {
        return -1
    }
    var tparams = -1
    if putil.peek_tag() == lex_lt {
        tparams = parse_type_params()
        if tparams < 0 {
            return -1
        }
    }
    if !putil.expect(lex_eq, "'='") {
        return -1
    }
    var target = pexpr_type.parse_type()
    if target < 0 {
        return -1
    }
    if !putil.expect_stmt_end() {
        return -1
    }
    var n = ast.new_node(N_TYPE_ALIAS, name, -1, -1, line, col)
    var kids: table<i64> = table_new_i64()
    table_push(kids, tparams)
    table_push(kids, target)
    ast.set_children(n, kids)
    return n
}

func parse_type_params() -> i64 {
    var line = putil.peek_line()
    var col = putil.peek_col()
    if !putil.expect(lex_lt, "'<'") {
        return -1
    }
    var ps: table<i64> = table_new_i64()
    var p = putil.expect_ident()
    if p < 0 {
        return -1
    }
    table_push(ps, parse_type_param_one(p, line, col))
    while putil.eat(lex_comma) {
        p = putil.expect_ident()
        if p < 0 {
            return -1
        }
        table_push(ps, parse_type_param_one(p, line, col))
    }
    if !putil.expect_type_gt("类型参数列表后需 '>'") {
        return -1
    }
    // p.8.2.6 泛型糖之一：**约束简化**。`<T, U: Drawable>` 一条约束作用于
    // 从上一个约束组之后到当前参数的所有未约束参数（含当前）——不必为每个
    // 参数重复书写 `T: Drawable`。纯书写糖，导出 AST 形态与逐参数写约束
    // 完全一致（为回填参数克隆同名的 N_STRUCT_TYPE 约束节点，不共享节点 id，
    // 保持 AST 为严格树）。向后兼容：无共享场景时此回填恒为空操作。
    //   `<A: X, B: Y>`   → A:X, B:Y        （各自约束，不变）
    //   `<T, U: Drawable>` → T:Drawable, U:Drawable （U 的约束回填到 T）
    //   `<A: X, B, C: Y>` → A:X, B:Y, C:Y  （B 继承最近约束 Y）
    var lastc: i64 = -1
    var i: i64 = 0
    while i < len(ps) {
        var pp = ps[i]
        if ast.tag(pp) == N_TYPE_PARAM && ast.child_count(pp) > 0 {
            var c0 = ast.child_at(pp, 0)
            if c0 >= 0 {
                var k = lastc + 1
                while k < i {
                    var q = ps[k]
                    // v2：值参数（val==1）是整型容量参数，不接受 port 约束回填
                    if ast.tag(q) == N_TYPE_PARAM && ast.child_count(q) > 0 && ast.child_at(q, 0) < 0 && ast.val(q) == 0 {
                        var qd = -1
                        if ast.child_count(q) > 1 {
                            qd = ast.child_at(q, 1)
                        }
                        // 克隆约束节点（N_STRUCT_TYPE 同名 + children=[-1] 槽），
                        // 避免多父共享同一 AST 节点 id
                        var nid = ast.name(c0)
                        var clone = ast.new_node(N_STRUCT_TYPE, nid, -1, -1, ast.line(q), ast.col(q))
                        var kk: table<i64> = table_new_i64()
                        table_push(kk, -1)
                        ast.set_children(clone, kk)
                        var qkids: table<i64> = table_new_i64()
                        table_push(qkids, clone)
                        table_push(qkids, qd)
                        ast.set_children(q, qkids)
                    }
                    k = k + 1
                }
                lastc = i
            }
        }
        i = i + 1
    }
    var n = ast.new_node(N_TYPE_PARAMS, -1, -1, -1, line, col)
    ast.set_children(n, ps)
    return n
}

// p.8.1.3 显式特化实参列表：`<i64>` / `<i64, string>` / `<table<i64>>` → N_TYPE_ARGS
//（与调用点显式类型实参同节点形态；语义层 collect_fn 按 N_TYPE_ARGS 槽识别特化）
// 值参数（v2）：整型字面量实参 `<1280>`（N_INT_LIT）与类型实参同表混排；语义层
// 按模板参数 kind 分流。注：常量名值实参 `<CAP_X>` 一期不支持（用字面量；常量名
// 限于默认值处使用），避免与单标识符类型实参（`<Foo>`）在解析层产生歧义。
func parse_fn_spec_args() -> i64 {
    var line = putil.peek_line()
    var col = putil.peek_col()
    if !putil.expect(lex_lt, "'<'") {
        return -1
    }
    var kids: table<i64> = table_new_i64()
    var d = false
    while !d {
        if putil.peek_tag() == lex_int {
            var vline = putil.peek_line()
            var vcol = putil.peek_col()
            if putil.int_lit_overflow(putil.peek_lexeme()) {
                putil.set_err(vline, vcol, "值实参超出 i64 可表示范围")
                return -1
            }
            var nv = putil.parse_int_lit(putil.peek_lexeme())
            putil.advance()
            var nn = ast.new_node(N_INT_LIT, -1, nv, -1, vline, vcol)
            table_push(kids, nn)
        } else {
            var t = pexpr_type.parse_type()
            if t < 0 {
                return -1
            }
            table_push(kids, t)
        }
        if putil.eat(lex_comma) {
            // 继续
        } else {
            if !putil.expect_type_gt("类型实参列表后需 '>'") {
                return -1
            }
            d = true
        }
    }
    var n = ast.new_node(N_TYPE_ARGS, -1, -1, -1, line, col)
    ast.set_children(n, kids)
    return n
}

// 单个类型参数节点：`T` 或 `T: Drawable`（S2.4 约束）+ p.8.2.6 默认类型参数
// `T=string` / `T: Drawable = string`。
// 值参数（容量参数，v2）：`CAP: i64`（内建整型标量关键词标注）→ kind=1（val 字段），
// 可选默认整值 `CAP: i64 = 1280`（children[1] 存 N_INT_LIT 或 N_VAR(const 名)）。
// 产出 N_TYPE_PARAM[name=参数名, val=kind(0类型/1值), children=[约束或 -1, 默认值或 -1]]。
func parse_type_param_one(p: i64, line: i64, col: i64) -> i64 {
    var cons: table<i64> = table_new_i64()
    var kind: i64 = 0
    if putil.eat(lex_colon) {
        // 值参数标注：`: i64`（内建整型标量关键词）。tie 类型关键词与普通
        // 标识符同为 lex_ident，此处按 lexeme 字符串比对判定，避免与
        // `<T: Drawable>` 的 port 约束混淆。其余一律走既有约束分支。
        var lx = putil.peek_lexeme()
        if lx == "i64" {
            kind = 1
            putil.advance()   // 消费 "i64"（标注统一为 i64；语义层只认整型值参数）
            table_push(cons, -1)
        } else {
            // `T: Drawable`：冒号后必须是 port 类型引用（语义层校验）
            var cty = pexpr_type.parse_type()
            if cty < 0 {
                return -1
            }
            table_push(cons, cty)
        }
    } else {
        table_push(cons, -1)
    }
    // 默认值：`=` 后。值参数取整型字面量或常量名；类型参数取默认类型。
    var dflt: i64 = -1
    if putil.eat(lex_eq) {
        if kind == 1 {
            if putil.peek_tag() == lex_int {
                if putil.int_lit_overflow(putil.peek_lexeme()) {
                    putil.set_err(line, col, "值参数默认值超出 i64 可表示范围")
                    return -1
                }
                var nv = putil.parse_int_lit(putil.peek_lexeme())
                putil.advance()
                dflt = ast.new_node(N_INT_LIT, -1, nv, -1, line, col)
            } else if putil.peek_tag() == lex_ident {
                var cid = putil.expect_ident()
                dflt = ast.new_node(N_VAR, cid, -1, -1, line, col)
            } else {
                putil.set_err(line, col, "值参数默认值必须是整型字面量或常量名")
                return -1
            }
        } else {
            dflt = pexpr_type.parse_type()
            if dflt < 0 {
                return -1
            }
        }
    }
    table_push(cons, dflt)
    var n = ast.new_node(N_TYPE_PARAM, p, kind, -1, line, col)
    ast.set_children(n, cons)
    return n
}

// `[pub] [unsafe] func name [<T1, T2>] (params) -> Ty { stmts }`
// 泛型（2026-08-14）：名字后紧跟类型参数列表 `<T1, T2>`；产出 N_FN_DEF
// children = [泛型槽(-1或N_TYPE_PARAMS), 返回类型, 参数..., 函数体]。
// S1.2：val 复用为标志位（bit0=is_pub, bit1=is_unsafe）。
// 一期并发：val bit2 = is_async（`pub async func` = actor 异步投递方法；仅 actor
// 体内语义合法，解析层统一接受、语义层拦截非 actor 用法）。
// S2.4：port 方法签名（无体）由 parse_port_method 单独解析（见下）。
// ---------- p.9.11.28 return 可省：判定辅助 ----------

// 返回类型节点是否 void（显式 `-> void` 或缺省；缺省时同样是 void 语义）
func fn_ret_is_void(ret_ty: i64) -> bool {
    if ast.tag(ret_ty) == N_NAMED_TYPE {
        if interner.lookup(ast.name(ret_ty)) == "void" {
            return true
        }
    }
    return false
}

// 单表达式体省略判定：语句类 tag 排除（声明/赋值/控制流/异常/defer/unsafe/asm
// 等一律不触发省略）。漏排的语句 tag（如宏语句）会在语义层报返回类型不匹配
// ——编译期可见，无静默误编译面。
func fn_eligible_expr_stmt(t: i64) -> bool {
    if t == N_VAR_DECL || t == N_ASSIGN || t == N_RETURN || t == N_IF ||
        t == N_WHILE || t == N_FOR || t == N_BREAK || t == N_CONTINUE ||
        t == N_SWITCH || t == N_FIELD_ASSIGN || t == N_INDEX_ASSIGN ||
        t == N_UNSAFE_BLOCK || t == N_ASM || t == N_PANIC ||
        t == N_GUARD_STMT || t == N_DEFER {
        return false
    }
    return true
}

func parse_fn_def() -> i64 {
    var line = putil.peek_line()
    var col = putil.peek_col()
    var is_pub: i64 = 0
    var is_unsafe: i64 = 0
    var is_async: i64 = 0
    // p.8.1.1：const fn 编译期求值——`const [pub] func/fn name(...)`（val bit4）。
    // const 位置：pub 前（`const func`）或 pub 后（`pub const func`）均接受。
    var is_const: i64 = 0
    // p.9.11.10：`inline` 内联提示——`inline [pub] func name(...)`（val bit5）。
    // inline 置于 pub/const 之前。
    var is_inline: i64 = 0
    if putil.eat(lex_inline) {
        is_inline = 1
    }
    if putil.eat(lex_const) {
        is_const = 1
    }
    if putil.eat(lex_pub) {
        is_pub = 1
    }
    if is_const == 0 && putil.eat(lex_const) {
        is_const = 1
    }
    if putil.eat(lex_async) {
        is_async = 1
    }
    if putil.eat(lex_unsafe) {
        is_unsafe = 1
    }
    // `unsafe fn name(...)`：unsafe 模式用 'fn' 字样（对齐设计文档与 extern
    // 声明，fn 即 func 角色）；普通函数仍用 func 关键字。'fn' 是标识符 token。
    // p.8.1.1：const fn 同款（`const fn` 即 const 语义的 fn 字样）。
    if is_unsafe == 1 || is_const == 1 {
        if putil.peek_tag() == lex_ident && putil.peek_lexeme() == "fn" {
            putil.advance()
        } else if !putil.expect(lex_func, "'func'") {
            return -1
        }
    } else if !putil.expect(lex_func, "'func'") {
        return -1
    }
    var name = putil.expect_ident_quasi()
    if name < 0 {
        return -1
    }
    var type_params = -1
    var fn_spec = -1
    if putil.peek_tag() == lex_lt {
        // p.8.1.3 显式特化 vs 模板：`<` 后首 token 为标识符（如 T）→ 模板类型
        // 参数列表 `<T, E>`；否则（类型关键字如 i64/string 或嵌套如 table<i64>）
        // → 显式特化实参列表 `<i64>`（专用实现，调用点自动优先绑定）。
        if putil.peek_n(1) == lex_ident {
            type_params = parse_type_params()
            if type_params < 0 {
                return -1
            }
        } else {
            fn_spec = parse_fn_spec_args()
            if fn_spec < 0 {
                return -1
            }
        }
    }
    if !putil.expect(lex_lparen, "'('") {
        return -1
    }
    var params: table<i64> = table_new_i64()
    if !putil.eat(lex_rparen) {
        var d = false
        while !d {
            // p.9.11.11 immut 只读形参：`fn f(immut t: i64)`——immut 前缀置于
            // 参数名之前。immut 存 N_PARAM val bit1（val = by_ref | immut*2；
            // 既有按 s_vals[p] 读 by_ref 的站点须掩码 & 1）。
            var is_immut: i64 = 0
            if putil.eat(lex_immut) {
                is_immut = 1
            }
            var pname = putil.expect_ident_quasi()
            if pname < 0 {
                return -1
            }
            // S2.4：self 接收者可省略类型标注（`pub func draw(self, ctx: ptr)`）——
            // port/impl 方法的第一参数统一为 self。类型节点用占位
            // N_NAMED_TYPE(name="self", val=-1)，语义层（collect_impl）改写为
            // 实现 struct 类型；普通函数参数名 self 无标注时占位类型会在
            // 语义层报「类型 'self' 未定义」（自然拦截）。
            // 注意顺序：`name: ...T` 变参与 `name: ref T` 修饰在 ':' 之后、
            // 类型解析之前（原版顺序），self 无标注时跳过类型解析。
            var pty: i64 = -1
            if putil.peek_tag() == lex_colon {
                putil.advance()
            } else if interner.lookup(pname) == "self" {
                pty = ast.new_node(N_NAMED_TYPE, interner.intern("self"), -1, -1, putil.peek_line(), putil.peek_col())
            } else {
                putil.set_err(putil.peek_line(), putil.peek_col(), "参数必须标注类型（': 类型'），实际是 " + putil.describe(putil.peek_tag()))
                return -1
            }
            var is_var: i64 = 0
            if putil.eat(lex_ellipsis) {
                is_var = 1   // 变参：`name: ...T`（必须是最后一个参数）
            }
            var by_ref: i64 = 0
            if putil.eat(lex_ref) {
                by_ref = 1
            }
            if is_var == 1 && by_ref == 1 {
                putil.set_err(putil.peek_line(), putil.peek_col(), "变参参数不能同时使用 ref 修饰")
                return -1
            }
            if pty < 0 {
                pty = pexpr_type.parse_type()
                if pty < 0 {
                    return -1
                }
            }
            var pdef = -1
            if putil.eat(lex_eq) {
                if is_var == 1 {
                    putil.set_err(putil.peek_line(), putil.peek_col(), "变参参数不能有默认值")
                    return -1
                }
                pdef = pexpr.parse_expr()
                if pdef < 0 {
                    return -1
                }
            }
            if is_var == 1 && putil.peek_tag() == lex_comma {
                putil.set_err(putil.peek_line(), putil.peek_col(), "变参参数必须是最后一个参数")
                return -1
            }
            var p = ast.new_node(N_PARAM, pname, by_ref + is_immut * 2, is_var, putil.peek_line(), putil.peek_col())
            var pkids: table<i64> = table_new_i64()
            table_push(pkids, pty)
            table_push(pkids, pdef)
            ast.set_children(p, pkids)
            table_push(params, p)
            if putil.eat(lex_comma) {
                // 继续
            } else {
                if !putil.expect(lex_rparen, "')'") {
                    return -1
                }
                d = true
            }
        }
    }
    var ret_ty = -1
    // p.9.11.28：返回类型是否显式标注（省略体强制显式 -> R 的依据）
    var has_ret_ann = false
    if putil.eat(lex_arrow) {
        has_ret_ann = true
        ret_ty = pexpr_type.parse_type()
        if ret_ty < 0 {
            return -1
        }
    } else {
        ret_ty = ast.new_node(N_NAMED_TYPE, interner.intern("void"), 14, -1, line, col)
    }
    // ---------- p.9.11.28 return 可省：等号体 + 单表达式体 ----------
    // 等号体：`func f(...) -> R = expr`（无块体）——desugar 为显式 N_RETURN(expr)
    // 单语句体；省略形式（等号体）强制显式标注返回类型。混用等号体+块体报
    // 「形式二选一」。单表达式体：块体恰 1 条表达式语句且返回类型显式标注为
    // 非 void → 隐式 return（void 体维持原样——「-> void 配非 void 表达式报
    // 不匹配」的既有语义不受影响，普通语句体零变化）。
    var body = -1
    if putil.peek_tag() == lex_eq {
        if !has_ret_ann {
            putil.set_err(putil.peek_line(), putil.peek_col(), "省略体（= 表达式）必须显式标注返回类型 '-> R'")
            return -1
        }
        putil.advance()   // '='
        var ev = pexpr.parse_expr()
        if ev < 0 {
            return -1
        }
        if putil.peek_tag() == lex_lbrace {
            putil.set_err(putil.peek_line(), putil.peek_col(), "函数体形式二选一：等号体（= 表达式）与块体不能混用")
            return -1
        }
        // 消费语句结束符（ASI 补的分号/换行断句；对齐 parse_return）
        if !putil.expect_stmt_end() {
            return -1
        }
        var ret_n = ast.new_node(N_RETURN, -1, -1, -1, ast.line(ev), ast.col(ev))
        var rk: table<i64> = table_new_i64()
        table_push(rk, ev)
        ast.set_children(ret_n, rk)
        var sl = ast.new_node(N_STMTLIST, -1, -1, -1, line, col)
        var sk: table<i64> = table_new_i64()
        table_push(sk, ret_n)
        ast.set_children(sl, sk)
        body = sl
    } else {
        body = pstmt_flow.parse_block()
        if body < 0 {
            return -1
        }
        if has_ret_ann && ast.is_stmt_list(body) && ast.child_count(body) == 1 {
            var only = ast.child_at(body, 0)
            // 表达式语句被 N_EXPR_STMT 包装——省略时解包出表达式
            if ast.tag(only) == N_EXPR_STMT {
                only = ast.child_at(only, 0)
            }
            if !fn_ret_is_void(ret_ty) && fn_eligible_expr_stmt(ast.tag(only)) {
                var ret_n2 = ast.new_node(N_RETURN, -1, -1, -1, ast.line(only), ast.col(only))
                var rk2: table<i64> = table_new_i64()
                table_push(rk2, only)
                ast.set_children(ret_n2, rk2)
                var sl2 = ast.new_node(N_STMTLIST, -1, -1, -1, line, col)
                var sk2: table<i64> = table_new_i64()
                table_push(sk2, ret_n2)
                ast.set_children(sl2, sk2)
                body = sl2
            }
        }
    }
    var f = ast.new_node(N_FN_DEF, name, is_pub + is_unsafe * 2 + is_async * 4 + is_const * 16 + is_inline * 32, len(params), line, col)
    var kids: table<i64> = table_new_i64()
    if fn_spec >= 0 {
        table_push(kids, fn_spec)   // p.8.1.3 显式特化：泛型槽存 N_TYPE_ARGS
    } else {
        table_push(kids, type_params)
    }
    table_push(kids, ret_ty)
    var i: i64 = 0
    while i < len(params) {
        table_push(kids, params[i])
        i = i + 1
    }
    table_push(kids, body)
    ast.set_children(f, kids)
    // 三期通用 `#[]` 属性通道（§7.1）：`#[unsafe.share] func X` 等声明属性
    // 附着到函数节点（val bit3 = has_attr；函数级便捷 = 整函数隐式持证）
    if g_pending_attr != 0 {
        ast.set_val(f, ast.val(f) + 8)   // val bit3 = has_attr
        g_pending_attr = 0
    }
    return f
}

// `[pub] func name (params) -> Ty`（S2.4 port 方法签名；无函数体 = 签名声明）
// 与 parse_fn_def 的差异：函数体**可省略**（port 声明 = 方法签名集合；
// 带体 = 默认实现，语义层暂不支持报错）。参数支持 self 无类型标注
// （`pub func draw(self, ctx: ptr)`）。产出 N_FN_DEF（body 槽 = -1 或无体）。
func parse_port_method() -> i64 {
    var line = putil.peek_line()
    var col = putil.peek_col()
    var is_pub: i64 = 0
    if putil.eat(lex_pub) {
        is_pub = 1
    }
    if !putil.expect(lex_func, "'func'") {
        return -1
    }
    var name = putil.expect_ident()
    if name < 0 {
        return -1
    }
    if !putil.expect(lex_lparen, "'('") {
        return -1
    }
    var params: table<i64> = table_new_i64()
    if !putil.eat(lex_rparen) {
        var d = false
        while !d {
            var pname = putil.expect_ident()
            if pname < 0 {
                return -1
            }
            // self 接收者可省略类型标注（`pub func draw(self, ctx: ptr)`）；
            // 类型节点用占位 N_NAMED_TYPE(name="self", val=-1)，语义层
            // （scollect.collect_impl_one）改写为实现 struct 类型
            var pty: i64 = -1
            if putil.peek_tag() == lex_colon {
                putil.advance()
                pty = pexpr_type.parse_type()
                if pty < 0 {
                    return -1
                }
            } else if interner.lookup(pname) == "self" {
                pty = ast.new_node(N_NAMED_TYPE, interner.intern("self"), -1, -1, putil.peek_line(), putil.peek_col())
            } else {
                putil.set_err(putil.peek_line(), putil.peek_col(), "参数必须标注类型（': 类型'），实际是 " + putil.describe(putil.peek_tag()))
                return -1
            }
            var p = ast.new_node(N_PARAM, pname, 0, 0, putil.peek_line(), putil.peek_col())
            var pkids: table<i64> = table_new_i64()
            table_push(pkids, pty)
            table_push(pkids, -1)
            ast.set_children(p, pkids)
            table_push(params, p)
            if putil.eat(lex_comma) {
                // 继续
            } else {
                if !putil.expect(lex_rparen, "')'") {
                    return -1
                }
                d = true
            }
        }
    }
    var ret_ty = -1
    if putil.eat(lex_arrow) {
        ret_ty = pexpr_type.parse_type()
        if ret_ty < 0 {
            return -1
        }
    } else {
        ret_ty = ast.new_node(N_NAMED_TYPE, interner.intern("void"), 14, -1, line, col)
    }
    // 函数体可选：`{` 开头才解析（默认实现）；否则 body = -1（签名声明）
    var body: i64 = -1
    if putil.peek_tag() == lex_lbrace {
        body = pstmt_flow.parse_block()
        if body < 0 {
            return -1
        }
    }
    var f = ast.new_node(N_FN_DEF, name, is_pub, len(params), line, col)
    var kids: table<i64> = table_new_i64()
    table_push(kids, -1)   // 泛型槽（port 方法不支持泛型，恒 -1）
    table_push(kids, ret_ty)
    var i: i64 = 0
    while i < len(params) {
        table_push(kids, params[i])
        i = i + 1
    }
    table_push(kids, body)
    ast.set_children(f, kids)
    return f
}

// `port Name { [pub] func 方法签名... }`（S2.4，docs/plans/port-model.md §2.1）
// port = 名义接口，声明方法签名集合（不包含实现）；方法接收者统一为 self。
// 产出 N_PORT[name=port 名, val=kind, children=[泛型槽(-1), 方法 FnDef...]]。
// 方法体可选（无体 = 签名声明；默认实现暂不支持，语义层报错）。
// p.9.11.21 扩展：kind = -1 为 port（S2.4 名义接口，需显式 impl 块）；
// kind = 1 为 interface（结构性接口，实现关系 = 命名空间方法签名兼容，
// 无需显式 impl——鸭子多态的类型安全升级）。语法形态与 port 完全一致。
func parse_port() -> i64 {
    return parse_port_inner(-1)
}

// p.9.11.21：`interface Name { [pub] func 方法签名... }` 结构性接口声明。
// 语法与 port 一致（方法签名集合、第一参 self、无函数体），产出 N_PORT
// val=1 标记 interface——语义层（collect_port）据此区分实现关系判定。
func parse_interface() -> i64 {
    return parse_port_inner(1)
}

func parse_port_inner(kind: i64) -> i64 {
    var line = putil.peek_line()
    var col = putil.peek_col()
    putil.advance()   // port / interface
    var name = putil.expect_ident()
    if name < 0 {
        return -1
    }
    if !putil.expect(lex_lbrace, "'{'") {
        return -1
    }
    var methods: table<i64> = table_new_i64()
    var done = false
    while !done {
        var tag = putil.peek_tag()
        if tag == lex_rbrace {
            putil.advance()
            done = true
        } else if tag == lex_eof {
            if !putil.expect(lex_rbrace, "'}'") {
                return -1
            }
            done = true
        } else if tag == lex_semi {
            putil.advance()   // ASI 补的分号（方法签名行尾）
        } else if tag == lex_func || tag == lex_pub {
            // 方法签名（无体或带体；port/interface 方法必须是 pub func）
            var m = parse_port_method()
            if m < 0 {
                return -1
            }
            table_push(methods, m)
        } else {
            if kind == 1 {
                putil.set_err(putil.peek_line(), putil.peek_col(), "interface 体内只允许方法定义（pub func 签名），实际是 " + putil.describe(tag))
            } else {
                putil.set_err(putil.peek_line(), putil.peek_col(), "port 体内只允许方法定义（pub func 签名），实际是 " + putil.describe(tag))
            }
            return -1
        }
    }
    var p = ast.new_node(N_PORT, name, kind, -1, line, col)
    var pkids: table<i64> = table_new_i64()
    table_push(pkids, -1)   // 泛型槽（第一版 port/interface 不支持泛型，恒 -1）
    var i: i64 = 0
    while i < len(methods) {
        table_push(pkids, methods[i])
        i = i + 1
    }
    ast.set_children(p, pkids)
    return p
}

// `impl Port for Struct { [pub] func 方法... }`（S2.4，port-model.md §2.2）
// impl 块 = 声明"该 struct 的这些命名空间函数满足 port 签名"。
// 产出 N_IMPL[children=[port 类型节点, struct 类型节点, 方法 FnDef...]]。
// 方法必须有函数体（实现）；语义层以 <struct 名>::<方法名> 全名登记。
func parse_impl() -> i64 {
    var line = putil.peek_line()
    var col = putil.peek_col()
    putil.advance()   // impl
    var pty = pexpr_type.parse_type()
    if pty < 0 {
        return -1
    }
    if !putil.expect(lex_for, "'for'") {
        return -1
    }
    var sty = pexpr_type.parse_type()
    if sty < 0 {
        return -1
    }
    if !putil.expect(lex_lbrace, "'{'") {
        return -1
    }
    var methods: table<i64> = table_new_i64()
    var done = false
    while !done {
        var tag = putil.peek_tag()
        if tag == lex_rbrace {
            putil.advance()
            done = true
        } else if tag == lex_eof {
            if !putil.expect(lex_rbrace, "'}'") {
                return -1
            }
            done = true
        } else if tag == lex_semi {
            putil.advance()   // ASI 补的分号（方法实现块后）
        } else if tag == lex_func || tag == lex_pub {
            // 方法实现（必须有函数体）
            var m = parse_fn_def()
            if m < 0 {
                return -1
            }
            table_push(methods, m)
        } else {
            putil.set_err(putil.peek_line(), putil.peek_col(), "impl 体内只允许方法定义（pub func 实现），实际是 " + putil.describe(tag))
            return -1
        }
    }
    var im = ast.new_node(N_IMPL, -1, -1, -1, line, col)
    var ikids: table<i64> = table_new_i64()
    table_push(ikids, pty)
    table_push(ikids, sty)
    var i: i64 = 0
    while i < len(methods) {
        table_push(ikids, methods[i])
        i = i + 1
    }
    ast.set_children(im, ikids)
    return im
}

// `struct Name [<T1, T2>] [extends Parent] { 字段 }`（纯数据）
// 泛型（2026-08-14）：struct 名后紧跟类型参数列表；产出 N_STRUCT
// children = [泛型槽(-1或N_TYPE_PARAMS), ClassField...]。
// S1.2 R1：`repr(C) struct` → val = 1（显式 C 内存布局）；普通 struct val = -1。
// `actor Name { var ...; pub func ...; pub async func ... }`（一期并发原生语法）
// 例子：
//   actor Counter {
//       var count: i64 = 0
//       pub func inc(by: i64) -> i64 { count = count + by; return count }
//       pub async func reset() { count = 0 }
//   }
// 产出 N_ACTOR，children = [字段 N_CLASS_FIELD..., 方法 N_FN_DEF...]（无泛型槽，
// 一期 actor 不支持泛型）。字段与 struct 字段同构；方法经 parse_fn_def（自带
// pub/async/unsafe 关键字缀饰处理，async 用 N_FN_DEF val bit2 标记）。方法必须
// pub（语义层拦截非 pub 方法）；async 方法必须 void 返回（语义层拦截）。
func parse_actor() -> i64 {
    var line = putil.peek_line()
    var col = putil.peek_col()
    putil.advance()   // actor
    var name = putil.expect_ident()
    if name < 0 {
        return -1
    }
    if !putil.expect(lex_lbrace, "actor 声明必须跟 '{'") {
        return -1
    }
    var items: table<i64> = table_new_i64()
    var done = false
    while !done {
        var tag = putil.peek_tag()
        if tag == lex_rbrace {
            putil.advance()
            done = true
        } else if tag == lex_eof {
            if !putil.expect(lex_rbrace, "actor 声明必须跟 '}'") {
                return -1
            }
            done = true
        } else if tag == lex_semi {
            putil.advance()   // ASI 补的分号
        } else if tag == lex_var {
            // 状态字段：复用 struct 字段解析（N_CLASS_FIELD）
            var fl = putil.peek_line()
            var fc = putil.peek_col()
            putil.advance()   // var
            var fname = putil.expect_ident()
            if fname < 0 {
                return -1
            }
            var fty = -1
            if putil.eat(lex_colon) {
                fty = pexpr_type.parse_type()
                if fty < 0 {
                    return -1
                }
            }
            var finit = -1
            if putil.eat(lex_eq) {
                finit = pexpr.parse_expr()
                if finit < 0 {
                    return -1
                }
            }
            if !putil.expect(lex_semi, "actor 字段声明结束符") {
                return -1
            }
            var f = ast.new_node(N_CLASS_FIELD, fname, -1, -1, fl, fc)
            var fkids: table<i64> = table_new_i64()
            table_push(fkids, fty)
            table_push(fkids, finit)
            ast.set_children(f, fkids)
            table_push(items, f)
        } else if tag == lex_func || tag == lex_pub {
            // 消息方法：`[pub] [async] func ...`（parse_fn_def 处理修饰缀）
            var m = parse_fn_def()
            if m < 0 {
                return -1
            }
            table_push(items, m)
        } else {
            putil.set_err(putil.peek_line(), putil.peek_col(), "actor 体内只允许字段(var)或消息方法([pub][async]func)，实际是 " + putil.describe(tag))
            return -1
        }
    }
    var s = ast.new_node(N_ACTOR, name, -1, len(items), line, col)
    ast.set_children(s, items)
    // 三期通用 `#[]` 属性通道（§7.1）：`#[unsafe.share] actor X` 等声明属性
    // 附着到 actor 节点（val bit3 = 有属性；actor 级属性 = 整 actor 解锁对应域）
    if g_pending_attr != 0 {
        ast.set_val(s, 8)   // val bit3 = has_attr（语义层按属性名查 pending 域）
        g_pending_attr = 0
    }
    return s
}

func parse_struct() -> i64 {
    var line = putil.peek_line()
    var col = putil.peek_col()
    var reprc: i64 = -1
    if putil.eat(lex_repr) {
        // `repr(C)`：repr ( C )
        if !putil.expect(lex_lparen, "'('") {
            return -1
        }
        var tagc = putil.peek_tag()
        if tagc != lex_ident || putil.peek_lexeme() != "C" {
            putil.set_err(putil.peek_line(), putil.peek_col(), "repr 标注只支持 repr(C)，实际是 " + putil.describe(tagc))
            return -1
        }
        putil.advance()
        if !putil.expect(lex_rparen, "')'") {
            return -1
        }
        reprc = 1
    }
    putil.advance()   // struct
    var name = putil.expect_ident()
    if name < 0 {
        return -1
    }
    var type_params = -1
    if putil.peek_tag() == lex_lt {
        type_params = parse_type_params()
        if type_params < 0 {
            return -1
        }
    }
    var parent = -1
    if putil.eat(lex_extends) {
        parent = putil.expect_ident()
        if parent < 0 {
            return -1
        }
    }
    if !putil.expect(lex_lbrace, "'{'") {
        return -1
    }
    var fields: table<i64> = table_new_i64()
    var done = false
    while !done {
        var tag = putil.peek_tag()
        if tag == lex_rbrace {
            putil.advance()
            done = true
        } else if tag == lex_eof {
            if !putil.expect(lex_rbrace, "'}'") {
                return -1
            }
            done = true
        } else if tag == lex_var {
            var fl = putil.peek_line()
            var fc = putil.peek_col()
            putil.advance()   // var
            var fname = putil.expect_ident()
            if fname < 0 {
                return -1
            }
            var fty = -1
            if putil.eat(lex_colon) {
                fty = pexpr_type.parse_type()
                if fty < 0 {
                    return -1
                }
            }
            var finit = -1
            if putil.eat(lex_eq) {
                finit = pexpr.parse_expr()
                if finit < 0 {
                    return -1
                }
            }
            if !putil.expect(lex_semi, "字段声明结束符") {
                return -1
            }
            var f = ast.new_node(N_CLASS_FIELD, fname, -1, -1, fl, fc)
            var fkids: table<i64> = table_new_i64()
            table_push(fkids, fty)
            table_push(fkids, finit)
            ast.set_children(f, fkids)
            table_push(fields, f)
        } else if tag == lex_func {
            putil.set_err(putil.peek_line(), putil.peek_col(), "struct 体不允许方法定义：逻辑请用绑定 struct 名的命名空间函数定义（namespace 数据名 { pub func 方法名(首参: 数据名) ... }），调用仍写 obj.method()")
            return -1
        } else if tag == lex_pub {
            putil.set_err(putil.peek_line(), putil.peek_col(), "struct 体不允许方法定义：逻辑请用绑定 struct 名的命名空间函数定义（namespace 数据名 { pub func 方法名(首参: 数据名) ... }），调用仍写 obj.method()")
            return -1
        } else {
            putil.set_err(putil.peek_line(), putil.peek_col(), "struct 体内只允许字段(var)，实际是 " + putil.describe(tag))
            return -1
        }
    }
    var s = ast.new_node(N_STRUCT, name, reprc, parent, line, col)
    var skids: table<i64> = table_new_i64()
    table_push(skids, type_params)
    var fi: i64 = 0
    while fi < len(fields) {
        table_push(skids, fields[fi])
        fi = fi + 1
    }
    ast.set_children(s, skids)
    return s
}

// `enum Name [<T1, T2>] { VariantA VariantB(i64, string) }`（ADT 枚举，2026-08-15）
// 泛型（对齐 struct）：enum 名后紧跟类型参数列表；产出 N_ENUM
// children = [泛型槽(-1或N_TYPE_PARAMS), EnumVariant...]。
// 每个变体 = N_ENUM_VARIANT[name=变体名, children=[payload 类型...]]；
// 无 payload 变体 children 为空。p.9.12.5：变体分隔符放宽为可选——`;` / `,` /
// 无（空格或直接空位，下一变体名或 '}' 前）三种均可，语义互不影响；原有换行
// 分隔由 ASI 自动补 `;`（lexer finish_line）照旧工作。payload 类型逐个用
// pexpr_type.parse_type() 解析（可为内建泛型/struct 引用，一期白名单由语义层
// 校验；payload 括号内逗号已在 parse_type 循环消费，变体间逗号是括号外上下文，
// 安全区分）。
func parse_enum() -> i64 {
    var line = putil.peek_line()
    var col = putil.peek_col()
    putil.advance()   // enum
    var name = putil.expect_ident()
    if name < 0 {
        return -1
    }
    var type_params = -1
    if putil.peek_tag() == lex_lt {
        type_params = parse_type_params()
        if type_params < 0 {
            return -1
        }
    }
    if !putil.expect(lex_lbrace, "'{'") {
        return -1
    }
    var variants: table<i64> = table_new_i64()
    var done = false
    while !done {
        var tag = putil.peek_tag()
        if tag == lex_rbrace {
            putil.advance()
            done = true
        } else if tag == lex_eof {
            if !putil.expect(lex_rbrace, "'}'") {
                return -1
            }
            done = true
        } else {
            // 变体：`VariantA` 或 `VariantB(i64, string)`
            var vline = putil.peek_line()
            var vcol = putil.peek_col()
            var vname = putil.expect_ident()
            if vname < 0 {
                return -1
            }
            var ptys: table<i64> = table_new_i64()
            if putil.eat(lex_lparen) {
                if !putil.eat(lex_rparen) {
                    var d = false
                    while !d {
                        var pty = pexpr_type.parse_type()
                        if pty < 0 {
                            return -1
                        }
                        table_push(ptys, pty)
                        if putil.eat(lex_comma) {
                            // 继续
                        } else {
                            if !putil.expect(lex_rparen, "')'") {
                                return -1
                            }
                            d = true
                        }
                    }
                }
            }
            // p.9.12.5：变体分隔符可选——`;` / `,` / 无（空格或下一变体名/`}` 前
            // 直接空位）三种均可。换行分隔由 ASI 自动补 `;`，此处 eat 即消费；
            // 逗号分隔显式 eat（payload 括号内逗号已被 parse_type 消费完，不会误吞）；
            // 二者都没有则直接进入下一轮循环（同行空格分隔 / `}` 前无分隔符）。
            // 非法 token（如 `A = 5`）不进 eat 分支，由下一轮 expect_ident 给出
            // 清晰诊断「期望标识符，实际是 …」。
            if putil.eat(lex_semi) {
                // 分号分隔
            } else if putil.eat(lex_comma) {
                // 逗号分隔
            }
            var v = ast.new_node(N_ENUM_VARIANT, vname, -1, -1, vline, vcol)
            ast.set_children(v, ptys)
            table_push(variants, v)
        }
    }
    var e = ast.new_node(N_ENUM, name, -1, -1, line, col)
    var ekids: table<i64> = table_new_i64()
    table_push(ekids, type_params)
    var vi: i64 = 0
    while vi < len(variants) {
        table_push(ekids, variants[vi])
        vi = vi + 1
    }
    ast.set_children(e, ekids)
    return e
}

// ---------- 块 / 控制流语句 ----------

// `{ stmts }` 代码块：返回 StmtList 节点

}
