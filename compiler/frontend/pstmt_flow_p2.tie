type tie<class>
// compiler/frontend/pstmt_flow_p2.tie —— 分片 2（p.9.21.3 单文件 ≤800 行）
// ============================================================
// 由 split_parts.py 按行数贪心分片：只搬函数与紧邻注释，
// 顶层全局 var 与 import 树仍留在 pstmt_flow.tie。
namespace pstmt_flow {
// case 匹配模式：类型匹配（case string:）或值/区间表达式；
// 批次 7：枚举变体 payload 解构 `[Ident | A.B] "(" Ident ")"` → N_CASE_BIND；
// p.8.1.4：多字段解构 `[Ident | A.B] "(" Ident ("," Ident)* ")"`（绑定变量数
// 由语义层与变体 payload 字段数校验）。
func parse_case_pattern() -> i64 {
    if putil.peek_tag() == lex_typekw {
        var line = putil.peek_line()
        var col = putil.peek_col()
        var lid = interner.intern(putil.peek_lexeme())
        var tk = putil.typekw_index(putil.peek_lexeme())
        putil.advance()
        var t = ast.new_node(N_NAMED_TYPE, lid, tk, -1, line, col)
        var tl = ast.new_node(N_TYPE_LIT, -1, -1, -1, line, col)
        var kids: table<i64> = table_new_i64()
        table_push(kids, t)
        ast.set_children(tl, kids)
        return tl
    }
    // 枚举变体绑定模式（仅 Ident 起始才尝试；save/restore 支持回退到普通表达式）
    if putil.peek_tag() == lex_ident {
        var line = putil.peek_line()
        var col = putil.peek_col()
        putil.save_pos()
        var vr = parse_case_variant_ref(line, col)
        if vr >= 0 && putil.peek_tag() == lex_lparen {
            putil.advance()  // '('
            if putil.peek_tag() == lex_ident {
                var bkids: table<i64> = table_new_i64()
                table_push(bkids, vr)
                var bdone = false
                while !bdone {
                    var bind_name = interner.intern(putil.peek_lexeme())
                    putil.advance()
                    table_push(bkids, bind_name)
                    if putil.eat(lex_comma) {
                        if putil.peek_tag() != lex_ident {
                            break  // 非法（缺绑定名）→ 走 restore 回退
                        }
                    } else {
                        bdone = true
                    }
                }
                if bdone && putil.expect(lex_rparen, "')'") {
                    var n = ast.new_node(N_CASE_BIND, -1, -1, -1, line, col)
                    ast.set_children(n, bkids)
                    return n
                }
            }
        }
        putil.restore_pos()
    }
    return pexpr.parse_case_arm_pattern()
}

// 枚举变体引用链：Ident(.Ident)* → N_VAR / N_FIELD_ACCESS（case pattern 专用；
// 解析失败不消费（调用方 restore_pos 回退））
func parse_case_variant_ref(line: i64, col: i64) -> i64 {
    if putil.peek_tag() != lex_ident {
        return -1
    }
    var nm = interner.intern(putil.peek_lexeme())
    putil.advance()
    var expr = ast.new_node(N_VAR, nm, -1, -1, line, col)
    while putil.peek_tag() == lex_dot {
        putil.advance()
        if putil.peek_tag() != lex_ident {
            return -1
        }
        var field = interner.intern(putil.peek_lexeme())
        putil.advance()
        var fa = ast.new_node(N_FIELD_ACCESS, field, -1, -1, line, col)
        var fkids: table<i64> = table_new_i64()
        table_push(fkids, expr)
        ast.set_children(fa, fkids)
        expr = fa
    }
    return expr
}

// `return [expr]`
func parse_return() -> i64 {
    var line = putil.peek_line()
    var col = putil.peek_col()
    putil.advance()   // return
    var expr = -1
    if putil.peek_tag() != lex_semi {
        expr = pexpr.parse_expr()
        if expr < 0 {
            return -1
        }
    }
    if !putil.expect_stmt_end() {
        return -1
    }
    var n = ast.new_node(N_RETURN, -1, -1, -1, line, col)
    var kids: table<i64> = table_new_i64()
    table_push(kids, expr)
    ast.set_children(n, kids)
    return n
}

// p.9.11.15 yield 生成器产出语句：`yield expr;`——产出单值并继续执行。
// 产出值表达式必填（无值 yield 不支持——须声明元素类型）；语句结束符同
// return（ASI 自动补分号）。产出 N_YIELD[name=-1, children=[expr]]。
func parse_yield() -> i64 {
    var line = putil.peek_line()
    var col = putil.peek_col()
    putil.advance()   // yield
    var expr = pexpr.parse_expr()
    if expr < 0 {
        return -1
    }
    if !putil.expect_stmt_end() {
        return -1
    }
    var n = ast.new_node(N_YIELD, -1, -1, -1, line, col)
    var kids: table<i64> = table_new_i64()
    table_push(kids, expr)
    ast.set_children(n, kids)
    return n
}

}