type tie<class>
// compiler/frontend/smove_stmt.tie —— S1.5 移动语义独立检查 pass（语句检查分区）
// ============================================================
// 从 smove.tie 拆分出的"语句检查"分区：负责移动语义检查的语句级递归遍历
// （check_stmt / check_switch_case / check_block / push_ns_of）。
//
// # 分区范式
//   tie import 文本内联：本文件全部代码并入编译单元，一切符号全局可见；
//   本文件与 smove.tie 共用 `namespace smove`（同名 namespace 跨多文件闭合并集）。
//   同 namespace 跨文件函数可互相裸名调用、访问主文件顶层全局 var。
//   与 sinfer_ret / sgen_inst / scollect_port 的分文件范式一致。
//
// # 依赖
//   依赖主文件 smove.tie 保留的辅助函数（is_owned/var_nid/var_is_const/
//   is_move_src/check_expr_read）与 sstate/types 全局表，跨文件裸调保持。
//   不含全局 var、不含 import（由主文件 smove.tie import 本文件）。

namespace smove {

// ==================== 语句检查 ====================
func check_stmt(s: i64) -> i64 {
    var tag = s_tags[s]
    // 语句级宏（dev33 批次10 任务28）展开残留的嵌套 StmtList / 块形式
    // N_CODE_LIT（`$body` 插值块后）：按语句块递归（与 scheck 处理一致）。
    if tag == S_N_STMTLIST {
        return check_block(s)
    }
    if tag == S_N_CODE_LIT {
        if s_vals[s] == 1 {
            var inner = sstate.child(s, 0)
            if inner >= 0 {
                return check_block(inner)
            }
            return 0
        }
        return 0
    }
    // VarDecl：children=[类型或 -1, 初值]
    if tag == S_N_VAR_DECL {
        var init = sstate.child(s, 1)
        if init >= 0 {
            // **any 装箱同样不消耗源**：any 是类型擦除的值单元，不提供修改原对象
            // 的途径（取出必须经显式 as_*），装箱本身不增加别名风险。
            // 2026-10-03 起本分支统一走 check_expr_read（纯读取检查），
            // any 装箱与普通按值初始化一并覆盖，故原先的 boxed_to_any
            // 特判判据随「按类型推断消耗源」一并移除——它是那条推断的补偿项。
            // 直接变量初值 + 堆类型 + 非 const → 源移动。
            // ★ 必须走 move_var（检查 + 标记）：此处曾只 mark 不检查，导致
            // `var b = a; var c = a` 编译通过——同一份所有权两个持有者。
            //
            // ★ 2026-10-03 修正：改为**不再**按类型推断消耗源。规范 §13.1 明文
            //   「赋值与传参默认按值：新位置得到一份独立的值，原位置继续有效」，
            //   §13.2 才是移动且要求**显式 `move` 记号**——`var b = a` 正是「按值
            //   赋值」的教科书形态，把它判成移动与规范直接冲突。
            //   误报实例：tiu api/tests/probe_m1 L95 `var lE = lA`，而该行下方
            //   的断言恰恰在验证「struct 字段拷贝是值语义」——探针预期与规范一致，
            //   编译器却拒绝。table/map 无refcount 析构，不存在二次释放。
            // 显式 `move x: T` 记号在 smove_move.tie 单独处理，不走此路径。
            var nid = var_nid(init)
            if nid >= 0 {
                // ★ 凭据（guard<cap>）是唯一例外：规范 §11.6 明令「凭据可以转移，
                //   但不能复制，因此同一时刻只有一处持有它」，`var g2 = g; var g3 = g`
                //   若放行即两处同时持有 mem 域权限——这是硬约束，不受 §13.1
                //   「按值」影响（凭据不是值，是身份）。负例语料
                //   tests/language/cred_dup_move_neg.tie 守这条。
                if var_is_const(nid) == 0 && is_cred_only(init) {
                    var mv = move_var(nid, init)
                    if mv < 0 {
                        return -1
                    }
                } else {
                    var r = check_expr_read(init)
                    if r < 0 {
                        return -1
                    }
                }
            } else {
                // 复杂初值：递归读取检查
                var r = check_expr_read(init)
                if r < 0 {
                    return -1
                }
            }
        }
        return 0
    }
    // Assign：name=目标名, children=[值]
    if tag == S_N_ASSIGN {
        var nm = sstate.name_str(s)
        var tgt = interner.intern(nm)
        var val = sstate.child(s, 0)
        var op = s_vals[s]
        if op < 0 {
            // 普通赋值：右侧按值读取（§13.1「赋值默认按值，原位置继续有效」），
            // 故**不消耗源**。2026-10-03 起与 var 初值位对齐——此前按堆类型
            // 推断会把 `b = a` 判成移动，与 §13.1 冲突。
            // `a = a` 与复杂表达式同走读取检查（已moved 则报错）。
            var nid_r = var_nid(val)
            if nid_r >= 0 && nid_r != tgt {
                // 凭据例外：见 VarDecl 位同处注释（§11.6 身份唯一，赋值即扩散）。
                if var_is_const(nid_r) == 0 && is_cred_only(val) {
                    var mv = move_var(nid_r, val)
                    if mv < 0 {
                        return -1
                    }
                } else {
                    var rr = check_expr_read(val)
                    if rr < 0 {
                        return -1
                    }
                }
            } else {
                // 复杂表达式或 a = a：读取检查（moved 则报错）
                var r = check_expr_read(val)
                if r < 0 {
                    return -1
                }
            }
            // 目标恢复 live（重新赋值 = 重新初始化）
            sstate.lv_moved_unmark(tgt)
        } else {
            // 复合赋值（+= 等）：右侧是读取（先读旧值再写）
            var r2 = check_expr_read(val)
            if r2 < 0 {
                return -1
            }
        }
        return 0
    }
    // Return：children=[表达式或 -1]
    if tag == S_N_RETURN {
        var v = sstate.child(s, 0)
        if v >= 0 {
            var nid = var_nid(v)
            if nid >= 0 {
                if var_is_const(nid) == 0 && is_move_src(v) {
                    var mv = move_var(nid, v)
                    if mv < 0 {
                        return -1
                    }
                }
            } else {
                var r = check_expr_read(v)
                if r < 0 {
                    return -1
                }
            }
        }
        return 0
    }
    // ExprStmt：children=[表达式]
    if tag == S_N_EXPR_STMT {
        var e = sstate.child(s, 0)
        // 语句级宏（dev33 批次10 任务28）：`$body` 插值块后子节点是块形式
        // N_CODE_LIT / 嵌套 StmtList → 按语句块递归（不按表达式读取检查）。
        if e >= 0 {
            var et = s_tags[e]
            if et == S_N_STMTLIST {
                return check_block(e)
            }
            if et == S_N_CODE_LIT && s_vals[e] == 1 {
                var inner = sstate.child(e, 0)
                if inner >= 0 {
                    return check_block(inner)
                }
                return 0
            }
            // p.9.11.3 try 错误聚合块：表达式位，其块体是语句 → 按块遍历移动语义
            if et == S_N_TRY_BLOCK {
                return check_block(sstate.child(e, 0))
            }
        }
        return check_expr_read(e)
    }
    // If：children=[条件, then, else]
    // 分支状态隔离：检查条件 → 快照 → 检查 then → 恢复快照 → 检查 else → 恢复快照。
    // 分支内 return/赋值触发的移动标记不泄漏到分支外（分支互斥路径，
    // 如 `if m == 0 { return s }` 后继续用 s 是合法模式）。
    if tag == S_N_IF {
        var r1 = check_expr_read(sstate.child(s, 0))
        if r1 < 0 {
            return -1
        }
        var snap1 = sstate.lv_moved_snap()
        var r2 = check_block(sstate.child(s, 1))
        if r2 < 0 {
            return -1
        }
        sstate.lv_moved_restore(snap1)
        var els = sstate.child(s, 2)
        if els >= 0 {
            var snap2 = sstate.lv_moved_snap()
            var r3 = check_block(els)
            if r3 < 0 {
                return -1
            }
            sstate.lv_moved_restore(snap2)
        }
        return 0
    }
    // While：children=[条件, 体]
    // 循环体状态隔离：条件读取 → 快照 → 检查体 → 恢复（循环每次迭代独立）。
    if tag == S_N_WHILE {
        var r4 = check_expr_read(sstate.child(s, 0))
        if r4 < 0 {
            return -1
        }
        var snap3 = sstate.lv_moved_snap()
        var r4b = check_block(sstate.child(s, 1))
        if r4b < 0 {
            return -1
        }
        sstate.lv_moved_restore(snap3)
        return 0
    }
    // For：name=迭代变量, children=[迭代对象, 体]
    // 迭代对象 = 读取（表遍历借用，不移动）；范围两端 = 读取。
    // 迭代变量每次迭代重新赋值（恢复 live）——循环体内移动它后，
    // 下次迭代重新绑定；循环结束变量保留最后值（重新赋值语义）。
    // 循环体状态隔离（每次迭代独立，移动标记不泄漏到循环外）。
    if tag == S_N_FOR {
        var iter = sstate.child(s, 0)
        var r5 = check_expr_read(iter)
        if r5 < 0 {
            return -1
        }
        // 迭代变量重新赋值（恢复 live）——循环体检查前 unmark
        var iter_nm = sstate.name_str(s)
        if str_len(iter_nm) > 0 {
            var iter_nid = interner.intern(iter_nm)
            sstate.lv_moved_unmark(iter_nid)
        }
        var snap6 = sstate.lv_moved_snap()
        var r5b = check_block(sstate.child(s, 1))
        if r5b < 0 {
            return -1
        }
        sstate.lv_moved_restore(snap6)
        return 0
    }
    // Switch：children=[主体, case..., default]；主体读取 + 各 case 体
    // 各 case 分支状态隔离（互斥路径，移动标记不跨 case 泄漏）。
    if tag == S_N_SWITCH {
        var r6 = check_expr_read(sstate.child(s, 0))
        if r6 < 0 {
            return -1
        }
        var ncases = s_aux[s]
        var i: i64 = 0
        while i < ncases {
            var snap4 = sstate.lv_moved_snap()
            var c = sstate.child(s, 1 + i)
            var r7 = check_switch_case(c)
            if r7 < 0 {
                return -1
            }
            sstate.lv_moved_restore(snap4)
            i = i + 1
        }
        var dflt = sstate.child(s, 1 + ncases)
        if dflt >= 0 {
            var snap5 = sstate.lv_moved_snap()
            var r8 = check_block(dflt)
            if r8 < 0 {
                return -1
            }
            sstate.lv_moved_restore(snap5)
        }
        return 0
    }
    // Break/Continue：无变量
    if tag == S_N_BREAK || tag == S_N_CONTINUE {
        return 0
    }
    // 三期 goto（§7.1.5）：标签无操作；goto 不移动任何变量（控制流改指，
    // 变量生命周期由块作用域确定性释放承载，R2/R3 语义层已校验）
    if tag == S_N_GOTO_LABEL || tag == S_N_GOTO {
        return 0
    }
    // 三期 A 组 guard<cap>（§7.1.1）：unsafe.get 表达式作表达式（children 读/
    // move 处理）；unsafe use/with 块遍历子语句。凭据本身 move-only 由语义层
    // 拦截复制（此处仅正常遍历）。
    if tag == S_N_GUARD_USE {
        var blk_u = sstate.child(s, 0)
        if blk_u >= 0 {
            return check_block(blk_u)
        }
        return 0
    }
    if tag == S_N_GUARD_WITH {
        var blk_w = sstate.child(s, 1)
        if blk_w >= 0 {
            return check_block(blk_w)
        }
        return 0
    }
    // p.9.11.4 defer 资源释放：块体遍历移动语义（读作用域变量/赋值）
    if tag == S_N_DEFER {
        var blk_d = sstate.child(s, 0)
        if blk_d >= 0 {
            return check_block(blk_d)
        }
        return 0
    }
    if tag == S_N_GUARD_GET {
        var bind_g = sstate.child(s, 1)
        if bind_g >= 0 {
            return check_expr_read(bind_g)
        }
        return 0
    }
    if tag == S_N_GUARD_REVOKE {
        // r.1.6.7 `unsafe.revoke(g)`：实参**豁免** moved 检查。
        // 理由：`delegate` 会 move 消费接收者（父凭据），而规范语义要求
        // 「撤销父凭据 ⇒ 其派生凭据一并失效」——若在此对已 move 的父凭据报
        // moved 错，撤销父就永远不可达，该语义成为死条文。撤销的对象是
        // **凭据身份**（编译期概念），不是运行时值，故不受 moved 约束；
        // 实参的类型/定义有效性由 sinfer 的 infer_expr 保证。
        return 0
    }
    // FieldAssign：children=[基址, 值]（基址按引用；值 = **复制**入字段）
    // ★ 值位置**不消耗**来源（2026-10-02）：`c.conn = sc` 之后继续读 `sc`
    // 是 tie 的惯用写法（实测 tlib 的 sse::connect / httpc::open_stream 均如此）。
    // 依据与「any 装箱不消耗源」同一条：赋值把**值的一份句柄**存进字段，tie 无
    // 析构器 ⇒ 源依然有效，不存在「已释放仍可用」的危险；把它判成移动会让
    // 「先存字段、再从局部继续用」这一自然写法全部报错。
    // 基址仍需 check_expr_read（读它本身要合法）。
    if tag == S_N_FIELD_ASSIGN {
        var base = sstate.child(s, 0)
        var r9 = check_expr_read(base)
        if r9 < 0 {
            return -1
        }
        var val2 = sstate.child(s, 1)
        var r10 = check_expr_read(val2)
        if r10 < 0 {
            return -1
        }
        return 0
    }
    // IndexAssign：children=[目标, 值]（目标按引用；值 = **复制**入元素）
    // ★ 同 FieldAssign：值位置不消耗来源。
    if tag == S_N_INDEX_ASSIGN {
        var tgt2 = sstate.child(s, 0)
        var r11 = check_expr_read(tgt2)
        if r11 < 0 {
            return -1
        }
        var val3 = sstate.child(s, 1)
        var r12 = check_expr_read(val3)
        if r12 < 0 {
            return -1
        }
        return 0
    }
    return 0
}

// switch case：children=[PatternList, when 或 -1, 体]
func check_switch_case(c: i64) -> i64 {
    var nc = sstate.nchild(c)
    if nc >= 3 {
        var when_node = sstate.child(c, 1)
        if when_node >= 0 {
            var r = check_expr_read(when_node)
            if r < 0 {
                return -1
            }
        }
        return check_block(sstate.child(c, 2))
    }
    return 0
}

// 语句块检查（StmtList）
func check_block(blk: i64) -> i64 {
    if blk < 0 {
        return 0
    }
    var n = sstate.nchild(blk)
    var i: i64 = 0
    while i < n {
        var s = sstate.child(blk, i)
        var r = check_stmt(s)
        if r < 0 {
            return -1
        }
        i = i + 1
    }
    return 0
}

// full 名 "::" 段（除最后一段函数名）压 ns_stack，返回压入段数（对齐
// scheck.push_ns_of；命名空间上下文重建）
func push_ns_of(full: string) -> i64 {
    var cnt: i64 = 0
    var n = str_len(full)
    var pos: i64 = 0
    var seg_start: i64 = 0
    while pos < n {
        if pos + 1 < n && str_char(full, pos) == ":" && str_char(full, pos + 1) == ":" {
            var seg = str.slice(full, seg_start, pos)
            sstate.ns_push(intern.intern(seg))
            cnt = cnt + 1
            pos = pos + 2
            seg_start = pos
        } else {
            pos = pos + 1
        }
    }
    return cnt
}

}