type tie<class>
// compiler/frontend/mexpand.tie —— S3.3 宏/元编程：编译期宏展开 pass
// ============================================================
// 里程碑：S3.3（docs/plans/macro-model.md：M3 函数式宏 + C1+C2+C3 code
// 三形态 + H2+H3 卫生）。宏展开在语义检查之前完成（展开结果参与类型
// 检查），位置：semantic.check_ast 在 copy_ast_tables 之后、expand_imports
// 之前调用本模块（sstate 池上操作，与语义共享同一 AST 表示）。
//
// # 展开模型（tie 写宏，编译期执行）
//   - 宏定义（N_MACRO_DEF）：顶层 `macro name(x: code) -> code { 体 }`。
//     本 pass 收集宏定义、从顶层移除（不参与语义/IR）、序列化为 AST 协议
//     文本注册进 interp（eval_proto，宏体由解释器编译期执行）。
//   - 宏调用（N_CALL，name ∈ 宏表）：实参子树序列化为协议文本（code 值）
//     → interp.eval_macro 执行宏体 → 返回 code 值（协议文本）→ 追加加载
//     进 s_* 池 → 替换调用点（表达式位置替换节点；语句位置可展开为多条
//     语句/函数定义）。
//   - 递归展开：展开结果可再含宏调用——循环扫描全池直到无展开（轮次上限
//     64 防无限递归）；宏体内调用宏由 interp 的 gen_call 宏分派处理。
//   - 卫生：H2 词法卫生在准引用求值（gen_code_lit）时完成（宏体绑定改名
//     __hygN_）；H3 gensym 由宏体显式调用（__tie_gensymN_ 前缀）。
//
// # 限制（第一版）
//   - 宏定义与使用必须在同一文件（跨文件宏未支持：import 文件的宏定义由
//     scollect 报错，宏调用按未定义函数报错）；
//   - 宏调用点实参必须是表达式（调用点 AST 快照 = code 值，不惰性求值）；
//   - 展开轮次上限 64。
//
// # 依赖与 import 树
//   import "../interp/interp.tie"（interp → session → value + parser 树 +
//   sstate 树；无环）。本模块由 semantic 树 import（semantic import
//   "./mexpand.tie"），与语义链共享 s_* 池与 sm_err_* 错误槽。

import "../interp/interp.tie"

// ==================== 宏表 ====================
var g_macro_keys: table<i64>;   // 宏名池 id（升序语义：线性查找即可）
var g_macro_nodes: table<i64>;  // 宏定义节点 id（与 keys 平行）
var g_macro_isproc: table<i64>; // 过程宏标记（1 = #[macro] token 流宏，与 keys 平行）
var g_macro_ispub: table<i64>;  // pub 导出标记（1 = pub macro 跨文件可见）
var g_macro_file: table<i64>;   // 宏定义所属文件 id（g_file_roots 编号；主文件 0）

// p.8.2.12 声明式宏表（与 g_macro_keys 平行索引）：g_macro_isdecl[mi] =
// 1 = 声明式宏（裸形参模板宏，N_DECL_MACRO_DEF）；g_dbody[mi] = 宏体 StmtList
// 的 AST 协议文本。声明式宏不注册进 interp（不编译期执行），展开时由 mexpand
// 直接模板代换 + 卫生唯一化（形参名/个数每次展开从登记定义节点现场读取）。
var g_macro_isdecl: table<i64>;
var g_dbody: table<string>;
// 声明式宏展开时的卫生改名映射（每次展开重置）：g_dhyk/g_dhyv 平行（原名字
// id -> 唯一化后名字 id）；g_dhyseq = 序号生成器（跨展开单调，保证多处展开
// 的卫生临时名互不冲突）。
var g_dhyk: table<i64>;
var g_dhyv: table<i64>;
var g_dhyseq: i64 = 0;

// ==================== s_* 池快照（宏执行隔离） ====================
// 宏执行（interp.eval_proto / eval_macro / eval_code / .call()）内部会
// sstate.load_ast **重建** s_* 池（宏定义/宏体是独立协议文本）——mexpand
// 的工作池（主文件 AST + 已展开追加）会被破坏。方案：每次宏执行前后
// 保存/恢复池快照（10 张表深拷贝；展开次数少，代价可接受）。
// 注意：表赋值是句柄共享，快照必须逐元素拷贝；恢复 = 重新绑定全局表。
var g_pool_tags: table<i64>;
var g_pool_names: table<i64>;
var g_pool_vals: table<i64>;
var g_pool_aux: table<i64>;
var g_pool_coff: table<i64>;
var g_pool_nchild: table<i64>;
var g_pool_children: table<i64>;
var g_pool_lines: table<i64>;
var g_pool_cols: table<i64>;
var g_pool_types: table<i64>;
var g_pool_sn: i64 = 0;        // 池快照节点总数（宏执行重建 s_* 池后恢复）

namespace mexpand {

// 池快照：s_* 池 9 列 + node_types + s_n（节点总数）深拷贝到 g_pool_*。
func pool_save() {
    g_pool_tags = copy_i64(s_tags)
    g_pool_names = copy_i64(s_names)
    g_pool_vals = copy_i64(s_vals)
    g_pool_aux = copy_i64(s_aux)
    g_pool_coff = copy_i64(s_coff)
    g_pool_nchild = copy_i64(s_nchild)
    g_pool_children = copy_i64(s_children)
    g_pool_lines = copy_i64(s_lines)
    g_pool_cols = copy_i64(s_cols)
    g_pool_types = copy_i64(node_types)
    g_pool_sn = s_n
}

// 池恢复：**深拷贝** g_pool_* 快照到全新表（重新绑定 s_* = 快照会导致后续
// append_ast/splice/gen_code_lit 追加直接改到 g_pool_* 本体——快照被污染，
// 多宏展开时第二次 pool_restore 拿到的池含上一次的克隆垃圾，类型推断错乱）。
// s_n 用拷贝后表长（快照保存时的 s_n 恒 == len(s_tags)，等价）。
func pool_restore() {
    s_tags = copy_i64(g_pool_tags)
    s_names = copy_i64(g_pool_names)
    s_vals = copy_i64(g_pool_vals)
    s_aux = copy_i64(g_pool_aux)
    s_coff = copy_i64(g_pool_coff)
    s_nchild = copy_i64(g_pool_nchild)
    s_children = copy_i64(g_pool_children)
    s_lines = copy_i64(g_pool_lines)
    s_cols = copy_i64(g_pool_cols)
    node_types = copy_i64(g_pool_types)
    s_n = len(s_tags)
}

// i64 表深拷贝。
func copy_i64(src: table<i64>) -> table<i64> {
    var out = table_new_i64()
    var i: i64 = 0
    while i < len(src) {
        table_push(out, src[i])
        i = i + 1
    }
    return out
}

// ---------- 宏表操作 ----------

// 宏名查找：命中返回下标，未命中 -1。
func macro_find(name_id: i64) -> i64 {
    var i: i64 = 0
    while i < len(g_macro_keys) {
        if g_macro_keys[i] == name_id {
            return i
        }
        i = i + 1
    }
    return -1
}

// 登记宏（name 池 id + 定义节点 id + 过程宏标记 + pub 标记 + 定义文件 id；
// 重复登记覆盖——后定义优先）。
func macro_put(name_id: i64, node: i64, isproc: i64, ispub: i64, file: i64) -> i64 {
    var i = macro_find(name_id)
    if i >= 0 {
        g_macro_nodes[i] = node
        g_macro_isproc[i] = isproc
        g_macro_ispub[i] = ispub
        g_macro_file[i] = file
        return i
    }
    table_push(g_macro_keys, name_id)
    table_push(g_macro_nodes, node)
    table_push(g_macro_isproc, isproc)
    table_push(g_macro_ispub, ispub)
    table_push(g_macro_file, file)
    table_push(g_macro_isdecl, 0)   // p.8.2.12 默认非声明式（collect 双层都对齐此长度）
    return len(g_macro_keys) - 1
}

// ==================== 主入口 ====================

// 宏展开主入口（semantic.check_ast 调用；前置：copy_ast_tables 已完成，
// s_* 池 = 主文件 AST，g_root = 顶层 StmtList）。返回 0 成功；-1 失败
//（错误写入 sm_err_line/sm_err_col/sm_err_msg）。
pub func expand_sstate() -> i64 {
    interp.reset()
    g_macro_keys = table_new_i64()
    g_macro_nodes = table_new_i64()
    g_macro_isproc = table_new_i64()
    g_macro_isdecl = table_new_i64()
    g_dbody = table_new_string()
    g_dhyseq = 0
    // 1. 收集顶层宏定义并从顶层移除
    if collect_macros() < 0 {
        return -1
    }
    // 1.5 保存主文件 AST 池快照（宏执行会重建 s_* 池，见 pool_save/restore）
    pool_save()
    // 2. 注册宏到 interp（宏体编译期执行环境）
    if register_macros() < 0 {
        return -1
    }
    // 3. 展开循环（递归展开：结果可再含宏调用）
    var rounds: i64 = 0
    var done = false
    while !done {
        var expanded = false
        var i: i64 = 0
        while i < s_n {
            if s_tags[i] == N_CALL {
                var nm_id = s_names[i]
                if nm_id >= 0 {
                    var mi = macro_find(nm_id)
                    if mi >= 0 {
                        // 跨文件宏可见性（dev33 批次10 任务29）：pub 宏跨文件
                        // 可见；非 pub 宏只能在定义文件内使用（同文件私有）。
                        var ispub = g_macro_ispub[mi]
                        if ispub == 0 {
                            var cfile = node_file_of(i)
                            if cfile != g_macro_file[mi] {
                                sm_err_line = s_lines[i]
                                sm_err_col = s_cols[i]
                                sm_err_msg = "宏 '" + interner.lookup(nm_id) +
                                    "' 是私有宏，只能在定义文件内使用（pub macro 导出跨文件可见）"
                                return -1
                            }
                        }
                        var rc = expand_one(i)
                        if rc < 0 {
                            return -1
                        }
                        if rc == 1 {
                            expanded = true
                            break   // 展开后池变化：重扫
                        }
                    }
                }
            }
            i = i + 1
        }
        if !expanded {
            done = true
        } else {
            rounds = rounds + 1
            if rounds > 64 {
                sm_err_line = s_lines[0]
                sm_err_col = s_cols[0]
                sm_err_msg = "宏展开轮次超过 64 次上限（疑似展开结果无限产生宏调用）"
                return -1
            }
        }
    }
    return 0
}

// 收集顶层宏定义（g_extra_tops 中的 N_MACRO_DEF——跨文件宏 dev33 批次10 任务29：
// import 展开先于宏展开，g_extra_tops = 主 + 全部导入文件顶层语句）→ 宏表；
// 同时重建 g_extra_tops 剔除宏定义（宏不参与语义/IR）。
func collect_macros() -> i64 {
    var kept: table<i64> = table_new_i64()
    var n = len(g_extra_tops)
    var i: i64 = 0
    while i < n {
        var s = g_extra_tops[i]
        if s_tags[s] == N_MACRO_DEF || s_tags[s] == N_DECL_MACRO_DEF {
            var nm_id = s_names[s]
            if nm_id < 0 {
                sm_err_line = s_lines[s]
                sm_err_col = s_cols[s]
                sm_err_msg = "宏定义缺少名字"
                return -1
            }
            if s_tags[s] == N_DECL_MACRO_DEF {
                // p.8.2.12 声明式宏：登记模板 + 宏体 AST 协议 + 形参名表。
                // 不注册进 interp（无编译期执行），展开由 decl 路径直接代换。
                var dparams: table<i64> = table_new_i64()
                var body_node = s_children[s_coff[s]]
                if body_node < 0 {
                    sm_err_line = s_lines[s]
                    sm_err_col = s_cols[s]
                    sm_err_msg = "声明式宏 '" + interner.lookup(nm_id) + "' 缺少展开体"
                    return -1
                }
                var body_proto = interp.sstate_subtree_protocol(body_node)
                if g_err != "" {
                    sm_err_line = s_lines[s]
                    sm_err_col = s_cols[s]
                    sm_err_msg = "声明式宏 '" + interner.lookup(nm_id) + "' 展开体序列化失败: " + g_err
                    return -1
                }
                var npar = s_nchild[s] - 1
                if npar < 0 {
                    npar = 0
                }
                var k: i64 = 0
                while k < npar {
                    var pp = s_children[s_coff[s] + 1 + k]
                    if pp < 0 || s_names[pp] < 0 {
                        sm_err_line = s_lines[s]
                        sm_err_col = s_cols[s]
                        sm_err_msg = "声明式宏 '" + interner.lookup(nm_id) + "' 形参缺少名字"
                        return -1
                    }
                    table_push(dparams, s_names[pp])
                    k = k + 1
                }
                var idx = macro_put(nm_id, s, 0, 0, node_file_of(s))
                if idx < 0 {
                    return -1
                }
                // 使 g_dbody 与宏表对齐（macro_put 只对齐 g_macro_isdecl；
                // g_dbody 是 string 表，须按长度补齐后按索引写，防越界）
                while len(g_dbody) < len(g_macro_keys) {
                    table_push(g_dbody, "")
                }
                g_macro_isdecl[idx] = 1
                g_dbody[idx] = body_proto
            } else {
                // val 位标志：bit0=过程宏（#[macro]），bit1=pub 导出
                var isproc: i64 = 0
                var ispub: i64 = 0
                if s_vals[s] % 2 == 1 {
                    isproc = 1
                }
                if s_vals[s] / 2 % 2 == 1 {
                    ispub = 1
                }
                var idx = macro_put(nm_id, s, isproc, ispub, node_file_of(s))
                if idx < 0 {
                    return -1
                }
                g_macro_isdecl[idx] = 0
            }
        } else {
            table_push(kept, s)
        }
        i = i + 1
    }
    // 重建 g_extra_tops（剔除宏定义；收集/查找统一遍历用）
    g_extra_tops = kept
    return 0
}

// 节点所属文件 id：沿父链上溯到最近的已记录顶层 StmtList 根（g_file_roots），
// 其文件 id 即节点所属文件；找不到（主文件顶层直接子节点）→ 0（主文件）。
func node_file_of(node: i64) -> i64 {
    var cur = node
    var depth: i64 = 0
    while depth < 64 {
        var out: table<i64> = table_new_i64()
        table_push(out, -1)
        table_push(out, -1)
        if find_parent(cur, out) < 0 {
            break
        }
        var p = out[0]
        // 已记录顶层 StmtList 根 → 其文件 id
        var fi = file_root_find(p)
        if fi >= 0 {
            return fi
        }
        cur = p
        depth = depth + 1
    }
    return 0
}

// 查 g_file_roots 中是否存在顶层 StmtList 根 id（线性；文件数少）。命中返回
// 文件 id；未命中 -1。
func file_root_find(root_id: i64) -> i64 {
    var i: i64 = 0
    while i < len(g_file_roots) {
        if g_file_roots[i] == root_id {
            return i
        }
        i = i + 1
    }
    return -1
}

// 注册全部宏到 interp：每个宏定义子树序列化为协议文本（根 = 宏定义
// 节点 id 0）→ eval_proto（load_ast + 归档 + 顶层注册）。
// 每轮注册前恢复池快照（上一轮 eval_proto 已重建 s_* 池）。
func register_macros() -> i64 {
    var i: i64 = 0
    while i < len(g_macro_keys) {
        // p.8.2.12 声明式宏不注册进 interp（无编译期执行，模板代换在
        // expand_one 声明式路径完成）。
        if len(g_macro_isdecl) > i && g_macro_isdecl[i] == 1 {
            i = i + 1
            continue
        }
        pool_restore()
        var node = g_macro_nodes[i]
        var proto = interp.sstate_subtree_protocol(node)
        if g_err != "" {
            sm_err_line = s_lines[node]
            sm_err_col = s_cols[node]
            sm_err_msg = "宏定义序列化失败: " + g_err
            return -1
        }
        var r = interp.eval_proto(proto)
        if g_err != "" {
            sm_err_line = s_lines[node]
            sm_err_col = s_cols[node]
            sm_err_msg = "宏 '" + interner.lookup(g_macro_keys[i]) + "' 注册失败: " + r
            return -1
        }
        i = i + 1
    }
    pool_restore()
    return 0
}

// 展开单个宏调用（call_id 是 s_* 池 N_CALL 节点）：
//   实参序列化 → eval_macro → 结果加载 → 替换调用点。
// eval_macro 会重建 s_* 池（宏体执行环境），故执行前恢复池快照（池 =
// 主文件 AST + 已展开追加），执行后再恢复并追加结果。
func expand_one(call_id: i64) -> i64 {
    var nm_id = s_names[call_id]
    var mi = macro_find(nm_id)
    // p.8.2.12 声明式宏：模板代换 + 卫生唯一化（不编译期执行，不需要 interp，
    // 直接在新树副本上改写后 splice）。
    if mi >= 0 && len(g_macro_isdecl) > mi && g_macro_isdecl[mi] == 1 {
        return expand_decl_one(call_id, mi)
    }
    // 每次展开前重存工作池快照（当前 = 主文件 AST + 已展开追加；宏执行会
    // 重建/污染 s_* 池，须在进入前保存干净状态，供完成后恢复）。
    pool_save()
    var name = interner.lookup(nm_id)
    var isproc: i64 = 0
    if mi >= 0 {
        isproc = g_macro_isproc[mi]
    }
    // 实参序列化（跳过类型实参槽——宏不支持泛型，槽恒为 -1 或 N_TYPE_ARGS）
    var soff: i64 = 0
    if s_nchild[call_id] > 0 {
        var c0 = s_children[s_coff[call_id]]
        if c0 < 0 {
            soff = 1
        } else if s_tags[c0] == N_TYPE_ARGS || s_tags[c0] == N_TYPE_PARAMS {
            soff = 1
        }
    }
    if isproc == 1 {
        // M4（dev33 批次9）过程宏：实参子树解引用为**源码文本**，绑定为
        // 字符串传给宏体（宏体用 tokenize/deparse 驱动）；返回 code 值。
        var argstrs: table<string> = table_new_string()
        var k2: i64 = soff
        while k2 < s_nchild[call_id] {
            var a = s_children[s_coff[call_id] + k2]
            if a < 0 {
                sm_err_line = s_lines[call_id]
                sm_err_col = s_cols[call_id]
                sm_err_msg = "过程宏 '" + name + "' 的实参缺失"
                return -1
            }
            var src = deparse_arg_expr(a)
            if g_err != "" {
                sm_err_line = s_lines[call_id]
                sm_err_col = s_cols[call_id]
                sm_err_msg = "过程宏实参解引用失败: " + g_err
                return -1
            }
            table_push(argstrs, src)
            k2 = k2 + 1
        }
        var rp = interp.eval_macro_proc(name, argstrs)
        if g_err != "" {
            sm_err_line = s_lines[call_id]
            sm_err_col = s_cols[call_id]
            sm_err_msg = "过程宏 '" + name + "' 展开失败: " + rp
            return -1
        }
        return finish_expand(call_id, name, rp)
    }
    var args: table<string> = table_new_string()
    var k: i64 = soff
    while k < s_nchild[call_id] {
        var a = s_children[s_coff[call_id] + k]
        if a < 0 {
            sm_err_line = s_lines[call_id]
            sm_err_col = s_cols[call_id]
            sm_err_msg = "宏 '" + name + "' 的实参缺失"
            return -1
        }
        var aproto = interp.sstate_subtree_protocol(a)
        if g_err != "" {
            sm_err_line = s_lines[call_id]
            sm_err_col = s_cols[call_id]
            sm_err_msg = "宏实参序列化失败: " + g_err
            return -1
        }
        table_push(args, aproto)
        k = k + 1
    }
    // 执行宏（编译期；宏体错误在此暴露）
    var result = interp.eval_macro(name, args)
    if g_err != "" {
        sm_err_line = s_lines[call_id]
        sm_err_col = s_cols[call_id]
        sm_err_msg = "宏 '" + name + "' 展开失败: " + result
        return -1
    }
    return finish_expand(call_id, name, result)
}

// 展开收尾（普通宏与过程宏共用）：恢复工作池 → 追加结果 → 替换调用点。
func finish_expand(call_id: i64, name: string, result: string) -> i64 {
    // 宏执行已重建 s_* 池：恢复工作池（主文件 AST + 已展开追加）后追加结果
    pool_restore()
    // 结果追加加载进 s_* 池（根 = base）
    var base = sstate.append_ast(result)
    if base < 0 {
        sm_err_line = s_lines[call_id]
        sm_err_col = s_cols[call_id]
        sm_err_msg = "宏展开结果加载失败（AST 协议解析错误）"
        return -1
    }
    // 语句位置 `$body` 插值块形式 code 值后，结果含嵌套 StmtList / 块形式
    // N_CODE_LIT 作语句——由后端 tig_stmt 直接支持（逐语句生成）。
    var new_root = base
    // 找父节点与子下标（out 表输出：out[0]=父节点 id，out[1]=子下标）
    var out: table<i64> = table_new_i64()
    table_push(out, -1)
    table_push(out, -1)
    if find_parent(call_id, out) < 0 {
        // 孤儿节点（宏定义被 collect_macros 移除后子树残留的 N_CALL）：
        // 跳过不展开（返回 0 = 无变化，不触发重扫；其父已不在活树中）。
        return 0
    }
    // 替换
    var rc2 = splice_call(out[0], out[1], call_id, new_root)
    if rc2 < 0 {
        return -1
    }
    return 1
}

// ==================== M4 过程宏实参解引用（AST → 源码文本） ====================
// 过程宏实参以**源码文本**传给宏体（token 流 API 驱动），此函数把 s_* 池
// 表达式子树还原为源码。二元/一元/三目一律括号包裹保证重解析语义一致。
// 覆盖常用表达式节点；未知节点置 g_err。
func deparse_arg_expr(node: i64) -> string {
    var t = s_tags[node]
    if t == N_INT_LIT {
        return to_string(s_vals[node])
    }
    if t == N_FLOAT_LIT {
        if s_names[node] >= 0 {
            return interner.lookup(s_names[node])
        }
        g_err = "浮点字面量缺少文本"
        return ""
    }
    if t == N_STR_LIT {
        if s_names[node] >= 0 {
            return interner.lookup(s_names[node])
        }
        g_err = "字符串字面量缺少文本"
        return ""
    }
    if t == N_CHAR_LIT {
        if s_names[node] >= 0 {
            return interner.lookup(s_names[node])
        }
        g_err = "字符字面量缺少文本"
        return ""
    }
    if t == N_BOOL_LIT {
        if s_vals[node] != 0 {
            return "true"
        }
        return "false"
    }
    if t == N_TRIT_LIT {
        return "zero"
    }
    if t == N_VAR {
        if s_names[node] >= 0 {
            return interner.lookup(s_names[node])
        }
        g_err = "变量节点缺少名字"
        return ""
    }
    if t == N_UNARY {
        var op = s_vals[node]
        var opr = deparse_arg_expr(s_children[s_coff[node]])
        if g_err != "" {
            return ""
        }
        if op == 0 {
            return "-(" + opr + ")"
        }
        if op == 1 {
            return "!(" + opr + ")"
        }
        if op == 2 || op == 3 {
            return "(" + unary_sym(op) + opr + ")"
        }
        return "(" + opr + unary_sym(op) + ")"
    }
    if t == N_BINARY {
        var op = s_vals[node]
        var l = deparse_arg_expr(s_children[s_coff[node]])
        if g_err != "" {
            return ""
        }
        var r = deparse_arg_expr(s_children[s_coff[node] + 1])
        if g_err != "" {
            return ""
        }
        return "(" + l + " " + bin_sym(op) + " " + r + ")"
    }
    if t == N_TERNARY {
        var c = deparse_arg_expr(s_children[s_coff[node]])
        if g_err != "" {
            return ""
        }
        var a = deparse_arg_expr(s_children[s_coff[node] + 1])
        if g_err != "" {
            return ""
        }
        var b = deparse_arg_expr(s_children[s_coff[node] + 2])
        if g_err != "" {
            return ""
        }
        return "(" + c + " ? " + a + " : " + b + ")"
    }
    if t == N_CALL {
        var out: string = interner.lookup(s_names[node]) + "("
        var nc = s_nchild[node]
        var off: i64 = 0
        if nc > 0 {
            var c0 = s_children[s_coff[node]]
            if c0 < 0 {
                off = 1
            } else if s_tags[c0] == N_TYPE_ARGS || s_tags[c0] == N_TYPE_PARAMS {
                off = 1
            }
        }
        var k: i64 = off
        while k < nc {
            if k > off {
                out = out + ", "
            }
            out = out + deparse_arg_expr(s_children[s_coff[node] + k])
            if g_err != "" {
                return ""
            }
            k = k + 1
        }
        return out + ")"
    }
    if t == N_METHOD_CALL {
        var recv = deparse_arg_expr(s_children[s_coff[node]])
        if g_err != "" {
            return ""
        }
        var out: string = recv + "." + interner.lookup(s_names[node]) + "("
        var nc = s_nchild[node]
        var off: i64 = 0
        if nc > 0 {
            var c0 = s_children[s_coff[node]]
            if c0 < 0 {
                off = 1
            } else if s_tags[c0] == N_TYPE_ARGS {
                off = 1
            }
        }
        var k: i64 = off + 1
        while k < nc {
            if k > off + 1 {
                out = out + ", "
            }
            out = out + deparse_arg_expr(s_children[s_coff[node] + k])
            if g_err != "" {
                return ""
            }
            k = k + 1
        }
        return out + ")"
    }
    if t == N_INDEX {
        var base = deparse_arg_expr(s_children[s_coff[node]])
        if g_err != "" {
            return ""
        }
        var idx = deparse_arg_expr(s_children[s_coff[node] + 1])
        if g_err != "" {
            return ""
        }
        return base + "[" + idx + "]"
    }
    if t == N_FIELD_ACCESS {
        var base = deparse_arg_expr(s_children[s_coff[node]])
        if g_err != "" {
            return ""
        }
        return base + "." + interner.lookup(s_names[node])
    }
    if t == N_RANGE {
        var a = deparse_arg_expr(s_children[s_coff[node]])
        if g_err != "" {
            return ""
        }
        var b = deparse_arg_expr(s_children[s_coff[node] + 1])
        if g_err != "" {
            return ""
        }
        return a + ".." + b
    }
    if t == N_TABLE_LIT {
        var out: string = "["
        var nc = s_nchild[node]
        var k: i64 = 0
        while k < nc {
            if k > 0 {
                out = out + ", "
            }
            var cell = s_children[s_coff[node] + k]
            var idn = s_children[s_coff[cell]]
            if idn >= 0 {
                out = out + interner.lookup(s_names[idn]) + ": " +
                    deparse_arg_expr(s_children[s_coff[cell] + 1])
            } else {
                out = out + deparse_arg_expr(s_children[s_coff[cell] + 1])
            }
            if g_err != "" {
                return ""
            }
            k = k + 1
        }
        return out + "]"
    }
    g_err = "过程宏实参解引用不支持节点类型 tag " + to_string(t)
    return ""
}

// 二元运算符编号 → 符号文本（deparse_arg_expr 用；与 parser.op_symbol 一致）。
func bin_sym(op: i64) -> string {
    if op == 0 {
        return "+"
    }
    if op == 1 {
        return "-"
    }
    if op == 2 {
        return "*"
    }
    if op == 3 {
        return "/"
    }
    if op == 4 {
        return "%"
    }
    if op == 5 {
        return "=="
    }
    if op == 6 {
        return "!="
    }
    if op == 7 {
        return "<"
    }
    if op == 8 {
        return ">"
    }
    if op == 9 {
        return "<="
    }
    if op == 10 {
        return ">="
    }
    if op == 11 {
        return "&&"
    }
    if op == 12 {
        return "||"
    }
    if op == 13 {
        return "&"
    }
    if op == 14 {
        return "|"
    }
    if op == 15 {
        return "^"
    }
    if op == 16 {
        return "<<"
    }
    if op == 17 {
        return ">>"
    }
    return "?"
}

// 一元运算符编号 → 符号文本（deparse_arg_expr 用；0=- 1=! 2/4=++ 3/5=--）。
func unary_sym(op: i64) -> string {
    if op == 0 {
        return "-"
    }
    if op == 1 {
        return "!"
    }
    if op == 2 || op == 4 {
        return "++"
    }
    if op == 3 || op == 5 {
        return "--"
    }
    return "?"
}

// 找 child_id 的父节点与子下标（全池扫描）。out 表输出：out[0]=父节点 id，
// out[1]=子下标。返回 0 找到；-1 未找到。
func find_parent(child_id: i64, out: ref table<i64>) -> i64 {
    var i: i64 = 0
    while i < s_n {
        var n = s_nchild[i]
        var k: i64 = 0
        while k < n {
            if s_children[s_coff[i] + k] == child_id {
                out[0] = i
                out[1] = k
                return 0
            }
            k = k + 1
        }
        i = i + 1
    }
    return -1
}

// 替换宏调用点：
//   - 父是 N_EXPR_STMT（语句位置）：结果 StmtList → 父节点替换为多条语句
//     （在祖父 children 中插入）；结果单节点 → 重建 N_EXPR_STMT。
//   - 表达式位置：结果必须是表达式（非 StmtList）→ 直接替换子 id。
// 返回 0 成功；-1 失败（错误置 sm_err_*）。
func splice_call(parent: i64, pidx: i64, call_id: i64, new_root: i64) -> i64 {
    var ptag = s_tags[parent]
    var rtag = s_tags[new_root]
    if ptag == N_EXPR_STMT {
        // 语句位置：祖父是 StmtList（或块体 StmtList）
        var gout: table<i64> = table_new_i64()
        table_push(gout, -1)
        table_push(gout, -1)
        if find_parent(parent, gout) < 0 {
            sm_err_line = s_lines[call_id]
            sm_err_col = s_cols[call_id]
            sm_err_msg = "内部错误: 表达式语句节点找不到父节点"
            return -1
        }
        var grand = gout[0]
        var gidx = gout[1]
        // 展开完成后旧 N_EXPR_STMT（parent）成为孤儿：解除其到调用点的子引用
        //（置 -1）。否则展开循环重扫全池时 find_parent(call_id) 会再命中该
        // 孤儿节点，二次展开语句位置宏调用 → "表达式语句节点找不到父节点"
        //（表达式分支直接覆盖子槽为 new_root 故无此问题）。
        s_children[s_coff[parent] + pidx] = -1
        if rtag == N_STMTLIST {
            // 结果多语句：收集结果子语句，替换祖父 children 中 [parent] 位置
            var stmts: table<i64> = table_new_i64()
            var k: i64 = 0
            while k < s_nchild[new_root] {
                table_push(stmts, s_children[s_coff[new_root] + k])
                k = k + 1
            }
            return replace_range(grand, gidx, stmts)
        }
        // 结果单语句/表达式：重建 N_EXPR_STMT 包装（保持语句形态）
        var line = s_lines[parent]
        var col = s_cols[parent]
        var ne = len(s_tags)
        table_push(s_tags, N_EXPR_STMT)
        table_push(s_names, -1)
        table_push(s_vals, -1)
        table_push(s_aux, -1)
        table_push(s_coff, len(s_children))
        table_push(s_nchild, 1)
        table_push(s_lines, line)
        table_push(s_cols, col)
        table_push(node_types, -1)
        table_push(s_children, new_root)
        s_n = len(s_tags)
        var one: table<i64> = table_new_i64()
        table_push(one, ne)
        return replace_range(grand, gidx, one)
    }
    // 表达式位置：结果必须是表达式（不能是语句块/语句）
    if rtag == N_STMTLIST || rtag == N_VAR_DECL || rtag == N_FN_DEF || rtag == N_MACRO_DEF {
        sm_err_line = s_lines[call_id]
        sm_err_col = s_cols[call_id]
        sm_err_msg = "宏展开返回语句块，但调用点在表达式位置（宏须返回表达式）"
        return -1
    }
    // 直接替换子 id（含父是 N_EXPR_STMT 之外的一切表达式容器）
    s_children[s_coff[parent] + pidx] = new_root
    return 0
}

// 替换节点 children 段中 [idx] 位置的单个子节点为多个节点（重建段：
// 旧段孤儿化，新段追加到 s_children 末尾——避免段内移动的 O(n) 拷贝与
// 越界风险）。s_nchild 同步更新。
func replace_range(node: i64, idx: i64, new_ids: table<i64>) -> i64 {
    var old_cnt = s_nchild[node]
    var old_off = s_coff[node]
    var new_cnt = old_cnt - 1 + len(new_ids)
    s_coff[node] = len(s_children)
    s_nchild[node] = new_cnt
    var i: i64 = 0
    while i < old_cnt {
        if i == idx {
            var k: i64 = 0
            while k < len(new_ids) {
                table_push(s_children, new_ids[k])
                k = k + 1
            }
        } else {
            table_push(s_children, s_children[old_off + i])
        }
        i = i + 1
    }
    return 0
}

// ==================== p.8.2.12 声明式宏展开（模板代换 + 卫生） ====================
// 与既有（函数式/过程式）宏的编译期执行不同，声明式宏 = 纯模板：宏体在每次
// 展开时重新解析为 AST，做两件事后 splice 回调用点：
//   1. 形参代换：体内与形参同名的 N_VAR（rvalue 引用槽）→ 调用实参子树的
//      克隆（每次引用各克隆一份，保持严格树结构，语义 = 文本代换去重）。
//   2. 卫生唯一化：体内 `__` 前缀标识符（宏作者引入的临时变量等）→ 追加
//      `_m<序号>` 后缀唯一化。同一展开内同名一致（绑定与引用对齐）；不同
//      展开序号不同 → 互不污染、不捕获调用处同名、不泄漏到调用处。
// 未前缀的非形参标识符按作者原样保留（借外部名的逃逸通道）。表达式位置：
// 宏体为单个表达式语句 StmtList 时解包为表达式（供表达式上下文）。

// 追加一个新节点（照抄 splice_call 的手动 append 模式）。
func decl_fresh(tag: i64, name: i64, val: i64, aux: i64, line: i64, col: i64) -> i64 {
    var nd = len(s_tags)
    table_push(s_tags, tag)
    table_push(s_names, name)
    table_push(s_vals, val)
    table_push(s_aux, aux)
    table_push(s_coff, len(s_children))
    table_push(s_nchild, 0)
    table_push(s_lines, line)
    table_push(s_cols, col)
    table_push(node_types, -1)
    s_n = len(s_tags)
    return nd
}

// 给池内节点写 children（段追加到 s_children 末尾）。
func decl_set_children(node: i64, kids: table<i64>) {
    s_coff[node] = len(s_children)
    s_nchild[node] = len(kids)
    var k: i64 = 0
    while k < len(kids) {
        table_push(s_children, kids[k])
        k = k + 1
    }
}

// 纯深拷贝（不做代换/卫生）——用于克隆实参子树（调用处代码保持原名）。
func decl_clone_plain(node: i64) -> i64 {
    var nd = decl_fresh(s_tags[node], s_names[node], s_vals[node], s_aux[node], s_lines[node], s_cols[node])
    var kids: table<i64> = table_new_i64()
    var nc = s_nchild[node]
    var k: i64 = 0
    while k < nc {
        var cid = s_children[s_coff[node] + k]
        if cid < 0 {
            table_push(kids, -1)   // 类型实参槽等 -1 哨兵：保持原样不递归
        } else {
            table_push(kids, decl_clone_plain(cid))
        }
        k = k + 1
    }
    decl_set_children(nd, kids)
    return nd
}

// 卫生临时名的唯一化 target 节点（N_VAR 引用 / N_VAR_DECL、N_FN_DEF 绑定 /
// N_METHOD_CALL 方法名）。仅这些承载真实标识符 name 字段——避免误改字符串
// 字面量 / 类型名等非标识符 name（保持数据与类型语义不变）。
func decl_is_ident(tag: i64) -> bool {
    if tag == N_VAR || tag == N_VAR_DECL || tag == N_FN_DEF || tag == N_METHOD_CALL || tag == N_ASSIGN {
        return true
    }
    return false
}

// 名字是否以 "__" 前缀（卫生临时名约定）。
func decl_hyg_pref(s: string) -> bool {
    if str_len(s) >= 2 {
        if str_char(s, 0) == "_" && str_char(s, 1) == "_" {
            return true
        }
    }
    return false
}

// 卫生唯一化：把名字 id 映射为展开内唯一新名 id（同一展开内同名复用同一新名，
// 保证绑定与引用对齐；序号来自 g_dhyseq 生成器，跨展开不同）。
func decl_hyg_name(nid: i64, nstr: string) -> i64 {
    var i: i64 = 0
    while i < len(g_dhyk) {
        if g_dhyk[i] == nid {
            return g_dhyv[i]
        }
        i = i + 1
    }
    var newname = nstr + "_m" + to_string(g_dhyseq)
    g_dhyseq = g_dhyseq + 1
    var nnid = interner.intern(newname)
    table_push(g_dhyk, nid)
    table_push(g_dhyv, nnid)
    return nnid
}

// 代换 + 卫生深拷贝（宏体源子树 → 新树）：返回新子树根 id。
func decl_transform(node: i64, params: table<i64>, argids: table<i64>) -> i64 {
    var tag = s_tags[node]
    // 1. 形参代换槽：N_VAR 名 == 某个形参名 → 克隆实参
    if tag == N_VAR {
        var nm = s_names[node]
        var k: i64 = 0
        while k < len(params) {
            if params[k] == nm {
                return decl_clone_plain(argids[k])
            }
            k = k + 1
        }
    }
    // 2. 卫生唯一化（`__` 前缀标识符）
    var nm2 = s_names[node]
    if decl_is_ident(tag) && nm2 >= 0 {
        var nstr = interner.lookup(nm2)
        if nstr != "" && decl_hyg_pref(nstr) {
            nm2 = decl_hyg_name(nm2, nstr)
        }
    }
    var nd = decl_fresh(tag, nm2, s_vals[node], s_aux[node], s_lines[node], s_cols[node])
    var kids: table<i64> = table_new_i64()
    var nc = s_nchild[node]
    var k: i64 = 0
    while k < nc {
        var cid = s_children[s_coff[node] + k]
        if cid < 0 {
            table_push(kids, -1)   // 类型实参槽等 -1 哨兵：保持原样不递归
        } else {
            table_push(kids, decl_transform(cid, params, argids))
        }
        k = k + 1
    }
    decl_set_children(nd, kids)
    return nd
}

// 展开一个声明式宏调用。返回 1 = 已展开（池有变化需重扫）；0 = 无变化（孤儿
// 调用点）；-1 = 错误（sm_err_* 已置）。
func expand_decl_one(call_id: i64, mi: i64) -> i64 {
    var nm_id = s_names[call_id]
    var name = interner.lookup(nm_id)
    var body_proto = g_dbody[mi]
    // 形参名 id：从登记的定义节点（N_DECL_MACRO_DEF，仍在 s_* 池中，
    // children = [body, 形参...]）现场读取——与 collect 时的 s_* 布局一致，
    // 避免跨阶段状态丢失。
    var mnode = g_macro_nodes[mi]
    var nparams = s_nchild[mnode] - 1
    if nparams < 0 {
        nparams = 0
    }
    var params: table<i64> = table_new_i64()
    var pk: i64 = 0
    while pk < nparams {
        var pnode = s_children[s_coff[mnode] + 1 + pk]
        var pn = -1
        if pnode >= 0 {
            pn = s_names[pnode]
        }
        table_push(params, pn)
        pk = pk + 1
    }
    // 实参 id（跳过类型实参槽——声明式宏不支持泛型）
    var soff: i64 = 0
    if s_nchild[call_id] > 0 {
        var c0 = s_children[s_coff[call_id]]
        if c0 < 0 {
            soff = 1
        } else if s_tags[c0] == N_TYPE_ARGS || s_tags[c0] == N_TYPE_PARAMS {
            soff = 1
        }
    }
    var argids: table<i64> = table_new_i64()
    var k: i64 = soff
    while k < s_nchild[call_id] {
        var a = s_children[s_coff[call_id] + k]
        if a < 0 {
            sm_err_line = s_lines[call_id]
            sm_err_col = s_cols[call_id]
            sm_err_msg = "声明式宏 '" + name + "' 的实参缺失"
            return -1
        }
        table_push(argids, a)
        k = k + 1
    }
    if len(argids) != nparams {
        sm_err_line = s_lines[call_id]
        sm_err_col = s_cols[call_id]
        sm_err_msg = "声明式宏 '" + name + "' 期望 " + to_string(nparams) + " 个实参，实际 " + to_string(len(argids)) + " 个"
        return -1
    }
    // 宏体重新解析为 AST（fresh：每次展开独立副本，序号的卫生改名互相隔离）
    var bodyroot = sstate.append_ast(body_proto)
    if bodyroot < 0 {
        sm_err_line = s_lines[call_id]
        sm_err_col = s_cols[call_id]
        sm_err_msg = "声明式宏 '" + name + "' 展开体解析失败（AST 协议错误）"
        return -1
    }
    if s_tags[bodyroot] != N_STMTLIST {
        sm_err_line = s_lines[call_id]
        sm_err_col = s_cols[call_id]
        sm_err_msg = "内部错误: 声明式宏 '" + name + "' 展开体根不是 StmtList（tag=" + to_string(s_tags[bodyroot]) + "）"
        return -1
    }
    g_dhyk = table_new_i64()
    g_dhyv = table_new_i64()
    var new_root = decl_transform(bodyroot, params, argids)
    if new_root < 0 || new_root >= len(s_tags) {
        sm_err_line = s_lines[call_id]
        sm_err_col = s_cols[call_id]
        sm_err_msg = "内部错误: 声明式宏 '" + name + "' 展开体变换越界"
        return -1
    }
    // 表达式位置支持：宏体 = 单表达式语句块 → 解包为内层表达式
    if s_tags[new_root] == N_STMTLIST && s_nchild[new_root] == 1 {
        var only = s_children[s_coff[new_root]]
        if only >= 0 && s_tags[only] == N_EXPR_STMT && s_nchild[only] == 1 {
            new_root = s_children[s_coff[only]]
        }
    }
    // 找父节点与子下标并替换（调用点仍在活树中；本路径不做 pool_restore，
    // 因为没进 interp 重建池——直接在当前池 append + splice）
    var out: table<i64> = table_new_i64()
    table_push(out, -1)
    table_push(out, -1)
    if find_parent(call_id, out) < 0 {
        return 0   // 孤儿调用点（宏定义被移除后子树残留）：无变化
    }
    var rc2 = splice_call(out[0], out[1], call_id, new_root)
    if rc2 < 0 {
        return -1
    }
    return 1
}

}   // namespace mexpand
