// 只搬函数与紧邻注释；顶层全局 var 与 import 树仍留在 sbuiltin_call_gen.tie。
// 顶层函数保持顶层身份（跨 ns 裸调依赖），ns 内函数按上下文包 namespace。
namespace sbuiltin {
pub func builtin_call_b_file_size(fn_name: string, args: table<i64>, call_node: i64) -> i64 {
    var nargs = len(args)
    // ---------- S1.2 unsafe 指针/内存内置（固定返回类型部分） ----------
    // 动态返回类型（addr_of/deref/slice_of/ptr_add）由调用点 infer 特判。
        if nargs != 1 {
            sm_err_line = s_lines[call_node]
            sm_err_col = s_cols[call_node]
            sm_err_msg = fn_name + "() 期望 1 个参数，实际 " + to_string(nargs) + " 个"
            return -2
        }
        if fn_name == "file_size" {
            return types.named(TK_I64)
        }
        return types.named(TK_BOOL)
}

