type tie<class>
// compiler/frontend/sinfer_ie_ie2.tie —— infer_expr 分支提子函数分片 2（p.9.21 G2 单函数 ≤300 行）
// ============================================================
// 只含函数与注释：import 树与顶层全局 var 仍留在原主文件；
// 分片内函数与原调度器同 namespace，跨文件裸名互调。
namespace sinfer {
pub func infer_expr_ternary(id: i64) -> i64 {
    var tag = s_tags[id]
        var cond = infer_expr(sstate.child(id, 0))
        if cond < 0 {
            return -1
        }
        if !types.is_bool_like(cond) {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "三目条件必须是 bool"
            return -1
        }
        var th = infer_expr(sstate.child(id, 1))
        if th < 0 {
            return -1
        }
        var el = infer_expr(sstate.child(id, 2))
        if el < 0 {
            return -1
        }
        if th != el && !(types.is_int(th) && types.is_int(el)) && !(types.is_float(th) && types.is_float(el)) {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "三目两分支类型不一致：" + types.type_name(th) + " 与 " + types.type_name(el)
            return -1
        }
        node_types[id] = th
        g_typed = g_typed + 1
        return th
}

pub func infer_expr_switch_expr(id: i64) -> i64 {
    var tag = s_tags[id]
        var subj = infer_expr(sstate.child(id, 0))
        if subj < 0 {
            return -1
        }
        if !types.is_number(subj) && !types.is_bool_like(subj) && subj != TK_STR &&
            subj != TK_CHAR && types.kind(subj) != K_ENUM && subj != types.named(TK_ANY) {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "switch 表达式对象仅支持数字、布尔、字符、字符串、枚举或 any 类型，实际是 " + types.type_name(subj)
            return -1
        }
        scheck.reset_case_seen()
        var ncases2 = s_aux[id]
        var res_ty: i64 = -1
        var k2: i64 = 0
        while k2 < ncases2 {
            var c = sstate.child(id, 1 + k2)
            var rp = scheck.check_arm_patterns(c, subj)
            if rp < 0 {
                return -1
            }
            var bty = infer_expr(sstate.child(c, 2))
            if bty < 0 {
                return -1
            }
            if res_ty < 0 {
                res_ty = bty
            } else if bty != res_ty && !(types.is_int(bty) && types.is_int(res_ty)) && !(types.is_float(bty) && types.is_float(res_ty)) {
                sm_err_line = s_lines[c]
                sm_err_col = s_cols[c]
                sm_err_msg = "switch 表达式各分支类型不一致：" + types.type_name(bty) + " 与 " + types.type_name(res_ty)
                return -1
            }
            k2 = k2 + 1
        }
        var has_wild = s_vals[id] == 1
        if has_wild {
            var dty = infer_expr(sstate.child(id, 1 + ncases2))
            if dty < 0 {
                return -1
            }
            if res_ty < 0 {
                res_ty = dty
            } else if dty != res_ty && !(types.is_int(dty) && types.is_int(res_ty)) && !(types.is_float(dty) && types.is_float(res_ty)) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "switch 表达式通配臂类型不一致：" + types.type_name(dty) + " 与 " + types.type_name(res_ty)
                return -1
            }
        } else if types.kind(subj) == K_ENUM {
            var re = scheck.check_enum_exhaustive(subj, id)
            if re < 0 {
                return -1
            }
        }
        if res_ty < 0 {
            res_ty = types.named(TK_I64)
        }
        node_types[id] = res_ty
        g_typed = g_typed + 1
        return res_ty
}

pub func infer_expr_path(id: i64) -> i64 {
    var tag = s_tags[id]
        // Path 名字在 Segment children 中（name 字段为空），拼接完整路径
        var pname = recv_path_name(id)
        // p.9.12.4：命名空间内 const 以全名登记 gb_*，`ns::NAME` 路径作值
        // 引用即为该全局常量（i64/string/f64/bool 标量；表/函数路径不在此列）
        var pnid = intern.intern(pname)
        // p.9.21.5 II2 A2b：ns 常量值引用跟随 L1 梯度（pub const 放行）
        var vc = sstate.check_const_visibility_nid(pnid, id)
        if vc < 0 {
            return -1
        }
        var pgt = gb_find(pnid)
        if pgt >= 0 {
            node_types[id] = pgt
            g_typed = g_typed + 1
            return pgt
        }
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "命名空间路径 '" + pname + "' 不能作为值使用（只能用于调用，如 'x::f()'）"
        return -1
}

pub func infer_expr_type_lit(id: i64) -> i64 {
    var tag = s_tags[id]
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "类型字面量只能用作 switch 的 case 类型匹配"
        return -1
}

pub func infer_expr_asm(id: i64) -> i64 {
    var tag = s_tags[id]
        if g_unsafe_depth == 0 {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "asm! 内联汇编必须在 unsafe 块或 unsafe 函数中使用（安全代码禁止触底）"
            return -1
        }
        var nc = sstate.nchild(id)
        var k: i64 = 0
        while k < nc {
            var op = sstate.child(id, k)
            if s_vals[op] == 3 {
                // target("arch") 平台条件编译标注（任务17）：非表达式操作数，跳过
                k = k + 1
                continue
            }
            var e = sstate.child(op, 0)
            var ot = infer_expr(e)
            if ot < 0 {
                return -1
            }
            k = k + 1
        }
        node_types[id] = types.named(TK_VOID)
        g_typed = g_typed + 1
        return types.named(TK_VOID)
}

pub func infer_expr_index(id: i64) -> i64 {
    var tag = s_tags[id]
        var base = infer_expr(sstate.child(id, 0))
        if base < 0 {
            return -1
        }
        var idx = infer_expr(sstate.child(id, 1))
        if idx < 0 {
            return -1
        }
        if types.is_array(base) {
            // L1 定长数组 a[i]：元素类型 = array_elem(base)；索引必须是整数。
            // 编译期常量越界（负/超长）直接拒绝；动态索引 v1 默认零检查
            //（--check-bounds 调试开关见 1.4，暂未接线）。
            if !types.is_int(idx) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "数组下标必须是整数，实际是 " + types.type_name(idx)
                return -1
            }
            var (ci, cv) = stype.arr_const_index(sstate.child(id, 1))
            if ci {
                if cv < 0 {
                    sm_err_line = s_lines[id]
                    sm_err_col = s_cols[id]
                    sm_err_msg = "数组下标越界：索引为负数"
                    return -1
                }
                if cv >= types.array_len(base) {
                    sm_err_line = s_lines[id]
                    sm_err_col = s_cols[id]
                    sm_err_msg = "数组下标越界：索引 " + to_string(cv) + " ≥ 长度 " + to_string(types.array_len(base))
                    return -1
                }
            }
            node_types[id] = types.array_elem(base)
            g_typed = g_typed + 1
            return types.array_elem(base)
        }
        if types.is_table(base) {
            var elem = types.table_elem(base)
            if elem < 0 {
                // 表变量：查 var_table_elem
                var base_node = sstate.child(id, 0)
                if s_tags[base_node] == S_N_VAR {
                    var nm = sstate.name_str(base_node)
                    var nid = intern.intern(nm)
                    var te = var_table_elem(nid)
                    if te >= 0 {
                        node_types[id] = te
                        g_typed = g_typed + 1
                        return te
                    }
                }
                // 裸 table：元素类型未知，默认 i64
                node_types[id] = types.named(TK_I64)
                g_typed = g_typed + 1
                return types.named(TK_I64)
            }
            node_types[id] = elem
            g_typed = g_typed + 1
            return elem
        }
        if base == TK_STR {
            if !types.is_int(idx) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "下标必须是整数，实际是 " + types.type_name(idx)
                return -1
            }
            // 对齐 Rust 版：s[i] → 取第 i 个字符（char），非 string
            node_types[id] = types.named(TK_CHAR)
            g_typed = g_typed + 1
            return types.named(TK_CHAR)
        }
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "下标访问的对象必须是表或字符串，实际是 " + types.type_name(base)
        return -1
}

pub func infer_expr_slice(id: i64) -> i64 {
    var tag = s_tags[id]
        var sbase = infer_expr(sstate.child(id, 0))
        if sbase < 0 {
            return -1
        }
        var s1 = sstate.child(id, 1)
        if s1 >= 0 {
            var st = infer_expr(s1)
            if st < 0 {
                return -1
            }
            if !types.is_int(st) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "切片起始必须是整数，实际是 " + types.type_name(st)
                return -1
            }
        }
        var s2 = sstate.child(id, 2)
        if s2 >= 0 {
            var et = infer_expr(s2)
            if et < 0 {
                return -1
            }
            if !types.is_int(et) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "切片终点必须是整数，实际是 " + types.type_name(et)
                return -1
            }
        }
        if sbase == TK_STR {
            node_types[id] = types.named(TK_STR)
            g_typed = g_typed + 1
            return types.named(TK_STR)
        }
        if types.is_table(sbase) {
            var sle = types.table_elem(sbase)
            if sle < 0 {
                sle = types.named(TK_I64)
            }
            var rt = types.table_of(sle)
            node_types[id] = rt
            g_typed = g_typed + 1
            return rt
        }
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "切片对象必须是表/数组或字符串，实际是 " + types.type_name(sbase)
        return -1
}

pub func infer_expr_with(id: i64) -> i64 {
    var tag = s_tags[id]
        var wbase = infer_expr(sstate.child(id, 0))
        if wbase < 0 {
            return -1
        }
        // p.9.11.33：struct 基 → 结构体不可变更新（值语义复制 + 指定字段覆盖；
        // 字段名/类型校验在 irgen tig_with_struct 以诊断落位）
        if types.kind(wbase) == K_STRUCT {
            var wupd2 = infer_expr(sstate.child(id, 1))
            if wupd2 < 0 {
                return -1
            }
            if !types.is_map(wupd2) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "'with' 右侧必须是记录/映射字面量 {k: v}，实际是 " + types.type_name(wupd2)
                return -1
            }
            node_types[id] = wbase
            g_typed = g_typed + 1
            return wbase
        }
        if !types.is_table(wbase) && !types.is_map(wbase) {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "'with' 左侧必须是表/数组或映射记录，实际是 " + types.type_name(wbase)
            return -1
        }
        var wupd = infer_expr(sstate.child(id, 1))
        if wupd < 0 {
            return -1
        }
        if !types.is_map(wupd) {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "'with' 右侧必须是记录/映射字面量 {k: v}，实际是 " + types.type_name(wupd)
            return -1
        }
        node_types[id] = wbase
        g_typed = g_typed + 1
        return wbase
}

pub func infer_expr_safe_access(id: i64) -> i64 {
    var tag = s_tags[id]
        var base0 = sstate.child(id, 0)
        var bt = infer_expr(base0)
        if bt < 0 {
            return -1
        }
        var pt = option_payload_ty(bt)
        if pt < 0 {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "'?.': 左侧必须是 Option<T>（Some/None 形态枚举），实际是 " + types.type_name(bt)
            return -1
        }
        var sname = s_names[id]
        var rty: i64 = -1
        if sname < 0 {
            // 索引形态：pt 必须是表/map（元素类型为结果）
            var it = infer_expr(sstate.child(id, 1))
            if it < 0 {
                return -1
            }
            if !types.is_int(it) {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "安全索引下标必须是整数，实际是 " + types.type_name(it)
                return -1
            }
            if (types.is_table(pt) || types.is_map(pt)) && pt != types.named(TK_TABLE) && pt != types.named(TK_MAP) {
                rty = types.table_elem(pt)
            }
            if rty < 0 {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "'?[i]' 的 Option 载荷必须是元素化表/映射（table<T>/map<V>），实际是 " + types.type_name(pt)
                return -1
            }
        } else {
            // 字段形态：pt 必须是 struct，字段类型为结果
            var fname = sstate.name_str(id)
            if types.kind(pt) != K_STRUCT {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "'?.' 安全字段访问的 Option 载荷必须是 struct，实际是 " + types.type_name(pt)
                return -1
            }
            var sidx = types.low(pt)
            var off = cls_fldoff[sidx]
            var nf = cls_nfld[sidx]
            var fk: i64 = 0
            while fk < nf {
                if intern.lookup(fld_names[off + fk]) == fname {
                    rty = fld_tys[off + fk]
                    break
                }
                fk = fk + 1
            }
            if rty < 0 {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "struct '" + types.type_name(pt) + "' 没有字段 '" + fname + "'"
                return -1
            }
            if sstate.nchild(id) > 1 {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "'?.' 安全方法调用第一版暂不支持（请先解包 Option 后普通调用）"
                return -1
            }
        }
        // 结果类型 = Option<结果类型>（模板实例化；幂等）
        var oty = option_ty_of(rty)
        if oty < 0 {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "内部错误：Option 模板实例化失败（结果 " + types.type_name(rty) + "）"
            return -1
        }
        node_types[id] = oty
        g_typed = g_typed + 1
        return oty
}

pub func infer_expr_field_access(id: i64) -> i64 {
    var tag = s_tags[id]
        var base_node = sstate.child(id, 0)
        var fnm = sstate.name_str(id)
        // 枚举变体常量探测（EnumName.Variant）：base 是未绑定变量（枚举名）时，
        // 查 en_keys 命中 → 变体引用。必须在 infer_expr(base) 之前拦截——
        // 否则枚举名被当未声明变量报错。无 payload 变体 = 常量值；带 payload
        // 变体的裸引用报错（须用 EnumName.Variant(...) 构造）。
        if s_tags[base_node] == S_N_VAR {
            var bname = sstate.name_str(base_node)
            var eidx = sstate.bs_find(en_keys, intern.intern(bname))
            if eidx >= 0 {
                var ei = en_vals[eidx]
                var varoff = en_varoff[ei]
                var nvar = en_nvar[ei]
                var found: i64 = -1
                var k: i64 = 0
                while k < nvar {
                    if intern.lookup(en_vnames[varoff + k]) == fnm {
                        found = k
                        break
                    }
                    k = k + 1
                }
                if found >= 0 {
                    if en_vnfld[varoff + found] == 0 {
                        // 无 payload 变体：枚举常量值
                        node_types[id] = types.enum_of(ei)
                        g_typed = g_typed + 1
                        return types.enum_of(ei)
                    }
                    sm_err_line = s_lines[id]
                    sm_err_col = s_cols[id]
                    sm_err_msg = "变体 '" + bname + "." + fnm + "' 需要 payload 参数（不能裸引用，请用 " + bname + "." + fnm + "(...) 构造）"
                    return -1
                }
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "枚举 '" + bname + "' 没有变体 '" + fnm + "'"
                return -1
            }
            // 泛型 enum 模板的裸变体引用（Option.None）：无实参可推断类型实参 →
            // 报错（一期不支持；构造调用带 payload 实参可推断）
            var gidx2 = sstate.gt_find(bname)
            if gidx2 >= 0 && gty_is_struct[gidx2] == 2 {
                sm_err_line = s_lines[id]
                sm_err_col = s_cols[id]
                sm_err_msg = "泛型枚举变体 '" + bname + "." + fnm + "' 无法推断类型参数（裸引用无实参，请用带 payload 的构造调用，如 " + bname + ".Some(...)）"
                return -1
            }
        }
        var base = infer_expr(base_node)
        if base < 0 {
            return -1
        }
        var bk = types.kind(base)
        if bk == K_TUPLE {
            var ti = types.low(base)
            var off = tup_offs[ti]
            var cnt = tup_n[ti]
            var i: i64 = 0
            while i < cnt {
                var fnid = tup_names[off + i]
                // 访问顺序：数字下标（.0 起）→ ItemN（1 起编号）→ 字段名
                var hit: bool = false
                if fnm == to_string(i) {
                    hit = true
                } else if fnm == "Item" + to_string(i + 1) {
                    hit = true
                } else if fnid >= 0 {
                    if intern.lookup(fnid) == fnm {
                        hit = true
                    }
                }
                if hit {
                    node_types[id] = tup_tys[off + i]
                    g_typed = g_typed + 1
                    return tup_tys[off + i]
                }
                i = i + 1
            }
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "元组没有字段 '" + fnm + "'"
            return -1
        }
        if bk == K_STRUCT {
            // 成员访问两种语义（p.8.2.7）：存储字段（普通，沿既有路径）/
            // 计算属性（<Struct>::name getter 方法，纯函数读，无需可寻址）。
            // 裁决：**字段优先**（若成员名命中真实字段 → 恒为普通字段，保证
            // 既有字段路径零变化）；字段缺失时才查 getter，命中即计算属性读。
            var base_node = sstate.child(id, 0)
            var si = types.low(base)
            var off = cls_fldoff[si]
            var cnt = cls_nfld[si]
            var field_found: bool = false
            var i: i64 = 0
            while i < cnt {
                if intern.lookup(fld_names[off + i]) == fnm {
                    field_found = true
                    break
                }
                i = i + 1
            }
            if field_found {
                // 普通字段路径（既有）：base 必须可寻址（P2a：表下标 t[i] 放行）。
                // p.9.11.17 fn 类型字段放宽：函数值读取（作被调者，如
                // make_cb().f(7) 改写后的 FieldAccess）不要求基可寻址——读值
                // 走 tig_agg_addr 表达式落内存；普通字段读取仍要求可寻址。
                if !sstate.is_addressable(base_node) && s_tags[base_node] != 13 {
                    var is_fnf: bool = types.is_fn(fld_tys[off + i])
                    if !is_fnf {
                        var cls_name = sstate.struct_name_of(si)
                        sm_err_line = s_lines[id]
                        sm_err_col = s_cols[id]
                        sm_err_msg = "struct 实例 '" + cls_name + "' 的字段访问需要可寻址对象（变量/字段链），"
                        return -1
                    }
                }
                node_types[id] = fld_tys[off + i]
                g_typed = g_typed + 1
                return fld_tys[off + i]
            }
            // 计算属性 getter：<Struct>::<field名>，零额外参数（仅接收者），返回属性类型。
            var gfull = sstate.struct_name_of(si) + "::" + fnm
            var gsig = sstate.fn_sig(gfull)
            if gsig >= 0 {
                var grec = sp_tys[sg_off[gsig]]
                if !stype.types_compatible(grec, base) {
                    sm_err_line = s_lines[id]
                    sm_err_col = s_cols[id]
                    sm_err_msg = "计算属性 getter '" + gfull + "' 接收者类型不匹配：期望 " + types.type_name(grec) + "，实际 " + types.type_name(base)
                    return -1
                }
                if sg_nparams[gsig] != 1 {
                    sm_err_line = s_lines[id]
                    sm_err_col = s_cols[id]
                    sm_err_msg = "计算属性 getter '" + gfull + "' 必须恰好 1 个参数（仅接收者），实际 " + to_string(sg_nparams[gsig]) + " 个"
                    return -1
                }
                var grt = sg_ret[gsig]
                g_cmp_getter[id] = interner.intern(gfull)
                node_types[id] = grt
                g_typed = g_typed + 1
                return grt
            }
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            sm_err_msg = "类 '" + sstate.struct_name_of(si) + "' 没有字段 '" + fnm + "'"
            return -1
        }
        if bk == K_MAP {
            // p.9.11.5 记录字段读取：`rec.k` ↔ `rec["k"]` 一致（键化表 map 模型）。
            // 字段名作字符串键 → s21_map_get(base, "k")，结果类型 = map 值类型。
            var me = types.table_elem(base)
            if me < 0 {
                // 裸 map：值类型未知，默认 i64
                node_types[id] = types.named(TK_I64)
                g_typed = g_typed + 1
                return types.named(TK_I64)
            }
            node_types[id] = me
            g_typed = g_typed + 1
            return me
        }
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "字段访问 '.' 的对象必须是元组/类实例/映射记录，实际是 " + types.type_name(base)
        return -1
}

}