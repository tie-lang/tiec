type tie<class>
// compiler/frontend/pexpr_p3.tie —— 分片 3（p.9.21.3 单文件 ≤800 行）
// ============================================================
// 由 split_parts.py 按行数贪心分片：只搬函数与紧邻注释，
// 顶层全局 var 与 import 树仍留在 pexpr.tie。
namespace pexpr {
// S1.2 I1 内联汇编：`asm!("template", in(reg) expr, out(reg) expr, ...)`
// 产出 N_ASM（name = 模板串池 id；children = 操作数节点——复用 N_PARAM：
// val = 0=in 1=out 2=inout，children[0] = 表达式）。
// 约束固定 "reg"（第一版；扩展约束语法后续）。
func parse_asm_expr(line: i64, col: i64) -> i64 {
    putil.advance()   // asm
    if !putil.expect(lex_bang, "'!'") {
        return -1
    }
    if !putil.expect(lex_lparen, "'('") {
        return -1
    }
    if putil.peek_tag() != lex_str {
        putil.set_err(putil.peek_line(), putil.peek_col(), "asm! 第一参数必须是模板字符串")
        return -1
    }
    var tmpl = interner.intern(putil.peek_lexeme())
    putil.advance()
    var ops: table<i64> = table_new_i64()
    if !putil.eat(lex_rparen) {
        // 有操作数：模板后必须跟逗号
        if !putil.expect(lex_comma, "','") {
            return -1
        }
        var d = false
        while !d {
            // 操作数：`in` / `out` / `inout`（in 是关键字 lex_in，out/inout 是
            // 标识符）+ `(` + `reg` + `)` + 表达式；或平台条件编译标注
            // `target("arch")`（任务17：按目标平台分支编译）。
            var kind = ""
            var kind_v: i64 = -1
            if putil.peek_tag() == lex_in {
                kind = "in"
                kind_v = 0
            } else if putil.peek_tag() == lex_ident {
                kind = putil.peek_lexeme()
                if kind == "out" {
                    kind_v = 1
                } else if kind == "inout" {
                    kind_v = 2
                } else if kind == "target" {
                    kind_v = 3
                } else {
                    putil.set_err(putil.peek_line(), putil.peek_col(), "asm! 操作数方向必须是 in / out / inout / target，实际是 '" + kind + "'")
                    return -1
                }
            } else {
                putil.set_err(putil.peek_line(), putil.peek_col(), "asm! 操作数必须形如 in(reg) 表达式 / out(reg) 表达式 / target(\"arch\")")
                return -1
            }
            putil.advance()
            if kind_v == 3 {
                // target("arch")：平台条件编译标注（N_PARAM name = 平台字符串池 id，
                // val = 3；children 空）。irgen 按当前编译目标匹配，不匹配 → 报错。
                if !putil.expect(lex_lparen, "'('") {
                    return -1
                }
                if putil.peek_tag() != lex_str {
                    putil.set_err(putil.peek_line(), putil.peek_col(), "asm! target() 参数必须是平台字符串字面量（如 target(\"x86_64\")）")
                    return -1
                }
                var arch = putil.peek_lexeme()
                putil.advance()
                if !putil.expect(lex_rparen, "')'") {
                    return -1
                }
                var p = ast.new_node(N_PARAM, interner.intern(arch), 3, -1, putil.peek_line(), putil.peek_col())
                var pk0: table<i64> = table_new_i64()
                ast.set_children(p, pk0)
                table_push(ops, p)
            } else {
                if !putil.expect(lex_lparen, "'('") {
                    return -1
                }
                if putil.peek_tag() != lex_ident || putil.peek_lexeme() != "reg" {
                    putil.set_err(putil.peek_line(), putil.peek_col(), "asm! 第一版只支持 reg 约束（in/out/inout(reg)）")
                    return -1
                }
                putil.advance()
                if !putil.expect(lex_rparen, "')'") {
                    return -1
                }
                var e = parse_unary()
                if e < 0 {
                    return -1
                }
                var p = ast.new_node(N_PARAM, -1, kind_v, -1, putil.peek_line(), putil.peek_col())
                var pkids: table<i64> = table_new_i64()
                table_push(pkids, e)
                ast.set_children(p, pkids)
                table_push(ops, p)
            }
            if putil.eat(lex_comma) {
                // 继续
            } else {
                if !putil.expect(lex_rparen, "')'") {
                    return -1
                }
                d = true
            }
        }
    }
    var n = ast.new_node(N_ASM, tmpl, -1, -1, line, col)
    ast.set_children(n, ops)
    return n
}

// 表单元格：`id:value`（id 为数字或字符串键）或普通 `value`
func parse_table_cell(row: i64) -> i64 {
    var line = putil.peek_line()
    var col = putil.peek_col()
    var id_node = -1
    if putil.peek_tag() == lex_int {
        if putil.peek_n(1) == lex_colon {
            var v = putil.parse_int_lit(putil.peek_lexeme())
            putil.advance()   // 数字
            putil.advance()   // 冒号
            id_node = ast.new_node(N_TABLE_ID, -1, v, -1, line, col)
        }
    } else if putil.peek_tag() == lex_str {
        if putil.peek_n(1) == lex_colon {
            var lid = interner.intern(putil.peek_lexeme())
            putil.advance()   // 字符串
            putil.advance()   // 冒号
            id_node = ast.new_node(N_TABLE_ID, lid, -1, -1, line, col)
        }
    }
    var value = parse_expr()
    if value < 0 {
        return -1
    }
    var c = ast.new_node(N_TABLE_CELL, -1, row, -1, line, col)
    var kids: table<i64> = table_new_i64()
    table_push(kids, id_node)
    table_push(kids, value)
    ast.set_children(c, kids)
    return c
}

// 闭包字面量：`func(x: i64, y: i64) -> i64 { ... }`。
// 只解析「头部」（参数列表 + 返回类型），函数体 token 流配平跳过并登记
// 快照（putil.defer_closure_push）；整份文件解析完后由
// pstmt_flow.parse_deferred_closures 恢复快照、parse_block 解析函数体并
// 回填到 N_FN_LIT 的 children 末尾。
// 为何延迟：函数体是语句块，需要 pstmt_flow 的语句解析能力，但本模块
// （pexpr）在 import 树底层无法调用 pstmt_flow（成环：pstmt_flow → pstmt
// → pexpr → pstmt_flow）。延迟解析让 pexpr 只产出「头部完整、函数体待填」
// 的节点，由 import 树高层的 pstmt_top/pstmt_flow 回填。
func parse_fn_lit(line: i64, col: i64) -> i64 {
    putil.advance()   // func
    if !putil.expect(lex_lparen, "'('") {
        return -1
    }
    var params: table<i64> = table_new_i64()
    if !putil.eat(lex_rparen) {
        var d = false
        while !d {
            var pname = putil.expect_ident()
            if pname < 0 {
                return -1
            }
            if !putil.expect(lex_colon, "':'") {
                return -1
            }
            var is_var: i64 = 0
            if putil.eat(lex_ellipsis) {
                is_var = 1   // 变参：`name: ...T`（必须是最后一个参数）
            }
            var by_ref: i64 = 0
            if putil.eat(lex_ref) {
                by_ref = 1
            }
            if is_var == 1 && by_ref == 1 {
                putil.set_err(putil.peek_line(), putil.peek_col(), "变参参数不能同时使用 ref 修饰")
                return -1
            }
            var pty = pexpr_type.parse_type()
            if pty < 0 {
                return -1
            }
            var pdef = -1
            if putil.eat(lex_eq) {
                if is_var == 1 {
                    putil.set_err(putil.peek_line(), putil.peek_col(), "变参参数不能有默认值")
                    return -1
                }
                pdef = parse_expr()
                if pdef < 0 {
                    return -1
                }
            }
            if is_var == 1 && putil.peek_tag() == lex_comma {
                putil.set_err(putil.peek_line(), putil.peek_col(), "变参参数必须是最后一个参数")
                return -1
            }
            var p = ast.new_node(N_PARAM, pname, by_ref, is_var, putil.peek_line(), putil.peek_col())
            var pkids: table<i64> = table_new_i64()
            table_push(pkids, pty)
            table_push(pkids, pdef)
            ast.set_children(p, pkids)
            table_push(params, p)
            if putil.eat(lex_comma) {
                // 继续
            } else {
                if !putil.expect(lex_rparen, "')'") {
                    return -1
                }
                d = true
            }
        }
    }
    var ret_ty = -1
    if putil.eat(lex_arrow) {
        ret_ty = pexpr_type.parse_type()
        if ret_ty < 0 {
            return -1
        }
    } else {
        ret_ty = ast.new_node(N_NAMED_TYPE, interner.intern("void"), 14, -1, line, col)
    }
    if putil.peek_tag() != lex_lbrace {
        putil.set_err(putil.peek_line(), putil.peek_col(), "闭包函数体必须是以 '{' 开始的代码块")
        return -1
    }
    // 创建节点：先设头部 children（泛型槽、返回类型、参数...），函数体
    // 由延迟回填追加到 children 末尾。布局与 N_FN_DEF 一致。
    var f = ast.new_node(N_FN_LIT, -1, -1, len(params), line, col)
    var kids: table<i64> = table_new_i64()
    table_push(kids, -1)   // 泛型槽（闭包暂不支持显式类型参数）
    table_push(kids, ret_ty)
    var i: i64 = 0
    while i < len(params) {
        table_push(kids, params[i])
        i = i + 1
    }
    ast.set_children(f, kids)
    // 登记函数体起始快照（游标此刻停在 '{' 上），随后配平跳过函数体 token
    putil.defer_closure_push(f)
    if !skip_closure_body() {
        return -1
    }
    return f
}

// 配平跳过闭包函数体 `{ ... }`（不建 AST，只消费 token 流到匹配的 '}'）。
// 函数体由 pstmt_flow.parse_deferred_closures 在 parse_program 末尾恢复
// 快照后重新解析（本模块无法调用 pstmt_flow——import 树成环）。
// 注意：字符串/字符字面量是单 token（lex_str），其内部花括号不会干扰
// 配平；嵌套闭包/普通块的花括号正常计数。
func skip_closure_body() -> bool {
    if !putil.expect(lex_lbrace, "'{'") {
        return false
    }
    var depth: i64 = 1   // 已消费起始 '{'，depth=1 表示进入一层
    while depth > 0 {
        var tag = putil.peek_tag()
        if tag == lex_eof {
            putil.set_err(putil.peek_line(), putil.peek_col(), "闭包函数体未闭合：期望 '}'")
            return false
        }
        if tag == lex_lbrace {
            depth = depth + 1
        } else if tag == lex_rbrace {
            depth = depth - 1
        }
        putil.advance()
    }
    return true
}

// 准引用字面量：`` ` `` 已消费。两形态：
//   `` `(expr) ``  表达式形式：立即用 parse_expr 解析（内部可含 $ 插值与
//                  嵌套准引用），产出 N_CODE_LIT(val=0, children=[expr])。
//   `` `{ stmts } `` 块形式：登记 N_CODE_LIT(val=1) + 块体 token 流快照
//                  （putil.defer_code_push），配平跳过块体；块体由
//                  pstmt_flow.parse_deferred_code_blocks 在 parse_program
//                  末尾恢复快照、parse_block 解析、回填 children[0]（StmtList）。
// 准引用内容必须是语法合法的表达式/语句块（宏 model §3.4：构造期检查）。
func parse_quasi(line: i64, col: i64) -> i64 {
    putil.advance()   // 反引号
    var tag = putil.peek_tag()
    if tag == lex_lparen {
        putil.advance()
        var expr = parse_expr()
        if expr < 0 {
            return -1
        }
        if !putil.expect(lex_rparen, "')'") {
            return -1
        }
        var n = ast.new_node(N_CODE_LIT, -1, 0, -1, line, col)
        var kids: table<i64> = table_new_i64()
        table_push(kids, expr)
        ast.set_children(n, kids)
        return n
    }
    if tag == lex_lbrace {
        var n = ast.new_node(N_CODE_LIT, -1, 1, -1, line, col)
        var kids: table<i64> = table_new_i64()
        table_push(kids, -1)   // 块体待回填（parse_deferred_code_blocks 填入）
        ast.set_children(n, kids)
        putil.defer_code_push(n)
        if !skip_quasi_body() {
            return -1
        }
        return n
    }
    putil.set_err(line, col, "准引用必须是 `(表达式)` 或 `{语句块}`，实际是 " + putil.describe(tag))
    return -1
}

// 配平跳过准引用块体 `{ ... }`（与 skip_closure_body 同款；块体由
// pstmt_flow.parse_deferred_code_blocks 恢复快照后重新解析）。
func skip_quasi_body() -> bool {
    if !putil.expect(lex_lbrace, "'{'") {
        return false
    }
    var depth: i64 = 1
    while depth > 0 {
        var tag = putil.peek_tag()
        if tag == lex_eof {
            putil.set_err(putil.peek_line(), putil.peek_col(), "准引用块未闭合：期望 '}'")
            return false
        }
        if tag == lex_lbrace {
            depth = depth + 1
        } else if tag == lex_rbrace {
            depth = depth - 1
        }
        putil.advance()
    }
    return true
}

// 插值表达式：`$` 已消费。两形态：
//   `$ident`  简单形式：N_CODE_INTERP(name=变量名池 id)——宏参数（code）
//             嵌入其 AST；gensym 字符串嵌入为标识符引用。
//   `$(expr)` 复杂形式：N_CODE_INTERP(children=[表达式])——表达式求值为
//             code/字符串后嵌入。
func parse_interp(line: i64, col: i64) -> i64 {
    putil.advance()   // $
    if putil.peek_tag() == lex_ident {
        var nm = interner.intern(putil.peek_lexeme())
        putil.advance()
        return ast.new_node(N_CODE_INTERP, nm, -1, -1, line, col)
    }
    if putil.peek_tag() == lex_lparen {
        putil.advance()
        var expr = parse_expr()
        if expr < 0 {
            return -1
        }
        if !putil.expect(lex_rparen, "')'") {
            return -1
        }
        var n = ast.new_node(N_CODE_INTERP, -1, -1, -1, line, col)
        var kids: table<i64> = table_new_i64()
        table_push(kids, expr)
        ast.set_children(n, kids)
        return n
    }
    putil.set_err(line, col, "插值必须是 $标识符 或 $(表达式)，实际是 " + putil.describe(putil.peek_tag()))
    return -1
}

}