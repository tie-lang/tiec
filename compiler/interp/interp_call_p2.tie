        table_push(cb_s3_nids, interner.intern("sort_strings"))
        table_push(cb_s3_nids, interner.intern("regex_findstr"))
        table_push(cb_s3_nids, interner.intern("sleep_ms"))
        cb_s3_ready = true
        // 构建后插入排序（一次性；查询走二分，对齐 is_builtin_nid）
        var a: i64 = 1
        while a < len(cb_s3_nids) {
            var key = cb_s3_nids[a]
            var b: i64 = a - 1
            while b >= 0 && cb_s3_nids[b] > key {
                cb_s3_nids[b + 1] = cb_s3_nids[b]
                b = b - 1
            }
            cb_s3_nids[b + 1] = key
            a = a + 1
        }
    }
    var lo: i64 = 0
    var hi: i64 = len(cb_s3_nids) - 1
    while lo <= hi {
        var mid = (lo + hi) / 2
        var v = cb_s3_nids[mid]
        if v == nid {
            return true
        }
        if v < nid {
            lo = mid + 1
        } else {
            hi = mid - 1
        }
    }
    return false
}

// 内置函数分派（nid 版主实现）：判段用 nid 整数比较，段函数仍收 name 文本
//（段内个别内建要用名字），由 interner.lookup 还原一次。
func call_builtin_nid(nid: i64, args: table<Value>) -> Value {
    var name = interner.lookup(nid)
    if cb_is_seg1_nid(nid) {
        return call_builtin_seg1(name, args)
    }
    if cb_is_seg2_nid(nid) {
        return call_builtin_seg2(name, args)
    }
    if cb_is_seg3_nid(nid) {
        return call_builtin_seg3(name, args)
    }
    w_err = "内部错误: 未实现的内置函数 '" + name + "'"
    return Value.Nil
}

// findstr /r 子集正则命中（0-Rust 纯 tie，零桥）。语义：s 中存在匹配即 true。
// 支持子集（对齐 findstr /r 常用语法）：
//   普通字符（字面量）、. （任意单字符）、[…] 字符类（含范围 a-z / 0-9、
//   ^ 开头取反）、^ 行首锚（仅整体首 token）、$ 行尾锚（仅整体末 token）、
//   * + ? 量词（贪婪 + 回溯）、\c 转义字面量（\. \\ \* 等）。
// 注：跨码点按码点匹配；逐字节语义见 str_char（内联原语）。零 Rust 依赖。
// fsm 匹配：递归回溯。find_here(s, si, pat, pi) = 以 si/pi 为起点，让 pat[pi..]
// 完整消费成功则返回 (匹配覆盖的 s 结束码点索引+1)，失败返回 -1。
func b_findstr(s: string, pat: string) -> bool {
    var slen = str_len(s)
    var plen = str_len(pat)
    if plen == 0 {
        return true
    }
    // ^ 锚定：仅从起点 0 尝试，且 pat 以 ^ 开头（后随体）
    if str_char(pat, 0) == "^" {
        if plen == 1 {
            return false
        }
        return find_here(s, 0, pat, 1) >= 0
    }
    var i: i64 = 0
    while i <= slen {
        if find_here(s, i, pat, 0) >= 0 {
            return true
        }
        i = i + 1
    }
    return false
}

}