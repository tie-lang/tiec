    if name == "tokenize" { return true }
    if name == "deparse" { return true }
    if name == "token_len" { return true }
    if name == "token_tag_at" { return true }
    if name == "token_lexeme_at" { return true }
    if name == "get_env" { return true }
    if name == "set_env" { return true }
    if name == "exec_code" { return true }
    if name == "exec_output" { return true }
    if name == "cwd" { return true }
    if name == "time_now" { return true }
    if name == "file_read" { return true }
    if name == "file_write" { return true }
    if name == "file_append" { return true }
    if name == "file_exists" { return true }
    if name == "path_join" { return true }
    if name == "mkdir_all" { return true }
    if name == "remove_dir_all" { return true }
    if name == "contains" { return true }
    if name == "has_prefix" { return true }
    if name == "has_suffix" { return true }
    if name == "split_lines" { return true }
    if name == "split_char" { return true }
    if name == "substr" { return true }
    if name == "replace_all" { return true }
    if name == "is_empty" { return true }
    if name == "pipe_char" { return true }
    if name == "path_basename" { return true }
    if name == "list_dir" { return true }
    if name == "walk_dir" { return true }
    if name == "arg_count" { return true }
    return false
}

// 段 3 名单：脚本参数/文件哈希/进程与退出/确定性内建（与 seg3 一致）
func cb_is_seg3(name: string) -> bool {
    if name == "arg_at" { return true }
    if name == "get_file_hash" { return true }
    if name == "exec_code_timeout" { return true }
    if name == "exit" { return true }
    if name == "remove_file" { return true }
    if name == "sort_strings" { return true }
    if name == "regex_findstr" { return true }
    if name == "sleep_ms" { return true }
    return false
}

// findstr /r 子集正则命中（0-Rust 纯 tie，零桥）。语义：s 中存在匹配即 true。
// 支持子集（对齐 findstr /r 常用语法）：
//   普通字符（字面量）、. （任意单字符）、[…] 字符类（含范围 a-z / 0-9、
//   ^ 开头取反）、^ 行首锚（仅整体首 token）、$ 行尾锚（仅整体末 token）、
//   * + ? 量词（贪婪 + 回溯）、\c 转义字面量（\. \\ \* 等）。
// 注：跨码点按码点匹配；逐字节语义见 str_char（内联原语）。零 Rust 依赖。
// fsm 匹配：递归回溯。find_here(s, si, pat, pi) = 以 si/pi 为起点，让 pat[pi..]
// 完整消费成功则返回 (匹配覆盖的 s 结束码点索引+1)，失败返回 -1。
func b_findstr(s: string, pat: string) -> bool {
    var slen = str_len(s)
    var plen = str_len(pat)
    if plen == 0 {
        return true
    }
    // ^ 锚定：仅从起点 0 尝试，且 pat 以 ^ 开头（后随体）
    if str_char(pat, 0) == "^" {
        if plen == 1 {
            return false
        }
        return find_here(s, 0, pat, 1) >= 0
    }
    var i: i64 = 0
    while i <= slen {
        if find_here(s, i, pat, 0) >= 0 {
            return true
        }
        i = i + 1
    }
    return false
}

}