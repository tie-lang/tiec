        table_push(cb_s2_nids, interner.intern("has_suffix"))
        table_push(cb_s2_nids, interner.intern("split_lines"))
        table_push(cb_s2_nids, interner.intern("split_char"))
        table_push(cb_s2_nids, interner.intern("substr"))
        table_push(cb_s2_nids, interner.intern("replace_all"))
        table_push(cb_s2_nids, interner.intern("is_empty"))
        table_push(cb_s2_nids, interner.intern("pipe_char"))
        table_push(cb_s2_nids, interner.intern("path_basename"))
        table_push(cb_s2_nids, interner.intern("list_dir"))
        table_push(cb_s2_nids, interner.intern("walk_dir"))
        table_push(cb_s2_nids, interner.intern("arg_count"))
        cb_s2_ready = true
        // 构建后插入排序（一次性；查询走二分，对齐 is_builtin_nid）
        var a: i64 = 1
        while a < len(cb_s2_nids) {
            var key = cb_s2_nids[a]
            var b: i64 = a - 1
            while b >= 0 && cb_s2_nids[b] > key {
                cb_s2_nids[b + 1] = cb_s2_nids[b]
                b = b - 1
            }
            cb_s2_nids[b + 1] = key
            a = a + 1
        }
    }
    var lo: i64 = 0
    var hi: i64 = len(cb_s2_nids) - 1
    while lo <= hi {
        var mid = (lo + hi) / 2
        var v = cb_s2_nids[mid]
        if v == nid {
            return true
        }
        if v < nid {
            lo = mid + 1
        } else {
            hi = mid - 1
        }
    }
    return false
}

// 段 3 名单：脚本参数/文件哈希/进程与退出/确定性内建。字符串版薄包装。
func cb_is_seg3(name: string) -> bool {
    return cb_is_seg3_nid(interner.intern(name))
}

func cb_is_seg3_nid(nid: i64) -> bool {
    if !cb_s3_ready {
        table_push(cb_s3_nids, interner.intern("arg_at"))
