type tie<class>
// compiler/interp/interp_call_p2.tie —— 分片 2（p.9.21.3 单文件 ≤800 行）
// ============================================================
// 由 split_parts.py 按行数贪心分片：只搬函数与紧邻注释，
// 顶层全局 var 与 import 树仍留在 interp_call.tie。
import "./call_builtin_seg1.tie"
import "./call_builtin_seg2.tie"
import "./call_builtin_seg3.tie"

// 三段名单单一数据源的全局表（p.9.17.3 后半；namespace 外——tie 全局必须顶层）。
var cb_s1: table<string>;
var cb_s1_ready: bool = false;
var cb_s2: table<string>;
var cb_s2_ready: bool = false;
var cb_s3: table<string>;
var cb_s3_ready: bool = false;
var cb_s1_nids: table<i64>;
var cb_s2_nids: table<i64>;
var cb_s3_nids: table<i64>;


namespace interp {

// 内置函数分派（对齐 Rust call_fn 内置分支语义与错误文本）。
// 值传递类（str_char/char_code/to_string/parse_float 等）直接转发语言底座
// 原语（两路径共用同一份 Rust 桥实现，行为一致）。
//
// p.9.17.2 Value 化分派约定：Value.Nil 是合法 void 返回值，旧的「-1 哨兵 =
// 未命中」双关失效；改用前置名单分派——先以 cb_is_segN 判定名字属于哪段，
// 只进入对应段（段尾 return 仅为防御出口）；错误统一经 w_err != "" 传播，
// 未命中不置 w_err。名单为无状态纯函数，eval 等内建递归重入安全。
func call_builtin(name: string, args: table<Value>) -> Value {
    if cb_is_seg1(name) {
        return call_builtin_seg1(name, args)
    }
    if cb_is_seg2(name) {
        return call_builtin_seg2(name, args)
    }
    if cb_is_seg3(name) {
        return call_builtin_seg3(name, args)
    }
    w_err = "内部错误: 未实现的内置函数 '" + name + "'"
    return Value.Nil
}

// p.9.17.3 后半：三段名单的 nid 版判定（热路径分派）。名单**内联惰性构建**
// 在各 nid 函数体内（教训：经 cb_segN_names() 辅助函数取名单 = 每次判定多付
// 一次完整解释器函数调用）；字符串版 cb_is_segN 转薄包装（intern 转 nid）。

// 段 1 名单：宏/求值/打印/字符串解析/动态表（与 call_builtin_seg1 分支一致）。
// 字符串版薄包装。
func cb_is_seg1(name: string) -> bool {
    return cb_is_seg1_nid(interner.intern(name))
}

func cb_is_seg1_nid(nid: i64) -> bool {
    if !cb_s1_ready {
        table_push(cb_s1_nids, interner.intern("gensym"))
        table_push(cb_s1_nids, interner.intern("eval_code"))
        table_push(cb_s1_nids, interner.intern("eval_expr"))
        table_push(cb_s1_nids, interner.intern("println"))
        table_push(cb_s1_nids, interner.intern("print"))
        table_push(cb_s1_nids, interner.intern("len"))
        table_push(cb_s1_nids, interner.intern("str_len"))
        table_push(cb_s1_nids, interner.intern("str_char"))
        table_push(cb_s1_nids, interner.intern("char_code"))
        table_push(cb_s1_nids, interner.intern("to_string"))
        table_push(cb_s1_nids, interner.intern("to_trit"))
        table_push(cb_s1_nids, interner.intern("trit_val"))
        table_push(cb_s1_nids, interner.intern("parse_int"))
        table_push(cb_s1_nids, interner.intern("parse_float"))
        table_push(cb_s1_nids, interner.intern("table_new_i64"))
        table_push(cb_s1_nids, interner.intern("table_new_f64"))
        table_push(cb_s1_nids, interner.intern("table_new_string"))
        table_push(cb_s1_nids, interner.intern("table_new_bool"))
        table_push(cb_s1_nids, interner.intern("table_at"))
        table_push(cb_s1_nids, interner.intern("eval"))
        table_push(cb_s1_nids, interner.intern("eval_call"))
        table_push(cb_s1_nids, interner.intern("compile_error"))
        cb_s1_ready = true
        // 构建后插入排序（一次性；查询走二分，对齐 is_builtin_nid）
        var a: i64 = 1
        while a < len(cb_s1_nids) {
            var key = cb_s1_nids[a]
            var b: i64 = a - 1
            while b >= 0 && cb_s1_nids[b] > key {
                cb_s1_nids[b + 1] = cb_s1_nids[b]
                b = b - 1
            }
            cb_s1_nids[b + 1] = key
            a = a + 1
        }
    }
    var lo: i64 = 0
    var hi: i64 = len(cb_s1_nids) - 1
    while lo <= hi {
        var mid = (lo + hi) / 2
        var v = cb_s1_nids[mid]
        if v == nid {
            return true
        }
        if v < nid {
            lo = mid + 1
        } else {
            hi = mid - 1
        }
    }
    return false
}

// 段 2 名单：token 流 API/tsh 运行时桥/字符串内建/路径与目录。字符串版薄包装。
