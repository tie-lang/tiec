type tie<class>
// compiler/interp/interp_call_p2.tie —— 分片 2（p.9.21.3 单文件 ≤800 行）
// ============================================================
// 由 split_parts.py 按行数贪心分片：只搬函数与紧邻注释，
// 顶层全局 var 与 import 树仍留在 interp_call.tie。
import "./call_builtin_seg1.tie"
import "./call_builtin_seg2.tie"
import "./call_builtin_seg3.tie"

namespace interp {
// 内置函数分派（对齐 Rust call_fn 内置分支语义与错误文本）。
// 值传递类（str_char/char_code/to_string/parse_float 等）直接转发语言底座
// 原语（两路径共用同一份 Rust 桥实现，行为一致）。
//
// p.9.17.2 Value 化分派约定：Value.Nil 是合法 void 返回值，旧的「-1 哨兵 =
// 未命中」双关失效；改用前置名单分派——先以 cb_is_segN 判定名字属于哪段，
// 只进入对应段（段尾 return 仅为防御出口）；错误统一经 w_err != "" 传播，
// 未命中不置 w_err。名单为无状态纯函数，eval 等内建递归重入安全。
func call_builtin(name: string, args: table<Value>) -> Value {
    if cb_is_seg1(name) {
        return call_builtin_seg1(name, args)
    }
    if cb_is_seg2(name) {
        return call_builtin_seg2(name, args)
    }
    if cb_is_seg3(name) {
        return call_builtin_seg3(name, args)
    }
    w_err = "内部错误: 未实现的内置函数 '" + name + "'"
    return Value.Nil
}

// 段 1 名单：宏/求值/打印/字符串解析/动态表（与 call_builtin_seg1 分支一致）
func cb_is_seg1(name: string) -> bool {
    if name == "gensym" { return true }
    if name == "eval_code" { return true }
    if name == "eval_expr" { return true }
    if name == "println" { return true }
    if name == "print" { return true }
    if name == "len" { return true }
    if name == "str_len" { return true }
    if name == "str_char" { return true }
    if name == "char_code" { return true }
    if name == "to_string" { return true }
    if name == "to_trit" { return true }
    if name == "trit_val" { return true }
    if name == "parse_int" { return true }
    if name == "parse_float" { return true }
    if name == "table_new_i64" { return true }
    if name == "table_new_f64" { return true }
    if name == "table_new_string" { return true }
    if name == "table_new_bool" { return true }
    if name == "table_at" { return true }
    if name == "eval" { return true }
    if name == "eval_call" { return true }
    if name == "compile_error" { return true }
    return false
}

// 段 2 名单：token 流 API/tsh 运行时桥/字符串内建/路径与目录（与 seg2 一致）
