type tie<class>
// compiler/interp/interp_call.tie —— 自举 v2 解释器核心：函数调用求值
// （从 interp.tie 拆出：call_fn/参数绑定/call_builtin/is_builtin/join_print
//   及宏调用分派等函数调用求值函数）
// ============================================================
// 范式：tie import 是文本内联——被 import 文件全部代码并入编译单元，一切
// 符号全局可见。本文件与主文件 interp.tie 共享一个 `namespace interp`（跨
// 文件闭合并集，同 interp_bin.tie 先例），函数可互相裸名调用、访问主文件
// 顶层全局 var（g_err/g_flow 等）与 ivalue 等。
// 本文件不自建全局 var，不含 import。

namespace interp {

// ==================== 函数调用 ====================

// 函数调用：内置函数 → 用户函数 → 报错。返回值 id；失败置 g_err 返回 -1。
// args = 实参值 id 表；arg_nodes = 实参 AST 节点表（by_ref 需取实参变量名）。
func call_fn(name: string, args: table<i64>, arg_nodes: table<i64>) -> i64 {
    // 内置函数（对齐 Rust call_fn 的 match name 分支）
    if is_builtin(name) {
        return call_builtin(name, args)
    }
    // 用户函数（REPL 中定义的；命名空间函数以全名注册）
    var f = isess.f_get(name)
    if f < 0 {
        g_err = "未定义的函数 '" + name + "'"
        return -1
    }
    // FnDef 泛型槽偏移：children = [类型参数槽, 返回类型, 参数..., 函数体]，
    // 形参从 1 + soff 起（对齐 sstate.slot_off——曾按旧布局读 children[1+i]，
    // 泛型槽引入后把槽/返回类型误当形参绑定，函数调用全错位）
    var fsoff: i64 = 0
    if isess.nchild(f) > 1 {
        var fc0 = isess.nchild_at(f, 0)
        if fc0 < 0 {
            fsoff = 1
        } else if isess.ntag(fc0) == N_TYPE_PARAMS {
            fsoff = 1
        }
    }
    // 参数个数区间检查（默认值参数）：实参数必须在 [必选数, 总形参数] 内；
    // 变参（最后一个形参 aux==1）：无上界，必选数不含变参本身
    var total = isess.naux(f)
    var has_var: bool = false
    var required: i64 = 0
    var pi: i64 = 0
    while pi < total {
        var p = isess.nchild_at(f, 1 + fsoff + pi)
        if isess.naux(p) == 1 {
            has_var = true   // 变参形参（aux 标记）
        } else if isess.nchild_at(p, 1) < 0 {
            required = required + 1
        }
        pi = pi + 1
    }
    if len(args) < required || (!has_var && len(args) > total) {
        var cnt_desc = ""
        if has_var {
            cnt_desc = to_string(required) + "+"
        } else if required == total {
            cnt_desc = to_string(total)
        } else {
            cnt_desc = to_string(required) + "-" + to_string(total)
        }
        g_err = "函数 '" + name + "' 期望 " + cnt_desc + " 个参数，实际 " + to_string(len(args)) + " 个"
        return -1
    }
    // 函数体执行期间，裸调用按本函数命名空间前缀补全
    var saved_ns = isess.ns_save()
    if rfind_ns_str(name) >= 0 {
        env_ns = ns_prefix_of_name(name)
    }
    // 保存调用者的作用域起点，压参后本函数作用域从参数作用域开始
    var saved_base = env_base
    isess.scope_push()
    isess.ref_push()
    var i: i64 = 0
    while i < total {
        var p = isess.nchild_at(f, 1 + fsoff + i)
        var pname = isess.nname_str(p)
        if isess.naux(p) == 1 {
            // 变参：剩余全部实参打包为 Value 表（支持 len/下标/for）
            var tv = ivalue.new_table()
            var ai: i64 = i
            while ai < len(args) {
                tv = ivalue.table_push_val(tv, args[ai])
                ai = ai + 1
            }
            isess.var_declare(pname, tv)
        } else if isess.nval(p) == 1 {
            // T0.3 by_ref：实参必须是可寻址表变量；引用槽记录调用方变量名。
            // 注意：tie 的 || 不短路，先判越界再取节点
            if i >= len(arg_nodes) {
                g_err = "函数 '" + name +
                    "' 的 ref 参数需要可寻址的表变量实参（字面量/下标/调用结果不可取地址）"
                isess.ref_pop()
                isess.scope_pop()
                env_base = saved_base
                isess.ns_restore(saved_ns)
                return -1
            }
            if isess.ntag(arg_nodes[i]) != N_VAR {
                g_err = "函数 '" + name +
                    "' 的 ref 参数需要可寻址的表变量实参（字面量/下标/调用结果不可取地址）"
                isess.ref_pop()
                isess.scope_pop()
                env_base = saved_base
                isess.ns_restore(saved_ns)
                return -1
            }
            isess.ref_add(pname, isess.nname_str(arg_nodes[i]))
        } else {
            var v: i64 = -1
            if i < len(args) {
                v = args[i]
            } else {
                // 缺省参数按默认值表达式求值补齐（限字面量/空表，无作用域依赖）
                var def = isess.nchild_at(p, 1)
                if def >= 0 {
                    v = gen_expr(def)
                    if g_err != "" {
                        isess.ref_pop()
                        isess.scope_pop()
                        env_base = saved_base
                        isess.ns_restore(saved_ns)
                        return -1
                    }
                } else {
                    g_err = "函数 '" + name + "' 缺少第 " + to_string(i + 1) +
                        " 个参数且无默认值"
                    isess.ref_pop()
                    isess.scope_pop()
                    env_base = saved_base
                    isess.ns_restore(saved_ns)
                    return -1
                }
            }
            isess.var_declare(pname, v)
        }
        i = i + 1
    }
    env_base = isess.scope_top()
    var body = isess.nchild_at(f, isess.nchild(f) - 1)
    if dbg_on {
        dbg_enter(name, isess.nline(body))
    }
    exec_block(body)
    if dbg_on {
        dbg_leave()
    }
    isess.ref_pop()
    isess.scope_pop()
    env_base = saved_base
    isess.ns_restore(saved_ns)
    if g_err != "" {
        return -1
    }
    // 处理 return 传播
    if g_flow == FL_RETURN {
        g_flow = FL_NORMAL
        return g_flow_val
    }
    if g_flow == FL_BREAK {
        g_err = "break" + label_space(g_flow_label) + "逃出函数体（内部错误）"
        return -1
    }
    if g_flow == FL_CONTINUE {
        g_err = "continue" + label_space(g_flow_label) + "逃出函数体（内部错误）"
        return -1
    }
    g_flow = FL_NORMAL
    if g_lastval >= 0 {
        return g_lastval
    }
    return ivalue.new_void()
}

// 内置函数名单（对齐 Rust call_fn 的内置分支；T4.1 核心子集）。
// S3.3 新增：gensym（H3 显式卫生唯一标识符）、eval_code（C3 编译期
// 代码生成——仅宏体环境可用，运行期语义层拦截）。
func is_builtin(name: string) -> bool {
    if name == "println" || name == "print" || name == "len" || name == "str_len" ||
        name == "str_char" || name == "char_code" || name == "to_string" ||
        name == "parse_int" || name == "parse_float" ||
        name == "parse_trit" || name == "to_trit" || name == "trit_val" ||
        name == "table_new_i64" || name == "table_new_f64" ||
        name == "table_new_string" || name == "table_new_bool" ||
        name == "table_at" || name == "eval" || name == "eval_call" {
        return true
    }
    if name == "gensym" || name == "eval_code" || name == "eval_expr" {
        return true
    }
    // M4（dev33 批次9 任务27）：compile_error("消息") 宏内主动报编译错误——
    // 置 g_err 上抛，mexpand 以调用点行列号报「宏展开失败」。
    if name == "compile_error" {
        return true
    }
    // M4 过程宏（dev33 批次9）：token 流 API——tokenize（源码→token 流）、
    // deparse（token 流→源码）、token_len/token_tag_at/token_lexeme_at
    // （token 流检视）。仅宏环境（编译期 interp）可用。
    if name == "tokenize" || name == "deparse" || name == "token_len" ||
        name == "token_tag_at" || name == "token_lexeme_at" {
        return true
    }
    // tsh 脚本运行时（shell 角色，p.9.4）：把过程/环境/文件桥开放给解释器
    // 求值——tsh 脚本可直接 `var x = get_env("K")`、`exec_code("cmd")` 等。
    // 这些基础原语在编译端内联到 libc/win32（无 tie_interp 依赖），解释器直调。
    if name == "get_env" || name == "set_env" || name == "exec_code" ||
        name == "exec_output" || name == "cwd" || name == "time_now" ||
        name == "file_read" || name == "file_write" || name == "file_append" ||
        name == "file_exists" || name == "path_join" ||
        name == "mkdir_all" || name == "remove_dir_all" {
        return true
    }
    // tsh 脚本字符串/目录/参数/哈希/超时内建（p.9.4 脚本语义升级）：
    // 字符串 contains/has_prefix/has_suffix/split_lines/split_char/substr/
    // replace_all/is_empty；字面 `|` 逃逸 pipe_char；目录枚举 list_dir/walk_dir；
    // 脚本参数 arg_count/arg_at；file SHA256 get_file_hash；exit(n) 条件退出。
    if name == "contains" || name == "has_prefix" || name == "has_suffix" ||
        name == "split_lines" || name == "split_char" || name == "substr" ||
        name == "replace_all" || name == "is_empty" || name == "pipe_char" ||
        name == "path_basename" ||
        name == "list_dir" || name == "walk_dir" ||
        name == "arg_count" || name == "arg_at" ||
        name == "get_file_hash" || name == "exec_code_timeout" ||
        name == "exit" {
        return true
    }
    // 批次④确定性内建：remove_file（确定删单文件，替代 exec del 的 flake）、
    // sort_strings（字符串表按字节序排序）、regex_findstr（findstr 正则子集
    // 命中判断）、sleep_ms（libc Sleep 短暂等待）。
    if name == "remove_file" || name == "sort_strings" ||
        name == "regex_findstr" || name == "sleep_ms" {
        return true
    }
    return false
}

// 内置函数分派（对齐 Rust call_fn 内置分支语义与错误文本）。
// 值传递类（str_char/char_code/to_string/parse_float 等）直接转发语言底座
// 原语（两路径共用同一份 Rust 桥实现，行为一致）。
func call_builtin(name: string, args: table<i64>) -> i64 {
    if name == "gensym" {
        // S3.3 H3 显式卫生：gensym("前缀") → 唯一标识符（intern 池 + 计数器）。
        // 宏体内生成导出/共享名，经插值（$name / $nm 名字位置）使用。
        if len(args) != 1 {
            g_err = "gensym 需要一个字符串前缀参数"
            return -1
        }
        if ivalue.type_of(args[0]) != T_STR {
            g_err = "gensym 需要一个字符串前缀参数"
            return -1
        }
        g_gensym_n = g_gensym_n + 1
        return ivalue.new_str("__tie_gensym" + to_string(g_gensym_n) + "_" +
            ivalue.str_val(args[0]))
    }
    if name == "eval_code" {
        // S3.3 C3 编译期 eval：eval_code("源码") → code 值（AST 协议文本）。
        // 编译期代码生成（宏体内用）；源码必须语法合法（解析即校验）。
        if len(args) != 1 {
            g_err = "eval_code 需要一个字符串源码参数"
            return -1
        }
        if ivalue.type_of(args[0]) != T_STR {
            g_err = "eval_code 需要一个字符串源码参数"
            return -1
        }
        var src = ivalue.str_val(args[0])
        var proto = parser.parse_src(src)
        if has_str_prefix(proto, "ERR:") {
            g_err = "eval_code 源码语法错误: " + proto
            return -1
        }
        return ivalue.new_code(proto)
    }
    if name == "eval_expr" {
        // M4（dev33 批次9）：eval_expr("表达式源码") → code 值（根 = 表达式
        // 子树）。eval_code 只能解析完整程序，表达式需独立入口——包装成
        // `func __tie_wrap__() -> i64 { return ( <expr> ) }` 解析后抽取
        // return 表达式子树序列化。编译期常量计算宏（任务25）用它注入
        // 计算结果字面量。
        if len(args) != 1 {
            g_err = "eval_expr 需要一个字符串参数"
            return -1
        }
        if ivalue.type_of(args[0]) != T_STR {
            g_err = "eval_expr 需要一个字符串参数"
            return -1
        }
        var src = ivalue.str_val(args[0])
        // 单行包装无换行 → ASI 不补分号，return 语句须显式分号
        var proto = parser.parse_src("func __tie_wrap__() -> i64 { return ( " + src + " ) ; }")
        if has_str_prefix(proto, "ERR:") {
            g_err = "eval_expr 源码语法错误: " + proto
            return -1
        }
        if sstate.load_ast(proto) < 0 {
            g_err = "内部错误: eval_expr 协议加载失败"
            return -1
        }
        var p = expr_from_wrap()
        if g_err != "" {
            return -1
        }
        return ivalue.new_code(p)
    }
    if name == "println" {
        var line = join_print(args)
        println(line)
        return ivalue.new_void()
    }
    if name == "print" {
        var line = join_print(args)
        print(line)
        return ivalue.new_void()
    }
    if name == "len" {
        if len(args) != 1 {
            g_err = "len 需要一个参数"
            return -1
        }
        var v = args[0]
        var t = ivalue.type_of(v)
        if t == T_STR {
            // 字节数（与 Rust s.len() 一致；编译路径 len 同语义）
            return ivalue.new_int(byte_len(ivalue.str_val(v)))
        }
        if t == T_TABLE || t == T_MAP {
            return ivalue.new_int(ivalue.elem_count(v))
        }
        g_err = "len 只支持字符串、表或键值表"
        return -1
    }
    if name == "str_len" {
        if len(args) != 1 {
            g_err = "str_len 需要一个参数"
            return -1
        }
        if ivalue.type_of(args[0]) != T_STR {
            g_err = "str_len 只支持字符串"
            return -1
        }
        return ivalue.new_int(str_len(ivalue.str_val(args[0])))
    }
    if name == "str_char" {
        if len(args) != 2 {
            g_err = "str_char 需要字符串与整数参数"
            return -1
        }
        if ivalue.type_of(args[0]) != T_STR || ivalue.type_of(args[1]) != T_INT {
            g_err = "str_char 需要字符串与整数参数"
            return -1
        }
        return ivalue.new_str(str_char(ivalue.str_val(args[0]), ivalue.int_val(args[1])))
    }
    if name == "char_code" {
        if len(args) != 1 {
            g_err = "char_code 需要一个字符串参数"
            return -1
        }
        if ivalue.type_of(args[0]) != T_STR {
            g_err = "char_code 需要一个字符串参数"
            return -1
        }
        return ivalue.new_int(char_code(ivalue.str_val(args[0])))
    }
    if name == "to_string" {
        if len(args) != 1 {
            g_err = "to_string 需要一个数字参数"
            return -1
        }
        var v = args[0]
        var t = ivalue.type_of(v)
        if t == T_INT {
            return ivalue.new_str(to_string(ivalue.int_val(v)))
        }
        if t == T_FLOAT {
            return ivalue.new_str(to_string(ivalue.float_val(v)))
        }
        if t == T_TRIT {
            return ivalue.new_str(to_string(ivalue.int_val(v)))
        }
        g_err = "to_string 需要一个数字参数"
        return -1
    }
    if name == "to_trit" {
        // i64 → 饱和钳制 trit（>0→+1，<0→-1，0→0，对齐 interp_bin clamp_trit）
        if len(args) != 1 {
            g_err = "to_trit 需要一个整数参数"
            return -1
        }
        if ivalue.type_of(args[0]) != T_INT {
            if ivalue.type_of(args[0]) != T_TRIT {
                g_err = "to_trit 需要一个整数参数"
                return -1
            }
        }
        return ivalue.new_trit(clamp_trit(ivalue.int_val(args[0])))
    }
    if name == "trit_val" {
        // trit → i64（-1/0/1 直接返回）；trit 盒即 i64，直取 int_val
        if len(args) != 1 {
            g_err = "trit_val 需要一个 trit 参数"
            return -1
        }
        if ivalue.type_of(args[0]) != T_TRIT {
            g_err = "trit_val 需要一个 trit 参数"
            return -1
        }
        return ivalue.new_int(ivalue.int_val(args[0]))
    }
    if name == "parse_int" {
        if len(args) != 1 {
            g_err = "parse_int 需要一个字符串参数"
            return -1
        }
        if ivalue.type_of(args[0]) != T_STR {
            g_err = "parse_int 需要一个字符串参数"
            return -1
        }
        var s = ivalue.str_val(args[0])
        // 非法输入先自检（对齐 Rust str::parse::<i64> 严格文法；语言底座
        // parse_int 非法时直接退出进程，解释路径必须改为返回错误）
        if !is_int_text(s) {
            g_err = "运行时错误: parse_int 参数 '" + s + "' 不是合法的整数"
            return -1
        }
        return ivalue.new_int(parse_int(s))
    }
    if name == "parse_float" {
        if len(args) != 1 {
            g_err = "parse_float 需要一个字符串参数"
            return -1
        }
        if ivalue.type_of(args[0]) != T_STR {
            g_err = "parse_float 需要一个字符串参数"
            return -1
        }
        var s = ivalue.str_val(args[0])
        if !is_float_text(s) {
            g_err = "运行时错误: parse_float 参数 '" + s + "' 不是合法的浮点数"
            return -1
        }
        return ivalue.new_float(parse_float(s))
    }
    // 动态表构造：全部返回空表值（与编译路径 table_new_* 语义一致）
    if name == "table_new_i64" || name == "table_new_f64" ||
        name == "table_new_string" || name == "table_new_bool" {
        if len(args) != 0 {
            g_err = name + " 不需要参数"
            return -1
        }
        return ivalue.new_table()
    }
    if name == "table_at" {
        if len(args) != 2 {
            g_err = "table_at 需要表与整数下标参数"
            return -1
        }
        if ivalue.type_of(args[0]) != T_TABLE || ivalue.type_of(args[1]) != T_INT {
            g_err = "table_at 需要表与整数下标参数"
            return -1
        }
        var t = args[0]
        var idx = ivalue.int_val(args[1])
        if idx < 0 || idx >= ivalue.elem_count(t) {
            g_err = "运行时错误: table_at 下标越界：索引 " + to_string(idx) +
                " 超出长度 " + to_string(ivalue.elem_count(t))
            return -1
        }
        return ivalue.elem_at(t, idx)
    }
    if name == "eval" {
        if len(args) != 1 {
            g_err = "eval 需要一个字符串参数"
            return -1
        }
        if ivalue.type_of(args[0]) != T_STR {
            g_err = "eval 需要一个字符串参数"
            return -1
        }
        // 递归 eval（同一会话；对齐 Rust session.eval）
        var r = eval(ivalue.str_val(args[0]))
        if g_err != "" {
            return -1
        }
        return ivalue.new_str(r)
    }
    if name == "eval_call" {
        if len(args) != 2 {
            g_err = "eval_call 需要两个字符串参数（函数名, 参数）"
            return -1
        }
        if ivalue.type_of(args[0]) != T_STR || ivalue.type_of(args[1]) != T_STR {
            g_err = "eval_call 需要两个字符串参数（函数名, 参数）"
            return -1
        }
        var r = eval_call(ivalue.str_val(args[0]), ivalue.str_val(args[1]))
        if g_err != "" {
            return -1
        }
        return ivalue.new_str(r)
    }
    // ==================== M4 token 流 API（宏环境，dev33 批次9） ====================
    // tokenize：源码字符串 → token 流文本（首行 <N>:，随后每行 <tag> <lexeme>，
    // 排除末尾 Eof；lexeme 反斜杠/换行转义——保证每 token 单行且往返一致）。
    if name == "compile_error" {
        // M4（dev33 批次9 任务27）：宏内主动报编译错误。置 g_err 上抛，
        // eval_macro/exec 链传播，mexpand 以**调用点**行列号报「宏展开失败:
        // 编译错误: <消息>」——编译错误定位到宏调用点（任务27 验收）。
        if len(args) != 1 {
            g_err = "compile_error 需要一个字符串参数"
            return -1
        }
        if ivalue.type_of(args[0]) != T_STR {
            g_err = "compile_error 需要一个字符串参数"
            return -1
        }
        g_err = "编译错误: " + ivalue.str_val(args[0])
        return -1
    }
    if name == "tokenize" {
        if len(args) != 1 {
            g_err = "tokenize 需要一个字符串参数"
            return -1
        }
        if ivalue.type_of(args[0]) != T_STR {
            g_err = "tokenize 需要一个字符串参数"
            return -1
        }
        var ok = lexer.run_lex(ivalue.str_val(args[0]))
        if !ok {
            g_err = "tokenize 失败: 词法错误 @" + to_string(lexer.lex_err_line()) + ":" +
                to_string(lexer.lex_err_col()) + ": " + lexer.lex_err_msg()
            return -1
        }
        var cnt = lexer.token_count()
        var n: i64 = 0
        var k: i64 = 0
        while k < cnt {
            if lexer.token_tag(k) == lex_eof {
                break
            }
            n = n + 1
            k = k + 1
        }
        var out: string = to_string(n) + ":\n"
        var j: i64 = 0
        while j < n {
            out = out + to_string(lexer.token_tag(j)) + " " +
                escape_token_lexeme(lexer.token_lexeme(j)) + "\n"
            j = j + 1
        }
        return ivalue.new_str(out)
    }
    // deparse：token 流文本 → 源码字符串（逐 token 发射原始拼写，token 间单空格；
    // 反序列化保证 tokenize(deparse(tokenize(s))) == tokenize(s)）。
    if name == "deparse" {
        if len(args) != 1 {
            g_err = "deparse 需要一个 token 流参数"
            return -1
        }
        if ivalue.type_of(args[0]) != T_STR {
            g_err = "deparse 需要一个 token 流参数"
            return -1
        }
        var src = deparse_tokens(ivalue.str_val(args[0]))
        if g_err != "" {
            return -1
        }
        return ivalue.new_str(src)
    }
    if name == "token_len" {
        if len(args) != 1 {
            g_err = "token_len 需要一个 token 流参数"
            return -1
        }
        if ivalue.type_of(args[0]) != T_STR {
            g_err = "token_len 需要一个 token 流参数"
            return -1
        }
        var n = parse_tokens(ivalue.str_val(args[0]))
        if g_err != "" {
            return -1
        }
        return ivalue.new_int(n)
    }
    if name == "token_tag_at" {
        if len(args) != 2 {
            g_err = "token_tag_at 需要 token 流与下标参数"
            return -1
        }
        if ivalue.type_of(args[0]) != T_STR || ivalue.type_of(args[1]) != T_INT {
            g_err = "token_tag_at 需要 token 流与下标参数"
            return -1
        }
        var n = parse_tokens(ivalue.str_val(args[0]))
        if g_err != "" {
            return -1
        }
        var i = ivalue.int_val(args[1])
        if i < 0 || i >= n {
            g_err = "token_tag_at 下标越界：索引 " + to_string(i) + " 超出长度 " + to_string(n)
            return -1
        }
        return ivalue.new_int(g_tk_tags[i])
    }
    if name == "token_lexeme_at" {
        if len(args) != 2 {
            g_err = "token_lexeme_at 需要 token 流与下标参数"
            return -1
        }
        if ivalue.type_of(args[0]) != T_STR || ivalue.type_of(args[1]) != T_INT {
            g_err = "token_lexeme_at 需要 token 流与下标参数"
            return -1
        }
        var n = parse_tokens(ivalue.str_val(args[0]))
        if g_err != "" {
            return -1
        }
        var i = ivalue.int_val(args[1])
        if i < 0 || i >= n {
            g_err = "token_lexeme_at 下标越界：索引 " + to_string(i) + " 超出长度 " + to_string(n)
            return -1
        }
        return ivalue.new_str(g_tk_lexemes[i])
    }
    // tsh 脚本运行时桥（过程/环境/文件；与 is_builtin 同集，直接转发基础原语）
    if name == "get_env" {
        return ivalue.new_str(get_env(ivalue.str_val(args[0])))
    }
    if name == "set_env" {
        set_env(ivalue.str_val(args[0]), ivalue.str_val(args[1]))
        return ivalue.new_bool(true)
    }
    if name == "exec_code" {
        return ivalue.new_int(exec_code(ivalue.str_val(args[0])))
    }
    if name == "exec_output" {
        return ivalue.new_str(exec_output(ivalue.str_val(args[0])))
    }
    if name == "cwd" {
        return ivalue.new_str(cwd())
    }
    if name == "time_now" {
        return ivalue.new_int(time_now())
    }
    if name == "file_read" {
        return ivalue.new_str(file_read(ivalue.str_val(args[0])))
    }
    if name == "file_write" {
        return ivalue.new_bool(file_write(ivalue.str_val(args[0]), ivalue.str_val(args[1])))
    }
    if name == "file_append" {
        // E 裁决：自动补尾换行——内容非空且不以 \n/\r 结尾时补一个 \n
        //（使逐行追加语义稳定；便于脚本 file_read 后按行解析）
        var content = ivalue.str_val(args[1])
        if content != "" {
            var n = str_len(content)
            var lastc = str_char(content, n - 1)
            if lastc != "\n" && lastc != "\r" {
                content = content + "\n"
            }
        }
        return ivalue.new_bool(file_append(ivalue.str_val(args[0]), content))
    }
    if name == "file_exists" {
        return ivalue.new_bool(file_exists(ivalue.str_val(args[0])))
    }
    if name == "path_join" {
        return ivalue.new_str(path_join(ivalue.str_val(args[0]), ivalue.str_val(args[1])))
    }
    if name == "mkdir_all" {
        return ivalue.new_bool(mkdir_all(ivalue.str_val(args[0])))
    }
    if name == "remove_dir_all" {
        return ivalue.new_bool(remove_dir_all(ivalue.str_val(args[0])))
    }
    // ==================== tsh 脚本语义内建（p.9.4 升级） ====================
    // 字符串内建：contains / has_prefix / has_suffix / split_lines / split_char /
    // substr / replace_all / is_empty。
    if name == "contains" {
        if len(args) != 2 || ivalue.type_of(args[0]) != T_STR || ivalue.type_of(args[1]) != T_STR {
            g_err = "contains 需要两个字符串参数（hay, needle）"
            return -1
        }
        return ivalue.new_bool(b_contains(ivalue.str_val(args[0]), ivalue.str_val(args[1])))
    }
    if name == "has_prefix" {
        if len(args) != 2 {
            g_err = "has_prefix 需要两个字符串参数"
            return -1
        }
        return ivalue.new_bool(b_has_prefix(ivalue.str_val(args[0]), ivalue.str_val(args[1])))
    }
    if name == "has_suffix" {
        if len(args) != 2 {
            g_err = "has_suffix 需要两个字符串参数"
            return -1
        }
        return ivalue.new_bool(b_has_suffix(ivalue.str_val(args[0]), ivalue.str_val(args[1])))
    }
    if name == "split_lines" {
        if len(args) != 1 || ivalue.type_of(args[0]) != T_STR {
            g_err = "split_lines 需要一个字符串参数"
            return -1
        }
        return b_lines_to_table(split_content_lines(ivalue.str_val(args[0])))
    }
    if name == "split_char" {
        if len(args) != 2 || ivalue.type_of(args[0]) != T_STR || ivalue.type_of(args[1]) != T_STR {
            g_err = "split_char 需要字符串与分隔符参数"
            return -1
        }
        var c = ivalue.str_val(args[1])
        if str_len(c) != 1 {
            g_err = "split_char 分隔符必须是单字符"
            return -1
        }
        return b_split_char_to_table(ivalue.str_val(args[0]), c)
    }
    if name == "substr" {
        if len(args) != 3 || ivalue.type_of(args[0]) != T_STR ||
            ivalue.type_of(args[1]) != T_INT || ivalue.type_of(args[2]) != T_INT {
            g_err = "substr 需要字符串与两个整数参数（s, start, end）"
            return -1
        }
        var s = ivalue.str_val(args[0])
        var lo = ivalue.int_val(args[1])
        var hi = ivalue.int_val(args[2])
        if lo < 0 { lo = 0 }
        if hi > str_len(s) { hi = str_len(s) }
        if lo >= hi {
            return ivalue.new_str("")
        }
        return ivalue.new_str(b_str_sub(s, lo, hi))
    }
    if name == "replace_all" {
        if len(args) != 3 {
            g_err = "replace_all 需要三个字符串参数（s, old, new）"
            return -1
        }
        return ivalue.new_str(b_replace_all(ivalue.str_val(args[0]),
            ivalue.str_val(args[1]), ivalue.str_val(args[2])))
    }
    if name == "is_empty" {
        if len(args) != 1 {
            g_err = "is_empty 需要一个字符串参数"
            return -1
        }
        return ivalue.new_bool(str_len(ivalue.str_val(args[0])) == 0)
    }
    // 字面 `|` 逃逸（管道分派劫持规避）：返回单字 "|"。
    if name == "pipe_char" {
        if len(args) != 0 {
            g_err = "pipe_char 不需要参数"
            return -1
        }
        return ivalue.new_str("|")
    }
    if name == "path_basename" {
        // 路径末尾段（去反斜杠/斜杠结尾后的最后一段；无分隔 → 原样）
        if len(args) != 1 {
            g_err = "path_basename 需要一个字符串参数"
            return -1
        }
        return ivalue.new_str(b_basename(ivalue.str_val(args[0])))
    }
    // 目录枚举 → table<string>（返回 Value::Table）
    if name == "list_dir" || name == "walk_dir" {
        if len(args) != 1 {
            g_err = name + " 需要一个目录路径参数"
            return -1
        }
        var t = list_dir(ivalue.str_val(args[0]))
        if name == "walk_dir" {
            t = walk_dir(ivalue.str_val(args[0]))
        }
        return b_str_to_table(t)
    }
    // 脚本参数读取（脚本模式下读 rn_run_script 注入的表——跳过 -f <path> 前缀；
    // 非脚本模式回退读进程 argv）
    if name == "arg_count" {
        if script_args_active() {
            return ivalue.new_int(len(script_args()))
        }
        return ivalue.new_int(arg_count())
    }
    if name == "arg_at" {
        if len(args) != 1 || ivalue.type_of(args[0]) != T_INT {
            g_err = "arg_at 需要一个整数下标参数"
            return -1
        }
        var i = ivalue.int_val(args[0])
        if script_args_active() {
            if i < 0 || i >= len(script_args()) {
                return ivalue.new_str("")
            }
            return ivalue.new_str(script_args()[i])
        }
        return ivalue.new_str(arg_string(i))
    }
    // 文件 SHA256（certutil 等价；内部 hex 提取，优先内部实现路径占位）
    if name == "get_file_hash" {
        if len(args) != 1 {
            g_err = "get_file_hash 需要一个文件路径参数"
            return -1
        }
        return ivalue.new_str(b_file_hash(ivalue.str_val(args[0])))
    }
    // 进程超时：解释器无 spawn+terminate 原语（libc system 同步阻塞），当前
    // 退化为同步 exec_code（返回退出码）；OS 级 CreateProcessWait 超时语义待
    // LLVM 后端内联原语接入后补强（诚实裁决，见批注）。
    if name == "exec_code_timeout" {
        if len(args) != 2 {
            g_err = "exec_code_timeout 需要命令字符串与超时毫秒参数"
            return -1
        }
        return ivalue.new_int(exec_code(ivalue.str_val(args[0])))
    }
    // 条件 exit(n)：置退出请求槽，eval_script 循环检测后停止；宿主透传退出码
    if name == "exit" {
        var exit_code: i64 = 0
        if len(args) >= 1 {
            exit_code = ivalue.int_val(args[0])
        }
        g_tsh_exit_req = true
        g_tsh_exit_code = exit_code
        return ivalue.new_void()
    }
    // ---- 批次④确定性内建 ----
    // 确定删除单文件（转发底座 file_delete，内部确定删除；替代 exec del 的 flake）。
    if name == "remove_file" {
        if len(args) != 1 || ivalue.type_of(args[0]) != T_STR {
            g_err = "remove_file 需要一个文件路径参数"
            return -1
        }
        return ivalue.new_bool(file_delete(ivalue.str_val(args[0])))
    }
    // 字符串表按字节序（码点序）升序排序 → 新 Value::Table。
    if name == "sort_strings" {
        if len(args) != 1 || ivalue.type_of(args[0]) != T_TABLE {
            g_err = "sort_strings 需要一个字符串表参数"
            return -1
        }
        return b_sort_strings(args[0])
    }
    // findstr 风格正则命中：s 中匹配则 true。底层走 tie regex 引擎
    //（regex_find 返回命中的子串；非空 = 命中）。pattern 支持 findstr /r
    // 常用子集（. * ^ $ [类]）且为其超集（tie 正则能力更大，文档注明子集）。
    if name == "regex_findstr" {
        if len(args) != 2 || ivalue.type_of(args[0]) != T_STR || ivalue.type_of(args[1]) != T_STR {
            g_err = "regex_findstr 需要两个字符串参数（s, pattern）"
            return -1
        }
        var m = regex_find(ivalue.str_val(args[0]), ivalue.str_val(args[1]))
        return ivalue.new_bool(str_len(m) > 0)
    }
    // 短暂睡眠（libc Sleep 毫秒级，供超时/等待用）。
    if name == "sleep_ms" {
        if len(args) != 1 || ivalue.type_of(args[0]) != T_INT {
            g_err = "sleep_ms 需要一个整数毫秒参数"
            return -1
        }
        if ivalue.int_val(args[0]) > 0 {
            unsafe { Sleep(ivalue.int_val(args[0])) }
        }
        return ivalue.new_void()
    }
    g_err = "内部错误: 未实现的内置函数 '" + name + "'"
    return -1
}

// ---- tsh 字符串/目录/哈希内建辅助（纯文本，无 Value 构造） ----

// 字符串表按字节序（码点序）升序排序 → 新 Value::Table。
// 先读入**局部** string 表（规避 tie-llvm 从 Value 表读串跨调用的缓冲 bug——
// 对齐 value.tie 头注释的"局部表过渡"工作法），局部表内比较/交换安全，排序完
// 再统一重建 Value 表。
func b_sort_strings(tid: i64) -> i64 {
    var cnt = ivalue.elem_count(tid)
    var strs: table<string> = table_new_string()
    var i: i64 = 0
    while i < cnt {
        var e = ivalue.elem_at(tid, i)
        if ivalue.type_of(e) != T_STR {
            g_err = "sort_strings 表必须全为字符串元素"
            return -1
        }
        table_push(strs, ivalue.str_val(e))
        i = i + 1
    }
    // 插入排序（稳定；元素少，O(n²) 可接受）
    var a: i64 = 1
    while a < cnt {
        var key = strs[a]
        var j = a - 1
        while j >= 0 && strs[j] > key {
            strs[j + 1] = strs[j]
            j = j - 1
        }
        strs[j + 1] = key
        a = a + 1
    }
    var nt = ivalue.new_table()
    var k: i64 = 0
    while k < cnt {
        nt = ivalue.table_push_val(nt, ivalue.new_str(strs[k]))
        k = k + 1
    }
    return nt
}

func b_has_prefix(s: string, pre: string) -> bool {
    var n = str_len(s)
    var m = str_len(pre)
    if n < m { return false }
    var i: i64 = 0
    while i < m {
        if str_char(s, i) != str_char(pre, i) { return false }
        i = i + 1
    }
    return true
}

func b_has_suffix(s: string, suf: string) -> bool {
    var n = str_len(s)
    var m = str_len(suf)
    if n < m { return false }
    var i: i64 = 0
    while i < m {
        if str_char(s, n - m + i) != str_char(suf, i) { return false }
        i = i + 1
    }
    return true
}

func b_contains(hay: string, needle: string) -> bool {
    var hn = str_len(hay)
    var nn = str_len(needle)
    if nn == 0 { return true }
    if nn > hn { return false }
    var i: i64 = 0
    var nend = hn - nn + 1
    while i < nend {
        var j: i64 = 0
        var match = true
        while j < nn {
            if str_char(hay, i + j) != str_char(needle, j) { match = false; break }
            j = j + 1
        }
        if match { return true }
        i = i + 1
    }
    return false
}

func b_str_sub(s: string, lo: i64, hi: i64) -> string {
    var out = ""
    var n = str_len(s)
    var end: i64 = hi
    if end > n { end = n }
    var i: i64 = lo
    while i < end {
        out = out + str_char(s, i)
        i = i + 1
    }
    return out
}

func b_str_to_table(t: table<string>) -> i64 {
    var nt = ivalue.new_table()
    var i: i64 = 0
    while i < len(t) {
        nt = ivalue.table_push_val(nt, ivalue.new_str(t[i]))
        i = i + 1
    }
    return nt
}

// 按 '\n' 切行（行尾去 '\r'）。
func split_content_lines(s: string) -> table<string> {
    var out: table<string> = table_new_string()
    var cur = ""
    var n = str_len(s)
    var i: i64 = 0
    while i < n {
        var c = str_char(s, i)
        if c == "\n" {
            table_push(out, trim_cr2(cur))
            cur = ""
        } else {
            cur = cur + c
        }
        i = i + 1
    }
    if cur != "" {
        table_push(out, trim_cr2(cur))
    }
    return out
}

func trim_cr2(s: string) -> string {
    var n = str_len(s)
    if n > 0 && str_char(s, n - 1) == "\r" {
        return b_str_sub(s, 0, n - 1)
    }
    return s
}

func b_lines_to_table(t: table<string>) -> i64 {
    return b_str_to_table(t)
}

// 按单字符切分（保留空段；末段总产出）。
func b_split_char_to_table(s: string, c: string) -> i64 {
    var nt = ivalue.new_table()
    var cur = ""
    var n = str_len(s)
    var i: i64 = 0
    while i < n {
        var ch = str_char(s, i)
        if ch == c {
            nt = ivalue.table_push_val(nt, ivalue.new_str(cur))
            cur = ""
        } else {
            cur = cur + ch
        }
        i = i + 1
    }
    nt = ivalue.table_push_val(nt, ivalue.new_str(cur))
    return nt
}

// 把 s 中所有 old 子串替换为 new（空 old 不替换）。
func b_replace_all(s: string, old: string, new: string) -> string {
    var on = str_len(old)
    if on == 0 {
        return s
    }
    var out = ""
    var i: i64 = 0
    var n = str_len(s)
    while i < n {
        if b_has_prefix(b_str_sub(s, i, n), old) {
            out = out + new
            i = i + on
        } else {
            out = out + str_char(s, i)
            i = i + 1
        }
    }
    return out
}

// 路径末段（去尾部分隔符后的最后一段；形如 Windows 路径）。
func b_basename(s: string) -> string {
    var n = str_len(s)
    var i = n - 1
    while i >= 0 {
        var c = str_char(s, i)
        if c == "/" || c == "\\" {
            return b_str_sub(s, i + 1, n)
        }
        i = i - 1
    }
    return s
}

// certutil SHA256：输出重定向到临时文件 → 读回 → 提取 64-hex（小写）。
func b_file_hash(path: string) -> string {
    var tmp = path + ".tsh.sha256.tmp"
    var rc = exec_code("certutil -hashfile \"" + path + "\" SHA256 > \"" + tmp + "\" 2>nul")
    var txt = ""
    if file_exists(tmp) {
        txt = file_read(tmp)
        file_delete(tmp)
    }
    return b_extract_hex64(txt)
}

// 从文本扫出首个长恰 64 的连续 hex 运行（certutil 哈希行），小写返回。
func b_extract_hex64(txt: string) -> string {
    var run = ""
    var n = str_len(txt)
    var i: i64 = 0
    while i < n {
        var c = str_char(txt, i)
        if b_is_hex(c) {
            run = run + b_lower_hex(c)
            if str_len(run) == 64 {
                return run
            }
        } else {
            run = ""
        }
        i = i + 1
    }
    return ""
}

func b_is_hex(c: string) -> bool {
    if c >= "0" && c <= "9" { return true }
    if c >= "a" && c <= "f" { return true }
    if c >= "A" && c <= "F" { return true }
    return false
}

func b_lower_hex(c: string) -> string {
    if c == "A" { return "a" }
    if c == "B" { return "b" }
    if c == "C" { return "c" }
    if c == "D" { return "d" }
    if c == "E" { return "e" }
    if c == "F" { return "f" }
    return c
}

// 参数值列表 → 打印文本（print/println 共用；to_print_string 无分隔符拼接）。
func join_print(args: table<i64>) -> string {
    var out: string = ""
    var i: i64 = 0
    while i < len(args) {
        out = out + ivalue.to_print_string(args[i])
        i = i + 1
    }
    return out
}

}   // namespace interp