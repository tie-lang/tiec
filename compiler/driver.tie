type tie<logic>
// compiler/driver.tie —— 自举 T3.2：完整 CLI 编译器驱动（tiec 入口）
// ============================================================
// 对齐 Rust crates/tie-llvm/src/main.rs + driver.rs：参数解析、角色分派、
// 消息格式、退出码。组装前端（parse_ast/check_ast，T5.3 内存 AST 版）+ 中端
//（irgen.tig_ast/llvmgen.emit）+ 后端（backend/toolchain.tie）。中端用
// tig_ast()（AST 已由 frontend 就绪，不再二次执行前端；tig_src 由
// driver-lite/_driver_test 使用）。
//
// 用法：tiec <input.tie> [-o <out>] [-l<0-3> -t<0-3>] [--target <三元组>]（p.9.20 双轴优化）
//                    [--emit-ir] [--keep-ir] [--no-warn] [--prep-only] [--config <f>] [--help]
// 退出码：0 成功 / 1 编译失败 / 2 参数错误。
//
// 角色识别：**头部扫描**（`type tie` / `type tie<X>` 声明），不依赖
// prep/core.tie 的 import（避免 import 路径与编译兼容性风险；prep 协议
// 识别 logic/script/class/type/data/ui/db/port/ir/zd/tsh；
// logic/script/class/type → 编译工具链，data → --compress-data 子命令
// （tdzd.tie：表字面量 → zd record），zd → tiedb compact/decompress 处理，
// tsh → 推荐由 tie 自己的 tshell 运行 .tsh.tie 脚本（扩展名 .tsh.tie 预判 +
// `type tie<tsh>` 头部，经 exec_code 调 `tshell -f`，tshell 解析：TSHELL→PATH），
// ui/db/port → 提示对应工具链未实现。zd 是 tie:data 的二进制压缩变体
// （xxx.zd.tie），人类不可读，必须在 file_read（文本读取）之前按文件名
// 预判并直接短接。
//
// opt/target 优先级：CLI 显式 > 头部 `// tie:opt=N` / `// tie:target=` > 默认 O2/无。
import "./backend/irgen.tie"
import "./backend/llvmgen.tie"  // p.9.21 G3：irgen 不再反向 import 后端，改由 driver 装配
import "./backend/toolchain.tie"
import "./config.tie"
// S3.2：tieir 序列化（--tieir-out 输出分发单元 / --dump-irt 读回 dump）
import "./middle/tieir_ser.tie"
// p.9.21.6-2：模块级 tieir 片段（模块化缓存写侧；set_fn_mods + write_mod_slice）
import "./middle/tieir_slice.tie"
import "./middle/tieir_asm.tie"
import "./middle/passes.tie"
// p.9.20：单元头写入 t 档 / pass 管道版本（ir_meta 侧表）
import "./middle/ir_meta.tie"
// td→zd 压缩数据子命令（--compress-data）：表字面量 → DFS 平铺 → zd record
import "./tdzd.tie"
// p.6.9.15 诊断标号：error[E#####]/warning[W#####] 渲染（driver 打印入口）
import "./frontend/diagcode.tie"
// p.9.11.13 #cfg 条件编译预处理（词法前按行裁剪；driver 读文件后、头部扫描/
// 词法之前调用；条件求值源 = --target/配置 target 与 --profile/配置 profile）
import "./frontend/cfg_preproc.tie"
// p.9.15.1 依赖感知缓存：tsha1r 强哈希（import 依赖指纹聚合键 + 产物指纹）
// 注：完整 import std/tsha1 触发编译器自举泛型实例化超限（E00520），改内联极简实现
// p.7.1.1 Keel 骨架接线：driver 真实 pass 登记为注册项，经 Keel 注册表驱动
// 执行管线（import 文本内联；顺序 registry → cli → boot → executor，各文件内部
// 互不 import，依赖经入口 import 链内联可达）。
import "./keel/keel_registry.tie"
// p.7.1.6 CLI 子命令注册化：keel_cli 承载命令登记/查表/描述；boot 依赖
// keelcli（须先于 keel_boot.tie 内经内联可达），故 import 顺序 registry→cli→boot。
import "./keel/keel_cli.tie"
import "./keel/keel_boot.tie"
import "./keel/keel_executor.tie"
import "./driver/util.tie"
import "./driver/cli_args.tie"
import "./driver/role_reg.tie"
// p.9.22 结构化输出（dbgem）：置于 role_reg 之后（sym_wanted 依赖 role_output），
// 先于 front_end/pipeline（两者出口调用 dbgem.*）。
import "./dbug/dbgem.tie"
// p.9.22 tinker：tink 帧协议收发（依赖 dbgem.spec_*；先于 front_end/pipeline 使用者）。
import "./tinker/tinker.tie"
import "./driver/prelude.tie"
import "./driver/front_end.tie"
import "./driver/keelcli.tie"
import "./driver/pipeline.tie"
import "./driver/cache_drv.tie"
// 单编译单元执行体（run_unit / unit_reset）+ 常驻服务（依赖 run_unit）。
// 顺序：unit 先于 serve —— tie 是「先定义后使用」，serve 的编译请求调 run_unit。
import "./driver/unit.tie"
// tink 常驻服务（分析 + 编译请求）：须在 unit 之后（编译请求调 run_unit）。
import "./driver/serve.tie"

// 阶段计时探针（性能诊断）：CRT clock()，毫秒精度。
// 环境变量 TIEC_TIME=1 时输出各阶段耗时（不设则零开销静默）。
unsafe extern fn clock() -> i64;
// p.9.15.4 备注：产物发布争用时要退让，用 kernel32 `Sleep`——但它**已在本单元声明**
// （frontend/mexpand.tie → interp/interp.tie:57，且 interp 注释写明与 ext/spidey、
// ext/gfx 同款）：再声明一次报 E00039「与已有函数重复定义」。故此处不重复声明，
// 直接用；形参按其 `i64` 调用，避免同一符号出现两种推导签名。

// ==================== 全局 ====================
pub var g_input: string = "";
pub var g_output: string = "";        // -o 指定（空 = 默认）
pub var g_llvm_opt: i64 = 2;          // -l LLVM/clang 轴（g_llvm_set 显式时生效；p.9.20 双轴）
pub var g_llvm_set: bool = false;     // 是否显式指定 -l / --llvm-opt
pub var g_tie_opt: i64 = 2;           // -t tiec 中端轴（默认 2；-t0 = 零 pass）
pub var g_tie_set: bool = false;      // 是否显式指定 -t / --tie-opt
// --opt=<0-2>：**强制额外跑** IR 优化（opt）阶段。默认不跑（-l2/-l3 预设）。
// -1 = 未指定（由 -l 预设决定）；>=0 = 强制跑 opt -O<n>。
pub var g_opt_force: i64 = -1;
// 构建模式（--develop / --release 预设）：0 = 未指定，1 = develop，2 = release。
// 只作为"一次性注入一组默认值"的语法糖，显式参数（-t/-l/-w/-Werror）后写覆盖。
pub var g_build_mode: i64 = 0;
pub var g_target: string = "";        // --target（空 = 未指定）
// p.9.1.2 编译资源可调（利好老电脑）：
pub var g_mem_limit: i64 = 0;         // --mem-limit <MB>：内存上限（0 = 不限；>0 时 -O3 受限降为 O2）
pub var g_jobs: i64 = 0;              // --jobs <N>：编译并发度（0 = 默认；预留配置 advanced.threads，并行在 p.9.1.3 增量/缓存一并落地）
// p.9.1.3 编译缓存：
pub var g_no_cache: bool = false;     // --no-cache：关闭编译缓存（产物缓存到缓存目录，命中直接复制）
pub var g_no_warn: bool = false;      // --no-warn：跳过警告检查（不发射/不打印任何 warning[W#####]；错误不受影响）
// --warn-error / -Werror：**有警告即当错误**（退出码非 0），供 CI 与「零警告」纪律使用。
// 隐含打开前端警告检查 -w（否则无警告可数）。判定口径 = 前端结构化警告
// （semantic.warn_count）+ driver 侧直接打印的警告（g_warn_seen，见 driver.warn_render）。
// 与 --no-warn 同族：**后出现者生效**（--no-warn 在后 ⇒ 无警告 ⇒ 门闸自然通过）。
pub var g_warn_error: bool = false;
pub var g_warn_seen: i64 = 0;         // driver 侧（角色/优化档等）已打印的告警条数
pub var g_warn_failed: bool = false;  // 已判定「警告按错误」失败（总结只打印一次）
// p.9.14.2 独立警告 pass：前端警告总开关（默认 false = 默认只报错，警告检查零成本；
// -w 开启、--no-warn 关闭）。驱动 semantic.set_warn_enabled；与 g_no_warn（LLVM 工具链
// 静默 + 角色/优化档降级行为）语义分离——默认只报错只关前端警告检查，不干扰降级逻辑。
pub var g_front_warn: bool = false;
// v3（p.9.21.9 收口）：装配器块操作数映射修正 + 装配路径副作用恢复——
// 旧片段由修正前的装配器语义写出，必须整体失效（盐升格）。
// p.9.15.1：**构建戳**（= 编译器自身身份）。初值由 driver 在 irgen 之后覆写
//（`bake_build_stamp`）：构建 tiec 时，本次编译的源码集**就是 tiec 自身源码集**
// ⇒ 烘进产物的即「tiec 这一版源码的指纹」；运行期读回参与缓存键 ⇒
// **改编译器源码重建后，旧缓存自动失效**，不再依赖手工 bump `g_cache_salt`
//（手工那条留着：它是**显式**失效通道，漏 bump 会静默复用过期产物）。
// ⚠ 为空（旧编译器产物、非自举构建、源码集为空）⇒ 退回手工盐，**不静默**。
pub var g_tiec_build_stamp: string = "";
// p.9.15.1：源码集指纹缓存（惰性算一次，见 driver.source_set_stamp）与「已提示」标志。
pub var g_src_stamp: string = "";
pub var g_ident_warned: bool = false;
// p.9.15.4：进程私有的中间产物路径与前缀（惰性算一次，见 driver.ir_paths_init）。
pub var g_ir_path_g: string = "";
pub var g_opt_path_g: string = "";
pub var g_ir_prefix_g: string = "";
pub var g_ir_lock: string = "";
pub var g_cache_salt: string = "tiec-cache-v14"; // 缓存键盐：编译器输出形态变更（如 optimizer 改动/固定点升格）时递增，强制旧缓存失效（p.9.19.8 遗留补：升格必 bump）；v12：f32 字面量 IR 值 double→float（2026-10-09）；v13：dll 模式 global_ctors 元素补显式类型前缀（LLVM 22 兼容）+ --dll-export（2026-10-14）
// v14（2026-10-18）：str_cat 临时串释放判定跳过名字/文本池槽位（此前池 id 与值 id
// 数值相同时被误判为「还有使用」⇒ 该释放的不释放，且随无关字符串计数翻面）。
// v10（2026-10-06）：越界/除零检查改为**常开**（原先默认关）⇒ 不带显式标志时的产物形态改变，
// 旧缓存（v9）产出的机器码与当前语义不符，必须整体失效。
pub var g_emit_ir: bool = false;
pub var g_keep_ir: bool = false;
pub var g_cli_fast_math: bool = false;    // --ffast-math：训练性能优先（编译产物启用 fast-math，默认关）
pub var g_cli_check_bounds: bool = false; // --check-bounds：幂等显式声明（检查恒开，见 driver 接线处）
pub var g_cli_esc_audit: bool = false;    // --esc-audit：打印独占免锁判定（审计用，默认关）
// --visibility=<档>：可见性梯度（p.9.21.4 II1）。0=A1a 全开放 1=A1b ns 级私有
// （默认 = 历史行为，不传旗标的编译语义逐字节不变）2=A1c 包级 3=A1d 全私有。
pub var g_cli_visibility: i64 = 1;
pub var g_prep_only: bool = false;
pub var g_compress_data: bool = false;  // --compress-data：td → zd 压缩数据
pub var g_lsp: bool = false;            // --lsp：启动 tie 语言服务器（tsp.exe）
// M5 动态库模式（dev33 批次 12）：--shared 或输出扩展名 .dll/.so → 动态库。
pub var g_shared: bool = false;
pub var g_role: string = "";          // 头部识别的角色
// S3.1 构建配置：--config 显式路径（空 = 默认 config.data.tie）+ CLI --profile
pub var g_config_path: string = "";   // --config <f> 指定（空 = 当前目录 config.data.tie）
pub var g_cli_profile: string = "";   // --profile <p> 指定（空 = config 顶层 profile 键）
pub var g_cfg_root: i64 = 0;          // 分层合并后的配置根节点（load_merge 结果；tie 全局 var 显式初值不生效，用 g_cfg_loaded 标记已加载）
pub var g_cfg_loaded: bool = false;   // 构建配置是否已加载（预加载/后段共用，防重复解析）
// S3.4 自定义角色注册表（config.data.tie roles 段，分层合并后提取）
pub var t_cr_name: table<string>;     // 自定义角色名（平行表）
pub var t_cr_kind: table<i64>;        // 1=基础角色 0=修饰角色
pub var t_cr_out: table<string>;      // 基础角色输出管线：lib/check/exe（修饰占位空串）
pub var t_cr_p_base: table<string>;   // 基础角色扩展参数对（base ↔ param）
pub var t_cr_p_val: table<string>;
pub var g_backend_cli: string = "";   // --backend <b> 指定（空 = 配置 tiec.backend）
// p.9.13.7-B 内置库零副本：--lib-root <dir> 显式指定库根（优先级最高，
// 覆盖 TIE_LIB_ROOT 环境变量与默认 ~/.tiec-lib/tlib；空 = 未指定）。
pub var g_lib_root_cli: string = "";
// --dll-export <names>：动态库导出白名单（逗号分隔的导出名，如 tiel$check；
// 空 = 不过滤——全部顶层函数与 ns pub 照常导出，既有行为逐字节不变）。
pub var g_dll_export_cli: string = "";
// S3.2：tieir 分发（--tieir-out <f> 编译后序列化 .tir；--dump-irt <f> 只读 dump）
pub var g_tieir_out: string = "";     // --tieir-out 指定（空 = 不输出 .tir）
pub var g_dump_irt: string = "";      // --dump-irt <f> 指定（空 = 不 dump）
// p.9.11.29：--dump-docs 短路——解析输入源码后输出 doc 注释注册表摘要
pub var g_dump_docs: bool = false;
// p.9.22 结构化输出：--emit <stage>:<fmt> 规格（可重复；"stage:fmt" 原样存放）
pub var g_emit_specs: table<string>;
// p.9.22.1：--emit-only——只 dump 不继续编译（前端跑完即停，不产后端产物）
pub var g_emit_only: bool = false;
// p.9.22.7：--no-sym——关闭 library/class 默认伴生 .sym.zd
pub var g_no_sym: bool = false;
// p.9.22.9+：tinker 收发（stdout 帧流 / stdin 帧流 / 帧文件 / 落盘目录）
pub var g_tink: bool = false;
pub var g_tink_in: bool = false;
pub var g_tink_file: string = "";
pub var g_tink_in_file: string = "";
pub var g_tink_save: string = "";
// tink 常驻服务（见 driver/serve.tie）：两种角色，各自独占进程
//   --tink-serve     role=1 分析（只接 op=1）
//   --serve-compile  role=2 编译（只接 op=2；落盘 + spawn clang/link）
pub var g_tink_serve: bool = false;
pub var g_serve_compile: bool = false;
// 常驻服务·编译请求的人读文本捕获缓冲（dbg_txt 在 g_svc_cap_on 时改写入此；
// 由 serve.sv_compile 每请求清空并随 done 帧回传）。
pub var g_svc_cap: string = "";
pub var g_svc_cap_on: bool = false;
// p.7.3.3：trm 目标（路线 B 可插拔后端）——--target=trm / --backend trm
pub var g_trm_mode: bool = false;     // 已请求 trm 字节码目标（默认关闭，不捆绑）
pub var g_trm_pipeline: i64 = 0;      // trm 管线注册项 id（keel_driver_boot 填充）

// ==================== 参数解析 ====================

// ==================== 头部扫描（文件类型声明） ====================

// ---------- S1.4 R2/R3 多角色解析（driver 侧，与 prep/core.tie 同规则） ----------
pub var g_role_param: string = "";           // 基础角色参数（如 db:vector 的 vector）
pub var g_role_mods: table<string>;          // 修饰角色（unsafe/owned/embedded）
pub var g_role_base: string = "";            // 解析中间结果：基础角色
pub var g_role_err: string = "";             // 解析错误消息（空 = 成功）

// ---------- 角色注册表（插件化：内建默认表 + config/项目/依赖包合并） ----------
// 角色体系数据驱动：内建角色与"包定制角色"同一样式存于注册表，
// 编译器只读表做校验与管线分派（output: lib|check|exe|pass）。
// 合并顺序（先注册者优先，重名 = 警告并忽略）：
//   内建默认表 → config.data.tie roles 段（S3.4 旧注册方式，兼容）
//   → 项目 roles.data.tie → .tie/deps/*/roles.data.tie（安装依赖包）

// 角色注册引导：默认表 → config roles → 项目/依赖包。src_dir 为源码目录。
pub var g_roles_booted: bool = false;   // 角色注册是否已完成（防重复引导）
// ---------------- 角色查询（全部查注册表） ----------------

// ==================== 前端 ====================

// 前端：词法/语法（parser.parse_ast，AST 留内存）→ 语义+import（semantic.check_ast）。
// 返回 0 成功；失败打印错误并返回 -1。
// 阶段计时（TIEC_TIME=1 时输出）：词法/语法与语义分开计量。
pub var g_t_parse: i64 = 0;   // parse_ast 耗时（ms）
pub var g_t_sem: i64 = 0;     // check_ast 耗时（ms）
// ==================== 主流程 ====================

// ==================== p.7.1.6 CLI 子命令注册化分派（driver 侧） ====================
// tie 工具链 `tie <子命令>` 层按 keelcli 注册表分派（设计稿 §3）：boot 已登记
// cli:pack/cli:verify/... 等；本层查表并 switch 到实际处理函数。**边界**：tiec
// 自身参数（-o/-O/--emit-ir/--target/...）不是子命令，保持既有语义逐字节不变；
// 本层为**新增能力**——仅当首个参数 token 恰好命中已登记 cli:xxx 时触发子命令
// 分派，否则原样回退到既有 tiec 参数路径（正常 `tiec <文件>` 的 token 非任何
// cli 子命令 → 不受影响）。未登记命令在 switch default 报"未知命令"。

// 入口：解析参数 → 读文件 → 头部扫描 → 角色分派。返回退出码。
func main() -> i64 {
    // p.7.1.6 tie 工具链 CLI 子命令注册化：先就绪 CLI 注册表（幂等、轻量；
    // 独立于 boot 的 pass/pipeline 登记，因子命令分派须先于编译引导可用），
    // 命中已登记 cli:xxx 时走注册表分派；否则原样走既有 tiec 参数解析（token
    // 非任何 cli 子命令 → 零行为变化）。
    keelboot.register_cli()
    // p.7.2.5 registry 客户端：登记 `tie pkg`（publish|info|versions 子命令路由，
    // 见 keelcli_pkg_handle；实际三操作驻 keel_registry_cli.tie 模块，探针验证）。
    keelcli.register("cli:pkg", "包注册中心客户端：tie pkg publish|info|versions（p.7.2.5）")
    if driver.keelcli_is_subcmd() == 1 {
        return driver.keelcli_handle(arg_string(0))
    }
    var pr = driver.parse_args()
    if pr == 2 {
        return driver.usage()
    }
    if pr < 0 {
        dbg_txt(diagcode.render_error(-1, -1, "参数错误。输入 tiec --help 查看用法。"))
        return 2
    }
    // p.9.22.9 tinker 接收入口（--tink-in / --tink-in-file）：编译前先消费输入帧。
    // 拒帧（CRC/长度/信封非法）→ 本进程以非 0 退出（不静默传递损坏数据）。
    if g_tink_in || str_len(g_tink_in_file) > 0 {
        var rrc = tinker.run_recv()
        if rrc != 0 {
            return rrc
        }
    }
    // tink 常驻服务：分析（--tink-serve，tsp/LSP 用）与编译（--serve-compile，
    // 构建驱动用）是**两个角色、两个进程**——编译会 spawn clang/link 且内部 panic
    // 走 exit(1)，与编辑器服务同进程会把故障与延迟一起传染过去。
    if g_tink_serve {
        return driver.run_serve()
    }
    if g_serve_compile {
        return driver.run_compile_serve()
    }
    // 单编译单元执行体（服务模式同源；见 driver/unit.tie）
    return driver.run_unit()
}


// p.7.1.1 Keel 接线：真实 pass 间传参载体（front 段输入；原 compile_program
// 的 src/base_dir 局部改用独立命名的全局，使 kpass_* 无参签名可与骨架 pass
// 槽一致）。注意不可复用前端的 g_src（lex_state，词法切片用）以免误改其语义。
pub var k_g_src: string = "";
pub var k_g_base_dir: string = "";
// 编译工具链（logic / library）：前端 → 中端 → 后端。
// 阶段计时（TIEC_TIME=1）：irgen / emit / 写盘分开计量。
pub var g_t_irgen: i64 = 0;   // irgen.tig_ast 耗时（ms）
pub var g_t_emit: i64 = 0;    // llvmgen.emit 耗时（ms）
pub var g_t_write: i64 = 0;   // file_write 耗时（ms）
// p.9.21.9 收口：装配路径副作用恢复的失败原因（driver/pipeline.tie 的
// asm_side_recover 写入；降级全量时打印）。全局变量按约定留在主文件。
pub var asm_recover_err: string = "";

// ==================== Keel 真实 pass 实现（kpass_*） ====================
// 签名统一 fn() -> i64，0 成功 / 非 0 失败；内部即原 compile_program 各
// 段逻辑（行为逐字节等价）。经 keelreg 登记（impl_name = "kpass_*"），由
// driver 侧 keel 分派驱动（见 keel_dispatch / keel_run_pipeline）。

// ==================== Keel driver 引导 + 分派 + 执行 ====================
// Keel 原则「一切行为皆为注册项」：driver 真实组件登记为注册项（新增
// tiec::pass_*_real / tiec::pipeline_real），执行顺序从 keelreg 注册表读取。
// 注：pass 实现驻留 driver，而 keel_executor 需被 tests/_p711_probe/
// keel_probe.tie 独立编译（只 import 三个 keel 文件、不含 driver），故调度
// switch（C1 分派到 driver 真实函数）只能落位在 driver 侧——这是 tie「未
// 定义函数 = E00413 编译错」约束下的唯一等价接法；Keel 注册表仍为管线形态
// 的唯一数据源（executor 的 run_pipeline_prefix 即本接线在骨架层的对应扩展）。

// ==================== p.9.1.3 编译缓存 ====================
// 缓存键 = 输入源码哈希 + 全部输出相关参数（优化档/目标/输出路径/角色/共享/
// emit-ir）+ 编译器形态盐（g_cache_salt）。命中：从缓存目录复制产物到目标路径，
// 跳过编译管线；--no-cache 关闭。缓存目录：config cache.dir；缺省 ~/.tiec-cache。

// ==================== p.9.15.1 依赖感知缓存 ====================
// 修复 p.9.1.3 缓存键缺陷：旧键只哈希入口源码（import 未展开），改任一
// import/using 依赖文件缓存不失效 → 返回陈旧产物。新键聚合「入口 + 全部
// import 递归依赖」的 tsha1r 指纹，任一依赖变化即得新键；命中时 .dep 清单
// 逐文件复核磁盘指纹兜底。强哈希 tsha1r 取代弱 str_hash（碰撞免疫）。

// ==================== 字符串/路径工具（零依赖） ====================

// 从文件名推断角色（S1.4 F1 连字符格式）：`xxx.<基础>[-<参数>][-<修饰>...].tie`
// → 基础角色（分派用）。参数/修饰写入 g_name_param / g_name_mods（一致性
// 检查用）。无角色段返回空串。
pub var g_name_param: string = "";
pub var g_name_mods: table<string>;
// ==================== M5 动态库模式工具（dev33 批次 12） ====================
