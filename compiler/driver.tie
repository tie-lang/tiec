type tie<logic>
// compiler/driver.tie —— 自举 T3.2：完整 CLI 编译器驱动（tiec 入口）
// ============================================================
// 对齐 Rust crates/tie-llvm/src/main.rs + driver.rs：参数解析、角色分派、
// 消息格式、退出码。组装前端（parse_ast/check_ast，T5.3 内存 AST 版）+ 中端
//（irgen.tig_ast/llvmgen.emit）+ 后端（backend/toolchain.tie）。中端用
// tig_ast()（AST 已由 frontend 就绪，不再二次执行前端；tig_src 由
// driver-lite/_driver_test 使用）。
//
// 用法：tiec <input.tie> [-o <out>] [-l<0-3> -t<0-3>] [--target <三元组>]（p.9.20 双轴优化）
//                    [--emit-ir] [--keep-ir] [--no-warn] [--prep-only] [--config <f>] [--help]
// 退出码：0 成功 / 1 编译失败 / 2 参数错误。
//
// 角色识别：**头部扫描**（`type tie` / `type tie<X>` 声明），不依赖
// prep/core.tie 的 import（避免 import 路径与编译兼容性风险；prep 协议
// 识别 logic/script/class/type/data/ui/db/port/ir/zd/tsh；
// logic/script/class/type → 编译工具链，data → --compress-data 子命令
// （tdzd.tie：表字面量 → zd record），zd → tiedb compact/decompress 处理，
// tsh → 推荐由 tie 自己的 tshell 运行 .tsh.tie 脚本（扩展名 .tsh.tie 预判 +
// `type tie<tsh>` 头部，经 exec_code 调 `tshell -f`，tshell 解析：TSHELL→PATH），
// ui/db/port → 提示对应工具链未实现。zd 是 tie:data 的二进制压缩变体
// （xxx.zd.tie），人类不可读，必须在 file_read（文本读取）之前按文件名
// 预判并直接短接。
//
// opt/target 优先级：CLI 显式 > 头部 `// tie:opt=N` / `// tie:target=` > 默认 O2/无。
import "./backend/irgen.tie"
import "./backend/llvmgen.tie"  // p.9.21 G3：irgen 不再反向 import 后端，改由 driver 装配
import "./backend/toolchain.tie"
import "./config.tie"
// S3.2：tieir 序列化（--tieir-out 输出分发单元 / --dump-irt 读回 dump）
import "./middle/tieir_ser.tie"
// p.9.21.6-2：模块级 tieir 片段（模块化缓存写侧；set_fn_mods + write_mod_slice）
import "./middle/tieir_slice.tie"
import "./middle/tieir_asm.tie"
import "./middle/passes.tie"
// p.9.20：单元头写入 t 档 / pass 管道版本（ir_meta 侧表）
import "./middle/ir_meta.tie"
// td→zd 压缩数据子命令（--compress-data）：表字面量 → DFS 平铺 → zd record
import "./tdzd.tie"
// p.6.9.15 诊断标号：error[E#####]/warning[W#####] 渲染（driver 打印入口）
import "./frontend/diagcode.tie"
// p.9.11.13 #cfg 条件编译预处理（词法前按行裁剪；driver 读文件后、头部扫描/
// 词法之前调用；条件求值源 = --target/配置 target 与 --profile/配置 profile）
import "./frontend/cfg_preproc.tie"
// p.9.15.1 依赖感知缓存：tsha1r 强哈希（import 依赖指纹聚合键 + 产物指纹）
// 注：完整 import std/tsha1 触发编译器自举泛型实例化超限（E00520），改内联极简实现
// p.7.1.1 Keel 骨架接线：driver 真实 pass 登记为注册项，经 Keel 注册表驱动
// 执行管线（import 文本内联；顺序 registry → cli → boot → executor，各文件内部
// 互不 import，依赖经入口 import 链内联可达）。
import "./keel/keel_registry.tie"
// p.7.1.6 CLI 子命令注册化：keel_cli 承载命令登记/查表/描述；boot 依赖
// keelcli（须先于 keel_boot.tie 内经内联可达），故 import 顺序 registry→cli→boot。
import "./keel/keel_cli.tie"
import "./keel/keel_boot.tie"
import "./keel/keel_executor.tie"
import "./driver/util.tie"
import "./driver/cli_args.tie"
import "./driver/role_reg.tie"
import "./driver/front_end.tie"
import "./driver/keelcli.tie"
import "./driver/pipeline.tie"
import "./driver/cache_drv.tie"

// 阶段计时探针（性能诊断）：CRT clock()，毫秒精度。
// 环境变量 TIEC_TIME=1 时输出各阶段耗时（不设则零开销静默）。
unsafe extern fn clock() -> i64;

// ==================== 全局 ====================
var g_input: string = "";
var g_output: string = "";        // -o 指定（空 = 默认）
var g_llvm_opt: i64 = 2;          // -l LLVM/clang 轴（g_llvm_set 显式时生效；p.9.20 双轴）
var g_llvm_set: bool = false;     // 是否显式指定 -l / --llvm-opt
var g_tie_opt: i64 = 0;           // -t tiec 中端轴（0 = 零 pass；p.9.20）
var g_tie_set: bool = false;      // 是否显式指定 -t / --tie-opt
var g_target: string = "";        // --target（空 = 未指定）
// p.9.1.2 编译资源可调（利好老电脑）：
var g_mem_limit: i64 = 0;         // --mem-limit <MB>：内存上限（0 = 不限；>0 时 -O3 受限降为 O2）
var g_jobs: i64 = 0;              // --jobs <N>：编译并发度（0 = 默认；预留配置 advanced.threads，并行在 p.9.1.3 增量/缓存一并落地）
// p.9.1.3 编译缓存：
var g_no_cache: bool = false;     // --no-cache：关闭编译缓存（产物缓存到缓存目录，命中直接复制）
var g_no_warn: bool = false;      // --no-warn：跳过警告检查（不发射/不打印任何 warning[W#####]；错误不受影响）
// p.9.14.2 独立警告 pass：前端警告总开关（默认 false = 默认只报错，警告检查零成本；
// -w 开启、--no-warn 关闭）。驱动 semantic.set_warn_enabled；与 g_no_warn（LLVM 工具链
// 静默 + 角色/优化档降级行为）语义分离——默认只报错只关前端警告检查，不干扰降级逻辑。
var g_front_warn: bool = false;
// v3（p.9.21.9 收口）：装配器块操作数映射修正 + 装配路径副作用恢复——
// 旧片段由修正前的装配器语义写出，必须整体失效（盐升格）。
var g_cache_salt: string = "tiec-cache-v8";  // 缓存键盐：编译器输出形态变更（如 optimizer 改动/固定点升格）时递增，强制旧缓存失效（p.9.19.8 遗留补：升格必 bump）
var g_emit_ir: bool = false;
var g_keep_ir: bool = false;
var g_cli_fast_math: bool = false;    // --ffast-math：训练性能优先（编译产物启用 fast-math，默认关）
var g_cli_check_bounds: bool = false; // --check-bounds：调试期数组越界检查（默认关）
// --visibility=<档>：可见性梯度（p.9.21.4 II1）。0=A1a 全开放 1=A1b ns 级私有
// （默认 = 历史行为，不传旗标的编译语义逐字节不变）2=A1c 包级 3=A1d 全私有。
var g_cli_visibility: i64 = 1;
var g_prep_only: bool = false;
var g_compress_data: bool = false;  // --compress-data：td → zd 压缩数据
var g_lsp: bool = false;            // --lsp：启动 tie 语言服务器（tsp.exe）
// M5 动态库模式（dev33 批次 12）：--shared 或输出扩展名 .dll/.so → 动态库。
var g_shared: bool = false;
var g_role: string = "";          // 头部识别的角色
// S3.1 构建配置：--config 显式路径（空 = 默认 config.data.tie）+ CLI --profile
var g_config_path: string = "";   // --config <f> 指定（空 = 当前目录 config.data.tie）
var g_cli_profile: string = "";   // --profile <p> 指定（空 = config 顶层 profile 键）
var g_cfg_root: i64 = 0;          // 分层合并后的配置根节点（load_merge 结果；tie 全局 var 显式初值不生效，用 g_cfg_loaded 标记已加载）
var g_cfg_loaded: bool = false;   // 构建配置是否已加载（预加载/后段共用，防重复解析）
// S3.4 自定义角色注册表（config.data.tie roles 段，分层合并后提取）
var t_cr_name: table<string>;     // 自定义角色名（平行表）
var t_cr_kind: table<i64>;        // 1=基础角色 0=修饰角色
var t_cr_out: table<string>;      // 基础角色输出管线：lib/check/exe（修饰占位空串）
var t_cr_p_base: table<string>;   // 基础角色扩展参数对（base ↔ param）
var t_cr_p_val: table<string>;
var g_backend_cli: string = "";   // --backend <b> 指定（空 = 配置 tiec.backend）
// p.9.13.7-B 内置库零副本：--lib-root <dir> 显式指定库根（优先级最高，
// 覆盖 TIE_LIB_ROOT 环境变量与默认 ~/.tiec-lib/tlib；空 = 未指定）。
var g_lib_root_cli: string = "";
// S3.2：tieir 分发（--tieir-out <f> 编译后序列化 .tir；--dump-irt <f> 只读 dump）
var g_tieir_out: string = "";     // --tieir-out 指定（空 = 不输出 .tir）
var g_dump_irt: string = "";      // --dump-irt <f> 指定（空 = 不 dump）
// p.9.11.29：--dump-docs 短路——解析输入源码后输出 doc 注释注册表摘要
var g_dump_docs: bool = false;
// p.7.3.3：trm 目标（路线 B 可插拔后端）——--target=trm / --backend trm
var g_trm_mode: bool = false;     // 已请求 trm 字节码目标（默认关闭，不捆绑）
var g_trm_pipeline: i64 = 0;      // trm 管线注册项 id（keel_driver_boot 填充）

// ==================== 参数解析 ====================

// ==================== 头部扫描（文件类型声明） ====================

// ---------- S1.4 R2/R3 多角色解析（driver 侧，与 prep/core.tie 同规则） ----------
var g_role_param: string = "";           // 基础角色参数（如 db:vector 的 vector）
var g_role_mods: table<string>;          // 修饰角色（unsafe/owned/embedded）
var g_role_base: string = "";            // 解析中间结果：基础角色
var g_role_err: string = "";             // 解析错误消息（空 = 成功）

// ---------- 角色注册表（插件化：内建默认表 + config/项目/依赖包合并） ----------
// 角色体系数据驱动：内建角色与"包定制角色"同一样式存于注册表，
// 编译器只读表做校验与管线分派（output: lib|check|exe|pass）。
// 合并顺序（先注册者优先，重名 = 警告并忽略）：
//   内建默认表 → config.data.tie roles 段（S3.4 旧注册方式，兼容）
//   → 项目 roles.data.tie → .tie/deps/*/roles.data.tie（安装依赖包）

// 角色注册引导：默认表 → config roles → 项目/依赖包。src_dir 为源码目录。
var g_roles_booted: bool = false;   // 角色注册是否已完成（防重复引导）
// ---------------- 角色查询（全部查注册表） ----------------

// ==================== 前端 ====================

// 前端：词法/语法（parser.parse_ast，AST 留内存）→ 语义+import（semantic.check_ast）。
// 返回 0 成功；失败打印错误并返回 -1。
// 阶段计时（TIEC_TIME=1 时输出）：词法/语法与语义分开计量。
var g_t_parse: i64 = 0;   // parse_ast 耗时（ms）
var g_t_sem: i64 = 0;     // check_ast 耗时（ms）
// ==================== 主流程 ====================

// ==================== p.7.1.6 CLI 子命令注册化分派（driver 侧） ====================
// tie 工具链 `tie <子命令>` 层按 keelcli 注册表分派（设计稿 §3）：boot 已登记
// cli:pack/cli:verify/... 等；本层查表并 switch 到实际处理函数。**边界**：tiec
// 自身参数（-o/-O/--emit-ir/--target/...）不是子命令，保持既有语义逐字节不变；
// 本层为**新增能力**——仅当首个参数 token 恰好命中已登记 cli:xxx 时触发子命令
// 分派，否则原样回退到既有 tiec 参数路径（正常 `tiec <文件>` 的 token 非任何
// cli 子命令 → 不受影响）。未登记命令在 switch default 报"未知命令"。

// 入口：解析参数 → 读文件 → 头部扫描 → 角色分派。返回退出码。
func main() -> i64 {
    // p.7.1.6 tie 工具链 CLI 子命令注册化：先就绪 CLI 注册表（幂等、轻量；
    // 独立于 boot 的 pass/pipeline 登记，因子命令分派须先于编译引导可用），
    // 命中已登记 cli:xxx 时走注册表分派；否则原样走既有 tiec 参数解析（token
    // 非任何 cli 子命令 → 零行为变化）。
    keelboot.register_cli()
    // p.7.2.5 registry 客户端：登记 `tie pkg`（publish|info|versions 子命令路由，
    // 见 keelcli_pkg_handle；实际三操作驻 keel_registry_cli.tie 模块，探针验证）。
    keelcli.register("cli:pkg", "包注册中心客户端：tie pkg publish|info|versions（p.7.2.5）")
    if driver.keelcli_is_subcmd() == 1 {
        return driver.keelcli_handle(arg_string(0))
    }
    var pr = driver.parse_args()
    if pr == 2 {
        return driver.usage()
    }
    if pr < 0 {
        println(diagcode.render_error(-1, -1, "参数错误。输入 tiec --help 查看用法。"))
        return 2
    }
    // S1.4：两个可选开关接线——--check-bounds → irgen（越界检查），--ffast-math → 后端工具链。
    irgen.set_check_bounds(g_cli_check_bounds)
    // p.9.20.5 tail call：t>=1 启用文本级 tail 提示（t0 保持不动点基线）
    llvmgen.set_tail_enable(driver.effective_tie_opt() >= 1 ? 1 : 0)
    tc.set_fast_math(g_cli_fast_math)
    tc.set_no_warn(g_no_warn)
    // p.9.13.7-B：CLI 显式库根（--lib-root）注入前端 import 解析。
    if str_len(g_lib_root_cli) > 0 {
        semantic.set_lib_root(g_lib_root_cli)
    }
    // --lsp：启动 tie 语言服务器（compiler/lsp/tsp.exe，LSP over stdio）。
    // stdio 继承当前进程（vscode-languageclient spawn `tie --lsp` 即与之直连），
    // exec_code 阻塞直至 tsp 退出（Exit 消息），退出码透传。
    if g_lsp {
        var tsp_path = ""
        if file_exists("compiler/lsp/tsp.exe") {
            tsp_path = "compiler/lsp/tsp.exe"
        } else if file_exists("lsp/tsp.exe") {
            tsp_path = "lsp/tsp.exe"
        }
        if str_len(tsp_path) == 0 {
            println("tsp 未找到：请先构建 compiler/lsp/server.tie → compiler/lsp/tsp.exe")
            return 1
        }
        return exec_code(tsp_path)
    }
    // S3.2：--dump-irt 短路——只读 .tir 输出可读摘要（不编译）
    if str_len(g_dump_irt) > 0 {
        var drc = tieir.read(g_dump_irt)
        if drc != 0 {
            println(diagcode.render_error(-1, -1, "tieir 读取失败: " + tieir.err_msg()))
            return 1
        }
        print(tieir.dump_text())
        return 0
    }
    // 读源码
    if !file_exists(g_input) {
        println("读取源码失败: " + g_input)
        return 1
    }
    // --compress-data：td → zd 压缩数据（表字面量 → DFS 平铺 → zd record）。
    // 短接普通编译管线；输出缺省 = 输入名 + ".zd"。
    if g_compress_data {
        var outp: string = g_output
        if str_len(outp) == 0 {
            outp = g_input + ".zd"
        }
        if tdzd.compress_data(g_input, outp) {
            println("[compress-data] " + g_input + " -> " + outp)
            return 0
        }
        println(diagcode.render_error(-1, -1, "compress-data 失败: " + tdzd.err_msg()))
        return 1
    }
    // zd 二进制预判：xxx.zd.tie 是二进制文件（压缩的 tie:data），人类不可读，
    // 必须在 file_read（文本读取）之前按文件名后缀预判并直接短接——二进制
    // 内容文本解码必然失败/乱码。zd 文件由 tiedb compact/decompress 原语处理。
    var zd_len: i64 = str_len(g_input)
    if zd_len >= 7 && slice(str.clone(g_input), zd_len - 7, zd_len) == ".zd.tie" {
        println("[预处理] 识别为 zd 压缩数据文件（头: " + g_input + "），tie:data 压缩格式，用 tiedb compact/decompress 处理")
        return 0
    }
    // tsh 脚本预判：xxx.tsh.tie 是可读文本的 shell 脚本（由 tie 自己的 tshell
    // 运行）。不短接（须走 file_read + 头部扫描验证 type tie<tsh>）；此处按扩展名
    // 预写角色，保证在头部缺失/不一致时仍按 tsh 分派，也满足 R3 文件名-头部一致性。
    var tsh_len: i64 = str_len(g_input)
    if tsh_len >= 8 && slice(str.clone(g_input), tsh_len - 8, tsh_len) == ".tsh.tie" {
        g_role = "tsh"
    }
    var src = file_read(g_input)
    if str_len(src) == 0 {
        println("读取源码失败: " + g_input)
        return 1
    }
    // p.9.11.29：--dump-docs 短路——解析后输出 doc 注释注册表摘要（不编译）
    if g_dump_docs {
        if parser.parse_ast(src) < 0 {
            println(diagcode.render_err_proto(parser.ast_err_protocol()))
            return 1
        }
        print(pstmt_top.pdoc_dump())
        return 0
    }
    // S3.4：自定义角色注册表需先于头部扫描可用（config.data.tie roles 段）。 
    // 分层合并：无配置文件时返回内置默认根；config 语法错误 → 报错退出。
    if !g_cfg_loaded {
        g_cfg_root = config.load_merge(g_config_path, g_cli_profile)
        if g_cfg_root < 0 {
            println("构建配置加载失败: " + config.err_msg())
            return 1
        }
        g_cfg_loaded = true
    }
    // 角色注册引导：内建默认表 → config roles → 项目 roles.data.tie
    // → .tie/deps/*/roles.data.tie（包定制角色 = 纯数据声明，不扩展加载器）
    driver.role_registry_boot(base_dir_of(str.clone(g_input)))
    // p.9.11.13 #cfg 条件编译预处理：词法前按行裁剪（#cfg/#else/#end/#endif）。
    // 必须在头部扫描（scan_header）之前——否则 #cfg 行会被当成头部首个非声明
    // 内容终止角色识别；裁剪后源码再走 scan_header + strip_type_header。
    // 条件求值源：--target > 配置 target > 主机（os/target 键）；生效 profile
    // （--profile > 配置顶层 profile 键，dev=debug / release=release）。
    var cfg_target = driver.normalize_target(g_target)
    if str_len(cfg_target) == 0 {
        if g_cfg_root >= 0 {
            cfg_target = driver.normalize_target(config.get_str(g_cfg_root, "target"))
        }
    }
    var cfg_profile = g_cli_profile
    if str_len(cfg_profile) == 0 {
        if g_cfg_root >= 0 {
            cfg_profile = config.get_str(g_cfg_root, "profile")
        }
    }
    var pruned = cfgpre.preprocess(src, cfg_target, cfg_profile)
    if has_prefix(str.clone(pruned), "ERR:") {
        println(diagcode.render_err_proto(pruned))
        return 1
    }
    src = pruned
    // 头部扫描（文件类型声明 / 角色）
    if driver.scan_header(str.clone(src)) < 0 {
        return 1
    }
    // 剥离头部声明行（`type tie` / `type tie<X>` 是真语法行，须从正文移除；
    // 旧 `// tie:` 是注释由 lexer 跳过，无需处理）
    var clean = strip_type_header(src)
    // S1.4 R3 文件名-头部一致性检查（F1）：`xxx.<基础>[-<参数>][-<修饰>...].tie`
    // 与头部声明不一致 = 编译错误（单一真相，升级自现状警告）。
    var fname = file_name_of(str.clone(g_input))
    var name_role = role_from_filename(fname)
    if str_len(name_role) > 0 {
        var mismatch: string = ""
        if name_role != g_role {
            mismatch = "基础角色不一致: 文件名 '" + name_role + "' vs 头部 '" + g_role + "'"
        } else if str_len(g_name_param) > 0 && g_name_param != g_role_param {
            mismatch = "角色参数不一致: 文件名 '" + g_name_param + "' vs 头部 '" + g_role_param + "'"
        } else {
            // 修饰角色集合比较（顺序无关）
            var k2: i64 = 0
            while k2 < len(g_name_mods) {
                var found2 = false
                var j2: i64 = 0
                while j2 < len(g_role_mods) {
                    if g_role_mods[j2] == g_name_mods[k2] {
                        found2 = true
                        break
                    }
                    j2 = j2 + 1
                }
                if !found2 {
                    mismatch = "修饰角色不一致: 文件名含 '" + g_name_mods[k2] + "'，头部未声明"
                    break
                }
                k2 = k2 + 1
            }
        }
        if str_len(mismatch) > 0 {
            println(diagcode.render_error(-1, -1, "文件名与头部角色声明不一致: " + mismatch))
            println("（R3 单一真相原则：文件名与头部都是角色声明源，不一致 = 编译错误）")
            return 1
        }
    }
    // S1.2 文件级 unsafe 角色（type tie<..., unsafe>）：整文件 unsafe 上下文
    var k3: i64 = 0
    while k3 < len(g_role_mods) {
        if g_role_mods[k3] == "unsafe" {
            g_unsafe_depth = g_unsafe_depth + 1
            break
        }
        k3 = k3 + 1
    }
    if g_prep_only {
        println("[预处理] 识别为 " + g_role + " 文件（头: " + g_input + "）")
        return 0
    }
    // 角色分派（表驱动，角色体系完全由注册表决定）：
    //   pass → 提示转交对应工具链（内建 data/ui/db/port/zd 或包注册的 pass 角色）
    //   check → 仅生成 LLVM IR（.ll，d覆 opt/clang 链接，等价 --emit-ir 由角色触发）
    //   lib/exe/空 → 后端输出判定处按角色落入静态库/可执行管线
    var disp = driver.role_output(str.clone(g_role))
    if disp == "pass" {
        if g_role == "data" {
            println("[预处理] 识别为 data 数据交换文件（头: " + g_input + "），可用 --compress-data 压缩为 zd（见 tdzd）")
        } else if g_role == "ui" {
            println("[预处理] 识别为 ui 界面文件（头: " + g_input + "），已转交 UI 工具链 —— v0.1 UI 工具链尚未实现")
        } else if g_role == "db" {
            println("[预处理] 识别为 db 数据库文件（头: " + g_input + "），已转交数据库工具链 —— v0.1 数据库工具链尚未实现")
        } else if g_role == "port" {
            println("[预处理] 识别为 port 端口文件（头: " + g_input + "），已转交端口工具链 —— v0.1 端口工具链尚未实现")
        } else if g_role == "zd" {
            println("[预处理] 识别为 zd 压缩数据文件（头: " + g_input + "），tie:data 压缩格式，用 tiedb compact/decompress 处理")
        } else if g_role == "tsh" {
            println("[预处理] 识别为 tsh 脚本文件（头: " + g_input + "），推荐由 tshell 运行")
            return driver.tsh_dispatch(g_input)
        } else {
            println("[预处理] 识别为 " + g_role + " 角色文件（头: " + g_input + "），已转交对应工具链 —— 由注册包提供，v0.1 尚未实现")
        }
        return 0
    }
    if disp == "check" {
        g_emit_ir = true
    }
    // M5 动态库模式（dev33 批次 12）：--shared 或输出扩展名 .dll/.so → 动态库。
    // 要求 library 角色（class/type，无 main）；通知 irgen 标记导出面（dllexport）
    // 并做边界检查（表/struct 不跨库）。
    if detect_shared_mode() {
        if g_role != "class" && g_role != "type" {
            println(diagcode.render_error(-1, -1, "动态库模式错误: 要求 library 角色（type tie<class> / type tie<type>）"))
            return 1
        }
        // 置位 g_shared（.dll/.so 扩展名触发的动态库模式也要让后续分派识别）
        g_shared = true
        irgen.set_dynlib(true)
    }
    // S3.1 构建配置：分层合并（内置默认 < 用户 config < 项目 config < profile < CLI；
    // 已由角色注册表预加载时（scan_header 前）直接复用，避免重复解析文件）
    if !g_cfg_loaded {
        g_cfg_root = config.load_merge(g_config_path, g_cli_profile)
        if g_cfg_root < 0 {
            println(diagcode.render_error(-1, -1, "构建配置加载失败: " + config.err_msg()))
            return 1
        }
    }
    // CLI 显式参数 → 覆盖合并结果（最高优先；CLI 是显式意图，不警告）
    // p.9.20 双轴：llvm_opt / tiec_opt 两键独立覆盖
    if g_llvm_set {
        g_cfg_root = config.apply_cli(g_cfg_root, "llvm_opt", to_string(g_llvm_opt))
    }
    if g_tie_set {
        g_cfg_root = config.apply_cli(g_cfg_root, "tiec_opt", to_string(g_tie_opt))
    }
    // p.9.1.2：编译资源可调——内存上限 / 并发度写入配置（降档逻辑在
    // effective_llvm_opt，见 kpass_link）。（mem_limit>0 才覆盖；0=不限跳过）
    if g_mem_limit != 0 {
        g_cfg_root = config.apply_cli(g_cfg_root, "tiec.mem_limit", to_string(g_mem_limit))
    }
    if g_jobs != 0 {
        g_cfg_root = config.apply_cli(g_cfg_root, "advanced.threads", to_string(g_jobs))
    }
    if str_len(g_target) > 0 {
        g_cfg_root = config.apply_cli(g_cfg_root, "target", g_target)
    }
    // --backend 实现选择（P4b 验收）：CLI 显式 > 配置 tiec.backend
    var backend = g_backend_cli
    if str_len(backend) == 0 {
        backend = config.get_str(g_cfg_root, "tiec.backend")
    }
    if str_len(backend) > 0 && backend != "win32" && backend != "trm" {
        println(diagcode.render_error(-1, -1, "后端实现未接入: tiec.backend=" + backend + "（win32/LLVM 工具链为当前默认；trm 为路线 B 字节码目标）"))
        return 1
    }
    return driver.compile_program(clean)
}

// p.7.1.1 Keel 接线：真实 pass 间传参载体（front 段输入；原 compile_program
// 的 src/base_dir 局部改用独立命名的全局，使 kpass_* 无参签名可与骨架 pass
// 槽一致）。注意不可复用前端的 g_src（lex_state，词法切片用）以免误改其语义。
var k_g_src: string = "";
var k_g_base_dir: string = "";
// 编译工具链（logic / library）：前端 → 中端 → 后端。
// 阶段计时（TIEC_TIME=1）：irgen / emit / 写盘分开计量。
var g_t_irgen: i64 = 0;   // irgen.tig_ast 耗时（ms）
var g_t_emit: i64 = 0;    // llvmgen.emit 耗时（ms）
var g_t_write: i64 = 0;   // file_write 耗时（ms）
// p.9.21.9 收口：装配路径副作用恢复的失败原因（driver/pipeline.tie 的
// asm_side_recover 写入；降级全量时打印）。全局变量按约定留在主文件。
var asm_recover_err: string = "";

// ==================== Keel 真实 pass 实现（kpass_*） ====================
// 签名统一 fn() -> i64，0 成功 / 非 0 失败；内部即原 compile_program 各
// 段逻辑（行为逐字节等价）。经 keelreg 登记（impl_name = "kpass_*"），由
// driver 侧 keel 分派驱动（见 keel_dispatch / keel_run_pipeline）。

// ==================== Keel driver 引导 + 分派 + 执行 ====================
// Keel 原则「一切行为皆为注册项」：driver 真实组件登记为注册项（新增
// tiec::pass_*_real / tiec::pipeline_real），执行顺序从 keelreg 注册表读取。
// 注：pass 实现驻留 driver，而 keel_executor 需被 tests/_p711_probe/
// keel_probe.tie 独立编译（只 import 三个 keel 文件、不含 driver），故调度
// switch（C1 分派到 driver 真实函数）只能落位在 driver 侧——这是 tie「未
// 定义函数 = E00413 编译错」约束下的唯一等价接法；Keel 注册表仍为管线形态
// 的唯一数据源（executor 的 run_pipeline_prefix 即本接线在骨架层的对应扩展）。

// ==================== p.9.1.3 编译缓存 ====================
// 缓存键 = 输入源码哈希 + 全部输出相关参数（优化档/目标/输出路径/角色/共享/
// emit-ir）+ 编译器形态盐（g_cache_salt）。命中：从缓存目录复制产物到目标路径，
// 跳过编译管线；--no-cache 关闭。缓存目录：config cache.dir；缺省 ~/.tiec-cache。

// ==================== p.9.15.1 依赖感知缓存 ====================
// 修复 p.9.1.3 缓存键缺陷：旧键只哈希入口源码（import 未展开），改任一
// import/using 依赖文件缓存不失效 → 返回陈旧产物。新键聚合「入口 + 全部
// import 递归依赖」的 tsha1r 指纹，任一依赖变化即得新键；命中时 .dep 清单
// 逐文件复核磁盘指纹兜底。强哈希 tsha1r 取代弱 str_hash（碰撞免疫）。

// ==================== 字符串/路径工具（零依赖） ====================

// 从文件名推断角色（S1.4 F1 连字符格式）：`xxx.<基础>[-<参数>][-<修饰>...].tie`
// → 基础角色（分派用）。参数/修饰写入 g_name_param / g_name_mods（一致性
// 检查用）。无角色段返回空串。
var g_name_param: string = "";
var g_name_mods: table<string>;
// ==================== M5 动态库模式工具（dev33 批次 12） ====================
